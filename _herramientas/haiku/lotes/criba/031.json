   "textos": {
    "titulo": "Decorar el piso",
    "b2.f0": "Ya tengo las llaves. El piso es pequeño, pero muy soleado.",
    "b2.f1": "¡Enhorabuena! ¿Y cómo lo vas a decorar?",
