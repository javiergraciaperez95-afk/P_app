                "en": "adverb (fine)",
                "vi": "trạng từ (khỏe)"
              }
            ],
            [
              "¡Hasta luego!",
              {
                "en": "farewell expression",
                "vi": "cụm từ tạm biệt"
              }
            ]
          ]
        },
        {
          "quien": "Pablo",
          "es": "¡Adiós!",
          "en": "Bye!",
          "vi": "Tạm biệt!",
          "analisis": [
