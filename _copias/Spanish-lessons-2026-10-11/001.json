{
  "capitulo": 1,
  "titulo_es": "¡Hola!",
  "titulo": {
    "en": "Hello!",
    "vi": "Xin chào!"
  },
  "intro": {
    "en": "First lesson! Today you'll learn to say hello, goodbye and thank you in Spanish. Tap the underlined words and press «?» on each sentence.",
    "vi": "Bài đầu tiên! Hôm nay em sẽ học chào hỏi, tạm biệt và cảm ơn bằng tiếng Tây Ban Nha. Chạm vào các từ gạch chân và bấm «?» ở mỗi câu nhé."
  },
  "palabras": {
    "hola": {
      "en": "hello",
      "vi": "xin chào",
      "pron": "O-la",
      "cat": {
        "en": "interjection",
        "vi": "thán từ"
      },
      "consejo": {
        "en": "The h is always silent in Spanish.",
        "vi": "Chữ h trong tiếng Tây Ban Nha luôn câm."
      }
    },
    "adiós": {
      "en": "goodbye",
      "vi": "tạm biệt",
      "pron": "a-DYOS",
      "cat": {
        "en": "interjection",
        "vi": "thán từ"
      }
    },
    "buenos días": {
      "en": "good morning",
      "vi": "chào buổi sáng",
      "pron": "BWE-nos DI-as",
      "cat": {
        "en": "expression",
        "vi": "cụm từ"
      }
    },
    "buenas tardes": {
      "en": "good afternoon",
      "vi": "chào buổi chiều",
      "pron": "BWE-nas TAR-des",
      "cat": {
        "en": "expression",
        "vi": "cụm từ"
      }
    },
    "buenas noches": {
      "en": "good evening / good night",
      "vi": "chào buổi tối / chúc ngủ ngon",
      "pron": "BWE-nas NO-ches",
      "cat": {
        "en": "expression",
        "vi": "cụm từ"
      }
    },
    "gracias": {
      "en": "thank you",
      "vi": "cảm ơn",
      "pron": "GRA-thyas",
      "cat": {
        "en": "interjection",
        "vi": "thán từ"
      },
      "consejo": {
        "en": "In Spain, «c» before i/e sounds like English «th».",
        "vi": "Ở Tây Ban Nha, «c» trước i/e đọc giống «th» trong tiếng Anh."
      }
    },
    "de nada": {
      "en": "you're welcome",
      "vi": "không có gì",
      "pron": "de NA-da",
      "cat": {
        "en": "expression",
        "vi": "cụm từ"
      }
    },
    "qué tal": {
      "en": "how are you? / how's it going?",
      "vi": "bạn khỏe không?",
      "pron": "ke TAL",
      "cat": {
        "en": "expression",
        "vi": "cụm từ"
      }
    },
    "bien": {
      "en": "well, fine",
      "vi": "khỏe, tốt",
      "pron": "byen",
      "cat": {
        "en": "adverb",
        "vi": "trạng từ"
      }
    },
    "muy": {
      "en": "very",
      "vi": "rất",
      "pron": "mwi",
      "cat": {
        "en": "adverb",
        "vi": "trạng từ"
      }
    },
    "y": {
      "en": "and",
      "vi": "và",
      "pron": "i",
      "cat": {
        "en": "conjunction",
        "vi": "liên từ"
      }
    },
    "tú": {
      "en": "you (informal)",
      "vi": "bạn (thân mật)",
