  "bloques": [
    {
      "tipo": "explicacion",
      "titulo": {
        "en": "Saying hello",
        "vi": "Chào hỏi"
      },
      "texto": {
        "en": "**Hola** works at any time of day and with anyone.\n\nTo be a bit more polite, use the time of day:\n\n- **buenos días**: until lunch (around 2 pm)\n- **buenas tardes**: afternoon until dark\n- **buenas noches**: evening and to say good night",
        "vi": "**Hola** dùng được vào mọi lúc và với mọi người.\n\nĐể lịch sự hơn, dùng lời chào theo thời gian trong ngày:\n\n- **buenos días**: đến giờ ăn trưa (khoảng 2 giờ chiều)\n- **buenas tardes**: buổi chiều đến khi trời tối\n- **buenas noches**: buổi tối và khi chúc ngủ ngon"
      }
    },
    {
      "tipo": "dialogo",
      "titulo": {
        "en": "Two friends meet",
        "vi": "Hai người bạn gặp nhau"
      },
      "frases": [
        {
          "quien": "Lucía",
          "es": "¡Hola! ¿Qué tal?",
          "en": "Hi! How are you?",
          "vi": "Chào! Bạn khỏe không?",
          "analisis": [
            [
              "¡Hola!",
              {
                "en": "greeting",
                "vi": "lời chào"
              }
            ],
            [
              "¿Qué tal?",
              {
                "en": "set question (how are you)",
                "vi": "câu hỏi cố định (khỏe không)"
              }
            ]
          ]
        },
        {
          "quien": "Pablo",
          "es": "Muy bien, gracias. ¿Y tú?",
          "en": "Very well, thanks. And you?",
          "vi": "Rất khỏe, cảm ơn. Còn bạn?",
          "analisis": [
            [
              "Muy bien",
              {
                "en": "adverb (very well)",
                "vi": "trạng từ (rất khỏe)"
              }
            ],
            [
              "gracias",
              {
                "en": "thanks",
                "vi": "lời cảm ơn"
              }
            ],
            [
              "¿Y tú?",
              {
                "en": "question (and you?)",
                "vi": "câu hỏi (còn bạn?)"
              }
            ]
          ],
          "nota": [
            {
              "en": "Spanish questions open with ¿ and exclamations with ¡.",
              "vi": "Câu hỏi tiếng Tây Ban Nha mở đầu bằng ¿ và câu cảm thán bằng ¡."
            }
          ]
        },
        {
          "quien": "Lucía",
          "es": "Bien. ¡Hasta luego!",
          "en": "Fine. See you later!",
          "vi": "Khỏe. Hẹn gặp lại!",
          "analisis": [
            [
              "Bien",
