  "titulo_es": "Por y para",
  "titulo": { "en": "Por and para" },
  "intro": { "en": "Both can mean for. They do not swap." },
  "palabras": {
    "por": { "en": "for, through, because of", "pron": "por", "cat": "preposition" },
