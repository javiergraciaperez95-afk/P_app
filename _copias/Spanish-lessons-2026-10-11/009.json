{
  "capitulo": 2,
  "titulo_es": "Estoy bien",
  "titulo": { "en": "I'm fine" },
  "intro": { "en": "Ser says what does not change easily: origin, job, looks. Estar says how you are right now, and where you are." },
  "palabras": {
    "estoy": { "en": "I am (right now)", "pron": "es-TOY", "cat": "verb" },
    "estás": { "en": "you are (right now)", "pron": "es-TAS", "cat": "verb" },
    "está": { "en": "he/she is, you (formal) are", "pron": "es-TA", "cat": "verb" },
    "estamos": { "en": "we are (right now)", "pron": "es-TA-mos", "cat": "verb" },
    "están": { "en": "they are (right now)", "pron": "es-TAN", "cat": "verb" },
    "bien": { "en": "well, fine", "pron": "byen", "cat": "adverb" },
    "mal": { "en": "badly, unwell", "pron": "mal", "cat": "adverb" },
    "cansada": { "en": "tired (female)", "pron": "kan-SA-da", "cat": "adjective" },
    "cansado": { "en": "tired (male)", "pron": "kan-SA-do", "cat": "adjective" },
    "ocupada": { "en": "busy (female)", "pron": "o-ku-PA-da", "cat": "adjective" },
    "contento": { "en": "glad (male)", "pron": "kon-TEN-to", "cat": "adjective" },
    "en casa": { "en": "at home", "pron": "en KA-sa", "cat": "expression", "nota": "En casa has no article. En la casa would point at the building." },
    "aquí": { "en": "here", "pron": "a-KI", "cat": "adverb" },
    "allí": { "en": "there", "pron": "a-YI", "cat": "adverb" }
  },
  "bloques": [
    {
      "tipo": "explicacion",
      "titulo": "Ser or estar",
      "texto": "**Ser** is who you are. **Estar** is how or where you are now.\n\n- Soy de Madrid. / **Estoy** en Madrid.\n- Soy alta. / **Estoy** cansada.\n- Es profesor. / **Está** ocupado.\n\n**En casa** means at home, with no article. **Aquí** is here, **allí** is there.\n\nThe forms: estoy, estás, está, estamos, estáis, están. The written accent is what separates está (he is) from esta (this, feminine), which comes in a later lesson."
    },
    {
      "tipo": "tabla",
      "titulo": "The same idea, two verbs",
      "columnas": ["ser", "estar"],
      "filas": [
        ["Soy canadiense.", "Estoy cansada."],
        ["Es profesora.", "Está en casa."],
        ["Somos de Lima.", "Estamos aquí."],
        ["Son jóvenes.", "Están bien."]
      ],
      "nota": { "en": "A place you are in right now takes estar: el museo está en la plaza. What the place is takes ser: es un museo." }
    },
    {
      "tipo": "dialogo",
      "titulo": "After class",
      "frases": [
        {
          "quien": "Pablo",
          "es": "¿Cómo estás?",
          "en": "How are you?",
          "analisis": [
            ["¿Cómo", "question"],
            ["estás", "verb"]
          ]
        },
        {
          "quien": "Lucía",
          "es": "Estoy bien, pero estoy cansada.",
          "en": "I'm fine, but I'm tired.",
          "analisis": [
            ["Estoy bien", "how she feels"],
            ["estoy cansada", "a state"]
          ]
        },
        {
          "quien": "Pablo",
          "es": "¿Estás en casa?",
          "en": "Are you at home?",
          "analisis": [
            ["¿Estás", "verb"],
            ["en casa", "place"]
          ]
        },
        {
          "quien": "Lucía",
          "es": "Sí, estoy aquí. ¿Y Ana?",
          "en": "Yes, I'm here. And Ana?",
          "analisis": [
            ["estoy", "verb"],
            ["aquí", "place"],
            ["¿Y Ana", "question"]
          ]
        },
        {
          "quien": "Pablo",
          "es": "Ana está allí. Está ocupada.",
          "en": "Ana is over there. She is busy.",
          "analisis": [
            ["Ana", "subject"],
            ["está", "verb"],
            ["allí", "place"],
            ["ocupada", "adjective"]
          ]
        },
        {
          "quien": "Lucía",
          "es": "Nosotros estamos bien.",
          "en": "We are fine.",
          "analisis": [
            ["Nosotros", "subject"],
            ["estamos", "verb"],
            ["bien", "how they are"]
          ]
        }
      ]
    },
    {
      "tipo": "vocabulario",
      "palabras": ["estoy", "estás", "está", "estamos", "están", "bien", "mal", "cansada", "cansado", "ocupada", "contento", "en casa", "aquí", "allí"]
    },
    {
      "tipo": "test",
      "id": "a1-estar-origen",
      "pregunta": { "en": "Which sentence says where she is from?" },
      "opciones": {
        "Soy de Madrid": { "en": "Origin uses ser." },
        "Estoy en Madrid": { "en": "That says where she is right now." },
        "Estoy cansada": { "en": "That says how she feels." }
      },
      "correcta": "Soy de Madrid"
    },
    {
      "tipo": "huecos",
      "id": "a1-estar-donde",
      "pregunta": { "en": "Complete: where is the museum?" },
      "frase": "¿Dónde ___ el museo?",
      "audio": true,
      "opciones": {
        "está": { "en": "Where something is right now uses estar." },
        "es": { "en": "Es would say what it is, not where it is." },
        "estoy": { "en": "Estoy is for yo." }
      },
      "correcta": "está"
    },
    {
      "tipo": "escribir",
      "id": "a1-estar-casa",
      "pregunta": { "en": "Write: I am at home." },
      "respuestas": ["Estoy en casa", "Yo estoy en casa"],
      "explicacion": { "en": "Estoy for how or where you are. En casa has no article." }
