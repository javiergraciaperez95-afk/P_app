  "bloques": [
    {
      "tipo": "explicacion",
      "titulo": "Once, or as a habit",
      "texto": "Ask: did it happen once, and is it finished? Use the **indefinido**.\n\nWas it the normal situation, or happening around another event? Use the **imperfecto**.\n\n- Ayer **compré** un billete. (once)\n- Antes **viajaba** en tren. (habit)\n- **Llovía** cuando salí. (rain was the background; salí is the event)"
    },
    {
      "tipo": "dialogo",
      "titulo": "The trip",
      "frases": [
        {
          "quien": "Lucía",
          "es": "Ayer compré un billete.",
          "en": "Yesterday I bought a ticket.",
          "analisis": [
            ["Ayer", "yesterday"],
            ["compré", "I bought (once)"],
            ["un billete", "a ticket"]
          ]
        },
        {
          "quien": "Pablo",
          "es": "Antes yo viajaba en tren.",
          "en": "I used to travel by train.",
          "analisis": [
            ["Antes", "back then"],
            ["viajaba", "I used to travel"],
            ["en tren", "by train"]
          ]
        },
        {
          "quien": "Lucía",
          "es": "Llovía cuando salí de casa.",
          "en": "It was raining when I left home.",
          "analisis": [
            ["Llovía", "background"],
            ["cuando salí", "the finished event"],
            ["de casa", "from home"]
          ]
        },
        {
          "quien": "Pablo",
          "es": "Ayer llovió todo el día.",
          "en": "Yesterday it rained all day.",
          "nota": "Todo el día gives the rain a finished block of time, so the indefinido fits.",
          "analisis": [
            ["Ayer", "yesterday"],
            ["llovió", "it rained"],
            ["todo el día", "all day"]
          ]
        }
      ]
    },
    {
      "tipo": "vocabulario",
      "palabras": ["ayer", "antes", "compré", "compraba", "llovió", "llovía", "el billete", "en tren", "viajaba", "salí"]
    },
