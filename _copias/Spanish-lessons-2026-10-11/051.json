  "titulo_es": "Para que vengas",
  "titulo": { "en": "So that you come" },
  "intro": { "en": "Para plus an infinitive is your own purpose. Para que is a purpose for someone else." },
  "palabras": {
    "para": { "en": "in order to, for", "pron": "PA-ra", "cat": "preposition" },
    "para que": { "en": "so that", "pron": "PA-ra ke", "cat": "conjunction" },
    "vengas": { "en": "you come (subjunctive)", "pron": "BEN-gas", "cat": "verb" },
