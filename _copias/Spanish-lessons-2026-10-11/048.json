          "analisis": [
            ["Se me olvidó", "it slipped my mind"],
            ["el nombre", "the name"]
          ]
        },
        {
          "quien": "Pablo",
          "es": "¿Otra vez?",
          "en": "Again?",
          "analisis": [["¿Otra vez?", "again"]]
        },
        {
