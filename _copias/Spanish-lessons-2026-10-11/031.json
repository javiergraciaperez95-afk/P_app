    },
    {
      "tipo": "vocabulario",
      "palabras": ["fui", "fue", "tuve", "hice", "hizo", "al mercado", "la compra"]
    },
    {
      "tipo": "test",
      "id": "a2-fui-significado",
      "pregunta": { "en": "In «Ayer fui al cine», fui means…" },
      "opciones": {
        "I went": { "en": "A place after fui means ir: I went." },
        "I was": { "en": "Fui can mean I was, but not with al cine." },
        "I had": { "en": "I had is tuve." }
      },
