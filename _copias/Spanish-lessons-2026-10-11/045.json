  "titulo_es": "No creo que esté",
  "titulo": { "en": "I don't think she is" },
  "intro": { "en": "Creo que takes the ordinary verb. No creo que takes the subjunctive." },
  "palabras": {
    "creo que": { "en": "I think that", "pron": "KRE-o ke", "cat": "expression" },
