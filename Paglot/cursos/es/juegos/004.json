      "tipo": "detector",
      "dice": {
        "en": "Age works differently in Spanish: you don't «are» your age, you **have** it. Look at the model, then tell me: is each sentence right? **Sí** or **No**."
      },
      "modelo": {
        "es": "**Tengo** ocho **años**.",
        "trad": {
          "en": "I am eight. Word for word: «I **have** eight **years**»."
        }
      },
      "frases": [
        {
          "es": "Tengo cinco años.",
          "ok": true,
          "por": {
            "en": "Sí: **tengo** + number + **años**. «I am five»."
          }
        },
        {
          "es": "Soy cinco años.",
          "ok": false,
          "por": {
            "en": "No! Never **soy** for age. You HAVE your years: **Tengo cinco años**."
          }
        },
        {
          "es": "¿Cuántos años tienes?",
          "ok": true,
          "por": {
            "en": "Sí: «how old are you?» Word for word: «how many years do you have?»"
          }
        },
        {
          "es": "¿Cuántos años eres?",
          "ok": false,
          "por": {
            "en": "No: age always goes with «have». **¿Cuántos años tienes?**"
          }
        },
        {
          "es": "Tengo diez.",
          "ok": true,
          "por": {
            "en": "Sí: you can leave out **años**. «I'm ten»."
          }
        },
        {
          "es": "Soy siete.",
          "ok": false,
          "por": {
            "en": "No: **Tengo siete**, or **Tengo siete años**."
          }
        }
      ],
      "despues": {
        "en": "**Tengo** + number + **años**. And by the way: **sí** = «yes», **no** = «no». Two free words!"
      }
