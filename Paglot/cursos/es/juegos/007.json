    {
      "etapa": {
        "en": "Jobs"
      },
      "tipo": "detector",
      "dice": {
        "en": "One strange thing: before a job, Spanish has NO word for «a». Look at the model, then judge each sentence: **Sí** or **No**."
      },
      "modelo": {
        "es": "**Soy profesora.**",
        "trad": {
          "en": "I am **a** teacher. Word for word: «I am teacher»."
        }
      },
      "frases": [
        {
          "es": "Soy médica.",
          "ok": true,
          "por": {
            "en": "Sí: «I am a doctor», with no «a»."
          }
        },
        {
          "es": "Soy una médica.",
          "ok": false,
          "por": {
            "en": "No: nothing before the job. **Soy médica.**"
          }
        },
        {
          "es": "Pablo es profesor.",
          "ok": true,
          "por": {
            "en": "Sí: «Pablo is a teacher»."
          }
        },
        {
          "es": "Soy un estudiante.",
          "ok": false,
          "por": {
            "en": "No: nothing before the job. **Soy estudiante.**"
          }
        },
        {
          "es": "Eres estudiante.",
          "ok": true,
          "por": {
            "en": "Sí: «you are a student»."
          }
        },
        {
          "es": "Ana es una profesora.",
          "ok": false,
          "por": {
            "en": "No: **Ana es profesora.**"
          }
        }
      ],
      "despues": {
        "en": "**Soy** + the job, and nothing else. Easy to say, easy to forget!"
      }
