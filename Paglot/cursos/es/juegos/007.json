  "pasos": [
    {
      "etapa": {
        "en": "Where from?"
      },
      "tipo": "explica",
      "dice": {
        "en": "You already know **soy**, **eres** and **es**. Today the slider goes further: «we», «you all» and «they». Drag it and watch the red word."
      },
      "palancas": [
        {
          "titulo": {
            "en": "ser, complete"
          },
          "control": "deslizador",
          "posiciones": [
            {
              "etiqueta": "yo",
              "es": "Yo **soy** de Madrid.",
              "trad": {
                "en": "**I am** from Madrid"
              }
            },
            {
              "etiqueta": "tú",
              "es": "Tú **eres** de Madrid.",
              "trad": {
                "en": "**you are** from Madrid"
              }
            },
            {
              "etiqueta": "ella",
              "es": "Ella **es** de Madrid.",
              "trad": {
                "en": "**she is** from Madrid (the same for «he» and for usted)"
              }
            },
            {
              "etiqueta": "nosotros",
              "es": "Nosotros **somos** de Madrid.",
              "trad": {
                "en": "**we are** from Madrid"
              }
            },
            {
              "etiqueta": "vosotros",
              "es": "Vosotros **sois** de Madrid.",
              "trad": {
                "en": "**you all are** from Madrid (to friends, in Spain)"
              }
            },
            {
              "etiqueta": "ellos",
              "es": "Ellos **son** de Madrid.",
              "trad": {
                "en": "**they are** from Madrid"
              }
            }
          ],
          "retos": [
            {
              "pide": {
                "en": "Find «We are from Madrid»."
              },
              "correcta": 3
            },
            {
              "pide": {
                "en": "Find «They are from Madrid»."
              },
              "correcta": 5
            },
            {
              "pide": {
                "en": "Find «You all are from Madrid»."
              },
              "correcta": 4
            },
            {
              "pide": {
                "en": "Find «She is from Madrid»."
              },
              "correcta": 2
            }
          ]
        }
      ],
      "despues": {
        "en": "Six forms: **soy, eres, es, somos, sois, son**. That is the whole verb."
      }
    },
    {
      "etapa": {
        "en": "Where from?"
      },
      "tipo": "maquina",
      "dice": {
        "en": "Sentence machine! Where you are from is **ser** + **de** + the place, with nothing in between: **de Londres**, **de Canadá**."
      },
      "ruedas": [
        [
          "yo",
          "Ana",
          "nosotros",
          "vosotros",
          "ellos"
        ],
        [
          "soy",
          "es",
          "somos",
          "sois",
          "son"
        ],
        [
          "de Londres",
          "de Canadá"
        ]
      ],
      "pista": {
        "en": "The reels that shook are wrong. **nosotros somos**, **vosotros sois**, **ellos son**."
      },
      "retos": [
        {
          "trad": {
            "en": "We are from London"
          },
          "solucion": [
            "nosotros",
            "somos",
            "de Londres"
          ]
        },
        {
          "trad": {
            "en": "They are from Canada"
          },
          "solucion": [
            "ellos",
            "son",
            "de Canadá"
          ]
        },
        {
          "trad": {
            "en": "Ana is from Canada"
          },
          "solucion": [
            "Ana",
            "es",
            "de Canadá"
          ]
        },
        {
          "trad": {
            "en": "You all are from London"
          },
          "solucion": [
            "vosotros",
            "sois",
            "de Londres"
          ]
        },
        {
          "trad": {
            "en": "I am from London"
          },
          "solucion": [
            "yo",
            "soy",
            "de Londres"
          ]
        }
      ],
      "despues": {
        "en": "No «the», no «a»: just **de** + the place. **Soy de Londres.**"
      }
    },
