 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": "Present or past",
   "texto": [
    "If the action is later or simultaneously at the moment we speak, use subjunctive present: **Je suis triste que tu partes** (I am sad that you leave).",
    "If it's past, use past subjunctive: **Je suis triste que tu sois parti** (I'm sad you're gone)."
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": "Choose between «que» and infinitive",
   "texto": [
    "If the person who feels and does the action is the same, **de** + infinitive is used: **Je suis content d'être arrivé** (I am glad to have arrived). If different, **que** + subjunctive is used: **Je suis content que tu sois arrivé** (I'm glad you got here)."
   ]
  },
