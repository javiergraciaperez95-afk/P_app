   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Ce qui / ce que / ce dont",
     "texto": [
      "**Ce qui** (what, as subject): **Ce qui est important, c'est la santé** (what matters is health).",
      "**Ce que** (what, as object): **Ce que tu dis est vrai** (what you say is true).",
      "**Ce dont** means «what» when the sentence needs **de**: **Ce dont j'ai besoin, c'est de repos** (what I need is rest)."
     ],
     "tutora": ""
    },
