 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Asking politely",
     "texto": [
      "**Je voudrais** (I would like) is more polite than **je veux** (I want).",
      "Example: **Je voudrais un billet pour Lyon** (I would like a ticket to Lyon)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Other polite forms",
     "texto": [
      "**J'aimerais** (I would like) and **Pourriez-vous** (could you?).",
      "Example: **Pourriez-vous répéter ?** (could you repeat?)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "The present conditional",
     "texto": [
      "It is formed with the future stem and the imperfect endings: **-ais, -ais, -ait, -ions, -iez, -aient**.",
      "**Vouloir** → **voudr-**: **je voudrais**. **Pouvoir** → **pourr-**: **vous pourriez**. **Aimer** → **aimer-**: **j'aimerais**."
     ],
     "tutora": ""
    },
