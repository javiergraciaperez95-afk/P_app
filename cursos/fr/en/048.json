       "texto": "Means",
       "lengua": "alumno"
      },
      {
       "texto": "Example",
       "lengua": "alumno"
      }
     ],
     "filas": [
      [
       {
        "texto": "plus + adjective + que",
        "lengua": "alumno"
       },
       {
        "texto": "more... than",
        "lengua": "alumno"
       },
       {
        "texto": "Lyon est plus petit que Paris.",
        "lengua": "estudio"
       }
      ],
      [
       {
        "texto": "moins + adjective + que",
        "lengua": "alumno"
       },
       {
        "texto": "less... than",
