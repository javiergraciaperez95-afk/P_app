   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "«Jouer à», «jouer de» and «faire»",
     "texto": [
      "To say you play a sport or game, use **jouer à** + article: **jouer au tennis**, **jouer aux cartes**. For instruments, use **jouer de**: **jouer de la guitare**, **jouer du piano**. **Faire du football** is also correct: it means to practise or do that sport."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "«Faire du», «faire de la»",
     "texto": [
      "With activities, use **faire** + article: **faire du vélo** (cycling), **faire de la natation** (swimming), **faire du sport** (do sport)."
     ],
     "tutora": ""
    },
