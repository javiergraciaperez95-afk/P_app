 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Days",
     "texto": [
      "Unlike in English, days are written in **lowercase**. Without an article, **lundi** usually refers to a specific Monday; the context shows which one. With an article, **le lundi** usually expresses a habit: «on Mondays».",
      "**Aujourd'hui** = today. **Le week-end** = the weekend; in a routine it can mean «on weekends»."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "The days of the week",
     "columnas": [
      {
       "texto": "French",
       "lengua": "alumno"
