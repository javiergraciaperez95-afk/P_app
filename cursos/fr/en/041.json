   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Near future or simple future",
     "texto": [
      "For things that are happening now or very soon, use **aller** + infinitive: **Je vais travailler demain** (I'm going to work tomorrow).",
      "For what will happen later on or for a prediction, use the futur simple: **Dans dix ans, je travaillerai à l'étranger** (in ten years I will work abroad)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "When you talk about the future with quand",
     "texto": [
      "After **quand** (when) the future is also used: **Quand je serai grand, je serai professeur** (when I grow up, I'll be a teacher)."
     ],
     "tutora": ""
    },
