   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Avant que, après que",
     "texto": [
      "**Avant que** (before) takes the subjunctive: **Avant que tu aies mangé, je pars** (I'm leaving before you have eaten).",
      "**Après que** (after) takes the indicative: **Après que tu as mangé, on sort** (after you ate, we go out)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "After having",
     "texto": [
      "**Après avoir** + past participle = after having: **Après avoir mangé, je dors** (after eating, I sleep). It is the most natural form in French."
     ],
     "tutora": ""
    },
