   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "«Venir de» + infinitive",
     "texto": [
      "**Je viens de manger** (I've just eaten): present of **venir** + **de** + infinitive.",
      "In the past, use the imperfect of **venir**: **Je venais de partir** (I had just left)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Watch out for «aller»",
     "texto": [
      "**Je vais partir** (I'm going to leave, not yet). Don't confuse **venir de** (has just happened) with **aller** (is going to happen)."
     ],
     "tutora": ""
    },
