   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Expressions of will",
     "texto": [
      "**Je veux que** (I want that), **il vaut mieux que** (it is better that), **il est important que** (it is important that).",
      "Example: **Il est important que tu viennes** (it is important that you come)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "What does not change",
     "texto": [
      "If the subject is the same, **que** is not used: **Je veux partir** (I want to leave), **il vaut mieux partir** (it is better to leave)."
     ],
     "tutora": ""
    },
