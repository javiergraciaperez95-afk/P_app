  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Making an appointment",
     "texto": [
      "To suggest a time you can ask **Vous êtes libre mardi ?** (Are you free on Tuesday?) or **On se voit à dix heures ?** (Shall we meet at ten?).",
      "To accept: **Oui, ça me va** (yes, that works for me). To confirm: **C'est confirmé** (it is confirmed).",
      "In a formal situation you can ask for an appointment with **Je voudrais prendre rendez-vous** (I would like to make an appointment). Learn this phrase as a useful expression."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Changing or cancelling",
     "texto": [
      "To suggest another time: **On peut reporter à jeudi ?** (Can we move it to Thursday?).",
      "To cancel: **Je dois annuler le rendez-vous** (I have to cancel the appointment). **Désolé(e)** = sorry; **merci** = thank you."
     ],
     "tutora": ""
    }
   ]
