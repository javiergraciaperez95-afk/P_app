  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "«Pas de», «pas encore», «pas du tout»",
     "texto": [
      "**Pas de** + noun = no / not any: **Je n'ai pas de travail** (I don't have a job).",
      "**Pas encore** = not yet: **Je ne travaille pas encore** (I'm not working yet).",
      "**Pas du tout** = not at all: **Je n'aime pas du tout le lundi** (I don't like Mondays at all)."
     ],
     "tutora": ""
    },
    {
