   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "At the hotel",
     "texto": [
      "On arrival: **J'ai une réservation** (I have a booking).",
      "Rooms: **une chambre simple** (single) and **une chambre double** (double). Nights: **pour deux nuits** (for two nights).",
      "To confirm: **C'est ça** (that's it).",
      "Floors are given with ordinal numbers: **au premier étage**, **au deuxième étage**, **au troisième étage**."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "If you don't feel well",
     "texto": [
      "**Ça ne va pas ?** = are you alright?",
      "**Je ne me sens pas bien** = I don't feel well. **Je suis malade** = I am ill.",
      "Pains are expressed with **avoir mal à**, as in English «I have a headache»: **J'ai mal à la tête** (I have a headache), **J'ai mal au ventre** (I have a stomach ache), **J'ai mal aux dents** (I have toothache)."
     ],
     "tutora": ""
    }
   ]
  },
