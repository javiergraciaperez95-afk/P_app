   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "«C'est... qui / que»",
     "texto": [
      "To highlight the subject use **c'est** + subject + **qui**: **C'est Thomas qui a téléphoné** (it was Thomas who called).",
      "To highlight the object or the time, use **que**: **C'est hier que je suis rentré** (it was yesterday that I came back)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "«Qui» or «que»",
     "texto": [
      "**Qui** goes with the subject and **que** with the rest. It changes the order and gives more emphasis to one part."
     ],
     "tutora": ""
    },
    {
