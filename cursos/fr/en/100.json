 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Present or past",
     "texto": [
      "If the action is later than or simultaneous with the moment we speak, use the present subjunctive: **Je suis triste que tu partes** (it saddens me that you are leaving).",
      "If it has already happened, use the past subjunctive: **Je suis triste que tu sois parti** (it saddens me that you have left)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Choosing between «que» and an infinitive",
     "texto": [
      "If the person who feels the emotion and the one who performs the action are the same, **de** + infinitive is used: **Je suis content d'être arrivé** (I'm glad to have arrived). If they are different, **que** + subjunctive is used: **Je suis content que tu sois arrivé** (I'm glad that you have arrived)."
     ],
     "tutora": ""
    },
