     "titulo": "Climate and us",
     "frases": [
      {
       "quien": {
        "texto": "Léa",
        "lengua": "estudio"
       },
       "estudio": "La forêt est menacée par la pollution.",
       "alumno": "The forest is threatened by pollution.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "la forêt",
         "the forest (feminine subject)"
        ],
        [
         "est menacée",
         "is threatened (passive voice: «être» in the present + agreeing past participle)"
        ],
        [
         "par la pollution",
         "by pollution (agent introduced by «par»)"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Thomas",
        "lengua": "estudio"
       },
       "estudio": "Il faut recycler, c'est écologique.",
       "alumno": "We have to recycle, it's ecological.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "il faut recycler",
         "we have to recycle («falloir» impersonal + infinitive)"
        ],
        [
         "c'est écologique",
         "it's ecological (c'est + invariable adjective)"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Léa",
        "lengua": "estudio"
       },
       "estudio": "Le climat change à cause du réchauffement.",
       "alumno": "The climate is changing because of the warming.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "le climat change",
         "the climate changes (masculine subject + present of «changer»)"
        ],
        [
         "à cause du réchauffement",
         "because of the warming (unfavorable causal phrase «à cause de» + «le»)"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Thomas",
        "lengua": "estudio"
       },
       "estudio": "Un transport durable est possible.",
       "alumno": "Sustainable transport is possible.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "un transport durable",
         "sustainable transport (masculine noun + qualifying adjective)"
        ],
        [
         "est possible",
         "is possible (verb «être» + predicate)"
        ]
       ],
       "parrafo": 0
      }
     ]
