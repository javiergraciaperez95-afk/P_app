   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Congratulating",
     "texto": [
      "For a birthday, say **Bon anniversaire !** (Happy birthday!). **Joyeux anniversaire !** is also heard.",
      "To congratulate someone on good news: **Félicitations !**.",
      "**Bonne chance !** means «good luck!» and **Bon courage !** means «keep going!» or «all the best!»."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Replying and making a wish",
     "texto": [
      "You can reply **Merci !** (thanks!) or **C'est gentil** (that's kind). To wish someone something on a special occasion: **Bonne année !** (happy new year!).",
      "Pay attention to gender: **bon** goes with a masculine noun (*bon anniversaire*); **bonne** with a feminine one (*bonne chance*)."
     ],
     "tutora": ""
    }
   ]
