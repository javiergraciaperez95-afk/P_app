    },
    {
     "tipo": "explicacion",
     "titulo": "Inviting",
     "texto": [
      "**Tu veux venir ?** (do you want to come?).",
      "To accept: **Avec plaisir !** (with pleasure!) or **Bonne idée !** (good idea!). To decline: **Désolé, je ne peux pas** (sorry, I can't).",
      "To meet up: **On se retrouve à huit heures ?** (shall we meet at eight?)."
     ],
     "tutora": ""
    }
   ]
