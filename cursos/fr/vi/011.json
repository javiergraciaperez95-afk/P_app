     "frases": [
      {
       "quien": {
        "texto": "Marie",
        "lengua": "estudio"
       },
       "estudio": "Voici mon nouvel appartement.",
       "alumno": "Đây là căn hộ mới của tôi.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "mon nouvel appartement",
         "căn hộ mới của tôi («nouvel» trước nguyên âm)"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Hugo",
        "lengua": "estudio"
       },
       "estudio": "Il est sympa ! Il y a combien de pièces ?",
       "alumno": "Đẹp quá! Có bao nhiêu phòng?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Il y a",
         "có"
        ],
        [
         "combien de pièces",
         "bao nhiêu phòng"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Marie",
        "lengua": "estudio"
       },
       "estudio": "Il y a quatre pièces. Il y a un salon, une cuisine, une chambre et une salle de bains.",
       "alumno": "Có bốn phòng. Có một phòng khách, một bếp, một phòng ngủ và một nhà tắm.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Il y a quatre pièces",
         "có bốn phòng"
        ],
        [
         "une salle de bains",
         "một nhà tắm"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Hugo",
        "lengua": "estudio"
       },
       "estudio": "Est-ce qu'il y a un jardin ?",
       "alumno": "Có vườn không?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Est-ce qu'il y a",
         "có… không?"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Marie",
        "lengua": "estudio"
       },
       "estudio": "Non, il n'y a pas de jardin. Mais il y a deux grandes fenêtres.",
       "alumno": "Không, không có vườn. Nhưng có hai cửa sổ lớn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "il n'y a pas de jardin",
         "không có vườn (không có mạo từ)"
        ],
        [
         "deux grandes fenêtres",
         "hai cửa sổ lớn"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Hugo",
        "lengua": "estudio"
       },
       "estudio": "Il y a des chaises dans la cuisine ?",
       "alumno": "Trong bếp có ghế không?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "des chaises",
         "ghế"
        ],
        [
         "dans la cuisine",
         "trong bếp"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Marie",
        "lengua": "estudio"
       },
       "estudio": "Oui, il y a deux chaises et une petite table.",
       "alumno": "Có, có hai ghế và một bàn nhỏ.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
