 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "El pronombre Y",
    "@en": "The pronoun Y"
   },
   "texto": [
    {
     "@es": "**Y** sustituye a un lugar (**à**, **dans**, **chez** + lugar): **Je vais à la piscine** → **J'y vais**. También puede sustituir **à + cosa o idea**: **Je pense à mes vacances** → **J'y pense** (pienso en ellas). Para una persona, di **Je pense à lui/elle**.",
     "@en": "**Y** replaces a place (**à**, **dans**, **chez** + place): **Je vais à la piscine** → **J'y vais**. You can also replace **à + cosa o idea**: **Je pense à mes vacances** → **J'y pense** (I think of them). For one person, say **Je pense à lui/elle**."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Dónde va",
    "@en": "Where are you going?"
   },
   "texto": [
    {
     "@es": "Como los demás pronombres, **y** va **delante del verbo**: **J'y vais**, **Il y est**.",
     "@en": "Like other pronouns, **y** goes **delante del verbo**: **J'y vais**, **Il y est**."
    },
    {
     "@es": "No se pone detrás del verbo: no se dice **Il est y**.",
     "@en": "It is not put behind the verb: it is not said **Il est y**."
    }
   ]
  },
