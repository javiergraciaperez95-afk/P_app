 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Avant de + infinitivo",
    "@en": "Avant of + infinitive"
   },
   "texto": [
    {
     "@es": "**Avant de** + infinitivo = antes de: **Avant de partir, je prends un café** (antes de salir, tomo un café). No se dice **avant partir**.",
     "@en": "**Avant de** + infinitive = before: **Avant de partir, je prends un café** (before leaving, I have a coffee). It's not **avant partir**."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Après + sustantivo",
    "@en": "Après + substantive"
   },
   "texto": [
    {
     "@es": "**Après** + sustantivo = después de: **Après le travail, je rentre** (después del trabajo, vuelvo a casa).",
     "@en": "**Après** + noun = after: **Après le travail, je rentre** (after work, I return home)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Quand + frase",
    "@en": "Quand + sentence"
   },
   "texto": [
    {
     "@es": "**Quand** = cuando: **Quand je suis libre, je lis** (cuando estoy libre, leo).",
     "@en": "**Quand** = when: **Quand je suis libre, je lis** (when I am free, I read)."
    }
   ]
  },
