 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Los pronombres COD",
    "@en": "The COD pronouns"
   },
   "texto": [
    {
     "@es": "Para no repetir el objeto directo, usa **le** (lo), **la** (la) o **les** (los, las): **Je prends le médicament** → **Je le prends**.",
     "@en": "To avoid repeating the direct object, use **le** (lo), **la** (la) or **les** (los, las): **Je prends le médicament** → **Je le prends**."
    },
    {
     "@es": "Delante de vocal o **h** muda, **le/la** se escribe **l'**: **J'aime le café** → **Je l'aime**.",
     "@en": "In front of Vowel or **h** muda, **le/la** is written **l'**: **J'aime le café** → **Je l'aime**."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Dónde va el pronombre",
    "@en": "Where the pronoun goes"
   },
   "texto": [
    {
     "@es": "El pronombre va **delante del verbo conjugado**: **Je le prends**, **Tu la veux ?** (¿la quieres?).",
     "@en": "The pronoun goes **delante del verbo conjugado**: **Je le prends**, **Tu la veux ?** (do you want it?)."
    },
    {
     "@es": "Si hay un infinitivo detrás, el pronombre va delante del infinitivo: **Je veux le voir** (quiero verlo). No se dice **Je le veux voir**.",
     "@en": "If there is an infinitive behind, the pronoun goes before the infinitive: **Je veux le voir** (I want to see it). It's not **Je le veux voir**."
    }
   ]
  },
  {
   "tipo": "tabla",
   "titulo": "Pronombres COD",
   "filas": [
    [
     "le",
     {
      "@es": "lo, el",
      "@en": "the, the"
     },
     "Je le prends."
    ],
