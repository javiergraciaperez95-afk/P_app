  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Invitar",
    "@en": "Invite"
   },
   "texto": [
    {
     "@es": "**Tu veux venir ?** (¿quieres venir?).",
     "@en": "**Tu veux venir ?** (do you want to come?)."
    },
    {
     "@es": "Para aceptar: **Avec plaisir !** (¡con mucho gusto!) o **Bonne idée !** (¡buena idea!). Para rechazar: **Désolé, je ne peux pas** (lo siento, no puedo).",
     "@en": "To accept: **Avec plaisir !** (with pleasure!) or **Bonne idée !** (good idea!). To reject: **Désolé, je ne peux pas** (I'm sorry, I can't)."
    },
    {
     "@es": "Para quedar: **On se retrouve à huit heures ?** (¿quedamos a las ocho?).",
     "@en": "To stay: **On se retrouve à huit heures ?** (are we left at 8: 00?)."
    }
   ]
  },
