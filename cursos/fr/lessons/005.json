 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Las profesiones",
    "@en": "The professions"
   },
   "texto": [
    {
     "@es": "Para preguntar a qué se dedica alguien: **Qu'est-ce que tu fais dans la vie ?** (literalmente «¿qué haces en la vida?»).",
     "@en": "To ask what one does: **Qu'est-ce que tu fais dans la vie ?** (literally «What are you doing in life?»)."
    },
    {
     "@es": "Al indicar una profesión con **être**, el nombre suele ir sin artículo: **Je suis médecin**, **Elle est professeur**.",
     "@en": "When you indicate a profession with **être**, the name usually goes without article: **Je suis médecin**, **Elle est professeur**."
    },
    {
     "@es": "Muchas profesiones tienen femenino: **étudiant** → **étudiante**, **infirmier** → **infirmière**, **serveur** → **serveuse**, **vendeur** → **vendeuse**.",
     "@en": "Many professions have feminine: **étudiant** → **étudiante**, **infirmier** → **infirmière**, **serveur** → **serveuse**, **vendeur** → **vendeuse**."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "El plural de «être»",
    "@en": "«être» plural"
   },
   "texto": [
    {
     "@es": "**Nous** = nosotros. **Ils** = ellos. **Elles** = ellas.",
     "@en": "**Nous** = us. **Ils** = them. **Elles** = them."
    },
    {
     "@es": "Muchos nombres y adjetivos forman el plural con **-s**; esta marca suele ser muda al final: **étudiant** y **étudiants** suenan igual.",
     "@en": "Many names and adjectives form the plural with **-s**; this mark is usually mute at the end: **étudiant** and **étudiants** sound the same."
    },
    {
     "@es": "Si en un grupo hay al menos un hombre, se usa **ils**.",
     "@en": "If there is at least one man in a group, **ils** is used."
    }
   ]
  },
