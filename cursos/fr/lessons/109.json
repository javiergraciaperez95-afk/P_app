 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": "Certes... mais",
   "texto": [
    {
     "@es": "**Certes** (ciertamente) reconoce un punto, y **mais** (pero) introduce la objeción: **Certes, il est riche, mais il est triste** (ciertamente es rico, pero está triste).",
     "@en": "**Certes** (certainly) recognizes a point, and **mais** (but) introduces the objection: **Certes, il est riche, mais il est triste** (certainly rich, but sad)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": "Il est vrai que, je reconnais que",
   "texto": [
    {
     "@es": "**Il est vrai que** + frase (es verdad que) y **je reconnais que** (reconozco que) también van con indicativo: **Il est vrai que Paul travaille beaucoup** (es verdad que Paul trabaja mucho).",
     "@en": "**Il est vrai que** + sentence (it's true that) and **je reconnais que** (I recognize that) also go with an indication: **Il est vrai que Paul travaille beaucoup** (it's true that Paul works a lot)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": "Concéder",
   "texto": [
    {
     "@es": "**Je te concède ce point** (te concedo ese punto) introduce una concesión personal.",
     "@en": "**Je te concède ce point** (I grant you that point) introduces a personal concession."
    }
   ]
  },
