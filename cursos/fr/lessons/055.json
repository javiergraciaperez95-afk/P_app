 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Il faut + infinitivo",
    "@en": "Il faut + infinitive"
   },
   "texto": [
    {
     "@es": "**Il faut** (hay que) va seguido de infinitivo. No cambia según la persona: **Il faut partir** (hay que irse).",
     "@en": "**Il faut** (it has to) is followed by infinitive. It does not change according to the person: **Il faut partir** (you must leave)."
    },
    {
     "@es": "Para decir que algo no se debe hacer: **Il ne faut pas** + infinitivo: **Il ne faut pas fumer ici** (no hay que fumar aquí).",
     "@en": "To say that something should not be done: **Il ne faut pas** + infinitive: **Il ne faut pas fumer ici** (do not smoke here)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Devoir + infinitivo",
    "@en": "Devoir + infinitive"
   },
   "texto": [
    {
     "@es": "**Devoir** (deber, tener que) cambia según la persona: **je dois** (debo), **tu dois** (debes), **il doit** (debe), **nous devons** (debemos).",
     "@en": "**Devoir** (duty, have to) changes according to the person: **je dois** (must), **tu dois** (must), **il doit** (must), **nous devons** (must)."
    },
    {
     "@es": "Después va infinitivo: **Nous devons payer** (tenemos que pagar).",
     "@en": "Then it goes infinitive: **Nous devons payer** (we have to pay)."
    }
   ]
  },
