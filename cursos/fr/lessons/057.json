  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Cuál es la diferencia de uso entre «pourquoi» y «parce que»?",
    "@en": "What is the difference in use between «pourquoi» and «parce que»?"
   },
   "id": "fr057-8",
   "opciones": [
    {
     "texto": {
      "@es": "«Pourquoi» introduce una pregunta de motivo y «parce que» introduce la respuesta explicativa.",
      "@en": "«Pourquoi» introduces a motif question and «parce que» introduces the explanatory answer."
     },
     "explicacion": {
      "@es": "«Pourquoi» significa «por qué» interrogativo, mientras que «parce que» es la conjunción causal «porque».",
      "@en": "«Pourquoi» means interrogative «Why?», while «parce que» is the causal conjunction «because»."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "«Pourquoi» se usa solo para responder y «parce que» solo para preguntar.",
      "@en": "«Pourquoi» is used only to answer and «parce que» only to ask."
     },
     "explicacion": {
      "@es": "En francés se pregunta con «pourquoi» y se contesta con «parce que», nunca a la inversa.",
      "@en": "In French you ask with «pourquoi» and you answer with «parce que», never the other way around."
     }
    },
    {
     "texto": {
      "@es": "Ambas formas son intercambiables tanto en preguntas como en respuestas.",
      "@en": "Both forms are interchangeable in both questions and answers."
     },
     "explicacion": {
      "@es": "En francés «pourquoi» y «parce que» desempeñan funciones sintácticas distintas y no pueden intercambiarse libremente.",
      "@en": "In French «pourquoi» and «parce que» perform different syntactic functions and cannot be freely exchanged."
     }
    }
   ]
  }
