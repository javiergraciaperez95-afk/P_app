     }
    },
    {
     "texto": {
      "@es": "Llueve porque me quedo.",
      "@en": "It's raining because I'm staying."
     },
     "explicacion": {
      "@es": "Eso invierte la lógica.",
      "@en": "That inverts logic."
     }
    }
   ]
