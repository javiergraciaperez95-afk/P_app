  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Cómo se pregunta «¿por qué no vienes?»?",
    "@en": "How do you ask «Why don't you come?»?"
   },
   "id": "fr057-1",
   "opciones": [
    {
     "texto": "Pourquoi tu ne viens pas ?",
     "explicacion": {
      "@es": "«Pourquoi» pregunta el motivo.",
      "@en": "«Pourquoi» asks the reason."
     },
     "correcta": true
    },
    {
     "texto": "Parce que tu ne viens pas ?",
     "explicacion": {
      "@es": "«Parce que» sirve para responder, no para preguntar.",
      "@en": "«Parce que» serves to answer, not to ask."
     }
    },
    {
     "texto": "Donc tu ne viens pas ?",
     "explicacion": {
      "@es": "«Donc» significa «así que».",
      "@en": "«Donc» means «So»."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué significa «il pleut, donc je reste»?",
