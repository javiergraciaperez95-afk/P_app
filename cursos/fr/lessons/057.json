 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Preguntar y responder",
    "@en": "Ask and answer"
   },
   "texto": [
    {
     "@es": "**Pourquoi** pregunta por qué: **Pourquoi tu ne viens pas ?** (¿por qué no vienes?).",
     "@en": "**Pourquoi** asks why: **Pourquoi tu ne viens pas ?** (why don't you come?)."
    },
    {
     "@es": "**Parce que** responde: **Parce que je suis fatigué** (porque estoy cansado).",
     "@en": "**Parce que** responds: **Parce que je suis fatigué** (because I am tired)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": "Mais, donc, alors",
   "texto": [
    {
     "@es": "**Mais** = pero: **Je suis fatigué, mais je viens** (estoy cansado, pero voy).",
     "@en": "**Mais** = but: **Je suis fatigué, mais je viens** (I'm tired, but I'm going)."
    },
    {
     "@es": "**Donc** = así que, por eso: **Il pleut, donc je reste à la maison** (llueve, así que me quedo en casa).",
     "@en": "**Donc** = so, that's why: **Il pleut, donc je reste à la maison** (it rains, so I stay home)."
    },
    {
     "@es": "**Alors** = entonces: **Alors, on part ?** (¿entonces, nos vamos?).",
     "@en": "**Alors** = then: **Alors, on part ?** (then, we go?)."
    }
   ]
  },
