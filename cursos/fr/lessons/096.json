   },
   "texto": [
    {
     "@es": "Para dar tu opinión: **selon moi** (según yo), **à mon avis** (a mi parecer), **personnellement** (personalmente).",
     "@en": "To give your opinion: **selon moi** (according to me), **à mon avis** (in my opinion), **personnellement** (personally)."
    },
    {
     "@es": "Para estar de acuerdo o no: **Je suis d'accord** (estoy de acuerdo), **Je ne suis pas d'accord** (no estoy de acuerdo).",
     "@en": "To agree or not: **Je suis d'accord** (I agree), **Je ne suis pas d'accord** (I disagree)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Argumentar",
    "@en": "Argument"
   },
   "texto": [
