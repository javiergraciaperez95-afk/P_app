  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Cómo se dice «pregunta si vienes»?",
    "@en": "How do you say «Ask if you're coming.»?"
   },
   "id": "fr089-1",
   "opciones": [
    {
     "texto": "Il demande si tu viens.",
     "explicacion": {
      "@es": "«Si» introduce una pregunta indirecta de sí o no.",
      "@en": "«Si» introduces an indirect question of yes or no."
     },
     "correcta": true
    },
    {
     "texto": "Il demande tu viens ?",
     "explicacion": {
      "@es": "Falta «si».",
      "@en": "«si» is missing."
     }
    },
    {
     "texto": "Il demande que tu viennes.",
     "explicacion": {
      "@es": "Eso es subjuntivo, no pregunta.",
      "@en": "That's subjunctive, he doesn't ask."
     }
    }
   ]
