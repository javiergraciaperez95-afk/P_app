 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Formación",
    "@en": "Training"
   },
   "texto": [
    {
     "@es": "Se forma con el imperfecto de **avoir** o **être** + participio pasado: **j'avais mangé** (había comido), **j'étais parti** (me había ido).",
     "@en": "It is formed with the imperfect **avoir** or **être** + past participle: **j'avais mangé** (had eaten), **j'étais parti** (had gone)."
    },
    {
     "@es": "Con **être** el participio concuerda con el sujeto, como en el passé composé: **Elle était partie** (ella se había ido).",
     "@en": "With **être** the participle matches the subject, as in the composite passé: **Elle était partie** (she was gone)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Cuándo se usa",
    "@en": "When used"
   },
   "texto": [
    {
     "@es": "Para una acción anterior a otra acción pasada: **Quand je suis arrivé, il était déjà parti** (cuando llegué, ya se había ido).",
     "@en": "For an action prior to another past action: **Quand je suis arrivé, il était déjà parti** (when I arrived, it was already gone)."
    },
    {
     "@es": "Compara con el español: en francés «había» + participio es igual que en español.",
     "@en": "Compare with Spanish: in French «there was» + participle is the same as in Spanish."
    }
   ]
  },
