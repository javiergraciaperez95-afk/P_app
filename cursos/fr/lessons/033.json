  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "En el hotel",
    "@en": "At the hotel"
   },
   "texto": [
    {
     "@es": "Al llegar: **J'ai une réservation** (tengo una reserva).",
     "@en": "When you arrive: **J'ai une réservation** (I have a reservation)."
    },
    {
     "@es": "Las habitaciones: **une chambre simple** (individual) y **une chambre double** (doble). Las noches: **pour deux nuits**.",
     "@en": "The rooms: **une chambre simple** (individual) and **une chambre double** (double). The nights: **pour deux nuits**."
    },
    {
     "@es": "Para confirmar: **C'est ça** (eso es).",
     "@en": "To confirm: **C'est ça** (that is)."
    },
    {
     "@es": "Las plantas se dicen con ordinales: **au premier étage**, **au deuxième étage**, **au troisième étage**.",
     "@en": "The plants are said with ordinals: **au premier étage**, **au deuxième étage**, **au troisième étage**."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Si no te encuentras bien",
    "@en": "If you're not feeling well"
   },
   "texto": [
    {
     "@es": "**Ça ne va pas ?** = ¿no estás bien?",
     "@en": "**Ça ne va pas ?** = aren't you okay?"
    },
    {
     "@es": "**Je ne me sens pas bien** = no me encuentro bien. **Je suis malade** = estoy enfermo.",
     "@en": "**Je ne me sens pas bien** = I'm not feeling well. **Je suis malade** = I'm sick."
    },
    {
     "@es": "Los dolores se dicen con **avoir mal à**: **J'ai mal à la tête** (me duele la cabeza), **J'ai mal au ventre** (me duele la tripa), **J'ai mal aux dents** (me duelen las muelas).",
     "@en": "The pains are said with **avoir mal à**: **J'ai mal à la tête** (my head hurts), **J'ai mal au ventre** (my stomach hurts), **J'ai mal aux dents** (my teeth hurt)."
    }
   ]
  },
