   "tipo": "explicacion",
   "titulo": {
    "@es": "Formación",
    "@en": "Training"
   },
   "texto": [
    {
     "@es": "Se forma con el conditionnel de **avoir** o **être** + participio pasado: **j'aurais mangé** (habría comido), **je serais parti** (me habría ido).",
     "@en": "It is formed with the conditionnel of **avoir** or **être** + past participle: **j'aurais mangé** (would have eaten), **je serais parti** (would have gone)."
    },
    {
     "@es": "Con **être** el participio concuerda con el sujeto: **Elle serait venue** (ella habría venido).",
     "@en": "With **être** the participle matches the subject: **Elle serait venue** (she would have come)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Para qué se usa",
    "@en": "What is it used for?"
   },
   "texto": [
    {
     "@es": "Para lamentar algo que no pasó: **J'aurais aimé venir** (me habría gustado venir).",
     "@en": "To regret something that didn't happen: **J'aurais aimé venir** (I would have liked to come)."
    },
    {
     "@es": "Para criticar: **J'aurais dû le dire** (debería haberlo dicho).",
     "@en": "To criticize: **J'aurais dû le dire** (I should have said it)."
    }
   ]
  },
