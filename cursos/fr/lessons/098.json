 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Formación",
    "@en": "Training"
   },
   "texto": [
    {
     "@es": "Se forma con el subjuntivo presente de **avoir** o **être** + participio pasado: **que j'aie fini** (que haya terminado), **que tu sois venu** (que hayas venido).",
     "@en": "It is formed with the present subjunctive of **avoir** or **être** + past participle: **que j'aie fini** (which is finished), **que tu sois venu** (which you have come)."
    },
    {
     "@es": "Con **être** el participio concuerda con el sujeto: **que tu sois venue** (si eres mujer).",
     "@en": "With **être** the participle matches the subject: **que tu sois venue** (if you are a woman)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Cuándo se usa",
    "@en": "When used"
   },
   "texto": [
    {
     "@es": "Cuando la acción es anterior al momento que hablamos y va con subjuntivo: **Je suis content que tu aies réussi ton examen** (me alegra que hayas aprobado el examen).",
     "@en": "When the action is before the moment we speak and goes with subjunctive: **Je suis content que tu aies réussi ton examen** (I'm glad you passed the test)."
    }
   ]
  },
