  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Emociones + que + subjuntivo",
    "@en": "Emotions + that + subjunctive"
   },
   "texto": [
    {
     "@es": "Después de un sentimiento se usa subjuntivo: **Je suis content que tu sois là** (me alegra que estés aquí).",
     "@en": "After a feeling is used subjunctive: **Je suis content que tu sois là** (I'm glad you're here)."
    },
    {
     "@es": "Lo mismo con **triste**, **surpris**, **inquiet** (preocupado), **heureux** (feliz) o **C'est normal que** (es normal que).",
     "@en": "The same with **triste**, **surpris**, **inquiet** (concerned), **heureux** (happy) or **C'est normal que** (it's normal that)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Ojo",
    "@en": "Eye"
   },
   "texto": [
    {
     "@es": "Si el sujeto es el mismo, no hay «que»: **Je suis content d'être là** (me alegra estar aquí).",
     "@en": "If the subject is the same, there is no «que»: **Je suis content d'être là** (I'm glad to be here)."
    }
   ]
  },
