 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Pour + infinitivo",
    "@en": "Pour + infinitive"
   },
   "texto": [
    {
     "@es": "**Pour** + infinitivo expresa finalidad cuando la misma persona hace las dos acciones: **Je vais au supermarché pour acheter du pain** (voy al supermercado para comprar pan).",
     "@en": "**Pour** + infinitive expresses purpose when the same person makes the two shares: **Je vais au supermarché pour acheter du pain** (I go to the supermarket to buy bread)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Pour o parce que",
    "@en": "Pour or parce that"
   },
   "texto": [
    {
     "@es": "**Pour** + infinitivo dice para qué se hace algo; **parce que** + frase conjugada explica el motivo: **Je travaille pour vivre** / **Je reste parce que je suis fatigué**. No se dice **parce que vivre**.",
     "@en": "**Pour** + infinitive says why something is done; **parce que** + conjugated phrase explains the motive: **Je travaille pour vivre** / **Je reste parce que je suis fatigué**. It's not **parce que vivre**."
    }
   ]
  },
