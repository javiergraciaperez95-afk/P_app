   },
   "id": "fr001-1",
   "opciones": [
    {
     "texto": "Bonjour",
     "explicacion": {
      "@es": "Es el saludo estándar durante el día.",
      "@en": "It's the standard day greeting."
     },
     "correcta": true
    },
    {
     "texto": "Salut",
     "explicacion": {
      "@es": "Es informal; se usa con personas de confianza.",
      "@en": "It is informal; it is used with people of trust."
     }
    },
    {
     "texto": "Au revoir",
     "explicacion": {
      "@es": "Es una despedida.",
      "@en": "It's a farewell."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
