{
 "capitulo": 1,
 "titulo_fr": "Bonjour !",
 "titulo_es": {
  "@es": "Saludar y decir cómo te llamas",
  "@en": "Say hello and say your name"
 },
 "palabras": {
  "bonjour": {
   "es": "hola, buenos días",
   "en": "Hello, good morning.",
   "pron": "bo(n)-ZHUR"
  },
  "salut": {
   "es": "hola; adiós (informal)",
   "en": "Hello; goodbye (informal)",
   "pron": "sa-LÜ",
   "consejo": {
    "@es": "La t final no se pronuncia. La u francesa se dice poniendo los labios de «u» y diciendo «i».",
    "@en": "The final t is not pronounced. The French u is said to be putting the lips of «u» and saying «i»."
   }
  },
  "bonsoir": {
   "es": "buenas tardes, buenas noches",
   "en": "Good evening, good night",
   "pron": "bo(n)-SUAR"
  },
  "au revoir": {
   "es": "adiós",
   "en": "Bye.",
   "pron": "o re-VUAR"
  },
  "je": {
   "es": "yo",
   "en": "I",
   "pron": "zhe",
   "consejo": {
    "@es": "La «j» francesa suena como una «sh» con voz.",
    "@en": "The French «j» sounds like a «sh» with a voice."
   }
  },
  "je m'appelle": {
   "es": "me llamo",
   "en": "My name is",
   "pron": "zhe ma-PEL"
  },
  "tu": {
   "es": "tú",
   "en": "You",
   "pron": "tü"
  },
  "vous": {
   "es": "usted; vosotros",
   "en": "You; you",
   "pron": "vu"
  },
  "comment": {
   "es": "cómo",
   "en": "how",
   "pron": "co-MA(N)"
  },
  "comment tu t'appelles": {
   "es": "¿cómo te llamas?",
   "en": "What's your name?",
   "pron": "co-MA(N) tü ta-PEL"
  },
  "comment vous vous appelez": {
   "es": "¿cómo se llama usted?",
   "en": "What's your name?",
   "pron": "co-MA(N) vu vu-sa-PLÉ"
  },
  "et": {
   "es": "y",
   "en": "and",
   "pron": "e"
  },
  "toi": {
   "es": "tú (solo o con énfasis)",
   "en": "you (alone or with emphasis)",
   "pron": "tuá"
  },
  "moi": {
   "es": "yo (solo o con énfasis)",
   "en": "me (alone or with emphasis)",
   "pron": "muá"
  },
  "enchanté": {
   "es": "encantado",
   "en": "Enchanted.",
   "pron": "a(n)-sha(n)-TÉ"
  },
  "enchantée": {
   "es": "encantada",
   "en": "enchanted",
   "pron": "a(n)-sha(n)-TÉ",
   "consejo": {
    "@es": "Suena igual que el masculino; solo cambia al escribir.",
    "@en": "It sounds just like the masculine; it only changes when you write."
   }
  },
  "oui": {
   "es": "sí",
   "en": "Yes.",
   "pron": "uí"
  },
  "non": {
   "es": "no",
   "en": "No.",
   "pron": "no(n)"
  },
  "merci": {
   "es": "gracias",
   "en": "Thank you.",
   "pron": "mer-SÍ"
  },
  "madame": {
   "es": "señora",
   "en": "Madam.",
   "pron": "ma-DAM"
  },
  "monsieur": {
   "es": "señor",
   "en": "Sir.",
   "pron": "me-SIÖ"
  }
 },
 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Saludar",
    "@en": "Say hello"
   },
   "texto": [
    {
     "@es": "**Bonjour** es el saludo habitual durante el día, tanto en situaciones formales como informales. Al anochecer suele usarse **bonsoir**.",
     "@en": "**Bonjour** is the usual greeting during the day, in both formal and informal situations. In the evening **bonsoir** is usually used."
    },
    {
     "@es": "**Salut** es informal y sirve para saludar y para despedirse. Para despedirte en una situación formal: **au revoir**.",
     "@en": "**Salut** is informal and serves to greet and say goodbye. To say goodbye in a formal situation: **au revoir**."
    },
    {
     "@es": "En francés es de buena educación añadir **madame** o **monsieur**: **Bonjour, madame**.",
     "@en": "In French it is of good education to add **madame** or **monsieur**: **Bonjour, madame**."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": "Tu y vous",
   "texto": [
    {
     "@es": "**Tu** es «tú»: se usa con amigos, familia y niños. **Vous** es «usted» y también «vosotros». Con un adulto que no conoces, **vous** es una opción cortés y segura; las costumbres pueden variar según la relación y el contexto.",
     "@en": "**Tu** is «You»: it is used with friends, family and children. **Vous** is «You» and also «You.». With an adult you don't know, **vous** is a safe and courteous option; customs may vary according to relationship and context."
    },
    {
     "@es": "Para decir tu nombre: **Je m'appelle Léa** (me llamo Léa).",
     "@en": "To say your name: **Je m'appelle Léa** (my name is Léa)."
    },
    {
     "@es": "Para preguntarlo: **Comment tu t'appelles ?** (informal) o **Comment vous vous appelez ?** (formal).",
     "@en": "To ask: **Comment tu t'appelles ?** (informal) or **Comment vous vous appelez ?** (formal)."
    },
    {
     "@es": "Detalle de escritura: en francés se deja un espacio antes de **?** y de **!**.",
     "@en": "Writing detail: in French a space is left before **?** and **!**."
    }
   ]
  },
