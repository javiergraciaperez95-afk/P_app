  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué matiz introduce la expresión «tout en» delante de un gérondif?",
    "@en": "What nuance does the «tout en» expression introduce in front of a gerondif?"
   },
   "id": "fr086-8",
   "opciones": [
    {
     "texto": "Enfatiza la estricta simultaneidad entre dos acciones.",
     "explicacion": {
      "@es": "«Tout en + gérondif» resalta que ambas acciones ocurren exactamente a la vez.",
      "@en": "«Tout en + gérondif» highlights that both actions occur exactly at the same time."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Indica que una acción ocurrió con anterioridad a la otra.",
      "@en": "It indicates that one action occurred prior to the other."
     },
     "explicacion": {
      "@es": "Para anterioridad se emplearía «après avoir» o «avant de».",
      "@en": "«après avoir» or «avant de» would be used prior."
     }
    },
    {
     "texto": {
      "@es": "Expresa una relación de causa absoluta e indiscutible.",
      "@en": "It expresses an absolute and indisputable relationship of cause."
     },
     "explicacion": {
      "@es": "Expresa simultaneidad (o concesión), no una causa pura.",
      "@en": "It expresses simularity (or concession), not a pure cause."
     }
    }
   ]
