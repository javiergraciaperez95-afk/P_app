   "texto": [
    {
     "@es": "Los meses van en **minúscula** y con **en**: **en juillet**.",
     "@en": "The months go to **minúscula** and with **en**: **en juillet**."
    },
    {
     "@es": "Las estaciones: **en été** (en verano), **en automne**, **en hiver**, pero **au printemps** (en primavera).",
     "@en": "The seasons: **en été** (in summer), **en automne**, **en hiver**, but **au printemps** (in spring)."
    },
    {
     "@es": "La fecha se dice con **le** y el número normal, sin «de»: **le 3 décembre** (el 3 de diciembre). Solo el día 1 es distinto: **le premier mai**.",
     "@en": "The date is said with **le** and the normal number, without «de»: **le 3 décembre** (December 3). Only day 1 is different: **le premier mai**."
    }
