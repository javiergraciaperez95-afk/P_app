   "tipo": "test",
   "pregunta": {
    "@es": "¿Cómo se dice «deberías dormir más»?",
    "@en": "How do you say «You should sleep more.»?"
   },
   "id": "fr056-1",
   "opciones": [
    {
     "texto": "Tu devrais dormir plus.",
     "explicacion": {
      "@es": "«Devrais» da un consejo.",
      "@en": "«Devrais» gives a tip."
     },
     "correcta": true
    },
    {
     "texto": "Tu dois dormir plus.",
     "explicacion": {
      "@es": "Eso es una obligación, no un consejo.",
      "@en": "That's an obligation, not a tip."
     }
    },
    {
     "texto": "Tu devrais dormir moins.",
     "explicacion": {
      "@es": "Eso significa «deberías dormir menos».",
      "@en": "That means «You should sleep less.»."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
