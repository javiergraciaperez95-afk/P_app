 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Futuro próximo o futuro simple",
    "@en": "Next future or simple future"
   },
   "texto": [
    {
     "@es": "Para lo que pasa ya o muy pronto, usa **aller** + infinitivo: **Je vais travailler demain** (voy a trabajar mañana).",
     "@en": "For what happens already or very soon, use **aller** + infinitive: **Je vais travailler demain** (I will work tomorrow)."
    },
    {
     "@es": "Para lo que pasará más adelante o para una predicción, usa el futuro simple: **Dans dix ans, je travaillerai à l'étranger** (dentro de diez años, trabajaré en el extranjero).",
     "@en": "For what will happen later or for a prediction, use the simple future: **Dans dix ans, je travaillerai à l'étranger** (within ten years, I will work abroad)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Cuando hablas del futuro con quand",
    "@en": "When you talk about the future with quand"
   },
   "texto": [
    {
     "@es": "Después de **quand** (cuando) también va futuro: **Quand je serai grand, je serai professeur** (cuando sea mayor, seré profesor).",
     "@en": "After **quand** (when) also goes future: **Quand je serai grand, je serai professeur** (when I am older, I will be a teacher)."
    }
   ]
  },
