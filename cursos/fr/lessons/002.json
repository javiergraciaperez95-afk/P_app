 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "¿Qué tal?",
    "@en": "How are you?"
   },
   "texto": [
    {
     "@es": "Entre amigos se pregunta **Ça va ?** y se responde igual: **Ça va** o **Ça va bien, merci**.",
     "@en": "Among friends you ask **Ça va ?** and answer the same: **Ça va** or **Ça va bien, merci**."
    },
    {
     "@es": "Con «vous»: **Comment allez-vous ?** (¿cómo está usted?). Se responde **Très bien, merci**.",
     "@en": "With «vous»: **Comment allez-vous ?** (how are you?). **Très bien, merci** is answered."
    },
    {
     "@es": "Otras respuestas: **Pas mal** (no estoy mal), **Je suis fatigué** (estoy cansado).",
     "@en": "Other answers: **Pas mal** (not bad), **Je suis fatigué** (I'm tired)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Presentar a alguien",
    "@en": "Present someone"
   },
   "texto": [
    {
     "@es": "**Voici Emma** (esta es Emma). **C'est mon amie** (es mi amiga).",
     "@en": "**Voici Emma** (this is Emma). **C'est mon amie** (is my friend)."
    },
    {
     "@es": "**Il** es «él» y **elle** es «ella»: **Il est professeur**, **Elle est étudiante**.",
     "@en": "**Il** is «He» and **elle** is «her.»: **Il est professeur**, **Elle est étudiante**."
    },
    {
     "@es": "**Ami** es «amigo» y **amie**, «amiga»; la **-e** final de **amie** no se pronuncia.",
     "@en": "**Ami** is «Dude.» and **amie**, «friend»; **-e** final **amie** is not pronounced."
    },
    {
     "@es": "Muchos adjetivos añaden **-e** en femenino: fatigué → **fatiguée**. A veces no cambia el sonido, pero sí la escritura.",
     "@en": "Many adjectives add **-e** in feminine: I tipped → **fatiguée**. Sometimes it doesn't change the sound, but it does."
    }
   ]
  },
