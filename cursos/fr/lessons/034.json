   "titulo": {
    "@es": "Algo que acaba de pasar",
    "@en": "Something that just happened."
   },
   "texto": [
    {
     "@es": "Para decir que algo acaba de ocurrir, usa **venir** en presente + **de** + infinitivo: **Je viens de finir** (acabo de terminar).",
     "@en": "To say that something just happened, use **venir** in present + **de** + infinitive: **Je viens de finir** (just finished)."
    },
    {
     "@es": "El verbo principal se queda en infinitivo: **Elle vient de rentrer**, **Nous venons de manger**.",
     "@en": "The main verb remains in infinitive: **Elle vient de rentrer**, **Nous venons de manger**."
    },
    {
     "@es": "El presente de **venir** es irregular; fíjate en las formas de la tabla.",
     "@en": "The present of **venir** is irregular; see the shapes of the table."
    }
   ]
