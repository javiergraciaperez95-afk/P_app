 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Où (lugar y momento)",
    "@en": "Où (place and time)"
   },
   "texto": [
    {
     "@es": "**Où** = donde o en el que: **C'est le restaurant où nous mangeons** (es el restaurante donde comemos).",
     "@en": "**Où** = where or where: **C'est le restaurant où nous mangeons** (is the restaurant where we eat)."
    },
    {
     "@es": "También se usa para el momento: **C'est le moment où tout le monde mange** (es el momento en que todos comen).",
     "@en": "It is also used for the moment: **C'est le moment où tout le monde mange** (it is the time when everyone eats)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Dont (de quien, de lo que)",
    "@en": "Dont (from whom, from which)"
   },
   "texto": [
    {
     "@es": "**Dont** sustituye a **de** + sustantivo: **C'est le film dont tout le monde parle** (es la película de la que todo el mundo habla).",
     "@en": "**Dont** replaces **de** + substantive: **C'est le film dont tout le monde parle** (it is the film that everyone is talking about)."
    },
    {
     "@es": "Con «parler de» se usa **dont**; no hace falta añadir nada más: se dice **dont**, no **de que**.",
     "@en": "«parler de» uses **dont**; there is no need to add any more: **dont** is said, not **de que**."
    }
   ]
