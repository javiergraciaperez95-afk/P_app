   "texto": [
    {
     "@es": "Se forma con el futuro (la raíz) + las terminaciones del imperfecto: **-ais, -ais, -ait, -ions, -iez, -aient**.",
     "@en": "It is formed with the future (the root) + the endings of the imperfect: **-ais, -ais, -ait, -ions, -iez, -aient**."
    },
    {
     "@es": "Ejemplo: **je pourrais** (podría), **nous voudrions** (querríamos), **ils seraient** (serían).",
     "@en": "Example: **je pourrais** (could), **nous voudrions** (we would want), **ils seraient** (would)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Para qué se usa",
    "@en": "What is it used for?"
   },
   "texto": [
    {
     "@es": "Para pedir con cortesía: **Je voudrais** (ya lo conoces).",
     "@en": "To ask with courtesy: **Je voudrais** (you know it)."
    },
    {
     "@es": "Para algo posible o un deseo: **Je ferais le voyage** (haría el viaje).",
     "@en": "For something possible or a wish: **Je ferais le voyage** (I would make the trip)."
    },
    {
     "@es": "Para aconsejar: **Tu devrais dormir** (deberías dormir).",
     "@en": "To advise: **Tu devrais dormir** (you should sleep)."
    }
   ]
  },
