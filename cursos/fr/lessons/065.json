    {
     "texto": "Avec plaisir !",
     "explicacion": {
      "@es": "Es la locución estándar en francés para aceptar una propuesta cordialmente.",
      "@en": "It is the standard French locution to accept a proposal cordially."
     },
     "correcta": true
    },
    {
     "texto": "De rien !",
     "explicacion": {
      "@es": "«De rien» se usa para responder a un agradecimiento («de nada»), no para aceptar una invitación.",
      "@en": "«De rien» is used to respond to a thank you («You're welcome.»), not to accept an invitation."
     }
    },
