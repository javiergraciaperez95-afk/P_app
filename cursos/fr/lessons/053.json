 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": "Pas de, pas encore, pas du tout",
   "texto": [
    {
     "@es": "**Pas de** + sustantivo = ningún: **Je n'ai pas de travail** (no tengo trabajo).",
     "@en": "**Pas de** + noun = none: **Je n'ai pas de travail** (I have no job)."
    },
    {
     "@es": "**Pas encore** = todavía no: **Je ne travaille pas encore** (todavía no trabajo).",
     "@en": "**Pas encore** = not yet: **Je ne travaille pas encore** (not yet working)."
    },
    {
     "@es": "**Pas du tout** = para nada: **Je n'aime pas du tout le lundi** (no me gustan nada los lunes).",
     "@en": "**Pas du tout** = not at all: **Je n'aime pas du tout le lundi** (I don't like it on Monday)."
    }
   ]
  },
