  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué conector completa la serie cronológica: «___, je prends le train. Ensuite, je prends le métro. Enfin, j'arrive au bureau.»?",
    "@en": "What connector completes the chronological series: Ensuite, je prices le metro. So, j-arrive au-bureau."
   },
   "id": "fr058-8",
   "opciones": [
    {
     "texto": "D'abord",
     "explicacion": {
      "@es": "«D'abord» encabeza cronológicamente el primer elemento de una serie de acciones cotidianas.",
      "@en": "«D'abord» heads the first element of a series of daily actions chronologically."
     },
     "correcta": true
    },
    {
     "texto": "Enfin",
     "explicacion": {
      "@es": "«Enfin» se reserva para el desenlace o último paso de la serie, no para el inicio.",
      "@en": "«Enfin» is reserved for the outcome or last step of the series, not for the start."
     }
    },
    {
     "texto": "Mais",
     "explicacion": {
      "@es": "«Mais» es una conjunción adversativa de contraste («pero»), no un conector cronológico de apertura.",
      "@en": "«Mais» is an adverse contrast conjunction («but»), not an opening chronological connector."
     }
    }
   ]
  }
