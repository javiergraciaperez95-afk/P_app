 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": "Bon → meilleur",
   "texto": [
    {
     "@es": "**Bon** (bueno) cambia en **meilleur** (mejor). Como adjetivo, concuerda: **un meilleur café**, **une meilleure idée**, **de meilleurs cafés**.",
     "@en": "**Bon** (good) changes in **meilleur** (better). As an adjective, it matches: **un meilleur café**, **une meilleure idée**, **de meilleurs cafés**."
    },
    {
     "@es": "No se dice **plus bon**.",
     "@en": "It's not **plus bon**."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": "Bien → mieux",
   "texto": [
    {
     "@es": "**Bien** (bien) es un adverbio y cambia en **mieux** (mejor): **Tu parles mieux français que moi**. **Meilleur** es un adjetivo que concuerda con el nombre; **mieux** suele modificar un verbo.",
     "@en": "**Bien** (well) is a warning and changes in **mieux** (better): **Tu parles mieux français que moi**. **Meilleur** is an adjective that matches the name; **mieux** usually modifies a verb."
    }
   ]
  },
