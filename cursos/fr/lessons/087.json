   "pregunta": {
    "@es": "¿Qué significa «en arrivant»?",
    "@en": "What does «en arrivant» mean?"
   },
   "id": "fr087-1",
   "opciones": [
    {
     "texto": {
      "@es": "Al llegar.",
      "@en": "When I get there."
     },
     "explicacion": {
      "@es": "«En» + gerundio = al llegar, mientras llego.",
      "@en": "«En» + gerundio = on arrival, as I arrive."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Después de llegar.",
      "@en": "After I got here."
     },
     "explicacion": {
      "@es": "Eso sería «après être arrivé».",
      "@en": "That would be «après être arrivé»."
     }
    },
    {
     "texto": {
      "@es": "Antes de llegar.",
      "@en": "Before we get there."
     },
     "explicacion": {
      "@es": "Eso sería «avant d'arriver».",
      "@en": "That would be «avant d'arriver»."
     }
    }
   ]
