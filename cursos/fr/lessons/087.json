 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": "En arrivant",
   "texto": [
    {
     "@es": "**En** + participio presente forma el gérondif: **En arrivant, j'ai vu Thomas** (al llegar, vi a Thomas).",
     "@en": "**En** + participle present forms the gerondif: **En arrivant, j'ai vu Thomas** (upon arrival, I saw Thomas)."
    },
    {
     "@es": "Relaciona dos acciones del mismo sujeto; según el contexto puede expresar simultaneidad, manera o una acción inmediatamente anterior.",
     "@en": "Relation to two actions of the same subject; depending on the context it can express simuleity, way or an immediately earlier action."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Mismo sujeto",
    "@en": "Same subject"
   },
   "texto": [
    {
     "@es": "En el uso normal, quien hace la acción del gérondif es también el sujeto de la oración principal: **En rentrant, je suis allé dormir** (al volver, me fui a dormir).",
     "@en": "In normal use, who does the action of the gerondif is also the subject of the main prayer: **En rentrant, je suis allé dormir** (when I returned, I went to sleep)."
    },
    {
     "@es": "No significa que ambas expresiones nombren una sola acción.",
     "@en": "It does not mean that both expressions name one action."
    }
   ]
  },
