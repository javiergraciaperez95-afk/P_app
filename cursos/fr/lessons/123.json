 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Faire + infinitivo",
    "@en": "Faire + infinitive"
   },
   "texto": [
    {
     "@es": "**Faire** + infinitivo significa «hacer que alguien haga algo» o «mandar hacer»: **Je fais réparer ma voiture** (mando reparar mi coche).",
     "@en": "**Faire** + infinitive means «make someone do something.» or «command to do»: **Je fais réparer ma voiture** (I control repair my car)."
    },
    {
     "@es": "No se dice **Je répare ma voiture** si la reparación la hace otra persona.",
     "@en": "**Je répare ma voiture** is not said if the repair is made by another person."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Lugar de los pronombres",
    "@en": "Place of pronouns"
   },
   "texto": [
    {
     "@es": "Los pronombres van delante de **faire**: **Je la fais réparer** (la mando reparar). El infinitivo no cambia.",
     "@en": "The pronouns go in front of **faire**: **Je la fais réparer** (the repair command). The infinitive does not change."
    }
   ]
  },
