 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": "Avant que, après que",
   "texto": [
    {
     "@es": "**Avant que** (antes de que) va con subjuntivo: **Avant que tu aies mangé, je pars** (me voy antes de que hayas comido).",
     "@en": "**Avant que** (before it) goes with subjunctive: **Avant que tu aies mangé, je pars** (I leave before you have eaten)."
    },
    {
     "@es": "**Après que** (después de que) va con indicativo: **Après que tu as mangé, on sort** (después de que comiste, salimos).",
     "@en": "**Après que** (after that) goes with an indication: **Après que tu as mangé, on sort** (after you ate, we go out)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Después de haber",
    "@en": "After there was"
   },
   "texto": [
    {
     "@es": "**Après avoir** + participio = después de haber: **Après avoir mangé, je dors** (después de comer, duermo). Es la forma más natural en francés.",
     "@en": "**Après avoir** + participle = after having: **Après avoir mangé, je dors** (after eating, I sleep). It's the most natural form in French."
    }
   ]
  },
