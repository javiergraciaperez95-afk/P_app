 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Pedir con educación",
    "@en": "Ask with education"
   },
   "texto": [
    {
     "@es": "**Je voudrais** (me gustaría, quisiera) es más educado que **je veux** (quiero).",
     "@en": "**Je voudrais** (I'd like to) is more educated than **je veux** (I want)."
    },
    {
     "@es": "Ejemplo: **Je voudrais un billet pour Lyon** (quisiera un billete para Lyon).",
     "@en": "Example: **Je voudrais un billet pour Lyon** (I would like a ticket for Lyon)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Otras formas educadas",
    "@en": "Other forms of education"
   },
   "texto": [
    {
     "@es": "**J'aimerais** (me gustaría) y **Pourriez-vous** (¿podría usted?).",
     "@en": "**J'aimerais** (I would like) and **Pourriez-vous** (could you?)."
    },
    {
     "@es": "Ejemplo: **Pourriez-vous répéter ?** (¿podría repetir?).",
     "@en": "Example: **Pourriez-vous répéter ?** (could you repeat?)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "El condicional presente",
    "@en": "The conditional is present"
   },
   "texto": [
    {
     "@es": "Se forma con la raíz del futuro y las terminaciones del imparfait: **-ais, -ais, -ait, -ions, -iez, -aient**.",
     "@en": "It is formed with the root of the future and the endings of the imparfait: **-ais, -ais, -ait, -ions, -iez, -aient**."
    },
    "**Vouloir** → **voudr-**: **je voudrais**. **Pouvoir** → **pourr-**: **vous pourriez**. **Aimer** → **aimer-**: **j'aimerais**."
   ]
  },
