  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Cómo se dice «hace una semana»?",
    "@en": "How do you say «A week ago»?"
   },
   "id": "fr062-1",
   "opciones": [
    {
     "texto": "Il y a une semaine.",
     "explicacion": {
      "@es": "«Il y a» + tiempo = hace.",
      "@en": "«Il y a» + time = ago."
     },
     "correcta": true
    },
    {
     "texto": "Depuis une semaine.",
     "explicacion": {
      "@es": "Eso es «desde hace».",
      "@en": "That's «since»."
     }
    },
    {
     "texto": "Pendant une semaine.",
     "explicacion": {
      "@es": "Eso es «durante».",
      "@en": "That's «during»."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Cómo se dice «durante dos horas»?",
    "@en": "How do you say «for two hours»?"
   },
   "id": "fr062-2",
   "opciones": [
    {
     "texto": "Pendant deux heures.",
     "explicacion": {
      "@es": "«Pendant» = durante.",
      "@en": "«Pendant» = during."
     },
     "correcta": true
    },
    {
     "texto": "Il y a deux heures.",
     "explicacion": {
      "@es": "Eso es «hace dos horas».",
      "@en": "That's «Two hours ago»."
     }
    },
    {
     "texto": "Depuis deux heures.",
     "explicacion": {
      "@es": "Eso es «desde hace dos horas».",
      "@en": "That's «for two hours»."
     }
    }
   ]
  },
