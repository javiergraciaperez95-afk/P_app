  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Cuál es la forma correcta de expresar la duración terminada «esperé durante dos horas»?",
    "@en": "What is the right way to express the finished duration «I waited for two hours.»?"
   },
   "id": "fr062-8",
   "opciones": [
    {
     "texto": "J'ai attendu pendant deux heures.",
     "explicacion": {
      "@es": "«Pendant» + periodo de tiempo cuantifica la duración de una acción.",
      "@en": "«Pendant» + time period quantifies the duration of a action."
     },
     "correcta": true
    },
    {
     "texto": "J'ai attendu il y a deux heures.",
     "explicacion": {
      "@es": "«Il y a» indica cuánto tiempo hace que ocurrió un hecho puntual, no su duración.",
      "@en": "«Il y a» indicates how long a punctual fact has occurred, not its duration."
     }
    },
    {
     "texto": "J'ai attendu depuis deux heures.",
     "explicacion": {
      "@es": "«Depuis» se combina con presente para hechos que continúan.",
      "@en": "«Depuis» is combined with present for continuing events."
     }
    }
   ]
