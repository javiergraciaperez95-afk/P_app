 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Alguien y algo",
    "@en": "Someone and something."
   },
   "texto": [
    {
     "@es": "**Quelqu'un** (alguien) y **quelque chose** (algo) se usan en frases afirmativas: **Il y a quelqu'un au bureau** (hay alguien en la oficina).",
     "@en": "**Quelqu'un** (someone) and **quelque chose** (something) are used in affirmative phrases: **Il y a quelqu'un au bureau** (there is someone in the office)."
    },
    {
     "@es": "**Tu veux quelque chose ?** (¿quieres algo?).",
     "@en": "**Tu veux quelque chose ?** (do you want something?)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Todo el mundo",
    "@en": "Everybody"
   },
   "texto": [
    {
     "@es": "**Tout le monde** (todo el mundo) va con verbo en singular: **Tout le monde aime le café** (a todo el mundo le gusta el café).",
     "@en": "**Tout le monde** (everyone) goes with verb in singular: **Tout le monde aime le café** (everyone likes coffee)."
    },
    {
     "@es": "Recuerda: **personne** (nadie) es la contraria de **quelqu'un** y va con **ne**.",
     "@en": "Remember: **personne** (no one) is the opposite of **quelqu'un** and goes with **ne**."
    }
   ]
