   "id": "fr052-8",
   "opciones": [
    {
     "texto": "Tout le monde aime cette ville.",
     "explicacion": {
      "@es": "«Tout le monde» gramaticalmente es tercera persona del singular («il/elle») y exige verbo en singular.",
      "@en": "«Tout le monde» is grammatically third person of singular («il/elle») and demands verb in singular."
     },
     "correcta": true
    },
    {
     "texto": "Tout le monde aiment cette ville.",
     "explicacion": {
      "@es": "«Aiment» es la terminación de tercera persona del plural; «tout le monde» no concuerda en plural.",
      "@en": "«Aiment» is the third person's completion of the plural; «tout le monde» does not match in plural."
     }
    },
