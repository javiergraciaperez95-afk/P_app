 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Concertar una cita",
    "@en": "Make an appointment"
   },
   "texto": [
    {
     "@es": "Para proponer un momento puedes preguntar **Vous êtes libre mardi ?** (¿Está libre el martes?) o **On se voit à dix heures ?** (¿Nos vemos a las diez?).",
     "@en": "To propose a moment you can ask **Vous êtes libre mardi ?** (Is it free on Tuesday?) or **On se voit à dix heures ?** (See you at ten?)."
    },
    {
     "@es": "Para aceptar: **Oui, ça me va** (sí, me viene bien). Para confirmar: **C'est confirmé** (queda confirmado).",
     "@en": "To accept: **Oui, ça me va** (yes, I do well). To confirm: **C'est confirmé** (confirmed)."
    },
    {
     "@es": "En una situación formal puedes pedir una cita con **Je voudrais prendre rendez-vous** (quisiera pedir una cita). Aprende esta frase como expresión útil.",
     "@en": "In a formal situation you can order an appointment with **Je voudrais prendre rendez-vous** (I would like to ask for an appointment). Learn this phrase as a useful expression."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Cambiar o cancelar",
    "@en": "Change or cancel"
   },
   "texto": [
    {
     "@es": "Para proponer otro momento: **On peut reporter à jeudi ?** (¿Podemos cambiarlo al jueves?).",
     "@en": "To propose another moment: **On peut reporter à jeudi ?** (Can we change it to Thursday?)."
    },
    {
     "@es": "Para cancelar: **Je dois annuler le rendez-vous** (tengo que cancelar la cita). **Désolé(e)** = lo siento; **merci** = gracias.",
     "@en": "To cancel: **Je dois annuler le rendez-vous** (I have to cancel the appointment). **Désolé(e)** = sorry; **merci** = thank you."
    }
   ]
  },
