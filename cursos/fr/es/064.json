 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Pedir con educación",
     "texto": [
      "**Je voudrais** (me gustaría, quisiera) es más educado que **je veux** (quiero).",
      "Ejemplo: **Je voudrais un billet pour Lyon** (quisiera un billete para Lyon)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Otras formas educadas",
     "texto": [
      "**J'aimerais** (me gustaría) y **Pourriez-vous** (¿podría usted?).",
      "Ejemplo: **Pourriez-vous répéter ?** (¿podría repetir?)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "El condicional presente",
     "texto": [
      "Se forma con la raíz del futuro y las terminaciones del imparfait: **-ais, -ais, -ait, -ions, -iez, -aient**.",
      "**Vouloir** → **voudr-**: **je voudrais**. **Pouvoir** → **pourr-**: **vous pourriez**. **Aimer** → **aimer-**: **j'aimerais**."
     ],
     "tutora": ""
    },
