      {
       "quien": {
        "texto": "Marie",
        "lengua": "estudio"
       },
       "estudio": "Non, il n'y a pas de jardin. Mais il y a deux grandes fenêtres.",
       "alumno": "No, no hay jardín. Pero hay dos ventanas grandes.",
       "literal": "",
       "estructura": "",
