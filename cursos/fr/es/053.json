    {
     "tipo": "explicacion",
     "titulo": "Pas de, pas encore, pas du tout",
     "texto": [
      "**Pas de** + sustantivo = ningún: **Je n'ai pas de travail** (no tengo trabajo).",
      "**Pas encore** = todavía no: **Je ne travaille pas encore** (todavía no trabajo).",
      "**Pas du tout** = para nada: **Je n'aime pas du tout le lundi** (no me gustan nada los lunes)."
     ],
     "tutora": ""
