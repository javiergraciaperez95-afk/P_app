     "oir_frase": false,
     "opciones": [
      {
       "texto": "«Pourquoi» introduce una pregunta de motivo y «parce que» introduce la respuesta explicativa.",
       "lengua": "alumno",
       "explicacion": "«Pourquoi» significa «por qué» interrogativo, mientras que «parce que» es la conjunción causal «porque».",
