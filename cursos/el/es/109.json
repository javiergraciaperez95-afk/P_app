     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Οι μαθητές δεν έχουν πάντα την ίδια πρόσβαση σε βιβλία, σύνδεση και υποστήριξη.",
