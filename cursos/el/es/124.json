       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Μέλος",
        "lengua": "estudio"
       },
       "estudio": "Ο αριθμός των δανεισμών σε μια πιλοτική περίοδο.",
