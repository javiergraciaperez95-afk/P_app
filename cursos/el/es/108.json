       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Υπάλληλος",
        "lengua": "estudio"
       },
       "estudio": "Το αίτημα θα διαβιβαστεί στην αρμόδια υπηρεσία.",
       "alumno": "La solicitud se remitirá al departamento competente.",
