       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Υπάλληλος",
        "lengua": "estudio"
       },
       "estudio": "Ποιο είναι το αίτημά σας;",
       "alumno": "¿Cuál es su solicitud?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Κάτοικος",
        "lengua": "estudio"
       },
       "estudio": "Παρακαλώ να εξετάσετε την τοποθέτηση ανελκυστήρα.",
       "alumno": "Le ruego que estudien la instalación de un ascensor.",
       "literal": "",
       "estructura": "",
       "nota": [],
