       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Παρακαλώ ενημερώστε με για τη νέα ημερομηνία και τις διαθέσιμες λύσεις.",
       "alumno": "Les ruego que me informen de la nueva fecha y de las soluciones disponibles.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
