     "titulo": "Σε μια ημερίδα εργασίας",
     "frases": [
      {
       "quien": {
        "texto": "Εισηγήτρια",
        "lengua": "estudio"
       },
       "estudio": "Πολλές επαναλαμβανόμενες εργασίες αυτοματοποιούνται.",
