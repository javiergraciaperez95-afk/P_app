       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Στέλιος",
        "lengua": "estudio"
       },
       "estudio": "Αυτό συνεπάγεται κατ’ ανάγκην λιγότερες θέσεις εργασίας;",
       "alumno": "¿Eso implica necesariamente menos puestos de trabajo?",
