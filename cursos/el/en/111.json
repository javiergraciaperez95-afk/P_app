   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Μια συζήτηση για τις εξετάσεις",
     "frases": [
      {
       "quien": {
        "texto": "Λίνα",
        "lengua": "estudio"
       },
       "estudio": "Θα ήθελα να προσθέσω ότι οι εξετάσεις δεν μετρούν όλες τις δεξιότητες.",
       "alumno": "I would like to add that exams don't measure all skills.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ορέστης",
        "lengua": "estudio"
       },
       "estudio": "Αν καταλαβαίνω σωστά, προτείνεις να καταργηθούν;",
       "alumno": "If I understand correctly, are you proposing to eliminate them?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Λίνα",
        "lengua": "estudio"
       },
       "estudio": "Όχι, προτείνω να συνδυαστούν με εργασίες και παρουσιάσεις.",
       "alumno": "No, I propose combining them with assignments and presentations.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ορέστης",
        "lengua": "estudio"
       },
       "estudio": "Μπορείς να διευκρινίσεις πώς θα αξιολογούνται;",
       "alumno": "Can you clarify how they would be evaluated?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Κείμενο για ανάγνωση",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Η συζήτηση ξεκινά με έναν κοινό κανόνα: ακούμε το επιχείρημα πριν απαντήσουμε.",
       "alumno": "The debate begins with a shared rule: we listen to the argument before responding.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Μερικοί μαθητές προτιμούν παραδείγματα, ενώ άλλοι ζητούν στοιχεία από έρευνες.",
       "alumno": "Some students prefer examples, while others ask for data from studies.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Η ανακεφαλαίωση στο τέλος ξεχωρίζει τα σημεία συμφωνίας από τις διαφωνίες.",
       "alumno": "The final summary separates the points of agreement from the disagreements.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
