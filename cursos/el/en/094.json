   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Στη συζήτηση της ομάδας",
     "frases": [
      {
       "quien": {
        "texto": "Συντονίστρια",
        "lengua": "estudio"
       },
       "estudio": "Από τη μία, η ευελιξία διευκολύνει πολλούς εργαζομένους.",
       "alumno": "On the one hand, flexibility makes life easier for many workers.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Μάριος",
        "lengua": "estudio"
       },
       "estudio": "Από την άλλη, η απομόνωση μπορεί να περιορίσει τη συνεργασία.",
       "alumno": "On the other hand, isolation can limit collaboration.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Συντονίστρια",
        "lengua": "estudio"
       },
       "estudio": "Η παραγωγικότητα αυξάνεται, υπό την προϋπόθεση ότι υπάρχουν σαφή όρια.",
       "alumno": "Productivity increases, provided there are clear limits.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Μάριος",
        "lengua": "estudio"
       },
       "estudio": "Συνεπώς, χρειάζεται ισορροπία ανάμεσα στο σπίτι και στο γραφείο.",
       "alumno": "Consequently, a balance between home and office is needed.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Κείμενο για ανάγνωση",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Η εργασία από το σπίτι προσφέρει ευελιξία και μειώνει τον χρόνο μετακίνησης.",
       "alumno": "Working from home offers flexibility and reduces commuting time.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Χωρίς κοινά όρια, όμως, η απομόνωση μπορεί να δυσκολέψει τη συνεργασία.",
       "alumno": "Without shared limits, however, isolation can make collaboration difficult.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Μια ισορροπημένη λύση χρειάζεται σαφή επικοινωνία και τακτικές συναντήσεις.",
       "alumno": "A balanced solution requires clear communication and regular meetings.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
