   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Σε μια ημερίδα εργασίας",
     "frases": [
      {
       "quien": {
        "texto": "Εισηγήτρια",
        "lengua": "estudio"
       },
       "estudio": "Πολλές επαναλαμβανόμενες εργασίες αυτοματοποιούνται.",
       "alumno": "Many repetitive tasks are automated.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Στέλιος",
        "lengua": "estudio"
       },
       "estudio": "Αυτό συνεπάγεται κατ’ ανάγκην λιγότερες θέσεις εργασίας;",
       "alumno": "Does that necessarily mean fewer jobs?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Εισηγήτρια",
        "lengua": "estudio"
       },
       "estudio": "Όχι. Η τεχνολογία μεταβάλλει καθήκοντα και δημιουργεί ανάγκη για νέες δεξιότητες.",
       "alumno": "No. Technology transforms duties and generates the need for new skills.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Στέλιος",
        "lengua": "estudio"
       },
       "estudio": "Άρα, η επανεκπαίδευση είναι μέρος της λύσης.",
       "alumno": "Therefore, retraining is part of the solution.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Κείμενο για ανάγνωση",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Τα αυτοματοποιημένα συστήματα αναλαμβάνουν επαναλαμβανόμενες εργασίες σε πολλές επιχειρήσεις.",
       "alumno": "Automated systems take on repetitive tasks in many companies.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Οι εργαζόμενοι χρειάζονται χρόνο και κατάρτιση για να αναλάβουν νέες αρμοδιότητες.",
       "alumno": "Workers need time and training to take on new responsibilities.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Η επίδραση στην απασχόληση εξαρτάται από τον κλάδο και τον τρόπο εφαρμογής.",
       "alumno": "The effect on employment depends on the sector and on how it is applied.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
