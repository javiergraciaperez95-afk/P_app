     "tipo": "dialogo",
     "titulo": "Στη συνέλευση της γειτονιάς",
     "frases": [
      {
       "quien": {
        "texto": "Κάτοικος",
        "lengua": "estudio"
       },
       "estudio": "Η οδός χρησιμοποιείται κυρίως για στάθμευση.",
       "alumno": "The street is mainly used for parking.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Έμπορος",
        "lengua": "estudio"
       },
       "estudio": "Χρειαζόμαστε πρόσβαση για φόρτωση, αλλά και χώρο για πεζούς.",
       "alumno": "We need access for loading, but also space for pedestrians.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Κάτοικος",
        "lengua": "estudio"
       },
       "estudio": "Αντί να κλείσει όλη η οδός, μπορούμε να περιορίσουμε την κυκλοφορία.",
       "alumno": "Instead of closing the whole street, we can limit traffic.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Έμπορος",
        "lengua": "estudio"
       },
       "estudio": "Με αυτόν τον τρόπο, η ασφάλεια και η πρόσβαση συνυπάρχουν.",
       "alumno": "In this way, safety and access can coexist.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
