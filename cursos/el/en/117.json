      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Οι κάτοικοι ζητούν επίσης λιγότερο θόρυβο και καλύτερη πρόσβαση για αμαξίδια.",
       "alumno": "Residents also ask for less noise and better access for wheelchairs.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
