    {
     "tipo": "texto",
     "titulo": "Κείμενο για ανάγνωση",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Η ίδια γειτονιά εμφανίζεται διαφορετική όταν την περιγράφει ένας νέος κάτοικος.",
       "alumno": "The same neighborhood looks different when described by a newcomer.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Η επιλογή του αφηγητή καθορίζει ποιες εμπειρίες γίνονται ορατές.",
       "alumno": "The choice of narrator determines which experiences become visible.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Συγκρίνοντας τις αφηγήσεις, αναγνωρίζουμε κοινές μνήμες και διαφορετικές οπτικές.",
       "alumno": "By comparing accounts, we recognize shared memories and different perspectives.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
