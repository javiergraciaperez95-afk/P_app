   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Introducing yourself",
     "texto": [
      "**Με λένε…** means «my name is…». To ask someone's name informally, say **Πώς σε λένε;**. In a formal situation: **Πώς σας λένε;**",
      "**Αυτός** means «he/this» and **αυτή** means «she/this». To introduce someone: **Αυτή είναι η Μαρία** (this is Maria)."
     ],
     "tutora": ""
    }
   ]
