     "tipo": "dialogo",
     "titulo": "Σχεδιασμός εφαρμογής",
     "frases": [
      {
       "quien": {
        "texto": "Μηχανικός",
        "lengua": "estudio"
       },
       "estudio": "Η εφαρμογή συλλέγει δεδομένα τοποθεσίας για να προτείνει διαδρομές.",
       "alumno": "The app collects location data to suggest routes.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ελένη",
        "lengua": "estudio"
       },
       "estudio": "Ο χρήστης γνωρίζει πόσο καιρό διατηρούνται;",
       "alumno": "Does the user know how long they are kept?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Μηχανικός",
        "lengua": "estudio"
       },
       "estudio": "Ναι, εφόσον διαβάσει την πολιτική απορρήτου.",
       "alumno": "Yes, as long as they read the privacy policy.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ελένη",
        "lengua": "estudio"
       },
       "estudio": "Και σε περίπτωση που ζητήσει διαγραφή;",
       "alumno": "And if they request deletion?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Μηχανικός",
        "lengua": "estudio"
       },
       "estudio": "Τα δεδομένα διαγράφονται μέσα σε τριάντα ημέρες.",
       "alumno": "The data is deleted within thirty days.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Κείμενο για ανάγνωση",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Η εφαρμογή αποθηκεύει πληροφορίες τοποθεσίας για να προτείνει κοντινές υπηρεσίες.",
       "alumno": "The app stores location information to suggest nearby services.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Οι χρήστες μπορούν να αλλάξουν τις ρυθμίσεις, αλλά δεν γνωρίζουν πάντα ποιος λαμβάνει τα δεδομένα.",
       "alumno": "Users can change the settings, but they don't always know who receives the data.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Η σαφής ενημέρωση και η συγκατάθεση περιορίζουν την αβεβαιότητα.",
       "alumno": "Clear information and consent reduce uncertainty.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
