   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Στο εκπαιδευτικό συνέδριο",
     "frases": [
      {
       "quien": {
        "texto": "Ερευνήτρια",
        "lengua": "estudio"
       },
       "estudio": "Δεν αρκεί να προσφέρουμε την ίδια ύλη σε όλους.",
       "alumno": "It is not enough to offer the same content to everyone.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Εκπαιδευτικός",
        "lengua": "estudio"
       },
       "estudio": "Χρειάζεται υποστήριξη, προκειμένου να εξασφαλιστεί ίση πρόσβαση.",
       "alumno": "Support is needed to guarantee equal access.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ερευνήτρια",
        "lengua": "estudio"
       },
       "estudio": "Για παράδειγμα, οι ψηφιακοί πόροι πρέπει να είναι προσβάσιμοι.",
       "alumno": "For example, digital resources must be accessible.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Εκπαιδευτικός",
        "lengua": "estudio"
       },
       "estudio": "Κατά συνέπεια, η ισότητα απαιτεί και κατάλληλα μέσα.",
       "alumno": "As a consequence, equality also requires suitable means.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Κείμενο για ανάγνωση",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Οι μαθητές δεν έχουν πάντα την ίδια πρόσβαση σε βιβλία, σύνδεση και υποστήριξη.",
       "alumno": "Students do not always have the same access to books, internet and support.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Ένα πρόγραμμα υποτροφιών μπορεί να μειώσει ορισμένα εμπόδια, αλλά δεν τα εξαλείφει όλα.",
       "alumno": "A scholarship program can reduce some barriers, but it does not eliminate them all.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Η αξιολόγηση εξετάζει ποιοι συμμετέχουν και ποιοι μένουν εκτός.",
       "alumno": "The evaluation looks at who takes part and who is left out.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
