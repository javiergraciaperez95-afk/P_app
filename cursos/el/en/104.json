      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Το μέτρο είναι πιο αποτελεσματικό όταν υπάρχουν προσβάσιμα σημεία συλλογής.",
       "alumno": "The measure is more effective when accessible collection points exist.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Ο δήμος θα επανεξετάσει τα αποτελέσματα ύστερα από έξι μήνες.",
       "alumno": "The city council will review the results after six months.",
       "literal": "",
