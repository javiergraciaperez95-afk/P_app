    {
     "tipo": "dialogo",
     "titulo": "Δημόσια διαβούλευση",
     "frases": [
      {
       "quien": {
        "texto": "Δήμαρχος",
        "lengua": "estudio"
       },
       "estudio": "Αν εφαρμοστεί η χρέωση ανά σακούλα, θα μειωθούν τα σύμμεικτα απορρίμματα.",
       "alumno": "If the per-bag fee is applied, mixed waste will decrease.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Κάτοικος",
        "lengua": "estudio"
       },
       "estudio": "Εφόσον υπάρχουν σημεία επαναχρησιμοποίησης, το μέτρο θα είναι δικαιότερο.",
       "alumno": "If there are reuse points, the measure will be fairer.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Δήμαρχος",
        "lengua": "estudio"
       },
       "estudio": "Θα δοθεί έκπτωση σε νοικοκυριά με χαμηλό εισόδημα.",
       "alumno": "A discount will be given to low-income households.",
