   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Saying what is wrong",
     "texto": [
      "**Πονάω** means «it hurts» or «I have pain». You can name the part of the body: **Πονάει το κεφάλι μου** (my head hurts).",
      "**Έχω πυρετό** means I have a fever. **Χρειάζομαι βοήθεια** means I need help. If you don't understand, ask **Μπορείτε να το πείτε ξανά;** (can you repeat it?)."
     ],
     "tutora": ""
    }
   ]
  },
