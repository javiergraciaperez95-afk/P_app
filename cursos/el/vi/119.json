     "frases": [
      {
       "quien": {
        "texto": "Φύλακας",
        "lengua": "estudio"
       },
       "estudio": "Για να διατηρηθεί ο χώρος, ο αριθμός των επισκεπτών περιορίζεται.",
       "alumno": "Để gìn giữ địa điểm, số lượng khách tham quan bị giới hạn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Επισκέπτρια",
        "lengua": "estudio"
       },
       "estudio": "Μπορώ να αγγίξω τα εκθέματα;",
       "alumno": "Tôi có thể chạm vào hiện vật trưng bày không?",
