     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Το παλιό υδραγωγείο χρειάζεται επισκευή, αλλά οι ειδικοί ζητούν να διατηρηθούν τα αρχικά υλικά.",
       "alumno": "Hệ thống dẫn nước cổ cần được sửa chữa, nhưng chuyên gia yêu cầu giữ lại vật liệu gốc.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Η χρηματοδότηση θα καλύψει τις εργασίες και ένα πρόγραμμα ενημέρωσης για τους επισκέπτες.",
       "alumno": "Nguồn tài trợ sẽ chi trả cho công trình và chương trình thông tin dành cho du khách.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Η προστασία του μνημείου απαιτεί πρόσβαση του κοινού και σαφείς κανόνες χρήσης.",
       "alumno": "Bảo vệ di tích đòi hỏi công chúng được tiếp cận và có quy tắc sử dụng rõ ràng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
