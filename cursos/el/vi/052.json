   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Viết về quá khứ",
     "texto": [
      "Trong một tin nhắn cá nhân, bạn chào, nói bạn đã đi đâu và kể một hoặc hai hoạt động. Kết thúc bằng một câu hỏi cho người kia.",
      "**Πέρασα πολύ ωραία** nghĩa là «tôi đã trải qua rất vui». **Επισκέφτηκα** nghĩa là tôi đã thăm; **γνώρισα** nghĩa là tôi đã gặp. Dùng các từ nối như **επίσης** (cũng) và **αλλά** (nhưng)."
     ],
     "tutora": ""
    }
   ]
  },
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Γεια σου, Άννα!",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Το περασμένο Σαββατοκύριακο πήγα στη Νάξο.",
       "alumno": "Cuối tuần vừa rồi tôi đã đi Naxos.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Επισκέφτηκα ένα μικρό χωριό και γνώρισα πολύ φιλικούς ανθρώπους.",
       "alumno": "Tôi đã thăm một ngôi làng nhỏ và gặp những người rất thân thiện.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Πέρασα υπέροχα, αλλά ο καιρός ήταν λίγο κρύος.",
       "alumno": "Tôi đã trải qua tuyệt vời, nhưng trời hơi lạnh.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Επέστρεψα την Κυριακή το βράδυ. Εσύ, πού πήγες;",
       "alumno": "Tôi về vào tối Chủ nhật. Còn bạn, bạn đã đi đâu?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
