        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Η πόλη εγκαινίασε έναν νέο σταθμό ποδηλάτων κοντά στο πανεπιστήμιο.",
       "alumno": "Thành phố vừa khai trương một trạm xe đạp mới gần trường đại học.",
       "literal": "",
       "estructura": "",
       "nota": [],
