       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Μια σύντομη περίληψη κρατά τα βασικά στοιχεία και παραλείπει τις επαναλήψεις.",
       "alumno": "Một bản tóm tắt ngắn giữ được dữ liệu chính và bỏ những phần lặp lại.",
       "literal": "",
       "estructura": "",
       "nota": [],
