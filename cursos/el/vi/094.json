 "etapas": [
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Στη συζήτηση της ομάδας",
     "frases": [
      {
       "quien": {
        "texto": "Συντονίστρια",
        "lengua": "estudio"
       },
       "estudio": "Από τη μία, η ευελιξία διευκολύνει πολλούς εργαζομένους.",
       "alumno": "Một mặt, sự linh hoạt tạo điều kiện thuận lợi cho nhiều người lao động.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Μάριος",
        "lengua": "estudio"
       },
       "estudio": "Από την άλλη, η απομόνωση μπορεί να περιορίσει τη συνεργασία.",
       "alumno": "Mặt khác, sự cô lập có thể hạn chế sự hợp tác.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Συντονίστρια",
        "lengua": "estudio"
       },
       "estudio": "Η παραγωγικότητα αυξάνεται, υπό την προϋπόθεση ότι υπάρχουν σαφή όρια.",
       "alumno": "Năng suất tăng, miễn là có những giới hạn rõ ràng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Μάριος",
        "lengua": "estudio"
       },
       "estudio": "Συνεπώς, χρειάζεται ισορροπία ανάμεσα στο σπίτι και στο γραφείο.",
       "alumno": "Vì vậy, cần có sự cân bằng giữa nhà và văn phòng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Κείμενο για ανάγνωση",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Η εργασία από το σπίτι προσφέρει ευελιξία και μειώνει τον χρόνο μετακίνησης.",
       "alumno": "Làm việc tại nhà mang lại sự linh hoạt và giảm thời gian đi lại.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Χωρίς κοινά όρια, όμως, η απομόνωση μπορεί να δυσκολέψει τη συνεργασία.",
       "alumno": "Tuy nhiên, khi thiếu giới hạn chung, sự cô lập có thể gây khó khăn cho hợp tác.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Μια ισορροπημένη λύση χρειάζεται σαφή επικοινωνία και τακτικές συναντήσεις.",
       "alumno": "Một giải pháp cân bằng cần có giao tiếp rõ ràng và các cuộc họp định kỳ.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
