      {
       "quien": {
        "texto": "Ιστορικός",
        "lengua": "estudio"
       },
       "estudio": "Μερικές καταγράφηκαν πρόσφατα και η έκθεση θα ανανεωθεί.",
       "alumno": "Một số đã được ghi lại gần đây và triển lãm sẽ được cập nhật.",
