   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Η μέρα της αποφοίτησης",
     "frases": [
      {
       "quien": {
        "texto": "Ελένη",
        "lengua": "estudio"
       },
       "estudio": "Ποια μέρα θυμάσαι περισσότερο;",
       "alumno": "Bạn nhớ nhất ngày nào?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Μαρία",
        "lengua": "estudio"
       },
       "estudio": "Η μέρα της αποφοίτησής μου. Ο καιρός ήταν καλός και η οικογένειά μου περίμενε έξω.",
       "alumno": "Ngày tốt nghiệp của tôi. Trời đẹp và gia đình tôi đợi bên ngoài.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Μαρία",
        "lengua": "estudio"
       },
       "estudio": "Ξαφνικά άρχισε να βρέχει, αλλά ένας φίλος έφερε ομπρέλες.",
       "alumno": "Bỗng dưng trời bắt đầu mưa, nhưng một người bạn mang ô đến.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Μαρία",
        "lengua": "estudio"
       },
       "estudio": "Στη συνέχεια πήγαμε όλοι για φαγητό. Τελικά ήταν μια αξέχαστη μέρα.",
       "alumno": "Sau đó tất cả chúng tôi đi ăn. Cuối cùng đó là một ngày không thể quên.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
