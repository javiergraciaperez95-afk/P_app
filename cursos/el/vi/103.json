   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Đối chiếu tinh tế",
     "texto": [
      "**Σε αντίθεση με…** chỉ sự khác biệt. **Παρά το γεγονός ότι…** thừa nhận một khó khăn; **μακροπρόθεσμα** đặt một đánh giá vào khoảng thời gian.",
      "Hãy chú ý mỗi từ nối tạo ra quan hệ nào, rồi dùng nó để diễn đạt quan điểm của riêng bạn."
     ],
     "tutora": ""
    }
   ]
  },
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Στο περιφερειακό συμβούλιο",
     "frases": [
      {
       "quien": {
        "texto": "Σύμβουλος",
        "lengua": "estudio"
       },
       "estudio": "Η ηλιακή ενέργεια μειώνει τις εκπομπές, αλλά χρειάζεται αποθήκευση.",
       "alumno": "Năng lượng mặt trời giảm phát thải, nhưng cần lưu trữ.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Μηχανικός",
        "lengua": "estudio"
       },
       "estudio": "Σε αντίθεση με τα ορυκτά καύσιμα, η πηγή είναι ανανεώσιμη.",
       "alumno": "Khác với nhiên liệu hóa thạch, nguồn này là nguồn tái tạo.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Σύμβουλος",
        "lengua": "estudio"
       },
       "estudio": "Παρά το γεγονός ότι το αρχικό κόστος είναι υψηλό, η επένδυση μπορεί να αποδώσει μακροπρόθεσμα.",
       "alumno": "Mặc dù chi phí ban đầu cao, khoản đầu tư có thể mang lại kết quả về lâu dài.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Μηχανικός",
        "lengua": "estudio"
       },
       "estudio": "Χρειάζεται, ωστόσο, αναβάθμιση του δικτύου.",
       "alumno": "Tuy nhiên, cần hiện đại hóa mạng lưới.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Κείμενο για ανάγνωση",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Οι ανανεώσιμες πηγές μειώνουν τις εκπομπές, αλλά απαιτούν υποδομές και αποθήκευση.",
       "alumno": "Nguồn tái tạo giảm phát thải, nhưng đòi hỏi hạ tầng và lưu trữ.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Το κόστος της μετάβασης κατανέμεται διαφορετικά ανάμεσα στα νοικοκυριά και στις επιχειρήσεις.",
       "alumno": "Chi phí chuyển đổi được phân bổ khác nhau giữa hộ gia đình và doanh nghiệp.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Η αξιολόγηση χρειάζεται να εξετάζει τόσο την αποτελεσματικότητα όσο και την ισότητα.",
       "alumno": "Đánh giá cần xem xét cả hiệu quả lẫn công bằng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
