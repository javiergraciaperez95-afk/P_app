     "tipo": "dialogo",
     "titulo": "Σχεδιασμός εφαρμογής",
     "frases": [
      {
       "quien": {
        "texto": "Μηχανικός",
        "lengua": "estudio"
       },
       "estudio": "Η εφαρμογή συλλέγει δεδομένα τοποθεσίας για να προτείνει διαδρομές.",
       "alumno": "Ứng dụng thu thập dữ liệu vị trí để gợi ý lộ trình.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ελένη",
        "lengua": "estudio"
       },
       "estudio": "Ο χρήστης γνωρίζει πόσο καιρό διατηρούνται;",
       "alumno": "Người dùng có biết dữ liệu được lưu giữ bao lâu không?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Μηχανικός",
        "lengua": "estudio"
       },
       "estudio": "Ναι, εφόσον διαβάσει την πολιτική απορρήτου.",
       "alumno": "Có, miễn là họ đọc chính sách quyền riêng tư.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ελένη",
        "lengua": "estudio"
       },
       "estudio": "Και σε περίπτωση που ζητήσει διαγραφή;",
       "alumno": "Còn nếu họ yêu cầu xóa thì sao?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Μηχανικός",
        "lengua": "estudio"
       },
       "estudio": "Τα δεδομένα διαγράφονται μέσα σε τριάντα ημέρες.",
       "alumno": "Dữ liệu được xóa trong vòng ba mươi ngày.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Κείμενο για ανάγνωση",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Η εφαρμογή αποθηκεύει πληροφορίες τοποθεσίας για να προτείνει κοντινές υπηρεσίες.",
       "alumno": "Ứng dụng lưu thông tin vị trí để gợi ý dịch vụ gần đó.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Οι χρήστες μπορούν να αλλάξουν τις ρυθμίσεις, αλλά δεν γνωρίζουν πάντα ποιος λαμβάνει τα δεδομένα.",
       "alumno": "Người dùng có thể thay đổi cài đặt, nhưng không phải lúc nào cũng biết ai nhận dữ liệu.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Η σαφής ενημέρωση και η συγκατάθεση περιορίζουν την αβεβαιότητα.",
       "alumno": "Thông tin rõ ràng và sự đồng ý làm giảm sự không chắc chắn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
