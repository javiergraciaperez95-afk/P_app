     "frases": [
      {
       "quien": {
        "texto": "Κάτοικος",
        "lengua": "estudio"
       },
       "estudio": "Σας γράφω σχετικά με την πρόσβαση στον σταθμό.",
       "alumno": "Tôi viết thư về việc tiếp cận nhà ga.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Υπάλληλος",
        "lengua": "estudio"
       },
       "estudio": "Ποιο είναι το αίτημά σας;",
       "alumno": "Yêu cầu của quý vị là gì?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Κάτοικος",
        "lengua": "estudio"
       },
       "estudio": "Παρακαλώ να εξετάσετε την τοποθέτηση ανελκυστήρα.",
       "alumno": "Tôi xin quý vị xem xét việc lắp đặt thang máy.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Κάτοικος",
        "lengua": "estudio"
       },
       "estudio": "Επισυνάπτω φωτογραφίες της εισόδου.",
       "alumno": "Tôi đính kèm ảnh lối vào.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Υπάλληλος",
        "lengua": "estudio"
       },
       "estudio": "Το αίτημα θα διαβιβαστεί στην αρμόδια υπηρεσία.",
       "alumno": "Yêu cầu sẽ được chuyển đến bộ phận thẩm quyền.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Κείμενο για ανάγνωση",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Σας απευθύνομαι σχετικά με την καθυστέρηση στην παράδοση του εξοπλισμού.",
       "alumno": "Tôi viết thư về việc giao thiết bị bị chậm.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Παρακαλώ ενημερώστε με για τη νέα ημερομηνία και τις διαθέσιμες λύσεις.",
       "alumno": "Xin quý vị thông báo cho tôi ngày mới và những giải pháp hiện có.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Κλείνω την επιστολή με ευχαριστίες και τα στοιχεία επικοινωνίας μου.",
       "alumno": "Tôi kết thư bằng lời cảm ơn và thông tin liên lạc của mình.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
