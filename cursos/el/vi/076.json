      {
       "quien": {
        "texto": "Υπάλληλος",
        "lengua": "estudio"
       },
       "estudio": "Λυπάμαι. Τι ακριβώς συμβαίνει;",
       "alumno": "Tôi rất tiếc. Chuyện gì đã xảy ra vậy?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Πελάτης",
        "lengua": "estudio"
       },
       "estudio": "Δεν υπάρχουν καθαρές πετσέτες και περίμενα ότι το δωμάτιο θα ήταν έτοιμο.",
       "alumno": "Không thấy khăn sạch và tôi đã mong phòng sẵn sàng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Υπάλληλος",
        "lengua": "estudio"
       },
       "estudio": "Θα στείλω κάποιον αμέσως και θα σας φέρουμε πετσέτες.",
       "alumno": "Tôi sẽ cử người đến ngay và sẽ mang khăn đến cho ngài.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
