    {
     "tipo": "texto",
     "titulo": "Κείμενο για ανάγνωση",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Δύο ιστοσελίδες περιγράφουν την ίδια αλλαγή, αλλά παραπέμπουν σε διαφορετικές πηγές.",
       "alumno": "Hai trang web mô tả cùng một thay đổi nhưng dẫn đến các nguồn khác nhau.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Η επίσημη ανακοίνωση δημοσιεύτηκε την ίδια ημέρα με την απόφαση.",
       "alumno": "Thông báo chính thức được đăng cùng ngày với quyết định.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Η σύγκριση των ημερομηνιών και των παραπομπών βοηθά να ελέγξουμε την αξιοπιστία.",
       "alumno": "Đối chiếu thời điểm và dẫn nguồn là cách kiểm tra độ tin cậy.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
