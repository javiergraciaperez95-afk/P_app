   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Tại cuộc họp khu phố",
     "frases": [
      {
       "quien": {
        "texto": "Κάτοικος",
        "lengua": "estudio"
       },
       "estudio": "Η οδός χρησιμοποιείται κυρίως για στάθμευση.",
       "alumno": "Con phố chủ yếu được dùng để đỗ xe.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Έμπορος",
        "lengua": "estudio"
       },
       "estudio": "Χρειαζόμαστε πρόσβαση για φόρτωση, αλλά και χώρο για πεζούς.",
       "alumno": "Chúng ta cần lối vào để bốc dỡ hàng, nhưng cũng cần không gian cho người đi bộ.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Κάτοικος",
        "lengua": "estudio"
       },
       "estudio": "Αντί να κλείσει όλη η οδός, μπορούμε να περιορίσουμε την κυκλοφορία.",
       "alumno": "Thay vì đóng toàn bộ con phố, chúng ta có thể hạn chế lưu thông.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Έμπορος",
        "lengua": "estudio"
       },
       "estudio": "Με αυτόν τον τρόπο, η ασφάλεια και η πρόσβαση συνυπάρχουν.",
       "alumno": "Bằng cách này, an toàn và khả năng tiếp cận có thể cùng tồn tại.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Κείμενο για ανάγνωση",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Η πλατεία έχει περισσότερο πράσινο, παγκάκια και ασφαλείς διαβάσεις.",
       "alumno": "Quảng trường có nhiều cây xanh hơn, ghế đá và vạch sang đường an toàn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Οι κάτοικοι ζητούν επίσης λιγότερο θόρυβο και καλύτερη πρόσβαση για αμαξίδια.",
       "alumno": "Cư dân cũng yêu cầu ít tiếng ồn hơn và khả năng tiếp cận tốt hơn cho xe lăn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Ο δήμος θα συγκρίνει τις απαντήσεις πριν αποφασίσει για τα επόμενα έργα.",
       "alumno": "Chính quyền sẽ so sánh những câu trả lời trước khi quyết định công trình tiếp theo.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
