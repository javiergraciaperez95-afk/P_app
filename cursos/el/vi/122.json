     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Η πρώτη πηγή δίνει έμφαση στην ταχύτητα, ενώ η δεύτερη στην ίση πρόσβαση.",
       "alumno": "Nguồn thứ nhất nhấn mạnh tốc độ, còn nguồn thứ hai nhấn mạnh tiếp cận bình đẳng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Και οι δύο συμφωνούν ότι χρειάζονται αξιόπιστα στοιχεία πριν από την απόφαση.",
       "alumno": "Cả hai đều đồng ý rằng cần dữ liệu đáng tin cậy trước khi quyết định.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Μια σύνθεση αναφέρει την κοινή θέση και διατηρεί ορατή τη βασική διαφωνία.",
       "alumno": "Một bản tổng hợp ghi lại quan điểm chung và giữ rõ bất đồng chính.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
