     "frases": [
      {
       "quien": {
        "texto": "Κώστας",
        "lengua": "estudio"
       },
       "estudio": "Νομίζω ότι όλοι πρέπει να δουλεύουν από το σπίτι.",
       "alumno": "Tôi nghĩ mọi người nên làm việc tại nhà.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ελένη",
        "lengua": "estudio"
       },
       "estudio": "Κατά τη γνώμη μου, είναι βολικό, αν και δεν ταιριάζει σε κάθε δουλειά.",
       "alumno": "Theo ý tôi, điều đó tiện lợi, mặc dù không hợp với mọi công việc.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Κώστας",
        "lengua": "estudio"
       },
       "estudio": "Συμφωνώ. Για παράδειγμα, οι γιατροί χρειάζεται να είναι εκεί.",
       "alumno": "Tôi đồng ý. Ví dụ, bác sĩ phải có mặt ở đó.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ελένη",
        "lengua": "estudio"
       },
       "estudio": "Ακριβώς. Όμως οι συναντήσεις μπορούν να γίνονται διαδικτυακά.",
       "alumno": "Chính xác. Tuy nhiên, các cuộc họp có thể được tổ chức trực tuyến.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
