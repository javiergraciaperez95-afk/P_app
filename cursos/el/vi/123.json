     "tipo": "dialogo",
     "titulo": "Nhận xét về một văn bản",
     "frases": [
      {
       "quien": {
        "texto": "Επιμελήτρια",
        "lengua": "estudio"
       },
       "estudio": "Η πρόταση «κανείς δεν χρησιμοποιεί την υπηρεσία» είναι πολύ απόλυτη.",
       "alumno": "Câu «không ai sử dụng dịch vụ» là quá tuyệt đối.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Συντάκτης",
        "lengua": "estudio"
       },
       "estudio": "Τα στοιχεία δείχνουν ότι τη χρησιμοποιεί το 18% των ερωτηθέντων.",
       "alumno": "Số liệu cho thấy 18 % người được khảo sát sử dụng dịch vụ này.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Επιμελήτρια",
        "lengua": "estudio"
       },
       "estudio": "Τότε, γράψε «λιγότεροι από ένας στους πέντε».",
       "alumno": "Vậy hãy viết «ít hơn một trong năm người».",
       "literal": "",
       "estructura": "",
       "nota": [],
