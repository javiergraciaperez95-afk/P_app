   "en": "Cocino",
   "pron": "mayirévo"
  },
  "πρέπει": {
   "es": "debo, hay que",
   "en": "I have to.",
   "pron": "prépi"
  },
  "να": {
   "es": "que, marcador verbal",
   "en": "What, verbal marker",
   "pron": "na"
  },
  "βοηθάω": {
   "es": "ayudo",
   "en": "I help",
   "pron": "voitháo"
  },
