  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué expresa «πρέπει να»?",
    "@en": "What does «πρέπει να» express?"
   },
   "id": "el008-2",
   "opciones": [
    {
     "texto": {
      "@es": "Una obligación o algo necesario.",
      "@en": "An obligation or something necessary."
     },
     "explicacion": {
      "@es": "Equivale a tener que.",
      "@en": "It's equal to having to."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Una posibilidad futura.",
      "@en": "A future possibility."
     },
     "explicacion": {
      "@es": "Para eso aparece «θα».",
      "@en": "That's why «θα» appears."
     }
    },
    {
     "texto": {
      "@es": "Una acción habitual.",
      "@en": "A regular action."
     },
     "explicacion": {
      "@es": "No es el significado de esta expresión.",
      "@en": "It is not the meaning of this expression."
     }
    }
   ]
  },
  {
