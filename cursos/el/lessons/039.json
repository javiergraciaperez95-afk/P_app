 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Tener que hacer algo",
    "@en": "Have to do something"
   },
   "texto": [
    {
     "@es": "**Πρέπει να** + verbo expresa obligación: **Πρέπει να καθαρίσω** (tengo que limpiar). Después de **να**, el verbo suele aparecer en una forma distinta del presente habitual.",
     "@en": "**Πρέπει να** + verb express obligation: **Πρέπει να καθαρίσω** (I have to clean). After **να**, the verb usually appears in a different form from the usual present."
    },
    {
     "@es": "**Μπορώ να** significa «puedo». Usa **εγώ** o **εσύ** para aclarar quién hace la tarea; a menudo se entiende por la terminación del verbo.",
     "@en": "**Μπορώ να** means «I can.». Use **εγώ** or **εσύ** to clarify who does the task; it is often understood by the termination of the verb."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": "Στο σπίτι",
   "palabras": [
    "δουλειές",
    "καθαρίζω",
    "πλένω",
    "πιάτα",
    "μαγειρεύω",
    "πρέπει",
    "να",
    "βοηθάω"
   ]
  },
  {
   "tipo": "dialogo",
   "titulo": "Μοιράζουμε τις δουλειές",
   "frases": [
    {
     "quien": "Κώστας",
     "el": "Πρέπει να καθαρίσουμε σήμερα.",
     "es": "Tenemos que limpiar hoy.",
     "en": "We have to clean up today.",
     "analisis": [
      [
       "πρέπει να",
       {
        "@es": "tenemos que",
        "@en": "We have to"
       }
      ],
      [
       "καθαρίσουμε",
       {
        "@es": "limpiemos",
        "@en": "Let's clean up"
       }
      ],
      [
       "σήμερα",
       {
        "@es": "hoy",
        "@en": "Today"
       }
      ]
     ]
    },
    {
     "quien": "Σοφία",
     "el": "Μπορώ να πλύνω τα πιάτα.",
     "es": "Puedo lavar los platos.",
     "en": "I can wash the dishes.",
     "analisis": [
      [
       "μπορώ να",
       {
        "@es": "puedo",
        "@en": "I can."
       }
      ],
      [
       "πλύνω",
       {
        "@es": "lavar",
        "@en": "wash"
       }
      ],
      [
       "πιάτα",
       {
        "@es": "platos",
        "@en": "dishes"
       }
      ]
     ]
    },
    {
     "quien": "Κώστας",
     "el": "Ωραία. Εγώ θα μαγειρέψω και θα βοηθήσω.",
     "es": "Muy bien. Yo cocinaré y ayudaré.",
     "en": "All right. I'll cook and help.",
     "analisis": [
      [
       "θα μαγειρέψω",
       {
        "@es": "cocinaré",
        "@en": "I'll cook"
       }
      ],
      [
       "θα βοηθήσω",
       {
        "@es": "ayudaré",
        "@en": "I'll help."
       }
      ]
     ]
    }
   ]
  },
