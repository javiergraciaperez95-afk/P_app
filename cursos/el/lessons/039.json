     "texto": {
      "@es": "Tengo que limpiar hoy.",
      "@en": "I have to clean up today."
     },
     "explicacion": {
      "@es": "Eso sería «πρέπει να καθαρίσω».",
      "@en": "That would be «πρέπει να καθαρίσω»."
     }
    },
    {
     "texto": {
      "@es": "Cocino todos los días.",
      "@en": "I cook every day."
     },
     "explicacion": {
      "@es": "Esa es una rutina.",
      "@en": "That's a routine."
     }
    }
   ]
  },
