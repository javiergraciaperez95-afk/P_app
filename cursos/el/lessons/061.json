 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Mensajes breves",
    "@en": "Short messages"
   },
   "texto": [
    {
     "@es": "**Άφησα μήνυμα** significa «dejé un mensaje». En un mensaje anota primero el nombre, el teléfono, el motivo y la hora para devolver la llamada.",
     "@en": "**Άφησα μήνυμα** means «I left a message.». In a message, first, he notes the name, the phone, the reason and the time to return the call."
    },
    {
     "@es": "**Μπορείτε να με καλέσετε πίσω;** es «¿puede llamarme de vuelta?». Con amigos, **πάρε με όταν μπορείς** es una petición informal: llámame cuando puedas.",
     "@en": "**Μπορείτε να με καλέσετε πίσω;** is «Can you call me back?». With friends, **πάρε με όταν μπορείς** is an informal request: call me when you can."
    }
   ]
  },
