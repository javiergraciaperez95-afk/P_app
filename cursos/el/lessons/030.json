     },
     "correcta": true
    },
    {
     "texto": "θέλω",
     "explicacion": {
      "@es": "«Δεν θέλω» significa no quiero.",
      "@en": "«Δεν θέλω» means I don't want to."
     }
    },
    {
     "texto": "έχω",
     "explicacion": {
      "@es": "«Δεν έχω» significa no tengo.",
      "@en": "«Δεν έχω» means I don't have."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "Escucha. ¿Qué significa?",
