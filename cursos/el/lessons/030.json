   "id": "el030-1",
   "opciones": [
    {
     "texto": "Με λένε Άννα.",
     "explicacion": {
      "@es": "«Με λένε» es la fórmula de presentación.",
      "@en": "«Με λένε» is the presentation formula."
     },
     "correcta": true
    },
    {
     "texto": "Πού μένω;",
     "explicacion": {
      "@es": "Significa dónde vivo.",
      "@en": "It means where I live."
     }
    },
    {
     "texto": "Θέλω νερό.",
     "explicacion": {
      "@es": "Significa quiero agua.",
      "@en": "It means I want water."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué significa «Πού μένεις;»?",
    "@en": "What does «Πού μένεις;» mean?"
   },
   "id": "el030-2",
   "opciones": [
    {
     "texto": {
      "@es": "¿Dónde vives?",
      "@en": "Where do you live?"
     },
     "explicacion": {
      "@es": "«Μένεις» es la forma tú de «vivo».",
      "@en": "«Μένεις» is the way you are of «alive»."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "¿Qué quieres?",
      "@en": "What do you want?"
     },
     "explicacion": {
      "@es": "Se pregunta «Τι θέλεις;».",
      "@en": "You ask «Τι θέλεις;»."
     }
    },
    {
     "texto": {
      "@es": "¿Cuánto cuesta?",
      "@en": "How much is it?"
     },
     "explicacion": {
      "@es": "Se pregunta «Πόσο κοστίζει;».",
      "@en": "You ask «Πόσο κοστίζει;»."
     }
    }
   ]
  },
  {
   "tipo": "traduccion",
   "pregunta": {
    "@es": "¿Qué significa?",
    "@en": "What does that mean?"
   },
   "frase": "Θα ήθελα ένα νερό, παρακαλώ.",
   "id": "el030-3",
   "opciones": [
    {
     "texto": {
      "@es": "Quisiera un agua, por favor.",
      "@en": "I'd like a water, please."
     },
     "explicacion": {
      "@es": "Una petición educada en un café.",
      "@en": "An educated request in a coffee."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Quiero un café con leche.",
      "@en": "I want a coffee and milk."
     },
     "explicacion": {
      "@es": "Café es «καφέ».",
      "@en": "Coffee is «καφέ»."
     }
    },
    {
     "texto": {
      "@es": "Me gusta el agua.",
      "@en": "I like water."
     },
     "explicacion": {
      "@es": "«Μου αρέσει» significa me gusta.",
      "@en": "«Μου αρέσει» means I like it."
     }
    }
   ]
  },
  {
   "tipo": "huecos",
   "pregunta": {
    "@es": "Completa la frase.",
    "@en": "Complete the sentence."
