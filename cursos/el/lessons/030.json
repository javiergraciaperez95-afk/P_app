    {
     "texto": {
      "@es": "¿Cuánto cuesta el billete?",
      "@en": "How much is the ticket?"
     },
     "explicacion": {
      "@es": "Billete es «εισιτήριο».",
      "@en": "Ticket is «εισιτήριο»."
     }
    }
   ]
  },
