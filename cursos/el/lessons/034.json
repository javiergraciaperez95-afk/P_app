{
 "capitulo": 11,
 "titulo_el": "Η οικογενειακή μου κατάσταση",
 "titulo_es": {
  "@es": "Mi situación familiar",
  "@en": "My family situation"
 },
 "palabras": {
  "παντρεμένος": {
   "es": "casado (masculino)",
   "en": "married (masculine)",
   "pron": "pandreménos"
  },
  "παντρεμένη": {
   "es": "casada (femenino)",
   "en": "married (feminine)",
   "pron": "pandreméni"
  },
  "ελεύθερος": {
   "es": "soltero; libre (masculino)",
   "en": "single; free (masculine)",
   "pron": "eléftheros"
  },
  "ελεύθερη": {
   "es": "soltera; libre (femenino)",
   "en": "single; free (feminine)",
   "pron": "eléftheri"
  },
  "γνωριστήκαμε": {
   "es": "nos conocimos",
   "en": "We met.",
   "pron": "ynoristíkame"
  },
  "χαίρομαι": {
   "es": "me alegro; encantado",
   "en": "I'm glad; delighted",
   "pron": "jérome"
  },
  "οικογενειακή": {
   "es": "familiar (femenino)",
   "en": "family member (feminine)",
   "pron": "ikoyeniakí"
  },
