   "en": "status, status",
   "pron": "katástasi"
  },
  "παιδιά": {
   "es": "niños; hijos",
   "en": "children;",
   "pron": "pediá"
  }
 },
 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Estado civil y relaciones",
    "@en": "Civil status and relations"
   },
   "texto": [
    {
     "@es": "**Είμαι παντρεμένος/παντρεμένη** significa «estoy casado/casada». **Είμαι ελεύθερος/ελεύθερη** puede significar «estoy soltero/soltera».",
     "@en": "**Είμαι παντρεμένος/παντρεμένη** means «I'm married / married». **Είμαι ελεύθερος/ελεύθερη** can mean «I'm single / single»."
    },
    {
     "@es": "Para hablar de dos personas, puedes decir **Γνωριστήκαμε στη δουλειά** (nos conocimos en el trabajo). En una charla informal, **μαζί** significa juntos; **χαίρομαι** expresa alegría o gusto al conocer a alguien.",
     "@en": "To talk about two people, you can say **Γνωριστήκαμε στη δουλειά** (we met at work). In an informal talk, **μαζί** means together; **χαίρομαι** expresses joy or taste in meeting someone."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": "Οικογένεια και γνωριμίες",
   "palabras": [
    "παντρεμένος",
    "παντρεμένη",
    "ελεύθερος",
    "ελεύθερη",
    "γνωριστήκαμε",
    "χαίρομαι",
    "οικογενειακή",
    "κατάσταση",
    "παιδιά"
   ]
  },
