{
 "capitulo": 11,
 "titulo_el": "Ο χαρακτήρας της",
 "titulo_es": {
  "@es": "Su carácter",
  "@en": "Its character"
 },
 "palabras": {
  "χαρακτήρας": {
   "es": "carácter",
   "en": "character",
   "pron": "jaraktíras"
  },
  "ευγενικός": {
   "es": "amable, educado (masculino)",
   "en": "friendly, educated (masculine)",
   "pron": "evyenikós"
  },
  "ευγενική": {
   "es": "amable, educada (femenino)",
   "en": "friendly, educated (feminine)",
   "pron": "evyenikí"
  },
  "αστείος": {
   "es": "gracioso (masculino)",
   "en": "funny (masculine)",
   "pron": "astíos"
  },
  "αστεία": {
   "es": "graciosa (femenino)",
   "en": "funny (feminine)",
   "pron": "astía"
  },
  "ήσυχος": {
   "es": "tranquilo (masculino)",
   "en": "quiet (masculine)",
   "pron": "ísijos"
  },
  "ήσυχη": {
   "es": "tranquila (femenino)",
   "en": "quiet (feminine)",
   "pron": "ísiji"
  },
  "από": {
   "es": "que, de, desde",
   "en": "which, from, from",
   "pron": "apó"
  },
  "ντροπαλός": {
   "es": "tímido (masculino)",
   "en": "timid (masculine)",
   "pron": "dropalós"
  },
  "ντροπαλή": {
   "es": "tímida (femenino)",
   "en": "timid (feminine)",
   "pron": "dropalí"
  },
  "που": {
   "es": "que",
   "en": "that",
   "pron": "pu"
  },
  "γνωρίζω": {
   "es": "conozco",
   "en": "I know.",
   "pron": "ynorízo"
  },
  "κι": {
   "es": "y (forma de και)",
   "en": "and (form of και)",
   "pron": "ki",
   "oculta": true
  }
 },
 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Carácter y comparación",
    "@en": "Nature and comparison"
   },
   "texto": [
    {
     "@es": "**Ο χαρακτήρας** es el carácter. Algunos adjetivos frecuentes son **ευγενικός** (amable), **αστείος** (gracioso) y **ήσυχος** (tranquilo).",
     "@en": "**Ο χαρακτήρας** is the character. Some frequent adjectives are **ευγενικός** (friendly), **αστείος** (funny) and **ήσυχος** (quiet)."
    },
    {
     "@es": "Para comparar, coloca **πιο** antes del adjetivo: **πιο ήσυχη από την αδελφή της** (más tranquila que su hermana). El adjetivo concuerda con la persona descrita.",
     "@en": "To compare, place **πιο** before adjective: **πιο ήσυχη από την αδελφή της** (quieter than your sister). The adjective matches the person described."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": "Χαρακτήρας και επίθετα",
   "palabras": [
    "χαρακτήρας",
    "ευγενικός",
    "ευγενική",
    "αστείος",
    "αστεία",
    "ήσυχος",
    "ήσυχη",
    "από",
    "ντροπαλός",
    "ντροπαλή",
    "που",
    "γνωρίζω"
   ]
  },
  {
   "tipo": "dialogo",
   "titulo": "Δύο αδελφές",
   "frases": [
    {
     "quien": "Μαρία",
     "el": "Η Άννα είναι πολύ ευγενική και αστεία.",
     "es": "Anna es muy amable y graciosa.",
     "en": "Anna is very kind and funny.",
     "analisis": [
      [
       "ευγενική",
       {
        "@es": "amable",
        "@en": "Nice."
       }
      ],
      [
       "αστεία",
       {
        "@es": "graciosa",
        "@en": "Funny."
       }
      ]
     ]
    },
    {
     "quien": "Σοφία",
     "el": "Και η αδελφή της;",
     "es": "¿Y su hermana?",
     "en": "And your sister?",
     "analisis": [
      [
       "αδελφή της",
       {
        "@es": "su hermana",
        "@en": "his sister"
       }
      ]
     ]
    },
    {
     "quien": "Μαρία",
     "el": "Είναι πιο ήσυχη από την Άννα, αλλά όχι ντροπαλή.",
     "es": "Es más tranquila que Anna, pero no es tímida.",
     "en": "She's quieter than Anna, but she's not shy.",
     "analisis": [
      [
       "πιο ήσυχη από",
       {
        "@es": "más tranquila que",
        "@en": "quieter than"
       }
      ],
      [
       "αλλά",
       {
        "@es": "pero",
        "@en": "but"
       }
      ],
      [
       "όχι",
       {
        "@es": "no",
        "@en": "No."
       }
      ]
     ]
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Cómo es Anna?",
    "@en": "What's Anna like?"
   },
   "id": "el002-1",
   "opciones": [
    {
     "texto": {
      "@es": "Muy amable y graciosa.",
      "@en": "Very kind and funny."
     },
     "explicacion": {
      "@es": "«Ευγενική» y «αστεία» son sus rasgos.",
      "@en": "«Ευγενική» and «αστεία» are his features."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Tranquila y tímida.",
      "@en": "Easy and shy."
     },
     "explicacion": {
      "@es": "Esa descripción es la de su hermana, salvo que no es tímida.",
      "@en": "That description is his sister's, except she's not shy."
     }
    },
    {
     "texto": {
      "@es": "Baja y seria.",
      "@en": "Come down and be serious."
     },
     "explicacion": {
      "@es": "No se describe su altura ni se dice que sea seria.",
      "@en": "His height is not described or said to be serious."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué quiere decir «πιο ήσυχη από»?",
    "@en": "What do you mean, «πιο ήσυχη από»?"
   },
   "id": "el002-2",
   "opciones": [
    {
     "texto": {
      "@es": "Más tranquila que.",
      "@en": "It's more quiet than that."
     },
     "explicacion": {
      "@es": "«Πιο» introduce la comparación.",
      "@en": "«Πιο» introduces the comparison."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Menos tranquila que.",
      "@en": "Less quiet than that."
     },
     "explicacion": {
      "@es": "No aparece «λιγότερο».",
      "@en": "«λιγότερο» does not appear."
     }
    },
    {
     "texto": {
      "@es": "Tan tranquila como.",
      "@en": "As quiet as it is."
     },
     "explicacion": {
      "@es": "No aparece «τόσο… όσο».",
      "@en": "«τόσο… όσο» does not appear."
     }
    }
   ]
  },
  {
   "tipo": "traduccion",
   "pregunta": {
    "@es": "¿Qué significa?",
    "@en": "What does that mean?"
   },
   "frase": "Είναι πιο ευγενική από την αδελφή της.",
   "id": "el002-3",
   "opciones": [
    {
     "texto": {
      "@es": "Es más amable que su hermana.",
      "@en": "He's nicer than his sister."
     },
     "explicacion": {
      "@es": "«Πιο» + adjetivo expresa comparación.",
      "@en": "«Πιο» + adjective expresses comparison."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Es tan amable como su hermana.",
      "@en": "He's as kind as his sister."
     },
     "explicacion": {
      "@es": "Para «tan… como» se usa otra estructura.",
      "@en": "Another structure is used for «as much as»."
     }
    },
    {
     "texto": {
      "@es": "Es menos amable que su hermana.",
      "@en": "He's less kind than his sister."
     },
     "explicacion": {
      "@es": "La frase dice «más».",
      "@en": "The phrase says «more»."
     }
    }
   ]
  },
  {
   "tipo": "huecos",
   "pregunta": {
    "@es": "Completa la frase.",
    "@en": "Complete the sentence."
   },
   "frase": "Ο Κώστας είναι πιο ___ από τον Νίκο.",
   "id": "el002-4",
   "opciones": [
    {
     "texto": "ήσυχος",
     "explicacion": {
      "@es": "La forma masculina concuerda con Κώστας.",
      "@en": "The masculine form is consistent with Κώστας."
     },
     "correcta": true
    },
    {
     "texto": "ήσυχη",
     "explicacion": {
      "@es": "Es la forma femenina.",
      "@en": "It's the feminine form."
     }
    },
    {
     "texto": "ήσυχα",
     "explicacion": {
      "@es": "Es una forma neutra o adverbial.",
      "@en": "It's a neutral or adverse form."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "Escucha. ¿Qué significa?",
    "@en": "Listen. What does that mean?"
   },
   "audio": "Η Μαρία είναι αστεία.",
   "id": "el002-5",
   "opciones": [
    {
     "texto": {
      "@es": "María es graciosa.",
      "@en": "Mary is funny."
     },
     "explicacion": {
      "@es": "«Αστεία» describe a una mujer.",
      "@en": "«Αστεία» describes a woman."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "María es tímida.",
      "@en": "Mary is shy."
     },
     "explicacion": {
      "@es": "Tímida es «ντροπαλή».",
      "@en": "Stimid is «ντροπαλή»."
     }
    },
    {
     "texto": {
      "@es": "María es amable.",
      "@en": "Mary is kind."
     },
     "explicacion": {
      "@es": "Amable es «ευγενική».",
      "@en": "Nice is «ευγενική»."
     }
    }
   ]
  },
  {
   "tipo": "ordenar",
   "pregunta": {
    "@es": "Ordena las palabras.",
    "@en": "Order the words."
   },
   "frase": "είναι πιο ήσυχη από την Άννα",
   "traduccion": {
    "@es": "es más tranquila que Anna",
    "@en": "is quieter than Anna"
   },
   "explicacion": {
    "@es": "«Πιο» va delante del adjetivo.",
    "@en": "«Πιο» goes in front of the adjective."
   },
   "id": "el002-6"
  },
  {
   "tipo": "escribir",
   "pregunta": {
    "@es": "Escribe en griego: «tímida»",
    "@en": "Write in Greek: «timid»"
   },
