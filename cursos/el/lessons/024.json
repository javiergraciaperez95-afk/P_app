{
 "capitulo": 8,
 "titulo_el": "Κατευθύνσεις και ανακοινώσεις",
 "titulo_es": {
  "@es": "Direcciones y anuncios",
  "@en": "Directions and announcements"
 },
 "palabras": {
  "πηγαίνετε": {
   "es": "vaya, vayan",
   "en": "Go, go, go.",
   "pron": "piyénete"
  },
  "στρίψτε": {
   "es": "gire, giren",
   "en": "Turn, turn.",
   "pron": "strípste"
  },
  "στα δεξιά": {
   "es": "a la derecha",
   "en": "Right.",
   "pron": "sta dexiá"
  },
  "στα αριστερά": {
   "es": "a la izquierda",
   "en": "left",
   "pron": "sta aristerá"
  },
  "αναχώρηση": {
   "es": "salida",
   "en": "output",
   "pron": "anajórisi"
  },
  "άφιξη": {
   "es": "llegada",
   "en": "arrival",
   "pron": "áfixi"
  },
  "αναχώρηση για": {
   "es": "salida hacia",
   "en": "output to",
   "pron": "anajórisi ya"
  },
  "στις": {
   "es": "a las",
   "en": "No.",
   "pron": "stis"
  },
  "Θεσσαλονίκη": {
   "es": "Salónica",
   "en": "Thessaloniki",
   "pron": "thessaloníki"
  },
  "λέει": {
   "es": "dice",
   "en": "It says",
   "pron": "léi"
  },
  "ανακοίνωση": {
   "es": "anuncio",
   "en": "Announcement",
   "pron": "anakínosi"
  },
  "αναχωρεί": {
   "es": "sale, parte",
   "en": "Get out, part",
   "pron": "anajorí"
  }
 },
 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Indicaciones breves",
    "@en": "Short indications"
   },
   "texto": [
    {
     "@es": "Para dar una instrucción formal, se puede usar **Πηγαίνετε…** (vaya) y **στρίψτε…** (gire). **Στα δεξιά** es a la derecha; **στα αριστερά**, a la izquierda.",
     "@en": "To give a formal instruction, you can use **Πηγαίνετε…** (go) and **στρίψτε…** (turn). **Στα δεξιά** is to the right; **στα αριστερά** is to the left."
    },
    {
     "@es": "En un anuncio, busca primero el destino, la hora y el medio de transporte. **Αναχώρηση** significa salida y **άφιξη**, llegada.",
     "@en": "In an ad, first look for the destination, the time and the means of transport. **Αναχώρηση** means output and **άφιξη**, arrival."
    }
   ]
  },
  {
