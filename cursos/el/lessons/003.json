        "@en": "(courteous form)"
       }
      ]
     ]
    },
    {
     "quien": "Άννα",
     "el": "Νερό, παρακαλώ.",
     "es": "Agua, por favor.",
     "en": "Water, please.",
     "analisis": [
      [
       "Νερό",
       {
        "@es": "agua",
        "@en": "water"
       }
      ],
      [
       "παρακαλώ",
       {
        "@es": "por favor",
        "@en": "Please."
       }
      ]
     ]
    },
    {
     "quien": "Κώστας",
     "el": "Ορίστε.",
     "es": "Aquí tiene.",
     "en": "Here you go.",
     "analisis": [
      [
       "Ορίστε",
       {
        "@es": "expresión al entregar algo",
        "@en": "expression when delivering something"
       }
      ]
     ]
    },
    {
     "quien": "Άννα",
     "el": "Ευχαριστώ πολύ.",
     "es": "Muchas gracias.",
     "en": "Thank you very much.",
     "analisis": [
      [
       "Ευχαριστώ",
       {
        "@es": "gracias",
        "@en": "Thank you."
       }
      ],
      [
       "πολύ",
       {
        "@es": "mucho",
        "@en": "a lot."
       }
      ]
     ]
    }
   ]
  },
  {
   "tipo": "texto",
   "titulo": "Πώς σε λένε;",
