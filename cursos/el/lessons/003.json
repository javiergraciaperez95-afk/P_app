{
 "capitulo": 1,
 "titulo_el": "Χαιρετισμοί",
 "titulo_es": {
  "@es": "Saludos y expresiones de cortesía",
  "@en": "Greetings and expressions of courtesy"
 },
 "palabras": {
  "σου": {
   "es": "a ti (informal)",
   "en": "to you (informal)",
   "pron": "su"
  },
  "σας": {
   "es": "a usted; a ustedes",
   "en": "You; you.",
   "pron": "sas"
  },
  "καλημέρα": {
   "es": "buenos días",
   "en": "Good morning.",
   "pron": "kaliméra"
  },
  "καλησπέρα": {
   "es": "buenas tardes, buenas noches (al llegar)",
   "en": "Good evening, good night (when you arrive)",
   "pron": "kalispéra"
  },
  "καληνύχτα": {
   "es": "buenas noches (al despedirse)",
   "en": "good night (when you say goodbye)",
   "pron": "kaliníjta"
  },
  "αντίο": {
   "es": "adiós",
   "en": "Bye.",
   "pron": "adío"
  },
  "παρακαλώ": {
   "es": "por favor; de nada",
   "en": "Please; you're welcome.",
   "pron": "parakaló"
  },
  "συγγνώμη": {
   "es": "perdón, disculpe",
   "en": "Sorry, sorry.",
   "pron": "signómi"
  },
  "με": {
   "es": "me, a mí",
   "en": "Me.",
   "pron": "me"
  },
  "σε": {
   "es": "te, a ti",
   "en": "you",
   "pron": "se"
  },
  "θέλετε": {
   "es": "quiere, desea (cortés)",
   "en": "want, want (courteous)",
   "pron": "thélete"
  },
  "ορίστε": {
   "es": "aquí tiene; dígame",
   "en": "Here you go; tell me",
   "pron": "oríste"
  },
  "λένε": {
   "es": "llaman",
   "en": "They call",
   "pron": "léne"
  },
  "το": {
   "es": "el, lo (neutro)",
   "en": "the, the (neutral)",
   "pron": "to"
  },
  "όνομα": {
   "es": "nombre",
   "en": "name",
   "pron": "ónoma"
  }
 },
 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Saludar con educación",
    "@en": "Greeting with education"
   },
   "texto": [
    {
     "@es": "**Γεια σου** es informal; **Γεια σας** sirve para saludar a varias personas o dirigirse con cortesía a una persona. **Καλημέρα** se usa por la mañana; **Καλησπέρα** por la tarde y al anochecer.",
     "@en": "**Γεια σου** is informal; **Γεια σας** serves to greet several people or to address one person with courtesy. **Καλημέρα** is used in the morning; **Καλησπέρα** in the afternoon and at dusk."
    },
    {
     "@es": "Para despedirse se puede decir **Αντίο**. **Παρακαλώ** significa «por favor» y también se usa al responder a «gracias».",
     "@en": "To say goodbye you can say **Αντίο**. **Παρακαλώ** means «Please.» and is also used when responding to «Thank you.»."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": "Χαιρετισμοί και ευγένεια",
   "palabras": [
    "σου",
    "σας",
    "καλημέρα",
    "καλησπέρα",
    "καληνύχτα",
    "αντίο",
    "παρακαλώ",
    "συγγνώμη",
    "με",
    "σε",
    "θέλετε",
    "ορίστε",
    "λένε",
    "το",
    "όνομα"
   ]
  },
  {
   "tipo": "dialogo",
   "titulo": "Στο καφέ",
   "frases": [
