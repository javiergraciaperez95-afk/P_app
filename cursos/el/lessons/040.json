      "@en": "It says «λίγο αργότερα»."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Ahora mismo.",
      "@en": "Right now."
     },
     "explicacion": {
      "@es": "Dice que ahora no puede.",
      "@en": "He says he can't now."
     }
    },
    {
     "texto": {
      "@es": "Mañana por la mañana.",
      "@en": "Tomorrow morning."
     },
     "explicacion": {
      "@es": "No da esa hora.",
      "@en": "It doesn't give that time."
     }
    }
   ]
  },
  {
   "tipo": "traduccion",
   "pregunta": {
    "@es": "¿Qué significa?",
    "@en": "What does that mean?"
   },
   "frase": "Δεν μπορώ τώρα.",
   "id": "el009-3",
   "opciones": [
    {
     "texto": {
      "@es": "Ahora no puedo.",
      "@en": "I can't right now."
     },
     "explicacion": {
      "@es": "«Δεν» niega «μπορώ».",
      "@en": "«Δεν» denies «μπορώ»."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "No quiero hacerlo mañana.",
      "@en": "I don't want to do it tomorrow."
     },
     "explicacion": {
      "@es": "No se menciona querer ni mañana.",
      "@en": "There's no mention of wanting tomorrow."
     }
    },
    {
     "texto": {
      "@es": "Puedo hacerlo ahora.",
      "@en": "I can do it now."
     },
     "explicacion": {
      "@es": "Es lo contrario.",
      "@en": "It's the opposite."
     }
    }
   ]
  },
