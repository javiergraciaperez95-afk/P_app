   "es": "claro, por supuesto",
   "en": "Of course.",
   "pron": "vévea"
  },
  "φυσικά": {
   "es": "naturalmente, por supuesto",
   "en": "Of course.",
   "pron": "fisiká"
  },
  "αργότερα": {
   "es": "más tarde",
   "en": "later",
   "pron": "argótera"
  },
  "σκουπίζω": {
   "es": "barro, paso la escoba",
   "en": "mud, pass the broom",
   "pron": "skupízo"
  },
  "σφουγγαρίζω": {
   "es": "friego el suelo",
   "en": "I fry the ground",
   "pron": "sfungarízo"
  },
  "σκουπίσεις": {
   "es": "barras",
   "en": "bars",
   "pron": "skupísis",
   "oculta": true
  },
  "πάτωμα": {
   "es": "suelo",
   "en": "ground",
   "pron": "pátoma",
   "oculta": true
  },
  "σφουγγαρίσεις": {
   "es": "friegues el suelo",
   "en": "you fry the ground",
   "pron": "sfungarísis",
   "oculta": true
  },
  "βοηθήσετε": {
   "es": "ayude (cortés)",
   "en": "help (courteous)",
   "pron": "voithísete",
   "oculta": true
  }
 },
 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Poder, pedir y responder",
    "@en": "Power, ask and answer"
   },
   "texto": [
    {
     "@es": "**Μπορείς να…;** pregunta «¿puedes…?». Para una petición cortés, usa **Μπορείτε να…;**.",
     "@en": "**Μπορείς να…;** asks «Can you?». For a polite request, use **Μπορείτε να…;**."
    },
    {
     "@es": "Para aceptar: **Βέβαια** (claro) o **Φυσικά** (por supuesto). Para explicar que no puedes, añade **δεν**: **Δεν μπορώ τώρα** (ahora no puedo). **Λίγο αργότερα** significa un poco más tarde.",
     "@en": "To accept: **Βέβαια** (clear) or **Φυσικά** (of course). To explain that you can't, add **δεν**: **Δεν μπορώ τώρα** (I can't now). **Λίγο αργότερα** means a little later."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": "Ζητάμε βοήθεια",
   "palabras": [
    "μπορείτε",
    "βέβαια",
    "φυσικά",
    "αργότερα",
    "σκουπίζω",
    "σφουγγαρίζω"
   ]
  },
  {
   "tipo": "dialogo",
   "titulo": "Μια μικρή χάρη",
   "frases": [
    {
     "quien": "Μαρία",
     "el": "Μπορείς να σκουπίσεις το πάτωμα;",
     "es": "¿Puedes barrer el suelo?",
     "en": "Can you sweep the floor?",
     "analisis": [
      [
       "μπορείς να",
       {
        "@es": "puedes",
        "@en": "You can."
       }
      ],
      [
       "σκουπίσεις",
       {
        "@es": "barrer",
        "@en": "sweep"
       }
      ],
      [
       "πάτωμα",
       {
        "@es": "suelo",
        "@en": "ground"
       }
      ]
     ]
    },
    {
     "quien": "Άννα",
     "el": "Βέβαια. Και μπορείς να σφουγγαρίσεις μετά;",
     "es": "Claro. ¿Y puedes fregar después?",
     "en": "Sure. And can you do the scrubbing later?",
     "analisis": [
      [
       "βέβαια",
       {
        "@es": "claro",
        "@en": "Of course."
       }
      ],
      [
       "σφουγγαρίσεις",
       {
        "@es": "fregar",
        "@en": "mop"
       }
      ],
      [
       "μετά",
       {
        "@es": "después",
        "@en": "after"
       }
      ]
     ]
    },
    {
     "quien": "Μαρία",
     "el": "Δεν μπορώ τώρα, αλλά μπορώ λίγο αργότερα.",
     "es": "Ahora no puedo, pero puedo un poco más tarde.",
     "en": "I can't now, but I can a little later.",
     "analisis": [
      [
       "δεν μπορώ",
       {
        "@es": "no puedo",
        "@en": "I can't."
       }
      ],
      [
       "τώρα",
       {
        "@es": "ahora",
        "@en": "Now"
       }
      ],
      [
       "αργότερα",
       {
        "@es": "más tarde",
        "@en": "later"
       }
      ]
     ]
    }
   ]
  },
  {
