{
 "capitulo": 9,
 "titulo_el": "Μπορείς να με βοηθήσεις;",
 "titulo_es": {
  "@es": "¿Puedes ayudarme?",
  "@en": "Can you help me?"
 },
 "palabras": {
  "μπορείτε": {
   "es": "puede (usted); podéis",
   "en": "can (you); can",
   "pron": "boríte"
  },
