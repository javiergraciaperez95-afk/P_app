{
 "capitulo": 3,
 "titulo_el": "Πού είναι;",
 "titulo_es": {
  "@es": "Decir dónde está algo",
  "@en": "To say where something is"
 },
 "palabras": {
  "σε": {
   "es": "en, a",
   "en": "in, a",
   "pron": "se"
  },
  "στη": {
   "es": "en la (femenino)",
   "en": "in the (feminine)",
   "pron": "sti"
  },
  "στον": {
   "es": "en el, al (masculino)",
   "en": "in the, al (masculine)",
   "pron": "ston"
  },
  "πάνω": {
   "es": "encima, arriba",
   "en": "On top, on top",
   "pron": "páno"
  },
  "κάτω": {
   "es": "debajo, abajo",
   "en": "down, down",
   "pron": "káto"
  },
  "μέσα": {
   "es": "dentro",
   "en": "inside",
   "pron": "mésa"
  },
  "έξω": {
   "es": "fuera",
   "en": "outside",
   "pron": "ékso"
  },
  "κινητό": {
   "es": "teléfono móvil",
   "en": "mobile phone",
   "pron": "kinitó"
  },
  "τσάντα": {
   "es": "bolso",
   "en": "bag",
   "pron": "tsánta"
  },
  "ψυγείο": {
   "es": "nevera",
   "en": "refrigerator",
   "pron": "psiyío"
  },
  "είναι": {
   "es": "está, es",
   "en": "It's, it's",
   "pron": "íne"
  }
 },
 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Lugar: σε + artículo",
    "@en": "Place: σε + article"
   },
   "texto": [
    {
     "@es": "**Πού είναι;** significa «¿dónde está?». La preposición **σε** (en/a) se combina con el artículo: **στο** (en el, neutro), **στη** (en la, femenino) y **στον** (en el, masculino).",
     "@en": "**Πού είναι;** means «Where is he?». The **σε** (in / a) preposition is combined with the article: **στο** (in the, neutral), **στη** (in the, feminine) and **στον** (in the, masculine)."
    },
    {
     "@es": "Para «está sobre la mesa» se dice **πάνω στο τραπέζι**. Para «está debajo de la mesa»: **κάτω από το τραπέζι**.",
     "@en": "For «is on the table» it is said **πάνω στο τραπέζι**. For «is under the table»: **κάτω από το τραπέζι**."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": "Πού είναι τα πράγματα;",
