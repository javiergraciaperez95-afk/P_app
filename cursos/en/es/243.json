     "tipo": "texto",
     "titulo": "Preparativos para el viaje",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Maya puts a charger in her bag in case her phone battery runs out.",
       "alumno": "Maya mete un cargador en el bolso por si su móvil se queda sin batería.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "She will pack a swimsuit if the hotel has a pool.",
       "alumno": "Llevará un bañador si el hotel tiene piscina.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "She can use the gym provided that she books a time slot.",
       "alumno": "Puede usar el gimnasio siempre que reserve una franja horaria.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "She may borrow a towel as long as she returns it.",
       "alumno": "Puede pedir prestada una toalla siempre que la devuelva.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Uso de «in case»",
     "texto": ["**In case** + presente simple presenta una precaución que tomas ahora porque algo quizá ocurra después. No equivale a **if**: **Take a charger in case your phone battery runs out** (lo llevas ya); **I'll pack a swimsuit if the hotel has a pool** (la decisión depende de esa condición). En la cláusula futura con **if**, usamos presente simple."],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "«Provided that» y «as long as»",
     "texto": ["**Provided that** y **as long as** pueden significar «siempre que» y fijan un requisito. **Provided that** suele sonar más formal; **as long as**, más cotidiano. Según el contexto, **as long as** también puede indicar duración («mientras»). **You can use the gym provided that you book a time slot**; **You may borrow a towel as long as you return it**."],
     "tutora": ""
    }
   ]
  },
