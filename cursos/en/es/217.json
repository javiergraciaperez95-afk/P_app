     "titulo": "A change of plan",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Mia was going to drive to the coast with Leo on Friday.",
       "alumno": "Mia iba a conducir hasta la costa con Leo el viernes.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "was going to drive",
         "tenía la intención de conducir"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Their car broke down, so they changed the plan.",
       "alumno": "Su coche se averió, así que cambiaron el plan.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "broke down",
         "se averió; el vehículo dejó de funcionar"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "They were going to cancel the trip, but Mia found a train.",
       "alumno": "Iban a cancelar el viaje, pero Mia encontró un tren.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "were going to cancel",
         "intención pasada; el resto de la frase informa de un cambio"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "They took the train instead and arrived before lunch.",
       "alumno": "En su lugar, fueron en tren y llegaron antes de comer.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "instead",
         "en lugar de la opción anterior"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
   ]
