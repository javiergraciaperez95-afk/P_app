   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Say y tell",
     "texto": [
      "**Say + contenido**; si nombras a quién se lo dices, usa **to**: **She said the room was ready** / **She said it to us**. Con **tell**, la persona va justo después: **She told us that the room was ready**; no digas **say us**."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Explain y ask",
     "texto": [
      "**Explain + contenido + to + persona**: **She explained the route to us**, no **explained us the route**. **Ask** introduce una pregunta (**She asked if the room was ready**) o una petición (**She asked us to wait**)."
     ],
     "tutora": ""
    }
   ]
  },
