   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Un proyecto vecinal",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "The committee set up a small team to carry out a survey about traffic.",
       "alumno": "El comité creó un equipo pequeño para realizar una encuesta sobre el tráfico.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "set up",
         "creó"
        ],
        [
         "carry out",
         "realizar"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "When the team ran out of funding, it had to put off the street trial.",
       "alumno": "Cuando el equipo se quedó sin fondos, tuvo que aplazar la prueba piloto en la calle.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "ran out of funding",
         "se quedó sin fondos"
        ],
        [
         "put off",
         "aplazar"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "At the next meeting, one member brought up a cheaper plan.",
       "alumno": "En la siguiente reunión, un miembro planteó un plan más barato.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "brought up",
         "planteó"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "The chair pointed out that the survey had included only two streets.",
       "alumno": "Quien presidía la reunión señaló que la encuesta solo había incluido dos calles.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "pointed out",
         "señaló"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "The council agreed to look into other sources of funding before deciding.",
       "alumno": "El ayuntamiento aceptó investigar otras fuentes de financiación antes de decidir.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "look into",
         "investigar"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "The council turned down the first proposal, but it did not call off the whole project.",
       "alumno": "El ayuntamiento rechazó la primera propuesta, pero no canceló todo el proyecto.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "turned down",
         "rechazó"
        ],
        [
         "call off",
         "cancelar"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "The team will figure out what went wrong and present a new plan next month.",
       "alumno": "El equipo averiguará qué salió mal y presentará un nuevo plan el mes que viene.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "figure out",
         "averiguar qué ocurrió"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
   ]
  },
  {
   "etapa": "palabras",
   "piezas": [
    {
     "tipo": "vocabulario",
     "titulo": "Vocabulario: proyectos y decisiones",
     "palabras": [
      "call off",
