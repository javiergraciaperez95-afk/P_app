     "titulo": "Un error en un informe",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Amy sent a report before lunch.",
       "alumno": "Amy envió un informe antes del almuerzo.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "sent a report",
         "envió un informe"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Later, she found two wrong figures in it.",
       "alumno": "Después, encontró dos cifras incorrectas en él.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "wrong figures",
         "cifras incorrectas"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "She regretted not checking them earlier.",
       "alumno": "Se arrepintió de no haberlas revisado antes.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "regretted not checking",
         "se arrepintió de no revisar"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "She had already sent the report, so she could not change it then.",
       "alumno": "Ya había enviado el informe, así que no pudo cambiarlo en ese momento.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "had already sent",
         "ya había enviado"
        ],
        [
         "could not change it then",
         "no pudo cambiarlo en ese momento"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
   ]
