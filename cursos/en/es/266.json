        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "The director had already cut one scene before the cast began rehearsals.",
       "alumno": "El director ya había eliminado una escena antes de que el reparto empezara los ensayos.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "scene",
         "escena"
        ],
        [
         "cast",
         "reparto"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "By opening night, the actors had been rehearsing for six weeks.",
       "alumno": "Para la noche del estreno, los actores llevaban seis semanas ensayando.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "by opening night",
         "para la noche del estreno"
        ],
        [
         "had been rehearsing",
         "llevaban ensayando"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "One costume had been repaired twice, but it still looked convincing from the back row.",
       "alumno": "Habían reparado dos veces uno de los trajes, pero desde la última fila todavía parecía convincente.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "costume",
         "vestuario"
        ],
        [
         "convincing",
         "convincente"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "The script was based on the original story, although the ending had been changed.",
       "alumno": "El guion se basaba en la historia original, aunque se había cambiado el final.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "script",
         "guion"
        ],
        [
         "ending",
         "final"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "The premiere sold out, and the audience praised the cast.",
       "alumno": "Se agotaron las entradas para el estreno y el público elogió al reparto.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "premiere",
         "estreno"
        ],
        [
         "sold out",
         "agotó las entradas"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "The next morning, a review praised the cast but said the final scene was too long.",
       "alumno": "A la mañana siguiente, una crítica elogió al reparto, pero dijo que la última escena era demasiado larga.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "review",
         "crítica"
        ],
        [
         "praised",
