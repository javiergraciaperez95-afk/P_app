       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "The play later won an award, and the author was invited to a question-and-answer event.",
       "alumno": "Más tarde, la obra ganó un premio y se invitó al autor a un acto de preguntas y respuestas.",
       "literal": "",
       "estructura": "",
       "nota": [],
