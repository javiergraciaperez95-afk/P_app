     "tipo": "texto",
     "titulo": "Una obra recuperada",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "The playwright, who holds a bachelor's degree in history, adapted a novel by a local author for the stage.",
       "alumno": "El dramaturgo, que tiene un título universitario de grado en Historia, adaptó para el escenario una novela de un autor local.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
