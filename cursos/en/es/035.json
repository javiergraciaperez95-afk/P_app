       "correcta": true
      },
      {
       "texto": "is",
       "lengua": "estudio",
       "explicacion": "«Is» se usa con he, she o it.",
       "correcta": false
      },
      {
       "texto": "do",
       "lengua": "estudio",
       "explicacion": "«Do» no forma el presente continuo.",
