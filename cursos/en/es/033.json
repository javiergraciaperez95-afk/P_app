   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "La hora",
     "texto": [
      "**What time is it?** — **It's nine o'clock** (son las nueve en punto).",
      "**Half past** = y media: **half past eight** (las ocho y media).",
      "**Quarter past** = y cuarto. **Quarter to** = menos cuarto: **quarter to ten** (las diez menos cuarto).",
      "Para decir a qué hora haces algo: **at**. **I get up at seven.**"
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "La hora",
     "columnas": [
      {
       "texto": "Reloj",
       "lengua": "alumno"
      },
      {
       "texto": "Se dice",
       "lengua": "alumno"
      }
     ],
     "filas": [
