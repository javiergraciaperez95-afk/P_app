  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Turismo y ciudad",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Tourism brings employment and income to the old town, but the number of visitors has also increased pollution.",
       "alumno": "El turismo genera empleo e ingresos en el casco antiguo, pero el número de visitantes también ha aumentado la contaminación.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "employment",
         "empleo"
        ],
        [
         "pollution",
         "contaminación"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "The council proposed investing in electric buses and limiting traffic near the historic square.",
       "alumno": "El ayuntamiento propuso invertir en autobuses eléctricos y limitar el tráfico cerca de la plaza histórica.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "proposed",
         "propuso"
        ],
        [
         "investing",
         "invertir"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Local businesses welcomed the plan because visitors would be able to reach more areas without a car.",
       "alumno": "Los comercios locales acogieron bien el plan porque los visitantes podrían llegar a más zonas sin coche.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "welcomed",
         "acogieron bien"
        ],
        [
         "reach",
         "llegar a"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "However, some residents worried that higher rents in tourist areas would push small shops out of the centre.",
       "alumno": "Sin embargo, algunos residentes temían que los alquileres más altos en las zonas turísticas expulsaran a las tiendas pequeñas del centro.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "however",
         "sin embargo"
        ],
        [
         "rents",
         "alquileres"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "A community survey showed broad support for cleaner transport, although people disagreed about how to pay for it.",
       "alumno": "Una encuesta vecinal mostró un amplio apoyo al transporte menos contaminante, aunque la gente no se puso de acuerdo sobre cómo pagarlo.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "broad support",
         "amplio apoyo"
        ],
        [
         "although",
         "aunque"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "A local campaign group accused the council of deception over its promise of a zero-emission city because no timetable had been published.",
       "alumno": "Un grupo vecinal acusó al ayuntamiento de engañar a la gente con su promesa de una ciudad sin emisiones, porque no había publicado ningún calendario.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "deception",
         "engaño, no «decepción»"
        ],
        [
         "timetable",
         "calendario"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "The proposal includes grants for local shops and a review of the plan after one year.",
       "alumno": "La propuesta incluye ayudas para los comercios locales y una revisión del plan al cabo de un año.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "grants",
         "ayudas"
        ],
        [
         "review",
         "revisión"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "The aim is sustainable growth: tourism should create wealth that benefits the whole community.",
       "alumno": "El objetivo es un crecimiento sostenible: el turismo debería generar riqueza para toda la comunidad.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "sustainable growth",
         "crecimiento sostenible"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Residents remain cautious: they want evidence that the benefits will reach the whole community.",
       "alumno": "Los residentes siguen siendo prudentes: quieren pruebas de que los beneficios llegarán a toda la comunidad.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "cautious",
         "prudentes"
        ],
        [
         "evidence",
         "pruebas"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
   ]
