     "titulo": "Preparativos para la fiesta",
     "frases": [
      {
       "quien": {
        "texto": "Anna",
        "lengua": "estudio"
       },
       "estudio": "Mum wants you to come to the party on Friday.",
       "alumno": "Mi madre quiere que vengas a la fiesta el viernes.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "wants you to come",
         "quiere que vengas"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Tom",
        "lengua": "estudio"
       },
       "estudio": "Thanks. I always forget dates.",
       "alumno": "Gracias. Siempre se me olvidan las fechas.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "always forget",
         "siempre se me olvidan"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Anna",
        "lengua": "estudio"
       },
       "estudio": "I’ll remind you to write it down.",
       "alumno": "Te recordaré que lo anotes.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "remind you to write",
         "recordarte que lo anotes"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Tom",
        "lengua": "estudio"
       },
       "estudio": "Do you expect the guests to arrive at seven?",
       "alumno": "¿Esperas que los invitados lleguen a las siete?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "expect the guests to arrive",
         "esperar que los invitados lleguen"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Anna",
        "lengua": "estudio"
       },
       "estudio": "Yes. Please encourage them to bring a board game.",
       "alumno": "Sí. Anímalos a traer un juego de mesa.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "encourage them to bring",
         "animarlos a traer"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Tom",
        "lengua": "estudio"
       },
       "estudio": "I’ll persuade Sam to come, but I won’t force him.",
       "alumno": "Convenceré a Sam para que venga, pero no lo obligaré.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "persuade Sam to come",
         "convencer a Sam para que venga"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Anna",
        "lengua": "estudio"
       },
       "estudio": "Do you want me to order a cake?",
       "alumno": "¿Quieres que encargue una tarta?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "want me to order",
         "querer que encargue"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Tom",
        "lengua": "estudio"
       },
       "estudio": "Yes, and please allow me to pay for it.",
       "alumno": "Sí, y por favor, permíteme pagarla.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "allow me to pay",
         "permitirme pagar"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Anna",
        "lengua": "estudio"
       },
       "estudio": "Don’t beg me to choose the flavour!",
       "alumno": "¡No me supliques que elija el sabor!",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "beg me to choose",
         "suplicarme que elija"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Tom",
        "lengua": "estudio"
       },
       "estudio": "OK, let me help you choose.",
       "alumno": "Vale, déjame ayudarte a elegir.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "let me help",
         "déjame ayudar"
        ]
       ],
       "parrafo": 0
      }
     ]
