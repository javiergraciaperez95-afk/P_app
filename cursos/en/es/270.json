         "habían olvidado"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "When she reached home, the lights were off.",
       "alumno": "Cuando llegó a casa, las luces estaban apagadas.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "reached home",
         "llegó a casa"
        ],
        [
         "were off",
         "estaban apagadas"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Her friends had hidden in the living room before she arrived.",
       "alumno": "Sus amigos se habían escondido en la sala de estar antes de que ella llegara.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "had hidden",
         "se habían escondido"
        ],
        [
         "before she arrived",
         "antes de que ella llegara"
