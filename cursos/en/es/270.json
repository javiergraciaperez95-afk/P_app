       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "They had decorated the room and put a cake on the table.",
       "alumno": "Habían decorado la habitación y puesto una tarta en la mesa.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "had decorated",
         "habían decorado"
        ],
        [
         "put a cake on the table",
         "puesto una tarta en la mesa"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "When Mia opened the door, everyone shouted, “Surprise!”",
       "alumno": "Cuando Mia abrió la puerta, todos gritaron: «¡Sorpresa!».",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
