    {
     "tipo": "texto",
     "titulo": "Una sorpresa de cumpleaños",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Mia thought her friends had forgotten her birthday.",
