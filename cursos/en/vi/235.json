 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Hình thức",
     "texto": [
      "Mệnh đề quan hệ bổ sung thêm thông tin không cần thiết để xác định người hoặc vật, và được đặt giữa hai dấu phẩy. Dùng **who/whom** cho người, **which** cho vật và **whose + danh từ** cho sở hữu. Không dùng **that** và không bỏ đại từ.",
      "**The museum, which is near the station, opens at ten.** = Bảo tàng, nằm gần ga, mở cửa lúc mười giờ."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Dấu phẩy và ý nghĩa",
     "texto": [
      "Thông tin giữa hai dấu phẩy là thông tin thêm: khi bỏ đi, vẫn rõ đang nói về ai hoặc cái gì. Không có dấu phẩy, mệnh đề quan hệ có thể xác định là cái nào: **I have two sisters; the sister who lives in Leeds is a doctor.**"
     ],
     "tutora": ""
    }
   ]
  },
