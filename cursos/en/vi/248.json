 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Dạng vô nhân xưng",
     "texto": [
      "**It is reported that + mệnh đề chia động từ**: **It is reported that the footbridge will close next Monday**. Ở đây **it** không chỉ một vật cụ thể; không nêu ai là người thông báo thông tin."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Chủ ngữ + động từ nguyên thể",
     "texto": [
      "**Chủ ngữ + is/are reported + to + động từ nguyên thể**: **The footbridge is reported to be unsafe**. Cầu đi bộ trở thành chủ đề. Hai dạng có thể diễn đạt cùng một thông báo: **It is reported that the footbridge is unsafe**. Cấu trúc này gán thông tin, không xác nhận thông tin đó."
     ],
     "tutora": ""
    }
   ]
