 "etapas": [
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Thư viện của khu phố",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "The old library was quiet, but only a few people from the community visited it to borrow books. Last year, the town added a small study room and a weekly book club.",
       "alumno": "«The old library was quiet, but only a few people from the community visited it to borrow …» nghĩa là: thư viện cũ rất yên tĩnh, nhưng chỉ có vài thành viên cộng đồng đến đó để mượn sách. Năm ngoái, khu phố đã thêm một phòng học nhỏ và một câu lạc bộ đọc sách hằng tuần.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Now students meet there after school, and older neighbours use the computers to speak with family. Volunteers also repair donated books instead of throwing them away. This helps reduce waste.",
       "alumno": "«Now students meet there after school, and older neighbours use the computers to speak wit…» nghĩa là: giờ đây học sinh tụ họp ở đó sau giờ học, còn hàng xóm lớn tuổi dùng máy tính để trò chuyện với người thân. Các tình nguyện viên cũng sửa sách được tặng thay vì vứt đi. Điều này giúp giảm rác thải.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "The library has not become bigger, but it has become more useful. The manager says the best change was listening to local people before spending money.",
       "alumno": "«The library has not become bigger, but it has become more useful. The manager says the be…» nghĩa là: thư viện không trở nên lớn hơn, nhưng đã trở nên hữu ích hơn. Quản lý nói rằng thay đổi tốt nhất là lắng nghe người dân khu phố trước khi chi tiêu tiền bạc.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Next month, the library will collect ideas for a garden outside. Anyone can leave a note in the suggestion box.",
       "alumno": "«Next month, the library will collect ideas for a garden outside. Anyone can leave a note …» nghĩa là: tháng tới, thư viện sẽ thu thập ý tưởng cho một khu vườn bên ngoài. Bất kỳ ai cũng có thể để lại ghi chú trong hộp góp ý.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
