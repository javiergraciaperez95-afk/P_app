       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Tom",
        "lengua": "estudio"
       },
       "estudio": "This is the house whose owner is my mother.",
       "alumno": "«This is the house whose owner is my mother.» nghĩa là: đây là ngôi nhà có chủ nhân là mẹ mình.",
