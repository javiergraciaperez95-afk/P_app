     "tipo": "texto",
     "titulo": "Một bất ngờ sinh nhật",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Mia thought her friends had forgotten her birthday.",
       "alumno": "«Mia thought her friends had forgotten her birthday.» nghĩa là: Mia nghĩ rằng bạn bè đã quên sinh nhật của cô.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "had forgotten",
         "«had forgotten»: đã quên"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "When she reached home, the lights were off.",
       "alumno": "«When she reached home, the lights were off.» nghĩa là: khi cô về đến nhà, đèn đã tắt.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "reached home",
         "«reached home»: về đến nhà"
        ],
        [
         "were off",
         "«were off»: đã tắt"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Her friends had hidden in the living room before she arrived.",
       "alumno": "«Her friends had hidden in the living room before she arrived.» nghĩa là: bạn bè của cô đã trốn trong phòng khách trước khi cô đến.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "had hidden",
         "«had hidden»: đã trốn"
        ],
        [
         "before she arrived",
         "«before she arrived»: trước khi cô đến"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "They had decorated the room and put a cake on the table.",
       "alumno": "«They had decorated the room and put a cake on the table.» nghĩa là: họ đã trang trí căn phòng và đặt một chiếc bánh lên bàn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "had decorated",
         "«had decorated»: đã trang trí"
        ],
        [
         "put a cake on the table",
         "«put a cake on the table»: đặt một chiếc bánh lên bàn"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "When Mia opened the door, everyone shouted, “Surprise!”",
       "alumno": "«When Mia opened the door, everyone shouted, “Surprise!”» nghĩa là: khi Mia mở cửa, mọi người hét lên: «Bất ngờ!».",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "opened the door",
         "«opened the door»: mở cửa"
        ],
        [
         "shouted",
         "«shouted»: đã hét lên"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "They had planned the party weeks earlier.",
       "alumno": "«They had planned the party weeks earlier.» nghĩa là: họ đã lên kế hoạch cho bữa tiệc từ vài tuần trước.",
       "literal": "",
