 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Saludar",
    "@en": "Say hello"
   },
   "texto": [
    {
     "@es": "**Hello** es un saludo neutral. **Hi** suele ser más informal y se usa mucho entre amigos.",
     "@en": "**Hello** is a neutral greeting. **Hi** is usually more informal and is used much among friends."
    },
    {
     "@es": "Según la hora: **Good morning** (por la mañana), **Good afternoon** (por la tarde) y **Good evening** al saludar por la tarde-noche.",
     "@en": "According to the time: **Good morning** (morning), **Good afternoon** (afternoon) and **Good evening** at night."
    },
    {
     "@es": "Para despedirte: **Goodbye** o, más corto, **Bye**.",
     "@en": "To say goodbye: **Goodbye** or, shorter, **Bye**."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Decir tu nombre",
    "@en": "Say your name"
   },
   "texto": [
    {
     "@es": "Hay dos formas: **I'm Anna** (soy Anna) y **My name is Anna** (mi nombre es Anna).",
     "@en": "There are two forms: **I'm Anna** (I am Anna) and **My name is Anna** (my name is Anna)."
    },
    {
     "@es": "**I'm** es la forma corta de **I am**. Al hablar casi siempre se usa la corta.",
     "@en": "**I'm** is the short form of **I am**. When you talk, you almost always use the cut."
    },
    {
     "@es": "Para preguntar: **What's your name?** (¿cómo te llamas?). **What's** es **what is**.",
     "@en": "To ask: **What's your name?** (what's your name?). **What's** is **what is**."
    }
   ]
  },
