 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Negar acciones en presente",
    "@en": "Denying actions in the present"
   },
   "texto": [
    {
     "@es": "Usa **don't** (= **do not**) con **I/you/we/they** y **doesn't** (= **does not**) con **he/she/it**. Después de **doesn't**, el verbo principal va en forma base: **She works** → **She doesn't work** (sin *-s*).",
     "@en": "Use **don't** (= **do not**) with **I/you/we/they** and **doesn't** (= **does not**) with **he/she/it**. After **doesn't**, the main verb goes in base form: **She works** → **She doesn't work** (without * -s *)."
    },
    "**They don't drive to work.**"
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": {
    "@es": "Palabras clave",
    "@en": "Key words"
   },
   "palabras": [
    "drive",
    "early",
    "weekdays"
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "Completa la frase: She ___ work on weekdays.",
    "@en": "Complete the phrase: She _ _ _ work on weekdays."
   },
   "id": "en012-1",
   "opciones": [
    {
     "texto": "doesn't",
     "explicacion": {
      "@es": "Con «she» se usa «doesn't».",
      "@en": "«she» is used with «doesn't»."
     },
     "correcta": true
    },
    {
     "texto": "don't",
     "explicacion": {
      "@es": "«Don't» va con I, you, we y they.",
      "@en": "«Don't» goes with I, you, we and they."
     }
    },
    {
     "texto": "isn't",
     "explicacion": {
      "@es": "«Isn't» niega «be», no esta acción.",
      "@en": "«Isn't» denies «be», not this action."
     }
    }
   ]
  },
  {
   "tipo": "huecos",
   "pregunta": {
    "@es": "Completa la frase.",
    "@en": "Complete the sentence."
   },
   "frase": "They ___ drive to work.",
   "id": "en012-2",
   "opciones": [
    {
     "texto": "don't",
     "explicacion": {
      "@es": "Con «they» se usa «don't».",
      "@en": "«they» is used with «don't»."
     },
     "correcta": true
    },
    {
     "texto": "doesn't",
     "explicacion": {
      "@es": "«Doesn't» va con he, she e it.",
      "@en": "«Doesn't» goes with him, she and it."
     }
    },
    {
     "texto": "aren't",
     "explicacion": {
      "@es": "«Aren't» niega «be», no esta acción.",
      "@en": "«Aren't» denies «be», not this action."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué frase es correcta?",
    "@en": "What sentence is correct?"
   },
   "id": "en012-3",
   "opciones": [
    {
     "texto": "He doesn't drive early.",
     "explicacion": {
      "@es": "Después de «doesn't», «drive» va sin «-s».",
      "@en": "After «doesn't», «drive» goes without «-s»."
     },
     "correcta": true
    },
    {
     "texto": "He don't drive early.",
     "explicacion": {
      "@es": "Con «he» se usa «doesn't».",
      "@en": "«he» is used with «doesn't»."
     }
    },
    {
     "texto": "He doesn't drives early.",
     "explicacion": {
      "@es": "No se añade «-s» al verbo principal.",
      "@en": "«-s» is not added to the main verb."
     }
    }
   ]
  },
  {
   "tipo": "traduccion",
   "pregunta": {
    "@es": "¿Qué significa?",
    "@en": "What does that mean?"
   },
   "frase": "I don't drive early.",
   "id": "en012-4",
   "opciones": [
    {
     "texto": "No conduzco temprano.",
     "explicacion": {
      "@es": "«I» lleva «don't» y «early» significa «temprano».",
      "@en": "«I» carries «don't» and «early» means «early»."
     },
     "correcta": true
    },
    {
     "texto": "No conduzco los días laborables.",
     "explicacion": {
      "@es": "Eso sería «I don't drive on weekdays».",
      "@en": "That would be «I don't drive on weekdays»."
     }
    },
    {
     "texto": "Él no conduce temprano.",
     "explicacion": {
      "@es": "«I» significa «yo».",
      "@en": "«I» means «I»."
     }
    }
   ]
  },
  {
   "tipo": "ordenar",
   "pregunta": {
    "@es": "Ordena las palabras.",
    "@en": "Order the words."
   },
   "frase": "They don't work on weekdays.",
   "traduccion": {
    "@es": "Ellos no trabajan los días laborables.",
    "@en": "They don't work working days."
   },
   "explicacion": {
    "@es": "«They» lleva «don't».",
    "@en": "«They» is carrying «don't»."
   },
   "id": "en012-5"
  },
  {
   "tipo": "escribir",
   "pregunta": {
    "@es": "Escribe en inglés: «Ella no trabaja los días laborables.»",
    "@en": "Write in English: «She doesn't work working days.»"
   },
   "respuestas": [
    "She doesn't work on weekdays."
   ],
   "explicacion": {
    "@es": "Con «doesn't», el verbo principal va sin «-s».",
    "@en": "With «doesn't», the main verb goes without «-s»."
   },
   "id": "en012-6"
  }
 ],
 "intro": {
  "@es": "Practica la negación en presente con sujetos singulares y plurales.",
  "@en": "Practice denial in present with singular and plural subjects."
 }
}