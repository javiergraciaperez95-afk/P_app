   "id": "en075-1",
   "opciones": [
    {
     "texto": "I'd like a cup of tea, please.",
     "explicacion": {
      "@es": "«I'd like» es una fórmula cortés.",
      "@en": "«I'd like» is a polite formula."
     },
     "correcta": true
    },
    {
     "texto": "Give me tea.",
     "explicacion": {
      "@es": "Suena a orden.",
      "@en": "Sounds like order."
     }
    },
    {
     "texto": "I am like tea.",
     "explicacion": {
      "@es": "«Like» no va con «am».",
      "@en": "«Like» does not go with «am»."
     }
    }
