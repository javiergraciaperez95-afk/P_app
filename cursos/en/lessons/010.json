 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Las profesiones",
    "@en": "The professions"
   },
   "texto": [
    {
     "@es": "Para preguntar a qué se dedica alguien: **What do you do?** (literalmente «¿qué haces?»).",
     "@en": "To ask what one does: **What do you do?** (literally «What are you doing?»)."
    },
    {
     "@es": "Se responde con **a** o **an** delante: **I'm a doctor**, **I'm an engineer**. En español decimos «soy médico»; en inglés el artículo es **obligatorio**.",
     "@en": "It is answered with **a** or **an** front: **I'm a doctor**, **I'm an engineer**. In Spanish we say «I'm a doctor.»; in English the article is **obligatorio**."
    },
    {
     "@es": "**A** va delante de sonido de consonante (a teacher). **An** va delante de sonido de vocal (an engineer, an actor).",
     "@en": "**A** goes in front of consonant sound (a teacher). **An** goes in front of vocal sound (an engineer, an actor)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Nosotros y ellos",
    "@en": "We and them."
   },
   "texto": [
    {
     "@es": "**We** es «nosotros» y **they** es «ellos, ellas». Los dos llevan **are**: **We are students**, **They are doctors**.",
     "@en": "**We** is «We» and **they** is «They, they». The two are **are**: **We are students**, **They are doctors**."
    },
    {
     "@es": "Formas cortas: **we're** y **they're**.",
     "@en": "Short forms: **we're** and **they're**."
    },
    {
     "@es": "En plural no hay artículo: **He's a doctor**, pero **They're doctors**.",
     "@en": "In plural there is no article: **He's a doctor**, but **They're doctors**."
    }
   ]
  },
