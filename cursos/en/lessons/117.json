{
 "capitulo": 15,
 "titulo_en": "I think it will rain",
 "titulo_es": {
  "@es": "Will: predicciones y opiniones",
  "@en": "Will: predictions and opinions"
 },
 "palabras": {
  "will": {
   "es": "(futuro)",
   "pron": "uil",
   "consejo": {
    "@es": "Se usa con verbo base. No cambia con la persona.",
    "@en": "It's used with base verb. It doesn't change with the person."
   }
  },
  "won't": {
   "es": "no (futuro)",
   "pron": "uont",
   "consejo": {
    "@es": "Forma corta de «will not».",
    "@en": "Short form of «will not»."
   }
  },
  "probably": {
   "es": "probablemente",
   "pron": "PRÓ-ba-bli"
  },
  "maybe": {
   "es": "quizá; tal vez",
   "pron": "MÉI-bi"
  },
  "sure": {
   "es": "seguro; segura",
   "pron": "shur"
  },
  "believe": {
   "es": "creer",
   "pron": "bi-LÍV"
  },
  "soon": {
   "es": "pronto; dentro de poco",
   "pron": "sun"
  },
  "later": {
   "es": "más tarde",
   "pron": "LÉI-ter"
  },
  "next": {
   "es": "próximo; siguiente",
   "pron": "nekst"
  },
