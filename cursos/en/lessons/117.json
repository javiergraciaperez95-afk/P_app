       }
      ]
     ]
    },
    {
     "quien": "Tom",
     "en": "OK. Let's meet later in the week.",
     "es": "Vale. Quedemos más adelante esta semana.",
     "analisis": [
      [
       "later in the week",
       {
        "@es": "más adelante esta semana",
