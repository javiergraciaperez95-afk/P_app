     "en": "Probably. But maybe it will be sunny.",
     "es": "Probablemente. Pero quizá haga sol.",
     "analisis": [
      [
       "Probably",
       {
        "@es": "Probablemente",
        "@en": "Probably."
       }
      ],
      [
       "maybe",
