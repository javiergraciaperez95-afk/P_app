       }
      ]
     ]
    },
    {
     "quien": "Anna",
     "en": "I will call you soon.",
     "es": "Te llamaré pronto.",
     "analisis": [
      [
       "I will call",
       {
        "@es": "Te llamaré",
        "@en": "I'll call you."
       }
      ],
      [
       "soon",
       {
        "@es": "pronto",
        "@en": "soon"
       }
      ]
     ]
    },
    {
     "quien": "Tom",
     "en": "Great! See you then!",
     "es": "¡Genial! ¡Hasta entonces!"
    }
   ]
  },
