       }
      ]
     ]
    },
    {
     "quien": "Anna",
     "en": "No, I'm not sure. I will check the forecast, I promise.",
     "es": "No, no estoy segura. Consultaré el pronóstico, lo prometo.",
     "analisis": [
      [
       "I'm not sure",
       {
