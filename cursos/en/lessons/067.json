   "texto": [
    {
     "@es": "**Yesterday** = ayer. **Last night** = anoche. **Last week** = la semana pasada. **Last year** = el año pasado.",
     "@en": "**Yesterday** = yesterday. **Last night** = last night. **Last week** = last week. **Last year** = last year."
    },
    {
     "@es": "**Ago** va detrás del tiempo: **two days ago** (hace dos días).",
     "@en": "**Ago** goes after time: **two days ago** (two days ago)."
    }
