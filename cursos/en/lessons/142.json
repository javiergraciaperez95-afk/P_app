  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué significa **You needn't come**?",
    "@en": "What does **You needn't come** mean?"
   },
   "id": "en142-1",
   "opciones": [
    {
     "texto": "No hace falta que vengas.",
     "explicacion": {
      "@es": "**Needn't + verbo base** expresa falta de obligación.",
      "@en": "**Needn't + verbo base** expresses a lack of obligation."
     },
     "correcta": true
    },
    {
     "texto": "No debes venir.",
     "explicacion": {
      "@es": "Eso sería **mustn't**: está prohibido.",
      "@en": "That would be **mustn't**: it's forbidden."
     }
    },
    {
     "texto": "No puedes venir.",
     "explicacion": {
      "@es": "Eso sería **can't**: no puedes.",
      "@en": "That would be **can't**: you can't."
     }
    }
   ]
  },
