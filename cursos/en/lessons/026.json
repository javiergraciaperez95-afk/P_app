 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Hay",
    "@en": "There's"
   },
   "texto": [
    {
     "@es": "Para decir «hay» en inglés hay dos formas: **there is** (singular) y **there are** (plural). **There is** se acorta a **there's**.",
     "@en": "To say «There's» in English there are two forms: **there is** (singular) and **there are** (plural). **There is** is shortened to **there's**."
    },
    {
     "@es": "**There's a garden** (hay un jardín). **There are four rooms** (hay cuatro habitaciones).",
     "@en": "**There's a garden** (there is a garden). **There are four rooms** (there are four rooms)."
    },
    {
     "@es": "Negación: **there isn't**, **there aren't**. Pregunta: **Is there…?**, **Are there…?**",
     "@en": "Denial: **there isn't**, **there aren't**. Question: **Is there…?**, **Are there…?**"
    }
   ]
  },
  {
   "tipo": "tabla",
   "titulo": "There is / there are",
   "filas": [
    [
     "Afirmación",
     "There's a table.",
     "There are two chairs."
    ],
    [
     "Negación",
     "There isn't a table.",
     "There aren't any chairs."
    ],
    [
     {
      "@es": "Pregunta",
      "@en": "Question"
     },
     "Is there a table?",
     "Are there any chairs?"
    ]
