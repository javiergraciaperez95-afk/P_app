 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "¿Qué tal?",
    "@en": "How are you?"
   },
   "texto": [
    {
     "@es": "**How are you?** es «¿cómo estás?». La respuesta normal es **I'm fine, thanks** o **Fine, thank you**.",
     "@en": "**How are you?** is «How are you?». The normal response is **I'm fine, thanks** or **Fine, thank you**."
    },
    {
     "@es": "Otras respuestas: **Very well** (muy bien), **Not bad** (no estoy mal), **I'm tired** (estoy cansado).",
     "@en": "Other answers: **Very well** (very good), **Not bad** (not bad), **I'm tired** (I'm tired)."
    },
    {
     "@es": "Para devolver la pregunta: **And you?**",
     "@en": "To return the question: **And you?**"
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "He y she",
    "@en": "He and she"
   },
   "texto": [
    {
     "@es": "**He** es «él» y **she** es «ella». Con los dos el verbo es **is**: **He is Tom**, **She is Anna**.",
     "@en": "**He** is «He» and **she** is «her.». With both the verb is **is**: **He is Tom**, **She is Anna**."
    },
    {
     "@es": "Formas cortas: **he's** y **she's**.",
     "@en": "Short forms: **he's** and **she's**."
    },
    {
     "@es": "Para presentar a alguien: **This is Tom** (este es Tom).",
     "@en": "To introduce someone: **This is Tom** (this is Tom)."
    }
   ]
  },
