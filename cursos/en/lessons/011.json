   "tipo": "explicacion",
   "titulo": {
    "@es": "Hablar idiomas",
    "@en": "Speak languages"
   },
   "texto": [
    {
     "@es": "**Do you speak English?** es «¿hablas inglés?». Las respuestas cortas son **Yes, I do** y **No, I don't**.",
     "@en": "**Do you speak English?** is «You speak English?». The short answers are **Yes, I do** and **No, I don't**."
    },
    {
     "@es": "**I speak Spanish** (hablo español), **I don't speak French** (no hablo francés). **Don't** es la forma corta de **do not**.",
     "@en": "**I speak Spanish** (I speak Spanish), **I don't speak French** (I do not speak French). **Don't** is the short form of **do not**."
    },
    {
     "@es": "**A little** es «un poco»: **I speak a little English**.",
     "@en": "**A little** is «A little.»: **I speak a little English**."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Frases para cuando no entiendes",
    "@en": "Phrases for when you don't understand"
   },
   "texto": [
    {
     "@es": "**Can you speak slowly, please?** (¿puede hablar despacio, por favor?).",
     "@en": "**Can you speak slowly, please?** (can you speak slowly, please?)."
    },
    {
     "@es": "**How do you say «gracias» in English?** (¿cómo se dice «gracias» en inglés?).",
     "@en": "**How do you say «gracias» in English?** (how is «Thank you.» said in English?)."
    },
    {
     "@es": "**What does «tired» mean?** (¿qué significa «tired»?).",
     "@en": "**What does «tired» mean?** (what does «tired» mean?)."
    },
    {
     "@es": "Apréndelas de memoria: te sacarán de muchos apuros.",
     "@en": "Learn them by memory: they will take you out of a lot of trouble."
    }
   ]
  },
