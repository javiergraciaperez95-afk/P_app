  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué significa «Because it's late, I'm tired»?",
    "@en": "What does «Because it's late, I'm tired» mean?"
   },
   "id": "en131-1",
   "opciones": [
    {
     "texto": "Estoy cansada porque es tarde.",
     "explicacion": {
      "@es": "Because = porque: presenta la causa.",
      "@en": "Because = because: presents the cause."
     },
     "correcta": true
    },
    {
     "texto": "Estoy cansada, pero es tarde.",
     "explicacion": {
      "@es": "Eso sería «but».",
      "@en": "That would be «but»."
     }
    },
    {
     "texto": "Estoy cansada, así que es tarde.",
     "explicacion": {
      "@es": "Eso expresaría otro resultado; no es el sentido de la frase.",
      "@en": "That would express another result; it is not the meaning of the phrase."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué conector va en «It rained, ___ we stayed home»?",
    "@en": "What connector is going on «It rained, ___ we stayed home»?"
   },
   "id": "en131-2",
   "opciones": [
    {
     "texto": "so",
     "explicacion": {
      "@es": "So = así que: presenta el resultado.",
      "@en": "So = so: presents the result."
     },
     "correcta": true
    },
    {
     "texto": "but",
     "explicacion": {
      "@es": "But = pero: expresa contraste.",
      "@en": "But: it expresses contrast."
     }
    },
    {
     "texto": "because",
     "explicacion": {
      "@es": "Because presenta la causa, no el resultado en esta frase.",
      "@en": "Because it presents the cause, not the result in this sentence."
     }
    }
   ]
  },
