    {
     "texto": "goed",
     "explicacion": {
      "@es": "Es un error.",
      "@en": "It's a mistake."
     }
    },
    {
     "texto": "gone",
     "explicacion": {
      "@es": "Es el participio de «go»; con «last year» se necesita el pasado simple «went».",
      "@en": "It is the participle of «go»; with «last year» the simple past «went» is needed."
     }
    }
