  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Cómo dices «odio el pescado»?",
    "@en": "What do you mean, «I hate fish.»?"
   },
   "id": "en038-1",
   "opciones": [
    {
     "texto": "I hate fish.",
     "explicacion": {
      "@es": "«Hate» significa odiar.",
      "@en": "«Hate» means hate."
     },
     "correcta": true
    },
    {
     "texto": "Fish hates me.",
     "explicacion": {
      "@es": "Eso cambiaría el sujeto y el sentido.",
      "@en": "That would change the subject and the meaning."
     }
    },
    {
     "texto": "I don't fish.",
     "explicacion": {
      "@es": "Significa que no pescas o que no comes pescado según el contexto.",
      "@en": "It means you don't fish or you don't eat fish according to the context."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Cómo preguntas «¿te gusta el pollo?»?",
    "@en": "How do you ask «You like chicken?»?"
   },
   "id": "en038-2",
   "opciones": [
    {
     "texto": "Do you like chicken?",
     "explicacion": {
      "@es": "Do + sujeto + verbo en forma base.",
      "@en": "Do + subject + verb in base form."
     },
     "correcta": true
    },
    {
     "texto": "Like you chicken?",
     "explicacion": {
      "@es": "Falta el auxiliar «do».",
      "@en": "The «do» assistant is missing."
     }
    },
    {
     "texto": "Are you like chicken?",
     "explicacion": {
      "@es": "No usamos «are» con «like» así.",
      "@en": "We don't use «are» with «like» like this."
     }
    }
   ]
  },
  {
