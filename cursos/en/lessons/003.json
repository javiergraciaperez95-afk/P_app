  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Fórmulas de cortesía",
    "@en": "Formules of courtesy"
   },
   "texto": [
    {
     "@es": "**Please** (por favor) puede ir al principio o al final: **Please repeat that** y **Can you repeat that, please?**",
     "@en": "**Please** (please) can go to the beginning or end: **Please repeat that** and **Can you repeat that, please?**"
    },
    {
     "@es": "**Sorry** sirve para disculparte. **Excuse me** sirve para llamar la atención de alguien.",
     "@en": "**Sorry** serves to apologize. **Excuse me** is used to draw someone's attention."
    },
    {
     "@es": "Si no entiendes: **I don't understand** (no entiendo).",
     "@en": "If you don't understand: **I don't understand** (I don't understand)."
    }
   ]
  },
