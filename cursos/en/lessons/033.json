   "tipo": "explicacion",
   "titulo": {
    "@es": "La hora",
    "@en": "The time"
   },
   "texto": [
    {
     "@es": "**What time is it?** — **It's nine o'clock** (son las nueve en punto).",
     "@en": "**What time is it?**-**It's nine o'clock** (nine o'clock)."
    },
    {
     "@es": "**Half past** = y media: **half past eight** (las ocho y media).",
     "@en": "**Half past** = half: **half past eight** (8: 30)."
    },
    {
     "@es": "**Quarter past** = y cuarto. **Quarter to** = menos cuarto: **quarter to ten** (las diez menos cuarto).",
     "@en": "**Quarter past** = and fourth. **Quarter to** = minus fourth: **quarter to ten** (the ten minus fourth)."
    },
    {
     "@es": "Para decir a qué hora haces algo: **at**. **I get up at seven.**",
     "@en": "To tell you what time you do something: **at**. **I get up at seven.**"
    }
   ]
  },
