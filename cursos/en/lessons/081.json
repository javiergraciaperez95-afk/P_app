 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Hace: «ago»",
    "@en": "Does: «ago»"
   },
   "texto": [
    {
     "@es": "**Ago** significa «hace» y va **detrás** del tiempo: **two weeks ago** = hace dos semanas. En español «hace» va delante; en inglés, detrás.",
     "@en": "**Ago** means «does» and goes **detrás** of the time: **two weeks ago** = two weeks ago. In Spanish «does» goes ahead; in English, behind."
    },
    {
     "@es": "Se usa con el pasado simple: **I lived in Paris two years ago**.",
     "@en": "It is used with the simple past: **I lived in Paris two years ago**."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Ordenar la historia",
    "@en": "Sort the story"
   },
   "texto": [
    {
     "@es": "**First** (primero), **then** (luego), **after that** (después de eso), **finally** (por fin). Sirven para contar algo en orden.",
     "@en": "**First** (first), **then** (then), **after that** (after that), **finally** (at last). They can tell you something in order."
    },
    {
     "@es": "**While** (mientras) une dos acciones que pasan a la vez: **I studied French while I lived in Paris** (estudié francés mientras vivía en París).",
     "@en": "**While** (while) joins two actions that happen at once: **I studied French while I lived in Paris** (I studied French while living in Paris)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Falso amigo",
    "@en": "False friend"
   },
   "texto": [
    {
     "@es": "**Actually** NO es «actualmente»: significa **en realidad**. Para «actualmente» se dice **currently**.",
     "@en": "**Actually** is NOT «currently»: it means **en realidad**. For «currently» it is said **currently**."
    }
   ]
  },
