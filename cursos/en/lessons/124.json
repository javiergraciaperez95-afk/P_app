   ]
  },
  {
   "tipo": "ordenar",
   "pregunta": {
    "@es": "Ordena las palabras.",
    "@en": "Order the words."
   },
   "frase": "We must warn them",
   "traduccion": {
    "@es": "Debemos advertirles",
    "@en": "We must warn them."
   },
   "explicacion": {
    "@es": "Warn = advertir o avisar.",
    "@en": "Warn = warning or warning."
   },
   "id": "en124-7"
  },
  {
   "tipo": "escribir",
   "pregunta": {
    "@es": "¿Cómo se dice «advertir» en inglés (avisar de un peligro)?",
    "@en": "How do you say «warning» in English (warning of a danger)?"
   },
   "respuestas": [
    "warn"
   ],
   "explicacion": {
    "@es": "Distingue **warn** (advertir) de **advise** (aconsejar).",
    "@en": "**warn** (warn) distinct from **advise** (advise)."
   },
   "id": "en124-8"
  }
 ],
 "intro": {
  "@es": "Aprende a expresar obligaciones y prohibiciones con **must** y **mustn't**. Distingue **mustn't** (prohibición) de **don't have to** (no hace falta), que aparece en la siguiente lección.",
  "@en": "Learn to express obligations and prohibitions with **must** and **mustn't**. **mustn't** (prohibition) of **don't have to** (no need), which appears in the next lesson."
 }
}