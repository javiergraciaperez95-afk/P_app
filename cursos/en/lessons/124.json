      "@en": "Prohibition."
     },
     "correcta": true
    },
    {
     "texto": "must",
     "explicacion": {
      "@es": "Eso es obligación, no prohibición.",
      "@en": "That's obligation, not prohibition."
     }
    },
    {
     "texto": "don't",
     "explicacion": {
      "@es": "En presente simple, significa que no fumas; no expresa esta prohibición.",
      "@en": "In the present simple, it means that you do not smoke; it does not express this prohibition."
     }
    }
   ]
  },
  {
   "tipo": "huecos",
   "pregunta": {
    "@es": "Casco",
    "@en": "Helmet"
   },
   "frase": "You must wear a ___ on the bike.",
   "id": "en124-5",
