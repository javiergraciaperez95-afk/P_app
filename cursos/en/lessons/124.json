      "@en": "It's the belt."
     }
    },
    {
     "texto": "rule",
     "explicacion": {
      "@es": "Es la regla.",
      "@en": "It's the rule."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "Escucha. ¿Qué significa?",
    "@en": "Listen. What does that mean?"
   },
   "audio": "It is not allowed.",
   "id": "en124-6",
   "opciones": [
    {
     "texto": "No está permitido.",
     "explicacion": {
