  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Cómo dices «hay dos sillas»?",
    "@en": "What do you mean, «There are two chairs.»?"
   },
   "id": "en074-4",
   "opciones": [
    {
     "texto": "There are two chairs.",
     "explicacion": {
      "@es": "Con un plural usamos «there are».",
      "@en": "With a plural we use «there are»."
     },
     "correcta": true
    },
    {
     "texto": "There is two chairs.",
     "explicacion": {
      "@es": "«There is» acompaña un singular.",
      "@en": "«There is» accompanies a singular."
     }
    },
    {
     "texto": "They are two chairs.",
     "explicacion": {
      "@es": "«They are» significa «son».",
      "@en": "«They are» means «son»."
     }
    }
   ]
  },
