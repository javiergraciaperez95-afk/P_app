       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Нет, я занят до семи. Давай встретимся позже.",
       "alumno": "No, estoy ocupado hasta las siete. Quedemos más tarde.",
       "literal": "",
       "estructura": "",
       "nota": [],
