       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Иван",
        "lengua": "estudio"
       },
       "estudio": "Население растёт, и это влияет на жизнь.",
       "alumno": "La población crece, y eso influye en la vida.",
       "literal": "",
       "estructura": "",
       "nota": [],
