        "texto": "Анна",
        "lengua": "estudio"
       },
       "estudio": "Все имеют право на образование и работу.",
       "alumno": "Todos tienen derecho a la educación y al trabajo.",
       "literal": "",
       "estructura": "",
       "nota": [],
