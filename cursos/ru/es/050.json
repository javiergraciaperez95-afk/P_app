    {
     "tipo": "dialogo",
     "titulo": "Dónde está",
     "frases": [
      {
       "quien": {
        "texto": "Анна",
        "lengua": "estudio"
       },
       "estudio": "Где ключи?",
       "alumno": "¿Dónde están las llaves?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Иван",
        "lengua": "estudio"
       },
       "estudio": "Над столом висит лампа, а ключи под книгой.",
       "alumno": "Encima de la mesa cuelga la lámpara, y las llaves están debajo del libro.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "над столом",
         "encima de la mesa"
        ],
        [
         "под книгой",
         "debajo del libro"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Анна",
        "lengua": "estudio"
       },
       "estudio": "А машина?",
       "alumno": "¿Y el coche?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Иван",
        "lengua": "estudio"
       },
       "estudio": "Перед домом, между деревьями.",
       "alumno": "Delante de la casa, entre los árboles.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "перед домом",
         "delante de la casa"
        ],
        [
         "между деревьями",
         "entre los árboles"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Анна",
        "lengua": "estudio"
       },
       "estudio": "Понятно. А сумка тоже там?",
       "alumno": "Entiendo. ¿Y el bolso también está ahí?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Иван",
        "lengua": "estudio"
       },
       "estudio": "Нет, сумка за дверью.",
       "alumno": "No, el bolso está detrás de la puerta.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "за дверью",
         "detrás de la puerta"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
   ]
