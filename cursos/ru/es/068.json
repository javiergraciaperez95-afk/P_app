     "opciones": [
      {
       "texto": "Я ходил в кино.",
       "lengua": "estudio",
       "explicacion": "Ходил es el pasado masculino de ходить; en este contexto expresa una visita al cine, sin indicar necesariamente cómo llegó.",
       "correcta": true
