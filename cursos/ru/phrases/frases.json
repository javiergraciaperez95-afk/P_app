{
 "categorias": [
  {
   "titulo": {
    "@es": "Lo básico",
    "@en": "The basic"
   },
   "descripcion": {
    "@es": "Saludos y frases de las primeras lecciones.",
    "@en": "Greetings and phrases from the first lessons."
   },
   "grupos": [
    {
     "titulo": {
      "@es": "Saludar",
      "@en": "Say hello"
     },
     "tarea": {
      "@es": "Saluda y pregunta qué tal.",
      "@en": "Say hello and ask what's up."
     },
     "leccion": "001",
     "frases": [
      {
       "ru": "Привет!",
       "es": "¡Hola!",
       "en": "Hey!",
       "pron": "pri-VYET",
       "analisis": [
        [
         "Привет",
         {
          "@es": "interjección (saludo)",
          "@en": "Interjection (greeting)"
         }
        ]
       ]
      },
      {
       "ru": "Как дела?",
       "es": "¿Qué tal?",
       "en": "How are you?",
       "pron": "kak dye-LA",
       "analisis": [
        [
         "Как",
         {
          "@es": "adverbio (cómo)",
          "@en": "Adverse (how)"
         }
        ],
        [
         "дела",
         {
          "@es": "sustantivo (asuntos)",
          "@en": "(matters)"
         }
        ]
       ]
      },
      {
       "ru": "Хорошо, спасибо!",
       "es": "Bien, ¡gracias!",
       "en": "Well, thank you!",
       "pron": "ja-ra-SHO spa-SI-ba",
       "analisis": [
        [
         "Хорошо",
         {
          "@es": "adverbio (bien)",
          "@en": "Adverse (well)"
         }
        ],
        [
         "спасибо",
         {
          "@es": "expresión (gracias)",
          "@en": "expression (thank you)"
         }
        ]
       ]
      },
      {
       "ru": "Пока!",
       "es": "¡Hasta luego!",
       "en": "See you later!",
       "pron": "pa-KA",
       "analisis": [
        [
         "Пока",
         {
          "@es": "interjección (hasta luego)",
          "@en": "Interjection (see below)"
         }
        ]
       ]
      }
     ]
    },
    {
     "titulo": {
      "@es": "Presentarse",
      "@en": "To be presented"
     },
     "tarea": {
      "@es": "Di tu nombre.",
      "@en": "Say your name."
     },
     "leccion": "002",
     "frases": [
      {
       "ru": "Меня зовут Анна.",
       "es": "Me llamo Anna.",
       "en": "My name is Anna.",
       "pron": "mi-NYA za-VUT A-na",
       "analisis": [
        [
         "Меня",
         {
          "@es": "pronombre (a mí)",
          "@en": "pronoun (to me)"
         }
        ],
        [
         "зовут",
         {
          "@es": "verbo (llaman)",
          "@en": "verb (call)"
         }
        ],
        [
         "Анна",
         {
          "@es": "nombre propio",
          "@en": "own name"
         }
        ]
       ]
      },
      {
       "ru": "Ты говоришь по-русски?",
       "es": "¿Hablas ruso?",
       "en": "You speak Russian?",
       "pron": "ti ga-va-RISH pa-RUS-ki",
       "analisis": [
        [
         "Ты",
         {
          "@es": "sujeto (tú)",
          "@en": "subject (you)"
         }
        ],
        [
         "говоришь",
         {
          "@es": "verbo (hablas)",
          "@en": "verb (speak)"
         }
        ],
        [
         "по-русски",
         {
          "@es": "adverbio (en ruso)",
          "@en": "adverbian (Russian)"
         }
        ]
       ]
      }
     ]
    },
    {
     "titulo": {
      "@es": "Pedir",
      "@en": "Ask"
     },
     "tarea": {
      "@es": "Pide un café.",
      "@en": "Get a coffee."
     },
     "leccion": "003",
     "frases": [
      {
       "ru": "Кофе, пожалуйста.",
       "es": "Un café, por favor.",
       "en": "A coffee, please.",
       "pron": "KO-fe pa-ZHA-luis-ta",
       "analisis": [
        [
         "Кофе",
         {
          "@es": "lo que se pide",
          "@en": "what is requested"
         }
        ],
        [
         "пожалуйста",
         {
          "@es": "fórmula de cortesía (por favor)",
          "@en": "courtesy formula (please)"
         }
        ]
       ]
      },
      {
       "ru": "Спасибо!",
       "es": "¡Gracias!",
       "en": "Thank you!",
       "pron": "spa-SI-ba",
       "analisis": [
        [
         "Спасибо",
         {
          "@es": "expresión (gracias)",
          "@en": "expression (thank you)"
         }
        ]
       ]
      },
      {
       "ru": "Пожалуйста.",
       "es": "De nada.",
       "en": "You're welcome.",
       "pron": "pa-ZHA-luis-ta",
       "analisis": [
        [
         "Пожалуйста",
         {
          "@es": "expresión (de nada)",
          "@en": "expression (of nothing)"
         }
        ]
       ]
      }
     ]
    }
   ]
  }
 ]
}