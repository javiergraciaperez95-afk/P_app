       {
        "@es": "examinar",
        "@en": "review"
       }
      ]
     ]
    },
    {
     "quien": "Работник",
     "ru": "Что случилось?",
     "es": "¿Qué pasó?",
     "en": "What happened?"
    },
    {
     "quien": "Иван",
     "ru": "Заказ пришёл с ошибкой. Прошу вернуть деньги.",
     "es": "El pedido llegó con un error. Le ruego que devuelva el dinero.",
     "en": "The order came with a mistake. I beg you to return the money.",
     "analisis": [
      [
       "с ошибкой",
       {
        "@es": "con un error",
        "@en": "with a mistake"
       }
      ],
      [
       "Прошу вернуть",
       {
        "@es": "le ruego que devuelva",
        "@en": "I beg you to return."
       }
      ]
     ]
    },
    {
     "quien": "Работник",
     "ru": "Хорошо, мы примем меры.",
     "es": "Muy bien, tomaremos medidas.",
     "en": "All right, we'll take action.",
