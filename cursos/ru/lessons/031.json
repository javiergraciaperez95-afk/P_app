 "titulo_ru": "Объявления и расписание",
 "titulo_es": {
  "@es": "Leer avisos y horarios",
  "@en": "Read notices and schedules"
 },
 "palabras": {
  "объявление": {
   "es": "aviso, anuncio",
   "en": "notice, notice",
   "pron": "ab-yav-LIE-ni-ye"
