   "id": "ru161-1",
   "opciones": [
    {
     "texto": {
      "@es": "es sorprendente",
      "@en": "It's amazing."
     },
     "explicacion": {
      "@es": "Удивительно = es sorprendente.",
      "@en": "Удивительно = is amazing."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "es normal",
      "@en": "is normal"
     },
     "explicacion": {
      "@es": "Normal es «нормально».",
      "@en": "Normal is «нормально»."
     }
    },
    {
     "texto": {
      "@es": "es triste",
      "@en": "It's sad."
     },
     "explicacion": {
      "@es": "Triste es «грустно».",
      "@en": "Sad is «грустно»."
     }
    }
   ]
  },
  {
   "tipo": "traduccion",
   "pregunta": {
    "@es": "¿Qué significa?",
    "@en": "What does that mean?"
   },
   "frase": "Странно, что он молчит.",
   "id": "ru161-2",
   "opciones": [
    {
     "texto": {
      "@es": "Es raro que se calle.",
      "@en": "It's weird that he's quiet."
     },
     "explicacion": {
      "@es": "Странно, что = es raro que.",
      "@en": "Странно, что = is rare that."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Es normal que se calle.",
      "@en": "It's normal for you to shut up."
     },
     "explicacion": {
      "@es": "Eso sería «нормально».",
      "@en": "That would be «нормально»."
     }
    },
    {
     "texto": {
      "@es": "Es evidente que habla.",
      "@en": "It's obvious he's talking."
     },
     "explicacion": {
      "@es": "Eso sería «очевидно» con «говорит».",
      "@en": "That would be «очевидно» with «говорит»."
     }
    }
   ]
  },
