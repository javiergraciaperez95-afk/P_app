   "es": "raro; extrañamente",
   "en": "rare; strangely",
   "pron": "STRAN-na"
  },
  "очевидно": {
   "es": "evidentemente; es evidente",
   "en": "Obviously, it is obvious.",
   "pron": "a-chi-VID-na"
  },
