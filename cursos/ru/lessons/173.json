        "@es": "influye en la vida",
        "@en": "influences life"
       }
      ]
     ]
    },
    {
     "quien": "Анна",
     "ru": "Все имеют право на образование и работу.",
     "es": "Todos tienen derecho a la educación y al trabajo.",
     "en": "Everyone has the right to education and work.",
     "analisis": [
      [
       "имеют право",
       {
        "@es": "tienen derecho",
        "@en": "have a right"
       }
      ]
