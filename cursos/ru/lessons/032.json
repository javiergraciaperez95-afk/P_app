     "es": "¡Hola! ¿Estás libre esta noche?",
     "en": "Hey! Are you free tonight?"
    },
    {
     "ru": "Нет, я занят до семи. Давай встретимся позже.",
     "es": "No, estoy ocupado hasta las siete. Quedemos más tarde.",
     "en": "No, I'm busy till 7: 00. Let's stay later."
    },
    {
     "ru": "Хорошо, в восемь. До встречи!",
     "es": "Vale, a las ocho. ¡Hasta luego!",
     "en": "Okay, 8: 00. See you later!"
    }
   ]
