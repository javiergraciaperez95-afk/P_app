     "correcta": true
    },
    {
     "texto": "Человек, читал газету.",
     "explicacion": {
      "@es": "**читал** es pasado: «leyó».",
      "@en": "**читал** is past: «He read»."
     }
    },
    {
     "texto": "Человек, читает газету.",
     "explicacion": {
      "@es": "**читает** es presente: no es un participio.",
      "@en": "**читает** is present: it is not a participle."
