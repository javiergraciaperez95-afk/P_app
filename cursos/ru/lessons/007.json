   "tipo": "explicacion",
   "titulo": {
    "@es": "Los números",
    "@en": "The numbers"
   },
   "texto": [
    {
     "@es": "Del 11 al 19 se forman con el número + **-надцать** (que suena «-natsat»): один → один**надцать** (11), пять → пят**надцать** (15).",
     "@en": "From 11 to 19 they are formed with the number + **-надцать** (which sounds «-natsat»): один → один**надцать** (11), пять → пят**надцать** (15)."
    },
    {
     "@es": "Veinte es **двадцать**.",
     "@en": "Twenty is **двадцать**."
    }
   ]
  },
