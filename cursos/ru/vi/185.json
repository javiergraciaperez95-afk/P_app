     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "С 12 по 18 июня читальный зал будет закрыт на ремонт.",
       "alumno": "Từ ngày 12 đến ngày 18 tháng Sáu, phòng đọc sẽ đóng cửa để sửa chữa.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Книги можно вернуть через автомат у главного входа.",
       "alumno": "Người ta trả được sách qua máy đặt cạnh lối vào chính.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Заказанные издания будут доступны в филиале на улице Лесной.",
       "alumno": "Những cuốn sách đã đặt trước sẽ sẵn sàng ở chi nhánh trên phố Lesnaya.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Trả lời một đơn",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Уважаемая Анна Сергеевна! Ваше обращение получено 3 июня.",
       "alumno": "Kính gửi bà Anna Serguéyevna: đơn của bà đã được nhận vào ngày 3 tháng Sáu.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Заявление будет рассмотрено в течение десяти рабочих дней.",
       "alumno": "Đơn sẽ được xem xét trong vòng mười ngày làm việc.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Согласно правилам, к заявлению необходимо приложить копию договора.",
       "alumno": "Theo quy định, phải đính kèm một bản sao hợp đồng vào đơn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "О результатах рассмотрения мы сообщим по указанному адресу.",
       "alumno": "Bên tôi sẽ thông báo kết quả đến địa chỉ đã ghi.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Thông tin đưa tin",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Городской совет утвердил новые правила пользования общественными площадками.",
       "alumno": "Hội đồng thành phố đã thông qua quy định mới về việc sử dụng những khu công cộng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Они вступают в силу первого сентября.",
       "alumno": "Quy định sẽ bắt đầu áp dụng vào ngày mồng một tháng Chín.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "По словам представителей совета, изменения должны упростить подачу заявок.",
       "alumno": "Theo đại diện hội đồng, những thay đổi này nên làm cho việc nộp đơn đơn giản hơn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
