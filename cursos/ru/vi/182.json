     "titulo": "Kết quả một cuộc khảo sát",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Опрос прошёл с пятого по двенадцатое мая в трёх районах города.",
       "alumno": "Cuộc khảo sát diễn ra từ ngày năm đến ngày mười hai tháng Năm ở ba quận.",
       "literal": "",
