       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Вечером пылесос опять сломался.",
       "alumno": "Buổi tối máy hút bụi lại hỏng.",
