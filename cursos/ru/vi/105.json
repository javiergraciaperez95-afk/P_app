 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Nguyên nhân với из-за",
     "texto": [
      "**Из-за + sinh dạng** nghĩa là «vì/do»: **из-за пробки**, **из-за дождя**. Thường đi trước một trở ngại hoặc một kết quả không thuận lợi, nhưng sắc thái phụ thuộc vào ngữ cảnh.",
      "**Мы опоздали из-за пробки** (chúng mình đến muộn vì tắc đường)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Nguyên nhân với mệnh đề: так как",
     "texto": [
      "**Так как** và **потому что** dẫn một mệnh đề đầy đủ và diễn tả nguyên nhân. **Так как** có thể đứng đầu câu, như ở đây: **Так как была авария, все стояли** (vì đã có tai nạn nên mọi người đều đứng yên). Không có sự khác biệt cố định về độ trang trọng giữa hai liên từ này.",
      "**Поскольку** cũng diễn tả nguyên nhân («vì», «bởi vì»)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Nguyên nhân thuận lợi thường gặp: благодаря",
     "texto": [
      "**Благодаря + tặng dạng** nghĩa là «nhờ có» và thường giới thiệu một nguyên nhân thuận lợi: **благодаря тебе**, **благодаря друзьям**. Sự đối lập với **из-за** là một xu hướng, không phải quy tắc tuyệt đối."
     ],
     "tutora": ""
    },
