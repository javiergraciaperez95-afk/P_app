       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Да, я свободна. Давай встретимся в три часа.",
       "alumno": "Có, mình rảnh. Hẹn gặp lúc ba giờ nhé.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Хорошо. Где встречаемся?",
       "alumno": "Được. Chúng ta gặp nhau ở đâu?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "У входа в метро. Это удобно?",
       "alumno": "Ở cửa ra vào ga tàu điện ngầm. Vậy được không?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Да. Я буду там немного раньше.",
       "alumno": "Được. Mình sẽ đến đó sớm hơn một chút.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
