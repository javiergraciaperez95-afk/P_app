        "lengua": "alumno"
       },
       "estudio": "В воскресенье у нас много гостей.",
       "alumno": "Chủ nhật nhà mình đón nhiều khách.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Приходят два брата и пять друзей.",
       "alumno": "Hai anh em và năm người bạn sẽ đến.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "У моей сестры трое детей, и все они очень весёлые.",
       "alumno": "Chị gái mình có ba đứa con, và tất cả đều rất vui vẻ.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Мы готовим борщ и несколько салатов.",
       "alumno": "Chúng mình chuẩn bị súp borsch và vài món salad.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "После обеда мы идём в парк и гуляем.",
       "alumno": "Sau bữa trưa chúng mình đi công viên và đi dạo.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Вечером сестра уходит домой, а дети спят.",
       "alumno": "Buổi tối chị gái về nhà, còn bọn trẻ đi ngủ.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
