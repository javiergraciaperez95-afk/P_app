 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "What aspect expresses",
     "texto": [
      "The imperfective presents a process, a repeated activity, or the fact that something was happening, without focusing on an end point. The perfective presents the action as a whole with a final point; in the past it usually stresses that it was completed. They are not tenses: each aspect can appear in the past or the non-past."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Three pairs in context",
     "columnas": [
      {
       "texto": "Pair",
       "lengua": "alumno"
      },
      {
       "texto": "Imperfective: process",
       "lengua": "alumno"
      },
      {
       "texto": "Perfective: completed action",
       "lengua": "alumno"
      }
     ],
     "filas": [
      [
       {
        "texto": "читать / прочитать",
        "lengua": "estudio"
       },
       {
        "texto": "Я читал книгу. — I was reading the book; it is not stated whether I finished it.",
        "lengua": "alumno"
       },
       {
        "texto": "Я прочитал книгу. — I finished reading the book.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "писать / написать",
        "lengua": "estudio"
       },
       {
        "texto": "Я писал письмо. — I was writing the letter; no ending is indicated.",
        "lengua": "alumno"
       },
       {
        "texto": "Я написал письмо. — I wrote and finished the letter.",
        "lengua": "alumno"
       }
      ],
