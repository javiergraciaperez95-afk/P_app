 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Accusative plural in the reading",
     "texto": [
      "With inanimate plural nouns, the accusative matches the nominative: яблоки, книги, газеты.",
      "With people, the accusative plural matches the genitive plural: друзья → друзей, соседи → соседей, дети → детей.",
      "Помогать takes the dative: помогаем им (\"we help them\"). Любить takes a direct object: любим детей."
     ],
     "tutora": ""
    }
   ]
  },
  {
