        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Книги можно вернуть через автомат у главного входа.",
       "alumno": "Books can be returned at the machine by the main entrance.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
