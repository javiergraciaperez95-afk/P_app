   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Pairs of connectors",
     "texto": [
      "**Чем + comparative ..., тем + comparative ...** = the more..., the more...: it links two changes.",
      "**Не только ..., но и ...** = not only..., but also...; it adds a second quality or element.",
      "**Ни ..., ни ... + не** = neither..., nor...; in this example the verb also takes **не**.",
      "**Либо ..., либо ...** = either..., or...; it presents two alternatives.",
      "**Как ..., так и ...** = both..., and...; it links two subjects, and here the verb is in the plural: **имеют**."
     ],
     "tutora": ""
    }
   ]
  },
