   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Active present: action in progress or habitual",
     "texto": [
      "It is formed on the imperfective present stem: читать → читающий, участвовать → участвующий. It agrees with the noun: читающий студент, читающая студентка.",
      "The participle usually goes before the noun; with complements it can go after it: студент, читающий статью."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Active past: action that happened earlier",
     "texto": [
      "It is formed on the past stem: прочитать → прочитавший; проводить → проводивший. It also agrees: событие, произошедшее вчера.",
      "It summarises a subordinate clause: люди, которые участвуют в проекте → люди, участвующие в проекте. If the sentence becomes heavy, the subordinate clause can be clearer."
     ],
     "tutora": ""
    }
   ]
  },
