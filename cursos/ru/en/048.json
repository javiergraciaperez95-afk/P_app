       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Иван",
        "lengua": "estudio"
       },
       "estudio": "Я работаю учителем. А кем ты хочешь быть?",
       "alumno": "I work as a teacher. And what do you want to be?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "кем ты хочешь быть",
         "what do you want to be?"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Мария",
        "lengua": "estudio"
       },
       "estudio": "Я хочу стать врачом. Это хорошая профессия.",
       "alumno": "I want to be a doctor. It is a good profession.",
       "literal": "",
       "estructura": "",
       "nota": [],
