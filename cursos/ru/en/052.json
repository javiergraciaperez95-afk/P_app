    {
     "tipo": "explicacion",
     "titulo": "States",
     "texto": [
      "The adjective agrees in gender with the person or thing you describe: **весёлый** (masculine), **весёлая** (feminine), **весёлое** (neuter); in the plural: **весёлые**. You can also express emotions with verbs: **Я радуюсь** (I'm glad), **Я злюсь** (I get angry)."
     ],
     "tutora": ""
    }
   ]
