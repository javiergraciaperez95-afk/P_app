 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Mạo từ: o, a, os, as",
     "texto": [
      "Mạo từ là **o**, **a**, **os**, **as**. Nhớ rằng **o** đọc thành «u» và **os** đọc thành «ush».",
      "Số nhiều thông thường thêm **-s**: o filho → os filhos. Các từ kết thúc bằng **-ão** có nhiều dạng số nhiều: **-ãos** (irmão → irmãos), **-ões** (televisão → televisões) và **-ães** (pão → pães). Nên học thuộc các dạng thường gặp của từng từ."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Tính từ sở hữu đi kèm mạo từ",
     "texto": [
      "Ở Bồ Đào Nha người ta nói «cha tôi» với mạo từ: **o meu pai**, **a minha mãe**. Tính từ sở hữu hợp với vật được sở hữu, giống tiếng Tây Ban Nha.",
      "Ở số nhiều: **os meus** pais, **as minhas** irmãs."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Tính từ sở hữu",
