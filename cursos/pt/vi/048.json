    {
     "tipo": "explicacion",
     "titulo": "Các hình thức thanh toán và phần chi tiết hóa đơn",
     "texto": [
      "**O total da compra** = tổng số tiền mua hàng.",
      "**Pagar com cartão** = thanh toán bằng thẻ (ghi nợ hoặc tín dụng).",
      "**Pagar em dinheiro** = thanh toán bằng tiền mặt.",
      "**O cliente recebeu o recibo** = khách hàng đã nhận phiếu thanh toán.",
      "**O valor pago** = số tiền thực tế đã trả."
     ],
     "tutora": ""
    }
   ]
  },
