   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "«Para»: purpose and destination",
     "texto": [
      "**para** shows what something is done for: **Trabalho para pagar a casa** (I work to pay for the house).",
      "It also shows the destination: **Vou para Lisboa** (I'm going to Lisbon)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "«Por»: cause, means and amount of time",
     "texto": [
      "**por** shows the cause: **por causa da chuva** (because of the rain), **por isso** (therefore).",
      "It shows the means or the price: **pelo correio** (by post), **Trabalho por dinheiro** (I work for money).",
      "It shows an approximate length of time: **Vou por uma semana** (I'm going for a week)."
     ],
     "tutora": ""
    },
