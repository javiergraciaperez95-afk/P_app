   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Offers and promotions",
     "texto": [
      "**Estar em promoção** = to be on offer or on promotion: *«O azeite está em promoção até sexta-feira»*.",
      "**Preço antigo** = former or old price.",
      "**Preço novo** = current reduced price.",
      "**Garrafa** = bottle: *«uma garrafa de azeite»*, *«uma garrafa de água»*.",
      "On leaflets, the original price is usually shown crossed out (**riscado**)."
     ],
     "tutora": ""
    }
   ]
  },
