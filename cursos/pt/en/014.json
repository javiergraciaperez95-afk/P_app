     "id": "pt014-2",
     "pregunta": {
      "texto": "What effect does the circumflex accent («^») have on the pronunciation of vowels such as «e» or «o»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "It makes the vowel pronounced in a closed way.",
       "lengua": "alumno",
       "explicacion": "The circumflex marks a closed vowel quality (/e/, /o/).",
       "correcta": true
      },
      {
       "texto": "It forces the following consonant to be doubled.",
       "lengua": "alumno",
       "explicacion": "It does not change the number of spelling consonants.",
       "correcta": false
      },
      {
       "texto": "It turns the vowel into a purely nasal sound.",
       "lengua": "alumno",
       "explicacion": "Nasality is marked with a tilde or with a following nasal consonant.",
       "correcta": false
      }
     ],
     "respuestas": {
