 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Acute and circumflex accents",
     "texto": [
      "The acute accent (**´**) opens the vowel sound: **António** (in Portugal the first «o» is open, written with an acute accent), **café**, **está**.",
      "The circumflex accent (**^**) closes the vowel: **você**, **Inês**, **avô**. In Brazil it is written *Antônio*, but in Portugal the European standard under AO90 keeps **António**.",
      "Respecting the exact spelling is compulsory on personal registration forms and contracts."
     ],
     "tutora": ""
    }
   ]
  },
