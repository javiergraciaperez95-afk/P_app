   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "«Continuar a», «deixar de», «voltar a»",
     "texto": [
      "**continuar a** (to keep on): **Continuo a estudar** (I keep studying). **deixar de** (to stop): **Deixei de fumar** (I stopped smoking). **voltar a** (to go back to): **Voltei a ler o livro** (I went back to reading the book)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "«Acabar de»",
     "texto": [
      "**acabar de** + infinitive = to have just: **Acabei de chegar** (I've just arrived). In Portugal it is used a lot to talk about something very recent."
     ],
     "tutora": ""
    },
