     "tipo": "explicacion",
     "titulo": "Travelling by public transport",
     "texto": [
      "**Ir de autocarro** = to go by bus.",
      "**Ir de metro** = to go by metro.",
      "**Mudar de linha** or **mudar de transporte** = to transfer or change line: *«Para chegar à universidade, muda para o metro na Baixa»*.",
      "**O bilhete é válido durante…** = the ticket is valid for a period of time (for example, 60 minutes on the urban network)."
     ],
     "tutora": ""
    }
   ]
  },
