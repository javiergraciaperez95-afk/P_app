   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Rules and access signs",
     "texto": [
      "**É gratuito / gratuita** = it is free (no cost).",
      "**É proibido + infinitivo** = it is forbidden: *«É proibido estacionar em frente à saída»*.",
      "**Saída** = exit (from a building, car park or station). **Entrada** = entrance.",
      "To refer to temporary installations, the adjective **temporário / temporária** is used: *«A paragem temporária fica junto à biblioteca»*."
     ],
     "tutora": ""
    }
   ]
  },
