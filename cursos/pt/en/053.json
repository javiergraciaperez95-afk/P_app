       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Paulo",
        "lengua": "estudio"
       },
       "estudio": "Bom dia, dona Sofia. A consulta com a médica de família é na terça-feira, às onze horas.",
       "alumno": "Good morning, Mrs Sofia. The appointment with the family doctor is on Tuesday at eleven.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
