     "titulo": "At the Coimbra health centre",
     "frases": [
      {
       "quien": {
        "texto": "Sofia",
        "lengua": "estudio"
       },
       "estudio": "Bom dia. Gostaria de marcar uma consulta médica para esta semana.",
       "alumno": "Good morning. I would like to book a medical appointment for this week.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
