   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Managing appointments at the health centre",
     "texto": [
      "**Marcar uma consulta** = to request or book a medical appointment.",
      "**Cartão de utente** = the official patient health card in Portugal.",
      "**A médica de família** = the GP (family doctor).",
      "**Marcação** = the booked medical appointment or reservation.",
      "Appointments can be changed or cancelled by phone or in person."
     ],
     "tutora": ""
    }
   ]
  },
