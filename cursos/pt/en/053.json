        ],
        [
         "às onze horas",
         "at eleven"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Sofia",
        "lengua": "estudio"
       },
       "estudio": "Perfeito. De que documentos preciso para o atendimento?",
       "alumno": "Perfect. What documents do I need for the visit?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "De que documentos preciso",
         "what documents do I need"
        ],
        [
         "para o atendimento",
         "for the visit"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Paulo",
        "lengua": "estudio"
       },
       "estudio": "Chegue dez minutos antes da hora marcada e leve o cartão de utente do SNS.",
       "alumno": "Arrive ten minutes before the appointment time and bring your SNS health card.",
       "literal": "",
