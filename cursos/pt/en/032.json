   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Directions and landmarks",
     "texto": [
      "**Vire à direita** = turn right.",
      "**Vire à esquerda** = turn left.",
      "**Siga em frente** = go straight on.",
      "**Em frente a / de** = opposite: *«O banco fica em frente à estação»*.",
      "The usual urban landmarks are: **igreja** (church), **farmácia** (pharmacy), **banco** (bank) and **praça** (square)."
     ],
     "tutora": ""
    }
   ]
