 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Irregular «yo», regular «tú» and «él»",
     "texto": [
      "Many verbs change only in the **eu** (I) form: **digo** (I say), **venho** (I come), **ouço** (I hear), **ponho** (I put), **dou** (I give).",
      "The other persons follow a similar pattern: **dizes**, **diz** (to say); **vens**, **vem** (to come)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "«Ver» and «ouvir»",
     "texto": [
      "**Ouvir** (to hear): **ouço**, **ouves**, **ouve**.",
      "**Ver** (to see): **vejo** (I see), **vês** (you see), **vê** (he sees). Also **dar** is irregular: **dou**, **dás**, **dá**."
     ],
     "tutora": ""
    },
