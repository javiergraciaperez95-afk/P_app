   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Appointments and work meetings",
     "texto": [
      "**Reunião** = work or business meeting.",
      "**Consulta** = medical or professional appointment.",
      "If an appointment changes time or day: **ficou para as…** (was set for…).",
      "If a commitment is delayed or put off to another date, the participle **adiado / adiada** is used (postponed): *«A consulta de sexta-feira foi adiada»*."
     ],
     "tutora": ""
    }
   ]
  },
  {
