   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "This, that, that one over there",
     "texto": [
      "Unlike English, which has only «this» and «that», Portuguese has three distances, and they agree with the noun.",
      "Notice the pronunciation: **este** sounds like «esh-t» and **esse** like «es»."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "The demonstratives",
     "columnas": [
      {
       "texto": "",
       "lengua": "alumno"
      },
