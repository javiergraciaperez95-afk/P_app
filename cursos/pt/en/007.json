 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Counter instructions and warnings",
     "texto": [
      "**Assinatura** is the handwritten signature or scrawl at the end of the sheet.",
      "**Campo** is each box or blank space where a detail is written.",
      "If a box has no information, you say it **está vazio** (is empty) or that a detail **falta** (is missing).",
      "The person serving the public is usually at the **receção** (reception, written without a silent «p» under AO90)."
     ],
     "tutora": ""
    }
   ]
  },
