      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "«Coloca-se imediatamente antes do verbo conjugado»",
       "lengua": "alumno",
       "explicacion": "«Diz-se «ainda não assinou» e nunca «assinou ainda não».»",
       "correcta": true
      },
      {
       "texto": "«Coloca-se no fim da frase após todos os complementos»",
       "lengua": "alumno",
       "explicacion": "«Não é a ordem gramatical natural.»",
       "correcta": false
      },
      {
       "texto": "«É facultativo e pode suprimir-se sem alterar o sentido»",
