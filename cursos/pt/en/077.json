 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "«Já» versus «ainda não»",
     "texto": [
      "**Já** expresses that an action happened before the reference point: **Já visitei o museu** (I have already visited the museum).",
      "**Ainda não** expresses that an expected action has not yet happened up to the present moment: **Ainda não almocei** (I haven't had lunch yet).",
      "«Em português europeu,» «ainda não» «precede obrigatoriamente o verbo conjugado.»"
     ],
     "tutora": ""
    }
   ]
  },
