 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "The future with «ir»",
     "texto": [
      "Like English «going to», but **without «a»**: ir + infinitive. **Vou jantar** = I'm going to have dinner. **Vamos viajar** = we're going to travel.",
      "**O que vais fazer amanhã?** = what are you going to do tomorrow?",
      "Negative: **Não vou sair** = I'm not going to go out."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "«Ir» + infinitive",
     "columnas": [
      {
       "texto": "Portugués",
       "lengua": "estudio"
      },
      {
       "texto": "English",
       "lengua": "alumno"
      }
     ],
     "filas": [
      [
       {
        "texto": "vou jantar",
        "lengua": "estudio"
       },
       {
        "texto": "I'm going to have dinner",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "vais sair",
        "lengua": "estudio"
       },
       {
        "texto": "you're going to go out",
        "lengua": "alumno"
       }
      ],
      [
       {
