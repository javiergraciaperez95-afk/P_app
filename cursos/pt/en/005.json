   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Countries and basic nationality words",
     "texto": [
      "In Portuguese, origin is usually expressed with the preposition **de** and its contraction with the article: **de Portugal** (Portugal takes no article), **do Porto** (Oporto takes a masculine article), **de Madrid**, **de Sevilha**.",
      "For nationality, adjectives such as **português / portuguesa**, **espanhol / espanhola** are used.",
      "The town where you were born is your **naturalidade**: *«A minha naturalidade é Faro»*."
     ],
     "tutora": ""
    }
   ]
  },
