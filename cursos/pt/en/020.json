    {
     "tipo": "explicacion",
     "titulo": "Vocabulary for shopping and prices",
     "texto": [
      "**Bilhete** is the ticket or admission for a show, train or museum.",
      "The total price is asked with **Quanto custa?** or **Quanto é?**",
      "**Custa doze euros** = it costs 12 euros.",
      "If there is a reduction, you say **com desconto** (with discount).",
      "The price list is displayed in a **tabela** (table, list or fare chart)."
     ],
     "tutora": ""
    }
   ]
  },
