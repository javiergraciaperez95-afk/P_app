     "tipo": "explicacion",
     "titulo": "Deadlines and proof of purchase",
     "texto": [
      "**Trocar o artigo** = to exchange the item.",
      "**Devolução** = return of the product and refund.",
      "**O prazo de trinta dias** = the thirty-day time limit (30 calendar days).",
      "**Guarde o recibo** = keep the receipt or till slip.",
      "**Artigos usados não são aceites** = used or unsealed items are not accepted."
     ],
     "tutora": ""
    }
