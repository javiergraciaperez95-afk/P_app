   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "It's possible, it's necessary",
     "texto": [
      "**É possível que** (it is possible that), **É provável que** (it is probable that), **É preciso que** (it is necessary that), **É importante que** (it is important that), **É bom que** (it is good that).",
      "Then comes the subjunctive: **É preciso que estudes** (it's necessary that you study)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Doubt and denying opinions",
     "texto": [
      "**Duvido que** (I doubt that) + subjunctive: **Duvido que chova** (I doubt it will rain).",
      "With a negative opinion, also the subjunctive: **Não acho que seja fácil** (I don't think it's easy). Watch out: with an affirmative **acho que** the indicative is used: **Acho que é fácil** (I think it's easy)."
     ],
     "tutora": ""
    },
