         "until when"
        ],
        [
         "podemos fazer",
         "we can do"
        ],
        [
         "a inscrição",
         "the registration"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Duarte",
        "lengua": "estudio"
       },
       "estudio": "A inscrição termina no dia quinze de maio, às seis da tarde.",
       "alumno": "Registration ends on 15 May, at six in the afternoon.",
       "literal": "",
       "estructura": "",
       "nota": [],
