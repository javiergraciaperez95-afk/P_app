         "the notice was published"
        ],
        [
         "a dois de abril",
         "2 April"
        ],
        [
         "no mural",
         "on the panel"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Beatriz",
        "lengua": "estudio"
       },
       "estudio": "E até quando podemos fazer a inscrição?",
       "alumno": "And until when can we sign up?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
