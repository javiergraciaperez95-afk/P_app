        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Beatriz",
        "lengua": "estudio"
       },
       "estudio": "Excelente. Vou avisar o meu irmão Tiago hoje mesmo.",
       "alumno": "Excellent. I'll tell my brother Tiago today.",
