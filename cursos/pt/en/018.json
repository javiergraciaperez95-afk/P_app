     "titulo": "A marcar uma visita guiada",
     "frases": [
      {
       "quien": {
        "texto": "Beatriz",
        "lengua": "estudio"
       },
       "estudio": "Bom dia. A visita ao museu está marcada para vinte e três de maio?",
       "alumno": "Good morning. Is the museum visit scheduled for 23 May?",
       "literal": "",
       "estructura": "",
       "nota": [],
