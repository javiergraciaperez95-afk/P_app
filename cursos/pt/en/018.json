         "23"
        ],
        [
         "de maio",
         "of May"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Duarte",
        "lengua": "estudio"
       },
       "estudio": "Sim, exatamente. O aviso foi publicado a dois de abril no mural da receção.",
       "alumno": "Yes, exactly. The notice was published on 2 April on the reception panel.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
