     "tipo": "explicacion",
     "titulo": "Payment methods and receipt breakdown",
     "texto": [
      "**O total da compra** = the accumulated total amount of the purchase.",
      "**Pagar com cartão** = to pay by card (debit or credit).",
      "**Pagar em dinheiro** = to pay in cash.",
      "**O cliente recebeu o recibo** = the customer received the till receipt.",
      "**O valor pago** = the amount actually paid."
     ],
     "tutora": ""
    }
   ]
  },
