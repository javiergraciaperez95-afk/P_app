     "tipo": "dialogo",
     "titulo": "«No consultório do médico»",
     "frases": [
      {
       "quien": {
        "texto": "Duarte",
        "lengua": "estudio"
       },
       "estudio": "Olá, Miguel. Como te estás a sentir hoje?",
       "alumno": "Hello, Miguel. How are you feeling today?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Como te estás a sentir",
         "how are you feeling"
        ],
        [
         "hoje",
         "today"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Miguel",
        "lengua": "estudio"
       },
       "estudio": "Não estou nada bem, Duarte. Tenho dores de garganta muito fortes e tosse.",
       "alumno": "I'm not well at all, Duarte. I have very strong throat pain and a cough.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Tenho dores de garganta",
         "I have a sore throat"
        ],
        [
         "muito fortes",
         "very strong"
        ],
        [
         "e tosse",
         "and a cough"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Duarte",
        "lengua": "estudio"
       },
       "estudio": "E a Inês também adoeceu? Ouvi dizer que estava doente.",
       "alumno": "And has Inês fallen ill too? I heard she was ill.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "também adoeceu",
         "has also fallen ill"
        ],
        [
         "estava doente",
         "was ill"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Miguel",
        "lengua": "estudio"
       },
       "estudio": "Sim, a Inês está constipada desde ontem, mas felizmente não tem febre.",
       "alumno": "Yes, Inês has had a cold since yesterday, but fortunately she has no fever.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "está constipada",
         "has a cold"
        ],
        [
         "felizmente",
         "fortunately"
        ],
        [
         "não tem febre",
         "she has no fever"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Duarte",
        "lengua": "estudio"
       },
       "estudio": "Compreendo. O aviso do SNS pede que os sintomas sejam descritos com clareza na triagem.",
       "alumno": "I understand. The SNS notice asks that symptoms be described clearly at triage.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "pede que os sintomas",
         "asks that the symptoms"
        ],
        [
         "sejam descritos",
         "be described"
        ],
        [
         "com clareza",
         "clearly"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Miguel",
        "lengua": "estudio"
       },
       "estudio": "É verdade, assim o médico receita o tratamento mais eficaz.",
       "alumno": "That's true, so the doctor prescribes the most effective treatment.",
       "literal": "",
       "estructura": "",
       "nota": [],
