    {
     "tipo": "explicacion",
     "titulo": "Symptoms and physical states",
     "texto": [
      "**Ter dores de garganta** = to have a sore throat.",
      "**Estar constipado / constipada** = to have a cold (a classic trap: in English «constipated» means something else).",
      "**Ter febre** = to have a fever.",
      "**Descrever os sintomas com clareza** = to describe the symptoms clearly and precisely.",
      "**A dor / as dores** = the pain / the pains."
     ],
     "tutora": ""
    }
   ]
