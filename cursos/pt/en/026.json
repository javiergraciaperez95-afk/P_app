 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Frequency adverbs",
     "texto": [
      "**Sempre** = always: *«Ele estuda sempre na biblioteca»*.",
      "**Às vezes** = sometimes, from time to time: *«Às vezes almoça na cantina»*.",
      "**Nunca** = never: it goes before the verb, and a second negative («não») is not compulsory: *«Nunca trabalha ao domingo»* or *«Ele nunca come carne»*.",
      "**Pequeno-almoço** is the Portuguese breakfast; the usual verb for taking meals is **tomar** or **almoçar** (to have lunch)."
     ],
     "tutora": ""
    }
   ]
  },
