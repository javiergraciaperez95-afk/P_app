   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Chronological sequence connectors",
     "texto": [
      "**Primeiro** = first (of all): *«Primeiro, Rui consulta o horário»*.",
      "**Depois** = then, afterwards: *«Depois, compra o bilhete»*.",
      "**Por fim** or **finalmente** = finally, at the end: *«Por fim, entra no autocarro das oito»*.",
      "To wait for transport, you wait at the **paragem de autocarro** (bus stop)."
     ],
     "tutora": ""
    }
   ]
  },
