 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Cause and consequence",
     "texto": [
      "**Porque** explains the cause (why?): **Levo um casaco porque está frio** (I'm wearing a coat because it's cold).",
      "**Por isso** introduces the consequence (so, therefore): **Está a chover; por isso não vou sair** (it's raining; so I'm not going out).",
      "Note the punctuation: **por isso** usually comes after a comma or a semicolon."
     ],
     "tutora": ""
    }
   ]
  },
