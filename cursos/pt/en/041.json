    {
     "tipo": "explicacion",
     "titulo": "Nutrition labels and allergens",
     "texto": [
      "**Contém…** = contains… (from the verb *conter*).",
      "**Pode conter vestígios de…** = may contain traces of…",
      "**Frutos secos** = nuts (walnuts, almonds).",
      "**Farinha de trigo** = wheat flour.",
      "Storage instructions: **Conservar no frio** (store in a cold place / in the fridge)."
     ],
     "tutora": ""
    }
   ]
  },
