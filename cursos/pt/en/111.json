   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "«Há ... que» + present",
     "texto": [
      "To say how long something has been going on, use **há** + time + **que** + present: **Há cinco anos que moro aqui** (I've lived here for five years).",
      "Example: **Há três anos que estudo português** (I've been studying Portuguese for three years)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Asking since when",
     "texto": [
      "To ask, use **Há quanto tempo** (for how long?): **Há quanto tempo moras em Lisboa?** (how long have you lived in Lisbon?).",
      "With **desde** the present is also used: **Moro aqui desde 2020** (I've lived here since 2020)."
     ],
     "tutora": ""
    },
