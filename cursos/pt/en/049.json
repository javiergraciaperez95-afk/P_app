    {
     "tipo": "explicacion",
     "titulo": "Queue and counter system",
     "texto": [
      "**Tirar uma senha** or **retirar uma senha** = to take or collect a queue number from the dispenser.",
      "**Aguardar pela sua vez** = to wait for your turn to come.",
      "**A sua vez** = your turn.",
      "**A senha B12 será atendida no balcão 3** = queue number B12 will be served at counter 3.",
      "**O balcão de atendimento** = the public service counter."
     ],
     "tutora": ""
    }
   ]
  },
