 "titulo_pt": "A porta está fechada",
 "titulo_es": {
  "@es": "La puerta está cerrada: estado y acción",
  "@en": "The door is closed: state and action"
 },
 "palabras": {
  "pelo porteiro": {
   "es": "por el portero",
   "en": "by the doorman",
   "pron": "pe-lu por-TEI-ru",
   "consejo": "«Por» + «o» + «porteiro»."
  },
  "estado": {
   "es": "estado",
   "en": "status",
   "pron": "esh-TA-du",
   "consejo": {
    "@es": "Situación en la que está algo.",
    "@en": "Situation where there's something."
   }
  },
  "desde as dez": {
   "es": "desde las diez",
   "en": "from 10: 00",
   "pron": "DESH-d(e) ash DEZH",
   "consejo": {
    "@es": "Para indicar desde cuándo.",
    "@en": "To indicate when."
   }
  }
 },
 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Estar + participio = estado",
    "@en": "Being + participle = status"
   },
   "texto": [
    {
     "@es": "Con **estar** + participio, describes cómo está algo ahora: **A porta está fechada** (la puerta está cerrada). El resultado es lo que importa.",
     "@en": "With **estar** + participle, you describe how something is now: **A porta está fechada** (the door is closed). The result is what matters."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Ser + participio = acción",
    "@en": "Being + participle = action"
   },
   "texto": [
    {
     "@es": "Con **ser** + participio, describes el hecho de la acción: **A porta foi fechada pelo porteiro** (la puerta fue cerrada por el portero). Aquí importa quién lo hizo.",
     "@en": "With **ser** + participle, you describe the fact of the action: **A porta foi fechada pelo porteiro** (the door was closed by the doorman). It matters who did it here."
    }
   ]
  },
  {
   "tipo": "tabla",
   "titulo": {
    "@es": "Forma",
    "@en": "Form"
   },
   "filas": [
