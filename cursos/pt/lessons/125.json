 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Preguntas con si",
    "@en": "You ask if"
   },
   "texto": [
    {
     "@es": "Para preguntas de sí o no, usa **se** (si): **Perguntou-me se ias à festa** (me preguntó si ibas a la fiesta).",
     "@en": "For questions of yes or no, use **se** (yes): **Perguntou-me se ias à festa** (asked if you were going to the party)."
    },
    {
     "@es": "Ojo: no se usa el signo de interrogación ni el orden de la pregunta original.",
     "@en": "Eye: the question mark and the order of the original question are not used."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Preguntas con palabra interrogativa",
    "@en": "Questions with question word"
   },
   "texto": [
    {
     "@es": "Con **onde**, **quando**, **o que**, **quem** se mantiene la palabra: **Perguntou-me onde estavas** (me preguntó dónde estabas).",
     "@en": "With **onde**, **quando**, **o que**, **quem** the word \"**Perguntou-me onde estavas**\" is kept (he asked me where you were)."
    },
    {
     "@es": "El verbo pasa a imperfecto o pasado según el caso.",
     "@en": "The verb becomes imperfect or past according to the case."
    }
   ]
  },
