 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": "Cada vez mais",
   "texto": [
    {
     "@es": "**Cada vez mais** (cada vez más): **Cada vez mais pessoas reciclam** (cada vez más personas reciclan). Muy útil para hablar de tendencias.",
     "@en": "**Cada vez mais** (increasingly): **Cada vez mais pessoas reciclam** (increasingly people recycle). Very useful to talk about trends."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": "A fim de, em vez de",
   "texto": [
    {
     "@es": "**A fim de** + infinitivo expresa finalidad (con el fin de): **a fim de poupar energia** (con el fin de ahorrar energía). **Em vez de** + infinitivo expresa alternativa (en vez de): **em vez de usar carro, andar a pé** (en vez de usar el coche, andar).",
     "@en": "**A fim de** + infinitive express purpose (for the purpose of): **a fim de poupar energia** (for the purpose of saving energy). **Em vez de** + infinitive express alternative (instead of): **em vez de usar carro, andar a pé** (instead of using the car, walk)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "La sostenibilidad",
    "@en": "Sustainability"
   },
   "texto": [
    {
     "@es": "La **sustentabilidade** es el equilibrio entre medio ambiente, economía y sociedad. Ojo: en Portugal se escribe **sustentabilidade** con un solo «n».",
     "@en": "The **sustentabilidade** is the balance between environment, economy and society. Eye: In Portugal, **sustentabilidade** is written with a single «n»."
    }
   ]
  },
