{
 "capitulo": 12,
 "titulo_pt": "Digo, venho, ponho",
 "titulo_es": {
  "@es": "Digo, vengo, pongo: verbos irregulares",
  "@en": "I mean, I come, I put: irregular verbs"
 },
 "palabras": {
  "digo": {
   "es": "digo",
   "en": "I mean...",
   "pron": "DI-gu",
   "consejo": {
    "@es": "Viene de «dizer» (decir).",
    "@en": "It comes from «dizer» (say)."
   }
  },
  "dizes": {
   "es": "dices (tú)",
   "en": "You say (you)",
   "pron": "DI-zesh",
   "consejo": {
    "@es": "Con tú, el verbo es regular en la terminación.",
    "@en": "With you, the verb is regular at the end."
   }
  },
  "diz": {
   "es": "dice",
   "en": "It says",
   "pron": "dish",
   "consejo": {
    "@es": "Él o ella dice.",
    "@en": "He or she says."
   }
  },
  "venho": {
   "es": "vengo",
   "en": "I'm coming.",
   "pron": "VE-ñu",
   "consejo": {
    "@es": "Viene de «vir» (venir).",
    "@en": "It comes from «vir» (come)."
   }
  },
  "vens": {
   "es": "vienes (tú)",
   "en": "You come (you)",
   "pron": "vensh",
   "consejo": {
    "@es": "En Portugal se pronuncia «vensh».",
    "@en": "In Portugal it is pronounced «vensh»."
   }
  },
  "vem": {
   "es": "viene",
   "en": "It's coming.",
   "pron": "veim",
   "consejo": {
    "@es": "Él o ella viene.",
    "@en": "He or she is coming."
   }
  },
  "ouço": {
   "es": "oigo",
   "en": "I hear",
   "pron": "O-su",
   "consejo": {
    "@es": "Viene de «ouvir» (oír).",
    "@en": "It comes from «ouvir» (hear)."
   }
  },
  "ouves": {
   "es": "oyes (tú)",
   "en": "You hear (you)",
   "pron": "O-vesh",
   "consejo": {
    "@es": "Con «tu».",
    "@en": "With «tu»."
   }
  },
  "ouve": {
   "es": "oye",
   "en": "Hey.",
   "pron": "O-vi",
   "consejo": {
    "@es": "Él o ella oye.",
    "@en": "He or she hears."
   }
  },
  "ponho": {
   "es": "pongo",
   "en": "I put",
   "pron": "PO-ñu",
   "consejo": {
    "@es": "Viene de «pôr» (poner).",
    "@en": "It comes from «pôr» (put)."
   }
  },
  "pões": {
   "es": "pones (tú)",
   "en": "put (you)",
   "pron": "po-ESH",
   "consejo": {
    "@es": "Con «tu».",
    "@en": "With «tu»."
   }
  },
  "põe": {
   "es": "pone",
   "en": "It says",
   "pron": "POI",
   "consejo": {
    "@es": "Él o ella pone.",
    "@en": "He or she puts."
   }
  },
  "dou": {
   "es": "doy",
   "en": "I give",
   "pron": "do",
   "consejo": {
    "@es": "Viene de «dar».",
    "@en": "It's from «dar»."
   }
  },
  "dás": {
   "es": "das (tú)",
   "en": "(you)",
   "pron": "dash",
   "consejo": {
    "@es": "Con «tu».",
    "@en": "With «tu»."
   }
  },
  "verdade": {
   "es": "verdad",
   "en": "Right.",
   "pron": "ver-DA-d(e)",
   "consejo": {
    "@es": "Es femenino: «a verdade».",
    "@en": "It's feminine: «a verdade»."
   }
  },
  "mentira": {
   "es": "mentira",
   "en": "lie",
   "pron": "men-TI-ra",
   "consejo": {
    "@es": "Es femenino: «uma mentira».",
    "@en": "It's feminine: «uma mentira»."
   }
  },
  "vês": {
   "es": "ves (tú)",
   "en": "ves (you)",
   "pron": "vesh",
   "consejo": {
    "@es": "Viene de «ver».",
    "@en": "It's from «ver»."
   }
  }
 },
 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Yo irregular, tú y él regulares",
    "@en": "Me irregular, you and him regular"
   },
   "texto": [
    {
     "@es": "Muchos verbos cambian solo en la forma de **eu** (yo): **digo** (digo), **venho** (vengo), **ouço** (oigo), **ponho** (pongo), **dou** (doy).",
     "@en": "Many verbs change only in the form of **eu** (I): **digo** (I say), **venho** (come), **ouço** (hear), **ponho** (put), **dou** (give)."
    },
    {
     "@es": "Las demás personas siguen un patrón parecido: **dizes**, **diz** (decir); **vens**, **vem** (venir).",
     "@en": "The other people follow a similar pattern: **dizes**, **diz** (say); **vens**, **vem** (come)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Ver y oír",
    "@en": "See and hear"
   },
   "texto": [
    {
     "@es": "**Ouvir** (oír): **ouço**, **ouves**, **ouve**.",
     "@en": "**Ouvir** (hear): **ouço**, **ouves**, **ouve**."
    },
    {
     "@es": "**Ver** (ver): **vejo** (yo veo), **vês** (tú ves), **vê** (él ve). También **dar** es irregular: **dou**, **dás**, **dá**.",
     "@en": "**Ver** (see): **vejo** (I see), **vês** (you see), **vê** (he sees). **dar** is also irregular: **dou**, **dás**, **dá**."
    }
   ]
  },
