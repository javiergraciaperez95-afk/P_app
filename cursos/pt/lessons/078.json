     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Voy a clase todos los días.",
      "@en": "I go to class every day."
     },
     "explicacion": {
      "@es": "Eso sería «vou à aula».",
      "@en": "That would be «vou à aula»."
     }
    },
    {
     "texto": {
      "@es": "Vengo a casa todos los días.",
      "@en": "I come home every day."
     },
     "explicacion": {
      "@es": "«Casa» es «casa», no «aula».",
      "@en": "«Casa» is «casa», not «aula»."
     }
    }
   ]
  },
