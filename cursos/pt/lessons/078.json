  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Cómo se dice «yo digo» en portugués?",
    "@en": "How do you say «I say» in Portuguese?"
   },
   "id": "pt078-1",
   "opciones": [
    {
     "texto": "Eu digo.",
     "explicacion": {
      "@es": "Con «eu», el verbo «dizer» cambia a «digo».",
      "@en": "With «eu», the verb «dizer» changes to «digo»."
     },
     "correcta": true
    },
    {
     "texto": "Eu dizo.",
     "explicacion": {
      "@es": "Eso no existe en portugués.",
      "@en": "That doesn't exist in Portuguese."
     }
    },
    {
     "texto": "Eu diz.",
     "explicacion": {
      "@es": "«Diz» es para él o ella.",
      "@en": "«Diz» is for him or her."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Cuál es la forma correcta de «tú vienes»?",
    "@en": "What is the correct form of «You're coming.»?"
   },
   "id": "pt078-2",
   "opciones": [
    {
     "texto": "vens",
     "explicacion": {
      "@es": "«Vir» con «tu» es «vens».",
      "@en": "«Vir» with «tu» is «vens»."
     },
     "correcta": true
    },
    {
     "texto": "venho",
     "explicacion": {
      "@es": "Es para «eu» (yo).",
      "@en": "It's for «eu» (I)."
     }
    },
    {
     "texto": "vem",
     "explicacion": {
      "@es": "Es para «ele» o «ela» (él o ella).",
      "@en": "It's for «ele» or «ela» (he or she)."
     }
    }
   ]
  },
  {
   "tipo": "traduccion",
   "pregunta": {
    "@es": "¿Qué significa?",
    "@en": "What does that mean?"
   },
   "frase": "Eu venho à aula todos os dias.",
