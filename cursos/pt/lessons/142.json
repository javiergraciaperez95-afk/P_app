 "capitulo": 32,
 "titulo_pt": "Seja como for",
 "titulo_es": {
  "@es": "Sea como sea: expresiones concesivas e indefinidas",
  "@en": "Whatever: concessional and indefinite expressions"
 },
 "palabras": {
  "seja como for": {
   "es": "sea como sea",
   "en": "Whatever.",
   "pron": "SE-zha KO-mu FOR",
   "consejo": {
    "@es": "Para decir que no importa cómo.",
    "@en": "To say it doesn't matter how."
   }
  },
  "quem quer que": {
   "es": "quienquiera que",
   "en": "whoever",
   "pron": "KEM KER KE",
