    "@es": "Con conjuntivo.",
    "@en": "Conjunctive."
   }
  },
  "onde quer que": {
   "es": "dondequiera que",
   "en": "wherever",
   "pron": "ON-d(e) KER KE",
   "consejo": {
    "@es": "Con conjuntivo.",
    "@en": "Conjunctive."
   }
  },
  "seja qual for": {
   "es": "sea cual sea",
   "en": "Whatever.",
   "pron": "SE-zha KWAL FOR",
   "consejo": {
    "@es": "Con conjuntivo.",
    "@en": "Conjunctive."
   }
  },
  "levo-te": {
   "es": "te llevo",
   "en": "I'll take you.",
   "pron": "LE-vu-t(e)",
   "consejo": {
    "@es": "Con «eu» y «te» al final.",
    "@en": "With «eu» and «te» at the end."
   }
  },
  "entra": {
   "es": "entra",
   "en": "Come in.",
   "pron": "EN-tra",
   "consejo": {
    "@es": "Viene de «entrar».",
    "@en": "It's from «entrar»."
   }
  },
