 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Preciso de + nombre",
    "@en": "+ name requirement"
   },
   "texto": [
    {
     "@es": "**Preciso de** (necesito) va con un nombre: **Preciso de um emprego** (necesito un empleo).",
     "@en": "**Preciso de** (I need) goes with a name: **Preciso de um emprego** (I need a job)."
    },
    {
     "@es": "Es lo mismo que «necesitar» en español.",
     "@en": "It's the same as «need» in Spanish."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Precisar de + infinitivo",
    "@en": "Need + infinitive"
   },
   "texto": [
    {
     "@es": "**Precisar de** también puede ir seguido de un infinitivo: **Preciso de descansar** (necesito descansar), **Precisamos de trabalhar** (necesitamos trabajar).",
     "@en": "**Precisar de** can also be followed by an infinitive: **Preciso de descansar** (I need to rest), **Precisamos de trabalhar** (we need to work)."
    },
    {
     "@es": "Conserva **de** delante del infinitivo.",
     "@en": "Keep **de** in front of the infinitive."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "É preciso + infinitivo",
    "@en": "Precise + infinitive"
   },
   "texto": [
    {
     "@es": "**É preciso** (hace falta) va con infinitivo: **É preciso falar português** (hace falta hablar portugués).",
     "@en": "**É preciso** (it is necessary) goes with infinitive: **É preciso falar português** (it is necessary to speak Portuguese)."
    },
    {
     "@es": "También se dice **é necessário** (es necesario).",
     "@en": "**é necessário** is also said (necessary)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Trabajar como",
    "@en": "Work as"
   },
   "texto": [
    {
     "@es": "**Trabalho como professora** (trabajo como profesora). Usa **como** para la profesión.",
     "@en": "**Trabalho como professora** (I work as a teacher). Use **como** for the profession."
    }
   ]
  },
