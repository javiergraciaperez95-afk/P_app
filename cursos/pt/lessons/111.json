 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": "Há ... que + presente",
   "texto": [
    {
     "@es": "Para decir desde cuándo se hace algo, usa **há** + tiempo + **que** + presente: **Há cinco anos que moro aqui** (vivo aquí desde hace cinco años).",
     "@en": "To tell you since when something is done, use **há** + time + **que** + present: **Há cinco anos que moro aqui** (I have lived here for five years)."
    },
    {
     "@es": "Ejemplo: **Há três anos que estudo português** (estudio portugués desde hace tres años).",
     "@en": "Example: **Há três anos que estudo português** (Portuguese study for three years)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Perguntar desde cuándo",
    "@en": "Perpose since when"
   },
   "texto": [
    {
     "@es": "Para preguntar, usa **Há quanto tempo** (¿desde hace cuánto tiempo?): **Há quanto tempo moras em Lisboa?** (¿desde hace cuánto tiempo vives en Lisboa?).",
     "@en": "To ask, use **Há quanto tempo** (for how long?): **Há quanto tempo moras em Lisboa?** (for how long do you live in Lisbon?)."
    },
    {
     "@es": "Con **desde** también se usa el presente: **Moro aqui desde 2020** (vivo aquí desde 2020).",
     "@en": "**desde** also uses the present: **Moro aqui desde 2020** (I live here since 2020)."
    }
   ]
  },
