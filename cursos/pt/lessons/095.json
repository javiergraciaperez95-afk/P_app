 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Negativo de cortesía",
    "@en": "Negative courtesy"
   },
   "texto": [
    {
     "@es": "Para una instrucción negativa cortés, usa **não + forma de cortesía**: **Não fume aqui** (no fume aquí), **Não faça isso** (no haga eso).",
     "@en": "For a polite negative instruction, use **não + forma de cortesía**: **Não fume aqui** (do not smoke here), **Não faça isso** (do not do that)."
    },
    {
     "@es": "El pronombre átono va delante: **Não se preocupe**, **Não me diga**. Se escribe sin guion.",
     "@en": "The tone pronoun goes ahead: **Não se preocupe**, **Não me diga**. It's written without a script."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Pronombres delante",
    "@en": "Preterms ahead"
   },
   "texto": [
    {
     "@es": "**Não se preocupe** (no se preocupe), **Não me diga** (no me diga). Con **não** el pronombre va siempre delante: **não o diga**, **não lhe fale**.",
     "@en": "**Não se preocupe** (don't worry), **Não me diga** (don't tell me). With **não** the pronoun always goes ahead: **não o diga**, **não lhe fale**."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Prohibiciones a una persona de confianza",
    "@en": "Prohibitions on a person of trust"
   },
   "texto": [
    {
     "@es": "Con **tu**, también se puede prohibir algo: **Não fales tão alto** (no hables tan alto), **Não comas aqui** (no comas aquí), **Não digas isso** (no digas eso), **Não vás sozinho** (no vayas solo).",
     "@en": "With **tu**, you can also ban something: **Não fales tão alto** (don't speak so loud), **Não comas aqui** (don't eat here), **Não digas isso** (don't say that), **Não vás sozinho** (don't go alone)."
    },
    {
     "@es": "La forma negativa es distinta del imperativo afirmativo (**fala**, pero **não fales**). En este nivel, aprende estas formas frecuentes como modelos.",
     "@en": "The negative form is different from the affirmative imperative (**fala**, but **não fales**). At this level, learn these frequent forms as models."
    }
   ]
  },
