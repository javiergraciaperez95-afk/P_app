   "tipo": "explicacion",
   "titulo": {
    "@es": "Para contar unas vacaciones",
    "@en": "To count a holiday"
   },
   "texto": [
    {
     "@es": "**As férias** = las vacaciones. **Ir de férias** = irse de vacaciones. **Onde foste nas férias?** = ¿adónde fuiste en vacaciones?",
     "@en": "**As férias** = the holiday. **Ir de férias** = go on vacation. **Onde foste nas férias?** = Where did you go on vacation?"
    },
    {
     "@es": "**A viagem** es «el viaje», y es femenino.",
     "@en": "**A viagem** is «the trip», and it is feminine."
    },
    {
     "@es": "**Lá** = allí. **Todos os dias** = todos los días. **Foi ótimo!** = ¡fue genial!",
     "@en": "**Lá** = there. **Todos os dias** = every day. **Foi ótimo!** = It was great!"
    },
    {
     "@es": "«Ver» en pasado: **vi** (vi), **viste** (viste), **viu** (vio).",
     "@en": "«Ver» in past: **vi** (vi), **viste** (vere), **viu** (vi)."
    }
   ]
  },
