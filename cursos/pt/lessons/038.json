 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Necesitar: «precisar de»",
    "@en": "Need: «precisar de»"
   },
   "texto": [
    {
     "@es": "«Necesitar» es **precisar**, y también lleva **de**: **Preciso de pão** (necesito pan). **Precisamos de leite** (necesitamos leche).",
     "@en": "«Need» is **precisar**, and also carries **de**: **Preciso de pão** (I need bread). **Precisamos de leite** (we need milk)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Las cantidades",
    "@en": "The quantities"
   },
   "texto": [
    {
     "@es": "**Um quilo de** (un kilo de), **meio quilo de** (medio kilo de), **um litro de**, **cem gramas de** (cien gramos de).",
     "@en": "**Um quilo de** (one kilo of), **meio quilo de** (half a kilo of), **um litro de**, **cem gramas de** (100 grams of)."
    },
    {
     "@es": "**Uma garrafa de** (una botella de), **um pacote de** (un paquete de), **uma dúzia de** (una docena de).",
     "@en": "**Uma garrafa de** (a bottle of), **um pacote de** (a package of), **uma dúzia de** (a dozen of)."
    },
    {
     "@es": "«Mucho» concuerda: **muito** arroz, **muita** fruta, **muitos** ovos, **muitas** maçãs.",
     "@en": "«A lot.» agrees: **muito** rice, **muita** fruit, **muitos** ovos, **muitas** maçãs."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Cuánto cuesta",
    "@en": "How much it costs"
   },
   "texto": [
    {
     "@es": "**Quanto custa?** si es una cosa y **Quanto custam?** si son varias.",
     "@en": "**Quanto custa?** if it's one thing and **Quanto custam?** if it's several."
    },
    {
     "@es": "**Custa doze euros o quilo** = cuesta doce euros el kilo. Los céntimos son **cêntimos**.",
     "@en": "**Custa doze euros o quilo** = costs 12 euros a kilo. The cents are **cêntimos**."
    },
    {
     "@es": "**Então** = entonces.",
     "@en": "**Então** = then."
    }
   ]
  },
