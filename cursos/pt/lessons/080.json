 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Frecuencia",
    "@en": "Frequency"
   },
   "texto": [
    {
     "@es": "**sempre** (siempre), **quase sempre** (casi siempre), **normalmente** (normalmente), **às vezes** (a veces), **de vez em quando** (de vez en cuando), **raramente** (raramente) y **nunca** (nunca).",
     "@en": "**sempre** (always), **quase sempre** (almost always), **normalmente** (usually), **às vezes** (sometimes), **de vez em quando** (sometimes), **raramente** (rarely) and **nunca** (never)."
    },
    {
     "@es": "Con **nunca** delante del verbo no se usa **não**: **Nunca faço isso** (nunca hago eso).",
     "@en": "With **nunca** in front of the verb **não**: **Nunca faço isso** is not used (I never do that)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Veces por periodo",
    "@en": "Time by period"
   },
   "texto": [
    {
     "@es": "**uma vez por semana** (una vez por semana), **duas vezes por mês** (dos veces al mes), **três vezes por ano** (tres veces al año).",
     "@en": "**uma vez por semana** (once a week), **duas vezes por mês** (twice a month), **três vezes por ano** (three times a year)."
    },
    {
     "@es": "**Por** indica «cada»: cada semana, cada mes.",
     "@en": "**Por** indicates «cada»: every week, every month."
    }
   ]
