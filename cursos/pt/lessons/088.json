 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Hace tres días",
    "@en": "Three days ago"
   },
   "texto": [
    {
     "@es": "**Há três dias** significa «hace tres días». Se usa para el tiempo que pasó desde que algo empezó: **Tenho febre há três dias** (tengo fiebre desde hace tres días).",
     "@en": "**Há três dias** means «Three days ago». It is used for the time that has happened since something started: **Tenho febre há três dias** (I have had a fever for three days)."
    },
    {
     "@es": "Ojo: aquí **há** significa «hace». Con otro sentido, **há** también puede significar «hay» (lección 4).",
     "@en": "Eye: here **há** means «does». In another sense, **há** can also mean «There's» (lesson 4)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Desde cuándo",
    "@en": "Since when?"
   },
   "texto": [
    {
     "@es": "**Desde quando** (desde cuándo) y **desde ontem** (desde ayer). Se usa con el presente: **Estou doente desde ontem** (estoy enfermo desde ayer).",
     "@en": "**Desde quando** (since when) and **desde ontem** (since yesterday). It is used with the present: **Estou doente desde ontem** (I have been ill since yesterday)."
    },
    {
     "@es": "En Portugal se dice también **há dois dias** (hace dos días) en esta función: **Estou doente há dois dias**.",
     "@en": "In Portugal, **há dois dias** (two days ago) is also said in this function: **Estou doente há dois dias**."
    }
   ]
  },
