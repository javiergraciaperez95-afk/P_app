 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Costumava + infinitivo",
    "@en": "Costumava + infinitive"
   },
   "texto": [
    {
     "@es": "**Costumava** (solía) + infinitivo: **Costumava ir à praia** (solía ir a la playa). Es el imperfecto de **costumar** (soler).",
     "@en": "**Costumava** (used to) + infinitive: **Costumava ir à praia** (used to go to the beach). It is the imperfect of **costumar** (soler)."
    },
    {
     "@es": "**Antigamente** (antiguamente) suele ir al principio: **Antigamente, nadava muito** (antes, nadaba mucho).",
     "@en": "**Antigamente** (formerly) usually goes to the beginning: **Antigamente, nadava muito** (before, it swam a lot)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Estava a + infinitivo",
    "@en": "Stava to + infinitive"
   },
   "texto": [
    {
     "@es": "En el pasado, **estava a** + infinitivo muestra una acción que estaba pasando: **Estava a trabalhar** (estaba trabajando).",
     "@en": "In the past, **estava a** + infinitive shows an action that was going on: **Estava a trabalhar** (was working)."
    },
    {
     "@es": "Igual que el presente (**estou a trabalhar**, estoy trabajando), pero con **estava**.",
     "@en": "Just like the present (**estou a trabalhar**, I'm working), but with **estava**."
    }
   ]
  },
