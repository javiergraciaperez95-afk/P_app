 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Consejo con condicional",
    "@en": "Conditional advice"
   },
   "texto": [
    {
     "@es": "**Eu, no teu lugar, falaria com ela** (yo, en tu lugar, hablaría con ella). **Eu faria o mesmo** (yo haría lo mismo).",
     "@en": "**Eu, no teu lugar, falaria com ela** (I would talk to her instead of you). **Eu faria o mesmo** (I would do the same)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Deveria y seria melhor",
    "@en": "Deveria and seria melhor"
   },
   "texto": [
    {
     "@es": "**Deveria** + infinitivo = deberías: **Deveria descansar** (deberías descansar).",
     "@en": "**Deveria** + infinitive = you should: **Deveria descansar** (you should rest)."
    },
    {
     "@es": "**Seria melhor** + infinitivo = sería mejor: **Seria melhor ir cedo** (sería mejor ir temprano).",
     "@en": "**Seria melhor** + infinitive = would be better: **Seria melhor ir cedo** (it would be better to go early)."
    }
   ]
  },
  {
   "tipo": "tabla",
