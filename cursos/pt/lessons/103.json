 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Ordenar lo que haces",
    "@en": "Order what you do"
   },
   "texto": [
    {
     "@es": "**Primeiro** (primero), **depois** (después), **por fim** (por fin, al final).",
     "@en": "**Primeiro** (first), **depois** (later), **por fim** (finally, at the end)."
    },
    {
     "@es": "Ejemplo: **Primeiro, vamos ao mercado, depois à farmácia** (primero, vamos al mercado, después a la farmacia).",
     "@en": "Example: **Primeiro, vamos ao mercado, depois à farmácia** (first, we go to the market, then to the pharmacy)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Pero y sin embargo",
    "@en": "But and yet"
   },
   "texto": [
    {
     "@es": "**Mas** (pero) une ideas opuestas. **No entanto** (sin embargo) es más formal.",
     "@en": "**Mas** (but) unites opposite ideas. **No entanto** (however) is more formal."
    },
    {
     "@es": "Ejemplo: **Não posso, mas tenho tempo** (no puedo, pero tengo tiempo).",
     "@en": "Example: **Não posso, mas tenho tempo** (I can't, but I have time)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Causa y consecuencia",
    "@en": "Cause and consequence"
   },
   "texto": [
    {
     "@es": "**Porque** (porque) explica la razón. **Por isso** (por eso) muestra la consecuencia. **Portanto** (por tanto) y **então** (entonces) también sirven para concluir.",
     "@en": "**Porque** (because) explains the reason. **Por isso** (therefore) shows the consequence. **Portanto** (therefore) and **então** (then) also serve to conclude."
    },
    {
     "@es": "Ejemplo: **Não posso, porque tenho uma reunião** (no puedo, porque tengo una reunión).",
     "@en": "Example: **Não posso, porque tenho uma reunião** (I can't, because I have a meeting)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Otros conectores",
    "@en": "Other connectors"
   },
   "texto": [
    {
     "@es": "**Além disso** (además). **Finalmente** (finalmente). **Assim** (así).",
     "@en": "**Além disso** (in addition). **Finalmente** (finally). **Assim** (so)."
    },
    {
     "@es": "Son útiles para escribir un correo o una historia.",
     "@en": "They're useful for writing an email or a story."
    }
   ]
  },
  {
   "tipo": "tabla",
   "titulo": {
