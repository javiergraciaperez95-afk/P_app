 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": "La CPLP",
   "texto": [
    {
     "@es": "La **CPLP** (Comunidade dos Países de Língua Portuguesa) reúne **nueve países** que tienen el portugués como lengua oficial: Portugal, Brasil, Angola, Moçambique, Cabo Verde, Guiné-Bissau, São Tomé e Príncipe, Guiné Equatorial y Timor-Leste.",
     "@en": "The **CPLP** (Community of two Portuguese Lingua Countries) brings together **nueve países** which have Portuguese as their official language: Portugal, Brazil, Angola, Moçambique, Cape Verde, Guinea-Bissau, Sao Tome e Príncipe, Guiné Equatorial and Timor- Leste."
    },
    {
     "@es": "Cuando hablamos de los países africanos de lengua portuguesa se dice **PALOP** (Países Africanos de Língua Oficial Portuguesa).",
     "@en": "When we talk about the Portuguese-speaking African countries, **PALOP** (Official Portuguese-speaking African Countries) is said."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Lengua oficial y lengua materna",
    "@en": "Official language and mother tongue"
   },
   "texto": [
    {
     "@es": "En muchos de estos países el portugués es la lengua oficial, pero no la materna de toda la población. En Timor-Leste y en Angola, por ejemplo, conviven con otras lenguas locales.",
     "@en": "In many of these countries, Portuguese is the official language, but not the mother tongue of the entire population. In Timor-Leste and Angola, for example, they live with other local languages."
    }
   ]
  },
