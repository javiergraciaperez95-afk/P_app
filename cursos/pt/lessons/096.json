 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Para: finalidad y destino",
    "@en": "For: purpose and destination"
   },
   "texto": [
    {
     "@es": "**para** indica para qué se hace algo: **Trabalho para pagar a casa** (trabajo para pagar la casa).",
     "@en": "**para** indicates why something is done: **Trabalho para pagar a casa** (work to pay for the house)."
    },
    {
     "@es": "También indica el destino: **Vou para Lisboa** (voy a Lisboa).",
     "@en": "It also indicates the destination: **Vou para Lisboa** (I'm going to Lisbon)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Por: causa, medio y cantidad de tiempo",
    "@en": "For: cause, medium and amount of time"
   },
   "texto": [
    {
     "@es": "**por** indica la causa: **por causa da chuva** (por culpa de la lluvia), **por isso** (por eso).",
     "@en": "**por** indicates the cause: **por causa da chuva** (because of the rain), **por isso** (because of it)."
    },
    {
     "@es": "Indica el medio o el precio: **pelo correio** (por correo), **Trabalho por dinheiro** (trabajo por dinero).",
     "@en": "Indicates the medium or price: **pelo correio** (by mail), **Trabalho por dinheiro** (work for money)."
    },
    {
     "@es": "Indica una duración aproximada: **Vou por uma semana** (voy por una semana).",
     "@en": "It indicates an approximate duration: **Vou por uma semana** (I go for a week)."
    }
   ]
  },
