 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Tinha + participio",
    "@en": "Tinha + particicio"
   },
   "texto": [
    {
     "@es": "Para hablar de algo que pasó antes de otra acción en el pasado, usa **tinha** (había) + participio: **Disse-me que tinha ido ao médico** (me dijo que había ido al médico).",
     "@en": "To talk about something that happened before another action in the past, use **tinha** (had) + participle: **Disse-me que tinha ido ao médico** (he told me he had gone to the doctor)."
    },
    {
     "@es": "Igual que el perfecto compuesto, pero con **tinha** en lugar de **tenho**.",
     "@en": "Just like the perfect compound, but with **tinha** instead of **tenho**."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Ya",
    "@en": "Now."
   },
   "texto": [
    {
     "@es": "Con **já** (ya): **já tinha feito** (ya había hecho). El **já** va delante del verbo auxiliar.",
     "@en": "With **já** (already): **já tinha feito** (already done). The **já** goes in front of the auxiliary verb."
    }
   ]
  },
