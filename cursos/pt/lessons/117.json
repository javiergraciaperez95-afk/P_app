 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Es posible, es preciso",
    "@en": "It is possible, it is necessary"
   },
   "texto": [
    {
     "@es": "**É possível que** (es posible que), **É provável que** (es probable que), **É preciso que** (hace falta que), **É importante que** (es importante que), **É bom que** (es bueno que).",
     "@en": "**É possível que** (it's possible that), **É provável que** (it's likely), **É preciso que** (it's necessary that), **É importante que** (it's important that), **É bom que** (it's good that)."
    },
    {
     "@es": "Después va el conjuntivo: **É preciso que estudes** (hace falta que estudies).",
     "@en": "Then the conjunctive: **É preciso que estudes** (you need to study)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Dudar y negar opiniones",
    "@en": "Doubt and deny opinions"
   },
   "texto": [
    {
     "@es": "**Duvido que** (dudo que) + conjuntivo: **Duvido que chova** (dudo que llueva).",
     "@en": "**Duvido que** (I doubt) + conjunctive: **Duvido que chova** (I doubt it rains)."
    },
    {
     "@es": "Con opinión negativa, también conjuntivo: **Não acho que seja fácil** (no creo que sea fácil). Ojo: con **acho que** afirmativo va indicativo: **Acho que é fácil** (creo que es fácil).",
     "@en": "With negative, also conjunctive opinion: **Não acho que seja fácil** (I don't think it's easy). Eye: with **acho que** affirmative goes indicative: **Acho que é fácil** (I think it's easy)."
    }
   ]
  },
