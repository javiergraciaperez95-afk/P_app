 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Gostar de + infinitivo",
    "@en": "Glostar of + infinitive"
   },
   "texto": [
    {
     "@es": "Para decir que te gusta hacer algo, usa **gostar de** + infinitivo: **Gosto de cozinhar** (me gusta cocinar).",
     "@en": "To say that you like to do something, use **gostar de** + infinitive: **Gosto de cozinhar** (I like to cook)."
    },
    {
     "@es": "Si hablas de una cosa, usa **gostar de** + nombre: **Gosto de música** (me gusta la música).",
     "@en": "If you talk about one thing, use **gostar de** + name: **Gosto de música** (I like music)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Preferir",
    "@en": "Prefer"
   },
   "texto": [
    {
     "@es": "**Preferir** (preferir) va con infinitivo: **Prefiro ler** (prefiero leer).",
     "@en": "**Preferir** (prefer) goes with infinitive: **Prefiro ler** (I prefer to read)."
    },
    {
     "@es": "Para comparar dos cosas, usa **a**: **Prefiro chá a café** (prefiero té a café). Ojo: **prefiro chá do que café** también se dice.",
     "@en": "To compare two things, use **a**: **Prefiro chá a café** (I prefer tea to coffee). Eye: **prefiro chá do que café** is also said."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Gustar más",
    "@en": "Taste more"
   },
   "texto": [
    {
     "@es": "**Gosto mais de pintar do que de cozinhar** (me gusta más pintar que cocinar).",
     "@en": "**Gosto mais de pintar do que de cozinhar** (I like to paint more than to cook)."
    },
    {
     "@es": "Usa **mais de** para decir «más» con gustos y **do que** para la comparación.",
     "@en": "Use **mais de** to say «more» with tastes and **do que** for comparison."
    }
   ]
  },
