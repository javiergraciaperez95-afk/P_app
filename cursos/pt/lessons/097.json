 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Estar a + infinitivo",
    "@en": "To be a + infinitive"
   },
   "texto": [
    {
     "@es": "Para decir que algo está pasando ahora mismo, usa **estar a** + infinitivo: **Estou a trabalhar** (estoy trabajando).",
     "@en": "To say that something is going on right now, use **estar a** + infinitive: **Estou a trabalhar** (I'm working)."
    },
    {
     "@es": "Igual que en el capítulo 9: **estou a ler** (estoy leyendo), **está a chover** (está lloviendo).",
     "@en": "As in chapter 9: **estou a ler** (I'm reading), **está a chover** (it's raining)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Andar a + infinitivo",
    "@en": "Go to + infinitive"
   },
   "texto": [
    {
     "@es": "**Andar a + infinitivo** puede presentar una actividad que se prolonga o se repite durante un período: **Ando a procurar emprego** (llevo un tiempo buscando trabajo).",
     "@en": "**Andar a + infinitivo** may present an activity that is prolonged or repeated over a period: **Ando a procurar emprego** (I have been looking for work for a while)."
    },
    {
     "@es": "Compáralo con **Estou a procurar emprego**, que enfoca lo que estoy haciendo ahora. El sentido exacto depende del contexto.",
     "@en": "Share it with **Estou a procurar emprego**, which focuses what I'm doing now. The exact meaning depends on the context."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Todavía no",
    "@en": "Not yet."
   },
   "texto": [
    {
     "@es": "**Ainda não** (todavía no) indica que algo no ha pasado aún: **Ainda não acabou** (todavía no ha terminado).",
     "@en": "**Ainda não** (not yet) indicates that something has not happened yet: **Ainda não acabou** (not yet finished)."
    },
    {
     "@es": "Para decir que algo ya no pasa, se usa **já não** (ya no): **Já não trabalho aqui** (ya no trabajo aquí).",
     "@en": "To say that something no longer happens, **já não** (no longer) is used: **Já não trabalho aqui** (no longer work here)."
    }
   ]
  },
