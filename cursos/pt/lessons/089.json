 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Pedir en la farmacia",
    "@en": "Ask at the pharmacy"
   },
   "texto": [
    {
     "@es": "**Queria um xarope** (quería un jarabe). **Pode dar-me um analgésico?** (¿puede darme un analgésico?).",
     "@en": "**Queria um xarope** (I wanted a syrup). **Pode dar-me um analgésico?** (can you give me an analgesic?)."
    },
    {
     "@es": "Te preguntarán **Tem receita?** (¿tiene receta?). Para algunos medicamentos hace falta receta.",
     "@en": "They'll ask you **Tem receita?** (do you have a prescription?). For some medicines, a prescription is needed."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Cómo tomarlo",
    "@en": "How to take it"
   },
   "texto": [
    {
     "@es": "**Deve tomar** (debe tomar) + el medicamento: **Deve tomar um xarope** (debe tomar un jarabe).",
     "@en": "**Deve tomar** (you should take) + the medicine: **Deve tomar um xarope** (you should take a syrup)."
    },
    {
     "@es": "Para la dosis usa **vezes por dia** (veces al día): **três vezes por dia** (tres veces al día).",
     "@en": "For the dose use **vezes por dia** (times daily): **três vezes por dia** (three times daily)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Cuándo tomarlo",
    "@en": "When to take it"
   },
   "texto": [
    {
     "@es": "**antes das refeições** (antes de las comidas) y **de oito em oito horas** (cada ocho horas).",
     "@en": "**antes das refeições** (before meals) and **de oito em oito horas** (every eight hours)."
    },
    {
     "@es": "Con «de... em...» dices cada cuánto: **de oito em oito horas**, **de dia em dia** (cada día).",
     "@en": "With «de... em...» you say each how much: **de oito em oito horas**, **de dia em dia** (every day)."
    }
   ]
  },
  {
   "tipo": "tabla",
   "titulo": {
    "@es": "Instrucción",
    "@en": "Instruction"
   },
   "filas": [
    [
     "Deve tomar três vezes por dia.",
     {
      "@es": "Debe tomar tres veces al día.",
      "@en": "It must take three times a day."
     }
    ],
    [
     "Tomar antes das refeições.",
     {
      "@es": "Tomar antes de las comidas.",
      "@en": "Take it before meals."
     }
    ],
    [
     "De oito em oito horas.",
     {
      "@es": "Cada ocho horas.",
      "@en": "Every eight hours."
     }
    ]
   ],
   "columnas": [
    "Traducción"
   ]
