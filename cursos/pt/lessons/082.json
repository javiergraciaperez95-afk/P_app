 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Poder, querer y saber",
    "@en": "Power, want and know"
   },
   "texto": [
    {
     "@es": "**Poder** (poder): **pude**, **pudeste**, **pôde**. **Querer** (querer): **quis**, **quiseste**, **quisemos**. **Saber** (saber): **soube**, **soubeste**.",
     "@en": "**Poder** (power): **pude**, **pudeste**, **pôde**. **Querer** (want): **quis**, **quiseste**, **quisemos**. **Saber** (know): **soube**, **soubeste**"
    },
    {
     "@es": "En el pasado, **saber** significa «enterarse»: **soube** = supe. Y con **não** en el pasado, **não quis** = no quiso.",
     "@en": "In the past, **saber** means «Find out»: **soube** = I knew. And with **não** in the past, **não quis** = didn't want to."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Trazer y ler",
    "@en": "Trazer and ler"
   },
   "texto": [
    {
     "@es": "**Trazer** (traer): **trouxe** (traje), **trouxeste** (trajiste). **Ler** (leer): **li** (leí), **leste** (leíste), **leu** (leyó).",
     "@en": "**Trazer** (bring): **trouxe** (suit), **trouxeste** (bring). **Ler** (read): **li** (read), **leste** (read), **leu** (read)."
    },
    {
     "@es": "Ojo: en Portugal **li** se pronuncia «lí».",
     "@en": "Eye: in Portugal **li** is pronounced «lí»."
    }
   ]
  },
