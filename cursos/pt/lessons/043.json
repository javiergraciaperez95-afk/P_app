 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Este, ese, aquel",
    "@en": "This, that, that"
   },
   "texto": [
    {
     "@es": "Igual que en español, hay tres distancias, y concuerdan con el nombre.",
     "@en": "As in Spanish, there are three distances, and they match the name."
    },
    {
     "@es": "Fíjate en la pronunciación: **este** suena «esht» y **esse**, «es».",
     "@en": "Look at the pronunciation: **este** sounds «esht» and **esse**, «is»."
    }
   ]
  },
  {
   "tipo": "tabla",
   "titulo": {
    "@es": "Los demostrativos",
    "@en": "The demonstrative"
   },
   "filas": [
    [
