     "estes, estas"
    ],
    [
     {
      "@es": "cerca de ti",
      "@en": "near you"
     },
     "esse",
     "essa",
     "esses, essas"
    ],
    [
     {
      "@es": "lejos",
      "@en": "far away"
     },
