 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": "Continuar a, deixar de, voltar a",
   "texto": [
    {
     "@es": "**continuar a** (seguir): **Continuo a estudar** (sigo estudiando). **deixar de** (dejar de): **Deixei de fumar** (dejé de fumar). **voltar a** (volver a): **Voltei a ler o livro** (volví a leer el libro).",
     "@en": "**continuar a** (continue): **Continuo a estudar** (I continue to study). **deixar de** (stop): **Deixei de fumar** (stop smoking). **voltar a** (back to): **Voltei a ler o livro** (I read the book again)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": "Acabar de",
   "texto": [
    {
     "@es": "**acabar de** + infinitivo = acabar de: **Acabei de chegar** (acabo de llegar). En Portugal se usa mucho para hablar de algo muy reciente.",
     "@en": "**acabar de** + infinitive = finish: **Acabei de chegar** (just arrived). In Portugal a lot is used to talk about something very recent."
    }
   ]
  },
