 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Creo que, pienso que",
    "@en": "I think, I think"
   },
   "texto": [
    {
     "@es": "En afirmaciones como **Acho que vai chover** (creo que va a llover), **acho que** y **penso que** suelen ir seguidos del indicativo.",
     "@en": "In claims like **Acho que vai chover** (I think it will rain), **acho que** and **penso que** are usually followed by the sign."
    },
    {
     "@es": "Para decir que algo parece probable, usa **parece que**: **Parece que vai fazer sol** (parece que va a hacer sol).",
     "@en": "To say that something seems likely, use **parece que**: **Parece que vai fazer sol** (it seems to make it sun)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Dudas y certezas",
    "@en": "Doubts and certainties"
   },
   "texto": [
    {
     "@es": "**Talvez** (quizá) y **se calhar** (quizá, muy usado en Portugal): **Se calhar tens razão** (quizá tienes razón).",
     "@en": "**Talvez** (perhaps) and **se calhar** (perhaps, very used in Portugal): **Se calhar tens razão** (perhaps you are right)."
    },
    {
     "@es": "Para decir que estás segura o seguro, di **tenho a certeza** (tengo la certeza). Para decir que no lo estás, di **tenho dúvidas** (tengo dudas).",
     "@en": "To say that you are safe or safe, say **tenho a certeza** (I am certain). To say you're not, say **tenho dúvidas** (I have doubts)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Estar de acuerdo",
    "@en": "To agree"
   },
   "texto": [
