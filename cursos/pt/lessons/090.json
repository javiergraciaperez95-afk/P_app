 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Descripciones y hábitos",
    "@en": "Descriptions and habits"
   },
   "texto": [
    {
     "@es": "El imperfecto sirve para describir el pasado (**A casa era grande**, la casa era grande) y para decir lo que hacías siempre (**Morava em Coimbra**, vivía en Coimbra).",
     "@en": "The imperfect serves to describe the past (**A casa era grande**, the house was great) and to say what you were always doing (**Morava em Coimbra**, lived in Coimbra)."
    },
    {
     "@es": "No dice cuándo empezó ni cuándo acabó. Solo describe.",
     "@en": "It doesn't say when it started or when it ended. Just describe."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Terminaciones",
    "@en": "Terminations"
   },
   "texto": [
    {
     "@es": "En los verbos en **-ar**: **-ava** (falava, hablaba). En los verbos en **-er** e **-ir**: **-ia** (comia, comía).",
     "@en": "In the verbs in **-ar**: **-ava** (falava, spoke). In the verbs in **-er** and **-ir**: **-ia** (eating, eating)."
    },
    {
     "@es": "Eu falava, tu falavas, ele falava, nós falávamos, eles falavam. Eu comia, tu comias, ele comia, nós comíamos, eles comiam.",
     "@en": "Eu falava, your falavas, ele falava, we falavos, eles falavam. Eu comia, tu comias, ele comia, nos comos, eles comiam."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Irregulares",
    "@en": "Unregular"
   },
   "texto": [
    {
     "@es": "**Ser** → **era** (era), **ter** → **tinha** (tenía), **ir** → **ia** (iba).",
     "@en": "**Ser** → **era** (era), **ter** → **tinha** (had), **ir** → **ia** (iba)."
    },
    {
     "@es": "Ojo: **ia** (iba) viene de **ir** en imperfecto. **Fui** (fui) es del pasado puntual.",
     "@en": "Eye: **ia** (iba) comes from **ir** in imperfect. **Fui** (I was) is from the punctual past."
    }
   ]
  },
