 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Verbos con pôr",
    "@en": "Verbs with pôr"
   },
   "texto": [
    {
     "@es": "**propor** (proponer), **dispor** (disponer), **compor** (componer), **repor** (reponer). Se conjugan igual que **pôr**: **proponho** (propongo), **propõe** (propone), **disponho** (dispongo).",
     "@en": "**propor** (propose), **dispor** (have), **compor** (compose), **repor** (replenish). They are conjugated as **pôr**: **proponho** (proposed), **propõe** (proposed), **disponho** (available)."
    },
    {
     "@es": "**Pôr** = poner, **propor** = proponer, **compor** = componer.",
     "@en": "**Pôr** = put, **propor** = propose, **compor** = compose."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Verbos con pedir",
    "@en": "Verbs with order"
   },
   "texto": [
    {
     "@es": "**impedir** (impedir), **despedir** (despedir): **impeço** (impido), **impede** (impide).",
     "@en": "**impedir** (prevent), **despedir** (fire): **impeço** (prevent), **impede** (prevent)."
    },
    {
     "@es": "Ojo: **despedir-se** significa «despedirse».",
     "@en": "Eye: **despedir-se** means «Say goodbye.»."
    }
   ]
  },
