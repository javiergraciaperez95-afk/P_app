     "pregunta": {
      "texto": "En el portugués estándar de Portugal, ¿cómo se escribe ortográficamente el nombre «António»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Com acento agudo na letra O (António)",
       "lengua": "estudio",
       "explicacion": "En Portugal la primera «o» es fonéticamente abierta y lleva acento agudo.",
       "correcta": true
      },
      {
       "texto": "Com acento circunflexo (Antônio)",
       "lengua": "estudio",
       "explicacion": "Esa es la convención fónica cerrada predominante en Brasil.",
       "correcta": false
      },
      {
       "texto": "Sem nenhum acento (Antonio)",
       "lengua": "alumno",
       "explicacion": "La palabra es esdrújula y requiere acento gráfico obligatorio.",
       "correcta": false
      }
     ],
     "respuestas": {
