     "tipo": "explicacion",
     "titulo": "Medios de pago y desglose del ticket",
     "texto": [
      "**O total da compra** = el importe total acumulado.",
      "**Pagar com cartão** = pagar con tarjeta (débito/crédito).",
      "**Pagar em dinheiro** = pagar en metálico o efectivo.",
      "**O cliente recebeu o recibo** = el cliente recibió el comprobante de caja.",
      "**O valor pago** = la cantidad efectivamente abonada."
     ],
     "tutora": ""
    }
   ]
  },
