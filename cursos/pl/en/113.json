   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Aspect: process and result",
     "texto": [
      "The imperfective shows an activity in progress, habitual or without emphasis on its end: **czytałam książkę**. The perfective presents the event as complete: **przeczytałam całą książkę**.",
      "The pairs do not always translate into different verbs in English. The context makes clear whether the process or the result is emphasised."
     ],
     "tutora": ""
    }
   ]
  },
