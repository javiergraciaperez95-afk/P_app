   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "A specific action",
     "texto": [
      "**Weź tabletkę** means «take a tablet»: **weź** presents a specific action that gets completed.",
      "**Wziąć** is the perfective infinitive; its command form is **weź**."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "A prohibition or habit",
     "texto": [
      "**Nie bierz więcej tabletek** means «don't take any more tablets».",
      "In general advice, the imperfective **bierz** is often used in the negative command; **więcej** means «more»."
     ],
     "tutora": ""
    },
