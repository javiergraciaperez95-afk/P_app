   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Comparative adjectives",
     "texto": [
      "Many adjectives form the comparative with **-szy/-ejszy**: **większy**, **krótszy**, **młodszy**. Others change their root: **dobry → lepszy**.",
      "The comparison can use **niż** or **od** («than»). The adjective agrees in gender and number with the noun."
     ],
     "tutora": ""
    }
   ]
  },
