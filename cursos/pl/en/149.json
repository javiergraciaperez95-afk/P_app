   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Purpose with «żeby»",
     "texto": [
      "**Żeby + infinitive** expresses purpose: **Uczę się, żeby zdać egzamin** («I study in order to pass the exam»).",
      "In English we can also say «in order to + infinitive» or «to + infinitive»."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "«Zdać» and «zdawać»",
     "texto": [
      "**Zdawać egzamin** presents the exam as an activity or process; **zdać egzamin** emphasises passing it.",
      "The prefix **z-** changes the aspect and presents a result."
     ],
     "tutora": ""
    },
