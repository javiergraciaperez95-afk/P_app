    {
     "tipo": "explicacion",
     "titulo": "Sufficient condition",
     "texto": [
      "**O ile** means «as long as» or «provided that». **Pod warunkiem że** introduces a necessary condition: «on condition that».",
      "The conditional clause is usually separated by a comma."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Consequence",
     "texto": [
      "**W przeciwnym razie** means «otherwise».",
      "**Doprowadzić do + genitive** expresses that an action can cause a result."
     ],
     "tutora": ""
    }
   ]
