    {
     "tipo": "explicacion",
     "titulo": "Impersonal and passive",
     "texto": [
      "**Podano informację** means «the information was made known» without naming who did it.",
      "**Informacja została potwierdzona** puts the focus on the information and its result."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Not overstating",
     "texto": [
      "**Przypuszczenie** is something assumed, not a confirmed fact.",
      "**Wprowadzać w błąd** means to mislead someone with false or incomplete information."
     ],
     "tutora": ""
    }
   ]
  },
