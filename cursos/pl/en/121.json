   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Long form and short form",
     "texto": [
      "**Mi** is usually the short dative form within the sentence: **ten film mi się podoba** («I like this film»).",
      "**Mnie** is used at the start, at the end with emphasis or to contrast: **mnie się to podoba**, «I do like it». They are not interchangeable in every position."
     ],
     "tutora": ""
    }
   ]
