     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Instructions",
     "texto": [
      "The imperative **wypełnij** is an informal command to one person. **Proszę wypełnić** is the formal request."
     ],
     "tutora": ""
    }
   ]
