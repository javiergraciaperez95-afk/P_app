   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Comparing adjectives",
     "texto": [
      "Many Polish comparatives end in **-szy** or **-ejszy**: **duży → większy**, **mały → mniejszy**.",
      "Unlike in English, the comparative also agrees with the noun: **większa Warszawa**, **większe miasto**."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "The superlative",
     "texto": [
      "To form the superlative, **naj-** is usually added to the comparative: **większy → największy**.",
      "The form changes with the gender of the noun, like other adjectives."
     ],
     "tutora": ""
    },
