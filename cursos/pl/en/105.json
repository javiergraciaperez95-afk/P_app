   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Already, still and never",
     "texto": [
      "**Już** means «already»; **jeszcze** can mean «still/yet». With **nie**, **jeszcze nie** expresses «not yet».",
      "Polish uses the simple past for events already completed: **już widziałem** («I have already seen»). It needs no auxiliary verb equivalent to «have»."
     ],
     "tutora": ""
    }
   ]
  },
