   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Present tense routines",
     "texto": [
      "The Polish present covers both what is happening now and habitual actions.",
      "**Wstaję** means «I get up» and **wstajesz**, «you get up»; the verb changes with the person."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Meals and activities",
     "texto": [
      "**Jem** is «I eat» and **jesz**, «you eat»; **piję** is «I drink» and **pijesz**, «you drink».",
      "**Do pracy** means «to work»: after **do**, **praca** changes to **pracy**."
     ],
     "tutora": ""
    },
