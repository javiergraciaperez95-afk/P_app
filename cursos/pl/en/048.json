 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Origin and belonging",
     "texto": [
      "The preposition **z** means «from» or «with» and usually takes the genitive when it shows origin: **z pracy**, **z kina**. The same preposition can have other uses with another case.",
      "The genitive also expresses belonging and appears after **do** («to; towards») and **bez** («without»): **klucz do pokoju**, **kawa bez cukru**."
     ],
     "tutora": ""
    }
   ]
