 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Vocales y consonantes",
    "@en": "Vocals and consonants"
   },
   "texto": [
    {
     "@es": "Las letras **ś** y **ć** suenan suaves; **sz** se parece a «sh» y **cz** a «ch».",
     "@en": "The letters **ś** and **ć** sound soft; **sz** resembles «sh» and **cz** to «ch»."
    },
    {
     "@es": "La **ł** se acerca a la «w» inglesa; **ń** recuerda a «ñ». **Ą** y **ę** son nasales; la **ę** al final suele sonar casi como «e».",
     "@en": "The **ł** approaches the English «w»; **ń** remembers «-». **Ą** and **ę** are nasal; the **ę** at the end usually sounds almost like «e»."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Acento y saludos",
    "@en": "Acento y saludas"
   },
   "texto": [
    {
     "@es": "En la mayoría de las palabras polacas de varias sílabas, el acento cae en la penúltima.",
     "@en": "In most Polish words of several syllables, the accent falls into the penultimate."
    },
    {
     "@es": "**Dzień dobry** es un saludo formal. **Cześć** sirve para saludar informalmente y despedirse; **Do widzenia** es una despedida más formal.",
     "@en": "**Dzień dobry** is a formal greeting. **Cześć** serves to greet and say goodbye informally; **Do widzenia** is a more formal farewell."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Trato formal",
    "@en": "Formal treatment"
   },
   "texto": [
    {
     "@es": "**Pan** se usa para dirigirse formalmente a un hombre y **pani** a una mujer. Ojo: **pan** no significa el alimento español «pan»; es un falso amigo.",
     "@en": "**Pan** is used to formally address a man and **pani** to a woman. Eye: **pan** does not mean Spanish food «pan»; it is a false friend."
    },
    {
     "@es": "Entre personas de confianza se pregunta **Jak się masz?**, literalmente «¿cómo te tienes?».",
     "@en": "Among trusted people you ask **Jak się masz?**, literally «How you doing?»."
    }
   ]
  },
