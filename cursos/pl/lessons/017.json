   "texto": [
    {
     "@es": "El color concuerda con el género de la prenda: **czerwony sweter**, **czerwona koszula**.",
     "@en": "The color is consistent with the gender of the garment: **czerwony sweter**, **czerwona koszula**."
    },
    {
     "@es": "Igual que otros adjetivos, cambia con el nombre.",
     "@en": "Like other adjectives, it changes with the name."
    }
   ]
