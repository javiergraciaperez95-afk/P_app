   "titulo": {
    "@es": "Lenguaje informativo y valorativo",
    "@en": "Information and valuation language"
   },
   "texto": [
    {
     "@es": "**Informować** es presentar datos; **oceniać** es expresar una valoración.",
     "@en": "**Informować** is to present data; **oceniać** is to express an assessment."
    },
    {
     "@es": "Un texto puede parecer neutral y, aun así, sugerir una postura.",
     "@en": "A text may seem neutral and, even so, suggest a position."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Interpretar el tono",
    "@en": "Interpreting the tone"
   },
   "texto": [
    {
     "@es": "**Ironia** consiste en decir algo de forma que el contexto sugiera otro sentido.",
     "@en": "**Ironia** is to say something so that the context suggests another sense."
    },
    {
     "@es": "El **podtekst** no se expresa de manera directa, pero el lector puede deducirlo.",
     "@en": "The **podtekst** is not expressed directly, but the reader can deduct it."
    }
   ]
  },
