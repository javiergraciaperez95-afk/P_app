   "titulo": {
    "@es": "Necesidad y prohibición",
    "@en": "Necessity and prohibition"
   },
   "texto": [
    {
     "@es": "**Trzeba + infinitivo** expresa necesidad; **nie wolno + infinitivo** indica que algo está prohibido.",
     "@en": "**Trzeba + infinitivo** expresses need; **nie wolno + infinitivo** indicates that something is prohibited."
    },
    {
     "@es": "En estas expresiones no hace falta decir quién realiza la acción.",
     "@en": "In these expressions it is not necessary to say who does the action."
    }
   ]
