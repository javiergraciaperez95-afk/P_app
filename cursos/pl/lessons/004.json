 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Familia y género",
    "@en": "Family and gender"
   },
   "texto": [
    {
     "@es": "En polaco, **mama** y **siostra** son femeninas; **tata** y **brat** son masculinos. No hay artículos como «el» y «la».",
     "@en": "In Polish, **mama** and **siostra** are feminine; **tata** and **brat** are masculine. There are no items like «the» and «the»."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Posesivos",
    "@en": "Possessive"
   },
   "texto": [
    {
     "@es": "**Mój** acompaña a un nombre masculino: **mój brat**. **Moja** acompaña a uno femenino: **moja mama**.",
     "@en": "**Mój** accompanies a masculine name: **mój brat**. **Moja** accompanies one feminine: **moja mama**."
    },
    {
     "@es": "**To jest moja rodzina** significa «Esta es mi familia».",
     "@en": "**To jest moja rodzina** means «This is my family.»."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Tener",
    "@en": "Have"
   },
   "texto": [
    {
     "@es": "**Mam** significa «tengo» y **masz** significa «tienes». En **Jak się masz?**, la traducción natural es «¿Qué tal estás?».",
     "@en": "**Mam** means «I have» and **masz** means «You got it.». In **Jak się masz?**, the natural translation is «How are you?»."
    },
    {
     "@es": "Después de **mam**, el nombre puede cambiar: **brat → brata**, **siostra → siostrę**.",
     "@en": "After **mam**, the name may change: **brat → brata**, **siostra → siostrę**."
    }
   ]
  },
