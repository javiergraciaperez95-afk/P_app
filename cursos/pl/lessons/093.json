  {
   "tipo": "explicacion",
   "titulo": "Wigilia",
   "texto": [
    {
     "@es": "**Wigilia** es la cena y la noche del 24 de diciembre en Polonia; no significa cualquier «vigilia».",
     "@en": "**Wigilia** is dinner and the night of December 24 in Poland; it does not mean any «vigilia»."
    },
    {
     "@es": "En muchas familias se comparte **opłatek** y se intercambian buenos deseos. Las costumbres varían según la región y la familia.",
     "@en": "In many families **opłatek** is shared and good wishes are exchanged. Customs vary according to region and family."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Algunas costumbres",
    "@en": "Some customs"
   },
   "texto": [
    {
     "@es": "Es habitual hablar de doce platos para la cena y de un sitio extra en la mesa.",
     "@en": "It is common to talk about 12 dishes for dinner and an extra place on the table."
    },
    {
     "@es": "**Dzielić się opłatkiem** significa «compartir la oblea navideña»; **składać życzenia**, «expresar buenos deseos».",
     "@en": "**Dzielić się opłatkiem** means «share the Christmas wafer»; **składać życzenia**, «expresar buenos deseos»."
    }
   ]
  },
