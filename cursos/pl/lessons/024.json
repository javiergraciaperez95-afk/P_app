   "texto": [
    {
     "@es": "Para decir «en primavera», «en verano», «en otoño» y «en invierno», se usan **wiosną**, **latem**, **jesienią** y **zimą**.",
     "@en": "«in spring», «in summer», «in autumn» and «in winter» are used to say **wiosną**, **latem**, **jesienią** and **zimą**."
    },
    {
     "@es": "Son formas adverbiales; no se traducen palabra por palabra como en español.",
     "@en": "They are adverse forms; they are not translated word by word as in Spanish."
    }
   ]
  },
