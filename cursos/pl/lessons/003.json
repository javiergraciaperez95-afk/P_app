 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Pedir algo",
    "@en": "Ask for something"
   },
   "texto": [
    {
     "@es": "Para pedir, se puede decir **Kawę poproszę**: **kawa** cambia a **kawę**. También decimos **Wodę, proszę**; **woda** cambia a **wodę**.",
     "@en": "To order, you can say **Kawę poproszę**: **kawa** changes to **kawę**. We also say **Wodę, proszę**; **woda** changes to **wodę**."
    },
    {
     "@es": "Para pedir té: **herbatę**. Son formas del objeto directo, aunque el español no cambia la palabra.",
     "@en": "To order tea: **herbatę**. They are forms of the direct object, although Spanish does not change the word."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Con leche o sin leche",
    "@en": "With or without milk"
   },
   "texto": [
    {
     "@es": "Después de **z** («con») aparece **mlekiem**; después de **bez** («sin»), **mleka**. En estos ejemplos cambia la forma de la palabra leche.",
     "@en": "After **z** («with») **mlekiem** appears; after **bez** («without»), **mleka** appears. In these examples the form of the word milk changes."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Precio y falso amigo",
    "@en": "Price and false friend"
   },
   "texto": [
    {
     "@es": "**Ile kosztuje?** significa «¿Cuánto cuesta?». Tras **pięć** («cinco»), se dice **złotych**.",
     "@en": "**Ile kosztuje?** means «How much is it?». After **pięć** («five»), **złotych** is said."
    },
    {
     "@es": "**Menu** significa «menú»; **rachunek** es «la cuenta», no «el razonamiento».",
     "@en": "**Menu** means «menu»; **rachunek** is «the account», not «el razonamiento»."
    }
   ]
  },
