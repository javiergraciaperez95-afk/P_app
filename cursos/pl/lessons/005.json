 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "La edad",
    "@en": "Age"
   },
   "texto": [
    {
     "@es": "En polaco la edad se expresa con **mam**, **masz** o **ma** más el número y la forma de «año». En español también usamos «tener»: «tengo veinte años».",
     "@en": "In Polish the age is expressed with **mam**, **masz** or **ma** plus the number and form of «Year». In Spanish we also use «have»: «I'm 20.»."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": "Rok, lata, lat",
   "texto": [
    {
     "@es": "Se dice **jeden rok** (un año), **dwa/trzy/cztery lata** (dos, tres o cuatro años) y **pięć lat** (cinco años).",
     "@en": "**jeden rok** (one year), **dwa/trzy/cztery lata** (two, three or four years) and **pięć lat** (five years) are said."
    },
    {
     "@es": "En esta lección practicamos esas formas frecuentes; las terminaciones no coinciden siempre con el español.",
     "@en": "In this lesson we practice these frequent forms; the terminations do not always coincide with Spanish."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Formas del verbo mieć",
    "@en": "Forms of the verb mieć"
   },
   "texto": [
    {
     "@es": "**Mam** = tengo, **masz** = tienes, **ma** = tiene. El sujeto se puede omitir si ya está claro.",
     "@en": "**Mam** = I have, **masz** = you have, **ma** = has. The subject can be omitted if it's already clear."
    }
   ]
