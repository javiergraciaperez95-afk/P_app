 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": "Boli mnie",
   "texto": [
    {
     "@es": "En **Boli mnie głowa** («me duele la cabeza»), la parte del cuerpo es el sujeto y **mnie** significa «me».",
     "@en": "In **Boli mnie głowa** («My head hurts.»), the body part is the subject and **mnie** means «me»."
    },
    {
     "@es": "No se usa un posesivo como «mi»: **Boli mnie głowa**, no **Moja głowa boli**.",
     "@en": "A possessive such as «mi»: **Boli mnie głowa**, not **Moja głowa boli**, is not used."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Singular y plural",
    "@en": "singular and plural"
   },
   "texto": [
    {
     "@es": "**Boli** va con una parte del cuerpo en singular: **Boli mnie ząb**.",
     "@en": "**Boli** goes with a body part in singular: **Boli mnie ząb**."
    },
    {
     "@es": "**Bolą** va con un nombre plural: **Bolą mnie plecy**; en polaco, «espalda» se expresa con una palabra plural.",
     "@en": "**Bolą** goes with a plural name: **Bolą mnie plecy**; in Polish, «back» is expressed with a plural word."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Síntomas y género",
    "@en": "Symptoms and gender"
   },
   "texto": [
    {
     "@es": "Para algunos síntomas se usa **mam** + objeto: **Mam gorączkę**, «tengo fiebre».",
     "@en": "For some symptoms **mam** + object is used: **Mam gorączkę**, «I have a fever.»."
    },
    {
     "@es": "**Jestem chory** lo dice un hombre y **Jestem chora**, una mujer.",
     "@en": "**Jestem chory** says so by a man and **Jestem chora**, a woman."
    }
   ]
  },
