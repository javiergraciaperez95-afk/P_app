 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Preguntar la hora",
    "@en": "Ask the time"
   },
   "texto": [
    {
     "@es": "**Która godzina?** pregunta qué hora es ahora. **O której godzinie?** pregunta a qué hora ocurre algo.",
     "@en": "**Która godzina?** asks what time it is now. **O której godzinie?** asks what time something happens."
    },
    {
     "@es": "Las horas en punto usan la forma femenina: **Jest ósma** («Son las ocho»).",
     "@en": "The hours in point use the feminine: **Jest ósma** («It's 8: 00.») form."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Decir a qué hora",
    "@en": "Say what time"
   },
   "texto": [
    {
     "@es": "Después de **o**, la forma también cambia: **o ósmej** significa «a las ocho» y **o siódmej**, «a las siete».",
     "@en": "After **o**, the form also changes: **o ósmej** means «8: 00.» and **o siódmej**, «at 7: 00»."
    },
    {
     "@es": "Es distinto del español, donde solemos mantener «ocho» y «siete».",
     "@en": "It is different from Spanish, where we usually maintain «8» and «seven»."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Días de la semana",
    "@en": "Days of the week"
   },
   "texto": [
    {
     "@es": "Para los días se dice **w poniedziałek**, **w środę**, **w sobotę** o **w niedzielę**.",
     "@en": "For the days it is said **w poniedziałek**, **w środę**, **w sobotę** or **w niedzielę**."
    },
    {
     "@es": "Algunas formas cambian después de **w**; memoriza las expresiones completas.",
     "@en": "Some forms change after **w**; it memorizes the full expressions."
    }
   ]
  },
