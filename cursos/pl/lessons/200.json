 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Condición suficiente",
    "@en": "Sufficient condition"
   },
   "texto": [
    {
     "@es": "**O ile** significa «siempre que» o «con tal de que». **Pod warunkiem że** introduce una condición necesaria: «con la condición de que».",
     "@en": "**O ile** means «provided that» or «as long as». **Pod warunkiem że** introduces a necessary condition: «on the condition that»."
    },
    {
     "@es": "La cláusula condicional suele ir separada por coma.",
     "@en": "The conditional clause is usually separated by coma."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Consecuencia",
    "@en": "Consequence"
   },
   "texto": [
    {
     "@es": "**W przeciwnym razie** significa «de lo contrario».",
     "@en": "**W przeciwnym razie** means «otherwise»."
    },
    {
     "@es": "**Doprowadzić do + genitivo** expresa que una acción puede causar un resultado.",
     "@en": "**Doprowadzić do + genitivo** expresses that an action can cause a result."
    }
   ]
  },
