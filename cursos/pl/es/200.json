   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Condición suficiente",
     "texto": [
      "**O ile** significa «siempre que» o «con tal de que». **Pod warunkiem że** introduce una condición necesaria: «con la condición de que».",
      "La cláusula condicional suele ir separada por coma."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Consecuencia",
     "texto": [
      "**W przeciwnym razie** significa «de lo contrario».",
      "**Doprowadzić do + genitivo** expresa que una acción puede causar un resultado."
     ],
     "tutora": ""
    }
   ]
  },
