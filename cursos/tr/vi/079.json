   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Một sở thích mới",
     "frases": [
      {
       "quien": {
        "texto": "Ece",
        "lengua": "estudio"
       },
       "estudio": "Seramikle uğraşmaktan hoşlanıyorum. Hem dinleniyorum hem de yeni bir beceri öğreniyorum.",
       "alumno": "Mình mê làm gốm. Vừa nghỉ ngơi vừa học một kỹ năng mới.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Anna",
        "lengua": "estudio"
       },
       "estudio": "Bir şekli nasıl yapıyorsun?",
       "alumno": "Bạn tạo một hình dạng bằng cách nào?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ece",
        "lengua": "estudio"
       },
       "estudio": "Önce malzemeyi hazırlıyorum, ardından şekil veriyorum. Son olarak kurumasını bekliyorum.",
       "alumno": "Trước hết mình chuẩn bị nguyên liệu, sau đó mình tạo hình. Cuối cùng mình chờ nó khô.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
  {
   "etapa": "explicar",
