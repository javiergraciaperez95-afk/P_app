       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Can",
        "lengua": "estudio"
       },
       "estudio": "Çünkü bazı insanlar atıkları suya bırakıyor.",
       "alumno": "Vì một số người vứt chất thải xuống nước.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Deniz",
        "lengua": "estudio"
       },
       "estudio": "Bu nedenle geri dönüşüm kutuları koyalım.",
       "alumno": "Vì thế hãy đặt thùng tái chế.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Can",
        "lengua": "estudio"
       },
       "estudio": "Ayrıca evde su ve enerji tasarrufu yapabiliriz.",
       "alumno": "Ngoài ra, mình tiết kiệm nước và điện ở nhà được.",
       "literal": "",
