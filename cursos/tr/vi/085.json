   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Truyền thống",
     "texto": [
      "**gelenek** = truyền thống; **adet** = phong tục; **sofra adabı** = phép xã giao ở bàn ăn.",
      "Để so sánh, dùng **-e göre** («theo») và **buna karşılık** («trái lại»).",
      "Khi nói về phong tục, hãy tò mò và tránh khái quát về mọi người của một nước."
     ],
     "tutora": ""
    }
   ]
  },
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Cuộc trò chuyện giữa bạn bè",
     "frases": [
      {
       "quien": {
        "texto": "Anna",
        "lengua": "estudio"
       },
       "estudio": "Türkiye'de misafirperverlik nasıl gösterilir?",
       "alumno": "Ở Thổ Nhĩ Kỳ, lòng hiếu khách được thể hiện thế nào?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Deniz",
        "lengua": "estudio"
       },
       "estudio": "Misafire çay veya kahve ikram etmek yaygındır.",
       "alumno": "Mời người đến thăm trà hoặc cà phê là phổ biến.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Anna",
        "lengua": "estudio"
       },
       "estudio": "İspanya'da da misafire bir şey ikram edilir.",
       "alumno": "Ở Tây Ban Nha cũng mời người đến thăm một thứ gì đó.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Deniz",
        "lengua": "estudio"
       },
       "estudio": "Gelenekler farklı olabilir; buna karşılık misafire değer vermek ortak bir davranış.",
       "alumno": "Truyền thống có thể không giống nhau; trái lại, coi trọng người đến chơi là hành vi chung.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
