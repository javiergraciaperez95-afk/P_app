      },
      {
       "quien": {
        "texto": "Spiker",
        "lengua": "estudio"
       },
       "estudio": "Bu nedenle yolun kapandığı bildirildi.",
       "alumno": "Vì thế, người ta thông báo rằng con đường đã bị đóng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Spiker",
        "lengua": "estudio"
       },
       "estudio": "Sürücülerin alternatif yolu kullanmaları öneriliyor.",
       "alumno": "Khuyến nghị người lái xe dùng tuyến đường thay thế.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Spiker",
        "lengua": "estudio"
       },
