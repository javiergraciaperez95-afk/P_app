     "tipo": "dialogo",
     "titulo": "Một lời gợi ý",
     "frases": [
      {
       "quien": {
        "texto": "Elif",
        "lengua": "estudio"
       },
       "estudio": "Bu ceket sana yakışıyor ama kumaşı biraz kalın.",
       "alumno": "Chiếc măng tô này hợp với bạn, nhưng vải hơi dày.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Deniz",
        "lengua": "estudio"
       },
       "estudio": "Rahatlık benim için önemli.",
       "alumno": "Sự thoải mái quan trọng với mình.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Elif",
        "lengua": "estudio"
       },
       "estudio": "Bence daha hafif bir ceket daha iyi olur.",
       "alumno": "Theo mình, một chiếc măng tô nhẹ hơn sẽ tốt hơn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Deniz",
        "lengua": "estudio"
       },
       "estudio": "Haklısın, spor kıyafetleri daha çok seviyorum.",
       "alumno": "Bạn đúng, mình mê quần áo thể thao hơn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
