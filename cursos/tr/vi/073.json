   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Quy tắc và quan hệ",
     "texto": [
      "**görgü** = lễ độ; **komşuluk** = quan hệ hàng xóm; **davranış** = hành vi.",
      "**-malı/-meli** diễn tả một lời khuyên trong xã hội.",
      "Để bất đồng một cách lịch sự, dùng **Sana katılıyorum, ama...** («Mình đồng ý với bạn, nhưng...»)."
     ],
     "tutora": ""
    }
   ]
  },
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Trong tòa nhà",
     "frases": [
      {
       "quien": {
        "texto": "Ayşe",
        "lengua": "estudio"
       },
       "estudio": "Geç saatlerde gürültü yapılmamalı.",
       "alumno": "Không nên gây ồn ào vào lúc khuya.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Can",
        "lengua": "estudio"
       },
       "estudio": "Sana katılıyorum, ama komşular birbirleriyle de konuşmalı.",
       "alumno": "Mình đồng ý với bạn, nhưng hàng xóm cũng nên nói chuyện với nhau.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ayşe",
        "lengua": "estudio"
       },
       "estudio": "Elbette. Yaşlılara yardım etmek de önemli.",
       "alumno": "Tất nhiên. Giúp đỡ người lớn tuổi cũng quan trọng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Can",
        "lengua": "estudio"
       },
       "estudio": "Bence saygılı davranış ilişkileri güçlendirir.",
       "alumno": "Theo mình, cách cư xử tôn trọng củng cố quan hệ.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
