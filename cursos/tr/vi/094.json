    {
     "tipo": "dialogo",
     "titulo": "Một cuộc họp khu phố",
     "frases": [
      {
       "quien": {
        "texto": "Ece",
        "lengua": "estudio"
       },
       "estudio": "Yeni bisiklet yolu mahallemiz için iyi bir gelişme.",
       "alumno": "Làn xe đạp mới là một tiến bộ tích cực cho khu phố của mình.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Can",
        "lengua": "estudio"
       },
       "estudio": "Katılıyorum, ancak park yerleri azalabilir.",
       "alumno": "Mình đồng ý, nhưng chỗ đậu xe giảm đi được.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ece",
        "lengua": "estudio"
       },
       "estudio": "Buna rağmen daha az araba kullanmamıza yardımcı olur.",
       "alumno": "Dù vậy, nó sẽ giúp mình bớt đi xe ô tô.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Can",
        "lengua": "estudio"
       },
       "estudio": "Önce komşuların görüşlerini alalım, sonra belediyeye öneri gönderelim.",
       "alumno": "Trước hết, hãy cùng thu thập ý kiến của hàng xóm, rồi gửi đề xuất đến chính quyền địa phương.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
