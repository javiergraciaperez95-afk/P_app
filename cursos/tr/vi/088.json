     "tipo": "dialogo",
     "titulo": "Ở bến xe buýt",
     "frases": [
      {
       "quien": {
        "texto": "Ali",
        "lengua": "estudio"
       },
       "estudio": "Otobüsü bekliyordum, tam o sırada cüzdanım yere düştü.",
       "alumno": "Mình đang chờ xe buýt thì đúng lúc đó ví mình rơi xuống đất.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Deniz",
        "lengua": "estudio"
       },
       "estudio": "Ne zaman fark ettin?",
       "alumno": "Bạn nhận ra khi nào?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ali",
        "lengua": "estudio"
       },
       "estudio": "Otobüs geldiğinde yerde gördüm ve çok telaşlandım.",
       "alumno": "Khi xe buýt đến, mình thấy nó dưới đất và rất hoảng hốt.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Deniz",
        "lengua": "estudio"
       },
       "estudio": "Sonunda ne oldu?",
       "alumno": "Cuối cùng thì đã xảy ra gì?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ali",
        "lengua": "estudio"
       },
       "estudio": "Bir görevli buldu. Cüzdanımı geri aldım.",
       "alumno": "Một nhân viên đã tìm thấy nó. Mình đã lấy lại ví.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
