   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Hai ý kiến",
     "frases": [
      {
       "quien": {
        "texto": "Deniz",
        "lengua": "estudio"
       },
       "estudio": "Toplu taşıma ücretsiz olmalı. Böylece şehirde trafik azalır.",
       "alumno": "Phương tiện công cộng nên miễn phí. Như vậy, giao thông trong thành phố sẽ giảm.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Can",
        "lengua": "estudio"
       },
       "estudio": "Görüşünü anlıyorum. Ancak belediyenin bu hizmeti nasıl finanse edeceğini de düşünmeliyiz.",
       "alumno": "Mình hiểu quan điểm của bạn. Tuy nhiên, mình cũng nên nghĩ xem chính quyền địa phương sẽ tài trợ dịch vụ này thế nào.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Deniz",
        "lengua": "estudio"
       },
       "estudio": "Haklısın. Bir yandan herkes ulaşabilir, öte yandan bütçe gerekir.",
       "alumno": "Bạn đúng rồi. Một mặt, mọi người đều tiếp cận được; mặt khác thì cần ngân sách.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Can",
        "lengua": "estudio"
       },
       "estudio": "O hâlde önce maliyeti araştırıp sonra karar verelim.",
       "alumno": "Vậy hãy tìm hiểu chi phí trước rồi quyết định sau.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
