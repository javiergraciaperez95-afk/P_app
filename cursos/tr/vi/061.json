   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Đi du lịch một cách tự lập",
     "texto": [
      "Khi đi du lịch, bạn có thể hỏi thông tin bằng **Nereden bilet alabilirim?** («Mình mua vé ở đâu được?») và giải thích vấn đề bằng **Yardımınıza ihtiyacım var** («Tôi cần sự giúp đỡ của quý vị»).",
      "Để kể chuyện, đặt hành động vào quá khứ; để sắp kế hoạch, dùng tương lai và những cụm từ chỉ thời gian.",
      "Ôn lại cách giới thiệu, so sánh, thói quen, mua sắm, công việc, lời khuyên và điều kiện."
     ],
     "tutora": ""
    }
   ]
  },
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Ở nhà ga",
     "frases": [
      {
       "quien": {
        "texto": "Yolcu",
        "lengua": "estudio"
       },
       "estudio": "Affedersiniz, danışma nerede?",
       "alumno": "Xin lỗi, quầy thông tin ở đâu?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Görevli",
        "lengua": "estudio"
       },
       "estudio": "Bilet gişesinin yanında. Yardımcı olabilir miyim?",
       "alumno": "Cạnh quầy vé. Mình giúp được không ạ?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Yolcu",
        "lengua": "estudio"
       },
       "estudio": "Bagajımı kaybettim. Yardımınıza ihtiyacım var.",
       "alumno": "Tôi bị mất hành lý. Tôi cần sự giúp đỡ của quý vị.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Görevli",
        "lengua": "estudio"
       },
       "estudio": "Önce kayıp eşya bürosuna gidin.",
       "alumno": "Trước hết hãy đi đến văn phòng đồ thất lạc.",
       "literal": "",
       "estructura": "",
       "nota": [],
