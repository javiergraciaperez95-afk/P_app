   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Hai cách sống",
     "frases": [
      {
       "quien": {
        "texto": "Anna",
        "lengua": "estudio"
       },
       "estudio": "Şehirde yaşamayı seviyorum çünkü her yere kolayca gidiyorum.",
       "alumno": "Mình thích sống ở thành phố vì mình đi đến mọi nơi dễ dàng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ece",
        "lengua": "estudio"
       },
       "estudio": "Ben doğada vakit geçirmeyi tercih ediyorum.",
       "alumno": "Còn mình chọn dành thời gian trong thiên nhiên.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Anna",
        "lengua": "estudio"
       },
       "estudio": "Yoğun çalışmama rağmen akşamları arkadaşlarımla buluşuyorum.",
       "alumno": "Dù làm việc nhiều, buổi tối mình vẫn hẹn gặp bạn bè.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ece",
        "lengua": "estudio"
       },
       "estudio": "Hem ailemle hem de arkadaşlarımla vakit geçirmek benim için önemli.",
       "alumno": "Với mình, dành thời gian vừa với gia đình vừa với bạn bè là quan trọng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
