       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Yolcu",
        "lengua": "estudio"
       },
       "estudio": "Bugün saat üçte. İfade vermem gerekiyor mu?",
       "alumno": "Hôm nay vào ba giờ. Mình phải khai báo không?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Polis",
        "lengua": "estudio"
       },
