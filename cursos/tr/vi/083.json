    {
     "tipo": "explicacion",
     "titulo": "Sự cố",
     "texto": [
      "**kayıp** = mất mát; **çalınmak** = bị trộm; **karakol** = đồn công an.",
      "Để giải thích chuyện gì đã xảy ra, nêu khi nào, ở đâu và thiếu món đồ nào.",
      "**-miş** có thể diễn đạt thông tin vừa phát hiện: **çantam kaybolmuş** = thì ra túi của mình bị mất."
     ],
     "tutora": ""
    }
   ]
  },
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Báo mất đồ",
     "frases": [
      {
       "quien": {
        "texto": "Yolcu",
        "lengua": "estudio"
       },
       "estudio": "Çantam otobüste kaybolmuş. İçinde pasaportum ve cüzdanım vardı.",
       "alumno": "Thì ra túi của mình bị mất trên xe buýt. Bên trong đã nằm hộ chiếu và ví của mình.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Polis",
        "lengua": "estudio"
       },
       "estudio": "En son ne zaman gördünüz?",
       "alumno": "Bạn thấy nó lần cuối khi nào?",
