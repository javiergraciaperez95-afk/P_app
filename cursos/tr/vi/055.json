       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ali",
        "lengua": "estudio"
       },
       "estudio": "Çok isterim. Belki biraz geç gelebilirim.",
       "alumno": "Tôi rất muốn. Biết đâu mình đến hơi muộn một lát.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ece",
        "lengua": "estudio"
       },
       "estudio": "Sorun değil. Hava yağmurlu olabilir.",
