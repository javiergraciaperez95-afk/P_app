       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ali",
        "lengua": "estudio"
       },
       "estudio": "O zaman taksiyle gelirim.",
       "alumno": "Vậy thì mình sẽ đi taxi.",
       "literal": "",
