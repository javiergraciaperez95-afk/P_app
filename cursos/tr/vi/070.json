     "frases": [
      {
       "quien": {
        "texto": "Anna",
        "lengua": "estudio"
       },
       "estudio": "Bu derste en iyi hangi yöntemle öğreniyorsun?",
       "alumno": "Trong lớp này bạn học tốt nhất bằng phương pháp nào?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Can",
        "lengua": "estudio"
       },
       "estudio": "Görselleri kullanarak ve not alarak daha iyi öğreniyorum.",
       "alumno": "Mình học tốt hơn khi dùng hình ảnh và ghi chú.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Anna",
        "lengua": "estudio"
       },
       "estudio": "Projede ne kadar ilerledin?",
       "alumno": "Bạn đã tiến được bao xa trong dự án?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Can",
        "lengua": "estudio"
       },
       "estudio": "Şu ana kadar ilk bölümü bitirdim ama sonuçları açıklamakta zorlanıyorum.",
       "alumno": "Cho đến nay mình đã xong phần đầu, nhưng mình gặp khó khăn khi giải thích kết quả.",
       "literal": "",
       "estructura": "",
       "nota": [],
