     "frases": [
      {
       "quien": {
        "texto": "Anna",
        "lengua": "estudio"
       },
       "estudio": "Şehirde yaşamayı seviyorum çünkü her yere kolayca gidiyorum.",
       "alumno": "Me gusta vivir en la ciudad porque puedo ir fácilmente a todas partes.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ece",
        "lengua": "estudio"
       },
       "estudio": "Ben doğada vakit geçirmeyi tercih ediyorum.",
       "alumno": "Yo prefiero pasar tiempo en la naturaleza.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Anna",
        "lengua": "estudio"
       },
       "estudio": "Yoğun çalışmama rağmen akşamları arkadaşlarımla buluşuyorum.",
       "alumno": "A pesar de trabajar mucho, por las tardes quedo con mis amigos.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ece",
        "lengua": "estudio"
       },
       "estudio": "Hem ailemle hem de arkadaşlarımla vakit geçirmek benim için önemli.",
       "alumno": "Para mí es importante pasar tiempo tanto con mi familia como con mis amigos.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
