     "frases": [
      {
       "quien": {
        "texto": "Ece",
        "lengua": "estudio"
       },
       "estudio": "Yeni bisiklet yolu mahallemiz için iyi bir gelişme.",
       "alumno": "El nuevo carril bici es un avance positivo para nuestro barrio.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Can",
        "lengua": "estudio"
       },
       "estudio": "Katılıyorum, ancak park yerleri azalabilir.",
       "alumno": "Estoy de acuerdo, pero puede que disminuyan las plazas de aparcamiento.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ece",
        "lengua": "estudio"
       },
       "estudio": "Buna rağmen daha az araba kullanmamıza yardımcı olur.",
       "alumno": "A pesar de eso, nos ayudará a usar menos el coche.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Can",
        "lengua": "estudio"
       },
       "estudio": "Önce komşuların görüşlerini alalım, sonra belediyeye öneri gönderelim.",
       "alumno": "Primero recojamos las opiniones de los vecinos y después enviemos una propuesta al municipio.",
       "literal": "",
