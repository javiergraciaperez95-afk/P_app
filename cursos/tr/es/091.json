      },
      {
       "quien": {
        "texto": "Can",
        "lengua": "estudio"
       },
       "estudio": "Çünkü bazı insanlar atıkları suya bırakıyor.",
       "alumno": "Porque algunas personas dejan residuos en el agua.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Deniz",
        "lengua": "estudio"
       },
       "estudio": "Bu nedenle geri dönüşüm kutuları koyalım.",
       "alumno": "Por este motivo, pongamos contenedores de reciclaje.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Can",
        "lengua": "estudio"
       },
       "estudio": "Ayrıca evde su ve enerji tasarrufu yapabiliriz.",
       "alumno": "Además, podemos ahorrar agua y energía en casa.",
       "literal": "",
       "estructura": "",
       "nota": [],
