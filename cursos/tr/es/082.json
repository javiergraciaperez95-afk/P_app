    {
     "tipo": "explicacion",
     "titulo": "Preparar el viaje",
     "texto": [
      "**broşür** = folleto; **giriş ücreti** = precio de entrada; **bütçe** = presupuesto.",
      "**ziyaret etmeye değer** significa «merece la pena visitar».",
      "**-e rağmen** significa «a pesar del»: **yağmura rağmen** = a pesar de la lluvia."
     ],
     "tutora": ""
    }
   ]
