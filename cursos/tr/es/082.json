       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ece",
        "lengua": "estudio"
       },
       "estudio": "Evet, manzarası çok güzel. Giriş ücreti de bütçemize uygun.",
       "alumno": "Sí, el paisaje es muy bonito. El precio de entrada también se ajusta a nuestro presupuesto.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ali",
        "lengua": "estudio"
       },
       "estudio": "Yağmur yağarsa ne yaparız?",
       "alumno": "¿Qué hacemos si llueve?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ece",
        "lengua": "estudio"
       },
       "estudio": "Yağmura rağmen yürüyüş yoluna gidebiliriz; uygun kıyafet seçelim.",
       "alumno": "A pesar de la lluvia, podemos ir a la ruta; elijamos ropa adecuada.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
