    {
     "tipo": "dialogo",
     "titulo": "Conversación entre amigos",
     "frases": [
      {
       "quien": {
        "texto": "Anna",
        "lengua": "estudio"
       },
       "estudio": "Türkiye'de misafirperverlik nasıl gösterilir?",
       "alumno": "¿Cómo se muestra la hospitalidad en Turquía?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Deniz",
        "lengua": "estudio"
       },
       "estudio": "Misafire çay veya kahve ikram etmek yaygındır.",
       "alumno": "Es habitual ofrecer té o café a los invitados.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Anna",
        "lengua": "estudio"
       },
       "estudio": "İspanya'da da misafire bir şey ikram edilir.",
       "alumno": "En España también se ofrece algo a los invitados.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Deniz",
        "lengua": "estudio"
       },
       "estudio": "Gelenekler farklı olabilir; buna karşılık misafire değer vermek ortak bir davranış.",
       "alumno": "Las tradiciones pueden ser distintas; en cambio, valorar al invitado es una conducta compartida.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
