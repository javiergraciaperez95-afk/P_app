     "titulo": "Aviso en la radio",
     "frases": [
      {
       "quien": {
        "texto": "Spiker",
        "lengua": "estudio"
       },
       "estudio": "Ana yolda bir kaza olduğu bildirildi.",
       "alumno": "Se informó de que hubo un accidente en la carretera principal.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Spiker",
        "lengua": "estudio"
       },
       "estudio": "Bu nedenle yolun kapandığı bildirildi.",
       "alumno": "Por este motivo, se informó de que la carretera estaba cerrada.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Spiker",
        "lengua": "estudio"
       },
       "estudio": "Sürücülerin alternatif yolu kullanmaları öneriliyor.",
       "alumno": "Se recomienda a los conductores usar una ruta alternativa.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Spiker",
        "lengua": "estudio"
       },
       "estudio": "Yeni bilgi saat onda verilecek.",
       "alumno": "Se darán nuevas noticias a las diez.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
