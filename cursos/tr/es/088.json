        "texto": "Deniz",
        "lengua": "estudio"
       },
       "estudio": "Ne zaman fark ettin?",
       "alumno": "¿Cuándo te diste cuenta?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ali",
        "lengua": "estudio"
       },
       "estudio": "Otobüs geldiğinde yerde gördüm ve çok telaşlandım.",
       "alumno": "Cuando llegó el autobús, la vi en el suelo y me puse muy nervioso.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Deniz",
        "lengua": "estudio"
       },
       "estudio": "Sonunda ne oldu?",
       "alumno": "¿Qué pasó al final?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ali",
        "lengua": "estudio"
       },
       "estudio": "Bir görevli buldu. Cüzdanımı geri aldım.",
       "alumno": "Un empleado la encontró. Recuperé mi cartera.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
