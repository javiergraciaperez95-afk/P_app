     "titulo": "Una recomendación",
     "frases": [
      {
       "quien": {
        "texto": "Elif",
        "lengua": "estudio"
       },
       "estudio": "Bu ceket sana yakışıyor ama kumaşı biraz kalın.",
       "alumno": "Esta chaqueta te queda bien, pero la tela es un poco gruesa.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Deniz",
        "lengua": "estudio"
       },
       "estudio": "Rahatlık benim için önemli.",
       "alumno": "La comodidad es importante para mí.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Elif",
        "lengua": "estudio"
       },
       "estudio": "Bence daha hafif bir ceket daha iyi olur.",
       "alumno": "En mi opinión, sería mejor una chaqueta más ligera.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Deniz",
        "lengua": "estudio"
       },
       "estudio": "Haklısın, spor kıyafetleri daha çok seviyorum.",
       "alumno": "Tienes razón, me gusta más la ropa deportiva.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
