       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ev sahibi",
        "lengua": "estudio"
       },
       "estudio": "Bir aylık kira kadar. Aidat fiyata dahil değil.",
       "alumno": "El equivalente a un mes de alquiler. Los gastos de comunidad no están incluidos en el precio.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Kiracı",
        "lengua": "estudio"
       },
       "estudio": "Kontratın süresini konuşabilir miyiz?",
       "alumno": "¿Podemos hablar de la duración del contrato?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ev sahibi",
        "lengua": "estudio"
       },
       "estudio": "Elbette, şartları birlikte değerlendirelim.",
       "alumno": "Claro, valoremos juntos las condiciones.",
