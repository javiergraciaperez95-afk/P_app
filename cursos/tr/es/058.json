    {
     "tipo": "dialogo",
     "titulo": "Un consejo",
     "frases": [
      {
       "quien": {
        "texto": "Ece",
        "lengua": "estudio"
       },
       "estudio": "Son zamanlarda çok yorgunum.",
       "alumno": "Últimamente estoy muy cansada.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Anna",
        "lengua": "estudio"
       },
       "estudio": "Daha çok uyuman gerek. Her gün spor yaparsan daha sağlıklı olursun.",
       "alumno": "Necesitas dormir más. Si haces deporte todos los días, estarás más saludable.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ece",
        "lengua": "estudio"
       },
       "estudio": "Haklısın. Daha az kahve içmeliyim.",
       "alumno": "Tienes razón. Debo tomar menos café.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Anna",
        "lengua": "estudio"
       },
       "estudio": "Evet, erken yatarsan daha iyi dinlenirsin.",
       "alumno": "Sí, si te acuestas temprano, descansas mejor.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
