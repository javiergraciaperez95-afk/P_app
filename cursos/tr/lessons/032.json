     "texto": "benden",
     "explicacion": {
      "@es": "Benden significa «que yo».",
      "@en": "Benen means «That I»."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "«Ece benden daha uzun» quiere decir…",
    "@en": "«Ece benden daha uzun» means"
   },
   "id": "tr001-3",
   "opciones": [
    {
     "texto": {
      "@es": "Ece es más alta que yo",
      "@en": "Ece is taller than me."
     },
     "explicacion": {
      "@es": "Benden = que yo; daha uzun = más alta.",
      "@en": "They bless = that I; daha uzun = higher."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Yo soy la más alta",
      "@en": "I'm the tallest."
     },
     "explicacion": {
