 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Rasgos personales",
    "@en": "Personal features"
   },
   "texto": [
    {
     "@es": "**kişilik** significa «personalidad». Puedes describir a alguien con adjetivos: **sakin** (tranquilo/a), **neşeli** (alegre) o **dürüst** (honesto/a).",
     "@en": "**kişilik** means «personalidad». You can describe someone with adjectives: **sakin** (quiet), **neşeli** (cheerful) or **dürüst** (honest)."
    },
    {
     "@es": "Para comparar usa **daha** («más») y para destacar, **en** («el/la más»): **Ece benden daha uzun** = Ece es más alta que yo.",
     "@en": "To compare use **daha** («more») and to highlight, **en** («the / the most»): **Ece benden daha uzun** = Ece is higher than me."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": {
    "@es": "Personalidad y aspecto",
    "@en": "Personality and appearance"
   },
   "palabras": [
    "kişilik",
    "sakin",
    "neşeli",
    "dürüst",
    "çalışkan",
    "uzun",
    "kısa",
    "daha",
    "en",
    "benden"
   ]
  },
  {
   "tipo": "dialogo",
   "titulo": {
    "@es": "Dos amigos",
    "@en": "Two friends"
   },
   "frases": [
    {
     "quien": "Anna",
     "tr": "Arkadaşım çok neşeli.",
     "es": "Mi amiga es muy alegre.",
     "en": "My friend is very happy."
    },
    {
     "quien": "Ali",
     "tr": "Ben de neşeliyim ama daha sakinim.",
     "es": "Yo también soy alegre, pero soy más tranquilo.",
     "en": "I'm happy too, but I'm quieter."
    },
    {
     "quien": "Anna",
     "tr": "Ece senden daha uzun mu?",
     "es": "¿Ece es más alta que tú?",
     "en": "Is Ece taller than you?"
    },
    {
     "quien": "Ali",
     "tr": "Evet, Ece en uzun arkadaşımız.",
     "es": "Sí, Ece es nuestra amiga más alta.",
     "en": "Yeah, Ece's our tallest friend."
    }
   ]
  },
  {
