      "@en": "That idea would be different."
     }
    },
    {
     "texto": {
      "@es": "Ece es mi amiga tranquila",
      "@en": "Ece is my quiet friend."
     },
     "explicacion": {
      "@es": "No aparece sakin.",
      "@en": "No sakin."
     }
    }
   ]
  },
  {
