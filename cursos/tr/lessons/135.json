{
 "capitulo": 2,
 "titulo_tr": "Çoğul ve miktar",
 "titulo_es": {
  "@es": "Plural y cantidad",
  "@en": "Plural and quantity"
 },
 "palabras": {
  "Evde kaç sandalye var": {
   "es": "¿cuántas sillas hay en casa?",
   "en": "How many chairs are there at home?",
   "oculta": true
  },
  "Üç sandalye var": {
   "es": "hay tres sillas",
   "en": "There are three chairs.",
   "oculta": true
  },
  "Kitaplar nerede": {
   "es": "¿dónde están los libros?",
   "en": "Where are the books?",
   "oculta": true
  },
  "Evde masada": {
   "es": "en casa sobre la mesa",
   "en": "at home on the table",
   "oculta": true
  }
 },
 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "El plural",
    "@en": "The plural"
   },
   "texto": [
    {
     "@es": "Añade **-lar/-ler** según la última vocal: **kitaplar**, **evler**.",
     "@en": "Add **-lar/-ler** according to the last vocal: **kitaplar**, **evler**."
    },
    {
     "@es": "Después de un número, el nombre permanece singular: **iki kitap**, **üç ev**.",
     "@en": "After a number, the name remains singular: **iki kitap**, **üç ev**."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": {
    "@es": "Objetos y cantidades",
    "@en": "Objects and quantities"
   },
   "palabras": []
  },
  {
   "tipo": "dialogo",
   "titulo": "Evde",
   "frases": [
    {
     "quien": "Deniz",
     "tr": "Evde kaç sandalye var?",
     "es": "¿Cuántas sillas hay en casa?",
     "en": "How many chairs are there at home?"
    },
    {
     "quien": "Baran",
     "tr": "Üç sandalye var.",
     "es": "Hay tres sillas.",
     "en": "There are three chairs."
    },
    {
     "quien": "Deniz",
     "tr": "Kitaplar nerede?",
     "es": "¿Dónde están los libros?",
     "en": "Where are the books?"
    },
    {
     "quien": "Baran",
     "tr": "Evde, masada.",
     "es": "En casa, sobre la mesa.",
     "en": "At home, on the table."
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué forma significa «libros»?",
    "@en": "What way does «books» mean?"
   },
   "id": "tr040-1",
   "opciones": [
    {
     "texto": "kitaplar",
     "explicacion": {
      "@es": "-lar marca el plural tras la vocal a.",
      "@en": "-to mark the plural after the vowel to."
     },
     "correcta": true
    },
    {
     "texto": "kitap",
     "explicacion": {
      "@es": "Es singular.",
      "@en": "It's singular."
     }
    },
    {
     "texto": "kitapler",
     "explicacion": {
      "@es": "No sigue la armonía vocálica.",
      "@en": "It doesn't follow the vocal harmony."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Cómo se dice «tres casas»?",
    "@en": "How do you say «three houses»?"
   },
   "id": "tr040-2",
   "opciones": [
    {
     "texto": "üç ev",
     "explicacion": {
      "@es": "Tras un número, ev no lleva plural.",
      "@en": "After a number, ev does not carry plural."
     },
     "correcta": true
    },
    {
     "texto": "üç evler",
     "explicacion": {
      "@es": "El nombre suele quedarse en singular tras el número.",
      "@en": "The name usually stays in singular after the number."
     }
    },
    {
     "texto": "üç evin",
     "explicacion": {
      "@es": "Esa forma significa «de tres casas» en otro contexto.",
      "@en": "That form means «of three houses» in another context."
     }
    }
   ]
  },
  {
   "tipo": "traduccion",
   "pregunta": {
    "@es": "Traduce.",
    "@en": "Translate."
   },
   "frase": "Üç sandalye var.",
   "id": "tr040-3",
   "opciones": [
    {
     "texto": {
      "@es": "Hay tres sillas.",
      "@en": "There are three chairs."
     },
     "explicacion": {
      "@es": "Var indica que existen.",
      "@en": "Var indicates they exist."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "No hay sillas.",
      "@en": "There are no chairs."
     },
     "explicacion": {
      "@es": "Yok sería «no hay».",
      "@en": "Yok would be «No.»."
     }
    },
    {
     "texto": {
      "@es": "¿Dónde están las sillas?",
      "@en": "Where are the chairs?"
     },
     "explicacion": {
      "@es": "Es una pregunta diferente.",
      "@en": "It's a different question."
     }
    }
   ]
  },
  {
   "tipo": "huecos",
   "pregunta": {
    "@es": "Completa «hay dos libros».",
    "@en": "Complete «There are two books.»."
   },
   "frase": "İki ___ var.",
   "id": "tr040-4",
   "opciones": [
    {
     "texto": "kitap",
     "explicacion": {
      "@es": "Tras iki, el nombre está en singular.",
      "@en": "After iki, the name is in singular."
     },
     "correcta": true
    },
    {
     "texto": "kitaplar",
     "explicacion": {
      "@es": "No se añade plural tras el número.",
      "@en": "Not added plural after number."
     }
    },
    {
     "texto": "evler",
     "explicacion": {
      "@es": "Cambia el objeto.",
      "@en": "Change the object."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué pregunta?",
    "@en": "What question?"
   },
   "audio": "Kitaplar nerede?",
   "id": "tr040-5",
   "opciones": [
    {
     "texto": {
      "@es": "Dónde están los libros.",
      "@en": "Where are the books."
     },
     "explicacion": {
      "@es": "Nerede significa dónde.",
      "@en": "Nerede means where."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Cuántos libros hay.",
      "@en": "How many books there are."
     },
     "explicacion": {
      "@es": "Kaç kitap pregunta cuántos.",
      "@en": "Kaç kitap asks how many."
     }
    },
    {
     "texto": {
      "@es": "Si hay una mesa.",
      "@en": "If there's a table."
     },
     "explicacion": {
      "@es": "No se pregunta por masa.",
      "@en": "You don't ask by mass."
     }
    }
   ]
  },
  {
   "tipo": "ordenar",
   "pregunta": {
    "@es": "Ordena las palabras.",
    "@en": "Order the words."
   },
   "frase": "İki kitap var",
   "traduccion": {
    "@es": "Hay dos libros.",
    "@en": "There are two books."
   },
   "explicacion": {
    "@es": "El sustantivo queda en singular después del número.",
    "@en": "The noun is left in singular after the number."
   },
   "id": "tr040-6"
  },
  {
   "tipo": "escribir",
   "pregunta": {
    "@es": "Escribe «tres casas».",
    "@en": "Write «three houses»."
   },
   "respuestas": [
    "üç ev"
   ],
   "explicacion": {
    "@es": "No añadas el sufijo plural.",
    "@en": "Do not add the plural suffix."
   },
   "id": "tr040-7"
  }
 ],
 "intro": {
  "@es": "Usa **-lar/-ler** para hablar de varios objetos y mantén el nombre en singular después de un número.",
  "@en": "Use **-lar/-ler** to talk about several objects and keep the name in singular after a number."
 }
}