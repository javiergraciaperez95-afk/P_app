     "correcta": true
    },
    {
     "texto": {
      "@es": "Con el señor Güneş",
      "@en": "With Mr. Güneş"
     },
     "explicacion": {
      "@es": "Güneş es el nombre de la oficina.",
      "@en": "Güneş is the name of the office."
     }
    },
    {
     "texto": {
      "@es": "Con su secretaria",
      "@en": "With his secretary"
     },
     "explicacion": {
      "@es": "Habla con la secretaria.",
      "@en": "Talk to the secretary."
     }
    }
   ]
  },
  {
