 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Llamadas",
    "@en": "Calls"
   },
   "texto": [
    {
     "@es": "**alo** = diga; **kiminle görüşüyorum?** = ¿con quién hablo?; **mesaj bırakmak** = dejar un mensaje.",
     "@en": "**alo** = say; **kiminle görüşüyorum?** = who am I talking to?; **mesaj bırakmak** = leave a message."
    },
    {
     "@es": "**-ebilir misiniz?** permite pedir algo con cortesía: **bekleyebilir misiniz?** = ¿puede esperar?",
     "@en": "**-ebilir misiniz?** allows you to order something with courtesy: **bekleyebilir misiniz?** = can you wait?"
    },
    {
     "@es": "**lütfen** suaviza una petición.",
     "@en": "**lütfen** softens a request."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": {
    "@es": "Al teléfono",
    "@en": "On the phone."
   },
   "palabras": [
    "alo",
    "görüşmek",
    "kiminle",
    "mesaj bırakmak",
    "beklemek",
    "bekleyebilir misiniz",
    "aramak"
   ]
  },
  {
   "tipo": "dialogo",
   "titulo": {
    "@es": "Una llamada a la oficina",
    "@en": "A call to the office"
   },
   "frases": [
    {
     "quien": "Sekreter",
     "tr": "Alo, Güneş Ofisi. Kiminle görüşüyorum?",
     "es": "Diga, oficina Güneş. ¿Con quién hablo?",
     "en": "Hello, office Güneş. Who am I talking to?"
    },
    {
     "quien": "Deniz",
     "tr": "Ben Deniz. Ayşe Hanım'la görüşebilir miyim?",
     "es": "Soy Deniz. ¿Puedo hablar con la señora Ayşe?",
     "en": "I'm Deniz. May I speak to Mrs. Ayşe?"
    },
    {
     "quien": "Sekreter",
     "tr": "Şu anda müsait değil. Mesaj bırakmak ister misiniz?",
     "es": "Ahora mismo no está disponible. ¿Quiere dejar un mensaje?",
     "en": "It's not available right now. You want to leave a message?"
    },
    {
     "quien": "Deniz",
     "tr": "Evet, lütfen beni arasın.",
     "es": "Sí, por favor, que me llame.",
     "en": "Yes, please call me."
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué significa «alo»?",
    "@en": "What does «alo» mean?"
   },
   "id": "tr018-1",
   "opciones": [
    {
     "texto": {
      "@es": "diga (al teléfono)",
      "@en": "say (on the phone)"
     },
     "explicacion": {
      "@es": "Alo es una fórmula para contestar el teléfono.",
      "@en": "Alo is a formula for answering the phone."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "hola, adiós",
      "@en": "Hi, bye."
     },
     "explicacion": {
      "@es": "No se usa para despedirse.",
      "@en": "It's not used to say goodbye."
     }
    },
    {
     "texto": {
      "@es": "esperar",
      "@en": "wait"
     },
     "explicacion": {
      "@es": "Esperar es beklemek.",
      "@en": "Waiting is beklemek."
     }
    }
   ]
  },
  {
