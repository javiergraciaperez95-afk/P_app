   "titulo": {
    "@es": "En la estación",
    "@en": "At the station"
   },
   "frases": [
    {
     "quien": "Ali",
     "tr": "İstanbul'a nasıl gideceksin?",
     "es": "¿Cómo irás a Estambul?",
     "en": "How are you going to Istanbul?"
    },
    {
     "quien": "Deniz",
     "tr": "Trenle gideceğim. Biletimi aldım.",
     "es": "Iré en tren. Ya compré mi billete.",
     "en": "I'll go by train. I already bought my ticket."
    },
    {
     "quien": "Ali",
     "tr": "Kaç günlüğüne kalacaksın?",
     "es": "¿Por cuántos días te quedarás?",
     "en": "How many days are you staying for?"
    },
    {
     "quien": "Deniz",
     "tr": "Hafta sonu için. Pazar günü döneceğim.",
     "es": "Para el fin de semana. Volveré el domingo.",
     "en": "For the weekend. I'll be back on Sunday."
    }
   ]
  },
