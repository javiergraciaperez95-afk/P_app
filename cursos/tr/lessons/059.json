 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Viajes",
    "@en": "Travel"
   },
   "texto": [
    {
     "@es": "**seyahat** = viaje; **tren** = tren; **uçak** = avión; **otobüs** = autobús.",
     "@en": "**seyahat** = trip; **tren** = train; **uçak** = plane; **otobüs** = bus."
    },
    {
     "@es": "**-le/-la** puede significar «con/en»: **trenle** = en tren.",
     "@en": "**-le/-la** can mean «with / in»: **trenle** = by train."
    },
    {
     "@es": "**kaç günlüğüne?** pregunta «¿por cuántos días?».",
     "@en": "**kaç günlüğüne?** asks «How many days?»."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": {
    "@es": "Preparar el viaje",
    "@en": "Prepare the trip"
