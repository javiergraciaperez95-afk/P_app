     "quien": "Anna",
     "tr": "İki oda var ve bir balkon var.",
     "es": "Hay dos habitaciones y un balcón.",
     "en": "There are two rooms and a balcony."
    },
    {
     "quien": "Ece",
     "tr": "Park mahallemize yakın mı?",
     "es": "¿El parque está cerca de nuestro barrio?",
     "en": "Is the park near our neighborhood?"
    },
    {
     "quien": "Anna",
     "tr": "Evet, çok yakın.",
     "es": "Sí, muy cerca.",
     "en": "Yes, very close."
    }
   ]
  },
