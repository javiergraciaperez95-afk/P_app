  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué significa «dün»?",
    "@en": "What does «dün» mean?"
   },
   "id": "tr027-1",
   "opciones": [
    {
     "texto": {
      "@es": "ayer",
      "@en": "Yesterday"
     },
     "explicacion": {
      "@es": "Dün = ayer.",
      "@en": "Dün = yesterday."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "mañana",
      "@en": "tomorrow"
     },
     "explicacion": {
      "@es": "Yarın = mañana.",
      "@en": "Yarın = tomorrow."
     }
    },
    {
     "texto": {
      "@es": "la semana pasada",
      "@en": "Last week"
     },
     "explicacion": {
      "@es": "Geçen hafta = la semana pasada.",
      "@en": "Geçen hafta = last week."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué terminación ves en «gittim»?",
    "@en": "What termination do you see in «gittim»?"
   },
   "id": "tr027-2",
   "opciones": [
    {
     "texto": "-ti + -m",
     "explicacion": {
      "@es": "La t aparece tras la consonante sorda t; -m marca «yo».",
      "@en": "The t appears after the deaf consonant t; -m marks «I»."
     },
     "correcta": true
    },
    {
     "texto": "-di + -n",
     "explicacion": {
      "@es": "Esa forma sería gittin, «fuiste».",
      "@en": "That way would be gittin, «You were»."
     }
    },
    {
     "texto": "-yor + -um",
     "explicacion": {
      "@es": "Eso forma el presente continuo.",
      "@en": "That forms the continuous present."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "«Ne yaptın?» pregunta…",
    "@en": "«Ne yaptın?» question"
   },
   "id": "tr027-3",
   "opciones": [
    {
     "texto": {
      "@es": "¿Qué hiciste?",
      "@en": "What did you do?"
     },
     "explicacion": {
      "@es": "Yaptın es pasado de «tú».",
