     "correcta": true
    },
    {
     "texto": {
      "@es": "¿Qué haces?",
      "@en": "What are you doing?"
     },
     "explicacion": {
      "@es": "Ne yapıyorsun es presente.",
      "@en": "Ne yapıyorsun is present."
     }
    },
    {
     "texto": {
      "@es": "¿Qué quieres hacer?",
      "@en": "What do you want to do?"
     },
     "explicacion": "Ne yapmak istiyorsun."
    }
   ]
  },
