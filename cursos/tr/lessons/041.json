   },
   "texto": [
    {
     "@es": "**hobi** = afición; **fotoğraf çekmek** = hacer fotos; **müzik dinlemek** = escuchar música.",
     "@en": "**hobi** = hobby; **fotoğraf çekmek** = photo making; **müzik dinlemek** = listening to music."
    },
    {
     "@es": "Para decir «me gusta», usa **-mayı/-meyi seviyorum**: **yüzmeyi seviyorum** = me gusta nadar.",
     "@en": "To say «I like it.», use **-mayı/-meyi seviyorum**: **yüzmeyi seviyorum** = I like to swim."
    },
    {
     "@es": "**boş vaktimde** significa «en mi tiempo libre».",
     "@en": "**boş vaktimde** means «in my free time»."
    }
   ]
  },
