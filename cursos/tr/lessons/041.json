     "tr": "Fotoğraf çekmeyi ve müzik dinlemeyi severim.",
     "es": "Me gusta hacer fotos y escuchar música.",
     "en": "I like to take pictures and listen to music."
    },
    {
     "quien": "Ece",
     "tr": "Yüzmeyi sever misin?",
     "es": "¿Te gusta nadar?",
     "en": "Do you like to swim?"
    },
    {
     "quien": "Anna",
     "tr": "Evet, ama dans etmeyi daha çok seviyorum.",
     "es": "Sí, pero me gusta más bailar.",
     "en": "Yeah, but I like to dance better."
    }
   ]
