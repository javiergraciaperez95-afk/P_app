    {
     "texto": {
      "@es": "información; mostrador de información",
      "@en": "information; information desk"
     },
     "explicacion": {
      "@es": "Danışma es un lugar donde se pide información.",
      "@en": "Danışma is a place where information is requested."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "taquilla",
      "@en": "box office"
     },
     "explicacion": "Bilet gişesi."
    },
    {
     "texto": "hotel",
     "explicacion": "Otel."
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
