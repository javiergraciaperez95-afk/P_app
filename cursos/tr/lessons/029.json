 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Necesitar y tener que",
    "@en": "Need and have to"
   },
   "texto": [
    {
     "@es": "**İhtiyacım var** = lo necesito (literalmente, tengo necesidad). **Suya ihtiyacım var** = necesito agua.",
     "@en": "**İhtiyacım var** = I need it (literally, I need it). **Suya ihtiyacım var** = I need water."
    },
    {
     "@es": "**-malı/-meli** expresa obligación o consejo: **dinlenmelisin** = deberías descansar; **su içmelisin** = deberías beber agua.",
     "@en": "**-malı/-meli** expresses obligation or advice: **dinlenmelisin** = should rest; **su içmelisin** = should drink water."
    },
    {
     "@es": "**Lazım** significa necesario: **ilaç lazım** = hace falta medicina.",
     "@en": "**Lazım** means necessary: **ilaç lazım** = medicine is needed."
    }
   ]
  },
