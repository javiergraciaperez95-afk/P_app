   },
   "frases": [
    {
     "tr": "Geçen ay İstanbul'a gittim.",
     "es": "El mes pasado fui a Estambul.",
     "en": "I went to Istanbul last month."
    },
    {
     "tr": "Şehir çok güzeldi çünkü eski binaları gezdim.",
     "es": "La ciudad era muy bonita porque visité edificios antiguos.",
     "en": "The city was very pretty because I visited old buildings."
    },
    {
     "tr": "Gelecek hafta ailemle Ankara'ya gideceğim.",
     "es": "La semana que viene iré a Ankara con mi familia.",
     "en": "I'm going to Ankara next week with my family."
    },
    {
     "tr": "Otelde iki kişilik oda ayırttım.",
     "es": "Reservé una habitación doble en el hotel.",
     "en": "I booked a double room at the hotel."
    },
    {
     "tr": "Yolculuk sırasında yardım gerekirse danışmaya soracağım.",
     "es": "Si necesito ayuda durante el viaje, preguntaré en información.",
     "en": "If I need help during the trip, I'll ask for information."
    }
   ]
