       }
      ]
     ]
    },
    {
     "quien": "Ece",
     "tr": "Günaydın. Nasılsın?",
     "es": "Buenos días. ¿Cómo estás?",
     "en": "Good morning. How are you?",
     "analisis": [
      [
       "Nasılsın",
       {
        "@es": "cómo estás (tú)",
        "@en": "How are you (you)"
       }
      ]
     ]
    },
    {
     "quien": "Anna",
     "tr": "İyiyim, teşekkürler.",
     "es": "Estoy bien, gracias.",
