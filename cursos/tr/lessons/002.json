{
 "capitulo": 1,
 "titulo_tr": "Merhaba!",
 "titulo_es": {
  "@es": "Saludos y cortesía",
  "@en": "Greetings and courtesy"
 },
 "palabras": {
  "günaydın": {
   "es": "buenos días",
   "en": "Good morning.",
   "pron": "gü-nay-DUHN"
  },
  "iyi akşamlar": {
   "es": "buenas tardes/noches (al llegar)",
   "en": "good evening / nights (when you arrive)",
   "pron": "i-YI ak-SHAM-lar"
  },
  "iyi geceler": {
   "es": "buenas noches (al despedirse)",
   "en": "good night (when you say goodbye)",
   "pron": "i-YI ge-je-LER"
  },
  "hoşça kal": {
   "es": "adiós (lo dice quien se marcha)",
   "en": "good-bye (says who leaves)",
   "pron": "hosh-cha KAL"
  },
  "güle güle": {
   "es": "adiós (a quien se marcha)",
   "en": "good-bye (to whom he leaves)",
   "pron": "gü-LE gü-LE"
  },
  "nasılsın": {
   "es": "¿cómo estás? (tú)",
   "en": "How are you? (you)",
   "pron": "na-suhl-SUHN"
  },
  "nasılsınız": {
   "es": "¿cómo está? (usted), ¿cómo están?",
   "en": "How are you? (you), how are you?",
   "pron": "na-suhl-suh-NUHZ"
  },
  "iyiyim": {
   "es": "estoy bien",
   "en": "I'm fine.",
   "pron": "i-yi-YIM"
  },
  "İyiyim": {
   "es": "estoy bien",
   "en": "I'm fine.",
   "pron": "i-yi-YIM",
   "oculta": true
  },
  "fena": {
   "es": "mal",
   "en": "wrong",
   "pron": "fe-NA"
  },
  "değil": {
   "es": "no, no es",
   "en": "No, it's not.",
   "pron": "de-YIL"
  },
  "rica ederim": {
   "es": "de nada",
   "en": "You're welcome.",
   "pron": "ri-ja e-de-RIM"
  },
  "görüşürüz": {
   "es": "nos vemos",
   "en": "See you.",
   "pron": "gö-rü-shü-RÜZ"
  },
  "memnun": {
   "es": "contento",
   "en": "Happy.",
   "pron": "mem-NUN"
  },
  "ben": {
   "es": "yo",
   "en": "I",
   "pron": "ben"
  },
  "de": {
   "es": "también",
   "en": "too",
   "pron": "de"
  }
 },
 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Saludar y despedirse",
    "@en": "Greeting and saying goodbye"
   },
   "texto": [
    {
     "@es": "**Merhaba** sirve a cualquier hora. **Günaydın** es buenos días; **iyi akşamlar**, buenas tardes/noches al llegar.",
     "@en": "**Merhaba** serves at any time. **Günaydın** is good morning; **iyi akşamlar**, good evening / night when you arrive."
    },
    {
     "@es": "Para despedirte, quien se marcha dice **hoşça kal** a la persona que se queda; quien se queda responde **güle güle** a quien se marcha.",
     "@en": "To say goodbye, who leaves says **hoşça kal** to the person who stays; who stays responds **güle güle** to the person who leaves."
    },
    {
     "@es": "**Lütfen** significa «por favor» y **teşekkürler**, «gracias».",
     "@en": "**Lütfen** means «Please.» and **teşekkürler**, «Thank you.»."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Preguntar qué tal",
    "@en": "Ask what's up?"
   },
   "texto": [
    {
     "@es": "**Nasılsın?** es informal, para una persona. Se contesta **İyiyim** (estoy bien) o **İyiyim, teşekkürler** (bien, gracias).",
     "@en": "**Nasılsın?** is informal, for one person. You answer **İyiyim** (I'm fine) or **İyiyim, teşekkürler** (well, thank you)."
    },
    {
     "@es": "**Nasılsınız?** es la forma cortés o plural. La terminación **-sınız** marca el trato formal/plural.",
     "@en": "**Nasılsınız?** is the courteous or plural form. The **-sınız** termination marks the formal / plural treatment."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": {
    "@es": "Saludos y respuestas",
    "@en": "Greetings and answers"
   },
   "palabras": [
    "günaydın",
    "iyi akşamlar",
    "iyi geceler",
    "hoşça kal",
    "güle güle",
    "nasılsın",
    "nasılsınız",
    "iyiyim",
    "fena",
    "değil",
    "rica ederim",
    "görüşürüz",
    "memnun",
    "ben",
    "de"
   ]
  },
