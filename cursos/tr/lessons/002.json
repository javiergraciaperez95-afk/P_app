    {
     "quien": "Ece",
     "tr": "Ben de iyiyim.",
     "es": "Yo también estoy bien.",
     "en": "I'm fine, too.",
     "analisis": [
      [
       "Ben",
       {
        "@es": "yo",
        "@en": "I"
       }
      ],
      [
       "de",
       {
        "@es": "también",
        "@en": "too"
       }
      ],
      [
       "iyiyim",
       {
        "@es": "estoy bien",
        "@en": "I'm fine."
       }
      ]
     ]
    },
    {
     "quien": "Anna",
     "tr": "Görüşürüz! Hoşça kal!",
     "es": "¡Nos vemos! ¡Adiós!",
     "en": "See you! Bye!",
     "analisis": [
      [
       "Görüşürüz",
       {
        "@es": "nos vemos",
        "@en": "See you."
       }
      ],
      [
       "Hoşça kal",
       {
        "@es": "adiós",
        "@en": "Bye."
       }
      ]
     ]
    },
    {
     "quien": "Ece",
     "tr": "Güle güle!",
     "es": "¡Adiós! (a quien se marcha)",
     "en": "Good-bye! (to whom he goes)",
     "analisis": [
      [
       "Güle güle",
       {
        "@es": "despedida a quien se marcha",
        "@en": "I say goodbye to the one who goes away."
       }
      ]
     ]
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué saludo usarías por la mañana?",
    "@en": "What would you use in the morning?"
   },
   "id": "tr002-1",
   "opciones": [
    {
     "texto": "Günaydın",
     "explicacion": {
      "@es": "Significa «buenos días».",
      "@en": "It means «Good morning.»."
     },
     "correcta": true
    },
    {
     "texto": "İyi geceler",
     "explicacion": {
      "@es": "Se usa al despedirse por la noche.",
      "@en": "It's used when you say goodbye at night."
     }
    },
    {
     "texto": "Görüşürüz",
     "explicacion": {
      "@es": "Significa «nos vemos».",
      "@en": "It means «See you.»."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Cómo preguntas «¿cómo estás?» a un amigo?",
    "@en": "How do you ask «How are you?» to a friend?"
   },
   "id": "tr002-2",
   "opciones": [
    {
     "texto": "Nasılsın?",
     "explicacion": {
      "@es": "La forma informal singular termina en -sın.",
      "@en": "The informal form singular ends in -sın."
     },
     "correcta": true
    },
    {
     "texto": "Nasılsınız?",
     "explicacion": {
      "@es": "Es formal o plural.",
      "@en": "It's formal or plural."
     }
    },
    {
     "texto": "İyiyim.",
     "explicacion": {
      "@es": "Es una respuesta: «estoy bien».",
      "@en": "It's an answer: «I'm fine.»."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué significa «teşekkürler»?",
    "@en": "What does «teşekkürler» mean?"
   },
   "id": "tr002-3",
   "opciones": [
    {
     "texto": {
      "@es": "Gracias",
      "@en": "Thank you."
     },
     "explicacion": {
      "@es": "Es la fórmula habitual de agradecimiento.",
      "@en": "It's the usual formula of thanks."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Por favor",
      "@en": "Please."
     },
     "explicacion": {
      "@es": "Eso es lütfen.",
      "@en": "That's lütfen."
     }
    },
    {
     "texto": {
      "@es": "De nada",
      "@en": "You're welcome."
     },
     "explicacion": {
      "@es": "Eso es rica ederim.",
      "@en": "That's rich ederim."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿A quién dices «güle güle»?",
    "@en": "Who are you saying «güle güle» to?"
   },
   "id": "tr002-4",
   "opciones": [
    {
     "texto": {
      "@es": "A quien se marcha",
      "@en": "Who's going away?"
     },
     "explicacion": {
      "@es": "La dice quien se queda al despedirse.",
      "@en": "Says who stays when he says goodbye."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "A quien llega",
      "@en": "To whom it comes"
     },
     "explicacion": {
      "@es": "Para saludar puedes decir merhaba.",
      "@en": "To say hello, you can say merhaba."
     }
    },
    {
     "texto": {
      "@es": "A quien da las gracias",
      "@en": "To whom he is grateful"
     },
     "explicacion": {
      "@es": "De nada es rica ederim.",
      "@en": "It's not a good thing."
     }
    }
   ]
  },
  {
   "tipo": "traduccion",
   "pregunta": {
    "@es": "¿Qué significa?",
    "@en": "What does that mean?"
   },
   "frase": "İyiyim, teşekkürler.",
   "id": "tr002-5",
   "opciones": [
    {
     "texto": {
      "@es": "Estoy bien, gracias.",
      "@en": "I'm fine, thank you."
     },
     "explicacion": {
      "@es": "İyiyim = estoy bien.",
      "@en": "İyiyim = I'm fine."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Estoy mal, por favor.",
      "@en": "I'm wrong, please."
     },
     "explicacion": {
      "@es": "No dice fena.",
      "@en": "It doesn't say fena."
     }
    },
    {
     "texto": {
      "@es": "Adiós, nos vemos.",
      "@en": "Bye, see you."
     },
     "explicacion": {
      "@es": "No es una despedida.",
      "@en": "It's not a goodbye."
     }
    }
   ]
  },
