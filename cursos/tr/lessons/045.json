   "tipo": "explicacion",
   "titulo": {
    "@es": "Pagar y pedir",
    "@en": "Pay and order"
   },
   "texto": [
    {
     "@es": "**fiş** = recibo; **nakit** = efectivo; **kredi kartı** = tarjeta de crédito.",
     "@en": "**fiş** = receipt; **nakit** = cash; **kredi kartı** = credit card."
    },
    {
     "@es": "**Kaç tane?** pregunta «¿cuántos/cuántas?».",
     "@en": "**Kaç tane?** asks «How many / how many?»."
    },
    {
     "@es": "**alabilir miyim?** es una petición cortés: «¿puedo comprar/tomar?».",
     "@en": "**alabilir miyim?** is a polite request: «Can I buy / drink?»."
    }
   ]
  },
