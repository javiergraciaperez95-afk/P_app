 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Invitar",
    "@en": "Invite"
   },
   "texto": [
    {
     "@es": "**İster misin?** = ¿quieres?; **birlikte** = juntos; **tabii** = claro.",
     "@en": "**İster misin?** = will you?; **birlikte** = together; **tabii** = clear."
    },
    {
     "@es": "El patrón **-maya/-meye ne dersin?** sugiere una actividad: **sinemaya gitmeye ne dersin?** = ¿qué te parece ir al cine?",
     "@en": "The **-maya/-meye ne dersin?** pattern suggests an activity: **sinemaya gitmeye ne dersin?** = how about going to the movies?"
    },
    {
     "@es": "Una respuesta amable puede empezar con **Memnuniyetle** («con mucho gusto») o **Üzgünüm** («lo siento»).",
     "@en": "A friendly response can start with **Memnuniyetle** («With pleasure.») or **Üzgünüm** («I'm sorry»)."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": {
    "@es": "Proponer una actividad",
    "@en": "Propose an activity"
   },
   "palabras": [
    "tabii",
    "memnuniyetle",
    "gitmeye ne dersin"
   ]
  },
  {
   "tipo": "dialogo",
   "titulo": {
    "@es": "Invitación",
    "@en": "Invitation"
   },
   "frases": [
    {
     "quien": "Ali",
     "tr": "Yarın birlikte sinemaya gitmeye ne dersin?",
     "es": "¿Qué te parece si mañana vamos juntos al cine?",
     "en": "What do you say we go to the movies together tomorrow?"
    },
    {
     "quien": "Ece",
     "tr": "Memnuniyetle! Saat kaçta?",
     "es": "¡Con mucho gusto! ¿A qué hora?",
     "en": "With pleasure! What time?"
    },
    {
     "quien": "Ali",
     "tr": "Saat yedide. Gelebilir misin?",
     "es": "A las siete. ¿Puedes venir?",
     "en": "At 7: 00. Can you come?"
    },
    {
     "quien": "Ece",
     "tr": "Tabii, görüşürüz.",
     "es": "Claro, nos vemos.",
     "en": "Sure, I'll see you."
    }
   ]
  },
  {
   "tipo": "test",
