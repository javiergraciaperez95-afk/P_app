   },
   "texto": [
    {
     "@es": "**Otel** = hotel; **oda** = habitación; **rezervasyon** = reserva. **Bir oda istiyorum** = quiero una habitación.",
     "@en": "**Otel** = hotel; **oda** = room; **rezervasyon** = booking. **Bir oda istiyorum** = I want a room."
    },
    {
     "@es": "**Tek kişilik oda** = habitación individual; **iki kişilik oda** = habitación doble. **Kahvaltı dahil mi?** = ¿está incluido el desayuno?",
     "@en": "**Tek kişilik oda** = single room; **iki kişilik oda** = double room. **Kahvaltı dahil mi?** = is breakfast included?"
    },
    {
     "@es": "**Giriş** es entrada/check-in y **çıkış** es salida/check-out.",
     "@en": "**Giriş** is input / check-in and **çıkış** is output / check-out."
    }
   ]
