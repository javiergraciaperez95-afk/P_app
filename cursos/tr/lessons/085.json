  {
   "tipo": "dialogo",
   "titulo": {
    "@es": "Conversación entre amigos",
    "@en": "Conversation between friends"
   },
   "frases": [
    {
     "quien": "Anna",
     "tr": "Türkiye'de misafirperverlik nasıl gösterilir?",
     "es": "¿Cómo se muestra la hospitalidad en Turquía?",
     "en": "How is hospitality shown in Turkey?"
    },
    {
     "quien": "Deniz",
     "tr": "Misafire çay veya kahve ikram etmek yaygındır.",
     "es": "Es habitual ofrecer té o café a los invitados.",
     "en": "It is common to offer tea or coffee to guests."
    },
    {
     "quien": "Anna",
     "tr": "İspanya'da da misafire bir şey ikram edilir.",
     "es": "En España también se ofrece algo a los invitados.",
     "en": "In Spain, something is also offered to guests."
    },
    {
     "quien": "Deniz",
     "tr": "Gelenekler farklı olabilir; buna karşılık misafire değer vermek ortak bir davranış.",
     "es": "Las tradiciones pueden ser distintas; en cambio, valorar al invitado es una conducta compartida.",
     "en": "Traditions may be different; instead, to value the guest is a shared conduct."
    }
   ]
  },
