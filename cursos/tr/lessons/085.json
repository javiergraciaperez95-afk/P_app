 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Tradiciones",
    "@en": "Traditions"
   },
   "texto": [
    {
     "@es": "**gelenek** = tradición; **adet** = costumbre; **sofra adabı** = modales en la mesa.",
     "@en": "**gelenek** = tradition; **adet** = custom; **sofra adabı** = manners on the table."
    },
    {
     "@es": "Para comparar, usa **-e göre** («según») y **buna karşılık** («en cambio»).",
     "@en": "To compare, use **-e göre** («according to») and **buna karşılık** («in contrast»)."
    },
    {
     "@es": "Habla de las costumbres con curiosidad y evita generalizar sobre todas las personas de un país.",
     "@en": "He speaks of customs with curiosity and avoids generalizing over all people in a country."
    }
   ]
  },
  {
