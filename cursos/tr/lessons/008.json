 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Familia",
    "@en": "Family"
   },
   "texto": [
    {
     "@es": "**Aile** significa «familia». El posesivo se une al nombre: **annem** (mi madre), **babam** (mi padre), **kardeşim** (mi hermano/a).",
     "@en": "**Aile** means «Family». The possessive joins the name: **annem** (my mother), **babam** (my father), **kardeşim** (my brother / a)."
    },
    {
     "@es": "El sufijo de «mi» suele ser **-(I)m**; toma una vocal de enlace cuando el nombre acaba en consonante: **evim** (mi casa).",
     "@en": "The «mi» suffix is usually **-(I)m**; it takes a link vowel when the name ends in consonant: **evim** (my house)."
    },
    {
     "@es": "**Ailem** es «mi familia». **Kim?** significa «¿quién?».",
     "@en": "**Ailem** is «My family». **Kim?** means «Who?»."
    }
   ]
  },
