   "texto": [
    {
     "@es": "**… alabilir miyim?** = ¿podría tomar/recibir…? **Bakar mısınız?** = ¿me atiende?/¿podría mirar?",
     "@en": "**… alabilir miyim?** = could you take / receive it? **Bakar mısınız?** = do you see me? / could you look?"
    },
    {
     "@es": "**Anlamadım** = no entendí; **tekrar eder misiniz?** = ¿podría repetir?",
     "@en": "**Anlamadım** = I didn't understand; **tekrar eder misiniz?** = could you repeat?"
    },
    {
     "@es": "**Yardım eder misiniz?** = ¿podría ayudarme? Son fórmulas útiles en una tienda, estación o consulta.",
     "@en": "**Yardım eder misiniz?** = could you help me? They are useful formulas in a store, station or consultation."
    }
