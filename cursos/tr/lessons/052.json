 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Experiencias",
    "@en": "Experiences"
   },
   "texto": [
    {
     "@es": "**hayatımda** = en mi vida; **ilk kez** = por primera vez; **unutulmaz** = inolvidable.",
     "@en": "**hayatımda** = in my life; **ilk kez** = for the first time; **unutulmaz** = unforgettable."
    },
    {
     "@es": "**-di** cuenta un hecho terminado: **ilk kez uçakla seyahat ettim** = viajé en avión por primera vez.",
     "@en": "**-di** tells a finished fact: **ilk kez uçakla seyahat ettim** = I traveled by plane for the first time."
    },
    {
     "@es": "Une la razón con **çünkü** («porque») o la consecuencia con **bu nedenle** («por este motivo»).",
     "@en": "Link the reason with **çünkü** («because») or the consequence with **bu nedenle** («for this reason»)."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": {
    "@es": "Un recuerdo",
    "@en": "A souvenir"
   },
   "palabras": [
    "hayatımda",
    "ilk kez",
    "unutulmaz",
    "uçakla",
    "seyahat ettim",
    "bu nedenle",
    "heyecanlı"
   ]
  },
  {
   "tipo": "dialogo",
   "titulo": {
    "@es": "Un viaje inolvidable",
    "@en": "An unforgettable journey"
   },
   "frases": [
    {
     "quien": "Deniz",
     "tr": "Hayatında unutulmaz bir deneyim yaşadın mı?",
     "es": "¿Has vivido una experiencia inolvidable en tu vida?",
     "en": "Have you lived an unforgettable experience in your life?"
    },
    {
     "quien": "Anna",
     "tr": "Evet, ilk kez uçakla seyahat ettim.",
     "es": "Sí, viajé en avión por primera vez.",
     "en": "Yeah, I was on a plane for the first time."
    },
    {
     "quien": "Deniz",
     "tr": "Nereye gittin?",
     "es": "¿Adónde fuiste?",
     "en": "Where'd you go?"
    },
    {
     "quien": "Anna",
     "tr": "Ankara'ya gittim. Çok heyecanlıydım çünkü ilk yolculuğumdu.",
     "es": "Fui a Ankara. Estaba muy emocionada porque era mi primer viaje.",
     "en": "I went to Ankara. I was very excited because it was my first trip."
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué significa «ilk kez»?",
    "@en": "What does «ilk kez» mean?"
   },
   "id": "tr021-1",
   "opciones": [
    {
     "texto": {
      "@es": "por primera vez",
      "@en": "first time"
     },
     "explicacion": {
      "@es": "Marca una experiencia inicial.",
      "@en": "It marks an initial experience."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "por última vez",
      "@en": "last time"
     },
     "explicacion": {
      "@es": "Última es son kez.",
      "@en": "Last is kez."
     }
    },
    {
     "texto": {
      "@es": "cada vez",
      "@en": "at a time"
     },
     "explicacion": {
      "@es": "Cada vez es her seferinde.",
      "@en": "Every time it's her seferinde."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué experiencia cuenta Anna?",
    "@en": "What experience does Anna have?"
   },
   "id": "tr021-2",
   "opciones": [
    {
     "texto": {
      "@es": "Que viajó en avión por primera vez",
      "@en": "Who first traveled by plane"
     },
     "explicacion": "İlk kez uçakla seyahat ettim.",
     "correcta": true
    },
    {
     "texto": {
      "@es": "Que visitó un museo",
      "@en": "Who visited a museum"
     },
     "explicacion": {
      "@es": "Museo es müze.",
      "@en": "Museum is müze."
     }
    },
    {
     "texto": {
      "@es": "Que aprendió a conducir",
      "@en": "He learned to drive."
     },
     "explicacion": {
      "@es": "Conducir es araba kullanmak.",
      "@en": "Driving is a kulanmak plow."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "«Unutulmaz» significa…",
    "@en": "«Unutulmaz» means"
   },
   "id": "tr021-3",
   "opciones": [
    {
     "texto": "inolvidable",
     "explicacion": {
      "@es": "Unutulmaz describe algo que no se olvida.",
      "@en": "Unutulmaz describes something that is not forgotten."
     },
     "correcta": true
    },
    {
     "texto": "emocionante",
     "explicacion": {
      "@es": "Emocionado/a es heyecanlı.",
      "@en": "Emotionado is hejecanlı."
     }
    },
    {
     "texto": {
      "@es": "lejano/a",
      "@en": "far / a"
     },
     "explicacion": {
      "@es": "Lejano/a es uzak.",
      "@en": "Far away is uzak."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Por qué estaba emocionada Anna?",
    "@en": "Why was Anna excited?"
   },
   "id": "tr021-4",
   "opciones": [
    {
     "texto": {
      "@es": "Porque era su primer viaje",
      "@en": "Because it was his first trip."
     },
     "explicacion": "Çünkü ilk yolculuğumdu.",
     "correcta": true
    },
    {
     "texto": {
      "@es": "Porque no tenía un billete",
      "@en": "Because I didn't have a ticket."
     },
     "explicacion": {
      "@es": "Billete es bilet.",
      "@en": "Ticket is billet."
     }
    },
    {
     "texto": {
      "@es": "Porque estaba en casa",
      "@en": "Because I was home."
     },
     "explicacion": {
      "@es": "Casa es ev.",
      "@en": "Home is ev."
     }
    }
   ]
  },
  {
   "tipo": "traduccion",
   "pregunta": {
