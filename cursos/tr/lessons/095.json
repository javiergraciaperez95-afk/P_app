 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Puedo hacerlo",
    "@en": "I can do it."
   },
   "texto": [
    {
     "@es": "Puedo explicar mis preferencias, objetivos y emociones con razones.",
     "@en": "I can explain my preferences, objectives and emotions with reasons."
    },
    {
     "@es": "Puedo resumir noticias y opiniones, pedir aclaraciones y responder de forma cortés.",
     "@en": "I can summarize news and opinions, ask for clarification and respond courteously."
    },
    {
     "@es": "Puedo narrar hechos pasados, describir viajes y defender una opinión reconociendo más de una perspectiva.",
     "@en": "I can tell past facts, describe travel and defend an opinion by recognizing more than one perspective."
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué estructura expresa «a pesar de que»?",
    "@en": "What structure does «even though» express?"
   },
   "id": "tr032-1",
   "opciones": [
    {
     "texto": "-mesine rağmen",
     "explicacion": {
      "@es": "Expresa concesión.",
      "@en": "Expresses concession."
     },
     "correcta": true
    },
    {
     "texto": "çünkü",
     "explicacion": {
      "@es": "Significa porque.",
      "@en": "It means why."
     }
    },
    {
     "texto": "-mek için",
     "explicacion": {
      "@es": "Expresa propósito.",
      "@en": "It expresses purpose."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué tiempo describe una acción que estaba en curso en el pasado?",
    "@en": "What time does an action that was in progress in the past describe?"
   },
   "id": "tr032-2",
   "opciones": [
    {
     "texto": "-yordu",
     "explicacion": {
      "@es": "Bekliyordum = estaba esperando.",
      "@en": "Bekliyordum = was waiting."
     },
     "correcta": true
    },
    {
     "texto": "-(y)acak",
     "explicacion": {
      "@es": "Expresa futuro.",
      "@en": "It expresses a future."
     }
    },
    {
     "texto": "geniş zaman",
     "explicacion": {
      "@es": "Expresa hábitos o hechos generales.",
      "@en": "It expresses general habits or facts."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué fórmula sirve para pedir que repitan una pregunta?",
    "@en": "What is the formula for asking you to repeat a question?"
   },
   "id": "tr032-3",
   "opciones": [
    {
     "texto": "Soruyu tekrar edebilir misiniz?",
     "explicacion": {
      "@es": "Petición cortés de aclaración.",
      "@en": "A clear request for clarification."
     },
     "correcta": true
    },
    {
     "texto": "Hangi bölümde çalışıyorsunuz?",
     "explicacion": {
      "@es": "Pregunta por una especialidad.",
      "@en": "Ask for a specialty."
     }
    },
    {
     "texto": "Bu ne kadar sürer?",
     "explicacion": {
      "@es": "Pregunta cuánto dura.",
      "@en": "She asks how long it lasts."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Cómo puedes resumir dos lados de una cuestión?",
    "@en": "How can you summarize two sides of a question?"
   },
   "id": "tr032-4",
   "opciones": [
    {
     "texto": "Bir yandan..., öte yandan...",
     "explicacion": {
      "@es": "Presenta dos perspectivas.",
      "@en": "It presents two perspectives."
     },
     "correcta": true
    },
    {
     "texto": "Önce..., sonra...",
     "explicacion": {
      "@es": "Ordena acciones.",
      "@en": "Order action."
     }
    },
    {
     "texto": "Hem..., hem de...",
     "explicacion": {
      "@es": "Añade dos elementos.",
      "@en": "Add two elements."
     }
    }
   ]
  },
  {
   "tipo": "traduccion",
   "pregunta": {
    "@es": "Traduce.",
    "@en": "Translate."
   },
   "frase": "Haber kaynağını doğrulamadan paylaşmamalıyız.",
   "id": "tr032-5",
   "opciones": [
    {
     "texto": {
      "@es": "No deberíamos compartir la fuente de la noticia sin verificarla.",
      "@en": "We should not share the source of the news without checking it."
     },
     "explicacion": {
      "@es": "Doğrulamadan = sin verificar.",
      "@en": "Doğrulamadan = unverified."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Tenemos que publicar todas las noticias.",
      "@en": "We have to publish all the news."
     },
     "explicacion": {
      "@es": "No dice eso.",
      "@en": "He doesn't say that."
     }
    },
    {
     "texto": {
      "@es": "La noticia se publicó ayer.",
      "@en": "The news was published yesterday."
     },
     "explicacion": {
      "@es": "Pasado distinto.",
      "@en": "Different past."
     }
    }
   ]
  },
  {
   "tipo": "huecos",
   "pregunta": {
    "@es": "Completa: «Después de contar mi experiencia, explicaré mi opinión».",
    "@en": "Complete: «After I tell my experience, I will explain my opinion.»."
   },
   "frase": "Deneyimimi anlat___ sonra fikrimi açıklayacağım.",
   "id": "tr032-6",
   "opciones": [
    {
     "texto": "ıp",
     "explicacion": {
      "@es": "-ıp enlaza acciones consecutivas.",
      "@en": "-ıp links consecutive actions."
     },
     "correcta": true
    },
    {
     "texto": "dığım",
     "explicacion": {
      "@es": "Forma una subordinada relativa.",
      "@en": "It forms a relative subordinate."
     }
    },
    {
     "texto": "mış",
     "explicacion": {
      "@es": "Marca información referida.",
      "@en": "It marks information referred to."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "Escucha la capacidad.",
    "@en": "Listen to the capacity."
   },
   "audio": "Farklı görüşleri kibarca değerlendirebiliriz.",
   "id": "tr032-7",
   "opciones": [
    {
     "texto": {
      "@es": "Podemos valorar distintas opiniones con cortesía.",
      "@en": "We can value different opinions with courtesy."
     },
     "explicacion": {
      "@es": "Değerlendirmek = valorar.",
      "@en": "Değerlendirmek = value."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Debemos rechazar toda opinión diferente.",
      "@en": "We must reject any different opinion."
     },
     "explicacion": {
      "@es": "Es lo contrario.",
      "@en": "It's the opposite."
     }
    },
    {
     "texto": {
      "@es": "No podemos participar en el debate.",
      "@en": "We cannot participate in the debate."
     },
     "explicacion": {
      "@es": "No es la frase.",
      "@en": "It's not the phrase."
     }
    }
   ]
  },
  {
   "tipo": "ordenar",
   "pregunta": {
    "@es": "Ordena las palabras.",
    "@en": "Order the words."
   },
   "frase": "Önce dinleyelim, sonra görüşümüzü açıklayalım",
   "traduccion": {
    "@es": "Escuchemos primero y después expliquemos nuestro punto de vista",
    "@en": "Let's listen first and then explain our point of view."
   },
   "explicacion": {
    "@es": "Ordena la participación en una conversación.",
    "@en": "He orders participation in a conversation."
   },
   "id": "tr032-8"
  },
  {
   "tipo": "escribir",
   "pregunta": {
    "@es": "Escribe «¿Puede repetir la pregunta?»",
    "@en": "Write «Can you repeat the question?»"
   },
   "respuestas": [
    "soruyu tekrar edebilir misiniz"
   ],
   "explicacion": {
    "@es": "Petición cortés.",
    "@en": "Courteous request."
   },
   "id": "tr032-9"
  }
 ],
 "intro": {
  "@es": "Comprueba que puedes participar en conversaciones, narrar experiencias y escribir textos conectados sobre temas conocidos.",
  "@en": "Check that you can participate in conversations, narrate experiences and write connected texts on known topics."
 }
}