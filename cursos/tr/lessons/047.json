   },
   "texto": [
    {
     "@es": "**eğitim** = educación; **ders** = clase; **sınav** = examen.",
     "@en": "**eğitim** = education; **ders** = class; **sınav** = exam."
    },
    {
     "@es": "**kurs** = curso; **öğrenmek** = aprender.",
     "@en": "**kurs** = course; **öğrenmek** = learning."
    },
    {
     "@es": "**... öğreniyorum** = estoy aprendiendo algo. Puedes expresar una intención con **istiyorum** («quiero»).",
     "@en": "**... öğreniyorum** = I'm learning something. You can express an intention with **istiyorum** («I want to»)."
    }
   ]
  },
