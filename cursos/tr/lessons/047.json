   "titulo": {
    "@es": "En la universidad",
    "@en": "At the university"
   },
   "frases": [
    {
     "quien": "Ece",
     "tr": "Üniversitede hangi bölümde okuyorsun?",
     "es": "¿Qué especialidad estudias en la universidad?",
     "en": "What specialty do you study in college?"
    },
    {
     "quien": "Ali",
     "tr": "Mühendislik okuyorum. Türkçe kursuna da gidiyorum.",
     "es": "Estudio ingeniería y también voy al curso de turco.",
     "en": "I study engineering and I also go to the Turkish course."
    },
    {
     "quien": "Ece",
     "tr": "Bu akşam sınava çalışacak mısın?",
     "es": "¿Vas a estudiar para el examen esta tarde?",
     "en": "Are you going to study for the exam this afternoon?"
    },
    {
     "quien": "Ali",
     "tr": "Evet, çünkü Türkçemi geliştirmek istiyorum.",
     "es": "Sí, porque quiero mejorar mi turco.",
     "en": "Yeah, because I want to improve my Turkish."
    }
   ]
  },
