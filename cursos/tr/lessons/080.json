    },
    {
     "quien": "Deniz",
     "tr": "Bir ailenin başka bir şehre taşınmasını anlatıyordu.",
     "es": "Contaba la mudanza de una familia a otra ciudad.",
     "en": "He counted the move from one family to another city."
    },
