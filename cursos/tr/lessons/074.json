 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Alquilar una vivienda",
    "@en": "Rent a home"
   },
   "texto": [
    {
     "@es": "**kiralık** = en alquiler; **depozito** = depósito; **kontrat** = contrato.",
     "@en": "**kiralık** = for rent; **depozito** = deposit; **kontrat** = contract."
    },
    {
     "@es": "**-den beri** expresa «desde hace»: **üç aydan beri ev arıyorum** = llevo tres meses buscando casa.",
     "@en": "**-den beri** expresses «since»: **üç aydan beri ev arıyorum** = I have been looking for a house for three months."
    },
    {
     "@es": "Para negociar, explica una necesidad y formula una propuesta con cortesía.",
     "@en": "To negotiate, he explains a need and makes a proposal with courtesy."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": {
    "@es": "Un anuncio",
    "@en": "An announcement"
   },
   "palabras": [
    "kiralık",
    "depozito",
    "kontrat",
    "ev sahibi",
    "aidat",
    "taşınmak",
    "pazarlık"
   ]
  },
  {
   "tipo": "dialogo",
   "titulo": {
    "@es": "Visita al piso",
    "@en": "Visit to the floor"
   },
   "frases": [
    {
     "quien": "Kiracı",
     "tr": "Üç aydan beri kiralık daire arıyorum. Bu daire için depozito ne kadar?",
     "es": "Llevo tres meses buscando un piso en alquiler. ¿De cuánto es el depósito para este apartamento?",
     "en": "I've been looking for a rental apartment for three months. How much is the deposit for this apartment?"
    },
    {
     "quien": "Ev sahibi",
     "tr": "Bir aylık kira kadar. Aidat fiyata dahil değil.",
     "es": "El equivalente a un mes de alquiler. Los gastos de comunidad no están incluidos en el precio.",
     "en": "The equivalent of one month's rent. Community expenditure is not included in the price."
    },
    {
     "quien": "Kiracı",
     "tr": "Kontratın süresini konuşabilir miyiz?",
     "es": "¿Podemos hablar de la duración del contrato?",
     "en": "Can we talk about the duration of the contract?"
    },
    {
     "quien": "Ev sahibi",
     "tr": "Elbette, şartları birlikte değerlendirelim.",
     "es": "Claro, valoremos juntos las condiciones.",
     "en": "Of course, let's value the conditions together."
    }
   ]
  },
