  {
   "tipo": "dialogo",
   "titulo": {
    "@es": "Una avería en la habitación",
    "@en": "A room failure"
   },
   "frases": [
    {
     "quien": "Misafir",
     "tr": "Klimanın çalışmamasına rağmen oda çok sıcak.",
     "es": "Aunque el aire acondicionado no funciona, la habitación está muy caliente.",
     "en": "Although the air conditioning is not working, the room is very hot."
    },
    {
     "quien": "Görevli",
     "tr": "Arızayı hemen kontrol edelim.",
     "es": "Revisemos la avería ahora mismo.",
     "en": "Let's check the breakdown right now."
    },
    {
     "quien": "Misafir",
     "tr": "Rezervasyon yapmama rağmen oda hazır değildi.",
     "es": "A pesar de que hice una reserva, la habitación no estaba lista.",
     "en": "Even though I made a reservation, the room wasn't ready."
    },
    {
     "quien": "Görevli",
     "tr": "Özür dileriz. Odanızı değiştirebilir veya ücret iadesi isteyebilirsiniz.",
     "es": "Lo sentimos. Puede cambiar de habitación o solicitar un reembolso.",
     "en": "We're sorry. You can change rooms or request a refund."
    }
   ]
  },
