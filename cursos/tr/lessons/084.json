  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Resolver un problema",
    "@en": "Solve a problem"
   },
   "texto": [
    {
     "@es": "**arıza** = avería; **şikâyet** = queja; **fatura** = factura.",
     "@en": "**arıza** = breakdown; **şikâyet** = complaint; **fatura** = invoice."
    },
    {
     "@es": "Explica el problema con calma y di qué solución esperas.",
     "@en": "Explain the problem calmly and say what solution you expect."
    },
    {
     "@es": "**-mesine rağmen** = a pesar de que: **rezervasyon yapmama rağmen** = a pesar de que hice una reserva.",
     "@en": "**-mesine rağmen** = even though: **rezervasyon yapmama rağmen** = even though I made a reservation."
    }
   ]
  },
