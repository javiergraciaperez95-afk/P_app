{
 "capitulo": 1,
 "titulo_tr": "Benim adım Anna",
 "titulo_es": {
  "@es": "Presentarse y dar datos personales",
  "@en": "To present and give personal data"
 },
 "palabras": {
  "benim": {
   "es": "mi, mío",
   "en": "My, my",
   "pron": "be-NIM"
  },
  "ad": {
   "es": "nombre",
   "en": "name",
   "pron": "ad"
  },
  "adım": {
   "es": "mi nombre",
   "en": "My name",
