  },
  "adın": {
   "es": "tu nombre",
   "en": "Your name",
   "pron": "a-DUHN"
  },
  "adınız": {
   "es": "su nombre, vuestro nombre",
   "en": "your name, your name",
   "pron": "a-du-NUHZ"
  },
  "ne": {
   "es": "qué",
   "en": "what",
   "pron": "ne"
  },
  "Anna'yım": {
   "es": "soy Anna",
   "en": "I'm Anna.",
   "pron": "an-NA-yuhm"
  },
  "nerelisin": {
   "es": "¿de dónde eres?",
   "en": "Where are you from?",
   "pron": "ne-re-li-SIN"
  },
  "nerelisiniz": {
   "es": "¿de dónde es usted?",
   "en": "Where are you from?",
   "pron": "ne-re-li-si-NIZ"
  },
  "İspanya": {
   "es": "España",
   "en": "Spain",
   "pron": "is-pan-ya"
  },
  "İspanyalı": {
   "es": "español, española",
   "en": "Spanish, Spanish",
   "pron": "is-pan-ya-LUH"
  },
  "İspanyolum": {
   "es": "soy español/a",
   "en": "I'm Spanish.",
   "pron": "is-pan-yo-LUM"
  },
  "Türk": {
   "es": "turco, turca",
   "en": "Turkish, Turkish",
   "pron": "türk"
  },
