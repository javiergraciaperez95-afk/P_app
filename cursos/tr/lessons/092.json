     "tr": "Bu uygulama eskisine göre daha hızlı.",
     "es": "Esta aplicación es más rápida que la anterior.",
     "en": "This application is faster than the previous one."
    },
    {
     "quien": "Ece",
     "tr": "Bir yandan zaman kazandırıyor, öte yandan kişisel bilgileri topluyor.",
     "es": "Por un lado ahorra tiempo; por otro, recopila información personal.",
     "en": "On the one hand, it saves time; on the other, it collects personal information."
    },
    {
     "quien": "Ali",
     "tr": "Bilgilerin güvenli olduğu söyleniyor.",
     "es": "Se dice que la información está segura.",
     "en": "The information is said to be secure."
    },
    {
     "quien": "Ece",
     "tr": "Yine de hangi bilgileri paylaştığımızı kontrol etmeliyiz.",
     "es": "Aun así, debemos controlar qué información compartimos.",
     "en": "However, we must control what information we share."
    }
   ]
