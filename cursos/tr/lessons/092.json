   "titulo": {
    "@es": "Comparar tecnologías",
    "@en": "Compare Technologies"
   },
   "texto": [
    {
     "@es": "**gelişme** = avance; **avantaj** = ventaja; **dezavantaj** = desventaja.",
     "@en": "**gelişme** = advance; **avantaj** = advantage; **dezavantaj** = disadvantage."
    },
    {
     "@es": "Usa **eskisine göre** («comparado con el anterior») y **bir yandan ... öte yandan ...** («por un lado... por otro...»).",
     "@en": "Use **eskisine göre** («compared to the previous») and **bir yandan ... öte yandan ...** («On the one hand... on the other...»)."
    },
    {
     "@es": "Para contar una afirmación ajena, puedes usar **-dığı söyleniyor** («se dice que...»).",
     "@en": "To count a foreign claim, you can use **-dığı söyleniyor** («It's said that...»)."
    }
   ]
  },
