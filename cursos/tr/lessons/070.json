   ]
  },
  {
   "tipo": "dialogo",
   "titulo": {
    "@es": "En el descanso",
    "@en": "At rest"
   },
   "frases": [
    {
     "quien": "Anna",
     "tr": "Bu derste en iyi hangi yöntemle öğreniyorsun?",
     "es": "¿Con qué método aprendes mejor en esta clase?",
     "en": "What method do you learn best in this class?"
    },
    {
     "quien": "Can",
     "tr": "Görselleri kullanarak ve not alarak daha iyi öğreniyorum.",
     "es": "Aprendo mejor usando imágenes y tomando notas.",
     "en": "I learn better using images and taking notes."
    },
    {
     "quien": "Anna",
     "tr": "Projede ne kadar ilerledin?",
     "es": "¿Cuánto has avanzado en el proyecto?",
     "en": "How much progress have you made on the project?"
    },
    {
     "quien": "Can",
     "tr": "Şu ana kadar ilk bölümü bitirdim ama sonuçları açıklamakta zorlanıyorum.",
     "es": "Hasta ahora terminé la primera parte, pero tengo dificultades para explicar los resultados.",
     "en": "So far I have finished the first part, but I have difficulty explaining the results."
    }
   ]
  },
