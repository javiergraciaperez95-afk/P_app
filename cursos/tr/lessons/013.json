 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Hay y no hay",
    "@en": "There is and there is no"
   },
   "texto": [
    {
     "@es": "**Masada ekmek var** = hay pan en la mesa. **Masada peynir yok** = no hay queso en la mesa.",
     "@en": "**Masada ekmek var** = there's bread on the table. **Masada peynir yok** = no cheese on the table."
    },
    {
     "@es": "**Var** afirma que algo existe o está disponible; **yok** niega su existencia.",
     "@en": "**Var** states that something exists or is available; **yok** denies its existence."
    },
    {
     "@es": "Los nombres de comida no llevan artículo definido: **ekmek** puede ser «pan» o «el pan», según el contexto.",
     "@en": "Food names do not have a defined article: **ekmek** can be «bread» or «the bread», depending on the context."
    }
   ]
  },
