   "es": "trabajé",
   "en": "I worked.",
   "oculta": true
  },
  "görünüyorsun": {
   "es": "pareces",
   "en": "You look like",
   "pron": "gö-rü-nü-YOR-sun"
  },
  "haklısın": {
   "es": "tienes razón",
   "en": "You're right.",
   "pron": "hak-luh-SUHN"
  }
 },
 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Expresar emociones",
    "@en": "Expression of emotions"
   },
   "texto": [
    {
     "@es": "**mutlu** = feliz; **üzgün** = triste; **şaşkın** = sorprendido/a.",
     "@en": "**mutlu** = happy; **üzgün** = sad; **şaşkın** = surprised."
    },
    {
     "@es": "Para preguntar con cuidado puedes decir **Neyin var?** («¿Qué te pasa?»). **Bence** significa «en mi opinión» y **çünkü**, «porque».",
     "@en": "To ask carefully you can say **Neyin var?** («What's the matter with you?»). **Bence** means «in my opinion» and **çünkü**, «because»."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": {
    "@es": "Emociones",
    "@en": "Emotions"
   },
   "palabras": [
    "mutlu",
    "üzgün",
    "şaşkın",
    "yorgun",
    "bence",
    "çünkü",
    "neyin",
    "var"
   ]
  },
  {
   "tipo": "dialogo",
   "titulo": {
    "@es": "Una conversación",
    "@en": "A conversation"
   },
   "frases": [
    {
     "quien": "Ece",
     "tr": "Bugün üzgün görünüyorsun. Neyin var?",
     "es": "Hoy pareces triste. ¿Qué te pasa?",
     "en": "You look sad today. What's the matter with you?"
    },
    {
     "quien": "Anna",
     "tr": "Kendimi yorgun hissediyorum çünkü çok çalıştım.",
     "es": "Me siento cansada porque trabajé mucho.",
     "en": "I feel tired because I worked a lot."
    },
    {
     "quien": "Ece",
     "tr": "Bence biraz dinlenmelisin.",
     "es": "En mi opinión, deberías descansar un poco.",
     "en": "In my opinion, you should get some rest."
    },
    {
     "quien": "Anna",
     "tr": "Haklısın, teşekkür ederim.",
     "es": "Tienes razón, gracias.",
     "en": "You're right, thank you."
    }
   ]
  },
  {
