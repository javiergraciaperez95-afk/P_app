   "en": "tired",
   "pron": "yor-GUN"
  },
  "bence": {
   "es": "en mi opinión",
   "en": "in my opinion",
   "pron": "BEN-je"
  },
  "çünkü": {
   "es": "porque",
   "en": "because",
   "pron": "chün-KÜ"
  },
  "neyin": {
   "es": "qué (de ti)",
   "en": "what (from you)",
   "pron": "ne-YIN"
  },
  "var": {
   "es": "hay; tener",
   "en": "there are; have",
   "pron": "var"
  },
  "kendimi": {
   "es": "me (a mí mismo/a)",
   "en": "me (myself)",
   "pron": "ken-di-MI",
   "oculta": true
  },
  "hissediyorum": {
   "es": "siento",
   "en": "I'm sorry.",
   "pron": "his-se-di-YO-rum",
   "oculta": true
  },
