{
 "capitulo": 11,
 "titulo_tr": "Duygular ve fikirler",
 "titulo_es": {
  "@es": "Emociones y opiniones",
  "@en": "Emotions and opinions"
 },
 "palabras": {
  "mutlu": {
   "es": "feliz",
   "en": "Happy",
   "pron": "mut-LU"
  },
