    {
     "quien": "Yolcu",
     "tr": "Otobüsüm gecikti. Biletimi başka bir seferle değiştirebilir miyim?",
     "es": "Mi autobús se retrasó. ¿Puedo cambiar mi billete por otro servicio?",
     "en": "My bus is late. Can I trade my ticket for another service?"
    },
    {
     "quien": "Görevli",
     "tr": "Evet. Aktarmalı sefer daha erken kalkıyor.",
     "es": "Sí. El servicio con transbordo sale antes.",
     "en": "Yeah. The transshipment service comes out first."
    },
    {
     "quien": "Yolcu",
     "tr": "Bilet ücretinde değişiklik olacak mı?",
     "es": "¿Habrá algún cambio en el precio del billete?",
     "en": "Will there be any change in the price of the ticket?"
    },
    {
     "quien": "Görevli",
     "tr": "Hayır, ama koltuk numaranız değişebilir.",
     "es": "No, pero su número de asiento puede cambiar.",
     "en": "No, but your seat number may change."
    }
   ]
