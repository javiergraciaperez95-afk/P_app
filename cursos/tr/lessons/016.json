 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "El sufijo de lugar",
    "@en": "The place suffix"
   },
   "texto": [
    {
     "@es": "**-da/-de/-ta/-te** significa «en». Se añade al final del nombre: **evde** (en casa), **okulda** (en la escuela).",
     "@en": "**-da/-de/-ta/-te** means «en». It is added at the end of the name: **evde** (at home), **okulda** (at school)."
    },
    {
     "@es": "La vocal se ajusta a la última vocal; después de consonantes sordas como **k, p, t, ç, f, h, s, ş**, d cambia a t: **parkta** (en el parque).",
     "@en": "The vowel fits the last vowel; after deaf consonants like **k, p, t, ç, f, h, s, ş**, d changes to t: **parkta** (in the park)."
    },
    {
     "@es": "**Nerede?** = ¿dónde? **Nerede çalışıyorsun?** = ¿dónde trabajas?",
     "@en": "**Nerede?** = where? **Nerede çalışıyorsun?** = where do you work?"
    }
   ]
  },
