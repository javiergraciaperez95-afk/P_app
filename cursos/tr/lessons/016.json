   "id": "tr016-2",
   "opciones": [
    {
     "texto": "La k cambia d por t",
     "explicacion": {
      "@es": "Después de consonante sorda se usa -ta/-te.",
      "@en": "After a deaf consonant is used -ta / -te."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Porque todos los lugares terminan en -ta",
      "@en": "Because all the places end up in -ta"
     },
     "explicacion": {
      "@es": "La terminación depende del sonido final.",
      "@en": "The termination depends on the final sound."
     }
    },
    {
     "texto": "Porque park es plural",
     "explicacion": {
      "@es": "El plural es parklar.",
      "@en": "The plural is parklar."
     }
    }
