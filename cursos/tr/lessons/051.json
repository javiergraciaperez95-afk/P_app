     "es": "No, por eso me mojé.",
     "en": "No, that's why I got wet."
    },
    {
     "quien": "Ali",
     "tr": "Sonra ne yaptın?",
     "es": "¿Qué hiciste después?",
     "en": "What did you do next?"
    },
    {
     "quien": "Ece",
     "tr": "Önce bir kafeye girdim, en sonunda eve gittim.",
     "es": "Primero entré en un café y al final fui a casa.",
     "en": "I first went into a coffee and then I went home."
    }
   ]
