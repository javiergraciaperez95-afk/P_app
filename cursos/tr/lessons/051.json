   "titulo": {
    "@es": "Conectar acciones",
    "@en": "Connect Actions"
   },
   "texto": [
    {
     "@es": "**önce** = primero; **sonra** = después; **en sonunda** = al final.",
     "@en": "**önce** = first; **sonra** = later; **en sonunda** = at the end."
    },
    {
     "@es": "**-ken** significa «mientras»: **eve giderken** = mientras iba a casa.",
     "@en": "**-ken** means «while»: **eve giderken** = while going home."
    },
    {
     "@es": "**bu yüzden** = por eso; **çünkü** = porque.",
     "@en": "**bu yüzden** = for that; **çünkü** = because."
    }
   ]
  },
