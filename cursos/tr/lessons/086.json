 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Celebrar e invitar",
    "@en": "Celebrate and invite"
   },
   "texto": [
    {
     "@es": "**tören** = ceremonia; **konuk** = invitado/a; **konuşma** = discurso.",
     "@en": "**tören** = ceremony; **konuk** = guest; **konuşma** = speech."
    },
    {
     "@es": "**hoş geldiniz** da la bienvenida; **katılabilirseniz** significa «si pueden asistir».",
     "@en": "**hoş geldiniz** welcomes; **katılabilirseniz** means «if you can attend»."
    },
    {
     "@es": "En una invitación, indica ocasión, fecha, lugar y cómo responder.",
     "@en": "In an invitation, it indicates occasion, date, place and how to respond."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": {
    "@es": "Una invitación",
    "@en": "An invitation"
   },
   "palabras": [
    "tören",
    "konuk",
    "hoş geldiniz",
    "davetiye",
    "katılabilirseniz",
    "kutlama konuşması",
    "anı"
   ]
  },
  {
   "tipo": "dialogo",
   "titulo": {
    "@es": "En una celebración",
    "@en": "In a celebration"
   },
   "frases": [
    {
     "quien": "Elif",
     "tr": "Mezuniyet törenimize katılabilirseniz çok seviniriz.",
     "es": "Nos alegraría mucho que pudieran asistir a nuestra ceremonia de graduación.",
     "en": "We would be very glad if you could attend our graduation ceremony."
    },
    {
     "quien": "Anna",
     "tr": "Davetiye için teşekkür ederim. Elbette geleceğim.",
     "es": "Gracias por la invitación. Claro que iré.",
     "en": "Thanks for the invitation. Of course I'll go."
    },
    {
     "quien": "Elif",
     "tr": "Törenden sonra küçük bir kutlama yapacağız.",
     "es": "Después de la ceremonia haremos una pequeña celebración.",
     "en": "After the ceremony we'll have a little celebration."
    },
    {
     "quien": "Anna",
     "tr": "Harika! Şimdiden tebrik ederim.",
     "es": "¡Qué bien! Te felicito por adelantado.",
     "en": "That's good! Congratulations in advance."
    }
   ]
  },
  {
