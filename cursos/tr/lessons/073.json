      "@en": "Can says they need to talk."
     }
    },
    {
     "texto": {
      "@es": "Ayudar a personas mayores",
      "@en": "Helping older people"
     },
     "explicacion": {
      "@es": "Se considera positivo.",
      "@en": "It's considered positive."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
