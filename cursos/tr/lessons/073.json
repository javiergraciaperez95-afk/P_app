 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Normas y relaciones",
    "@en": "Rules and relations"
   },
   "texto": [
    {
     "@es": "**görgü** = buenos modales; **komşuluk** = vecindad; **davranış** = comportamiento.",
     "@en": "**görgü** = good manners; **komşuluk** = neighbourhood; **davranış** = behavior."
    },
    {
     "@es": "**-malı/-meli** puede expresar una recomendación social.",
     "@en": "**-malı/-meli** may express a social recommendation."
    },
    {
     "@es": "Para disentir con educación, puedes decir **Sana katılıyorum, ama...** («Estoy de acuerdo contigo, pero...»).",
     "@en": "To be educated, you can say **Sana katılıyorum, ama...** («I agree with you, but...»)."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": {
    "@es": "Convivencia",
    "@en": "Coexistence"
   },
   "palabras": [
    "görgü",
    "komşuluk",
    "davranış",
    "saygı",
    "gürültü",
    "yaşlı",
    "katılmak"
   ]
  },
  {
   "tipo": "dialogo",
   "titulo": {
    "@es": "En el edificio",
    "@en": "In the building"
   },
   "frases": [
    {
     "quien": "Ayşe",
     "tr": "Geç saatlerde gürültü yapılmamalı.",
     "es": "No se debería hacer ruido a altas horas.",
     "en": "No noise should be made in the late hours."
    },
    {
     "quien": "Can",
     "tr": "Sana katılıyorum, ama komşular birbirleriyle de konuşmalı.",
     "es": "Estoy de acuerdo contigo, pero los vecinos también deberían hablar entre sí.",
     "en": "I agree with you, but the neighbors should talk to each other, too."
    },
    {
     "quien": "Ayşe",
     "tr": "Elbette. Yaşlılara yardım etmek de önemli.",
     "es": "Claro. También es importante ayudar a las personas mayores.",
     "en": "Sure. It is also important to help older people."
    },
    {
     "quien": "Can",
     "tr": "Bence saygılı davranış ilişkileri güçlendirir.",
     "es": "En mi opinión, un comportamiento respetuoso fortalece las relaciones.",
     "en": "In my opinion, respectful behaviour strengthens relationships."
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué significa «görgü»?",
    "@en": "What does «görgü» mean?"
   },
   "id": "tr010-1",
   "opciones": [
    {
     "texto": "buenos modales",
     "explicacion": {
      "@es": "Görgü trata de normas de convivencia.",
      "@en": "Görgü is about rules of coexistence."
     },
     "correcta": true
    },
    {
     "texto": "vecindad",
     "explicacion": {
      "@es": "Vecindad es komşuluk.",
      "@en": "Neighbor is komşuluk."
     }
    },
    {
     "texto": "comportamiento",
     "explicacion": {
      "@es": "Comportamiento es davranış.",
      "@en": "Behavior is davranış."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué conducta no se recomienda?",
