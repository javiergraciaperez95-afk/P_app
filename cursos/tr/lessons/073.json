      "@en": "There's no mention."
     }
    },
    {
     "texto": {
      "@es": "Evitar hablar con vecinos",
      "@en": "Avoid talking to neighbors"
     },
     "explicacion": {
      "@es": "Es lo contrario de la conversación.",
      "@en": "It's the opposite of the conversation."
     }
    }
   ]
  },
