      "@en": "It started."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "Escucha el plan.",
    "@en": "Listen to the plan."
   },
   "audio": "Yağmura rağmen yürüyüş yoluna gidebiliriz.",
   "id": "tr019-7",
   "opciones": [
    {
     "texto": {
      "@es": "Podemos ir a la ruta a pesar de la lluvia.",
      "@en": "We can go to the route despite the rain."
     },
     "explicacion": {
      "@es": "-e rağmen = a pesar de.",
      "@en": "-e rağmen = despite."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "No podemos salir por la lluvia.",
      "@en": "We can't go out in the rain."
     },
     "explicacion": {
      "@es": "No es lo que dice.",
      "@en": "It's not what he says."
     }
    },
    {
     "texto": {
      "@es": "La lluvia empieza en la ruta.",
      "@en": "The rain starts on the road."
     },
     "explicacion": {
      "@es": "No es la frase.",
      "@en": "It's not the phrase."
     }
    }
   ]
  },
  {
   "tipo": "ordenar",
   "pregunta": {
    "@es": "Ordena las palabras.",
    "@en": "Order the words."
   },
   "frase": "Uygun kıyafet seçelim",
   "traduccion": {
    "@es": "Elijamos ropa adecuada",
    "@en": "Let's choose proper clothes."
   },
   "explicacion": {
    "@es": "-elim propone una acción compartida.",
    "@en": "-elim proposes a shared action."
   },
   "id": "tr019-8"
  },
  {
   "tipo": "escribir",
   "pregunta": {
