 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Preparar el viaje",
    "@en": "Prepare the trip"
   },
   "texto": [
    {
     "@es": "**broşür** = folleto; **giriş ücreti** = precio de entrada; **bütçe** = presupuesto.",
     "@en": "**broşür** = brochure; **giriş ücreti** = entry price; **bütçe** = budget."
    },
    {
     "@es": "**ziyaret etmeye değer** significa «merece la pena visitar».",
     "@en": "**ziyaret etmeye değer** means «worth a visit.»."
    },
    {
     "@es": "**-e rağmen** significa «a pesar del»: **yağmura rağmen** = a pesar de la lluvia.",
     "@en": "**-e rağmen** means «in spite of»: **yağmura rağmen** = despite the rain."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": {
    "@es": "Elegir una excursión",
    "@en": "Choose an excursion"
   },
   "palabras": [
    "broşür",
    "giriş ücreti",
    "bütçe",
    "ziyaret etmeye değer",
    "manzara",
    "yürüyüş yolu",
    "yağmura rağmen"
   ]
  },
  {
   "tipo": "dialogo",
   "titulo": {
    "@es": "Plan para el domingo",
    "@en": "Plan for Sunday"
   },
   "frases": [
    {
     "quien": "Ali",
     "tr": "Broşürdeki göl ziyaret etmeye değer mi?",
     "es": "¿Merece la pena visitar el lago del folleto?",
     "en": "Is it worth visiting the prospectus lake?"
    },
    {
     "quien": "Ece",
     "tr": "Evet, manzarası çok güzel. Giriş ücreti de bütçemize uygun.",
     "es": "Sí, el paisaje es muy bonito. El precio de entrada también se ajusta a nuestro presupuesto.",
     "en": "Yes, the landscape is very nice. The entry price is also in line with our budget."
    },
    {
     "quien": "Ali",
     "tr": "Yağmur yağarsa ne yaparız?",
     "es": "¿Qué hacemos si llueve?",
     "en": "What do we do if it rains?"
    },
    {
     "quien": "Ece",
     "tr": "Yağmura rağmen yürüyüş yoluna gidebiliriz; uygun kıyafet seçelim.",
     "es": "A pesar de la lluvia, podemos ir a la ruta; elijamos ropa adecuada.",
     "en": "Despite the rain, we can go to the route; we choose proper clothes."
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué significa «bütçe»?",
    "@en": "What does «bütçe» mean?"
   },
   "id": "tr019-1",
   "opciones": [
    {
     "texto": {
      "@es": "presupuesto",
      "@en": "budget"
     },
     "explicacion": {
      "@es": "El presupuesto limita cuánto se puede gastar.",
      "@en": "The budget limits how much can be spent."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "paisaje",
      "@en": "landscape"
     },
     "explicacion": {
      "@es": "Paisaje es manzara.",
      "@en": "Landscape is apple."
     }
    },
    {
     "texto": {
      "@es": "folleto",
      "@en": "brochure"
     },
     "explicacion": {
      "@es": "Folleto es broşür.",
      "@en": "Folleto is broşür."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Por qué el grupo considera adecuado el lago?",
    "@en": "Why does the group consider the lake appropriate?"
   },
   "id": "tr019-2",
   "opciones": [
    {
     "texto": {
      "@es": "Por el paisaje y el precio",
      "@en": "For the landscape and the price"
     },
     "explicacion": {
      "@es": "Ece da ambas razones.",
      "@en": "Ece gives both reasons."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Porque no hay que caminar",
      "@en": "Because you don't have to walk."
     },
     "explicacion": {
      "@es": "Hay una ruta de senderismo.",
      "@en": "There's a hiking route."
     }
    },
    {
     "texto": {
      "@es": "Porque está dentro de la ciudad",
      "@en": "Because it's inside the city."
     },
     "explicacion": {
      "@es": "No lo menciona.",
      "@en": "He doesn't mention it."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "«Ziyaret etmeye değer» significa…",
    "@en": "«Ziyaret etmeye değer» means"
   },
   "id": "tr019-3",
   "opciones": [
    {
     "texto": {
      "@es": "merece la pena visitar",
      "@en": "worth a visit."
     },
     "explicacion": {
      "@es": "Değer = vale/la pena.",
      "@en": "Değer = worth it."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "es demasiado caro",
      "@en": "It's too expensive."
     },
     "explicacion": {
      "@es": "Caro/a es pahalı.",
      "@en": "Caro / a is pahalı."
     }
    },
    {
     "texto": {
      "@es": "queda lejos",
      "@en": "It's far away."
     },
     "explicacion": {
      "@es": "Lejos es uzak.",
      "@en": "Far is uzak."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué harán si llueve?",
    "@en": "What will they do if it rains?"
   },
   "id": "tr019-4",
   "opciones": [
    {
     "texto": {
      "@es": "Aun así, pueden ir con ropa adecuada",
      "@en": "Still, they can go in proper clothes."
     },
     "explicacion": {
      "@es": "La lluvia no cancela automáticamente el plan.",
      "@en": "The rain does not automatically cancel the plan."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Se quedarán en casa",
      "@en": "They'll stay home."
     },
     "explicacion": {
      "@es": "No es su decisión.",
      "@en": "It's not your decision."
     }
    },
    {
     "texto": {
      "@es": "Cambiarán de ciudad",
      "@en": "They'll change the city"
     },
     "explicacion": {
      "@es": "No se dice.",
      "@en": "It's not said."
     }
    }
   ]
  },
  {
   "tipo": "traduccion",
   "pregunta": {
    "@es": "Traduce.",
    "@en": "Translate."
   },
   "frase": "Giriş ücreti bütçemize uygun.",
   "id": "tr019-5",
   "opciones": [
    {
     "texto": {
      "@es": "El precio de entrada se ajusta a nuestro presupuesto.",
      "@en": "The entry price is in line with our budget."
     },
     "explicacion": {
      "@es": "Uygun = adecuado.",
      "@en": "Uygun = suitable."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "La entrada es gratuita.",
      "@en": "The entrance is free."
     },
     "explicacion": {
      "@es": "Gratis es ücretsiz.",
      "@en": "Free is ücretsiz"
     }
    },
    {
     "texto": {
      "@es": "El paisaje está dentro del presupuesto.",
      "@en": "The landscape is within the budget."
     },
     "explicacion": {
      "@es": "No es la frase.",
      "@en": "It's not the phrase."
     }
    }
   ]
  },
  {
   "tipo": "huecos",
   "pregunta": {
    "@es": "Completa: «¿Merece la pena visitar el lago del folleto?».",
    "@en": "Complete: «Is it worth visiting the prospectus lake?»."
   },
   "frase": "Broşürdeki göl ziyaret etmeye ___ mi?",
   "id": "tr019-6",
   "opciones": [
    {
     "texto": "değer",
     "explicacion": {
      "@es": "Değer = merece/vale.",
      "@en": "Değer = deserves / worth."
     },
     "correcta": true
    },
    {
     "texto": "gerekir",
     "explicacion": {
      "@es": "Hace falta.",
      "@en": "It's necessary."
     }
    },
    {
     "texto": "başladı",
     "explicacion": {
