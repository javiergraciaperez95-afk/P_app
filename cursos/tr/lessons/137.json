     "correcta": true
    },
    {
     "texto": {
      "@es": "A casa",
      "@en": "Home"
     },
     "explicacion": {
      "@es": "Para dirección se usa eve.",
      "@en": "For direction is used eve."
     }
    },
    {
     "texto": {
      "@es": "Desde casa",
      "@en": "From home"
     },
     "explicacion": {
      "@es": "Para procedencia se usa evden.",
      "@en": "For provenance, evden is used."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Por qué aparece **t** en «parkta»?",
    "@en": "Why does **t** appear in «parkta»?"
   },
   "id": "tr042-2",
   "opciones": [
    {
     "texto": {
      "@es": "Park termina en una consonante sorda.",
      "@en": "Park ends up in a deaf consonant."
     },
     "explicacion": {
      "@es": "El locativo cambia d por t después de p, ç, t, k y otras consonantes sordas.",
      "@en": "The locative changes d by t after p, ç, t, k and other deaf consonants."
     },
     "correcta": true
    },
    {
     "texto": "Porque park es plural.",
     "explicacion": {
      "@es": "No es plural.",
      "@en": "It's not plural."
     }
    },
    {
     "texto": {
      "@es": "Porque indica destino.",
      "@en": "Because it indicates fate."
     },
     "explicacion": {
      "@es": "El destino lleva -a/-e.",
      "@en": "Fate takes -a / -e."
     }
    }
   ]
  },
