 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Ubicación",
    "@en": "Location"
   },
   "texto": [
    {
     "@es": "El locativo expresa «en»: **evde** = en casa; **okulda** = en la escuela.",
     "@en": "The location expresses «en»: **evde** = at home; **okulda** = at school."
    },
    {
     "@es": "Tras consonantes sordas frecuentes, d cambia a t: **parkta**. La vocal depende de la última vocal de la palabra.",
     "@en": "After frequent deaf consonants, d changes to t: **parkta**. The vowel depends on the last vowel of the word."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": {
    "@es": "Lugares",
    "@en": "Places"
   },
   "palabras": [
    "çanta"
   ]
  },
  {
   "tipo": "dialogo",
   "titulo": "Evde",
   "frases": [
