 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Encuestas y consumo",
    "@en": "Surveys and consumption"
   },
   "texto": [
    {
     "@es": "**anket** = encuesta; **tüketici** = consumidor/a; **yüzde** = porcentaje.",
     "@en": "**anket** = survey; **tüketici** = consumer / a; **yüzde** = percentage."
    },
    {
     "@es": "Para resumir datos usa **çoğunlukla** («en su mayoría») o **yarısı** («la mitad»).",
     "@en": "To summarize data use **çoğunlukla** («mostly») or **yarısı** («half»)."
    },
    {
     "@es": "**-e göre** significa «según»: **ankete göre** = según la encuesta.",
     "@en": "**-e göre** means «according to»: **ankete göre** = according to the survey."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": {
    "@es": "Resultados de una encuesta",
    "@en": "Results of a survey"
   },
   "palabras": [
    "anket",
    "tüketici",
    "yüzde",
    "çoğunluk",
    "yarısı",
    "ankete göre",
    "çevrim içi",
    "mağaza"
   ]
  },
  {
   "tipo": "dialogo",
   "titulo": {
    "@es": "Compras en línea",
    "@en": "Online shopping"
   },
   "frases": [
    {
     "quien": "Ece",
     "tr": "Ankete göre tüketicilerin yarısı çevrim içi alışveriş yapıyor.",
     "es": "Según la encuesta, la mitad de los consumidores compra en línea.",
     "en": "According to the survey, half of consumers buy online."
    },
    {
     "quien": "Ali",
     "tr": "Diğer yarısı mağazaları tercih ediyor mu?",
     "es": "¿La otra mitad prefiere las tiendas?",
     "en": "The other half prefer the shops?"
    },
    {
     "quien": "Ece",
     "tr": "Evet, çoğunlukla ürünleri görerek almak istiyorlar.",
     "es": "Sí, en su mayoría quieren comprar viendo los productos.",
     "en": "Yeah, they mostly want to buy by looking at the products."
    },
    {
     "quien": "Ali",
     "tr": "Bu sonuçlar ilginç.",
     "es": "Estos resultados son interesantes.",
     "en": "These results are interesting."
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué significa «anket»?",
    "@en": "What does «anket» mean?"
   },
   "id": "tr005-1",
   "opciones": [
    {
     "texto": {
      "@es": "encuesta",
      "@en": "survey"
     },
     "explicacion": {
      "@es": "Un anket recoge respuestas de varias personas.",
      "@en": "A ticket collects answers from several people."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "tienda",
      "@en": "shop"
     },
     "explicacion": {
      "@es": "Tienda es mağaza.",
      "@en": "Shop is mağaza."
     }
    },
    {
     "texto": {
      "@es": "producto",
      "@en": "product"
     },
     "explicacion": {
      "@es": "Producto es ürün.",
      "@en": "Product is ürün."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
