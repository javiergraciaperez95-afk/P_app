     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "antes de la encuesta",
      "@en": "before the survey"
     },
     "explicacion": {
      "@es": "Antes es anketten önce.",
      "@en": "Before that, it's anketten önce."
     }
    },
    {
     "texto": {
      "@es": "después de la encuesta",
      "@en": "after the survey"
     },
     "explicacion": {
      "@es": "Después es anketten sonra.",
      "@en": "Then it's anketten smiling."
     }
    }
