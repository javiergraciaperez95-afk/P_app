      "@en": "Yarısı means half."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "La mayoría",
      "@en": "Most"
     },
     "explicacion": {
      "@es": "La encuesta no dice çoğunluk.",
      "@en": "The survey doesn't say çoğunluk."
     }
    },
    {
     "texto": {
      "@es": "Todos",
      "@en": "All"
     },
     "explicacion": {
      "@es": "No es la totalidad.",
      "@en": "It's not the whole."
     }
    }
   ]
  },
  {
