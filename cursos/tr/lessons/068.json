      "@en": "It's not the preference he mentions."
     }
    },
    {
     "texto": {
      "@es": "No comprar productos",
      "@en": "Do not buy products"
     },
     "explicacion": {
      "@es": "No se dice eso.",
      "@en": "You don't say that."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "«Ankete göre» significa…",
    "@en": "«Ankete göre» means"
   },
   "id": "tr005-4",
   "opciones": [
    {
