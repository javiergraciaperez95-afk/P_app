   "texto": [
    {
     "@es": "El pasado en **-di/-dı/-du/-dü** cuenta una acción terminada: **gittim** = fui, **yaptım** = hice.",
     "@en": "The past in **-di/-dı/-du/-dü** counts a finished action: **gittim** = I went, **yaptım** = I did."
    },
    {
     "@es": "**geçen hafta sonu** = el fin de semana pasado; **iki gün önce** = hace dos días.",
     "@en": "**geçen hafta sonu** = last weekend; **iki gün önce** = two days ago."
    },
    {
     "@es": "**Kimle?** pregunta «¿con quién?» y **nereye?**, «¿adónde?».",
     "@en": "**Kimle?** question «With who?» and **nereye?**, «Where?»."
    }
   ]
  },
