  {
   "tipo": "dialogo",
   "titulo": {
    "@es": "Una reunión vecinal",
    "@en": "A neighborhood meeting"
   },
   "frases": [
    {
     "quien": "Ece",
     "tr": "Yeni bisiklet yolu mahallemiz için iyi bir gelişme.",
     "es": "El nuevo carril bici es un avance positivo para nuestro barrio.",
     "en": "The new bike lane is a positive step forward for our neighborhood."
    },
    {
     "quien": "Can",
     "tr": "Katılıyorum, ancak park yerleri azalabilir.",
     "es": "Estoy de acuerdo, pero puede que disminuyan las plazas de aparcamiento.",
     "en": "I agree, but the parking spaces may be reduced."
    },
    {
     "quien": "Ece",
     "tr": "Buna rağmen daha az araba kullanmamıza yardımcı olur.",
     "es": "A pesar de eso, nos ayudará a usar menos el coche.",
     "en": "In spite of that, it will help us to use the car less."
    },
    {
     "quien": "Can",
     "tr": "Önce komşuların görüşlerini alalım, sonra belediyeye öneri gönderelim.",
     "es": "Primero recojamos las opiniones de los vecinos y después enviemos una propuesta al municipio.",
     "en": "First we collect the opinions of the neighbors and then send a proposal to the municipality."
    }
   ]
  },
