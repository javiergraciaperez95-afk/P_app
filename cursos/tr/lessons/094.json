   "tipo": "explicacion",
   "titulo": {
    "@es": "Conectar ideas",
    "@en": "Connect ideas"
   },
   "texto": [
    {
     "@es": "Para narrar, combina acciones en curso, hechos terminados y referencias temporales.",
     "@en": "To narrate, it combines ongoing actions, completed facts and time references."
    },
    {
     "@es": "Para valorar una propuesta, expresa tanto ventajas como límites y da razones.",
     "@en": "To assess a proposal, it expresses both advantages and limits and gives reasons."
    },
    {
     "@es": "En situaciones reales, puedes pedir aclaraciones, resumir lo entendido y comprobar si la otra persona está de acuerdo.",
     "@en": "In real situations, you can ask for clarification, summarize the understanding and check if the other person agrees."
    }
   ]
