 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Hablar de profesiones",
    "@en": "Talk about professions"
   },
   "texto": [
    {
     "@es": "**beceri** = habilidad; **arzu** = deseo; **deneyim** = experiencia.",
     "@en": "**beceri** = skill; **arzu** = desire; **deneyim** = experience."
    },
    {
     "@es": "**-mek istiyorum** expresa deseo; **-ebilirim** indica capacidad.",
     "@en": "**-mek istiyorum** expresses desire; **-ebilirim** indicates capacity."
    },
    {
     "@es": "Puedes justificar una elección con **bu nedenle** («por este motivo») o **bana göre** («en mi opinión»).",
     "@en": "You can justify a choice with **bu nedenle** («for this reason») or **bana göre** («in my opinion»)."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": {
    "@es": "Una decisión profesional",
    "@en": "A professional decision"
   },
   "palabras": [
    "beceri",
    "arzu",
    "yaratıcı",
    "sabırlı",
    "tasarımcı",
    "bana göre"
   ]
  },
  {
   "tipo": "dialogo",
   "titulo": {
    "@es": "Hablar del futuro",
    "@en": "Talk about the future"
   },
   "frases": [
    {
     "quien": "Deniz",
     "tr": "Neden tasarımcı olmak istiyorsun?",
     "es": "¿Por qué quieres ser diseñador?",
     "en": "Why do you want to be a designer?"
    },
    {
     "quien": "Elif",
     "tr": "Yaratıcıyım ve çizim yapmayı seviyorum.",
     "es": "Soy creativa y me gusta dibujar.",
     "en": "I'm creative and I like to draw."
    },
    {
     "quien": "Deniz",
     "tr": "Bu iş için hangi beceriler gerekli?",
     "es": "¿Qué habilidades hacen falta para este trabajo?",
     "en": "What skills do you need for this job?"
    },
    {
     "quien": "Elif",
     "tr": "Sabırlı olmak ve insanlarla iyi iletişim kurabilmek.",
     "es": "Ser paciente y poder comunicarse bien con la gente.",
     "en": "Be patient and be able to communicate well with people."
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué significa «beceri»?",
    "@en": "What does «beceri» mean?"
   },
   "id": "tr008-1",
   "opciones": [
    {
     "texto": "habilidad",
     "explicacion": {
      "@es": "Es una capacidad para realizar una tarea.",
      "@en": "It is a capacity to perform a task."
     },
     "correcta": true
    },
    {
     "texto": "deseo",
     "explicacion": {
      "@es": "Deseo es arzu.",
      "@en": "I wish it's arzu."
     }
    },
    {
     "texto": {
      "@es": "experiencia",
      "@en": "experience"
     },
     "explicacion": {
      "@es": "Experiencia es deneyim.",
      "@en": "Experience is deneyim."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Por qué quiere Elif ser diseñadora?",
    "@en": "Why does Elif want to be a designer?"
   },
   "id": "tr008-2",
   "opciones": [
    {
     "texto": {
      "@es": "Porque es creativa y le gusta dibujar",
      "@en": "Because he's creative and he likes to draw"
     },
     "explicacion": {
      "@es": "Da ambas razones.",
      "@en": "He gives both reasons."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Porque quiere trabajar en un hospital",
      "@en": "Because he wants to work in a hospital."
     },
     "explicacion": {
      "@es": "No lo dice.",
      "@en": "He doesn't say."
     }
    },
    {
     "texto": {
      "@es": "Porque ya tiene mucha experiencia",
      "@en": "Because he has a lot of experience."
     },
     "explicacion": {
      "@es": "No menciona su experiencia.",
      "@en": "He doesn't mention his experience."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "«Gerekli» significa…",
    "@en": "«Gerekli» means"
   },
   "id": "tr008-3",
   "opciones": [
    {
     "texto": {
      "@es": "necesario/a",
      "@en": "required / a"
     },
     "explicacion": {
      "@es": "Gerekli describe algo que hace falta.",
      "@en": "Gerekli describes something that is needed."
     },
     "correcta": true
    },
    {
     "texto": "creativo/a",
     "explicacion": {
      "@es": "Creativo/a es yaratıcı.",
      "@en": "Creative is yaratıcı."
     }
    },
    {
     "texto": {
      "@es": "paciente",
      "@en": "patient"
     },
     "explicacion": {
      "@es": "Paciente es sabırlı.",
      "@en": "Patient is wise."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué habilidades menciona Elif?",
    "@en": "What skills does Elif mention?"
   },
   "id": "tr008-4",
   "opciones": [
    {
     "texto": {
      "@es": "Ser paciente y comunicarse bien",
      "@en": "Be patient and communicate well"
     },
     "explicacion": {
      "@es": "Ambas aparecen en su respuesta.",
      "@en": "Both appear in your answer."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Hablar varios idiomas",
      "@en": "Speak several languages"
     },
     "explicacion": {
      "@es": "No se menciona.",
      "@en": "There's no mention."
     }
    },
    {
     "texto": {
      "@es": "Diseñar edificios",
      "@en": "Design buildings"
     },
     "explicacion": {
      "@es": "No se menciona.",
      "@en": "There's no mention."
     }
    }
   ]
  },
  {
