   "en": "big, big",
   "pron": "bü-YÜK"
  },
  "küçük": {
   "es": "pequeño/a",
   "en": "small",
   "pron": "kü-CHÜK"
  },
  "uzun": {
   "es": "alto/a, largo/a",
   "en": "high, long / a",
   "pron": "u-ZUN"
  },
  "kısa": {
   "es": "bajo/a, corto/a",
   "en": "low, short / a",
   "pron": "kuh-SA"
  },
  "genç": {
   "es": "joven",
   "en": "young",
   "pron": "gench"
  },
  "yaşlı": {
   "es": "mayor, anciano/a",
   "en": "older, old",
   "pron": "yash-LUH"
  },
  "güzel": {
   "es": "bonito/a",
   "en": "Nice.",
   "pron": "gü-ZEL"
  },
  "çok": {
   "es": "muy, mucho",
   "en": "very, very",
   "pron": "chok"
  },
  "ailen": {
   "es": "tu familia",
   "en": "Your family",
   "pron": "ai-LEN"
  },
  "mü": {
   "es": "partícula interrogativa",
   "en": "question particle",
   "pron": "mü"
  },
  "iş": {
   "es": "trabajo",
   "en": "work",
   "pron": "ish"
