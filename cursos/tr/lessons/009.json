     "explicacion": {
      "@es": "Büyük aile = familia grande.",
      "@en": "Büyük aile = large family."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Después del nombre",
      "@en": "After the name"
     },
     "explicacion": {
      "@es": "El adjetivo suele preceder al nombre.",
      "@en": "The adjective usually precedes the name."
     }
    },
    {
     "texto": {
      "@es": "Siempre al final",
      "@en": "Always at the end"
     },
     "explicacion": {
      "@es": "Puede ir al final del predicado, pero no antes del nombre.",
      "@en": "You can go to the end of the preaching, but not before the name."
     }
    }
   ]
