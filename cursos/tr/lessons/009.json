 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Posesivos",
    "@en": "Possessive"
   },
   "texto": [
    {
     "@es": "**Benim** significa «mi» y **senin**, «tu». El sustantivo recibe la terminación: **benim annem** (mi madre), **senin baban** (tu padre).",
     "@en": "**Benim** means «mi» and **senin**, «You». The noun receives the termination: **benim annem** (my mother), **senin baban** (your father)."
    },
    {
     "@es": "**Onun** significa «su/de él/de ella»: **onun kardeşi** (su hermano/a). En una frase normal, el pronombre posesivo puede omitirse: **Annem öğretmen** (mi madre es profesora).",
     "@en": "**Onun** means «his / her / her»: **onun kardeşi** (his brother). In a normal phrase, the possessive pronoun can be omitted: **Annem öğretmen** (my mother is a teacher)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Adjetivos",
    "@en": "Adjectives"
   },
   "texto": [
    {
     "@es": "El adjetivo va antes del nombre: **büyük aile** (familia grande), **küçük çocuk** (niño pequeño). Los adjetivos no cambian de forma por género o plural.",
     "@en": "The adjective goes before the name: **büyük aile** (large family), **küçük çocuk** (small child). Adjectives do not change by gender or plural."
    },
    {
     "@es": "**Çok** significa «muy/mucho» y va antes del adjetivo: **çok iyi** (muy bueno/a).",
     "@en": "**Çok** means «very / very» and goes before the adjective: **çok iyi** (very good / a)."
    }
   ]
  },
  {
