{
 "capitulo": 3,
 "titulo_tr": "Benim ailem",
 "titulo_es": {
  "@es": "Posesión y descripción familiar",
  "@en": "Possession and family description"
 },
 "palabras": {
  "onun": {
   "es": "su, suyo (de él/ella)",
   "en": "his, his (his / her)",
   "pron": "o-NUN"
  },
  "baban": {
   "es": "tu padre",
   "en": "Your father",
   "pron": "ba-BAN"
  },
