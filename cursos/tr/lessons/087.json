 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Cortesía",
    "@en": "Courtesy"
   },
   "texto": [
    {
     "@es": "**iltifat** = cumplido; **nazik** = amable; **rica etmek** = pedir/ofrecer cortésmente.",
     "@en": "**iltifat** = compliance; **nazik** = friendly; **rica etmek** = request / offer courteously."
    },
    {
     "@es": "Si alguien te ofrece un regalo, puedes agradecerlo y decir **hiç gerek yoktu** («no hacía falta»).",
     "@en": "If someone offers you a gift, you can thank him and say **hiç gerek yoktu** («I didn't have to.»)."
    },
    {
     "@es": "**-meden önce** significa «antes de hacer».",
     "@en": "**-meden önce** means «before you do»."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": {
    "@es": "Recibir invitados",
    "@en": "Receiving guests"
   },
   "palabras": [
    "iltifat",
    "nazik",
    "rica etmek",
    "hiç gerek yoktu",
    "ağırlamak",
    "önceden"
   ]
  },
  {
   "tipo": "dialogo",
   "titulo": {
    "@es": "Antes de la cena",
    "@en": "Before dinner"
   },
   "frases": [
    {
     "quien": "Can",
     "tr": "Konukları kapıda karşılamadan önce sofrayı hazırladık.",
     "es": "Preparamos la mesa antes de recibir a los invitados en la puerta.",
     "en": "We prepared the table before we met the guests at the door."
    },
    {
     "quien": "Ayşe",
     "tr": "Çok güzel ağırladınız, yemek de harikaydı.",
     "es": "Nos recibieron muy bien y la comida estuvo estupenda.",
     "en": "We were very well received and the food was great."
    },
    {
     "quien": "Can",
     "tr": "Güzel sözleriniz için teşekkür ederim. Küçük bir hediye getirmişsiniz!",
     "es": "Gracias por tus palabras. ¡Has traído un pequeño regalo!",
     "en": "Thank you for your words. You brought a little gift!"
    },
    {
     "quien": "Ayşe",
     "tr": "Hiç gerek yoktu, davetiniz yeterliydi.",
     "es": "No hacía falta, la invitación era suficiente.",
     "en": "No need, the invitation was enough."
    }
   ]
  },
