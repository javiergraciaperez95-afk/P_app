     "explicacion": "Önce malzemeyi hazırlıyorum.",
     "correcta": true
    },
    {
     "texto": {
      "@es": "Da forma a la pieza",
      "@en": "It shapes the piece."
     },
     "explicacion": {
      "@es": "Eso ocurre después.",
      "@en": "That happens later."
     }
    },
    {
     "texto": {
      "@es": "Espera a que se seque",
      "@en": "Wait till it dries."
     },
     "explicacion": {
      "@es": "Es el último paso.",
      "@en": "It's the last step."
     }
    }
   ]
  },
