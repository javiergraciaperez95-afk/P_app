 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Actividades",
    "@en": "Activities"
   },
   "texto": [
    {
     "@es": "**uğraş** = actividad/ocupación; **el becerisi** = habilidad manual; **malzeme** = material.",
     "@en": "**uğraş** = activity / occupation; **el becerisi** = manual skill; **malzeme** = material."
    },
    {
     "@es": "**-maktan hoşlanıyorum** significa «disfruto haciendo».",
     "@en": "**-maktan hoşlanıyorum** means «disfruto haciendo»."
    },
    {
     "@es": "Para dar instrucciones, ordena los pasos con **önce**, **ardından** y **son olarak**.",
     "@en": "To give instructions, order the steps with **önce**, **ardından** and **son olarak**."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": {
    "@es": "Hacer cerámica",
    "@en": "Make ceramic"
   },
   "palabras": [
    "uğraş",
    "el becerisi",
    "malzeme",
    "uğraşmak",
    "hoşlanmak",
    "ardından"
   ]
  },
  {
   "tipo": "dialogo",
   "titulo": {
    "@es": "Una afición nueva",
    "@en": "A new hobby"
   },
   "frases": [
    {
     "quien": "Ece",
     "tr": "Seramikle uğraşmaktan hoşlanıyorum. Hem dinleniyorum hem de yeni bir beceri öğreniyorum.",
     "es": "Disfruto haciendo cerámica. Tanto descanso como aprendo una habilidad nueva.",
     "en": "I enjoy making ceramics. As much rest as I learn a new skill."
    },
    {
     "quien": "Anna",
     "tr": "Bir şekli nasıl yapıyorsun?",
     "es": "¿Cómo haces una forma?",
     "en": "How do you make a way?"
    },
    {
     "quien": "Ece",
     "tr": "Önce malzemeyi hazırlıyorum, ardından şekil veriyorum. Son olarak kurumasını bekliyorum.",
     "es": "Primero preparo el material, después le doy forma. Por último espero a que se seque.",
     "en": "First I prepare the material, then I shape it. Finally, I wait for it to dry."
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué significa «el becerisi»?",
    "@en": "What does «el becerisi» mean?"
   },
   "id": "tr016-1",
   "opciones": [
    {
     "texto": "habilidad manual",
     "explicacion": {
      "@es": "El = mano, becerisi = habilidad.",
      "@en": "The = hand, Becerisi = skill."
     },
     "correcta": true
    },
    {
     "texto": "material",
     "explicacion": {
      "@es": "Material es malzeme.",
      "@en": "Material is malzeme."
     }
    },
    {
     "texto": {
      "@es": "forma",
      "@en": "form"
     },
     "explicacion": {
      "@es": "Forma es şekil.",
      "@en": "Form is şekil."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Por qué le gusta a Ece hacer cerámica?",
    "@en": "Why does Ece like to make ceramics?"
   },
   "id": "tr016-2",
   "opciones": [
    {
     "texto": {
      "@es": "Porque descansa y aprende una habilidad",
      "@en": "Because he rests and learns a skill"
     },
     "explicacion": {
      "@es": "Da dos razones.",
      "@en": "It gives two reasons."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Porque es su trabajo",
      "@en": "Because it's his job."
     },
     "explicacion": {
      "@es": "No lo dice.",
      "@en": "He doesn't say."
     }
    },
    {
     "texto": {
      "@es": "Porque puede venderla",
      "@en": "Because he can sell it."
     },
     "explicacion": {
      "@es": "No menciona vender.",
      "@en": "He doesn't mention selling."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
