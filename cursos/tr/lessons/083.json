     },
     "explicacion": {
      "@es": "No menciona ropa.",
      "@en": "He doesn't mention clothes."
     }
    },
    {
     "texto": {
      "@es": "Su billete de autobús",
      "@en": "Your bus ticket"
     },
     "explicacion": {
