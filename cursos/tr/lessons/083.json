 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Incidencias",
    "@en": "Incidences"
   },
   "texto": [
    {
     "@es": "**kayıp** = pérdida; **çalınmak** = ser robado; **karakol** = comisaría.",
     "@en": "**kayıp** = loss; **çalınmak** = to be stolen; **karakol** = police station."
    },
    {
     "@es": "Para explicar qué pasó, incluye cuándo, dónde y qué objeto falta.",
     "@en": "To explain what happened, it includes when, where and what object is missing."
    },
    {
     "@es": "**-miş** puede presentar información que acabas de descubrir: **çantam kaybolmuş** = resulta que mi bolso se ha perdido.",
     "@en": "**-miş** can present information you just discovered: **çantam kaybolmuş** = turns out my bag has been lost."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": {
    "@es": "En la comisaría",
    "@en": "At the police station."
   },
   "palabras": [
    "kayıp",
    "çalınmak",
    "karakol",
    "ifade vermek",
    "çanta",
    "cüzdan"
   ]
  },
  {
   "tipo": "dialogo",
   "titulo": {
    "@es": "Informar de una pérdida",
    "@en": "Report a loss"
   },
   "frases": [
    {
     "quien": "Yolcu",
     "tr": "Çantam otobüste kaybolmuş. İçinde pasaportum ve cüzdanım vardı.",
     "es": "Resulta que mi bolso se perdió en el autobús. Dentro estaban mi pasaporte y mi cartera.",
     "en": "Turns out my bag got lost on the bus. There was my passport and my wallet inside."
    },
    {
     "quien": "Polis",
     "tr": "En son ne zaman gördünüz?",
     "es": "¿Cuándo lo vio por última vez?",
     "en": "When did you last see him?"
    },
    {
     "quien": "Yolcu",
     "tr": "Bugün saat üçte. İfade vermem gerekiyor mu?",
     "es": "Hoy a las tres. ¿Tengo que declarar?",
     "en": "Today at 3: 00. Do I have to testify?"
    },
    {
     "quien": "Polis",
     "tr": "Evet, lütfen bu formu doldurun.",
     "es": "Sí, por favor, rellene este formulario.",
     "en": "Yes, please fill in this form."
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué significa «çalınmak»?",
    "@en": "What does «çalınmak» mean?"
   },
   "id": "tr020-1",
   "opciones": [
    {
     "texto": "ser robado",
     "explicacion": {
      "@es": "El verbo describe una cosa sustraída por alguien.",
      "@en": "The verb describes a thing taken away by someone."
     },
     "correcta": true
    },
    {
     "texto": "declarar",
     "explicacion": {
      "@es": "Declarar es ifade vermek.",
      "@en": "Declaring is ifade vermek."
     }
    },
    {
     "texto": {
      "@es": "rellenar",
      "@en": "fill in"
     },
     "explicacion": {
      "@es": "Rellenar es doldurmak.",
      "@en": "Filling is doldurmak."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
