 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Colores y adjetivos",
    "@en": "Colors and adjectives"
   },
   "texto": [
    {
     "@es": "Los colores van antes del nombre: **kırmızı araba** (coche rojo), **mavi çanta** (bolso azul).",
     "@en": "The colors go before the name: **kırmızı araba** (red car), **mavi çanta** (blue bag)."
    },
    {
     "@es": "El adjetivo no cambia por género o plural: **güzel ev**, **güzel evler** (casa bonita, casas bonitas).",
     "@en": "The adjective does not change by gender or plural: **güzel ev**, **güzel evler** (pretty house, pretty houses)."
    },
    {
     "@es": "Para decir «esto es…», usa **Bu…**; **şu** señala algo más apartado y **o** algo lejano.",
     "@en": "To say «This is», use **Bu…**; **şu** points out something more remote and **o** something far away."
    }
   ]
  },
