  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Dónde se coloca normalmente el color?",
    "@en": "Where is the color usually placed?"
   },
   "id": "tr019-1",
   "opciones": [
    {
     "texto": {
      "@es": "Antes del nombre",
      "@en": "Before the name"
     },
     "explicacion": {
      "@es": "Mavi çanta = bolso azul.",
      "@en": "Mavi çanta = blue bag."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Después del nombre",
      "@en": "After the name"
     },
     "explicacion": {
      "@es": "El adjetivo va antes del sustantivo.",
      "@en": "The adjective goes before the noun."
     }
    },
    {
     "texto": {
      "@es": "Al principio siempre",
      "@en": "At the beginning always"
     },
     "explicacion": {
      "@es": "Puede ir al principio de la frase, pero modifica al nombre.",
      "@en": "It can go to the beginning of the sentence, but it changes the name."
     }
    }
   ]
  },
