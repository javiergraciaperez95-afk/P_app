 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Decir la hora",
    "@en": "Tell the time"
   },
   "texto": [
    {
     "@es": "**Saat kaç?** = ¿qué hora es? Para la hora en punto se usa **Saat üç** (son las tres). Para decir «a las tres», añade **-te/-ta**: **Saat üçte**.",
     "@en": "**Saat kaç?** = what time is it? **Saat üç** is used for the hour in point (three o'clock). To say «on three.», add **-te/-ta**: **Saat üçte**."
    },
    {
     "@es": "**Saat yedide** = a las siete; **Saat dokuzda** = a las nueve. El sufijo locativo se ajusta a la última vocal y consonante.",
     "@en": "**Saat yedide** = at seven; **Saat dokuzda** = at nine. The locative suffix fits the last vocal and consonant."
    },
    {
     "@es": "**Önce** significa «antes» y **sonra**, «después».",
     "@en": "**Önce** means «before» and **sonra**, «after»."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Días de la semana",
    "@en": "Days of the week"
   },
   "texto": [
    {
     "@es": "Los días no se escriben con mayúscula: **pazartesi, salı, çarşamba, perşembe, cuma, cumartesi, pazar**.",
     "@en": "The days are not written with capital: **pazartesi, salı, çarşamba, perşembe, cuma, cumartesi, pazar**."
    },
    {
     "@es": "**Pazartesi günü** = el lunes (literalmente, el día lunes). **Hafta sonu** significa «fin de semana».",
     "@en": "**Pazartesi günü** = Monday (literally Monday). **Hafta sonu** means «weekend»."
    }
   ]
  },
  {
