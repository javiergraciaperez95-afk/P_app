   "texto": [
    {
     "@es": "**alışkanlık** = hábito; **beslenme** = alimentación; **egzersiz** = ejercicio.",
     "@en": "**alışkanlık** = habit; **beslenme** = feeding; **egzersiz** = exercise."
    },
    {
     "@es": "**bırakmak** significa dejar/abandonar; **başlamak** = empezar.",
     "@en": "**bırakmak** means to leave / leave; **başlamak** = start."
    },
    {
     "@es": "Para animar a alguien, puedes usar **denemeye ne dersin?** («¿qué te parece probar?»).",
     "@en": "To encourage someone, you can use **denemeye ne dersin?** («What do you think to prove?»)."
    }
   ]
