     "es": "¿Siempre sales a caminar?",
     "en": "You always go for a walk?"
    },
    {
     "quien": "Anna",
     "tr": "Hayır, hiçbir zaman yağmurda yürüyüş yapmam.",
     "es": "No, nunca paseo bajo la lluvia.",
     "en": "No, never walk in the rain."
    }
   ]
