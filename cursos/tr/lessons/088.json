 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Ordenar un relato",
    "@en": "Order a story"
   },
   "texto": [
    {
     "@es": "**-yordu** describe lo que estaba ocurriendo: **otobüsü bekliyordum** = estaba esperando el autobús.",
     "@en": "**-yordu** describes what was happening: **otobüsü bekliyordum** = was waiting for the bus."
    },
    {
     "@es": "**-dığında** significa «cuando»: **eve geldiğimde** = cuando llegué a casa.",
     "@en": "**-dığında** means «when»: **eve geldiğimde** = when I got home."
    },
    {
     "@es": "Conecta los hechos con **tam o sırada** («justo entonces») y **sonunda** («al final»).",
     "@en": "Connect the facts with **tam o sırada** («justo entonces») and **sonunda** («at the end»)."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": {
    "@es": "Un imprevisto",
    "@en": "One unforeseen."
   },
   "palabras": [
    "-yordu",
    "tam o sırada",
    "sonunda",
    "fark etmek",
    "telaşlanmak"
   ]
  },
  {
   "tipo": "dialogo",
   "titulo": {
    "@es": "En la parada",
    "@en": "At the stop"
   },
   "frases": [
    {
     "quien": "Ali",
     "tr": "Otobüsü bekliyordum, tam o sırada cüzdanım yere düştü.",
     "es": "Estaba esperando el autobús y justo entonces se me cayó la cartera.",
     "en": "I was waiting for the bus and then I dropped my wallet."
    },
    {
     "quien": "Deniz",
     "tr": "Ne zaman fark ettin?",
     "es": "¿Cuándo te diste cuenta?",
     "en": "When did you notice?"
    },
    {
     "quien": "Ali",
     "tr": "Otobüs geldiğinde yerde gördüm ve çok telaşlandım.",
     "es": "Cuando llegó el autobús, la vi en el suelo y me puse muy nervioso.",
     "en": "When the bus came, I saw her on the floor and I got really nervous."
    },
    {
     "quien": "Deniz",
     "tr": "Sonunda ne oldu?",
     "es": "¿Qué pasó al final?",
     "en": "What happened at the end?"
    },
    {
     "quien": "Ali",
     "tr": "Bir görevli buldu. Cüzdanımı geri aldım.",
     "es": "Un empleado la encontró. Recuperé mi cartera.",
     "en": "An employee found her. I got my wallet back."
    }
   ]
  },
  {
   "tipo": "test",
