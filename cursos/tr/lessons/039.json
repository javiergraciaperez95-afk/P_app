    "@es": "Horarios",
    "@en": "Timetable"
   },
   "texto": [
    {
     "@es": "**öğle yemeği** = almuerzo; **akşam yemeği** = cena; **boş zaman** = tiempo libre.",
     "@en": "**öğle yemeği** = lunch; **akşam yemeği** = dinner; **boş zaman** = free time."
    },
    {
     "@es": "**-dan önce/sonra** se une a un nombre: **işten sonra** = después del trabajo.",
     "@en": "**-dan önce/sonra** is attached to a name: **işten sonra** = after work."
    },
    {
     "@es": "**Saat kaçta?** pregunta «¿a qué hora?».",
     "@en": "**Saat kaçta?** asks «What time?»."
    }
   ]
  },
