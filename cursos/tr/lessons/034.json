 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Comparaciones",
    "@en": "Comparations"
   },
   "texto": [
    {
     "@es": "**-den/-dan** puede marcar el punto de comparación: **Ali Ayşe'den daha kısa** = Ali es más bajo que Ayşe.",
     "@en": "**-den/-dan** can mark the comparison point: **Ali Ayşe'den daha kısa** = Ali is lower than Ayşe."
    },
    {
     "@es": "**en** expresa el grado máximo: **en çalışkan öğrenci** = el/la estudiante más aplicado/a. La armonía vocálica elige la variante del sufijo.",
     "@en": "**en** expresses the maximum degree: **en çalışkan öğrenci** = the most applied student. Vocal harmony chooses the variant of the suffix."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": {
    "@es": "Comparar",
    "@en": "Compare"
   },
   "palabras": [
    "öğrenci daha",
    "Ayşe'den",
    "benim"
   ]
  },
  {
   "tipo": "dialogo",
   "titulo": {
    "@es": "En clase",
    "@en": "In class"
   },
   "frases": [
    {
     "quien": "Can",
     "tr": "Ali Ayşe'den daha kısa.",
     "es": "Ali es más bajo que Ayşe.",
     "en": "Ali is lower than Ayşe."
    },
    {
     "quien": "Deniz",
     "tr": "Evet, ama Ali en çalışkan öğrenci.",
     "es": "Sí, pero Ali es el estudiante más aplicado.",
     "en": "Yeah, but Ali's the most applied student."
    },
    {
     "quien": "Can",
     "tr": "Benim arkadaşım da çok çalışkan.",
     "es": "Mi amigo también es muy aplicado.",
     "en": "My friend is also very applied."
    },
    {
     "quien": "Deniz",
     "tr": "İkiniz de çok iyisiniz.",
     "es": "Los dos sois muy buenos.",
     "en": "You're both very good."
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
