    "@en": "What role does «-den» have in Ayşe-den?"
   },
   "id": "tr003-1",
   "opciones": [
    {
     "texto": {
      "@es": "Marca «que Ayşe» en la comparación",
      "@en": "«que Ayşe» mark in comparison"
     },
     "explicacion": {
      "@es": "Separa a la persona usada como referencia.",
      "@en": "Separate the person used as a reference."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Significa «con Ayşe»",
      "@en": "Means «con Ayşe»"
     },
     "explicacion": {
      "@es": "«Con» sería Ayşe'yle.",
      "@en": "«With» would be Ayşe-yle."
     }
    },
    {
     "texto": {
      "@es": "Significa «para Ayşe»",
      "@en": "Means «para Ayşe»"
     },
     "explicacion": {
      "@es": "«Para» sería Ayşe için.",
      "@en": "«Stop.» would be Ayşe için."
     }
    }
   ]
  },
