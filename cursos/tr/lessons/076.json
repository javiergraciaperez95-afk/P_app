 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Resumir un boletín",
    "@en": "Summarize a newsletter"
   },
   "texto": [
    {
     "@es": "**duyuru** = anuncio; **yayın** = emisión; **uyarı** = advertencia.",
     "@en": "**duyuru** = ad; **yayın** = issue; **uyarı** = warning."
    },
    {
     "@es": "Para resumir una noticia, menciona el hecho principal, el lugar y la hora.",
     "@en": "To summarize a news, he mentions the main fact, the place and the time."
    },
    {
     "@es": "**-dığı bildirildi** significa «se informó que...»: **yolun kapandığı bildirildi** = se informó que la carretera estaba cerrada.",
     "@en": "**-dığı bildirildi** means «it was reported that...»: **yolun kapandığı bildirildi** = the road was reported to be closed."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": {
    "@es": "Un boletín de tráfico",
    "@en": "A traffic bulletin"
   },
   "palabras": [
    "duyuru",
    "yayın",
    "uyarı",
    "ana yol",
    "kapanmak",
    "kaza",
    "bildirmek"
   ]
  },
  {
   "tipo": "dialogo",
   "titulo": {
    "@es": "Aviso en la radio",
    "@en": "Radio warning"
   },
   "frases": [
    {
     "quien": "Spiker",
     "tr": "Ana yolda bir kaza olduğu bildirildi.",
     "es": "Se informó de que hubo un accidente en la carretera principal.",
     "en": "An accident was reported on the main road."
    },
    {
     "quien": "Spiker",
     "tr": "Bu nedenle yolun kapandığı bildirildi.",
     "es": "Por este motivo, se informó de que la carretera estaba cerrada.",
     "en": "For this reason, it was reported that the road was closed."
    },
    {
     "quien": "Spiker",
     "tr": "Sürücülerin alternatif yolu kullanmaları öneriliyor.",
     "es": "Se recomienda a los conductores usar una ruta alternativa.",
     "en": "Drivers are recommended to use an alternative route."
    },
    {
     "quien": "Spiker",
     "tr": "Yeni bilgi saat onda verilecek.",
     "es": "Se darán nuevas noticias a las diez.",
     "en": "New news will be given at ten."
    }
   ]
  },
