   "texto": [
    {
     "@es": "**temizlik** = limpieza; **çamaşır** = ropa para lavar; **bulaşık** = platos.",
     "@en": "**temizlik** = cleaning; **çamaşır** = washing clothes; **bulaşık** = dishes."
