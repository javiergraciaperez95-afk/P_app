      "@en": "Invite is davet etmek."
     }
    },
    {
     "texto": {
      "@es": "llegar tarde",
      "@en": "I'm late."
     },
     "explicacion": {
      "@es": "Llegar es gelmek.",
      "@en": "Getting there is gelmek."
     }
    }
   ]
  },
  {
