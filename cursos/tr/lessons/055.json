 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Invitaciones y posibilidad",
    "@en": "Invitations and possibility"
   },
   "texto": [
    {
     "@es": "**davet etmek** = invitar; **katılmak** = asistir/participar.",
     "@en": "**davet etmek** = invite; **katılmak** = attend / participate."
    },
    {
     "@es": "**Belki** = quizás; **muhtemelen** = probablemente.",
     "@en": "**Belki** = maybe; **muhtemelen** = probably."
    },
    {
     "@es": "**yağmur yağabilir** = puede que llueva; **gelebilirim** = quizá pueda venir.",
     "@en": "**yağmur yağabilir** = may rain; **gelebilirim** = may come."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": {
    "@es": "Una invitación",
    "@en": "An invitation"
   },
   "palabras": [
    "davet",
    "katılmak",
    "belki",
    "muhtemelen",
    "yağmur yağabilir",
    "gelebilirim",
    "kusura bakmayın"
   ]
  },
  {
   "tipo": "dialogo",
   "titulo": {
    "@es": "Una fiesta el sábado",
    "@en": "A party on Saturday"
   },
   "frases": [
    {
     "quien": "Ece",
     "tr": "Cumartesi akşamı partimize katılır mısın?",
     "es": "¿Vendrás a nuestra fiesta el sábado por la noche?",
     "en": "Are you coming to our party Saturday night?"
    },
    {
     "quien": "Ali",
     "tr": "Çok isterim. Belki biraz geç gelebilirim.",
     "es": "Me encantaría. Quizá llegue un poco tarde.",
     "en": "I'd love to. Maybe he's a little late."
    },
    {
     "quien": "Ece",
     "tr": "Sorun değil. Hava yağmurlu olabilir.",
     "es": "No pasa nada. Puede que llueva.",
     "en": "It's okay. It may rain."
    },
    {
     "quien": "Ali",
     "tr": "O zaman taksiyle gelirim.",
     "es": "Entonces iré en taxi.",
     "en": "Then I'll go by taxi."
    }
   ]
  },
  {
