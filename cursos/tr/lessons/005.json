 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Profesión",
    "@en": "Profession"
   },
   "texto": [
    {
     "@es": "**Mesleğin ne?** = ¿cuál es tu profesión? La respuesta **Öğretmenim** significa «soy profesor/a».",
     "@en": "**Mesleğin ne?** = what is your profession? The **Öğretmenim** response means «I'm a teacher.»."
    },
    {
     "@es": "**Ben doktorum** = soy médico/a. El turco normalmente no usa un verbo separado para «ser» en presente: la terminación se une al nombre.",
     "@en": "**Ben doktorum** = I'm a doctor. The Turkish usually does not use a separate verb for «be» present: the termination is attached to the name."
    },
    {
     "@es": "**O** significa «él, ella» o «eso»; el contexto aclara el sentido.",
     "@en": "**O** means «He, she» or «That.»; the context clarifies the meaning."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Idiomas y hablar",
    "@en": "Languages and speak"
   },
   "texto": [
    {
     "@es": "El sufijo **-ca/-ce** puede formar el nombre de una lengua: **Türkçe** (turco), **İngilizce** (inglés), **İspanyolca** (español).",
     "@en": "The **-ca/-ce** suffix can form the name of a language: **Türkçe** (Turkish), **İngilizce** (English), **İspanyolca** (Spanish)."
    },
    {
     "@es": "**Konuşuyorum** = hablo; **konuşuyor musun?** = ¿hablas? La partícula interrogativa se escribe separada.",
     "@en": "**Konuşuyorum** = I speak; **konuşuyor musun?** = do you speak? The question particle is written separately."
    },
    {
     "@es": "**Biraz** significa «un poco».",
     "@en": "**Biraz** means «A little.»."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": {
    "@es": "Trabajo e idiomas",
    "@en": "Work and languages"
   },
