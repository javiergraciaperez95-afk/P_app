   "texto": [
    {
     "@es": "El poseedor lleva **-(n)ın/in/un/ün** y el objeto un sufijo posesivo: **okulun kapısı** = la puerta de la escuela.",
     "@en": "The owner carries **-(n)ın/in/un/ün** and the object a possessive suffix: **okulun kapısı** = the school door."
    },
    {
     "@es": "Después de nombre propio se escribe apóstrofo: **Ece'nin kitabı**.",
     "@en": "After its own name, it is written apothrophus: **Ece'nin kitabı**."
    }
   ]
  },
