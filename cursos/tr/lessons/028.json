   "texto": [
    {
     "@es": "**Baş** = cabeza; **karın** = barriga; **boğaz** = garganta; **diş** = diente.",
     "@en": "**Baş** = head; **karın** = belly; **boğaz** = throat; **diş** = tooth."
    },
    {
     "@es": "**Başım ağrıyor** = me duele la cabeza (literalmente, mi cabeza duele). El sufijo **-ım** significa «mi».",
     "@en": "**Başım ağrıyor** = my head hurts (literally, my head hurts). The **-ım** suffix means «mi»."
    },
    {
     "@es": "**Hastayım** = estoy enfermo/a; **iyiyim** = estoy bien. **Doktor** es médico y **eczane**, farmacia.",
     "@en": "**Hastayım** = I'm sick; **iyiyim** = I'm fine. **Doktor** is a doctor and **eczane** is a pharmacy."
    }
