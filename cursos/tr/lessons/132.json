      "@en": "That person would be six."
     }
    },
    {
     "texto": {
      "@es": "Tercera persona",
      "@en": "Third person"
     },
     "explicacion": {
      "@es": "No es una forma de o.",
      "@en": "It's not a form of o."
     }
    }
   ]
  },
  {
