{
 "capitulo": 2,
 "titulo_tr": "İsim cümlelerinde kişi",
 "titulo_es": {
  "@es": "La persona en frases nominales",
  "@en": "The person in nominal phrases"
 },
 "palabras": {
  "Biz yorgunuz": {
   "es": "estamos cansados",
   "en": "We're tired.",
   "oculta": true
  },
  "Ben öğrenciyim": {
   "es": "soy estudiante",
   "en": "I'm a student.",
   "oculta": true
  },
  "Ben de öğrenciyim": {
   "es": "yo también soy estudiante",
   "en": "I'm a student, too.",
   "oculta": true
  },
  "Ece öğretmen mi": {
   "es": "¿Ece es profesora?",
   "en": "Is Ece a teacher?",
   "oculta": true
  },
  "Hayır Ece doktor": {
   "es": "no Ece es médica",
   "en": "No, Ece's a doctor.",
   "oculta": true
  }
 },
 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Terminaciones personales",
    "@en": "Personal terminations"
   },
   "texto": [
    {
     "@es": "**Ben öğretmenim** = soy profesor/a; **sen öğrencisin** = eres estudiante; **biz yorgunuz** = estamos cansados.",
     "@en": "**Ben öğretmenim** = I am a teacher; **sen öğrencisin** = you are a student; **biz yorgunuz** = we are tired."
    },
    {
     "@es": "En turco, el pronombre puede omitirse si la terminación ya muestra la persona.",
     "@en": "In Turkish, the pronoun can be omitted if the termination already shows the person."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": {
    "@es": "Personas y estados",
    "@en": "Persons and States"
   },
   "palabras": []
  },
  {
