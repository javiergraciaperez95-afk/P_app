 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Proteger el entorno",
    "@en": "Protecting the environment"
   },
   "texto": [
    {
     "@es": "**kirlilik** = contaminación; **tasarruf** = ahorro; **atık** = residuo.",
     "@en": "**kirlilik** = pollution; **tasarruf** = savings; **atık** = residue."
    },
    {
     "@es": "**-dığı için** enlaza una causa; **bu nedenle** introduce una consecuencia.",
     "@en": "**-dığı için** links a cause; **bu nedenle** introduces a consequence."
    },
    {
     "@es": "Las instrucciones claras suelen combinar una acción y su propósito.",
     "@en": "Clear instructions often combine an action and its purpose."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": {
    "@es": "Acciones pequeñas",
    "@en": "Small actions"
   },
   "palabras": [
    "kirlilik",
    "tasarruf",
    "atık",
    "çevre koruma",
    "enerji",
    "azaltmak",
    "geri dönüşüm"
   ]
  },
  {
   "tipo": "dialogo",
   "titulo": {
    "@es": "Una propuesta vecinal",
    "@en": "A neighbouring proposal"
   },
   "frases": [
    {
     "quien": "Deniz",
     "tr": "Eskiden bu dere daha temizdi. Şimdi kirlilik arttı.",
     "es": "Antes este arroyo estaba más limpio. Ahora aumentó la contaminación.",
     "en": "This stream was cleaner before. Now the pollution has increased."
    },
    {
     "quien": "Can",
     "tr": "Çünkü bazı insanlar atıkları suya bırakıyor.",
     "es": "Porque algunas personas dejan residuos en el agua.",
     "en": "Because some people leave waste in the water."
    },
    {
     "quien": "Deniz",
     "tr": "Bu nedenle geri dönüşüm kutuları koyalım.",
     "es": "Por este motivo, pongamos contenedores de reciclaje.",
     "en": "For this reason, let's put in recycling containers."
    },
    {
     "quien": "Can",
     "tr": "Ayrıca evde su ve enerji tasarrufu yapabiliriz.",
     "es": "Además, podemos ahorrar agua y energía en casa.",
     "en": "Besides, we can save water and energy at home."
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué significa «kirlilik»?",
    "@en": "What does «kirlilik» mean?"
   },
   "id": "tr028-1",
   "opciones": [
    {
     "texto": "contaminación",
     "explicacion": {
      "@es": "Kirlilik describe el daño causado al entorno.",
      "@en": "Kirlik describes the damage caused to the environment."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "ahorro",
      "@en": "savings"
     },
     "explicacion": {
      "@es": "Ahorro es tasarruf.",
      "@en": "Saving is tasarruf."
     }
    },
    {
     "texto": {
      "@es": "residuos",
      "@en": "waste"
     },
     "explicacion": {
      "@es": "Residuos es atıklar.",
      "@en": "Waste is atıklar."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
