      "@en": "Can identifies that cause."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Hay demasiados contenedores",
      "@en": "There are too many containers."
     },
     "explicacion": {
      "@es": "No lo dice.",
      "@en": "He doesn't say."
     }
    },
    {
     "texto": {
      "@es": "La energía es cara",
      "@en": "Energy is expensive"
     },
     "explicacion": {
      "@es": "No menciona precios.",
      "@en": "He doesn't mention prices."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
