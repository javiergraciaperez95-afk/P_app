      "@en": "Dry is kuruydu."
     }
    },
    {
     "texto": {
      "@es": "Estaba más contaminado",
      "@en": "It was more contaminated."
     },
     "explicacion": {
      "@es": "Dice lo contrario.",
      "@en": "He says otherwise."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
