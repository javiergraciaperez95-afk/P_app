      "@en": "He doesn't propose to close it."
     }
    },
    {
     "texto": {
      "@es": "Dejar de ahorrar agua",
      "@en": "Stop saving water"
     },
     "explicacion": {
      "@es": "Propone ahorrar agua.",
      "@en": "He proposes to save water."
