 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Hablar del tiempo",
    "@en": "Talk about time"
   },
   "texto": [
    {
     "@es": "**Hava nasıl?** = ¿qué tiempo hace? **Hava güzel** = hace buen tiempo.",
     "@en": "**Hava nasıl?** = what time does it make? **Hava güzel** = good weather."
    },
    {
     "@es": "**Yağmur yağıyor** = llueve (literalmente, cae lluvia); **kar yağıyor** = nieva. **Güneşli** significa soleado y **bulutlu**, nublado.",
     "@en": "**Yağmur yağıyor** = rain (literally, rain falls); **kar yağıyor** = nieva. **Güneşli** means sunny and **bulutlu**, cloudy."
    },
    {
     "@es": "Para decir la temperatura: **Hava sıcak** (hace calor) o **hava soğuk** (hace frío).",
     "@en": "To tell the temperature: **Hava sıcak** (it's hot) or **hava soğuk** (it's cold)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Estaciones",
    "@en": "Stations"
   },
   "texto": [
    {
     "@es": "**İlkbahar** = primavera; **yaz** = verano; **sonbahar** = otoño; **kış** = invierno.",
     "@en": "**İlkbahar** = spring; **yaz** = summer; **sonbahar** = autumn; **kış** = winter."
    },
    {
     "@es": "**-de/-da** también puede indicar la estación: **yazın** (en verano), **kışın** (en invierno).",
     "@en": "**-de/-da** can also indicate the season: **yazın** (in summer), **kışın** (in winter)."
    }
   ]
  },
