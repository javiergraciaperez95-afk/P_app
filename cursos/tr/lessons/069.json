  {
   "tipo": "dialogo",
   "titulo": {
    "@es": "Una recomendación",
    "@en": "One recommendation"
   },
   "frases": [
    {
     "quien": "Elif",
     "tr": "Bu ceket sana yakışıyor ama kumaşı biraz kalın.",
     "es": "Esta chaqueta te queda bien, pero la tela es un poco gruesa.",
     "en": "This jacket suits you, but the fabric is a little thick."
    },
    {
     "quien": "Deniz",
     "tr": "Rahatlık benim için önemli.",
     "es": "La comodidad es importante para mí.",
     "en": "The comfort is important to me."
    },
    {
     "quien": "Elif",
     "tr": "Bence daha hafif bir ceket daha iyi olur.",
     "es": "En mi opinión, sería mejor una chaqueta más ligera.",
     "en": "In my opinion, a lighter jacket would be better."
    },
    {
     "quien": "Deniz",
     "tr": "Haklısın, spor kıyafetleri daha çok seviyorum.",
     "es": "Tienes razón, me gusta más la ropa deportiva.",
     "en": "You're right, I like sports clothes better."
    }
   ]
  },
