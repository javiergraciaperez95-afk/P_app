  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Hablar de moda",
    "@en": "Talk about fashion"
   },
   "texto": [
    {
     "@es": "**eğilim** = tendencia; **rahatlık** = comodidad; **şık** = elegante.",
     "@en": "**eğilim** = trend; **rahatlık** = comfort; **şık** = elegant."
    },
    {
     "@es": "Para aconsejar puedes usar **bence ... daha iyi olur** («en mi opinión, sería mejor...»).",
     "@en": "To advise you can use **bence ... daha iyi olur** («In my opinion, it would be better...»)."
    },
    {
     "@es": "**-den ziyade** presenta una preferencia: **rahatlıktan ziyade şıklık** = elegancia antes que comodidad.",
     "@en": "**-den ziyade** presents a preference: **rahatlıktan ziyade şıklık** = elegance rather than comfort."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": {
    "@es": "Elegir ropa",
    "@en": "Choose clothes"
   },
   "palabras": [
