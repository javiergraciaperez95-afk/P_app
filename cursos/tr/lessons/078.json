    {
     "@es": "Los anuncios suelen destacar beneficios, pero hay que revisar las condiciones y la fecha de validez.",
     "@en": "The ads often highlight benefits, but the conditions and the date of validity need to be reviewed."
    },
    {
     "@es": "**-dığı sürece** significa «mientras/siempre que».",
     "@en": "**-dığı sürece** means «while / always»."
    }
   ]
