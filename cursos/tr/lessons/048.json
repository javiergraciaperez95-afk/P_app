     "quien": "İşveren",
     "tr": "Ne tür bir iş arıyorsunuz?",
     "es": "¿Qué tipo de trabajo busca?",
     "en": "What kind of work are you looking for?"
    },
    {
     "quien": "Başvuran",
     "tr": "Maaşı iyi ve çalışma saatleri uygun bir iş.",
     "es": "Un trabajo con buen salario y horario conveniente.",
     "en": "A job with good pay and convenient time."
    }
   ]
