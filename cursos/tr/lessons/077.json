     "tr": "Bu paylaşımda haberin kaynağı yazıyor mu?",
     "es": "¿En esta publicación aparece la fuente de la noticia?",
     "en": "Does the source of the news appear in this publication?"
    },
    {
     "quien": "Ali",
     "tr": "Hayır, yalnızca dikkat çekici bir başlık var.",
     "es": "No, solo hay un titular llamativo.",
     "en": "No, there's only one striking headline."
    },
    {
     "quien": "Elif",
     "tr": "O zaman bilgiyi başka bir yerden doğrulayalım.",
     "es": "Entonces verifiquemos la información en otro lugar.",
     "en": "Then let's check the information somewhere else."
    },
    {
     "quien": "Ali",
     "tr": "Evet, güvenilir bir kaynak bulmadan paylaşmamalıyız.",
     "es": "Sí, no deberíamos compartirla sin encontrar una fuente fiable.",
     "en": "Yeah, we shouldn't share it without finding a reliable source."
    }
   ]
