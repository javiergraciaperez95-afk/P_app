 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Negación verbal",
    "@en": "Oral denial"
   },
   "texto": [
    {
     "@es": "En el presente, coloca **-m-** antes de **-iyor**: **çalışıyorum → çalışmıyorum**.",
     "@en": "In the present, place **-m-** before **-iyor**: **çalışıyorum → çalışmıyorum**."
    },
    {
     "@es": "Para preguntar, usa la partícula separada: **Çalışmıyor musun?** = ¿No estás trabajando?",
     "@en": "To ask, use the separate particle: **Çalışmıyor musun?** = Aren't you working?"
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": {
    "@es": "Afirmar y negar",
    "@en": "Affirm and deny"
   },
   "palabras": [
    "çalışmak",
    "dinlenmek",
    "ders"
   ]
  },
  {
   "tipo": "dialogo",
   "titulo": "Evde",
   "frases": [
    {
     "quien": "Mert",
     "tr": "Şimdi ders çalışıyor musun?",
     "es": "¿Estás estudiando ahora?",
     "en": "Are you studying now?"
    },
    {
     "quien": "Ece",
     "tr": "Hayır, çalışmıyorum.",
     "es": "No, no estoy estudiando.",
     "en": "No, I'm not studying."
    },
    {
     "quien": "Mert",
     "tr": "Dinleniyor musun?",
     "es": "¿Estás descansando?",
     "en": "Are you resting?"
    },
    {
     "quien": "Ece",
     "tr": "Evet, biraz dinleniyorum.",
     "es": "Sí, estoy descansando un poco.",
     "en": "Yeah, I'm resting a little."
    }
   ]
  },
