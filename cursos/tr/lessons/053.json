     "quien": "Ali",
     "tr": "Kaç gün kalacaksın?",
     "es": "¿Cuántos días te quedarás?",
     "en": "How many days will you stay?"
    },
    {
     "quien": "Ece",
     "tr": "İki hafta kalacağım. Sonra tatile gideceğim.",
     "es": "Me quedaré dos semanas. Después me iré de vacaciones.",
     "en": "I'll stay for two weeks. I'll go on vacation later."
    }
   ]
