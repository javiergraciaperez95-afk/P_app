 },
 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Expresar emociones",
    "@en": "Expression of emotions"
   },
   "texto": [
    {
     "@es": "**hayal kırıklığı** = decepción; **endişeli** = preocupado/a; **gururlu** = orgulloso/a.",
     "@en": "**hayal kırıklığı** = disappointment; **endişeli** = concerned; **gururlu** = proud."
    },
    {
     "@es": "**-dığı için** puede explicar una emoción: **sınavı geçtiğim için mutluyum** = estoy feliz porque aprobé el examen.",
     "@en": "**-dığı için** can explain an emotion: **sınavı geçtiğim için mutluyum** = I'm happy because I passed the test."
    },
    {
     "@es": "En una carta personal, ordena los hechos y añade una despedida cercana.",
     "@en": "In a personal letter, he orders the facts and adds a close farewell."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": {
    "@es": "Una carta",
    "@en": "A letter"
   },
   "palabras": [
    "hayal kırıklığı",
    "endişeli",
    "gururlu",
    "mutluyum",
    "mektup",
    "başarı"
   ]
  },
  {
   "tipo": "texto",
   "titulo": {
    "@es": "El mensaje de Elif",
    "@en": "The message of Eif"
   },
   "frases": [
    {
     "tr": "Sevgili Anna, geçen hafta sınav sonucumu aldım.",
     "es": "Querida Anna, la semana pasada recibí el resultado de mi examen.",
     "en": "Dear Anna, last week I got the result of my test."
    },
    {
     "tr": "Sınavı geçtiğim için çok mutluyum; ailem de benimle gurur duyuyor.",
     "es": "Estoy muy feliz porque aprobé el examen; mi familia también está orgullosa de mí.",
     "en": "I'm very happy because I passed the test; my family is proud of me too."
    },
    {
     "tr": "Sonuç açıklanana kadar endişeliydim.",
     "es": "Estuve preocupada hasta que se anunció el resultado.",
     "en": "I was worried until the result was announced."
    },
    {
     "tr": "Senin haberlerini de bekliyorum. Sevgiler, Elif.",
     "es": "También espero tener noticias tuyas. Un abrazo, Elif.",
     "en": "I hope I have news of you, too. A hug, Elif."
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué significa «hayal kırıklığı»?",
    "@en": "What does «hayal kırıklığı» mean?"
   },
   "id": "tr003-1",
   "opciones": [
    {
     "texto": {
      "@es": "decepción",
      "@en": "disappointment"
     },
     "explicacion": {
      "@es": "Es una emoción ante un resultado peor de lo esperado.",
      "@en": "It's an emotion to a worse result than expected."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "orgullo",
      "@en": "pride"
     },
     "explicacion": {
      "@es": "Orgullo es gurur.",
      "@en": "Pride is gurur."
     }
    },
    {
     "texto": {
      "@es": "preocupación",
      "@en": "of concern"
     },
     "explicacion": {
      "@es": "Preocupación es endişe.",
      "@en": "Concern is endişe."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Por qué está feliz Elif?",
    "@en": "Why is Elif happy?"
   },
   "id": "tr003-2",
   "opciones": [
    {
     "texto": {
      "@es": "Porque aprobó el examen",
      "@en": "Because he passed the test."
     },
     "explicacion": "Sınavı geçtiği için mutlu.",
     "correcta": true
    },
    {
     "texto": {
      "@es": "Porque recibió una carta",
      "@en": "Because he got a letter."
     },
     "explicacion": {
      "@es": "No es la causa que menciona.",
      "@en": "It's not the cause he mentions."
     }
    },
    {
     "texto": {
      "@es": "Porque va a viajar",
      "@en": "Because he's going to travel"
     },
     "explicacion": {
      "@es": "No aparece un viaje.",
      "@en": "There's no trip."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Cómo se sentía antes del resultado?",
    "@en": "How did you feel before the result?"
   },
   "id": "tr003-3",
   "opciones": [
    {
     "texto": {
      "@es": "Preocupada",
      "@en": "Concerned"
     },
     "explicacion": "Endişeliydim.",
     "correcta": true
    },
    {
     "texto": {
      "@es": "Orgullosa",
      "@en": "Proud"
     },
     "explicacion": {
      "@es": "Su familia está orgullosa.",
      "@en": "His family is proud."
     }
    },
    {
     "texto": "Decepcionada",
     "explicacion": {
      "@es": "No dice que estuviera decepcionada.",
      "@en": "She doesn't say she was disappointed."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué significa «sevgili» al comienzo de la carta?",
    "@en": "What does «sevgili» mean at the beginning of the letter?"
   },
   "id": "tr003-4",
   "opciones": [
    {
     "texto": {
      "@es": "querida",
      "@en": "My dear."
     },
     "explicacion": {
      "@es": "Es una forma cariñosa de dirigirse a una amistad.",
      "@en": "It's a loving way to address a friendship."
     },
     "correcta": true
    },
    {
     "texto": "saludos afectuosos",
     "explicacion": {
      "@es": "Sevgiler va al final.",
      "@en": "Sevgiler goes to the end."
     }
    },
    {
     "texto": {
      "@es": "resultado",
      "@en": "outcome"
     },
     "explicacion": {
      "@es": "Sonuç significa resultado.",
      "@en": "Sonuç means result."
     }
    }
   ]
  },
  {
