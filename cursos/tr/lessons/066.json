{
 "capitulo": 21,
 "titulo_tr": "Duygular ve kişisel mektuplar",
 "titulo_es": {
  "@es": "Emociones y cartas personales",
  "@en": "Emotions and personal letters"
 },
 "palabras": {
  "hayal kırıklığı": {
   "es": "decepción",
   "en": "disappointment",
   "pron": "ha-yal kı-rık-lı-UH"
  },
  "endişeli": {
   "es": "preocupado/a",
   "en": "concerned",
   "pron": "en-di-she-LI"
  },
  "gururlu": {
   "es": "orgulloso/a",
   "en": "proud",
   "pron": "gurur-LU"
  },
  "mutluyum": {
   "es": "estoy feliz",
   "en": "I'm happy.",
   "pron": "mut-lu-YUM"
  },
  "mektup": {
   "es": "carta",
   "en": "letter",
   "pron": "mek-TUP"
  },
  "başarı": {
   "es": "éxito",
   "en": "success",
   "pron": "ba-sha-RUH"
  },
  "sınavı": {
   "es": "el examen",
   "en": "the review",
   "pron": "sı-na-VUH",
   "oculta": true
  },
  "geçtiğim için": {
   "es": "porque aprobé",
   "en": "Because I passed",
   "pron": "geç-ti-ĞIM i-CHIN",
   "oculta": true
  },
  "sevgiler": {
   "es": "un abrazo; saludos afectuosos",
