   "pron": "sev-gi-LER",
   "oculta": true
  },
  "gurur": {
   "es": "orgullo",
   "en": "pride",
   "oculta": true
  },
  "duyuyor": {
   "es": "siente",
   "en": "It feels",
   "oculta": true
  },
  "endişeliydim": {
   "es": "estaba preocupado/a",
