     "quien": "Ali",
     "tr": "Elbette. Başka bir şey?",
     "es": "Claro. ¿Algo más?",
     "en": "Sure. Anything else?"
    },
    {
     "quien": "Anna",
     "tr": "Bir su, lütfen.",
     "es": "Un agua, por favor.",
     "en": "A water, please."
    },
    {
     "quien": "Ali",
     "tr": "Hemen getiriyorum.",
     "es": "Lo traigo enseguida.",
     "en": "I'll get it right back."
    }
   ]
