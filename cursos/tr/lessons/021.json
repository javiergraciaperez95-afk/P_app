        "@en": "young"
       }
      ],
      [
       "gözlüklü",
       {
        "@es": "con gafas",
        "@en": "with glasses"
       }
      ]
     ]
    },
    {
     "quien": "Anna",
     "tr": "Ne iş yapıyor?",
     "es": "¿En qué trabaja?",
     "en": "What are you working on?",
     "analisis": [
      [
       "Ne iş yapıyor",
       {
        "@es": "qué trabajo hace",
        "@en": "What work does he do?"
       }
      ]
     ]
    },
    {
     "quien": "Ali",
     "tr": "Doktor olarak çalışıyor.",
     "es": "Trabaja como médico.",
     "en": "He works as a doctor.",
     "analisis": [
      [
       "Doktor",
       {
        "@es": "médico",
        "@en": "doctor"
       }
      ],
      [
       "olarak",
       {
        "@es": "como",
        "@en": "how"
       }
      ],
      [
       "çalışıyor",
       {
        "@es": "trabaja",
        "@en": "Work"
       }
      ]
     ]
    },
    {
     "quien": "Anna",
     "tr": "Eşi de doktor mu?",
     "es": "¿Su pareja también es médico/a?",
     "en": "Is your partner a doctor, too?",
     "analisis": [
