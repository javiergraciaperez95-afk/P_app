       "Eşi",
       {
        "@es": "su pareja",
        "@en": "your partner"
       }
      ],
      [
       "de",
       {
        "@es": "también",
        "@en": "too"
       }
      ],
      [
       "doktor",
       {
        "@es": "médico",
        "@en": "doctor"
       }
      ],
      [
       "mu",
       {
        "@es": "pregunta",
        "@en": "Question"
       }
      ]
     ]
    },
