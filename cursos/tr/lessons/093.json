 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Debatir",
    "@en": "Discuss"
   },
   "texto": [
    {
     "@es": "**görüş** = punto de vista; **gerekçe** = razón; **sonuç** = conclusión.",
     "@en": "**görüş** = view; **gerekçe** = reason; **sonuç** = conclusion."
    },
    {
     "@es": "En un debate, escucha, resume la idea anterior y después responde.",
     "@en": "In a debate, listen, sum up the idea above and then respond."
    },
    {
     "@es": "**Bir yandan ... öte yandan ...** permite reconocer dos perspectivas antes de llegar a una conclusión.",
     "@en": "**Bir yandan ... öte yandan ...** allows you to recognize two perspectives before reaching a conclusion."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": {
    "@es": "Una conversación sobre transporte",
    "@en": "A conversation about transport"
   },
   "palabras": [
    "görüş",
    "gerekçe",
    "sonuç",
    "desteklemek",
    "karşı çıkmak",
    "özetlemek"
   ]
  },
  {
   "tipo": "dialogo",
   "titulo": {
    "@es": "Dos opiniones",
    "@en": "Two opinions"
   },
   "frases": [
    {
     "quien": "Deniz",
     "tr": "Toplu taşıma ücretsiz olmalı. Böylece şehirde trafik azalır.",
     "es": "El transporte público debería ser gratuito. Así disminuiría el tráfico en la ciudad.",
     "en": "Public transport should be free. This would reduce traffic in the city."
    },
    {
     "quien": "Can",
     "tr": "Görüşünü anlıyorum. Ancak belediyenin bu hizmeti nasıl finanse edeceğini de düşünmeliyiz.",
     "es": "Entiendo tu punto de vista. Sin embargo, también debemos pensar cómo financiará el municipio este servicio.",
     "en": "I understand your point of view. However, we must also think about how the municipality will finance this service."
    },
    {
     "quien": "Deniz",
     "tr": "Haklısın. Bir yandan herkes ulaşabilir, öte yandan bütçe gerekir.",
     "es": "Tienes razón. Por un lado, todos podrían acceder; por otro, hace falta presupuesto.",
     "en": "You're right. On the one hand, everyone would be able to access; on the other, budget is needed."
    },
    {
     "quien": "Can",
     "tr": "O hâlde önce maliyeti araştırıp sonra karar verelim.",
     "es": "Entonces investiguemos primero el coste y decidamos después.",
     "en": "Then let's first investigate the cost and decide later."
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué significa «gerekçe»?",
    "@en": "What does «gerekçe» mean?"
   },
   "id": "tr030-1",
   "opciones": [
    {
     "texto": "razón; justificación",
     "explicacion": {
      "@es": "Explica por qué se apoya una idea.",
      "@en": "He explains why an idea is supported."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "conclusión",
      "@en": "Conclusion"
     },
     "explicacion": {
      "@es": "Conclusión es sonuç.",
      "@en": "Conclusion is sonuç."
     }
    },
    {
     "texto": "municipio",
     "explicacion": {
      "@es": "Municipio es belediye.",
      "@en": "Municipality is belediye."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Por qué apoya Deniz el transporte gratuito?",
    "@en": "Why does Deniz support free transport?"
   },
   "id": "tr030-2",
   "opciones": [
    {
     "texto": {
      "@es": "Porque podría reducir el tráfico y facilitar el acceso",
      "@en": "Because it could reduce traffic and facilitate access"
     },
     "explicacion": {
      "@es": "Presenta esas ventajas.",
      "@en": "It has these advantages."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Porque no cuesta nada al municipio",
      "@en": "Because it costs the municipality nothing."
     },
     "explicacion": {
      "@es": "Can dice que hay un coste.",
      "@en": "Can says there's a cost."
     }
    },
    {
     "texto": {
      "@es": "Porque nadie usa el transporte público",
      "@en": "Because no one uses public transport"
     },
     "explicacion": {
      "@es": "No lo dice.",
      "@en": "He doesn't say."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué preocupación plantea Can?",
    "@en": "What concern does Can raise?"
   },
   "id": "tr030-3",
   "opciones": [
    {
     "texto": {
      "@es": "Cómo financiar el servicio",
      "@en": "How to finance the service"
     },
     "explicacion": {
      "@es": "Pregunta por la financiación.",
      "@en": "He asked about funding."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Si el autobús es cómodo",
      "@en": "If the bus is comfortable"
     },
     "explicacion": {
      "@es": "No habla de comodidad.",
      "@en": "He's not talking about comfort."
     }
    },
    {
     "texto": {
      "@es": "Si la ciudad tiene tráfico",
      "@en": "If the city has traffic"
     },
     "explicacion": {
      "@es": "Ambos aceptan que hay tráfico.",
      "@en": "They both accept there's traffic."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué deciden hacer antes de decidir?",
    "@en": "What do you decide to do before you decide?"
   },
   "id": "tr030-4",
   "opciones": [
    {
     "texto": {
      "@es": "Investigar el coste",
      "@en": "Investigate the cost"
     },
     "explicacion": "Önce maliyeti araştırıp...",
     "correcta": true
    },
    {
     "texto": {
      "@es": "Cancelar el servicio",
      "@en": "Cancel the service"
     },
     "explicacion": {
      "@es": "No lo deciden.",
      "@en": "They don't decide."
     }
    },
    {
     "texto": {
      "@es": "Hacer una encuesta nacional",
      "@en": "To conduct a national survey"
     },
     "explicacion": {
      "@es": "No lo menciona.",
      "@en": "He doesn't mention it."
     }
    }
   ]
  },
  {
   "tipo": "traduccion",
   "pregunta": {
    "@es": "Traduce.",
    "@en": "Translate."
   },
   "frase": "Görüşünü anlıyorum, ancak maliyeti de düşünmeliyiz.",
   "id": "tr030-5",
   "opciones": [
    {
     "texto": {
      "@es": "Entiendo tu punto de vista, pero también debemos pensar en el coste.",
      "@en": "I understand your point of view, but we must also think about the cost."
     },
     "explicacion": {
      "@es": "Ancak = pero/sin embargo.",
      "@en": "Ancak = but / however."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "No entiendo tu conclusión.",
      "@en": "I don't understand your conclusion."
     },
     "explicacion": {
      "@es": "No es la frase.",
      "@en": "It's not the phrase."
     }
    },
    {
     "texto": {
      "@es": "Estoy de acuerdo con el transporte gratuito.",
      "@en": "I agree with the free transport."
     },
     "explicacion": {
      "@es": "Es otra idea.",
      "@en": "It's another idea."
     }
    }
   ]
  },
  {
   "tipo": "huecos",
   "pregunta": {
    "@es": "Completa: «Primero investiguemos el coste y después decidamos».",
    "@en": "Complete: «Primero investiguemos el coste y después decidamos»."
   },
   "frase": "Önce maliyeti ___ sonra karar verelim.",
   "id": "tr030-6",
   "opciones": [
    {
     "texto": "araştırıp",
     "explicacion": {
      "@es": "-ıp conecta dos acciones consecutivas.",
      "@en": "-ıp connects two consecutive actions."
     },
     "correcta": true
    },
    {
     "texto": "araştırmadan",
     "explicacion": {
      "@es": "Sin investigar.",
      "@en": "No investigation."
     }
    },
    {
     "texto": "araştıracak",
     "explicacion": {
      "@es": "Investigará.",
      "@en": "He'll investigate."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "Escucha los dos lados.",
    "@en": "Listen to both sides."
   },
   "audio": "Bir yandan herkes ulaşabilir, öte yandan bütçe gerekir.",
   "id": "tr030-7",
   "opciones": [
    {
     "texto": {
      "@es": "Por un lado todos podrían acceder; por otro, hace falta presupuesto.",
      "@en": "On the one hand, everyone would be able to access it; on the other, budget is needed."
     },
     "explicacion": {
      "@es": "Presenta dos perspectivas.",
      "@en": "It presents two perspectives."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Todos están de acuerdo en que es gratis.",
      "@en": "Everyone agrees it's free."
     },
     "explicacion": {
      "@es": "Hay una preocupación financiera.",
      "@en": "There's a financial concern."
     }
    },
    {
     "texto": {
      "@es": "El presupuesto no es importante.",
      "@en": "The budget is not important."
     },
     "explicacion": {
      "@es": "No es lo que dice.",
      "@en": "It's not what he says."
     }
    }
   ]
  },
  {
   "tipo": "ordenar",
   "pregunta": {
    "@es": "Ordena las palabras.",
    "@en": "Order the words."
   },
   "frase": "Önce maliyeti araştıralım, sonra karar verelim",
   "traduccion": {
    "@es": "Investiguemos primero el coste y decidamos después",
    "@en": "Let's first investigate the cost and decide later."
   },
   "explicacion": {
    "@es": "-ıp/-ıp enlaza acciones.",
    "@en": "-ıp / -ıp links actions."
   },
   "id": "tr030-8"
  },
  {
   "tipo": "escribir",
   "pregunta": {
    "@es": "Escribe «Entiendo tu punto de vista, pero...»",
    "@en": "Write «I understand your point of view, but...»"
   },
   "respuestas": [
    "görüşünü anlıyorum ancak"
   ],
   "explicacion": {
    "@es": "Ancak introduce una respuesta matizada.",
    "@en": "Ancak introduces a nuanced response."
   },
   "id": "tr030-9"
  },
  {
   "tipo": "vocabulario",
   "titulo": {
    "@es": "Vocabulario",
