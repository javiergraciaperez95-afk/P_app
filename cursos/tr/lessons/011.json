 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Negar una acción",
    "@en": "Denying an action"
   },
   "texto": [
    {
     "@es": "Para negar el presente continuo, se inserta **-m-** antes de **-(I)yor**: **çalışıyorum** (trabajo/estudio) → **çalışmıyorum** (no trabajo/no estudio).",
     "@en": "To deny the continuous present, **-m-** is inserted before **-(I)yor**: **çalışıyorum** (work / study) → **çalışmıyorum** (no work / no study)."
    },
    {
     "@es": "**Bugün** significa «hoy». **Her gün** significa «todos los días».",
     "@en": "**Bugün** means «Today». **Her gün** means «daily»."
    },
    {
     "@es": "En preguntas de sí/no, la partícula **mi/mı/mu/mü** se escribe separada y recibe la terminación personal: **Çalışıyor musun?** = ¿estás trabajando?",
     "@en": "In yes / no questions, the **mi/mı/mu/mü** particle is written separately and is given the personal termination: **Çalışıyor musun?** = are you working?"
    }
   ]
  },
