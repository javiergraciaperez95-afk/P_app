   },
   "texto": [
    {
     "@es": "**cihaz** = aparato; **düğme** = botón; **ekran** = pantalla.",
     "@en": "**cihaz** = device; **düğme** = button; **ekran** = screen."
    },
    {
     "@es": "**ne işe yarar?** pregunta «¿para qué sirve?».",
     "@en": "**ne işe yarar?** asks «What's the use?»."
    },
    {
     "@es": "Para ordenar instrucciones: **önce** (primero), **sonra** (después), **en sonunda** (al final).",
     "@en": "To order instructions: **önce** (first), **sonra** (later), **en sonunda** (at the end)."
    }
   ]
  },
  {
