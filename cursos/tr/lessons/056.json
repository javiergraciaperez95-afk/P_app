   "frases": [
    {
     "quien": "Ali",
     "tr": "Bu cihaz ne işe yarıyor?",
     "es": "¿Para qué sirve este aparato?",
     "en": "What's the use of this device?"
    },
    {
     "quien": "Ece",
     "tr": "İnternete bağlanıyor. Önce düğmeye bas, sonra şifreni gir.",
     "es": "Se conecta a internet. Primero pulsa el botón y después escribe tu contraseña.",
     "en": "It's connected to the Internet. First press the button and then write your password."
    },
    {
     "quien": "Ali",
     "tr": "En sonunda ne yapmalıyım?",
     "es": "¿Qué debo hacer al final?",
     "en": "What should I do in the end?"
    },
    {
     "quien": "Ece",
     "tr": "Ekranı kontrol et.",
     "es": "Comprueba la pantalla.",
     "en": "Check the screen."
    }
   ]
