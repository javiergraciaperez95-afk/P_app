       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Deniz",
        "lengua": "estudio"
       },
       "estudio": "Bu nedenle geri dönüşüm kutuları koyalım.",
       "alumno": "For this reason, let's put out recycling bins.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Can",
        "lengua": "estudio"
       },
       "estudio": "Ayrıca evde su ve enerji tasarrufu yapabiliriz.",
       "alumno": "We can also save water and energy at home.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
