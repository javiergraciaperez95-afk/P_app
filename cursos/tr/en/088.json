        "texto": "Ali",
        "lengua": "estudio"
       },
       "estudio": "Otobüsü bekliyordum, tam o sırada cüzdanım yere düştü.",
       "alumno": "I was waiting for the bus, and just then my wallet fell.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Deniz",
        "lengua": "estudio"
       },
       "estudio": "Ne zaman fark ettin?",
       "alumno": "When did you notice?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ali",
        "lengua": "estudio"
       },
       "estudio": "Otobüs geldiğinde yerde gördüm ve çok telaşlandım.",
       "alumno": "When the bus arrived, I saw it on the ground and I got very worried.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Deniz",
        "lengua": "estudio"
       },
       "estudio": "Sonunda ne oldu?",
       "alumno": "What happened in the end?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ali",
        "lengua": "estudio"
       },
       "estudio": "Bir görevli buldu. Cüzdanımı geri aldım.",
       "alumno": "An employee found it. I got my wallet back.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
