   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Ordering a story",
     "texto": [
      "**-yordu** describes what was happening: **otobüsü bekliyordum** = I was waiting for the bus.",
      "**-dığında** means «when»: **eve geldiğimde** = when I got home.",
      "Link events with **tam o sırada** («just then») and **sonunda** («in the end»)."
     ],
     "tutora": ""
    }
   ]
