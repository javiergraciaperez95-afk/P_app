  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Talking about the weather",
     "texto": [
      "**Hava nasıl?** = what's the weather like? **Hava güzel** = the weather is nice.",
      "**Yağmur yağıyor** = it's raining (literally, rain falls); **kar yağıyor** = it's snowing. **Güneşli** means sunny and **bulutlu** means cloudy.",
      "To talk about temperature: **Hava sıcak** (it's hot) or **hava soğuk** (it's cold)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Seasons",
     "texto": [
      "**İlkbahar** = spring; **yaz** = summer; **sonbahar** = autumn; **kış** = winter.",
      "**-de/-da** can also show the season: **yazın** (in summer), **kışın** (in winter)."
     ],
     "tutora": ""
    }
   ]
  },
