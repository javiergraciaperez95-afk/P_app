   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Summarising a bulletin",
     "texto": [
      "**duyuru** = announcement; **yayın** = broadcast; **uyarı** = warning.",
      "To summarise a news item, mention the main event, the place and the time.",
      "**-dığı bildirildi** means «it was reported that...»: **yolun kapandığı bildirildi** = it was reported that the road was closed."
     ],
     "tutora": ""
    }
   ]
  },
