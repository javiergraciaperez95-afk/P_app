    {
     "tipo": "dialogo",
     "titulo": "A radio announcement",
     "frases": [
      {
       "quien": {
        "texto": "Spiker",
        "lengua": "estudio"
       },
       "estudio": "Ana yolda bir kaza olduğu bildirildi.",
       "alumno": "It was reported that there had been an accident on the main road.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Spiker",
        "lengua": "estudio"
       },
       "estudio": "Bu nedenle yolun kapandığı bildirildi.",
       "alumno": "For this reason, it was reported that the road was closed.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Spiker",
        "lengua": "estudio"
       },
       "estudio": "Sürücülerin alternatif yolu kullanmaları öneriliyor.",
       "alumno": "Drivers are advised to use an alternative route.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Spiker",
        "lengua": "estudio"
       },
       "estudio": "Yeni bilgi saat onda verilecek.",
       "alumno": "More news will be given at ten.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
