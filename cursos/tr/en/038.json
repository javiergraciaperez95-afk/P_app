    {
     "tipo": "explicacion",
     "titulo": "Frequency",
     "texto": [
      "**her gün** = every day; **genellikle** = usually; **bazen** = sometimes; **nadiren** = rarely.",
      "**-den önce** means before and **-den sonra** means after.",
      "The habitual present usually ends in **-r/-ar/-er**: **kahvaltı ederim** = I have breakfast."
     ],
     "tutora": ""
    }
