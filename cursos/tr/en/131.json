    {
     "tipo": "explicacion",
     "titulo": "Proper nouns and suffixes",
     "texto": [
      "After proper nouns, the case suffix is separated with an apostrophe: **Ankara'da**, **İstanbul'a**.",
      "With common nouns, it is written attached: **evde**, **okula**. The Turkish capitals **İ** and **I** are not interchangeable."
     ],
     "tutora": ""
    }
   ]
