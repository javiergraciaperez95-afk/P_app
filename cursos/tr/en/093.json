   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Two opinions",
     "frases": [
      {
       "quien": {
        "texto": "Deniz",
        "lengua": "estudio"
       },
       "estudio": "Toplu taşıma ücretsiz olmalı. Böylece şehirde trafik azalır.",
       "alumno": "Public transport should be free. This way traffic would fall in the city.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Can",
        "lengua": "estudio"
       },
       "estudio": "Görüşünü anlıyorum. Ancak belediyenin bu hizmeti nasıl finanse edeceğini de düşünmeliyiz.",
       "alumno": "I understand your viewpoint. However, we also need to think about how the council will fund this service.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Deniz",
        "lengua": "estudio"
       },
       "estudio": "Haklısın. Bir yandan herkes ulaşabilir, öte yandan bütçe gerekir.",
       "alumno": "You're right. On the one hand, everyone could access it; on the other, it needs a budget.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Can",
        "lengua": "estudio"
       },
       "estudio": "O hâlde önce maliyeti araştırıp sonra karar verelim.",
       "alumno": "So let's look into the cost first and decide afterwards.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
