  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Politeness",
     "texto": [
      "**iltifat** = compliment; **nazik** = kind; **rica etmek** = to ask or offer politely.",
      "If someone gives you a present, you can thank them and say **hiç gerek yoktu** («there was no need»).",
      "**-meden önce** means «before doing»."
     ],
     "tutora": ""
    }
   ]
  },
