        "texto": "Can",
        "lengua": "estudio"
       },
       "estudio": "Konukları kapıda karşılamadan önce sofrayı hazırladık.",
       "alumno": "We prepared the table before welcoming the guests at the door.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ayşe",
        "lengua": "estudio"
       },
       "estudio": "Çok güzel ağırladınız, yemek de harikaydı.",
       "alumno": "You welcomed us very warmly and the food was wonderful.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Can",
        "lengua": "estudio"
       },
       "estudio": "Güzel sözleriniz için teşekkür ederim. Küçük bir hediye getirmişsiniz!",
       "alumno": "Thank you for your kind words. You've brought a little present!",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ayşe",
        "lengua": "estudio"
       },
       "estudio": "Hiç gerek yoktu, davetiniz yeterliydi.",
       "alumno": "There was no need, the invitation was enough.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
