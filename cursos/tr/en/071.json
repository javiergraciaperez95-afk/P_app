    {
     "tipo": "explicacion",
     "titulo": "Talking about jobs",
     "texto": [
      "**beceri** = skill; **arzu** = wish; **deneyim** = experience.",
      "**-mek istiyorum** expresses a wish; **-ebilirim** indicates ability.",
      "You can justify a choice with **bu nedenle** («for this reason») or **bana göre** («in my opinion»)."
     ],
     "tutora": ""
    }
   ]
  },
