  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Colours and adjectives",
     "texto": [
      "Colours come before the noun: **kırmızı araba** (red car), **mavi çanta** (blue bag).",
      "The adjective does not change for gender or plural: **güzel ev**, **güzel evler** (beautiful house, beautiful houses).",
      "To say «this is…», use **Bu…**; **şu** points to something a bit further away, and **o** to something far away."
     ],
     "tutora": ""
    }
   ]
