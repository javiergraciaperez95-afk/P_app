    {
     "tipo": "explicacion",
     "titulo": "Traditions",
     "texto": [
      "**gelenek** = tradition; **adet** = custom; **sofra adabı** = table manners.",
      "To compare, use **-e göre** («according to») and **buna karşılık** («on the other hand»).",
      "Talk about customs with curiosity and avoid generalising about everyone in a country."
     ],
     "tutora": ""
    }
   ]
  },
