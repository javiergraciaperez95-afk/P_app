     "tipo": "dialogo",
     "titulo": "A conversation between friends",
     "frases": [
      {
       "quien": {
        "texto": "Anna",
        "lengua": "estudio"
       },
       "estudio": "Türkiye'de misafirperverlik nasıl gösterilir?",
       "alumno": "How is hospitality shown in Turkey?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Deniz",
        "lengua": "estudio"
       },
       "estudio": "Misafire çay veya kahve ikram etmek yaygındır.",
       "alumno": "It is common to offer tea or coffee to guests.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Anna",
        "lengua": "estudio"
       },
       "estudio": "İspanya'da da misafire bir şey ikram edilir.",
       "alumno": "In Spain, something is also offered to guests.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Deniz",
        "lengua": "estudio"
       },
       "estudio": "Gelenekler farklı olabilir; buna karşılık misafire değer vermek ortak bir davranış.",
       "alumno": "Traditions can differ; on the other hand, valuing guests is a shared behaviour.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
