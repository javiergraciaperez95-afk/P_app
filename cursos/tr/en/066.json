        "lengua": "alumno"
       },
       "estudio": "Sevgili Anna, geçen hafta sınav sonucumu aldım.",
       "alumno": "Dear Anna, last week I got my exam result.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Sınavı geçtiğim için çok mutluyum; ailem de benimle gurur duyuyor.",
       "alumno": "I'm very happy because I passed the exam; my family is proud of me too.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Sonuç açıklanana kadar endişeliydim.",
       "alumno": "I was worried until the result was announced.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Senin haberlerini de bekliyorum. Sevgiler, Elif.",
       "alumno": "I'm also looking forward to hearing your news. Love, Elif.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
