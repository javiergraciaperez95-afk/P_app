     "titulo": "A water leak",
     "frases": [
      {
       "quien": {
        "texto": "Can",
        "lengua": "estudio"
       },
       "estudio": "Banyoda su akıyor. Tesisatçı çağırmamız gerekiyor.",
       "alumno": "Water is leaking in the bathroom. We have to call a plumber.",
