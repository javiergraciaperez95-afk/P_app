 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Dar consejos con sollen",
    "@en": "Give advice with sollen"
   },
   "texto": [
    {
     "@es": "Con **sollen** (deber) se aconseja sin dar una orden fuerte: **Du solltest mehr schlafen** (deberías dormir más). El verbo principal va al final, en infinitivo.",
     "@en": "**sollen** (duty) is advised without giving a strong order: **Du solltest mehr schlafen** (you should sleep more). The main verb goes to the end, in infinitive."
    },
    {
     "@es": "Con «Sie» (usted): **Sie sollten viel Wasser trinken** (debería beber mucha agua).",
     "@en": "With «Sie» (you): **Sie sollten viel Wasser trinken** (you should drink a lot of water)."
    }
   ]
  },
