 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "seit, vor y nach",
    "@en": "seit, vor and nach"
   },
   "texto": [
    {
     "@es": "**Seit** significa «desde hace» y se usa con el presente: **Ich wohne seit zwei Jahren hier** (vivo aquí desde hace dos años).",
     "@en": "**Seit** means «since» and is used with the present: **Ich wohne seit zwei Jahren hier** (I have lived here for two years)."
    },
    {
     "@es": "**Vor** significa «hace» en pasado: **vor einer Woche** (hace una semana). **Nach** significa «después de»: **nach dem Fest** (después de la fiesta). Las tres piden **dativo**.",
     "@en": "**Vor** means «does» in the past: **vor einer Woche** (a week ago). **Nach** means «after»: **nach dem Fest** (after the party). All three are asking for **dativo**."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "bei, ab y bis",
    "@en": "bei, ab and bis"
   },
   "texto": [
    {
     "@es": "**Bei** significa «en el momento de»: **bei der Feier** (en la celebración). **Ab** significa «a partir de»: **ab Freitag** (a partir del viernes). **Bis** significa «hasta» y con días va sin artículo: **bis Freitag** (hasta el viernes).",
     "@en": "**Bei** means «at the time of»: **bei der Feier** (in the celebration). **Ab** means «from»: **ab Freitag** (from Friday). **Bis** means «up» and with days goes without article: **bis Freitag** (until Friday)."
    },
    {
     "@es": "Ojo con el falso amigo: **bei** no significa «by», sino «en casa de» o «en el momento de».",
     "@en": "Eye with the false friend: **bei** does not mean «by», but «at the house of» or «at the time of»."
    }
   ]
  },
