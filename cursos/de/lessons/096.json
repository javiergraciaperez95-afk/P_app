 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Tan… como",
    "@en": "As much as"
   },
   "texto": [
    {
     "@es": "Para decir que dos cosas son iguales se usa **so** + adjetivo + **wie**: **Er ist so alt wie ich** (él es tan mayor como yo).",
     "@en": "To say that two things are the same is used **so** + adjective + **wie**: **Er ist so alt wie ich** (he is as old as me)."
    },
    {
     "@es": "Para decir que no son iguales: **nicht so … wie**: **Der Bus ist nicht so schnell wie der Zug** (el autobús no es tan rápido como el tren).",
     "@en": "To say they are not the same: **nicht so … wie**: **Der Bus ist nicht so schnell wie der Zug** (the bus is not as fast as the train)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Cada vez más",
    "@en": "More and more"
   },
   "texto": [
    {
     "@es": "Con **immer** delante de un comparativo se dice «cada vez más»: **immer schneller** (cada vez más rápido).",
     "@en": "With **immer** in front of a comparative it is said «more and more»: **immer schneller** (increasingly fast)."
    },
    {
     "@es": "Ojo con el falso amigo: **immer** no significa «inmediatamente». Significa «siempre» y, con comparativo, «cada vez».",
     "@en": "Eye with the false friend: **immer** does not mean «inmediatamente». It means «always» and, with comparison, «at a time»."
    }
   ]
  },
