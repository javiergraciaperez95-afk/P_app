  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Palabras del pasado",
    "@en": "Words of the past"
   },
   "texto": [
    {
     "@es": "**Gestern** = ayer. **Gestern Abend** = anoche. **Letzte Woche** = la semana pasada. **Letztes Jahr** = el año pasado.",
     "@en": "**Gestern** = yesterday. **Gestern Abend** = last night. **Letzte Woche** = last week. **Letztes Jahr** = last year."
    },
    {
     "@es": "**Da** = allí. **Krank** = enfermo. **Toll** = genial. **Lecker** = rico (de sabor).",
     "@en": "**Da** = there. **Krank** = sick. **Toll** = great. **Lecker** = rich (flavour)."
    }
   ]
  },
