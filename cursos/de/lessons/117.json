 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Formal o informal",
    "@en": "Formal or informal"
   },
   "texto": [
    {
     "@es": "Con un adulto que no conoces se usa **Sehr geehrte Frau Schmidt,** (estimada señora Schmidt). Con amigos, **Liebe Anna,** (querida Anna).",
     "@en": "With an adult you don't know **Sehr geehrte Frau Schmidt,** is used (esteemed Mrs. Schmidt). With friends, **Liebe Anna,** (dear Anna)."
    },
    {
     "@es": "Para despedirte de forma formal: **Mit freundlichen Grüßen** (atentamente). Con amigos: **Viele Grüße** (un saludo).",
     "@en": "To formally say goodbye: **Mit freundlichen Grüßen** (carefully). With friends: **Viele Grüße** (a greeting)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Pedir con cortesía",
    "@en": "Ask with courtesy"
   },
   "texto": [
    {
     "@es": "**Könnten Sie mir bitte helfen?** (¿podría ayudarme, por favor?). **Ich würde mich freuen** (me alegraría). Son las formas de cortesía que ya conoces de la lección 38.",
     "@en": "**Könnten Sie mir bitte helfen?** (could you help me, please?). **Ich würde mich freuen** (I'd be happy). These are the forms of courtesy you already know of lesson 38."
    },
    {
     "@es": "**Vielen Dank für Ihre Nachricht** (muchas gracias por su mensaje). **Ich freue mich auf Ihre Antwort** (espero su respuesta con ganas).",
     "@en": "**Vielen Dank für Ihre Nachricht** (thank you for your message). **Ich freue mich auf Ihre Antwort** (I look forward to your answer)."
    }
   ]
  },
