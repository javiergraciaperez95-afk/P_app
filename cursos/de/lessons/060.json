 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "En el hotel",
    "@en": "At the hotel"
   },
   "texto": [
    {
     "@es": "Al llegar: **Ich habe eine Reservierung** (tengo una reserva).",
     "@en": "When you arrive: **Ich habe eine Reservierung** (I have a reservation)."
    },
    {
     "@es": "Las habitaciones: **ein Einzelzimmer** (individual) y **ein Doppelzimmer** (doble). Las noches: **für zwei Nächte**.",
     "@en": "The rooms: **ein Einzelzimmer** (individual) and **ein Doppelzimmer** (double). The nights: **für zwei Nächte**."
    },
    {
     "@es": "Para confirmar: **Ja, genau** (sí, exacto).",
     "@en": "To confirm: **Ja, genau** (yes, exactly)."
    },
    {
     "@es": "Las plantas: **im ersten Stock**, **im zweiten Stock**, **im dritten Stock**. Ojo: en Alemania la planta baja no cuenta, así que «erster Stock» es nuestro primer piso.",
     "@en": "Plants: **im ersten Stock**, **im zweiten Stock**, **im dritten Stock**. Eye: In Germany the ground floor does not count, so «erster Stock» is our first floor."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Si no te encuentras bien",
    "@en": "If you're not feeling well"
   },
   "texto": [
    {
     "@es": "**Was ist los?** = ¿qué pasa?",
     "@en": "**Was ist los?** = what's going on?"
    },
    {
     "@es": "**Mir geht es nicht gut** = no me encuentro bien. **Ich bin krank** = estoy enfermo.",
     "@en": "**Mir geht es nicht gut** = I'm not feeling well. **Ich bin krank** = I'm sick."
    },
    {
     "@es": "Los dolores se dicen con **haben** + parte del cuerpo + **-schmerzen**: **Ich habe Kopfschmerzen** (me duele la cabeza), **Ich habe Bauchschmerzen** (me duele la tripa).",
     "@en": "The pains are said with **haben** + body part + **-schmerzen**: **Ich habe Kopfschmerzen** (head pain), **Ich habe Bauchschmerzen** (stomach pain)."
    },
    "**Ich habe Fieber** = tengo fiebre.",
    {
     "@es": "A quien está enfermo se le dice **Gute Besserung!** (¡que te mejores!).",
     "@en": "The sick are told **Gute Besserung!** (better!)."
    }
   ]
  },
