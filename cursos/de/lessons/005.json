   "tipo": "explicacion",
   "titulo": {
    "@es": "Deletrear en alemán",
    "@en": "Deletrear in German"
   },
   "texto": [
    {
     "@es": "El verbo **buchstabieren** significa deletrear.",
     "@en": "The verb **buchstabieren** means spelling."
    },
    {
     "@es": "Para pedirlo con cortesía: **Wie buchstabiert man das?** (¿cómo se deletrea eso?).",
     "@en": "To ask with courtesy: **Wie buchstabiert man das?** (how is that spelled out?)."
    },
    {
     "@es": "Letras con nombres especiales:",
     "@en": "Letters with special names:"
    },
    {
     "@es": "**J** se llama «iot», **V** se llama «fau», **W** se llama «ve», **Z** se llama «tset».",
     "@en": "**J** is called «iot», **V** is called «fau», **W** is called «Go», **Z** is called «tset»."
    },
    {
     "@es": "**Ä** se llama «a-Umlaut», **Ö** «o-Umlaut», **Ü** «u-Umlaut» y **ß** se llama «Eszett» o «scharfes S».",
     "@en": "**Ä** is called «a-Umlaut», **Ö** «o-Umlaut», **Ü** «u-Umlaut» and **ß** is called «Eszett» or «scharfes S»."
    }
   ]
