     }
    }
   ]
  },
  {
   "tipo": "huecos",
   "pregunta": {
    "@es": "Completa la frase.",
    "@en": "Complete the sentence."
   },
   "frase": "Hallo! Ich bin Lena. Und ___ ?",
   "id": "de001-5",
   "opciones": [
    {
     "texto": "du",
     "explicacion": {
      "@es": "Und du? = ¿y tú?",
      "@en": "And you?"
     },
     "correcta": true
    },
    {
     "texto": "ich",
     "explicacion": {
      "@es": "Sería «¿y yo?».",
      "@en": "It would be «What about me?»."
     }
    },
    {
     "texto": "bin",
     "explicacion": {
      "@es": "Es forma verbal («soy»), no pronombre.",
      "@en": "It is verbal form («I am»), not pronoun."
     }
    }
   ]
  },
  {
   "tipo": "traduccion",
   "pregunta": {
    "@es": "¿Qué significa esta despedida?",
    "@en": "What does this farewell mean?"
   },
   "frase": "Auf Wiedersehen, Frau Schmidt.",
   "id": "de001-6",
   "opciones": [
    {
     "texto": {
      "@es": "Adiós, señora Schmidt.",
      "@en": "Good-bye, Mrs. Schmidt."
     },
     "explicacion": {
      "@es": "«Auf Wiedersehen» es la despedida formal.",
      "@en": "«Auf Wiedersehen» is the formal farewell."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Buenos días, señora Schmidt.",
      "@en": "Good morning, Mrs. Schmidt."
     },
     "explicacion": {
      "@es": "«Buenos días» sería «Guten Morgen» o «Guten Tag».",
      "@en": "«Good morning.» would be «Guten Morgen» or «Guten Tag»."
     }
    },
    {
     "texto": {
      "@es": "Gracias, señora Schmidt.",
      "@en": "Thank you, Mrs. Schmidt."
     },
     "explicacion": {
      "@es": "«Gracias» sería «Danke».",
      "@en": "«Thank you.» would be «Danke»."
     }
    }
   ]
  },
  {
   "tipo": "ordenar",
   "pregunta": {
    "@es": "Ordena las palabras.",
    "@en": "Order the words."
   },
   "frase": "Wie heißen Sie",
   "traduccion": {
    "@es": "¿Cómo se llama usted?",
    "@en": "What's your name?"
   },
   "explicacion": {
    "@es": "Wie + verbo + Sie.",
    "@en": "Wie + verb + Sie."
   },
   "id": "de001-7"
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Cómo se dice «gracias» en alemán?",
    "@en": "How do you say «Thank you.» in German?"
   },
   "id": "de001-8",
   "opciones": [
    {
     "texto": "Danke",
     "explicacion": {
      "@es": "Es la forma habitual de agradecer.",
      "@en": "It's the usual way to thank you."
     },
     "correcta": true
    },
    {
     "texto": "Bitte",
     "explicacion": {
      "@es": "Significa «por favor» o «de nada».",
      "@en": "It means «Please.» or «You're welcome.»."
     }
    },
    {
     "texto": "Tschüss",
     "explicacion": {
      "@es": "Es una despedida informal («adiós»).",
      "@en": "It's an informal farewell («Bye.»)."
     }
    }
   ]
  }
 ],
 "intro": {
  "@es": "Empezamos por saludar y decir tu nombre. Un detalle para toda la vida: en alemán, todos los nombres (sustantivos) se escriben con mayúscula, no solo los propios.",
  "@en": "We started by saying hello and saying your name. A detail for all life: in German, all (substantive) names are written with capital, not just their own."
 }
}