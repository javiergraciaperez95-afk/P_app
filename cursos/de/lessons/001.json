       {
        "@es": "¿cómo se llama usted?",
        "@en": "What's your name?"
       }
      ]
     ]
    },
    {
     "quien": "Maria",
     "de": "Ich heiße Maria Schmidt. Und Sie?",
     "es": "Me llamo Maria Schmidt. ¿Y usted?",
     "en": "My name is Maria Schmidt. And you?",
     "analisis": [
