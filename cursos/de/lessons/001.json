{
 "capitulo": 1,
 "titulo_de": "Hallo!",
 "titulo_es": {
  "@es": "Saludar y decir cómo te llamas",
  "@en": "Say hello and say your name"
 },
 "palabras": {
  "hallo": {
   "es": "hola",
   "en": "Hello.",
   "pron": "JA-lo",
   "consejo": {
    "@es": "La h se aspira, como una jota suave.",
    "@en": "The h is aspired, like a soft jota."
   }
  },
  "guten Morgen": {
   "es": "buenos días",
   "en": "Good morning.",
   "pron": "GU-ten MOR-guen"
  },
  "guten Tag": {
   "es": "buenos días, buenas tardes",
   "en": "Good morning, good afternoon",
   "pron": "GU-ten tak"
  },
  "guten Abend": {
   "es": "buenas tardes, buenas noches",
   "en": "Good evening, good night",
   "pron": "GU-ten A-bent"
  },
  "tschüss": {
   "es": "adiós (informal)",
   "en": "(informal)",
   "pron": "chüs",
   "consejo": {
    "@es": "La ü se dice con labios de «u» y diciendo «i».",
    "@en": "The ü is said with «u» lips and «i»."
   }
  },
  "auf Wiedersehen": {
   "es": "adiós (formal)",
   "en": "(formal)",
   "pron": "auf VI-da-se-en",
   "consejo": {
    "@es": "La w suena como nuestra v suave.",
    "@en": "The w sounds like our v soft."
   }
  },
  "ich": {
   "es": "yo",
   "en": "I",
   "pron": "ij",
   "consejo": {
    "@es": "La «ch» después de i suena como una jota muy suave.",
    "@en": "The «ch» after i sounds like a very soft jota."
   }
  },
  "du": {
   "es": "tú",
   "en": "You",
   "pron": "du"
  },
  "Sie": {
   "es": "usted",
   "en": "You",
   "pron": "si",
   "consejo": {
    "@es": "Con mayúscula es «usted»; con minúscula, «ella» o «ellos».",
    "@en": "With capital is «You»; with small, «her.» or «They»."
   }
  },
  "ich heiße": {
   "es": "me llamo",
   "en": "My name is",
   "pron": "ij JAI-se",
   "consejo": {
    "@es": "La ß es una s fuerte. «Ei» suena «ai».",
    "@en": "The ß is a s strong. «Ei» sounds «ai»."
   }
  },
  "wie heißt du": {
   "es": "¿cómo te llamas?",
   "en": "What's your name?",
   "pron": "vi jaist du"
  },
  "wie heißen Sie": {
   "es": "¿cómo se llama usted?",
   "en": "What's your name?",
   "pron": "vi JAI-sen si"
  },
  "ich bin": {
   "es": "soy, estoy",
   "en": "I'm, I'm",
   "pron": "ij bin"
  },
  "und": {
   "es": "y",
   "en": "and",
   "pron": "unt"
  },
  "und du": {
   "es": "¿y tú?",
   "en": "What about you?",
   "pron": "unt du"
  },
  "und Sie": {
   "es": "¿y usted?",
   "en": "And you?",
   "pron": "unt si"
  },
  "freut mich": {
   "es": "encantado, encantada",
   "en": "Enchanted, enchanted",
   "pron": "froit mij",
   "consejo": {
    "@es": "«Eu» suena «oi».",
    "@en": "«Eu» sounds «oi»."
   }
  },
  "ja": {
   "es": "sí",
   "en": "Yes.",
   "pron": "ya"
  },
  "nein": {
   "es": "no",
   "en": "No.",
   "pron": "nain"
  },
  "danke": {
   "es": "gracias",
   "en": "Thank you.",
   "pron": "DAN-ke"
  },
  "Frau": {
   "es": "señora (delante del apellido)",
   "en": "Madam (in front of the last name)",
   "pron": "frau"
  },
  "Herr": {
   "es": "señor (delante del apellido)",
   "en": "Sir (in front of the last name)",
   "pron": "jer"
  }
 },
 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Saludar",
    "@en": "Say hello"
   },
   "texto": [
    {
     "@es": "**Hallo** vale para casi todo el mundo. Más formal: **Guten Morgen** (por la mañana), **Guten Tag** (durante el día) y **Guten Abend** (al anochecer).",
     "@en": "**Hallo** is for almost everyone. More formal: **Guten Morgen** (morning), **Guten Tag** (during the day) and **Guten Abend** (at night)."
    },
    {
     "@es": "Para despedirte: **Tschüss** (informal) o **Auf Wiedersehen** (formal).",
     "@en": "To say goodbye: **Tschüss** (informal) or **Auf Wiedersehen** (formal)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Tú y usted",
    "@en": "You and you."
   },
   "texto": [
    {
     "@es": "**Du** es «tú»: para amigos, familia y gente joven. **Sie** es «usted» y se escribe siempre con mayúscula. Con desconocidos adultos se usa **Sie**.",
     "@en": "**Du** is «You»: for friends, family and young people. **Sie** is «You» and is always written with capital. With unknown adults **Sie** is used."
    },
    {
     "@es": "Para decir tu nombre: **Ich heiße Anna** (me llamo Anna) o **Ich bin Anna** (soy Anna).",
     "@en": "To say your name: **Ich heiße Anna** (my name is Anna) or **Ich bin Anna** (I am Anna)."
    },
    {
     "@es": "Para preguntarlo: **Wie heißt du?** (tú) o **Wie heißen Sie?** (usted).",
     "@en": "To ask: **Wie heißt du?** (you) or **Wie heißen Sie?** (you)."
    },
    {
     "@es": "Al conocer a alguien: **Freut mich** (encantado).",
     "@en": "When you meet someone: **Freut mich** (enchanted)."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": {
    "@es": "Vocabulario: saludos",
    "@en": "Vocabulary: greetings"
   },
   "palabras": [
    "hallo",
    "guten Morgen",
    "guten Tag",
    "guten Abend",
    "tschüss",
    "auf Wiedersehen",
    "ich",
    "du",
    "Sie",
    "ich heiße",
    "wie heißt du",
    "wie heißen Sie",
    "ich bin",
    "und",
    "und du",
    "und Sie",
    "freut mich",
    "ja",
    "nein",
    "danke",
    "Frau",
    "Herr"
   ]
  },
  {
   "tipo": "dialogo",
   "titulo": {
    "@es": "Entre estudiantes",
    "@en": "Among students"
   },
   "frases": [
    {
     "quien": "Lena",
     "de": "Hallo! Ich heiße Lena. Und du?",
     "es": "¡Hola! Me llamo Lena. ¿Y tú?",
     "en": "Hey! My name is Lena. And you?",
     "analisis": [
      [
       "Hallo",
       {
        "@es": "saludo",
        "@en": "Greetings."
       }
      ],
      [
       "Ich heiße",
       {
        "@es": "me llamo",
        "@en": "My name is"
       }
      ],
      [
       "Und du",
       {
        "@es": "¿y tú?",
        "@en": "What about you?"
       }
      ]
     ]
    },
    {
     "quien": "Jonas",
     "de": "Hallo, Lena. Ich bin Jonas.",
     "es": "Hola, Lena. Yo soy Jonas.",
     "en": "Hey, Lena. I'm Jonas.",
     "analisis": [
      [
       "Ich bin",
       {
        "@es": "yo soy",
        "@en": "I am"
       }
      ]
     ]
    },
    {
     "quien": "Lena",
     "de": "Freut mich, Jonas.",
     "es": "Encantada, Jonas.",
     "en": "Nice to meet you, Jonas.",
     "analisis": [
      [
       "Freut mich",
       {
        "@es": "«me alegra»: encantada",
        "@en": "«me alegra»: enchanted"
       }
      ]
     ]
    },
    {
     "quien": "Jonas",
     "de": "Freut mich. Tschüss!",
     "es": "Encantado. ¡Adiós!",
     "en": "Nice to meet you. Bye!",
     "analisis": [
      [
       "Tschüss",
       {
        "@es": "despedida informal",
        "@en": "informal farewell"
       }
      ]
     ]
    }
   ]
  },
  {
   "tipo": "dialogo",
