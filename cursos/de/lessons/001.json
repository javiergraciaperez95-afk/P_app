    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué saludo sirve con casi todo el mundo?",
    "@en": "What kind of greeting does it serve with most people?"
   },
   "id": "de001-1",
   "opciones": [
    {
     "texto": "Hallo",
     "explicacion": {
      "@es": "Es el saludo más común.",
      "@en": "It's the most common greeting."
     },
     "correcta": true
    },
    {
     "texto": "Tschüss",
     "explicacion": {
      "@es": "Es una despedida.",
      "@en": "It's a farewell."
     }
    },
    {
     "texto": "Auf Wiedersehen",
     "explicacion": {
      "@es": "Es una despedida formal.",
      "@en": "It's a formal farewell."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "Hablas con una señora que no conoces. ¿Cómo le preguntas el nombre?",
    "@en": "You talk to a lady you don't know. How do you ask her the name?"
   },
   "id": "de001-2",
   "opciones": [
    {
     "texto": "Wie heißen Sie?",
     "explicacion": {
      "@es": "Con «Sie» (usted).",
      "@en": "With «Sie» (you)."
     },
     "correcta": true
    },
    {
     "texto": "Wie heißt du?",
     "explicacion": {
      "@es": "Eso es con «du».",
      "@en": "That's with «du»."
     }
    },
    {
     "texto": "Wie heiße ich?",
     "explicacion": {
      "@es": "Eso sería «¿cómo me llamo?».",
      "@en": "That would be «What's my name?»."
     }
    }
   ]
  },
  {
   "tipo": "traduccion",
   "pregunta": {
    "@es": "¿Qué significa?",
    "@en": "What does that mean?"
   },
   "frase": "Ich heiße Lena.",
   "id": "de001-3",
   "opciones": [
    {
     "texto": {
      "@es": "Me llamo Lena.",
      "@en": "My name is Lena."
     },
     "explicacion": {
      "@es": "Ich heiße = me llamo.",
      "@en": "Ich heiße = my name is."
     },
     "correcta": true
    },
    {
     "texto": "Te llamas Lena.",
     "explicacion": {
      "@es": "Sería «Du heißt Lena».",
      "@en": "It would be «Du heißt Lena»."
     }
    },
    {
     "texto": {
      "@es": "Se llama Lena.",
      "@en": "His name is Lena."
     },
     "explicacion": {
      "@es": "Sería «Sie heißt Lena».",
      "@en": "It would be «Sie heißt Lena»."
     }
    }
   ]
  },
  {
