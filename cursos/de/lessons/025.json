 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Verbos que se parten",
    "@en": "Verbs that break"
   },
   "texto": [
    {
     "@es": "Muchos verbos alemanes llevan delante una partícula que **se separa** al conjugarlos y se va **al final** de la frase.",
     "@en": "Many German verbs carry a particle that **se separa** to the conjugate and **al final** goes from the phrase."
    },
    {
     "@es": "**aufstehen** (levantarse): **Ich stehe früh auf** (me levanto temprano).",
     "@en": "**aufstehen** (get up): **Ich stehe früh auf** (get up early)."
    },
    {
     "@es": "**anfangen** (empezar): **Ich fange um neun Uhr an** (empiezo a las nueve).",
     "@en": "**anfangen** (start): **Ich fange um neun Uhr an** (start at nine)."
    },
    {
     "@es": "**fernsehen** (ver la tele): **Ich sehe fern** (veo la tele).",
     "@en": "**fernsehen** (see TV): **Ich sehe fern** (see TV)."
    },
    {
     "@es": "En el diccionario los encontrarás juntos; en la frase, separados.",
     "@en": "In the dictionary you will find them together; in the phrase, separate."
    }
   ]
  },
  {
   "tipo": "tabla",
   "titulo": {
    "@es": "Verbos separables",
    "@en": "Separable verbs"
   },
   "filas": [
