 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Los días",
    "@en": "The days"
   },
   "texto": [
    {
     "@es": "Los días son nombres, así que van con **mayúscula**, y son todos masculinos. Llevan **am**: **am Montag** (el lunes).",
     "@en": "The days are names, so they go with **mayúscula**, and they're all masculine. They carry **am**: **am Montag** (Monday)."
    },
    {
     "@es": "**Heute** = hoy. **Am Wochenende** = el fin de semana.",
     "@en": "**Heute** = today. **Am Wochenende** = the weekend."
    }
   ]
  },
