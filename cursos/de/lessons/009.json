 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "La regla de oro: el verbo en segundo lugar",
    "@en": "The golden rule: the verb in second place"
   },
   "texto": [
    {
     "@es": "En una frase normal, el verbo conjugado va siempre en **segunda posición**: **Ich spreche Deutsch** (hablo alemán).",
     "@en": "In a normal sentence, the conjugated verb always goes in **segunda posición**: **Ich spreche Deutsch** (I speak German)."
    },
    {
     "@es": "Si empiezas la frase con otra cosa, el sujeto pasa detrás del verbo: **Heute spreche ich Deutsch** (hoy hablo alemán).",
     "@en": "If you start the phrase with something else, the subject passes behind the verb: **Heute spreche ich Deutsch** (I speak German today)."
    },
    {
     "@es": "En las preguntas de sí o no, el verbo va **el primero**: **Sprechen Sie Deutsch?**",
     "@en": "In questions whether or not, the verb goes **el primero**: **Sprechen Sie Deutsch?**"
    },
    {
     "@es": "En las preguntas con palabra interrogativa, el verbo sigue en segundo lugar: **Wo wohnen Sie?** (¿dónde vive?).",
     "@en": "In questions with question word, the verb remains second: **Wo wohnen Sie?** (where does he live?)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Verbos que cambian la vocal",
    "@en": "Verbs that change the vowel"
   },
   "texto": [
    {
     "@es": "Algunos verbos cambian la vocal con **du** y con **er/sie**. **Sprechen** (hablar) es uno: e → i.",
     "@en": "Some verbs change the vocal with **du** and **er/sie**. **Sprechen** (speak) is one: e → i."
    }
   ]
  },
