   "tipo": "explicacion",
   "titulo": {
    "@es": "Vivir en un sitio",
    "@en": "Living in a place"
   },
   "texto": [
    {
     "@es": "**Wohnen** es «vivir» en el sentido de residir: **Ich wohne in Madrid**.",
     "@en": "**Wohnen** is «live» in the sense of residence: **Ich wohne in Madrid**."
    },
    {
     "@es": "**Ein bisschen** = un poco. **Leider** = por desgracia. **Langsam** = despacio.",
     "@en": "**Ein bisschen** = a little. **Leider** = unfortunately. **Langsam** = slow."
    }
   ]
  },
