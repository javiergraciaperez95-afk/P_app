   "frases": [
    {
     "quien": "Julia",
     "de": "Erzähl mal! Was hast du gestern gemacht?",
     "es": "¡Cuéntame! ¿Qué hiciste ayer?",
     "en": "Tell me! What did you do yesterday?",
     "analisis": [
      [
       "erzähl mal",
       {
        "@es": "cuenta",
        "@en": "account"
       }
      ],
      [
       "was hast du gestern gemacht",
       {
        "@es": "¿qué hiciste ayer?",
        "@en": "What did you do yesterday?"
       }
      ]
     ]
    },
    {
     "quien": "Thomas",
     "de": "Zuerst ging ich ins Kino, dann aß ich mit Freunden.",
     "es": "Primero fui al cine, luego comí con amigos.",
     "en": "First I went to the movies, then I ate with friends.",
     "analisis": [
      [
       "zuerst ging ich",
       {
        "@es": "primero fui",
        "@en": "I went first."
       }
      ],
      [
       "dann aß ich",
       {
        "@es": "luego comí",
        "@en": "Then I ate"
       }
      ]
     ]
    },
    {
     "quien": "Julia",
     "de": "Und danach?",
     "es": "¿Y después?",
     "en": "And then?",
     "analisis": [
      [
       "danach",
       {
        "@es": "después de eso",
        "@en": "after that."
       }
      ]
     ]
    },
    {
     "quien": "Thomas",
     "de": "Danach war ich sehr müde. Als ich nach Hause kam, schlief ich sofort.",
     "es": "Después estaba muy cansado. Cuando llegué a casa, me dormí enseguida.",
     "en": "Then I was very tired. When I got home, I fell asleep right away.",
