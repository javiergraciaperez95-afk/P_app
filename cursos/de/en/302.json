     "oir_frase": false,
     "opciones": [
      {
       "texto": "It can hardly be disputed that this step was economically necessary.",
       "lengua": "alumno",
       "explicacion": "Rhetorical formula with sich lassen + infinitive bestreiten.",
       "correcta": true
      },
      {
       "texto": "It is false to claim that the measure will bring financial benefits to the municipality.",
       "lengua": "alumno",
       "explicacion": "It distorts the categorical finding of economic necessity.",
       "correcta": false
      },
      {
       "texto": "Parliament will debate whether the resolution fits the approved spending framework.",
       "lengua": "alumno",
       "explicacion": "It introduces a procedural doubt that does not exist in the assertion.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
