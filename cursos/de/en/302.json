    },
    {
     "tipo": "test",
     "id": "de302-4",
     "pregunta": {
      "texto": "What syntactic effect does the connector «somit» produce at the start of a main clause?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "It occupies the first syntactic position, causing the immediate inversion of the finite verb in position 2.",
       "lengua": "alumno",
       "explicacion": "Somit eröffnen sich… follows the regular principle of V2.",
       "correcta": true
      },
      {
       "texto": "It moves the conjugated verb to the last position of the sentence.",
       "lengua": "alumno",
       "explicacion": "It is not a subordinating conjunction, so it does not move the verb to the end.",
       "correcta": false
      },
      {
       "texto": "It always requires the presence of the subjunctive Konjunktiv I in the clause.",
       "lengua": "alumno",
       "explicacion": "somit combines with the indicative of logical certainty.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
