   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Expressing assumptions with werden",
     "texto": [
      "When a speaker says **Sie wird jetzt im Büro sein**, they are not planning a future appointment but deducing what is happening at this moment: \"She's probably in the office now\". To make this hypothetical nuance explicit, it is usually accompanied by probability adverbs such as **wohl**, **vermutlich** or **wahrscheinlich**: **Er wird wohl im Stau stehen** (He's probably stuck in traffic)."
     ],
     "tutora": ""
    },
