 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Proposing",
     "texto": [
      "To propose something: **Ich schlage vor, dass …** (I propose that…) or **Ich würde vorschlagen, …** (I would propose…). With «dass» the verb goes at the end: **Ich schlage vor, dass wir früher anfangen** (I propose that we start earlier).",
      "To close a text: **Abschließend möchte ich betonen, dass …** (to conclude, I want to stress that…)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Following the thread of an opinion",
     "texto": [
      "Identify the position, the reasons, the contrast, the proposal and the conclusion. Connectors help reconstruct the relation between ideas; they do not replace the concrete reasons in the text."
     ],
     "tutora": ""
    },
