     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "After the noun it complements, governing the dative.",
       "lengua": "alumno",
       "explicacion": "«Den Berichten zufolge» is typically constructed as a postposition with dative.",
       "correcta": true
      },
      {
       "texto": "In front of the conjugated verb at the absolute start of the sentence.",
       "lengua": "alumno",
       "explicacion": "It is placed after the noun phrase that represents the source.",
       "correcta": false
      },
      {
       "texto": "Always at the end of the subordinate clause, like a separable prefix.",
       "lengua": "alumno",
       "explicacion": "It is a source adposition, not a separable verb particle.",
