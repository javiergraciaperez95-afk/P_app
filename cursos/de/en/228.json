    {
     "tipo": "test",
     "id": "de228-4",
     "pregunta": {
      "texto": "What case does the preposition «laut» usually govern in modern formal language?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Dative or genitive.",
       "lengua": "alumno",
       "explicacion": "In modern German it is widely used with the dative («laut dem Bericht») and also with the genitive.",
       "correcta": true
      },
      {
       "texto": "Only the accusative of direction.",
       "lengua": "alumno",
       "explicacion": "«Laut» expresses the reference source, not direction or movement in the accusative.",
       "correcta": false
      },
      {
       "texto": "It doesn't govern any case because it always functions as a conjunction.",
       "lengua": "alumno",
       "explicacion": "It is a preposition that determines the case of the source noun phrase.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
