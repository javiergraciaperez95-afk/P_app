 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "The double mark of the plural dative",
     "texto": [
      "In the plural dative, all genders unite under the article **den** (or possessive determiners ending in **-en**, like **meinen** or **ihren**).",
      "Also, the plural noun gets an **-n** added: **die Freunde** → **mit den Freunden** (with friends); **die Ärzte** → **von den Ärzten** (of the doctors); **die Kinder** → **mit den Kindern** (with the children).",
      "Exception: if the plural already ends in **-n** (die Patienten, die Familien) or **-s** (die Autos), no extra letter is added: **mit den Patienten**, **mit den Familien**."
     ],
     "tutora": ""
    },
