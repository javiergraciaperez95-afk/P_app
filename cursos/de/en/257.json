   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "The double marking of the weak masculine accusative",
     "texto": [
      "When formulating the masculine direct object of a weak noun, both the article or adjective and the noun itself must agree with the inflectional ending:",
      "- **Ich kenne den neuen Kollegen** (I know the new colleague).",
      "- **Wir unterstützen den engagierten Assistenten** (we support the committed assistant).",
      "- **Der Chef empfängt einen ausländischen Journalisten** (the boss receives a foreign journalist).",
      "This morphological feature is exclusive to the weak masculine class and prevents agreement errors in professional B2 registers."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Nominative (base form)",
     "columnas": [
