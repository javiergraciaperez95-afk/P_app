    {
     "tipo": "test",
     "id": "de202-1",
     "pregunta": {
      "texto": "What semantic value does the connector «dennoch» add in a chain of arguments?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Adversative concession: it introduces a positive action or result that succeeds despite the previous obstacle.",
       "lengua": "alumno",
       "explicacion": "It expresses that the obstacle did not prevent reaching the stated goal.",
       "correcta": true
      },
      {
       "texto": "Symmetrical copulative addition: it adds identical data without contrasting any difficulty.",
       "lengua": "alumno",
       "explicacion": "That function corresponds to connectors such as «außerdem» or «zudem».",
       "correcta": false
      },
      {
       "texto": "Direct causality: it explains the unavoidable reason why a management effort failed.",
       "lengua": "alumno",
       "explicacion": "That function corresponds to «weil», «deshalb» or «daher».",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
    {
     "tipo": "huecos",
