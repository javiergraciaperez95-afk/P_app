    {
     "tipo": "test",
     "id": "de202-4",
     "pregunta": {
      "texto": "What syntactic effect do «deshalb», «dennoch» and «außerdem» share when they begin a sentence?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "They occupy position 1 and cause the immediate inversion of the conjugated verb into position 2.",
       "lengua": "alumno",
       "explicacion": "They are sentence adverbs that require the verb to be placed before the subject.",
       "correcta": true
      },
      {
