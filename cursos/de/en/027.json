   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "The days",
     "texto": [
      "Days are nouns, so they are written with a **capital letter**, and they are all masculine. They take **am**: **am Montag** (on Monday).",
      "**Heute** = today. **Am Wochenende** = on the weekend."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "The days of the week",
     "columnas": [
      {
       "texto": "German",
       "lengua": "alumno"
      },
      {
       "texto": "English",
       "lengua": "alumno"
      }
     ],
     "filas": [
      [
       {
