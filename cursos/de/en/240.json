 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Logical deduction in the present and the past",
     "texto": [
      "When the speaker has conclusive clues about a fact, they use **müssen**:",
      "1. **Present time reference**: **conjugated modal + Infinitiv** (**Das Licht brennt, er muss im Büro sein** = the light is on, he is surely in the office).",
      "2. **Past time reference**: **conjugated modal + Partizip II + haben/sein** (**Er muss im Stau gestanden haben** = he must have been stuck in a traffic jam; **Sie muss den Zug verpasst haben** = she must have missed the train)."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Type of use",
     "columnas": [
      {
       "texto": "Example",
       "lengua": "alumno"
      },
      {
       "texto": "Communicative value",
       "lengua": "alumno"
      }
     ],
