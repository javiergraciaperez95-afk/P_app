   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "The dative endings in possessives",
     "texto": [
      "Masculine and neuter: **meinem**, **deinem**, **seinem**, **ihrem**, **unserem**: *Ich fahre mit meinem Vater* (I'm going with my father); *Er hilft seinem Kind* (He helps his child).",
      "Feminine: **meiner**, **deiner**, **seiner**, **ihrer**, **unserer**: *Sie wohnt bei ihrer Mutter* (She lives with her mother).",
      "Plural: **meinen**, **deinen**, **seinen**, **ihren**, **unseren** + noun ending in -n: *Wir sprechen mit unseren Gästen* (We talk with our guests)."
     ],
     "tutora": ""
    },
    {
