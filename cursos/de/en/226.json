     "opciones": [
      {
       "texto": "When the Konjunktiv I form morphologically coincides with the indicative.",
       "lengua": "alumno",
       "explicacion": "The substitution ensures that the reader recognises the reported speech.",
       "correcta": true
      },
      {
       "texto": "Exclusively when the speaker wants to express that the statement is a lie.",
       "lengua": "alumno",
       "explicacion": "Konjunktiv II in indirect speech doesn't qualify truthfulness; it only avoids formal ambiguity.",
       "correcta": false
      },
      {
       "texto": "Only when the main clause is conjugated in the future tense.",
       "lengua": "alumno",
       "explicacion": "The rule depends on morphological coincidence, not on the tense of the main clause.",
