     "id": "de226-4",
     "pregunta": {
      "texto": "Why is «sie würden fordern» preferred over «sie forderten» in spoken language and everyday press?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Because «forderten» is identical to the simple past (Präteritum) of the indicative and creates temporal confusion.",
       "lengua": "alumno",
       "explicacion": "In weak verbs, Konjunktiv II formally coincides with the Präteritum.",
       "correcta": true
      },
      {
       "texto": "Because the verb «fordern» has no conjugation in written German.",
       "lengua": "alumno",
       "explicacion": "All regular verbs have a complete paradigm.",
       "correcta": false
      },
      {
       "texto": "Because «würden» can only be used with singular nouns.",
       "lengua": "alumno",
       "explicacion": "«würden» is the conjugated plural form for «sie» or «wir».",
       "correcta": false
      }
