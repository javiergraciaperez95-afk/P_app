   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Use in the past versus seit",
     "texto": [
      "**Vor** shows that the event has already finished: **Der Zug ist vor zehn Minuten angekommen** (the train arrived ten minutes ago). By contrast, **seit** shows that the situation is still active today: **Ich wohne seit zehn Jahren hier** (I've lived here for ten years)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Declension in the dative with vor",
     "texto": [
      "With masculine and neuter nouns: **vor einem Monat**, **vor einem Jahr**. With feminine nouns: **vor einer Stunde**, **vor einer Woche**. In the plural: **vor zwei Tagen**, **vor drei Wochen**."
     ],
     "tutora": ""
    },
