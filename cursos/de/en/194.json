    {
     "tipo": "explicacion",
     "titulo": "Temporal and spatial prepositions with the genitive",
     "texto": ["Some time and place prepositions take the genitive: **innerhalb** (within a time limit: **innerhalb eines Monats**), **außerhalb** (outside opening hours or deadlines: **außerhalb der Geschäftszeiten**) and **während** (during a continuous period: **während des Verfahrens**)."],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Preposition",
     "columnas": [
      {
       "texto": "Temporal meaning",
       "lengua": "alumno"
      },
      {
       "texto": "Formal example",
       "lengua": "alumno"
      },
      {
       "texto": "Note",
       "lengua": "alumno"
      }
     ],
