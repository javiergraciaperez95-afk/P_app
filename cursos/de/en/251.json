      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Inserted between the separable prefix and the verb root: «beizulegen», «einzugehen».",
       "lengua": "alumno",
       "explicacion": "In verbs with a separable prefix the particle «zu» becomes part of the word's interior.",
       "correcta": true
      },
      {
       "texto": "In front of the whole main clause, before the subject.",
       "lengua": "alumno",
       "explicacion": "The particle «zu» accompanies only the infinitive form at the end.",
       "correcta": false
      },
      {
       "texto": "Always separated at the end of the sentence after the full stop.",
       "lengua": "alumno",
       "explicacion": "It forms a single written word with the separable verb.",
