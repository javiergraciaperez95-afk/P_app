     "opciones": [
      {
       "texto": "They require inversion: the conjugated verb moves to position 2, placed immediately before the subject.",
       "lengua": "alumno",
       "explicacion": "By acting as adverbial connectors in position 1, they trigger the obligatory grammatical inversion.",
       "correcta": true
      },
      {
       "texto": "They move the conjugated verb to the very end of the sentence, as if they were subordinating conjunctions.",
       "lengua": "alumno",
       "explicacion": "They are not subordinators but adverbs that form part of the main clause structure.",
       "correcta": false
      },
      {
       "texto": "They keep the verb in third position after the subject, without altering the straight order.",
       "lengua": "alumno",
       "explicacion": "The verb cannot remain in third position after an initial adverbial element.",
       "correcta": false
      }
