     "pregunta": {
      "texto": "What syntactic order do «einerseits» and «andererseits» cause when they head their respective clauses?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
