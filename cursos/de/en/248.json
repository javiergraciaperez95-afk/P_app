 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "The adjectival declension of participles",
     "texto": [
      "Depending on the preceding determiner (definite article, indefinite article or none), the participle receives the endings of the weak, mixed or strong declension:",
      "1. **Attributive Partizip I**: **das strahlende Licht** (neuter nominative, weak), **mit steigender Freude** (feminine dative, strong).",
      "2. **Attributive Partizip II**: **ein restauriertes Gemälde** (neuter nominative, mixed), **die ausgestellten Skulpturen** (plural accusative, weak).",
      "In all cases they agree strictly in gender, number and case with the noun they modify."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Structure",
     "columnas": [
      {
       "texto": "Case and gender",
       "lengua": "alumno"
      },
      {
       "texto": "Example",
       "lengua": "alumno"
      }
     ],
