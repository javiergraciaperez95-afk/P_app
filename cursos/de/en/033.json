   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "How much",
     "texto": [
      "**Wie viel** goes with things you don't count: **Wie viel Reis?** (how much rice?). **Wie viele** goes with things you count, in the plural: **Wie viele Eier?** (how many eggs?).",
      "**Viel** = much / a lot. **Wenig** = little. **Nicht viel** = not much.",
      "With measures, German doesn't use «of» either: **ein Kilo Tomaten**, **ein Liter Milch**."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Quantities",
     "columnas": [
      {
       "texto": "",
       "lengua": "alumno"
      },
