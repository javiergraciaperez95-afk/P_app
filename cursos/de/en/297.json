    {
     "tipo": "test",
     "id": "de297-1",
     "pregunta": {
      "texto": "What period is granted to the consumer to exercise his statutory right of withdrawal?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "A period of fourteen calendar days without the need to justify the decision.",
       "lengua": "alumno",
       "explicacion": "The text expressly indicates: innerhalb von vierzehn Tagen ohne Angabe von Gründen.",
       "correcta": true
      },
      {
       "texto": "A maximum period of forty-eight hours subject to judicial authorisation.",
       "lengua": "alumno",
       "explicacion": "An incorrect period not supported by the specification.",
       "correcta": false
      },
      {
       "texto": "A full year provided the product has not left the central warehouses.",
       "lengua": "alumno",
       "explicacion": "No ordinary annual withdrawal period is foreseen.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
