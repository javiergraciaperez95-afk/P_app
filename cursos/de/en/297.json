     "id": "de297-3",
     "pregunta": {
      "texto": "What does it mean?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "Voraussetzung für die Erstattung ist, dass die Ware unbeschädigt bleibt.",
      "lengua": "estudio"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "The requirement for the reimbursement is that the goods remain undamaged.",
       "lengua": "alumno",
       "explicacion": "Copulative sentence that sets the indispensable condition for refunding the money.",
       "correcta": true
      },
      {
       "texto": "The company will reimburse the amount only through redeemable purchase vouchers.",
       "lengua": "alumno",
       "explicacion": "It does not address the form of payment, but the condition of the returned item.",
       "correcta": false
      },
      {
       "texto": "The customer will bear fifty per cent of the depreciation caused to the product.",
       "lengua": "alumno",
       "explicacion": "A clause that does not exist in the text provided.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
