     "oir_frase": false,
     "opciones": [
      {
       "texto": "With «wäre» plus the participle II («wäre gekommen»)",
       "lengua": "alumno",
       "explicacion": "As «kommen» forms its compound tenses with «sein», in the unreal past it uses «wäre».",
       "correcta": true
      },
      {
       "texto": "With «hätte» plus the participle II («hätte gekommen»)",
       "lengua": "alumno",
