     "id": "de264-1",
     "pregunta": {
      "texto": "Which element determines the grammatical gender and plural in a German compound noun?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Always the last element of the compound (Grundwort).",
       "lengua": "alumno",
       "explicacion": "The final head governs the article and the inflectional endings.",
       "correcta": true
      },
      {
       "texto": "The first element (Bestimmungswort), because it provides the main topic.",
       "lengua": "alumno",
       "explicacion": "The first term only specifies or qualifies.",
       "correcta": false
      },
      {
       "texto": "It depends exclusively on whether the word describes a person or an inanimate object.",
       "lengua": "alumno",
       "explicacion": "The morphological rule of the final head is universal in German.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
