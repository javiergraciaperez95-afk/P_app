    {
     "tipo": "traduccion",
     "id": "de266-6",
     "pregunta": {
      "texto": "What stylistic nuance does this expression add?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "Die Restauratoren haben ihr Können eindrucksvoll unter Beweis gestellt.",
      "lengua": "estudio"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "It raises the formal register by replacing the common verb «beweisen» with a cultivated turn.",
       "lengua": "alumno",
       "explicacion": "It adds stylistic density typical of technical reports and expert opinions.",
       "correcta": true
      },
      {
       "texto": "It turns an affirmative sentence into a doubtful conjecture in the past.",
       "lengua": "alumno",
       "explicacion": "It keeps the indicative affirmation in present perfect.",
       "correcta": false
      },
      {
       "texto": "It obligatorily requires the impersonal passive with a dative pronoun.",
       "lengua": "alumno",
       "explicacion": "It is an active transitive clause with a support verb.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
