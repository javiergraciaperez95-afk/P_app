    {
     "tipo": "traduccion",
     "id": "de266-3",
     "pregunta": {
      "texto": "What does «zur Debatte stehen» express?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "Die Konservierung des Denkmals steht heute im Kulturausschuss zur Debatte.",
      "lengua": "estudio"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "That the project is being formally analysed and discussed by the committee.",
       "lengua": "alumno",
       "explicacion": "It is equivalent to the formal passive «wird debattiert / diskutiert».",
       "correcta": true
      },
      {
       "texto": "That the committee has definitively banned any discussion about the monument.",
       "lengua": "alumno",
       "explicacion": "It states the very opposite of the content of the collocation.",
       "correcta": false
      },
      {
       "texto": "That the monument has been demolished without prior administrative notice.",
       "lengua": "alumno",
       "explicacion": "It confuses the term with a demolition action.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
