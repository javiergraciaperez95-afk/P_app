     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "treffen",
       "lengua": "estudio",
       "explicacion": "The fixed institutional collocation in German is «eine Entscheidung treffen».",
       "correcta": true
      },
      {
       "texto": "machen",
       "lengua": "estudio",
       "explicacion": "It is a literal interference from Spanish («hacer una decisión») rejected at B2.",
       "correcta": false
      },
      {
       "texto": "tun",
       "lengua": "estudio",
       "explicacion": "The verb «tun» does not form an idiomatic collocation with «Entscheidung».",
