   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "As… as",
     "texto": [
      "To say that two things are equal, use **so** + adjective + **wie**: **Er ist so alt wie ich** (he's as old as I am).",
      "To say they aren't equal: **nicht so … wie**: **Der Bus ist nicht so schnell wie der Zug** (the bus isn't as fast as the train)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "More and more",
     "texto": [
      "With **immer** before a comparative you say \"more and more\": **immer schneller** (faster and faster).",
      "Watch out for the false friend: **immer** doesn't mean \"immediately\". It means \"always\" and, with a comparative, \"more and more\"."
     ],
     "tutora": ""
    },
