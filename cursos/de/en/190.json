 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Rules for endings in masculine and neuter",
     "texto": [
      "In the genitive of masculine and neuter nouns, the ending depends on the word's structure: monosyllables and stems ending in a sibilant (-s, -ß, -z, -sch, -x) take **-es** (des Gesetzes); polysyllables with an unstressed suffix (-el, -en, -er, -ling) take **-s** (des Wagens); and masculine weak-declension nouns take **-(e)n** (des Kollegen)."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Word type",
     "columnas": [
      {
       "texto": "Noun ending",
       "lengua": "alumno"
      },
      {
       "texto": "Phonetic rule",
       "lengua": "alumno"
      },
      {
       "texto": "Example",
       "lengua": "alumno"
      }
     ],
     "filas": [
      [
       {
        "texto": "Monosyllables or stem in a sibilant (-s, -ß, -z, -sch, -x)",
        "lengua": "alumno"
       },
       {
        "texto": "They end in **-es**",
        "lengua": "alumno"
       },
       {
        "texto": "Makes pronunciation easier",
        "lengua": "alumno"
       },
       {
        "texto": "des Beschlusses, des Gesetzes, des Arztes",
        "lengua": "estudio"
       }
      ],
      [
       {
        "texto": "Polysyllables with unstressed suffix (-el, -en, -er, -ling)",
        "lengua": "alumno"
       },
       {
        "texto": "They end in **-s**",
        "lengua": "alumno"
       },
       {
        "texto": "Without intermediate vowel",
        "lengua": "alumno"
       },
       {
        "texto": "des Bürgermeisters, des Wagens, des Lehrers",
        "lengua": "estudio"
       }
      ],
      [
       {
        "texto": "Masculine nouns of weak declension (n-Deklination)",
        "lengua": "alumno"
       },
       {
        "texto": "They end in **-(e)n**",
        "lengua": "alumno"
       },
       {
        "texto": "Without genitive «-s»",
        "lengua": "alumno"
       },
       {
        "texto": "des Mandanten, des Kollegen, des Experten",
        "lengua": "estudio"
       }
      ]
     ],
     "nota": "",
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Adjective declension",
     "texto": [
      "The attributive adjective before a masculine or neuter noun in the genitive always takes the ending **-en**: **infolge des unerwarteten Beschlusses**, **aufgrund eines schweren Fehlers**."
     ],
     "tutora": ""
    }
   ]
  },
