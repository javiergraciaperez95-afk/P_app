    },
    {
     "tipo": "explicacion",
     "titulo": "Past time words",
     "texto": [
      "**Gestern** = yesterday. **Gestern Abend** = last night. **Letzte Woche** = last week. **Letztes Jahr** = last year.",
      "**Da** = there. **Krank** = ill. **Toll** = great. **Lecker** = tasty."
     ],
     "tutora": ""
