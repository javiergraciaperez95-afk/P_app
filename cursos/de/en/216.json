   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Construction of Future II",
     "texto": [
      "It consists of the present of **werden** (in position 2), the past participle (**Partizip II**) and the infinitive of the auxiliary (**haben** or **sein**, depending on the verb) at the very end: **Bis Freitag wird sie den Bericht geschrieben haben** (by Friday she will have written the report). With verbs of change of place or state sein is used: **Morgen um zehn Uhr werde ich angekommen sein** (tomorrow at ten I will have arrived)."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Main verb",
     "columnas": [
      {
       "texto": "Auxiliary",
       "lengua": "alumno"
      },
      {
       "texto": "Example in Future II",
       "lengua": "alumno"
      },
      {
       "texto": "Meaning",
       "lengua": "alumno"
      }
     ],
     "filas": [
      [
       {
        "texto": "schreiben",
        "lengua": "estudio"
       },
       {
        "texto": "haben",
        "lengua": "estudio"
       },
       {
        "texto": "Er wird den Text geschrieben haben.",
        "lengua": "estudio"
       },
       {
        "texto": "She will have written the text.",
