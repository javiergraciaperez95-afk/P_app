     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "«sowohl … als auch» formulates a neutral symmetrical addition, while «nicht nur … sondern auch» introduces an emphatic emphasis on the second term.",
