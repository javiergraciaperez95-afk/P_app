   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "The scale of probability in formal discourse",
     "texto": [
      "In economic journalism and market reports, the author's conviction is expressed through specialised adverbs:",
      "1. **zweifellos / gewiss / sicher** (100% certainty): **Der Markt wird zweifellos wachsen** (the market will undoubtedly grow).",
      "2. **vermutlich / wahrscheinlich / wohl** (high probability): **Die Kunden kaufen vermutlich online** (customers probably buy online).",
      "3. **offenbar / anscheinend** (visible or apparent evidence): **Offenbar bevorzugen sie Apps** (apparently they prefer apps).",
      "These qualifiers avoid premature categorical statements in professional analysis."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Adverb",
     "columnas": [
      {
       "texto": "Degree of certainty",
       "lengua": "alumno"
      },
      {
       "texto": "Contextual meaning",
       "lengua": "alumno"
      }
     ],
     "filas": [
