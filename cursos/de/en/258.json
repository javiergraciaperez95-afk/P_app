    {
     "tipo": "test",
     "id": "de258-1",
     "pregunta": {
      "texto": "What case must the explanatory apposition take in German?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "The same grammatical case as the noun it complements and explains.",
       "lengua": "alumno",
       "explicacion": "The apposition agrees strictly in case with its reference term.",
       "correcta": true
      },
      {
       "texto": "Always the nominative case regardless of the rest of the sentence.",
       "lengua": "alumno",
       "explicacion": "In German the apposition inflects to match the case of the head.",
       "correcta": false
      },
      {
       "texto": "Only the possessive genitive case.",
       "lengua": "alumno",
       "explicacion": "It only takes genitive if the head is in genitive.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
    {
     "tipo": "huecos",
     "id": "de258-2",
     "pregunta": {
      "texto": "to the (dative feminine of the apposition)",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "Wir gratulieren Frau Klein, ___ erfolgreichen Leiterin des Projekts.",
      "lengua": "estudio"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "der",
       "lengua": "estudio",
       "explicacion": "The verb «gratulieren» governs the dative («Frau Klein»), so the apposition takes «der».",
       "correcta": true
      },
      {
       "texto": "die",
       "lengua": "estudio",
       "explicacion": "It would be nominative or accusative feminine; it does not agree with the dative.",
       "correcta": false
      },
      {
       "texto": "den",
       "lengua": "estudio",
       "explicacion": "It corresponds to masculine accusative or plural dative.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
    {
     "tipo": "traduccion",
     "id": "de258-3",
     "pregunta": {
      "texto": "Why does the apposition take «dem»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "Die Belegschaft dankte Herrn Professor Krause, dem scheidenden Direktor.",
      "lengua": "estudio"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Because «danken» governs the dative and the apposition «scheidenden Direktor» agrees with «Herrn Krause».",
       "lengua": "alumno",
       "explicacion": "Mandatory agreement in singular masculine dative.",
       "correcta": true
      },
      {
       "texto": "Because «Direktor» is a neuter word in nominative.",
       "lengua": "alumno",
       "explicacion": "It is a masculine noun functioning as apposition in dative.",
       "correcta": false
      },
      {
       "texto": "Because it introduces a subordinate relative clause without a verb.",
       "lengua": "alumno",
       "explicacion": "It is a closed nominal apposition between commas, not a relative clause.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
    {
     "tipo": "test",
     "id": "de258-4",
     "pregunta": {
      "texto": "Which punctuation rule is compulsory for intermediate explanatory appositions?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "They must be set off by two commas: one opening and one closing.",
       "lengua": "alumno",
       "explicacion": "«Frau Weber, die neue Leiterin, spricht heute zu uns».",
       "correcta": true
      },
      {
       "texto": "A comma is only placed at the beginning of the apposition, never at the end.",
       "lengua": "alumno",
       "explicacion": "Omitting the closing comma is a serious spelling mistake in German.",
       "correcta": false
      },
      {
       "texto": "No comma is placed if the apposition has more than three words.",
       "lengua": "alumno",
       "explicacion": "Comma delimitation applies regardless of length.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
    {
     "tipo": "huecos",
     "id": "de258-5",
     "pregunta": {
      "texto": "of a (genitive masculine)",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "Das Urteil des Richters, ___ erfahrenen Juristen, stieß auf breite Zustimmung.",
      "lengua": "estudio"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "eines",
       "lengua": "estudio",
       "explicacion": "As the head «des Richters» is in genitive, the apposition requires the genitive «eines».",
       "correcta": true
      },
      {
       "texto": "einem",
       "lengua": "estudio",
       "explicacion": "It would correspond to dative case.",
       "correcta": false
      },
      {
       "texto": "einen",
