        "lengua": "estudio"
       },
       {
        "texto": "Summarises the entire content of the preceding sentence",
        "lengua": "alumno"
       },
       {
        "texto": "Das Gesetz passierte das Plenum. Dies war ein Meilenstein.",
        "lengua": "estudio"
       }
      ],
      [
