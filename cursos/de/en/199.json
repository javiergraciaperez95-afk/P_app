     "pregunta": {
      "texto": "What punctuation and coordination rule applies to «sondern auch»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "A comma must precede «sondern», and «auch» goes with the second coordinated element.",
       "lengua": "alumno",
       "explicacion": "A comma is placed before «sondern», delimiting the two coordinated members.",
       "correcta": true
      },
      {
       "texto": "A comma is never written, and «auch» must always be placed before «sondern».",
       "lengua": "alumno",
       "explicacion": "The position «auch sondern» is ungrammatical in standard German.",
       "correcta": false
      },
      {
       "texto": "It always requires the conjugated verb to be placed at the end of the sentence in the subjunctive.",
       "lengua": "alumno",
       "explicacion": "It doesn't introduce a subordinate clause with a final verb; it coordinates phrases or independent clauses.",
       "correcta": false
      }
     ],
