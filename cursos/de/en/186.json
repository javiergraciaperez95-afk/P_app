    {
     "tipo": "test",
     "id": "de186-1",
     "pregunta": {
      "texto": "In the sentence «Wir prüfen das Gutachten des Sachverständigen, das die Verteidigung vorgelegt hat», what element does the relative clause with «das» modify?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "It modifies «das Gutachten» (neuter), since the relative pronoun «das» agrees in gender and number with the report and not with the expert («der Sachverständige»).",
       "lengua": "alumno",
       "explicacion": "The gender distinction makes clear that what was presented is the report and not the expert's person.",
       "correcta": true
      },
      {
       "texto": "It modifies «der Sachverständige», because experts always agree in neuter when they draw up reports.",
       "lengua": "alumno",
       "explicacion": "Personal masculine nouns never take a neuter pronoun in relative clauses.",
       "correcta": false
      },
      {
       "texto": "It modifies the lawyer who signs the minutes of the court session.",
       "lengua": "alumno",
       "explicacion": "The lawyer is not the immediate antecedent and does not share gender with «das».",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
    {
