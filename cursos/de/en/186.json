     "oir_frase": false,
     "opciones": [
      {
       "texto": "von der",
       "lengua": "estudio",
       "explicacion": "«verlangen von» governs the dative, and «die Zeugin» is a feminine singular antecedent.",
       "correcta": true
      },
      {
