     "opciones": [
      {
       "texto": "He handed the chairperson of the court the file that contained all the decisive clues.",
       "lengua": "alumno",
       "explicacion": "The feminine relative «die» refers unambiguously to «die Akte» (file) and not to the chairperson («der Vorsitzende»).",
       "correcta": true
      },
      {
       "texto": "He handed the chairperson of the court, who was the person that contained all the evidentiary clues.",
