     "oir_frase": false,
     "opciones": [
      {
       "texto": "die",
       "lengua": "estudio",
       "explicacion": "«auf» with «aufbauen» in the figurative sense of being based on governs the plural accusative («auf die Indizien»).",
       "correcta": true
      },
      {
