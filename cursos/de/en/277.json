     "id": "de277-1",
     "pregunta": {
      "texto": "What communicative nuance favours the use of «da» at the start of an utterance instead of «weil»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "«da» takes up a circumstance known or presupposed in the debate («as / since we already know»).",
       "lengua": "alumno",
       "explicacion": "It serves as a natural thematic bridge from an accepted premise.",
       "correcta": true
      },
      {
       "texto": "«da» indicates a completely impossible or counterfactual condition in the future.",
       "lengua": "alumno",
       "explicacion": "It does not express counterfactual value; it is a strictly causal conjunction.",
       "correcta": false
      },
      {
       "texto": "«da» prevents the verb of its clause from moving to the end of the sentence.",
       "lengua": "alumno",
       "explicacion": "Like any German subordinating conjunction, it places the conjugated verb at the end.",
       "correcta": false
      }
     ],
     "respuestas": {
