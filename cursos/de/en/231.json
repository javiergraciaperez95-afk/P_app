 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Choosing between process and state",
     "texto": [
      "**Werden + Partizip II** focuses on the event: **Der Patient wird operiert** (they're operating on the patient / the patient is being operated on). **Sein + Partizip II** focuses on the resulting state: **Der Patient ist operiert** (the patient is already operated on). The context, not only the form, decides whether the process passive is translated with \"gets\" or \"is being\"."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Identifying the tense",
     "texto": [
      "**Der Patient wurde operiert** is the Präteritum of the process passive (they operated on him / he was operated on). **Der Patient ist operiert worden** is the Perfekt of that passive. By contrast, **Der Patient ist operiert** describes the current state. They are not interchangeable: notice **worden** and the situation described."
     ],
     "tutora": ""
    },
