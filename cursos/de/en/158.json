     "pregunta": {
      "texto": "What is the main function of the process passive (Vorgangspassiv)?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "To highlight the action or process in progress regardless of who carries it out",
       "lengua": "alumno",
       "explicacion": "The passive puts the communicative focus on the event that the object undergoes, not on the active agent.",
       "correcta": true
      },
      {
       "texto": "Indicating only the resulting final state of an object",
       "lengua": "alumno",
       "explicacion": "The resulting final state is expressed with the state passive using «sein» (Zustandspassiv).",
       "correcta": false
      },
      {
       "texto": "Forcing the subject to carry out an action in the immediate future",
       "lengua": "alumno",
       "explicacion": "It expresses the passive voice, not an imperative order or a modal obligation.",
       "correcta": false
      }
     ],
