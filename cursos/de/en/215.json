   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "The future and time",
     "texto": [
      "If a sentence already includes a specific time expression (**morgen**, **nächstes Jahr**, **bald**), native speakers usually prefer the present: **Nächstes Jahr fahre ich nach Wien**. When **werden + infinitive** is used, it emphasises commitment, determination or an explicit prediction: **In zwei Jahren werde ich mein Studium beenden**. In both cases the syntactic order respects position 2 of the finite verb and sends the infinitive to the very end."
     ],
     "tutora": ""
    },
