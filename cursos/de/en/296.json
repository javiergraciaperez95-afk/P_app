     "pregunta": {
      "texto": "How does «haben + zu + Infinitiv» differ syntactically from «sein + zu + Infinitiv»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "«haben + zu» expresses obligation in the active voice with an agent subject; «sein + zu» expresses passive obligation or possibility over the object.",
       "lengua": "alumno",
       "explicacion": "Der Mieter hat die Kaution zu zahlen (active) versus Die Kaution ist zu zahlen (passive).",
       "correcta": true
      },
      {
       "texto": "Both constructions are identical and can be interchanged without altering the grammatical person.",
       "lengua": "alumno",
       "explicacion": "Confusing the two would cause a serious grammatical error of voice.",
       "correcta": false
      },
      {
       "texto": "«sein + zu» can only be used with adjectives and never with infinitive verbs.",
       "lengua": "alumno",
       "explicacion": "It compulsorily requires a verb in the infinitive with zu.",
       "correcta": false
      }
     ],
