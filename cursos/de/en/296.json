      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "It expresses a formal obligation equivalent to müssen in the passive voice: the rules must be observed rigorously.",
       "lengua": "alumno",
       "explicacion": "sein + zu + Infinitiv acts as a cultivated synonym of müssen + Partizip + werden.",
       "correcta": true
      },
      {
       "texto": "It expresses an express prohibition equivalent to nicht dürfen under penal sanction.",
       "lengua": "alumno",
       "explicacion": "It is not a prohibition but an order of strict observance.",
       "correcta": false
      },
      {
       "texto": "It poses a subjective non-binding recommendation equivalent to man könnte beachten.",
       "lengua": "alumno",
       "explicacion": "It expresses a normative obligation, not a mere optional suggestion.",
       "correcta": false
      }
