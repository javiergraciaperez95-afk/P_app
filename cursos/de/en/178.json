     "id": "de178-1",
     "pregunta": {
      "texto": "How is a direct object noun negated within an infinitive clause?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "By the corresponding form of the indefinite determiner «kein-» declined before the noun",
       "lengua": "alumno",
       "explicacion": "For example: «keine Fehler zu machen» or «kein Risiko einzugehen».",
       "correcta": true
      },
      {
       "texto": "By adding only «nicht» at the very end of the sentence after the infinitive",
       "lengua": "alumno",
       "explicacion": "In German, the negation of indefinite nouns rejects «nicht» placed after the verb.",
       "correcta": false
      },
      {
       "texto": "By using the preposition «ohne» repeated before and after the noun",
       "lengua": "alumno",
       "explicacion": "«ohne» is a privative modal preposition, not the negation operator of a noun.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
