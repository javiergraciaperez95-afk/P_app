    {
     "tipo": "test",
     "id": "de276-1",
     "pregunta": {
      "texto": "Why is it grammatically incorrect to say *«Er ging, ohne die Kollegen ihn bemerkten»*?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Because when the subject changes the subordinating conjunction «ohne dass» with the verb at the end is obligatory.",
       "lengua": "alumno",
       "explicacion": "The change of agent prevents the use of truncated constructions without a subordinating link.",
       "correcta": true
      },
      {
       "texto": "Because the verb «bemerken» prohibits the presence of third person pronouns.",
       "lengua": "alumno",
       "explicacion": "No such pronominal restriction exists.",
       "correcta": false
      },
      {
       "texto": "Because clauses with «ohne» only admit the present indicative tense.",
       "lengua": "alumno",
       "explicacion": "They combine with any tense depending on the discourse frame.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
    {
     "tipo": "huecos",
     "id": "de276-2",
     "pregunta": {
      "texto": "without",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "Die Novelle wurde beschlossen, ___ dass die Fachverbände Einwände erhoben.",
      "lengua": "estudio"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "ohne",
       "lengua": "estudio",
       "explicacion": "The conjunctive locution is «ohne dass» before a change of subject.",
       "correcta": true
      },
      {
       "texto": "statt",
       "lengua": "estudio",
       "explicacion": "«statt dass» would express substitution («instead of that»), not circumstantial privation.",
       "correcta": false
      },
      {
       "texto": "außer",
       "lengua": "estudio",
       "explicacion": "«außer dass» denotes exclusive exception («except that»).",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
    {
     "tipo": "traduccion",
     "id": "de276-3",
     "pregunta": {
      "texto": "Why is «ohne … zu» used?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "Der Abgeordnete stimmte gegen den Haushalt, ohne seine Beweggründe im Plenum zu erklären.",
      "lengua": "estudio"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Because the subject who votes and the subject who does not explain their motives are exactly the same person.",
       "lengua": "alumno",
       "explicacion": "Identity of subject requires the more economical construction of the infinitive with «zu».",
       "correcta": true
      },
      {
       "texto": "Because parliament requires that all votes be held without the «dass» link.",
       "lengua": "alumno",
       "explicacion": "It is not a parliamentary regulation rule, but a syntax rule.",
       "correcta": false
      },
      {
       "texto": "Because the verb «erklären» is an intransitive verb that rejects subordinate clauses.",
       "lengua": "alumno",
       "explicacion": "«erklären» is transitive and here governs the direct object «Beweggründe».",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
