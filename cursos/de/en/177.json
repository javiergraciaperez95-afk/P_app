     "opciones": [
      {
       "texto": "To present an alternative action that is discarded in favour of the one actually carried out",
       "lengua": "alumno",
       "explicacion": "It contrasts two incompatible options, highlighting the one that was not carried out.",
       "correcta": true
      },
      {
       "texto": "To express the indispensable condition for the main action to be fulfilled",
       "lengua": "alumno",
       "explicacion": "The condition is expressed with «wenn», not with a substitution clause.",
       "correcta": false
      },
      {
       "texto": "To indicate the cause or reason why a decision was taken in the past",
       "lengua": "alumno",
       "explicacion": "Causality is introduced with «weil» or «da», not with «statt … zu».",
       "correcta": false
      }
