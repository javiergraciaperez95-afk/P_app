     "opciones": [
      {
       "texto": "Syntactic inversion occurs: the conjugated verb moves immediately into first position after the comma",
       "lengua": "alumno",
       "explicacion": "The full subordinate clause occupies position 1, so the main verb goes in position 2.",
       "correcta": true
      },
      {
       "texto": "The subject of the main clause must necessarily be placed before the conjugated verb",
       "lengua": "alumno",
       "explicacion": "It would break the invariable German rule of position 2 for the conjugated verb in main clauses.",
       "correcta": false
      },
      {
       "texto": "The main clause's verb must be placed at the very end",
