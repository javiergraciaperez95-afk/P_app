     "pregunta": {
      "texto": "What function does the structure «statt … zu» perform in a sentence?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
