    {
     "tipo": "test",
     "id": "de250-4",
     "pregunta": {
      "texto": "Why is it possible to say «der angekommene Zug», but NOT «*das gearbeitete Personal»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Because «ankommen» is an intransitive verb of change that forms its tense with «sein».",
       "lengua": "alumno",
       "explicacion": "Only intransitives with «sein» admit an attributive Partizip II with a completed active meaning.",
       "correcta": true
      },
      {
       "texto": "Because «arbeiten» is an irregular verb with no participle ending in «-t».",
       "lengua": "alumno",
       "explicacion": "«gearbeitet» is the regular participle, but it does not admit an attributive adjectival function.",
       "correcta": false
      },
      {
       "texto": "Because «Personal» is a collective noun that accepts no adjective.",
       "lengua": "alumno",
       "explicacion": "It accepts normal adjectives («qualifiziertes Personal»), but not incompatible participles.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
