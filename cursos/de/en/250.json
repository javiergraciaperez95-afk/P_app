     "id": "de250-1",
     "pregunta": {
      "texto": "In the expression «die gelieferten Sensoren», what relation does the participle have to the noun?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Passive and resultative: the sensors were supplied by the supplier.",
       "lengua": "alumno",
       "explicacion": "The Partizip II of a transitive verb attributes the action suffered by the object.",
       "correcta": true
      },
      {
       "texto": "Active present: the sensors are delivering packages to the technicians.",
       "lengua": "alumno",
       "explicacion": "The sensors do not deliver anything; they are the ones delivered.",
       "correcta": false
      },
      {
       "texto": "Hypothetical future: the sensors may be manufactured next year.",
       "lengua": "alumno",
       "explicacion": "It describes a completed state after the actual delivery.",
       "correcta": false
      }
     ],
     "respuestas": {
