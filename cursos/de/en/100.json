   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Genauso versus weniger",
     "texto": [
      "1. **Genauso + Adjektiv + wie**: *Das Zimmer ist genauso gemütlich wie das Luxushotel* (the room is exactly as cosy as the luxury hotel); *Die Miete ist genauso hoch wie in Berlin* (the rent is as high as in Berlin).",
      "2. **weniger + Adjektiv + als**: *Die Unterkunft ist weniger teuer als gedacht* (the accommodation is less expensive than expected); *Dieser Koffer wiegt weniger als zehn Kilo* (this suitcase weighs less than ten kilos)."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Equivalence and inferiority",
