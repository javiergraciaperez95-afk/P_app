     "tipo": "test",
     "id": "de243-1",
     "pregunta": {
      "texto": "In the phrase «Die Schließung zweier Produktionsstätten», what function does «zweier Produktionsstätten» have?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "It is a noun complement in the genitive case specifying what is closed.",
       "lengua": "alumno",
       "explicacion": "Dense nominal groups use the genitive for the object of the nominalised action.",
       "correcta": true
      },
      {
       "texto": "It is the nominative plural subject that carries out the closing of the buildings.",
       "lengua": "alumno",
       "explicacion": "The head of the sentence is «die Schließung».",
       "correcta": false
      },
      {
       "texto": "It is a time adverbial in the dative case.",
       "lengua": "alumno",
       "explicacion": "It does not answer when, but which entities are the object of the measure.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
