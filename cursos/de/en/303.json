    },
    {
     "tipo": "test",
     "id": "de303-4",
     "pregunta": {
      "texto": "What meaning does the adverb «freilich» introduce into a formal argument?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "It provides a natural and reflective concession equivalent to «of course», «certainly» or «naturally».",
       "lengua": "alumno",
       "explicacion": "freilich qualifies and grants plausibility to a previous observation.",
       "correcta": true
      },
      {
       "texto": "It expresses a categorical prohibition similar to by no means.",
       "lengua": "alumno",
       "explicacion": "It has no value of veto or negative prohibition.",
       "correcta": false
      },
      {
       "texto": "It indicates the exact chronological time at which a parliamentary vote will begin.",
       "lengua": "alumno",
       "explicacion": "It is a modalising discursive marker, not a specific temporal adverb.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
