     "pregunta": {
      "texto": "Why is «woran» used and not «worauf» for the question \"What are you thinking about?\"",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Because the verb «denken» always governs the preposition «an» («denken an + Akk»)",
       "lengua": "alumno",
       "explicacion": "The interrogative pronoun must exactly reproduce the preposition governed by the verb.",
       "correcta": true
      },
      {
       "texto": "Because «an» necessarily indicates an enclosed place inside a building",
       "lengua": "alumno",
       "explicacion": "The prepositional government of abstract verbs is idiomatic and does not depend on physical location.",
       "correcta": false
      },
      {
       "texto": "Because «worauf» can only be used with verbs that express fast movement",
       "lengua": "alumno",
       "explicacion": "The distinction responds to the lexical government of each verb, not to the speed of the action.",
       "correcta": false
      }
     ],
