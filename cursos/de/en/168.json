     "opciones": [
      {
       "texto": "«Präposition + wen» (for example: «Auf wen wartest du?»)",
       "lengua": "alumno",
       "explicacion": "People require the preposition followed by the interrogative pronoun «wen» (accusative) or «wem» (dative).",
       "correcta": true
      },
      {
       "texto": "A question word with «wor-» (for example: «Worauf wartest du?»)",
       "lengua": "alumno",
       "explicacion": "The forms with «wo(r)-» refer exclusively to things, facts or concepts.",
       "correcta": false
      },
      {
       "texto": "The interrogative particle «was» followed by the preposition at the end",
       "lengua": "alumno",
       "explicacion": "It's a construction from English («What are you waiting for?») that doesn't exist in correct German.",
       "correcta": false
      }
