    {
     "tipo": "explicacion",
     "titulo": "Use with the present indicative",
     "texto": [
      "Unlike English (\"I have been living here for a year\"), in German the verb is in the **present indicative**: **Ich lerne seit drei Monaten Deutsch** (I've been learning German for three months and still am)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Declension in the dative with seit",
     "texto": [
      "With masculine and neuter nouns: **seit einem Monat**, **seit einem Jahr**. With feminine nouns: **seit einer Woche**. In the plural, nouns add **-n**: **seit zwei Jahren**, **seit drei Monaten**."
     ],
     "tutora": ""
    },
