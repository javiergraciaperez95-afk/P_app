      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "«auf» refers to an expected future event; «über» to something present or already happened.",
       "lengua": "alumno",
       "explicacion": "«sich freuen auf» looks ahead with anticipation; «sich freuen über» expresses satisfaction about something already received or experienced.",
       "correcta": true
      },
      {
       "texto": "«auf» is used exclusively for material gifts and «über» for trips or holidays",
       "lengua": "alumno",
       "explicacion": "Both can be combined with different kinds of objects depending on the time frame of the action.",
       "correcta": false
      },
      {
       "texto": "«auf» takes mandatory dative case, while «über» takes only the accusative",
       "lengua": "alumno",
       "explicacion": "Both verbs with their respective prepositions strictly take the accusative case.",
       "correcta": false
      }
