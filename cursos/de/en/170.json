   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Common reflexive verbs with a fixed preposition",
     "texto": [
      "1. **sich freuen auf (+ Akkusativ)**: Looking forward in advance to an expected future event: **Wir freuen uns auf den Urlaub** (we are looking forward to the holiday).",
      "2. **sich freuen über (+ Akkusativ)**: Being glad about a present or already occurred event: **Ich freue mich über das Geschenk** (I'm glad about the gift I already received).",
      "3. **sich interessieren für (+ Akkusativ)**: Showing interest in a field or subject: **Er interessiert sich für Geschichte**.",
      "4. **sich kümmern um (+ Akkusativ)**: To take care of a matter, to attend to someone: **Ich kümmere mich um die Reservierung**.",
      "5. **sich erinnern an (+ Akkusativ)**: To remember or keep a memory in mind: **Erinnerst du dich an unseren Ausflug?**.",
      "6. **sich bewerben um (+ Akkusativ)**: To apply for a job position: **Sie bewirbt sich um die Stelle**."
     ],
     "tutora": ""
    },
