     "autoevaluacion": false
    },
    {
     "tipo": "test",
     "id": "de217-3",
     "pregunta": {
      "texto": "What syntactic change does the connector «deshalb» produce at the start of a main clause?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "It causes inversion: the conjugated verb moves immediately into second position, before the subject.",
       "lengua": "alumno",
       "explicacion": "As a conjunctive adverb in position 1, «deshalb» directly precedes the verb («schreibe ich»).",
       "correcta": true
      },
      {
       "texto": "It sends the conjugated verb to the very end of the sentence.",
       "lengua": "alumno",
       "explicacion": "That only happens with subordinating conjunctions such as «weil» or «dass».",
       "correcta": false
      },
      {
       "texto": "It keeps the strict order of subject followed by verb unchanged.",
       "lengua": "alumno",
       "explicacion": "That would only occur with coordinating conjunctions of position zero (und, aber, denn).",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
