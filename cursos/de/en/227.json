   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Syntax with and without dass",
     "texto": [
      "In German indirect speech there are two main structures:",
      "1. **With dass**: introduces a full subordinate clause, which moves the verb in Konjunktiv to the very end (**Die Anwältin erklärt, dass ihr Mandant unschuldig sei**).",
      "2. **Without dass**: the reported sentence adopts the syntactic structure of an independent main clause, with the conjugated verb in Konjunktiv in second position (**Die Anwältin erklärt, ihr Mandant sei unschuldig**). Both models are correct and frequent in the press and in legal texts."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Type of structure",
     "columnas": [
      {
       "texto": "Position of the verb in Konjunktiv",
       "lengua": "alumno"
      },
      {
       "texto": "Example",
       "lengua": "alumno"
      }
     ],
     "filas": [
      [
       {
        "texto": "With the conjunction «dass»",
        "lengua": "alumno"
       },
       {
        "texto": "At the very end of the subordinate clause",
        "lengua": "alumno"
       },
       {
        "texto": "Der Zeuge sagt, dass er nichts gesehen habe.",
        "lengua": "estudio"
       }
      ],
      [
       {
        "texto": "Without a connector",
        "lengua": "alumno"
       },
       {
        "texto": "In second position (main clause order)",
        "lengua": "alumno"
       },
       {
        "texto": "Der Zeuge sagt, er habe nichts gesehen.",
        "lengua": "estudio"
       }
      ]
     ],
     "nota": "",
     "tutora": ""
    }
