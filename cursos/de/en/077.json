       }
      ],
      [
       {
        "texto": "er / sie / es",
        "lengua": "estudio"
       },
       {
        "texto": "sich",
        "lengua": "estudio"
       },
       {
        "texto": "Er ärgert sich über den Fehler.",
        "lengua": "estudio"
       }
      ],
      [
       {
        "texto": "wir",
        "lengua": "estudio"
       },
       {
        "texto": "uns",
        "lengua": "estudio"
       },
       {
        "texto": "Wir freuen uns über den Erfolg.",
        "lengua": "estudio"
       }
      ],
      [
       {
        "texto": "ihr",
