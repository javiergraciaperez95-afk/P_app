     "tipo": "test",
     "id": "de279-1",
     "pregunta": {
      "texto": "What function does the connector «Im Gegensatz dazu» fulfil at the start of the second paragraph?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "It introduces an antithesis that contrasts the domestic situation with the international tensions set out before.",
       "lengua": "alumno",
       "explicacion": "It articulates an explicit antithetical turn between two dimensions of the analysis.",
       "correcta": true
      },
      {
       "texto": "It indicates that the author concludes the article and formally takes leave of the newspaper editorial office.",
       "lengua": "alumno",
       "explicacion": "It has no concluding farewell function.",
       "correcta": false
      },
      {
       "texto": "It shows that the first section was full of unverified statistical falsehoods.",
       "lengua": "alumno",
       "explicacion": "It does not refute the previous paragraph, but contrasts different realities.",
