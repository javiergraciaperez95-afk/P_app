    {
     "tipo": "traduccion",
     "id": "de267-3",
     "pregunta": {
      "texto": "What does «doch» communicate in this exclamation?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "Das ist doch ein deutlicher Beweis für die Meisterschaft des Malers!",
      "lengua": "estudio"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "It vehemently reaffirms, in a friendly tone, an evidence in the face of possible hesitation.",
       "lengua": "alumno",
       "explicacion": "It seeks the interlocutor's agreement about a clue that is plain to see.",
       "correcta": true
      },
      {
       "texto": "It expresses an insurmountable doubt that invalidates the critic's argument.",
       "lengua": "alumno",
       "explicacion": "It does not denote scepticism, but expressive reaffirmation.",
       "correcta": false
      },
      {
       "texto": "It sets up a subordinate temporal condition with the verb inflected at the end.",
       "lengua": "alumno",
       "explicacion": "It is not a conditional conjunction; it is an illocutionary particle.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
    {
     "tipo": "test",
     "id": "de267-4",
     "pregunta": {
      "texto": "In which syntactic position of the main clause are modal particles usually placed?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "In the Mittelfeld, integrated in the chain of complements after the conjugated verb.",
       "lengua": "alumno",
       "explicacion": "They cannot occupy the first position (Vorfeld) of the declarative sentence.",
       "correcta": true
      },
      {
       "texto": "Obligatorily in the first position before the subject and the verb.",
       "lengua": "alumno",
       "explicacion": "Unstressed modal particles are ruled out in the Vorfeld.",
       "correcta": false
      },
      {
       "texto": "At the absolute end of the sentence after the closing participle or infinitive.",
       "lengua": "alumno",
       "explicacion": "The Satzende (Nachfeld) is not the ordinary location of these particles.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
