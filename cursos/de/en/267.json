     "tipo": "test",
     "id": "de267-1",
     "pregunta": {
      "texto": "What dialogic nuance does the modal particle «ja» add to a formal statement?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "It suggests that the fact is known, evident or shared by the interlocutors.",
       "lengua": "alumno",
       "explicacion": "It appeals to the common background of knowledge without claiming to inform from scratch.",
       "correcta": true
      },
      {
       "texto": "It requires the listener to respond with a categorical negation.",
       "lengua": "alumno",
       "explicacion": "It has no interrogative or prohibitive value.",
       "correcta": false
      },
      {
       "texto": "It indicates that the action completely unexpectedly occurred in the past.",
       "lengua": "alumno",
       "explicacion": "Modal particles modulate attitude, not aspectual temporality.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
    {
