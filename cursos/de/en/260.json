     "opciones": [
      {
       "texto": "Aus der Tabelle geht hervor, dass...",
       "lengua": "estudio",
       "explicacion": "It is the standard idiomatic formula in economic and academic reports.",
       "correcta": true
      },
      {
       "texto": "In der Tabelle liest man weg, wenn...",
       "lengua": "estudio",
       "explicacion": "Colloquial and incorrect phrasing in formal German.",
       "correcta": false
      },
      {
       "texto": "Von die Tabelle kommt voran, dass...",
       "lengua": "estudio",
       "explicacion": "Ungrammatical construction not used in German.",
       "correcta": false
      }
     ],
     "respuestas": {
