     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "zum",
       "lengua": "estudio",
       "explicacion": "The fixed contrast preposition is «im Vergleich zu» + dative («zum Vorjahr»).",
       "correcta": true
      },
      {
       "texto": "am",
       "lengua": "estudio",
       "explicacion": "It is not part of the standard comparative phrase.",
       "correcta": false
      },
      {
       "texto": "beim",
       "lengua": "estudio",
       "explicacion": "It governs the dative but does not combine with «im Vergleich».",
