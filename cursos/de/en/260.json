     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "That renewable sources already reach a share close to 30% of the total.",
       "lengua": "alumno",
       "explicacion": "«liegt bei fast dreißig Prozent» defines the current statistical share.",
       "correcta": true
      },
      {
       "texto": "That renewable energies have fallen below ten per cent.",
       "lengua": "alumno",
       "explicacion": "It states that they are close to thirty per cent upwards.",
       "correcta": false
      },
      {
