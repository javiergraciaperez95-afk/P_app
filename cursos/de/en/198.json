     "id": "de198-1",
     "pregunta": {
      "texto": "What syntactic effect does «sodass» have on the clause it introduces?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "It subordinates the sentence by placing the conjugated verb in the final position.",
       "lengua": "alumno",
       "explicacion": "As a consecutive subordinating conjunction, it requires the conjugated verb at the end of the clause.",
       "correcta": true
      },
      {
       "texto": "It requires immediate inversion by placing the verb in absolute second position.",
       "lengua": "alumno",
       "explicacion": "That happens with connecting adverbs like «deshalb» or «folglich», not with «sodass».",
       "correcta": false
      },
      {
       "texto": "It behaves as a coordinating conjunction without changing the usual order.",
       "lengua": "alumno",
       "explicacion": "That corresponds to conjunctions like «und», «aber», «denn» or «oder».",
       "correcta": false
      }
     ],
