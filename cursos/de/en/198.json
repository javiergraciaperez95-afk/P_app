    {
     "tipo": "test",
     "id": "de198-4",
     "pregunta": {
      "texto": "What is the difference between the conjunction «sodass» and the correlative structure «so …, dass»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "«sodass» introduces the consequence as a whole, while «so …, dass» grades the intensity of an adjective or adverb.",
       "lengua": "alumno",
       "explicacion": "«so» qualifies the degree of the attribute in the main clause before opening the consequence with «dass».",
       "correcta": true
      },
      {
       "texto": "«sodass» is used only with conditional meaning and «so …, dass» with causal meaning.",
       "lengua": "alumno",
       "explicacion": "Both constructions belong to the field of consecutive subordination.",
       "correcta": false
      },
      {
       "texto": "«so …, dass» obligatorily requires the verb in the infinitive with «zu».",
       "lengua": "alumno",
       "explicacion": "Both introduce subordinate clauses with a conjugated verb at the end.",
       "correcta": false
      }
     ],
     "respuestas": {
