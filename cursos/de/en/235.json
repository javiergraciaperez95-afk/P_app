     "pregunta": {
      "texto": "What happens to the pronoun «es» in \"Es wurde stundenlang diskutiert\" if we place «Gestern» at the beginning?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "«Es» disappears because it only occupied position 1 as a provisional formal pronoun.",
       "lengua": "alumno",
       "explicacion": "«Gestern wurde stundenlang diskutiert».",
       "correcta": true
      },
      {
       "texto": "«Es» must obligatorily move to just after the participle at the end.",
       "lengua": "alumno",
       "explicacion": "It is not kept inside the sentence if it isn't the real subject.",
       "correcta": false
      },
      {
       "texto": "«Es» must be replaced by the demonstrative pronoun «das».",
       "lengua": "alumno",
       "explicacion": "No demonstrative is introduced.",
