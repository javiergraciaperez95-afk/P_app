     "id": "de235-1",
     "pregunta": {
      "texto": "Why is it incorrect to say «Die Verletzten wurden geholfen»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Because «helfen» governs the dative and that object never becomes a nominative subject.",
       "lengua": "alumno",
       "explicacion": "The dative remains unchanged: «Den Verletzten wurde geholfen».",
       "correcta": true
      },
      {
       "texto": "Because the verb «helfen» has no participle in German.",
       "lengua": "alumno",
       "explicacion": "The regular participle is «geholfen».",
       "correcta": false
      },
      {
       "texto": "Because the impersonal passive can only be formulated in the present tense.",
       "lengua": "alumno",
       "explicacion": "It can be formulated in any tense (Präteritum: «wurde geholfen»).",
       "correcta": false
      }
     ],
