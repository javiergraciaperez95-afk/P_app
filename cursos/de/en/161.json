     "tipo": "test",
     "id": "de161-1",
     "pregunta": {
      "texto": "When is the preposition «von» used to introduce the agent in the passive?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "To indicate the personal author, entity or institution that voluntarily carries out the action",
       "lengua": "alumno",
       "explicacion": "«von + Dativ» points to the direct human or institutional person responsible.",
       "correcta": true
      },
      {
       "texto": "Exclusively for involuntary atmospheric phenomena",
       "lengua": "alumno",
       "explicacion": "Natural phenomena or mechanical causes are usually introduced with «durch + Akkusativ».",
       "correcta": false
      },
      {
       "texto": "To indicate the price or economic cost of a repair",
       "lengua": "alumno",
       "explicacion": "The price is not the agent carrying out a passive action.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
    {
     "tipo": "test",
     "id": "de161-2",
     "pregunta": {
      "texto": "Which grammatical case does the preposition «durch» take when indicating the means or instrument?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Strict accusative",
       "lengua": "alumno",
       "explicacion": "«durch» is a preposition that always governs the accusative, without exception.",
       "correcta": true
      },
      {
       "texto": "Mandatory dative",
       "lengua": "alumno",
       "explicacion": "The dative is governed by «von», but never by «durch».",
       "correcta": false
      },
      {
       "texto": "Formal genitive",
       "lengua": "alumno",
       "explicacion": "«durch» doesn't belong to the class of prepositions that govern the genitive.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
