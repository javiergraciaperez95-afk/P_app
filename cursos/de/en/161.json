     "oir_frase": false,
     "opciones": [
      {
       "texto": "von",
       "lengua": "estudio",
       "explicacion": "It refers to the direct author or collective institution responsible and takes the dative («der Forschungsgruppe»).",
       "correcta": true
      },
      {
       "texto": "durch",
       "lengua": "estudio",
       "explicacion": "«durch» is reserved for impersonal means or instruments and takes the accusative.",
       "correcta": false
      },
      {
       "texto": "mit",
       "lengua": "estudio",
       "explicacion": "«mit» would express company or a tool, not the agent of the passive.",
       "correcta": false
      }
