     "oir_frase": false,
     "opciones": [
      {
       "texto": "They end in -t and don't take the prefix ge-.",
       "lengua": "alumno",
       "explicacion": "For example: reservieren -> reserviert, fotografieren -> fotografiert.",
       "correcta": true
      },
      {
       "texto": "They take the prefix ge- and end in -en.",
       "lengua": "alumno",
       "explicacion": "Verbs in -ieren never form the participle with ge-.",
       "correcta": false
      },
      {
       "texto": "They are conjugated exactly like the present indicative with «du».",
       "lengua": "alumno",
       "explicacion": "The participle takes the fixed unchanging form ending in -t.",
       "correcta": false
      }
     ],
