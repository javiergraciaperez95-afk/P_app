     "id": "de063-1",
     "pregunta": {
      "texto": "Why don't verbs like «besuchen» or «erzählen» take «ge-» in the participle?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Because inseparable prefixes (be-, ver-, er-) prevent adding «ge-».",
       "lengua": "alumno",
       "explicacion": "Inseparable prefixes never combine with the prefix ge-.",
       "correcta": true
      },
      {
       "texto": "Because they are irregular movement verbs that take «sein».",
       "lengua": "alumno",
       "explicacion": "They take haben, and the prefix rule is morphological.",
       "correcta": false
      },
      {
       "texto": "Because they are short, one-syllable words.",
       "lengua": "alumno",
       "explicacion": "Length doesn't matter; the rule depends on the inseparable prefix.",
       "correcta": false
      }
     ],
     "respuestas": {
