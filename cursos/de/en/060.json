 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "At the hotel",
     "texto": [
      "On arrival: **Ich habe eine Reservierung** (I have a reservation).",
      "Rooms: **ein Einzelzimmer** (single) and **ein Doppelzimmer** (double). Nights: **für zwei Nächte**.",
      "To confirm: **Ja, genau** (yes, exactly).",
      "Floors: **im ersten Stock**, **im zweiten Stock**, **im dritten Stock**. Careful: in German the ground floor isn't counted, so «erster Stock» is the floor above the ground floor."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "If you don't feel well",
     "texto": [
      "**Was ist los?** = what's wrong?",
      "**Mir geht es nicht gut** = I don't feel well. **Ich bin krank** = I'm ill.",
      "As in English («I have a headache»), aches use **haben** + body part + **-schmerzen**: **Ich habe Kopfschmerzen** (I have a headache), **Ich habe Bauchschmerzen** (I have a stomach ache).",
      "**Ich habe Fieber** = I have a fever.",
      "To someone who is ill you say **Gute Besserung!** (get well soon!)."
     ],
     "tutora": ""
    }
   ]
  },
