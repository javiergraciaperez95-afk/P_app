    {
     "tipo": "test",
     "id": "de304-7",
     "pregunta": {
      "texto": "What word-order rule governs the proposal sentences introduced by «dass»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "The conjugated finite verb compulsorily moves to the absolute end of the subordinate clause.",
       "lengua": "alumno",
       "explicacion": "dass is one of the archetypal subordinating conjunctions of German.",
       "correcta": true
      },
      {
       "texto": "The verb is placed before the subject, immediately after dass.",
       "lengua": "alumno",
       "explicacion": "An order that would break the basic structure of the Nebensatz.",
       "correcta": false
      },
      {
       "texto": "The modal particle zu must always be inserted between the subject and the main verb.",
       "lengua": "alumno",
       "explicacion": "zu is associated with infinitive clauses without a conjunction, not with subordinate clauses with dass.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
