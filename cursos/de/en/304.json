     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "We propose that the interested parties request an independent expert opinion.",
       "lengua": "alumno",
       "explicacion": "Canonical proposal structure with vorschlagen and a completive clause with dass.",
       "correcta": true
      },
      {
