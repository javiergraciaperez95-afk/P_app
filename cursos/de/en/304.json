     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "werden",
       "lengua": "estudio",
       "explicacion": "In the subordinate clause introduced by dass, the conjugated verb werden is placed at the end.",
       "correcta": true
      },
      {
       "texto": "wird",
       "lengua": "estudio",
       "explicacion": "Richtlinien is plural, so it requires plural agreement with werden.",
       "correcta": false
      },
      {
       "texto": "worden",
       "lengua": "estudio",
       "explicacion": "worden requires the auxiliary sein for the past tense, incorrect here in the present passive.",
       "correcta": false
      }
     ],
     "respuestas": {
