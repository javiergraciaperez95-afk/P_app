    {
     "tipo": "explicacion",
     "titulo": "Mirror verb pairs",
     "texto": [
      "**liegen** (to lie, to be located): *Das Notizbuch liegt auf dem Schreibtisch* (dative).",
      "**legen** (to lay flat): *Ich lege das Notizbuch auf den Schreibtisch* (accusative).",
      "**stehen** (to stand, to be placed): *Die Gläser stehen im Schrank* (dative).",
      "**stellen** (to stand up, to place): *Ich stelle die Teller neben die Tassen* (accusative)."
     ],
     "tutora": ""
    },
