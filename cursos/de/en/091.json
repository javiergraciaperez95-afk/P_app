   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Direct question versus indirect question with ob",
     "texto": [
      "Direct question (verb first): *Hat der Arzt heute Sprechstunde?* (Is the doctor seeing patients today?).",
      "Indirect question (with ob and the verb at the end): *Können Sie mir sagen, **ob** der Arzt heute Sprechstunde **hat**?* (Can you tell me whether the doctor is seeing patients today?).",
      "This structure is the norm in public services, doctor's appointments and phone calls when requesting information with maximum politeness."
     ],
     "tutora": ""
    },
