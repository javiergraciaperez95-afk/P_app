     "tipo": "test",
     "id": "de166-1",
     "pregunta": {
      "texto": "What is the case rule for verbs with two complements, like «geben» or «erklären»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "The recipient goes in the Dative and the transferred thing in the Accusative",
       "lengua": "alumno",
       "explicacion": "«wem?» (to whom?) requires the dative, and «was?» (what?) requires the accusative.",
       "correcta": true
      },
      {
       "texto": "Both complements must be in the Accusative",
       "lengua": "alumno",
       "explicacion": "Two accusative objects only occur in very rare exceptions (such as «nennen»).",
       "correcta": false
      },
      {
       "texto": "The thing goes in the Dative and the person in the Accusative",
       "lengua": "alumno",
       "explicacion": "It would reverse the basic semantic functions of the German language.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
    {
     "tipo": "test",
     "id": "de166-2",
     "pregunta": {
      "texto": "If both complements are pronouns («es», «ihm»), in what order do they go?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Accusative first and Dative after («Ich gebe es ihm»)",
       "lengua": "alumno",
       "explicacion": "With two pronouns the fixed and unbreakable rule is always accusative before dative.",
       "correcta": true
      },
      {
       "texto": "Dative first and Accusative after («Ich gebe ihm es»)",
       "lengua": "alumno",
       "explicacion": "That order only applies if both complements are full nouns.",
       "correcta": false
      },
      {
       "texto": "The order is completely free, depending on oral emphasis",
       "lengua": "alumno",
       "explicacion": "With two pronouns German grammar imposes a rigid, mandatory sequence.",
       "correcta": false
      }
     ],
     "respuestas": {
