 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "The preposition governs the case",
     "texto": [
      "In a relative clause with a preposition, the preposition is placed first in the subordinate clause. Gender and number correspond to the antecedent noun, but the case is marked by the preposition:"
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Verb with government",
     "columnas": [
      {
       "texto": "Preposition + Case",
       "lengua": "alumno"
      },
      {
       "texto": "Antecedent and Relative",
       "lengua": "alumno"
      },
      {
       "texto": "Complete example",
       "lengua": "alumno"
      }
     ],
     "filas": [
      [
       {
        "texto": "sich interessieren für",
        "lengua": "estudio"
       },
       {
        "texto": "für + Accusative",
        "lengua": "alumno"
       },
       {
        "texto": "der Artikel (masc.) → für den",
        "lengua": "estudio"
       },
       {
        "texto": "Das ist der Artikel, für den ich mich interessiere.",
        "lengua": "estudio"
       }
      ],
      [
       {
        "texto": "berichten über",
        "lengua": "estudio"
       },
       {
        "texto": "über + Accusative",
        "lengua": "alumno"
       },
       {
        "texto": "die Debatte (fem.) → über die",
        "lengua": "alumno"
       },
       {
        "texto": "Das ist die Debatte, über die alle berichten.",
        "lengua": "estudio"
       }
      ],
      [
       {
        "texto": "sich befassen mit",
        "lengua": "estudio"
       },
       {
        "texto": "mit + Dative",
        "lengua": "alumno"
       },
       {
        "texto": "das Projekt (neut.) → mit dem",
        "lengua": "estudio"
       },
       {
        "texto": "Das ist das Projekt, mit dem wir uns befassen.",
        "lengua": "estudio"
       }
      ],
      [
       {
        "texto": "sprechen von",
        "lengua": "estudio"
       },
       {
        "texto": "von + Dative",
        "lengua": "alumno"
       },
       {
        "texto": "die Kollegen (pl.) → von denen",
        "lengua": "alumno"
       },
       {
        "texto": "Das sind Kollegen, von denen wir viel lernen.",
        "lengua": "estudio"
       }
      ]
     ],
     "nota": "",
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Golden rule",
     "texto": [
      "The preposition is never separated from the relative pronoun at the start of the subordinate clause. The conjugated verb stays at the end of the sentence."
     ],
     "tutora": ""
    }
   ]
  },
