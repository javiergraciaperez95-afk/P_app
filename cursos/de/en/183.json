    {
     "tipo": "test",
     "id": "de183-1",
     "pregunta": {
      "texto": "What case and gender does the relative require in «Der Dokumentarfilm, für den wir recherchieren»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Masculine accusative, because the preposition «für» always governs the accusative and «Film» is masculine.",
       "lengua": "alumno",
       "explicacion": "«für» + masculine accusative determines the use of «den».",
       "correcta": true
      },
      {
       "texto": "Neuter dative, because the subject of the subordinate clause is «wir».",
       "lengua": "alumno",
       "explicacion": "The relative pronoun doesn't depend on the subject «wir», but on «für» and the masculine antecedent.",
       "correcta": false
      },
      {
       "texto": "Masculine nominative, because the film performs the action of the documentary.",
       "lengua": "alumno",
       "explicacion": "«für» never governs the nominative in German.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
    {
     "tipo": "huecos",
