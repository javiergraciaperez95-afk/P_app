     "oir_frase": false,
     "opciones": [
      {
       "texto": "der",
       "lengua": "estudio",
       "explicacion": "«mit» governs the dative and «die Kollegin» is feminine singular.",
       "correcta": true
      },
      {
       "texto": "die",
       "lengua": "estudio",
       "explicacion": "«die» would be accusative and the preposition «mit» strictly requires the dative.",
       "correcta": false
      },
      {
       "texto": "dem",
       "lengua": "estudio",
       "explicacion": "«dem» corresponds to the masculine or neuter dative, not the feminine.",
