     "tipo": "test",
     "id": "de193-1",
     "pregunta": {
      "texto": "What function does «statt» perform when it precedes a noun phrase?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "It acts as a preposition governing the genitive, expressing substitution or a discarded alternative.",
       "lengua": "alumno",
       "explicacion": "It introduces the element that is not carried out or is discarded in favour of another option.",
       "correcta": true
      },
      {
       "texto": "It works as a modal conjunction of affirmative comparison.",
       "lengua": "alumno",
       "explicacion": "Affirmative comparison uses «wie» or «als», not «statt».",
       "correcta": false
      },
      {
       "texto": "It introduces a temporal subordinate clause of simultaneity.",
       "lengua": "alumno",
       "explicacion": "Temporal simultaneity corresponds to «während», not to «statt».",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
