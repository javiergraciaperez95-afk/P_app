   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Structure of the noun alternative",
     "texto": ["«Statt» and «anstelle» express an alternative: «statt» with the genitive means «instead of» (**statt eines Neuwagens**), and «anstelle» is even more formal (**anstelle des Abteilungsleiters**). When the alternative is an action with the same subject, use **statt … zu + Infinitiv** instead of a noun in the genitive."],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Preposition",
     "columnas": [
      {
       "texto": "Government",
       "lengua": "alumno"
      },
      {
       "texto": "Meaning",
       "lengua": "alumno"
      },
      {
       "texto": "Illustrative example",
       "lengua": "alumno"
      }
     ],
     "filas": [
      [
       {
        "texto": "statt / anstatt",
        "lengua": "estudio"
       },
       {
        "texto": "Genitive",
        "lengua": "alumno"
       },
       {
        "texto": "instead of",
        "lengua": "alumno"
       },
       {
        "texto": "Statt eines Neuwagens wählte er ein Abonnement für die Bahn.",
        "lengua": "estudio"
       }
      ],
      [
       {
        "texto": "anstelle",
        "lengua": "estudio"
       },
       {
        "texto": "Genitive (very formal register)",
        "lengua": "alumno"
       },
       {
        "texto": "in place of",
        "lengua": "alumno"
       },
       {
        "texto": "Anstelle des Abteilungsleiters reiste seine Assistentin an.",
        "lengua": "estudio"
       }
      ]
     ],
     "nota": "",
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Contrast with infinitive clauses",
     "texto": [
      "When the alternative involves a verbal action with the same subject, the discontinuous conjunction **statt … zu + Infinitiv** is used (*Statt den Bus zu nehmen, lief er zu Fuß*). If the alternative is a mere noun, the simple preposition **statt + Genitiv** is used (*Statt des Busses nahm er die Bahn*)."
     ],
     "tutora": ""
    }
   ]
  },
