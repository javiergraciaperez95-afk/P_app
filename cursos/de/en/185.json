    {
     "tipo": "test",
     "id": "de185-5",
     "pregunta": {
      "texto": "Why, in the sentence «Wer fleißig lernt, der besteht die Prüfung», does the verb «lernt» go at the end and «besteht» go after «der»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Because the clause with «wer» is a subordinate clause (verb at the end), and the clause with «der» is the main clause (inversion because it occupies position 1).",
       "lengua": "alumno",
       "explicacion": "The subordinate clause functions as the first sentence element, so the main clause begins with the correlative pronoun followed by the verb.",
       "correcta": true
      },
      {
       "texto": "Because both verbs must always be placed next to each other in the middle of the sentence.",
       "lengua": "alumno",
       "explicacion": "The verbs are separated by the comma and the correlative pronoun «der».",
       "correcta": false
      },
      {
       "texto": "Because «wer» inverts the word order of the main verb and «der» sends it to the infinitive.",
       "lengua": "alumno",
       "explicacion": "Neither verb goes into the infinitive; both are conjugated in the present.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
