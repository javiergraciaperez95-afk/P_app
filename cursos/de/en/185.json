     "tipo": "test",
     "id": "de185-1",
     "pregunta": {
      "texto": "What syntactic function does the correlation «Wer …, der …» perform in formal speech?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "It sets out a general statement applicable to anyone who meets the condition expressed in the first clause.",
       "lengua": "alumno",
       "explicacion": "It works as a universal generalising relative for indeterminate persons.",
       "correcta": true
      },
      {
       "texto": "It limits the statement exclusively to an individual previously mentioned by name and surname.",
       "lengua": "alumno",
       "explicacion": "«Wer» does not require a previous antecedent; it covers any hypothetical subject.",
       "correcta": false
      },
      {
       "texto": "It serves as a stylistic formula for indirectly quoting witnesses' statements.",
       "lengua": "alumno",
       "explicacion": "Indirect speech uses Subjunctive I and the conjunction «dass», or inversion without «wer… der».",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
