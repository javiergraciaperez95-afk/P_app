 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Negative subordinate clauses with «ohne dass» versus infinitive with «zu»",
     "texto": [
      "1. **ohne dass**: it is obligatory when the subject of the main clause differs from the subject of the subordinate clause: **Er handelte, ohne dass die Kollegen etwas bemerkten** (he acted without the colleagues noticing anything).",
      "2. **ohne … zu**: it is preferably used when both clauses share the same subject: **Er verließ den Saal, ohne sich zu verabschieden** (he left the room without saying goodbye).",
      "3. **Key lexical distinction**: **merken** means to notice or realise; **sich erinnern an (+ Akk.)** expresses the conscious act of remembering or recalling."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Construction",
     "columnas": [
      {
       "texto": "Syntactic condition",
       "lengua": "alumno"
      },
      {
       "texto": "Example in an official record",
       "lengua": "alumno"
      }
     ],
     "filas": [
      [
       {
        "texto": "ohne dass (+ Nebensatz)",
        "lengua": "estudio"
       },
       {
        "texto": "Different subjects in both parts",
        "lengua": "alumno"
       },
       {
        "texto": "Der Ausschuss tagte, ohne dass die Presse informiert wurde.",
        "lengua": "estudio"
       }
      ],
      [
       {
        "texto": "ohne … zu (+ Infinitiv)",
        "lengua": "estudio"
       },
       {
