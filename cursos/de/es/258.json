    {
     "tipo": "test",
     "id": "de258-1",
     "pregunta": {
      "texto": "¿Qué caso gramatical debe adoptar la aposición explicativa en alemán?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "El mismo caso gramatical que el sustantivo al que complementa y explica.",
       "lengua": "alumno",
       "explicacion": "La aposición concuerda rigurosamente en caso con su término de referencia.",
       "correcta": true
      },
      {
       "texto": "Siempre obligatoriamente el caso nominativo sin importar el resto de la frase.",
       "lengua": "alumno",
       "explicacion": "En alemán la aposición flexiona para igualar el caso del núcleo.",
       "correcta": false
      },
      {
       "texto": "Únicamente el caso genitivo posesivo.",
       "lengua": "alumno",
       "explicacion": "Solo adopta genitivo si el núcleo está en genitivo.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
    {
     "tipo": "huecos",
     "id": "de258-2",
     "pregunta": {
      "texto": "a la (dativo femenino de la aposición)",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "Wir gratulieren Frau Klein, ___ erfolgreichen Leiterin des Projekts.",
      "lengua": "estudio"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "der",
       "lengua": "estudio",
       "explicacion": "El verbo «gratulieren» rige dativo («Frau Klein»), por lo que la aposición adopta «der».",
       "correcta": true
      },
      {
       "texto": "die",
       "lengua": "estudio",
       "explicacion": "Sería nominativo o acusativo femenino; no concuerda con el dativo.",
       "correcta": false
      },
      {
       "texto": "den",
       "lengua": "estudio",
       "explicacion": "Corresponde a acusativo masculino o dativo plural.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
    {
     "tipo": "traduccion",
     "id": "de258-3",
     "pregunta": {
      "texto": "¿Por qué la aposición lleva «dem»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "Die Belegschaft dankte Herrn Professor Krause, dem scheidenden Direktor.",
      "lengua": "estudio"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Porque «danken» rige dativo y la aposición «scheidenden Direktor» concuerda con «Herrn Krause».",
       "lengua": "alumno",
       "explicacion": "Concordancia obligatoria en dativo masculino singular.",
       "correcta": true
      },
      {
       "texto": "Porque «Direktor» es una palabra neutra en nominativo.",
       "lengua": "alumno",
       "explicacion": "Es un sustantivo masculino en función de aposición en dativo.",
       "correcta": false
      },
      {
       "texto": "Porque introduce una oración de relativo subordinada sin verbo.",
       "lengua": "alumno",
       "explicacion": "Es una aposición nominal cerrada entre comas, no una cláusula de relativo.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
    {
     "tipo": "test",
     "id": "de258-4",
     "pregunta": {
      "texto": "¿Qué regla de puntuación es obligatoria para las aposiciones explicativas intermedias?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Deben ir delimitadas por dos comas: una de apertura y otra de cierre.",
       "lengua": "alumno",
       "explicacion": "«Frau Weber, die neue Leiterin, spricht heute zu uns».",
       "correcta": true
      },
      {
       "texto": "Solo se coloca coma al principio de la aposición, nunca al final.",
       "lengua": "alumno",
       "explicacion": "Omitir la coma de cierre es una falta ortográfica grave en alemán.",
       "correcta": false
      },
      {
       "texto": "No se pone ninguna coma si la aposición tiene más de tres palabras.",
       "lengua": "alumno",
       "explicacion": "La delimitación por comas se aplica con independencia de la longitud.",
       "correcta": false
      }
     ],
