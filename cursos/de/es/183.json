     "pregunta": {
      "texto": "¿Qué caso y género exige el relativo en «Der Dokumentarfilm, für den wir recherchieren»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Acusativo masculino, porque la preposición «für» rige siempre acusativo y «Film» es masculino.",
       "lengua": "alumno",
       "explicacion": "«für» + acusativo masculino determina el uso de «den».",
       "correcta": true
      },
      {
       "texto": "Dativo neutro, porque el sujeto de la subordinada es «wir».",
       "lengua": "alumno",
       "explicacion": "El pronombre relativo no depende del sujeto «wir», sino de «für» y del antecedente masculino.",
       "correcta": false
      },
      {
       "texto": "Nominativo masculino, porque la película realiza la acción del documental.",
       "lengua": "alumno",
       "explicacion": "«für» nunca rige nominativo en la lengua alemana.",
       "correcta": false
      }
