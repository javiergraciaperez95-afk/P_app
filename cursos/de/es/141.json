     "opciones": [
      {
       "texto": "Con «hatte» conjugado en Präteritum más el participio II",
       "lengua": "alumno",
       "explicacion": "Por ejemplo: «ich hatte ausgedruckt», «wir hatten geschickt».",
       "correcta": true
      },
      {
       "texto": "Con «habe» en presente más el participio II",
       "lengua": "alumno",
