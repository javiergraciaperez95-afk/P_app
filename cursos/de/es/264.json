      "lengua": "alumno"
     },
     "frase": {
      "texto": "Das neue Ausstellungskonzept verbindet historische Gemälde mit moderner Skulptur.",
      "lengua": "estudio"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Porque su núcleo final es «das Konzept», que rige el género neutro del compuesto completo.",
       "lengua": "alumno",
       "explicacion": "El último elemento compuesto fija el género y la declinación.",
       "correcta": true
      },
      {
       "texto": "Porque todas las palabras relacionadas con exposiciones artísticas son invariablemente neutras.",
       "lengua": "alumno",
       "explicacion": "El género depende estrictamente de la morfología del Grundwort.",
       "correcta": false
      },
      {
       "texto": "Porque «die Ausstellung» pierde su género al unirse mediante una «-s-» medial.",
       "lengua": "alumno",
       "explicacion": "El género no se neutraliza; lo define el componente final.",
       "correcta": false
      }
