       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Sie öffnet um zehn Uhr und schließt um sechzehn Uhr.",
       "alumno": "Abre a las diez y cierra a las dieciséis.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Im Leseraum kann man Bücher lesen.",
       "alumno": "En la sala de lectura se pueden leer libros.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Essen und Getränke sind dort nicht erlaubt.",
       "alumno": "Allí no se permite comer ni beber.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Wer einen Platz am Tisch möchte, muss ihn bis Freitag reservieren.",
       "alumno": "Quien quiera un sitio en la mesa debe reservarlo antes del viernes.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Weil es nur zwanzig Plätze gibt, empfiehlt die Bibliothek eine Anmeldung bis Freitag.",
       "alumno": "Como solo hay veinte sitios, la biblioteca recomienda inscribirse antes del viernes.",
       "literal": "",
       "estructura": "",
       "nota": [],
