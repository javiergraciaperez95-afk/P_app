     "id": "de184-1",
     "pregunta": {
      "texto": "¿Por qué se debe usar «was» y no «das» en la frase «Alles, was er vorschlägt, ist sinnvoll»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Porque tras pronombres indefinidos neutros como «alles» la gramática alemana exige el relativo «was».",
       "lengua": "alumno",
       "explicacion": "«alles, nichts, etwas, vieles» reclaman sistemáticamente el pronombre «was».",
       "correcta": true
      },
      {
       "texto": "Porque «was» solo se puede utilizar en preguntas directas de objeto.",
       "lengua": "alumno",
       "explicacion": "En este contexto «was» actúa como pronombre relativo libre o generalizador.",
       "correcta": false
      },
      {
       "texto": "Porque «das» solo se permite cuando el verbo principal está en pasado compuesto.",
       "lengua": "alumno",
       "explicacion": "El tiempo verbal del verbo principal no altera la selección del relativo neutro indefinido.",
       "correcta": false
      }
