      {
       "quien": {
        "texto": "Julia",
        "lengua": "estudio"
       },
       "estudio": "Wegen des Lärms gab es letzte Woche eine Diskussion.",
       "alumno": "Por el ruido hubo una discusión la semana pasada.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "wegen des Lärms",
         "por el ruido"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Peter",
        "lengua": "estudio"
       },
       "estudio": "Stimmt, aber wir haben es gelöst.",
       "alumno": "Es verdad, pero lo resolvimos.",
       "literal": "",
