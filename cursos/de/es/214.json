    },
    {
     "tipo": "texto",
     "titulo": "Normas del piso compartido",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "In unserer Wohnung hat jede Person eine Aufgabe.",
       "alumno": "En nuestra vivienda cada persona tiene una tarea.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Am Montag kauft eine Person ein, am Dienstag putzt eine andere die Küche.",
       "alumno": "El lunes hace la compra una persona y el martes otra limpia la cocina.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Nach zehn Uhr abends hören wir keine laute Musik.",
       "alumno": "Después de las diez de la noche no escuchamos música alta.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Wenn Freunde kommen, informieren wir vorher alle.",
       "alumno": "Si vienen amigos, informamos antes a todo el mundo.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Am Sonntag planen wir gemeinsam die Woche.",
       "alumno": "El domingo planeamos juntos la semana.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Bei Problemen sprechen wir miteinander.",
       "alumno": "Cuando hay problemas, hablamos entre nosotros.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
