     "opciones": [
      {
       "texto": "Porque «Milch» es femenino y la preposición «mit» rige dativo, cuya desinencia fuerte femenina es «-er».",
       "lengua": "alumno",
       "explicacion": "Reproduce la marca morfológica del artículo dativo femenino «der» («mit der Milch» → «mit frischer Milch»).",
