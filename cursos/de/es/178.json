     "id": "de178-1",
     "pregunta": {
      "texto": "¿Cómo se niega un sustantivo objeto directo dentro de una cláusula de infinitivo?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Mediante la forma correspondiente del determinante indefinido «kein-» declinado ante el sustantivo",
       "lengua": "alumno",
       "explicacion": "Por ejemplo: «keine Fehler zu machen» o «kein Risiko einzugehen».",
       "correcta": true
      },
      {
       "texto": "Añadiendo exclusivamente «nicht» al final absoluto de la frase tras el infinitivo",
       "lengua": "alumno",
       "explicacion": "En alemán la negación de sustantivos indeterminados rechaza «nicht» pospuesto al verbo.",
       "correcta": false
      },
      {
       "texto": "Utilizando la preposición «ohne» repetida antes y después del sustantivo",
       "lengua": "alumno",
       "explicacion": "«ohne» es una preposición modal privativa, no el operador de negación de un sustantivo.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
