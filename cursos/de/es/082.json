    {
     "tipo": "test",
     "id": "de082-2",
     "pregunta": {
      "texto": "¿Por qué se dice «auf dem Schreibtisch» y no «auf den Schreibtisch» para indicar dónde está el libro?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Porque expresa ubicación estática (Wo? + Dativ).",
       "lengua": "alumno",
       "explicacion": "«Schreibtisch» es masculino («der Schreibtisch»), cuyo dativo es «dem».",
       "correcta": true
      },
      {
       "texto": "Porque el libro se está moviendo activamente por la mesa.",
       "lengua": "alumno",
       "explicacion": "No indica traslado, sino reposo sobre el mueble.",
       "correcta": false
      },
      {
       "texto": "Porque «auf» nunca puede combinarse con acusativo.",
       "lengua": "alumno",
       "explicacion": "Sí puede combinarse con acusativo cuando responde a «Wohin?».",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
