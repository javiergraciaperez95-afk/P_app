     "pregunta": {
      "texto": "¿Qué caso gramatical rigen las preposiciones mixtas cuando responden a la pregunta «Wo?» (ubicación)?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Dativo",
       "lengua": "alumno",
       "explicacion": "Para indicar posición estática o reposo se usa siempre el dativo tras la preposición.",
       "correcta": true
      },
      {
       "texto": "Acusativo",
       "lengua": "alumno",
       "explicacion": "El acusativo se reserva para indicar dirección o movimiento con «Wohin?».",
       "correcta": false
      },
      {
       "texto": "Genitivo",
       "lengua": "alumno",
       "explicacion": "Las Wechselpräpositionen no rigen genitivo en este contexto.",
       "correcta": false
      }
     ],
     "respuestas": {
