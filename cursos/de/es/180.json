 "etapas": [
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Hablando de medios",
     "frases": [
      {
       "quien": {
        "texto": "Anna",
        "lengua": "estudio"
       },
       "estudio": "Hast du die Zeitung gelesen, über die alle sprechen?",
       "alumno": "¿Has leído el periódico del que todos hablan?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "über die alle sprechen",
         "del que todos hablan"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Tim",
        "lengua": "estudio"
       },
       "estudio": "Ja, das ist der Roman, von dem die Nachrichten berichten.",
       "alumno": "Sí, es la novela de la que informan las noticias.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "von dem die Nachrichten berichten",
         "de la que informan las noticias"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Anna",
        "lengua": "estudio"
       },
       "estudio": "Und die Serie, mit der du arbeitest?",
       "alumno": "¿Y la serie con la que trabajas?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "mit der du arbeitest",
         "con la que trabajas"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Tim",
        "lengua": "estudio"
       },
       "estudio": "Das ist keine Serie. Ich arbeite mit einem Künstler am Theater.",
       "alumno": "No es una serie. Trabajo con un artista del teatro.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "mit einem Künstler",
         "con un artista"
        ]
       ],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Reseña de un libro",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Ich habe ein Buch gelesen, über das viele Leser sprechen.",
       "alumno": "He leído un libro del que hablan muchos lectores.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Die Geschichte spielt in Berlin.",
       "alumno": "La historia transcurre en Berlín.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Der Autor beschreibt eine Familie, die zusammen ein Haus renoviert.",
       "alumno": "El autor describe una familia que renueva una casa juntos.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Besonders spannend ist die Frau, der die Nachbarn helfen.",
       "alumno": "La mujer a la que ayudan los vecinos es especialmente interesante.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Die Zeitung lobt das Buch, aber ich finde das Ende traurig.",
       "alumno": "El periódico elogia el libro, pero a mí me parece triste el final.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
