     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Porque «ankommen» es un verbo intransitivo de cambio que forma el tiempo con «sein».",
       "lengua": "alumno",
       "explicacion": "Solo los intransitivos con «sein» admiten Partizip II atributivo con sentido activo terminado.",
       "correcta": true
      },
      {
       "texto": "Porque «arbeiten» es un verbo irregular que no tiene participio acabado en «-t».",
       "lengua": "alumno",
       "explicacion": "«gearbeitet» es el participio regular, pero no admite función adjetival atributiva.",
       "correcta": false
      },
      {
       "texto": "Porque «Personal» es un sustantivo colectivo que no acepta ningún adjetivo.",
       "lengua": "alumno",
       "explicacion": "Acepta adjetivos normales («qualifiziertes Personal»), pero no participios incompatibles.",
       "correcta": false
      }
