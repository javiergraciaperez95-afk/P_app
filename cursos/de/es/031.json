   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "¿Te gusta el pescado?",
     "frases": [
      {
       "quien": {
        "texto": "Sophie",
        "lengua": "estudio"
       },
       "estudio": "Magst du Fisch, Tim?",
       "alumno": "¿Te gusta el pescado, Tim?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Magst du",
         "¿te gusta? (de «mögen»)"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Tim",
        "lengua": "estudio"
       },
       "estudio": "Nein, ich mag keinen Fisch. Aber ich esse gern Hähnchen.",
       "alumno": "No, no me gusta el pescado. Pero me gusta comer pollo.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "ich mag keinen Fisch",
         "no me gusta el pescado («kein» en acusativo masculino)"
        ],
        [
         "ich esse gern",
         "me gusta comer"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Sophie",
        "lengua": "estudio"
       },
       "estudio": "Was isst du zum Frühstück?",
       "alumno": "¿Qué comes para desayunar?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Was isst du",
         "qué comes"
        ],
        [
         "zum Frühstück",
         "para desayunar"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Tim",
        "lengua": "estudio"
       },
       "estudio": "Ich esse Brot mit Käse und einen Apfel.",
       "alumno": "Como pan con queso y una manzana.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Brot mit Käse",
         "pan con queso"
        ],
        [
         "einen Apfel",
         "una manzana (acusativo masculino)"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Sophie",
        "lengua": "estudio"
       },
       "estudio": "Trinkst du gern Kaffee?",
       "alumno": "¿Te gusta el café?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Trinkst du gern",
         "¿te gusta beber…?"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Tim",
        "lengua": "estudio"
       },
       "estudio": "Ja, sehr gern. Ich trinke jeden Morgen Kaffee mit Milch.",
       "alumno": "Sí, mucho. Tomo café con leche todas las mañanas.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "sehr gern",
         "con mucho gusto"
        ],
        [
         "jeden Morgen",
         "todas las mañanas"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Sophie",
        "lengua": "estudio"
       },
       "estudio": "Ich trinke nicht gern Kaffee. Ich trinke lieber Tee.",
       "alumno": "A mí no me gusta el café. Prefiero el té.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
