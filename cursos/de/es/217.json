     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Provoca inversión: el verbo conjugado pasa inmediatamente a la segunda posición, antes del sujeto.",
       "lengua": "alumno",
       "explicacion": "Como adverbio conjuntivo en posición 1, «deshalb» precede directamente al verbo («schreibe ich»).",
       "correcta": true
      },
      {
       "texto": "Envía el verbo conjugado al final absoluto de la frase.",
       "lengua": "alumno",
       "explicacion": "Eso solo ocurre con conjunciones subordinantes como «weil» o «dass».",
       "correcta": false
      },
      {
       "texto": "Mantiene el orden estricto de sujeto seguido de verbo sin cambios.",
       "lengua": "alumno",
       "explicacion": "Eso solo ocurriría con conjunciones coordinantes de posición cero (und, aber, denn).",
       "correcta": false
