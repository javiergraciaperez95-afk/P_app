    {
     "tipo": "test",
     "id": "de265-1",
     "pregunta": {
      "texto": "¿Qué matiz semántico aporta el prefijo «zer-» en el verbo «zerfließen»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Expresa desintegración, disgregación o dilución de una forma delimitada.",
       "lengua": "alumno",
       "explicacion": "«zer-» connota siempre destrucción, descomposición o dispersión.",
       "correcta": true
      },
      {
       "texto": "Indica repetición periódica de un movimiento armónico regular.",
       "lengua": "alumno",
       "explicacion": "No tiene valor de reiteración; para ello se emplean otros recursos.",
       "correcta": false
      },
      {
       "texto": "Añade el sentido de inicio voluntario o aceleración deliberada.",
       "lengua": "alumno",
       "explicacion": "El prefijo incoativo por excelencia es «er-» o «ent-».",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
