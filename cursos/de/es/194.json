    {
     "tipo": "traduccion",
     "id": "de194-3",
     "pregunta": {
      "texto": "¿Qué estipula esta cláusula legal?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "Innerhalb einer Frist von zwei Wochen ist Widerspruch einzulegen.",
      "lengua": "estudio"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Debe presentarse recurso formal en el plazo improrrogable de dos semanas.",
       "lengua": "alumno",
       "explicacion": "«innerhalb einer Frist» delimita el periodo hábil fijado por la autoridad administrativa.",
       "correcta": true
      },
      {
       "texto": "La resolución administrativa surtirá plenos efectos sin posibilidad alguna de recurso.",
       "lengua": "alumno",
       "explicacion": "El texto indica expresamente el procedimiento de recurso («Widerspruch ist einzulegen»).",
       "correcta": false
      },
      {
       "texto": "El interesado dispone de un plazo ilimitado para aportar nueva documentación económica.",
       "lengua": "alumno",
       "explicacion": "Establece un límite temporal taxativo («von zwei Wochen»), no un periodo ilimitado.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
