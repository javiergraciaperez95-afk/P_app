    {
     "tipo": "test",
     "id": "de194-1",
     "pregunta": {
      "texto": "¿Qué caso gramatical rige la preposición temporal «innerhalb» en un documento administrativo oficial?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Caso genitivo singular o plural según el marco temporal especificado.",
       "lengua": "alumno",
       "explicacion": "«innerhalb» exige sistemáticamente genitivo para fijar plazos temporales o límites espaciales.",
       "correcta": true
      },
      {
       "texto": "Caso acusativo sin importar el género del sustantivo temporal.",
       "lengua": "alumno",
       "explicacion": "«innerhalb» nunca rige acusativo en la gramática estándar alemana.",
       "correcta": false
      },
      {
       "texto": "Caso dativo únicamente cuando el plazo exceda los doce meses.",
       "lengua": "alumno",
       "explicacion": "La duración cuantitativa del plazo no altera la regla de régimen de genitivo.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
    {
     "tipo": "huecos",
     "id": "de194-2",
     "pregunta": {
      "texto": "de las",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "Anträge können nur außerhalb ___ Betriebsferien bearbeitet werden.",
      "lengua": "estudio"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "der",
       "lengua": "estudio",
       "explicacion": "«die Betriebsferien» es sustantivo plural y en genitivo adopta el artículo «der».",
       "correcta": true
      },
      {
       "texto": "den",
       "lengua": "estudio",
       "explicacion": "«den» es dativo plural, incompatible con el régimen de «außerhalb».",
       "correcta": false
      },
      {
       "texto": "des",
       "lengua": "estudio",
       "explicacion": "«des» es forma de masculino o neutro singular.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
