     "pregunta": {
      "texto": "¿Dónde se coloca la partícula «zu» en un verbo separable como «aufhören» o «einhalten»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Intercalada entre el prefijo separable y la raíz verbal («aufzuhören», «einzuhalten»)",
       "lengua": "alumno",
       "explicacion": "En verbos separables, «zu» se funde como infijo entre el prefijo y el verbo base.",
       "correcta": true
      },
      {
       "texto": "Delante del prefijo separable («zu aufhören», «zu einhalten»)",
       "lengua": "alumno",
       "explicacion": "«zu» nunca puede preceder al prefijo de un verbo separable.",
       "correcta": false
      },
      {
       "texto": "Al final absoluto detrás de la terminación de infinitivo",
       "lengua": "alumno",
       "explicacion": "La terminación de infinitivo (-en) debe cerrar siempre la palabra verbal.",
       "correcta": false
      }
     ],
