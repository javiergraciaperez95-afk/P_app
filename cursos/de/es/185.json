     "pregunta": {
      "texto": "¿Qué función sintáctica desempeña la correlación «Wer …, der …» en un discurso formal?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Establece un enunciado general aplicable a cualquier persona que cumpla la condición expresada en la primera cláusula.",
       "lengua": "alumno",
       "explicacion": "Funciona como relativo generalizador universal para personas indeterminadas.",
       "correcta": true
      },
      {
       "texto": "Limita la afirmación exclusivamente a un individuo mencionado con nombre y apellido previamente.",
       "lengua": "alumno",
       "explicacion": "«Wer» no requiere antecedente previo; engloba a cualquier sujeto hipotético.",
       "correcta": false
      },
      {
       "texto": "Sirve como fórmula de estilo indirecto para citar declaraciones de testigos.",
       "lengua": "alumno",
       "explicacion": "El estilo indirecto emplea subjuntivo I y conjunción «dass» o inversión sin «wer… der».",
       "correcta": false
      }
     ],
     "respuestas": {
