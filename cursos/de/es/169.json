     "id": "de169-1",
     "pregunta": {
      "texto": "¿Por qué se utiliza «mir» y no «mich» en «Ich wasche mir die Hände»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Porque la presencia del objeto directo «die Hände» desplaza al pronombre reflexivo al dativo",
       "lengua": "alumno",
       "explicacion": "Al haber ya un complemento en acusativo («die Hände»), la persona beneficiaria pasa a dativo.",
       "correcta": true
      },
      {
       "texto": "Porque «die Hände» es un sustantivo plural y los plurales exigen dativo",
       "lengua": "alumno",
       "explicacion": "El número del objeto no altera la regla de distribución de casos entre paciente y beneficiario.",
       "correcta": false
      },
      {
       "texto": "Porque «waschen» es un verbo intransitivo que rechaza el acusativo",
       "lengua": "alumno",
       "explicacion": "«waschen» es transitivo y rige acusativo para el objeto directo lavado.",
       "correcta": false
      }
     ],
