     "tipo": "test",
     "id": "de276-1",
     "pregunta": {
      "texto": "¿Por qué es gramaticalmente incorrecto decir *«Er ging, ohne die Kollegen ihn bemerkten»*?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Porque al cambiar de sujeto es obligatorio emplear la conjunción subordinante «ohne dass» con verbo al final.",
       "lengua": "alumno",
       "explicacion": "El cambio de agente impide el uso de giros truncados sin nexo subordinante.",
       "correcta": true
      },
      {
       "texto": "Porque el verbo «bemerken» prohíbe la presencia de pronombres de tercera persona.",
       "lengua": "alumno",
       "explicacion": "No existe semejante restricción pronominal.",
       "correcta": false
      },
      {
       "texto": "Porque las oraciones con «ohne» solo admiten el tiempo presente de indicativo.",
       "lengua": "alumno",
       "explicacion": "Se combinan con cualquier tiempo según el marco discursivo.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
