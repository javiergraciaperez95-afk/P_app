   "piezas": [
    {
     "tipo": "test",
     "id": "de186-1",
     "pregunta": {
      "texto": "En la frase «Wir prüfen das Gutachten des Sachverständigen, das die Verteidigung vorgelegt hat», ¿a qué elemento modifica la relativa con «das»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Modifica a «das Gutachten» (neutro), pues el pronombre relativo «das» concuerda en género y número con el dictamen y no con el perito («der Sachverständige»).",
       "lengua": "alumno",
       "explicacion": "La distinción de género aclara que lo presentado es el peritaje y no la persona del perito.",
       "correcta": true
      },
      {
       "texto": "Modifica a «der Sachverständige», porque los peritos siempre concuerdan en neutro cuando elaboran informes.",
       "lengua": "alumno",
       "explicacion": "Los sustantivos masculinos personales nunca adoptan pronombre neutro en oraciones de relativo.",
       "correcta": false
      },
      {
       "texto": "Modifica al abogado que suscribe el acta de la sesión judicial.",
       "lengua": "alumno",
       "explicacion": "El abogado no figura como antecedente inmediato ni comparte género con «das».",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
