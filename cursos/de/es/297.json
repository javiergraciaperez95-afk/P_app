     "id": "de297-1",
     "pregunta": {
      "texto": "¿Cuál es el plazo conferido al consumidor para ejercer su derecho legal de desistimiento?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Un plazo de catorce días naturales sin necesidad de justificar la decisión.",
       "lengua": "alumno",
       "explicacion": "El texto indica expresamente: innerhalb von vierzehn Tagen ohne Angabe von Gründen.",
       "correcta": true
      },
      {
       "texto": "Un período máximo de cuarenta y ocho horas sujeto a autorización judicial.",
       "lengua": "alumno",
       "explicacion": "Plazo incorrecto no respaldado por el pliego.",
       "correcta": false
      },
      {
       "texto": "Un año completo siempre que el producto no haya salido de los almacenes centrales.",
       "lengua": "alumno",
       "explicacion": "No se prevé un plazo anual de desistimiento ordinario.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
