      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "«da» retoma una circunstancia conocida o presupuesta en el debate («como / dado que ya sabemos»).",
       "lengua": "alumno",
       "explicacion": "Sirve de puente temático natural desde una premisa aceptada.",
       "correcta": true
      },
      {
       "texto": "«da» indica una condición completamente imposible o contrafáctica en el futuro.",
       "lengua": "alumno",
       "explicacion": "No expresa valor contrafáctico; es una conjunción estrictamente causal.",
       "correcta": false
      },
      {
       "texto": "«da» prohíbe que el verbo de su cláusula se desplace al final de la frase.",
       "lengua": "alumno",
       "explicacion": "Como toda conjunción subordinante alemana, coloca el verbo conjugado al final.",
