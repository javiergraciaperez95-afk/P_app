     "id": "de162-1",
     "pregunta": {
      "texto": "¿Qué ocurre con el complemento indirecto en dativo al pasar una oración activa a pasiva?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Permanece obligatoriamente en dativo y nunca se convierte en sujeto de la pasiva",
       "lengua": "alumno",
       "explicacion": "En alemán, solo los objetos acusativos pueden asumir la función de sujeto pasivo.",
       "correcta": true
      },
      {
       "texto": "Pasa siempre a ser el sujeto en nominativo de la frase",
       "lengua": "alumno",
       "explicacion": "Es un calco erróneo de la pasiva inglesa («He was given...» no existe en alemán).",
       "correcta": false
      },
      {
       "texto": "Se transforma obligatoriamente en acusativo para concordar con el verbo",
       "lengua": "alumno",
       "explicacion": "Los casos no se intercambian arbitrariamente; el dativo queda protegido e invariable.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
