     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Aporta una concesión natural y reflexiva equivalente a «desde luego», «ciertamente» o «por supuesto».",
       "lengua": "alumno",
       "explicacion": "freilich matiza y concede verosimilitud a una observación previa.",
       "correcta": true
      },
      {
       "texto": "Expresa una prohibición tajante semejante a bajo ningún concepto.",
       "lengua": "alumno",
       "explicacion": "No tiene valor de veto ni de prohibición negativa.",
       "correcta": false
      },
      {
       "texto": "Indica el tiempo cronológico exacto en que comenzará una votación parlamentaria.",
       "lengua": "alumno",
       "explicacion": "Es un marcador discursivo modalizador, no un adverbio temporal puntual.",
       "correcta": false
      }
