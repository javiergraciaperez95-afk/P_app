     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Actúa como preposición de régimen genitivo que expresa sustitución o alternativa descartada.",
       "lengua": "alumno",
       "explicacion": "Introduce el elemento que no se realiza o descarta a favor de otra opción.",
       "correcta": true
      },
      {
       "texto": "Funciona como conjunción modal de comparación afirmativa.",
       "lengua": "alumno",
       "explicacion": "La comparación afirmativa emplea «wie» o «als», no «statt».",
       "correcta": false
      },
      {
       "texto": "Introduce una oración subordinada temporal de simultaneidad.",
       "lengua": "alumno",
       "explicacion": "La simultaneidad temporal corresponde a «während», no a «statt».",
