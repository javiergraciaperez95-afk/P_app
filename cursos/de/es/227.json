     "pregunta": {
      "texto": "En una oración de estilo indirecto introducida por «dass», ¿dónde debe situarse el verbo conjugado?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Al final absoluto de la oración subordinada.",
       "lengua": "alumno",
       "explicacion": "Toda conjunción subordinante como «dass» envía el verbo conjugado al final de la cláusula.",
       "correcta": true
      },
      {
       "texto": "En la segunda posición sintáctica, inmediatamente después del sujeto.",
       "lengua": "alumno",
       "explicacion": "Esta posición corresponde a las oraciones sin conjunción «dass».",
       "correcta": false
      },
      {
       "texto": "En la primera posición absoluta, antes del sujeto y los complementos.",
       "lengua": "alumno",
