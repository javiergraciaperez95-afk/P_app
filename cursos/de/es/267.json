     "oir_frase": false,
     "opciones": [
      {
       "texto": "Reafirma con vehemencia cordial una evidencia frente a una posible vacilación.",
       "lengua": "alumno",
       "explicacion": "Busca la adhesión del interlocutor ante un indicio que salta a la vista.",
       "correcta": true
      },
      {
       "texto": "Expresa una duda insuperable que invalida el argumento del crítico.",
       "lengua": "alumno",
       "explicacion": "No denota escepticismo, sino reafirmación expresiva.",
       "correcta": false
      },
      {
       "texto": "Plantea una condición temporal subordinada con verbo flexionado al final.",
       "lengua": "alumno",
       "explicacion": "No es conjunción condicional; es una partícula ilocutiva.",
