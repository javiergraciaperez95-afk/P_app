      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "En el Mittelfeld, integradas en la cadena de complementos tras el verbo conjugado.",
       "lengua": "alumno",
       "explicacion": "No pueden ocupar la primera posición (Vorfeld) de la oración enunciativa.",
       "correcta": true
      },
      {
       "texto": "Obligatoriamente en la primera posición antes del sujeto y del verbo.",
       "lengua": "alumno",
