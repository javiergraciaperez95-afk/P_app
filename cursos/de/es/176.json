     "id": "de176-1",
     "pregunta": {
      "texto": "¿Qué significado introduce la construcción con «ohne … zu»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Expresa que la acción principal ocurre sin que se cumpla otra acción esperada o debida",
       "lengua": "alumno",
       "explicacion": "Indica omisión o privación de una acción concomitante esperable en el contexto.",
       "correcta": true
      },
      {
       "texto": "Expresa la meta o finalidad última que persigue el sujeto con su acción",
       "lengua": "alumno",
       "explicacion": "La finalidad positiva se formula mediante «um … zu», no mediante «ohne … zu».",
       "correcta": false
      },
      {
       "texto": "Plantea una condición indispensable futura similar a «wenn»",
       "lengua": "alumno",
       "explicacion": "La condición hipotética requiere «wenn» o Konjunktiv, no una cláusula modal privativa.",
       "correcta": false
      }
     ],
     "respuestas": {
