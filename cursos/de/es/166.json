     "opciones": [
      {
       "texto": "La persona destinataria va en Dativo y la cosa transferida en Acusativo",
       "lengua": "alumno",
       "explicacion": "«wem?» (¿a quién?) exige dativo y «was?» (¿qué?) exige acusativo.",
       "correcta": true
      },
      {
       "texto": "Ambos complementos deben ir obligatoriamente en Acusativo",
       "lengua": "alumno",
       "explicacion": "Dos objetos en acusativo solo se dan en excepciones muy raras (como «nennen»).",
       "correcta": false
      },
      {
       "texto": "La cosa va en Dativo y la persona en Acusativo",
       "lengua": "alumno",
       "explicacion": "Invertiría las funciones semánticas básicas de la lengua alemana.",
       "correcta": false
      }
