     "oir_frase": false,
     "opciones": [
      {
       "texto": "Acusativo primero y Dativo después («Ich gebe es ihm»)",
       "lengua": "alumno",
       "explicacion": "Con dos pronombres la regla fija e inviolable es siempre Acusativo antes de Dativo.",
       "correcta": true
      },
      {
       "texto": "Dativo primero y Acusativo después («Ich gebe ihm es»)",
       "lengua": "alumno",
       "explicacion": "Ese orden solo se aplica si ambos complementos son sustantivos plenos.",
       "correcta": false
