     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Al final absoluto de la oración.",
       "lengua": "alumno",
       "explicacion": "El verbo modal conjugado va en posición 2 y el infinitivo cierra la oración: «Ich kann gut schwimmen».",
       "correcta": true
      },
      {
       "texto": "Inmediatamente detrás del verbo modal.",
       "lengua": "alumno",
       "explicacion": "Esa es la estructura romance española, no el orden alemán.",
       "correcta": false
      },
      {
       "texto": "En la primera posición antes del sujeto.",
