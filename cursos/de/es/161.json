     "id": "de161-1",
     "pregunta": {
      "texto": "¿Cuándo se utiliza la preposición «von» para introducir el complemento agente en pasiva?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Para indicar el autor personal, entidad o institución que realiza la acción voluntariamente",
       "lengua": "alumno",
       "explicacion": "«von + Dativ» señala al responsable directo humano o institucional.",
       "correcta": true
      },
      {
       "texto": "Exclusivamente para fenómenos atmosféricos involuntarios",
       "lengua": "alumno",
       "explicacion": "Los fenómenos de la naturaleza o causas mecánicas suelen introducirse con «durch + Akkusativ».",
       "correcta": false
      },
      {
       "texto": "Para indicar el precio o coste económico de una reparación",
       "lengua": "alumno",
       "explicacion": "El precio no constituye el agente ejecutor de una acción pasiva.",
       "correcta": false
      }
     ],
     "respuestas": {
