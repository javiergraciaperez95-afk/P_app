    {
     "tipo": "test",
     "id": "de199-4",
     "pregunta": {
      "texto": "¿Qué regla de puntuación y coordinación rige para «sondern auch»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Debe precederle una coma antes de «sondern», y «auch» acompaña al segundo elemento coordinado.",
       "lengua": "alumno",
       "explicacion": "Se coloca coma antes de «sondern» delimitando los dos miembros coordinados.",
       "correcta": true
      },
      {
       "texto": "Nunca se escribe coma y «auch» debe colocarse siempre delante de «sondern».",
       "lengua": "alumno",
