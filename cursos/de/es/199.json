    {
     "tipo": "test",
     "id": "de199-1",
     "pregunta": {
      "texto": "¿Qué función semántica desempeña «nicht nur … sondern auch» en una argumentación?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Suma dos afirmaciones complementarias destacando el valor acumulativo de la segunda.",
       "lengua": "alumno",
       "explicacion": "Refuerza la coordinación copulativa añadiendo un relieve enfático a ambos términos.",
       "correcta": true
      },
      {
       "texto": "Establece una exclusión mutua donde el hablante debe elegir obligatoriamente entre dos opciones.",
       "lengua": "alumno",
       "explicacion": "Esa es la función del conector disyuntivo «entweder … oder».",
       "correcta": false
      },
      {
       "texto": "Niega la primera parte para sustituirla íntegramente por la segunda.",
       "lengua": "alumno",
       "explicacion": "La negación sustitutiva estricta emplearía solo «nicht …, sondern …» sin «auch».",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
