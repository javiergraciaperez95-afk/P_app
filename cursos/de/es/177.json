     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Se produce inversión sintáctica: el verbo conjugado pasa inmediatamente a la primera posición tras la coma",
       "lengua": "alumno",
       "explicacion": "La cláusula subordinada completa ocupa la posición 1, por lo que el verbo principal va en posición 2.",
       "correcta": true
      },
      {
       "texto": "El sujeto de la oración principal se coloca obligatoriamente antes del verbo conjugado",
       "lengua": "alumno",
       "explicacion": "Rompería la regla invariable alemana de posición 2 para el verbo conjugado en oraciones principales.",
       "correcta": false
      },
      {
       "texto": "El verbo de la oración principal debe colocarse al final absoluto",
       "lengua": "alumno",
       "explicacion": "Solo las oraciones subordinadas llevan el verbo conjugado al final absoluto.",
       "correcta": false
      }
