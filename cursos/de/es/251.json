     "tipo": "test",
     "id": "de251-1",
     "pregunta": {
      "texto": "¿Dónde se coloca la partícula «zu» en un verbo separable dentro de una construcción de infinitivo?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Intercalada entre el prefijo separable y la raíz del verbo: «beizulegen», «einzugehen».",
       "lengua": "alumno",
       "explicacion": "En verbos con prefijo separable la partícula «zu» queda integrada en el interior de la palabra.",
       "correcta": true
      },
      {
       "texto": "Delante de toda la frase principal antes del sujeto.",
       "lengua": "alumno",
       "explicacion": "La partícula «zu» acompaña exclusivamente a la forma de infinitivo al final.",
       "correcta": false
      },
      {
       "texto": "Siempre separada al final de la oración después del punto.",
       "lengua": "alumno",
       "explicacion": "Forma una sola palabra gráfica con el verbo separable.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
