    {
     "tipo": "test",
     "id": "de251-4",
     "pregunta": {
      "texto": "¿Cuándo es estrictamente preceptiva la coma en una construcción de infinitivo?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Cuando está introducida por conjunciones subordinantes de infinitivo como «um», «ohne» o «anstatt».",
       "lengua": "alumno",
       "explicacion": "En esas construcciones la coma separadora de cláusula es obligatoria.",
       "correcta": true
      },
      {
       "texto": "Únicamente cuando la frase contiene un número superior a veinte palabras.",
       "lengua": "alumno",
       "explicacion": "La regla ortográfica depende de la naturaleza sintáctica del conector, no del cómputo léxico.",
       "correcta": false
      },
      {
       "texto": "Nunca se coloca coma en las construcciones de infinitivo en la lengua alemana.",
       "lengua": "alumno",
       "explicacion": "La coma es obligatoria en los casos señalados por la norma ortográfica oficial.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
