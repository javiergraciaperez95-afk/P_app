    {
     "tipo": "test",
     "id": "de168-2",
     "pregunta": {
      "texto": "¿Por qué se utiliza «woran» y no «worauf» para la pregunta «¿En qué piensas?»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Porque el verbo «denken» rige fijamente la preposición «an» («denken an + Akk»)",
       "lengua": "alumno",
       "explicacion": "El interrogativo pronominal debe reproducir con exactitud la preposición regida por el verbo.",
       "correcta": true
      },
      {
       "texto": "Porque «an» indica obligatoriamente un lugar cerrado en el interior de un edificio",
       "lengua": "alumno",
       "explicacion": "El régimen preposicional de los verbos abstractos es idiomático y no depende de la localización física.",
       "correcta": false
      },
      {
       "texto": "Porque «worauf» solo se puede usar con verbos que expresen movimiento rápido",
       "lengua": "alumno",
       "explicacion": "La distinción responde al régimen léxico de cada verbo, no a la velocidad de la acción.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
