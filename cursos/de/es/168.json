     "pregunta": {
      "texto": "¿Qué estructura se utiliza para preguntar por una persona tras una preposición que rige acusativo?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "«Präposition + wen» (por ejemplo: «Auf wen wartest du?»)",
       "lengua": "alumno",
       "explicacion": "Las personas requieren la preposición seguida del pronombre interrogativo «wen» (acusativo) o «wem» (dativo).",
       "correcta": true
      },
      {
       "texto": "Un interrogativo con «wor-» (por ejemplo: «Worauf wartest du?»)",
       "lengua": "alumno",
       "explicacion": "Las formas con «wo(r)-» se refieren exclusivamente a cosas, hechos o conceptos.",
       "correcta": false
      },
      {
       "texto": "La partícula interrogativa «was» seguida de la preposición al final",
       "lengua": "alumno",
       "explicacion": "Es una construcción del inglés («What are you waiting for?») inexistente en alemán correcto.",
       "correcta": false
      }
