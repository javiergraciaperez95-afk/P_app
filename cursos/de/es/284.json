     "id": "de284-1",
     "pregunta": {
      "texto": "¿Qué cambio sintáctico define la omisión de «wenn» en una cláusula condicional?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "El verbo conjugado se desplaza a la posición inicial de la frase subordinada.",
       "lengua": "alumno",
       "explicacion": "La posición V1 (verbo al inicio) marca formalmente la prótasis condicional sin wenn.",
       "correcta": true
      },
      {
       "texto": "El verbo se coloca obligatoriamente en infinitivo al final de la frase.",
       "lengua": "alumno",
       "explicacion": "El verbo se mantiene en modo finito conjugado, no en infinitivo.",
       "correcta": false
      },
      {
       "texto": "La frase requiere obligatoriamente una partícula interrogativa de apertura.",
       "lengua": "alumno",
       "explicacion": "No se trata de una interrogativa, sino de una subordinada condicional asindética.",
       "correcta": false
      }
     ],
     "respuestas": {
