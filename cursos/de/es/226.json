    {
     "tipo": "traduccion",
     "id": "de226-3",
     "pregunta": {
      "texto": "¿Qué significa esta afirmación?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "Beide Seiten hoffen, sie fänden bald eine Lösung.",
      "lengua": "estudio"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Ambas partes esperan encontrar pronto una solución.",
       "lengua": "alumno",
       "explicacion": "«fänden» es el Konjunktiv II de «finden», usado como forma de sustitución.",
       "correcta": true
      },
      {
       "texto": "Ninguna de las partes tiene interés en resolver el conflicto.",
       "lengua": "alumno",
       "explicacion": "El verbo «hoffen» (esperar) y «Lösung» indican voluntad de acuerdo.",
       "correcta": false
      },
      {
       "texto": "Ambas partes descartan que exista alguna solución posible.",
       "lengua": "alumno",
       "explicacion": "La frase expresa esperanza de alcanzarla pronto («bald»).",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
    {
     "tipo": "test",
     "id": "de226-4",
     "pregunta": {
      "texto": "¿Por qué se prefiere «sie würden fordern» frente a «sie forderten» en la lengua hablada y prensa cotidiana?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Porque «forderten» es idéntico al pasado simple (Präteritum) de indicativo y crea confusión temporal.",
       "lengua": "alumno",
       "explicacion": "En verbos débiles, el Konjunktiv II coincide formalmente con el Präteritum.",
       "correcta": true
      },
      {
       "texto": "Porque el verbo «fordern» no tiene conjugación en lengua alemana escrita.",
       "lengua": "alumno",
       "explicacion": "Todos los verbos regulares disponen de paradigma completo.",
       "correcta": false
      },
      {
       "texto": "Porque «würden» solo puede emplearse con sustantivos en singular.",
       "lengua": "alumno",
       "explicacion": "«würden» es la forma conjugada de plural para «sie» o «wir».",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
