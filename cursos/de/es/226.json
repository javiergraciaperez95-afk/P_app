   "piezas": [
    {
     "tipo": "test",
     "id": "de226-1",
     "pregunta": {
      "texto": "¿Cuándo es preceptivo usar una forma de sustitución en estilo indirecto?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Cuando la forma del Konjunktiv I coincide morfológicamente con el indicativo.",
       "lengua": "alumno",
       "explicacion": "La sustitución asegura que el lector reconozca el discurso referido.",
       "correcta": true
      },
      {
       "texto": "Exclusivamente cuando el hablante quiere expresar que la declaración es una mentira.",
       "lengua": "alumno",
       "explicacion": "El Konjunktiv II en estilo indirecto no califica la veracidad, solo evita la ambigüedad formal.",
       "correcta": false
      },
      {
       "texto": "Solo cuando la oración principal está conjugada en tiempo futuro.",
       "lengua": "alumno",
       "explicacion": "La regla depende de la coincidencia morfológica, no del tiempo de la matriz.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
    {
     "tipo": "huecos",
