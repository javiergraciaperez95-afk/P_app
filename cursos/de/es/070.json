     "id": "de070-1",
     "pregunta": {
      "texto": "¿Qué caso gramatical exige el verbo alemán «helfen» (ayudar)?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Dativo",
       "lengua": "alumno",
       "explicacion": "En alemán «helfen» rige siempre dativo: «Er hilft mir», «Die Ärztin hilft ihm».",
       "correcta": true
      },
      {
       "texto": "Acusativo",
       "lengua": "alumno",
       "explicacion": "«Helfen» no admite objeto directo en acusativo.",
       "correcta": false
      },
      {
       "texto": "Genitivo",
       "lengua": "alumno",
       "explicacion": "El genitivo no se utiliza con el verbo «helfen».",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
