     "opciones": [
      {
       "texto": "ob",
       "lengua": "estudio",
       "explicacion": "«Ob» equivale al «si» dubitativo español en preguntas indirectas y sitúa el verbo al final.",
       "correcta": true
      },
      {
       "texto": "wenn",
       "lengua": "estudio",
       "explicacion": "«Wenn» significa «si» condicional o «cuando» temporal, pero no introduce preguntas indirectas.",
       "correcta": false
      },
      {
       "texto": "dass",
       "lengua": "estudio",
       "explicacion": "«Dass» introduce hechos u opiniones afirmadas («creo que...»), no dudas de sí o no.",
       "correcta": false
