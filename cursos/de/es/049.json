      {
       "texto": "Verbo en forma de Sie en primera posición + Sie + complementos.",
       "lengua": "alumno",
       "explicacion": "El imperativo formal invierte el orden habitual situando el verbo al inicio: «Nehmen Sie den Bus!».",
       "correcta": true
      },
      {
       "texto": "Pronombre Sie + verbo en infinitivo al final.",
       "lengua": "alumno",
       "explicacion": "Ese no es el orden del imperativo alemán.",
       "correcta": false
      },
      {
       "texto": "Verbo con desinencia «-st» + sujeto Sie.",
       "lengua": "alumno",
       "explicacion": "«-st» corresponde a la 2.ª persona informal «du».",
       "correcta": false
      }
