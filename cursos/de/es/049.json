     "pregunta": {
      "texto": "¿Cuál es la estructura sintáctica correcta del imperativo formal con «Sie»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
