       {
        "texto": "mögen + acusativo",
        "lengua": "alumno"
       },
       {
        "texto": "Ich mag Obst.",
        "lengua": "estudio"
       },
       {
        "texto": "Me gusta la fruta.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Acciones (verbos)",
        "lengua": "alumno"
       },
       {
        "texto": "verbo + gern",
        "lengua": "alumno"
       },
       {
        "texto": "Ich esse gern Reis.",
        "lengua": "estudio"
       },
       {
        "texto": "Me gusta comer arroz.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Negación con cosas",
        "lengua": "alumno"
       },
       {
        "texto": "mögen + kein",
        "lengua": "estudio"
       },
       {
        "texto": "Er mag keinen Fisch.",
        "lengua": "estudio"
       },
       {
        "texto": "No le gusta el pescado.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Negación con acciones",
        "lengua": "alumno"
       },
       {
        "texto": "verbo + nicht gern",
        "lengua": "alumno"
       },
       {
        "texto": "Wir essen nicht gern Fleisch.",
        "lengua": "estudio"
       },
       {
        "texto": "No nos gusta comer carne.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Preferencia",
        "lengua": "alumno"
       },
       {
        "texto": "verbo + lieber",
        "lengua": "alumno"
       },
       {
        "texto": "Ich trinke lieber Saft.",
        "lengua": "estudio"
       },
       {
        "texto": "Prefiero tomar zumo.",
        "lengua": "alumno"
       }
      ]
     ],
