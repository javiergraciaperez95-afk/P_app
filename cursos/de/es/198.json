    {
     "tipo": "test",
     "id": "de198-1",
     "pregunta": {
      "texto": "¿Qué efecto sintáctico produce «sodass» en la cláusula que introduce?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Subordina la oración situando el verbo conjugado en última posición.",
       "lengua": "alumno",
       "explicacion": "Como conjunción subordinante consecutiva, exige el verbo conjugado al final de la cláusula.",
       "correcta": true
      },
      {
       "texto": "Exige inversión inmediata colocando el verbo en segunda posición absoluta.",
       "lengua": "alumno",
       "explicacion": "Eso ocurre con adverbios conectores como «deshalb» o «folglich», no con «sodass».",
       "correcta": false
      },
      {
       "texto": "Se comporta como conjunción coordinante sin alterar el orden habitual.",
       "lengua": "alumno",
       "explicacion": "Eso corresponde a conjunciones como «und», «aber», «denn» u «oder».",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
