    {
     "tipo": "test",
     "id": "de198-4",
     "pregunta": {
      "texto": "¿Cuál es la diferencia entre el conector «sodass» y la estructura correlativa «so …, dass»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "«sodass» introduce la consecuencia en bloque, mientras «so …, dass» gradúa la intensidad de un adjetivo o adverbio.",
       "lengua": "alumno",
       "explicacion": "«so» califica el grado del atributo en la cláusula principal antes de abrir la consecuencia con «dass».",
       "correcta": true
      },
      {
       "texto": "«sodass» se emplea únicamente con valor condicional y «so …, dass» con valor causal.",
       "lengua": "alumno",
       "explicacion": "Ambas construcciones pertenecen al ámbito de la subordinación consecutiva.",
       "correcta": false
      },
      {
       "texto": "«so …, dass» requiere el verbo en infinitivo con «zu» obligatoriamente.",
       "lengua": "alumno",
       "explicacion": "Ambas introducen oraciones subordinadas con verbo conjugado al final.",
       "correcta": false
      }
     ],
