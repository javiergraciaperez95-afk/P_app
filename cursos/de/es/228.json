     "tipo": "test",
     "id": "de228-1",
     "pregunta": {
      "texto": "¿Cuál es la posición más frecuente de la palabra «zufolge» cuando indica la fuente?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Detrás del sustantivo al que complementa, rigiendo dativo.",
       "lengua": "alumno",
       "explicacion": "«Den Berichten zufolge» se construye típicamente como posposición con dativo.",
       "correcta": true
      },
      {
       "texto": "Delante del verbo conjugado al principio absoluto de la oración.",
       "lengua": "alumno",
       "explicacion": "Se coloca tras el grupo nominal que representa la fuente.",
       "correcta": false
      },
      {
       "texto": "Siempre al final de la subordinada como si fuera un prefijo separable.",
       "lengua": "alumno",
       "explicacion": "Es una adposición de fuente, no una partícula verbal separable.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
