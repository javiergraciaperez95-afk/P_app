    {
     "tipo": "test",
     "id": "de228-4",
     "pregunta": {
      "texto": "¿Qué caso suele regir la preposición «laut» en la lengua formal moderna?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Dativo o Genitivo.",
       "lengua": "alumno",
       "explicacion": "En alemán moderno se utiliza ampliamente con dativo («laut dem Bericht») y también con genitivo.",
       "correcta": true
      },
      {
       "texto": "Únicamente acusativo de dirección.",
       "lengua": "alumno",
       "explicacion": "«Laut» expresa fuente de referencia, no dirección ni movimiento en acusativo.",
       "correcta": false
      },
      {
       "texto": "No rige ningún caso porque funciona siempre como conjunción.",
       "lengua": "alumno",
       "explicacion": "Es una preposición que determina el caso del sintagma nominal de la fuente.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
