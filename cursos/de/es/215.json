     "opciones": [
      {
       "texto": "Con el presente de indicativo y el complemento de tiempo.",
       "lengua": "alumno",
       "explicacion": "En el uso cotidiano, un marcador como «morgen» o «nächstes Jahr» permite usar el presente sin ambigüedad.",
       "correcta": true
      },
      {
       "texto": "Es obligatorio usar siempre el condicional «würde».",
       "lengua": "alumno",
       "explicacion": "«würde» expresa cortesía o irrealidad, no un plan seguro.",
       "correcta": false
      },
      {
       "texto": "Debe usarse el pasado para enfatizar la seguridad del plan.",
       "lengua": "alumno",
       "explicacion": "El pasado indicaría una acción ya concluida.",
       "correcta": false
      }
     ],
     "respuestas": {
