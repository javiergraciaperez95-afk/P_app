     "pregunta": {
      "texto": "¿Cómo se forma el Konjunktiv II del pasado para un verbo de movimiento como «kommen»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Con «wäre» más el participio II («wäre gekommen»)",
       "lengua": "alumno",
       "explicacion": "Como «kommen» forma sus tiempos compuestos con «sein», en pasado irreal utiliza «wäre».",
       "correcta": true
      },
      {
       "texto": "Con «hätte» más el participio II («hätte gekommen»)",
       "lengua": "alumno",
       "explicacion": "Los verbos de movimiento intransitivos no forman tiempos compuestos con «haben».",
       "correcta": false
      },
      {
       "texto": "Con «würde» más el infinitivo («würde kommen»)",
       "lengua": "alumno",
       "explicacion": "Esa estructura corresponde al presente irreal o condicional simple, no al pasado.",
       "correcta": false
      }
     ],
     "respuestas": {
