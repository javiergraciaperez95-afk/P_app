     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Liebe Lena, du hast vor fünf Jahren in einer kleinen Stadt gewohnt.",
       "alumno": "Querida Lena, hace cinco años vivías en una ciudad pequeña.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "du hast",
         "tienes"
        ],
        [
         "gewohnt",
         "vivido"
        ],
        [
         "vor fünf Jahren",
         "hace cinco años"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Damals warst du unsicher, aber du wolltest etwas Neues lernen.",
       "alumno": "Entonces estabas insegura, pero querías aprender algo nuevo.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "damals warst du",
         "entonces estabas"
        ],
        [
         "wolltest",
         "querías"
        ],
        [
         "etwas Neues lernen",
         "aprender algo nuevo"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Nachdem du die Stelle bekommen hattest, hast du dich sehr gefreut.",
       "alumno": "Después de que consiguieras el puesto, te alegraste mucho.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Nachdem du die Stelle bekommen hattest",
         "después de que consiguieras el puesto"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Heute wirst du sicher sagen, dass es die beste Entscheidung war.",
       "alumno": "Hoy seguro que dirás que fue la mejor decisión.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "wirst du",
         "dirás"
        ],
        [
         "sagen",
         "decir"
        ],
        [
         "die beste Entscheidung",
         "la mejor decisión"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Mit dem Wissen, das du damals hattest, wärst du nicht so nervös gewesen.",
       "alumno": "Con los conocimientos que tenías entonces, no habrías estado tan nerviosa.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "das du damals hattest",
         "que tenías entonces"
        ],
        [
         "wärst du",
         "habrías estado"
        ],
        [
         "gewesen",
         "estado"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Deine Familie hilft dir, weil sie dich liebt.",
       "alumno": "Tu familia te ayuda, porque te quiere.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "weil sie dich liebt",
         "porque te quiere"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Also lerne weiter, damit du deine Ziele erreichst.",
       "alumno": "Así que sigue aprendiendo, para alcanzar tus metas.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "damit du deine Ziele erreichst",
         "para que alcances tus metas"
