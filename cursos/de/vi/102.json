        "texto": "Felix",
        "lengua": "estudio"
       },
       "estudio": "Was machtest du früher?",
       "alumno": "«Was machtest du früher?» Dịch: Ngày xưa bạn làm gì?",
       "literal": "",
       "estructura": "",
       "nota": [],
