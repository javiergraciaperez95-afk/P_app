        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Julia",
        "lengua": "estudio"
       },
       "estudio": "Wegen des Lärms gab es letzte Woche eine Diskussion.",
       "alumno": "Vì tiếng ồn, tuần trước đã có một cuộc tranh luận.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "wegen des Lärms",
         "vì tiếng ồn («wegen des Lärms»)"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Peter",
        "lengua": "estudio"
       },
       "estudio": "Stimmt, aber wir haben es gelöst.",
       "alumno": "Đúng vậy, nhưng chúng mình đã giải quyết được.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "haben es gelöst",
         "chúng mình đã giải quyết («haben es gelöst»)"
        ]
       ],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Quy định của căn hộ ở ghép",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "In unserer Wohnung hat jede Person eine Aufgabe.",
       "alumno": "Trong căn hộ của chúng ta, mỗi người có một nhiệm vụ.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Am Montag kauft eine Person ein, am Dienstag putzt eine andere die Küche.",
       "alumno": "Thứ Hai một người đi mua sắm, thứ Ba người khác lau bếp.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Nach zehn Uhr abends hören wir keine laute Musik.",
       "alumno": "Sau mười giờ tối chúng ta không nghe nhạc to.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Wenn Freunde kommen, informieren wir vorher alle.",
       "alumno": "Nếu có bạn đến, chúng ta báo trước cho mọi người.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Am Sonntag planen wir gemeinsam die Woche.",
       "alumno": "Chủ nhật chúng ta cùng lên kế hoạch cho tuần.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Bei Problemen sprechen wir miteinander.",
       "alumno": "Khi có vấn đề, chúng ta nói chuyện với nhau.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
