     "titulo": "Căn hộ ở ghép",
     "frases": [
      {
       "quien": {
        "texto": "Julia",
        "lengua": "estudio"
       },
       "estudio": "Wir sollten gemeinsam einen Plan machen, damit es keine Konflikte gibt.",
       "alumno": "Chúng ta nên cùng lập một kế hoạch để không có xung đột.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "damit es keine Konflikte gibt",
         "để không có xung đột («damit es keine Konflikte gibt»)"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Peter",
        "lengua": "estudio"
       },
       "estudio": "Ja, ich würde mir mehr Rücksicht wünschen.",
       "alumno": "Đúng vậy, mình muốn được quan tâm nhiều hơn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "ich würde mir",
         "mình muốn («ich würde mir»)"
        ],
        [
         "wünschen",
