   "etapa": "leer",
   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Nói về truyền thông",
     "frases": [
      {
       "quien": {
        "texto": "Anna",
        "lengua": "estudio"
       },
       "estudio": "Hast du die Zeitung gelesen, über die alle sprechen?",
       "alumno": "Bạn đã đọc tờ báo mà mọi người đang nói tới chưa?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "über die alle sprechen",
         "mà mọi người đang nói tới («über die alle sprechen»)"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Tim",
        "lengua": "estudio"
       },
       "estudio": "Ja, das ist der Roman, von dem die Nachrichten berichten.",
       "alumno": "Đúng vậy, đó là cuốn tiểu thuyết mà các tin tức đưa tin.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "von dem die Nachrichten berichten",
         "tiểu thuyết mà các tin tức đưa tin («von dem die Nachrichten berichten»)"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Anna",
        "lengua": "estudio"
       },
       "estudio": "Und die Serie, mit der du arbeitest?",
       "alumno": "Còn bộ phim nhiều tập mà bạn làm việc cùng thì sao?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "mit der du arbeitest",
         "mà bạn làm việc cùng («mit der du arbeitest»)"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Tim",
        "lengua": "estudio"
       },
       "estudio": "Das ist keine Serie. Ich arbeite mit einem Künstler am Theater.",
       "alumno": "Không phải phim nhiều tập. Mình làm việc với một nghệ sĩ ở nhà hát.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "mit einem Künstler",
         "với một nghệ sĩ («mit einem Künstler»)"
        ]
       ],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Bài điểm sách",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Ich habe ein Buch gelesen, über das viele Leser sprechen.",
       "alumno": "Mình đã đọc một cuốn sách mà nhiều độc giả đang bàn tán.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Die Geschichte spielt in Berlin.",
       "alumno": "Câu chuyện diễn ra ở Berlin.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Der Autor beschreibt eine Familie, die zusammen ein Haus renoviert.",
       "alumno": "Tác giả mô tả một gia đình cùng nhau sửa lại một ngôi nhà.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Besonders spannend ist die Frau, der die Nachbarn helfen.",
       "alumno": "Người phụ nữ mà hàng xóm giúp đỡ là nhân vật đặc biệt thú vị.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Die Zeitung lobt das Buch, aber ich finde das Ende traurig.",
       "alumno": "Tờ báo ca ngợi cuốn sách, nhưng mình thấy kết thúc buồn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
