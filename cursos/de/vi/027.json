        [
         "ins Kino",
         "đi xem phim"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Tim",
        "lengua": "estudio"
       },
       "estudio": "Ich mache am Wochenende immer Sport.",
       "alumno": "Mình luôn chơi thể thao vào cuối tuần.",
