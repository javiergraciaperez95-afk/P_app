    {
     "tipo": "dialogo",
     "titulo": "Bạn làm gì vào cuối tuần?",
     "frases": [
      {
       "quien": {
        "texto": "Tim",
        "lengua": "estudio"
       },
       "estudio": "Heute ist Samstag! Du arbeitest am Samstag nicht.",
       "alumno": "Hôm nay là thứ Bảy! Bạn không làm việc vào thứ Bảy.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Heute ist Samstag",
         "hôm nay là thứ Bảy"
        ],
        [
