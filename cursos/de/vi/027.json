         "vào thứ Bảy"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Laura",
        "lengua": "estudio"
       },
       "estudio": "Doch! Manchmal arbeite ich am Samstag.",
       "alumno": "Có chứ! Đôi khi mình làm việc vào thứ Bảy.",
       "literal": "",
       "estructura": "",
       "nota": [],
