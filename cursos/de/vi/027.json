        ],
        [
         "am Wochenende",
         "cuối tuần"
        ],
        [
         "immer Sport",
         "luôn tập thể thao"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Laura",
        "lengua": "estudio"
       },
       "estudio": "Gehst du ins Schwimmbad?",
       "alumno": "Bạn đi bể bơi à?",
