         "bạn làm gì"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Laura",
        "lengua": "estudio"
       },
       "estudio": "Am Sonntag arbeite ich nie. Ich gehe oft mit Freunden ins Kino.",
       "alumno": "Chủ nhật mình không bao giờ làm việc. Mình thường đi xem phim cùng bạn bè.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
