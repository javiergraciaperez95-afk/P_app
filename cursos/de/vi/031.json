    {
     "tipo": "dialogo",
     "titulo": "Bạn mê cá không?",
     "frases": [
      {
       "quien": {
        "texto": "Sophie",
        "lengua": "estudio"
       },
       "estudio": "Magst du Fisch, Tim?",
       "alumno": "Tim ơi, bạn có mê cá không?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Magst du",
         "bạn thích à? (từ «mögen»)"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Tim",
        "lengua": "estudio"
       },
       "estudio": "Nein, ich mag keinen Fisch. Aber ich esse gern Hähnchen.",
       "alumno": "Không, mình không ưa cá. Nhưng mình mê ăn gà.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
