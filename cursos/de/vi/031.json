        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Sophie",
        "lengua": "estudio"
       },
       "estudio": "Was isst du zum Frühstück?",
       "alumno": "Bạn ăn gì vào bữa sáng?",
