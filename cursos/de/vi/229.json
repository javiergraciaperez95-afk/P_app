   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Bị động trạng thái",
     "texto": [
      "Được hình thành với **sein** + phân từ II: **Die Tür ist geschlossen** (cánh cửa đang đóng). Nó diễn đạt một trạng thái hay kết quả. Với **werden** hình thành bị động quá trình: **Die Tür wird geschlossen** (cửa được đóng / đang được đóng). Dạng này không buộc phải hiểu hành động xảy ra ngay bây giờ: thì và ngữ cảnh giúp hoàn thiện nghĩa. **Ist geschlossen** tự nó không phải là thì quá khứ; nó mô tả trạng thái tại thời điểm đang nói."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Quá trình và kết quả trong ngữ cảnh",
     "texto": [
      "**Der Patient wird operiert** trình bày ca mổ như một quá trình hoặc sự kiện; **Der Patient ist operiert** trình bày bệnh nhân đã được mổ. **Das Medikament wird eingenommen** có thể mô tả một quá trình hoặc chỉ dẫn chung; **Das Medikament ist eingenommen worden** diễn đạt rằng ai đó đã uống nó. Không phải phân từ nào cũng tự nhiên mang nghĩa trạng thái."
     ],
     "tutora": ""
    },
