  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Cấu trúc bổ sung tương quan sowohl … als auch",
     "texto": [
      "**Sowohl … als auch** nối hai thành phần tương đương bằng cách cộng nội dung của chúng với giá trị khẳng định tích lũy («vừa … vừa»). Khác với **nicht nur … sondern auch**, nó không thêm sắc thái nhấn mạnh hay bất ngờ mà tạo sự song song nghiêm ngặt: **Sowohl der Bund als auch die Länder finanzieren das Hilfsprogramm** (cả Liên bang lẫn các bang đều tài trợ chương trình hỗ trợ)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Hòa hợp động từ",
     "texto": [
      "Khi **sowohl … als auch** nối hai danh từ số ít làm chủ ngữ kép, động từ thường chia ở ngôi thứ ba số nhiều, vì cả hai chủ ngữ cộng lại tác động chủ động: **Sowohl die Qualität als auch der Kundenservice haben sich verbessert**."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Thành phần được nối",
     "columnas": [
      {
       "texto": "Ví dụ",
       "lengua": "alumno"
      },
      {
       "texto": "Ý nghĩa",
       "lengua": "alumno"
      }
     ],
     "filas": [
      [
       {
        "texto": "Chủ ngữ danh từ",
        "lengua": "alumno"
       },
       {
        "texto": "Sowohl der Preis als auch die Qualität stimmen.",
        "lengua": "estudio"
       },
       {
        "texto": "Cả giá cả lẫn chất lượng đều đúng.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Bổ ngữ trực tiếp",
        "lengua": "alumno"
       },
       {
        "texto": "Wir fördern sowohl Innovation als auch Bildung.",
        "lengua": "estudio"
       },
       {
        "texto": "Chúng tôi khuyến khích cả đổi mới lẫn giáo dục.",
