   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Thông báo của thư viện",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Die Bibliothek ist ab Mai auch sonntags geöffnet.",
       "alumno": "Từ tháng Năm, thư viện cũng mở cửa vào các Chủ nhật.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Sie öffnet um zehn Uhr und schließt um sechzehn Uhr.",
       "alumno": "Mở cửa lúc mười giờ và đóng cửa lúc mười sáu giờ.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Im Leseraum kann man Bücher lesen.",
       "alumno": "Trong phòng đọc có thể đọc sách.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Essen und Getränke sind dort nicht erlaubt.",
       "alumno": "Ở đó không được phép ăn uống.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Wer einen Platz am Tisch möchte, muss ihn bis Freitag reservieren.",
       "alumno": "Ai muốn một chỗ ngồi ở bàn thì phải đặt trước thứ Sáu.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Weil es nur zwanzig Plätze gibt, empfiehlt die Bibliothek eine Anmeldung bis Freitag.",
       "alumno": "Vì chỉ có hai mươi chỗ, thư viện khuyên nên đăng ký trước thứ Sáu.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
