    {
     "tipo": "explicacion",
     "titulo": "Ôn tập cuối B1",
     "texto": [
      "Bài trắc nghiệm này kết hợp ngữ pháp, từ vựng và đọc hiểu từ chương 21 đến 30. Hãy dùng nó để xác định những chủ đề cần ôn lại; đây không phải là chứng chỉ hay bài thi B1 chuẩn hóa.",
      "Mỗi câu hỏi có ghi chương: «Chương 21» là chương 21."
     ],
     "tutora": ""
    }
   ]
  },
  {
   "etapa": "palabras",
   "piezas": [
    {
     "tipo": "vocabulario",
     "titulo": "Từ vựng: thư viện",
