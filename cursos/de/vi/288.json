   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Kỹ thuật nhượng bộ trong lập luận",
     "texto": [
      "Trong diễn ngôn học thuật, pháp lý và trọng tài, một lập luận vững chắc bắt đầu bằng việc thừa nhận một phần giá trị của các phản đối từ phía đối phương, rồi sau đó để luận điểm của mình chiếm ưu thế. Để cấu trúc sự cân bằng này, người ta dùng các liên từ nhượng bộ và đối lập như **zwar … aber / dennoch / trotzdem**: **Zwar ist das Vorhaben kostenintensiv, dennoch überwiegen die langfristigen Vorteile** (dù dự án tốn kém, tuy nhiên các lợi ích dài hạn vẫn vượt trội)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Quy tắc vị trí của dennoch và trotzdem",
     "texto": [
      "Sau một mệnh đề mở đầu bằng **zwar**, liên từ **dennoch** thường hoạt động như trạng từ liên kết ở vị trí thứ nhất của mệnh đề chính, gây đảo ngữ tức thì của động từ chia (**V2**): **dennoch bietet die Maßnahme entscheidende Garantien**."
     ],
     "tutora": ""
    },
