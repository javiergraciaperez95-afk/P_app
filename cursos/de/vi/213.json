       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Nachdem du die Stelle bekommen hattest, hast du dich sehr gefreut.",
       "alumno": "Sau khi bạn nhận được công việc, bạn đã rất vui mừng.",
       "literal": "",
       "estructura": "",
       "nota": [],
