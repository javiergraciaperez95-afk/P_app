    {
     "tipo": "explicacion",
     "titulo": "Rutina de la mañana",
     "texto": [
      "**Bangun** es despertarse, **mandi** es bañarse y **sarapan** es desayunar. Los verbos no cambian según la persona."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Antes, después y luego",
     "texto": [
      "**Sebelum** significa «antes de», **setelah**, «después de», y **lalu**, «luego». El orden de la frase puede variar."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Decir una hora",
     "texto": [
      "**Pukul lima pagi** equivale a «a las cinco de la mañana». **Jam** también se usa al hablar de la hora."
     ],
     "tutora": ""
    }
   ]
