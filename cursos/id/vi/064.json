   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Diễn đạt lời chúc tốt đẹp",
     "texto": [
      "**Semoga** đã xuất hiện ở A2; **mudah-mudahan** cũng nghĩa là «mong sao». Cả hai cụm này thường đứng đầu câu nói về điều mình mong muốn.",
      "**Berharap** nghĩa là hy vọng hoặc mong điều gì xảy ra; không cần dạng động từ đặc biệt đứng sau."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Bàn về kế hoạch và mục tiêu",
     "texto": [
      "**Tercapai** nghĩa là một mục tiêu đạt được; **terwujud**, điều ước trở thành hiện thực; **terlaksana**, kế hoạch được thực hiện. Đừng nhầm lẫn ba kết quả này."
     ],
     "tutora": ""
    }
   ]
  },
