    {
     "tipo": "explicacion",
     "titulo": "Từ có tiền tố ber-",
     "texto": [
      "**Berambut** nghĩa là \"có tóc\" và **bermata** nghĩa là \"có mắt\" với một đặc điểm nào đó. Gốc từ được ghép với tiền tố."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Màu da",
     "texto": [
      "**Berkulit putih** nghĩa là \"có làn da sáng\". Màu sắc đứng sau từ có **ber-**."
     ],
     "tutora": ""
    }
   ]
