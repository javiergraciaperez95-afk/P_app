   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Danh từ chỉ hành động",
     "texto": [
      "**peng-…-an** tạo ra danh từ chỉ hành động hoặc quá trình, như **mencegah → pencegahan** («ngăn ngừa → phòng ngừa») và **menggunakan → penggunaan** («dùng → việc sử dụng»). Hình thức và nghĩa cụ thể phụ thuộc vào từ gốc và ngữ cảnh.",
      "Trong tiếng Việt, danh từ tương đương thường mở đầu bằng **sự**, nhưng sự tương ứng không tự động. Hãy chú ý đến gốc động từ và chức năng của danh từ trong câu."
     ],
     "tutora": ""
    }
   ]
