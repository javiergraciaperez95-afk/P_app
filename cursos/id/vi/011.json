     "titulo": "Sở hữu bằng hậu tố",
     "texto": [
      "**Ibuku** nghĩa là \"mẹ tôi\" và **nenekmu**, \"bà của bạn\". Hậu tố được viết liền với danh từ."
     ],
     "tutora": ""
    },
