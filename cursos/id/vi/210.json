   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Bài phê bình",
     "texto": [
      "**ulasan** là đánh giá về một tác phẩm. Nó có thể gồm một bản tóm tắt, những điểm nổi bật và một lời khuyên.",
      "**Meskipun** đưa ra sự đối lập («dù rằng»); **sebaliknya**, một ý trái ngược («ngược lại»)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Tóm tắt và đánh giá",
     "texto": [
      "**Menyimpulkan** là tóm tắt ý chính. **Layak ditonton** nghĩa là «đáng xem». Khi viết một nhận xét, hãy tách phần tóm tắt khỏi đánh giá cá nhân."
     ],
     "tutora": ""
    }
   ]
