 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Tarjetas y mensajes",
    "@en": "Cards and messages"
   },
   "texto": [
    {
     "@es": "**Kartu ucapan** es una tarjeta para acompañar una felicitación o un deseo. **Selamat menempuh hidup baru** es una fórmula de buenos deseos para una pareja que se casa.",
     "@en": "**Kartu ucapan** is a card to accompany a greeting or a wish. **Selamat menempuh hidup baru** is a good wish formula for a married couple."
    },
    {
     "@es": "El contexto ayuda a distinguir **ucapan** («palabras, mensaje») de **ucapan selamat** («felicitación»).",
     "@en": "The context helps to distinguish **ucapan** («words, message») from **ucapan selamat** («felicitación»)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Preposiciones en una felicitación",
    "@en": "Prepositions in a congratulation"
   },
   "texto": [
    {
     "@es": "**Kepada** señala quién recibe algo; **untuk**, para quién o con qué propósito; **atas**, el motivo de la felicitación. Estas preposiciones ya aparecen en el nivel anterior, pero aquí se combinan en mensajes más largos.",
     "@en": "**Kepada** points out who receives something; **untuk**, for whom or for what purpose; **atas**, the reason for the congratulation. These prepositions already appear at the previous level, but here they are combined in longer messages."
    }
   ]
  },
