 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Describir un edificio",
    "@en": "Describe a building"
   },
   "texto": [
    {
     "@es": "Para describir un lugar, puedes decir **Bangunan ini memiliki ruang tunggu** («Este edificio tiene una sala de espera») o **Klinik berfungsi untuk layanan kesehatan** («La clínica sirve para prestar servicios de salud»).",
     "@en": "To describe a place, you can say **Bangunan ini memiliki ruang tunggu** («This building has a waiting room») or **Klinik berfungsi untuk layanan kesehatan** («The clinic serves to provide health services»)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Lugares públicos",
    "@en": "Public places"
   },
   "texto": [
    {
     "@es": "**Fasilitas umum** son espacios o servicios que usa la población. El nombre del lugar suele bastar para decir qué servicio ofrece.",
     "@en": "**Fasilitas umum** are spaces or services used by the population. The name of the place is usually enough to say what service it offers."
    }
   ]
  },
