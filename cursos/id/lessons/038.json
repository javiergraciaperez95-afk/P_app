      "@en": "That's a «loket»."
     }
    },
    {
     "texto": {
      "@es": "El edificio de una clínica.",
      "@en": "A clinic building."
     },
     "explicacion": {
      "@es": "Eso es un «klinik».",
      "@en": "That's a «klinik»."
     }
