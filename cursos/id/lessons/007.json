{
 "capitulo": 1,
 "titulo_ind": "Ciri-ciri fisik",
 "titulo_es": {
  "@es": "Rasgos físicos",
  "@en": "Physical features"
 },
 "palabras": {
  "ciri-ciri": {
   "es": "rasgos",
   "en": "features",
   "pron": "CHI-ri CHI-ri",
   "consejo": {
    "@es": "La repetición forma el plural o expresa una categoría de rasgos.",
    "@en": "The repetition forms the plural or expresses a category of features."
   }
  },
  "tinggi": {
   "es": "alto, de estatura",
   "en": "High, height",
   "pron": "TING-gi",
   "consejo": {
    "@es": "Se refiere a la altura de una persona o cosa.",
    "@en": "It means the height of a person or something."
   }
  },
  "pendek": {
   "es": "bajo, corto",
   "en": "low, short",
   "pron": "pen-DEK",
   "consejo": {
    "@es": "Para una persona significa «bajo»; para pelo, «corto».",
    "@en": "For a person means «low»; for hair, «short»."
   }
  },
  "rambut": {
   "es": "pelo, cabello",
   "en": "hair, hair",
   "pron": "RAM-but",
   "consejo": {
    "@es": "No cambia por género ni número.",
    "@en": "It doesn't change by gender or number."
   }
  },
  "lurus": {
   "es": "liso, recto",
   "en": "smooth, straight",
   "pron": "LU-rus",
   "consejo": {
    "@es": "Puede describir el pelo o una línea.",
    "@en": "You can describe the hair or a line."
   }
  },
  "keriting": {
   "es": "rizado",
   "en": "curly",
   "pron": "ke-ri-TING",
   "consejo": {
    "@es": "Se usa sobre todo para el pelo.",
    "@en": "It's mostly used for hair."
   }
  },
  "wajah": {
   "es": "cara, rostro",
   "en": "face, face",
   "pron": "WA-jah",
   "consejo": {
    "@es": "Nombre del rostro.",
    "@en": "Face name."
   }
  },
  "bulat": {
   "es": "redondo",
   "en": "round",
   "pron": "bu-LAT",
   "consejo": {
    "@es": "Describe la forma.",
    "@en": "Describe the form."
   }
  },
  "panjang": {
   "es": "largo",
   "en": "long",
   "pron": "pan-JANG",
   "consejo": {
    "@es": "Puede describir el pelo o un objeto.",
    "@en": "You can describe the hair or an object."
   }
  },
  "hidung": {
   "es": "nariz",
   "en": "nose",
   "pron": "hi-DUNG",
   "consejo": {
    "@es": "Nombre del rostro.",
    "@en": "Face name."
   }
  },
  "mata": {
   "es": "ojo",
   "en": "eye",
   "pron": "MA-ta",
   "consejo": {
    "@es": "La palabra no cambia en plural: «dos ojos» es «dua mata».",
    "@en": "The word does not change in plural: «two eyes» is «dua mata»."
   }
  },
  "pesek": {
   "es": "chato, respingado",
   "en": "chute, repented",
   "pron": "pe-SEK",
   "consejo": {
    "@es": "Describe una nariz.",
    "@en": "Describe a nose."
   }
  },
  "lonjong": {
   "es": "ovalado",
   "en": "ovalate",
   "pron": "LON-jong",
   "consejo": {
    "@es": "Describe una forma ovalada.",
    "@en": "Describe an oval form."
   }
  }
