    "@en": "In «hujan deras» it means intense rain."
   }
  },
  "berubah": {
   "es": "cambiar; volverse distinto",
   "en": "change; become different",
   "pron": "be-ru-BAH",
   "consejo": {
    "@es": "El prefijo no cambia con la persona.",
    "@en": "The prefix does not change with the person."
   }
  }
