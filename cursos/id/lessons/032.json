 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Hablar del clima",
    "@en": "Talk about the weather"
   },
   "texto": [
    {
     "@es": "**Musim hujan** es la estación lluviosa y **musim kemarau**, la seca. Los adjetivos no cambian por género ni número: **cuaca cerah**, **hari cerah**.",
     "@en": "**Musim hujan** is the rainy season and **musim kemarau** is the dry season. Adjectives do not change by gender or number: **cuaca cerah**, **hari cerah**."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Preguntar el motivo",
    "@en": "Ask the reason"
   },
   "texto": [
    {
     "@es": "**Mengapa?** significa «¿por qué?». Para contestar, **karena** equivale a «porque». Como en español, la razón puede ir al principio o al final de la oración.",
     "@en": "**Mengapa?** means «Why?». To answer, **karena** equals «because». As in Spanish, reason can go to the beginning or end of prayer."
    }
   ]
  },
