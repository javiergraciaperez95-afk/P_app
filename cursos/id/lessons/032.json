 "palabras": {
  "musim": {
   "es": "estación (del año)",
   "en": "(year)",
   "pron": "MU-sim",
   "consejo": {
    "@es": "Se refiere a una estación o temporada, no al «mismo».",
    "@en": "It refers to a season or season, not the «Same»."
   }
  },
  "kemarau": {
   "es": "estación seca",
   "en": "dry season",
   "pron": "ke-ma-RAU",
   "consejo": {
    "@es": "Suele nombrar la estación seca de Indonesia.",
    "@en": "It is usually named the dry station of Indonesia."
   }
  },
  "hujan": {
   "es": "lluvia; llover",
   "en": "rain; rain",
   "pron": "HU-jan",
   "consejo": {
    "@es": "Puede nombrar la lluvia o la acción de llover.",
    "@en": "You can name rain or rain action."
   }
  },
  "cuaca": {
   "es": "tiempo atmosférico",
   "en": "atmospheric time",
   "pron": "chu-A-cha",
   "consejo": {
    "@es": "Habla del tiempo, no del tiempo que marca el reloj.",
    "@en": "He's talking about time, not the time the clock sets."
   }
  },
  "mendung": {
   "es": "nublado",
   "en": "clouded",
   "pron": "men-DUNG",
   "consejo": {
    "@es": "Describe un cielo con nubes que pueden traer lluvia.",
    "@en": "It describes a sky with clouds that can bring rain."
   }
  },
  "cerah": {
   "es": "despejado; luminoso",
   "en": "clear; bright",
   "pron": "che-RAH",
   "consejo": {
    "@es": "Se usa para el cielo o el tiempo.",
    "@en": "It's used for heaven or time."
   }
  },
  "angin": {
   "es": "viento",
   "en": "wind",
   "pron": "A-ngin",
   "consejo": {
    "@es": "Aire que se mueve.",
    "@en": "Air moving."
   }
  },
  "payung": {
   "es": "paraguas",
   "en": "umbrella",
   "pron": "PA-yung",
   "consejo": {
    "@es": "Objeto para protegerse de la lluvia o el sol.",
    "@en": "Object to protect from rain or sun."
   }
  },
  "jas hujan": {
   "es": "impermeable; chubasquero",
   "en": "waterproof; cocksucker",
   "pron": "jas HU-jan",
   "consejo": {
    "@es": "Prenda para protegerse de la lluvia.",
    "@en": "Light to protect yourself from the rain."
   }
  },
  "basah": {
   "es": "mojado",
   "en": "wet",
   "pron": "BA-sah",
   "consejo": {
    "@es": "Describe algo que tiene agua.",
    "@en": "Describe something that has water."
   }
  },
  "kering": {
   "es": "seco",
   "en": "dry",
   "pron": "ke-RING",
   "consejo": {
    "@es": "Describe algo sin agua o humedad.",
    "@en": "Describe something without water or moisture."
   }
  },
  "banjir": {
   "es": "inundación",
   "en": "Flood",
   "pron": "BAN-jir",
   "consejo": {
    "@es": "Acumulación de agua que cubre una zona.",
    "@en": "Water accumulation that covers an area."
   }
  },
  "mengapa": {
   "es": "por qué",
   "en": "Why?",
   "pron": "meng-A-pa",
   "consejo": {
    "@es": "Pregunta por una causa o motivo.",
    "@en": "He asks for a cause or reason."
   }
  },
  "karena": {
   "es": "porque",
   "en": "because",
   "pron": "ka-RE-na",
   "consejo": {
    "@es": "Introduce la causa o el motivo.",
    "@en": "Enter the cause or the reason."
   }
  },
  "mungkin": {
   "es": "quizá; puede que",
   "en": "Maybe; maybe",
   "pron": "MUNG-kin",
   "consejo": {
    "@es": "Indica posibilidad.",
    "@en": "It indicates possibility."
   }
  },
  "deras": {
