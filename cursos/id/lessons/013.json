   "texto": [
    {
     "@es": "**Bangun** es despertarse, **mandi** es bañarse y **sarapan** es desayunar. Los verbos no cambian según la persona.",
     "@en": "**Bangun** is waking up, **mandi** is bathing and **sarapan** is breakfast. Verbs don't change according to the person."
