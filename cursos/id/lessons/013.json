   "texto": [
    {
     "@es": "**Sebelum** significa «antes de», **setelah**, «después de», y **lalu**, «luego». El orden de la frase puede variar.",
     "@en": "**Sebelum** means «before», **setelah**, «after», and **lalu**, «then». The order of the sentence may vary."
    }
   ]
  },
  {
   "tipo": "explicacion",
