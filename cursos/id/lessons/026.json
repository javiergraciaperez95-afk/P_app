{
 "capitulo": 3,
 "titulo_ind": "Memberi petunjuk arah",
 "titulo_es": {
  "@es": "Dar indicaciones",
  "@en": "Provide indications"
 },
 "palabras": {
  "belok": {
   "es": "girar; doblar",
   "en": "turn; fold",
   "pron": "be-LOK",
   "consejo": {
    "@es": "Se combina con «kiri» o «kanan» para dar una dirección.",
    "@en": "It is combined with «kiri» or «kanan» to give an address."
   }
  },
  "pertigaan": {
   "es": "cruce de tres caminos",
   "en": "three-way crossing",
   "pron": "per-ti-GA-an",
   "consejo": {
    "@es": "En este cruce se unen tres caminos.",
    "@en": "At this crossing there are three paths."
   }
  },
  "perempatan": {
   "es": "cruce de cuatro caminos",
   "en": "four-way crossing",
   "pron": "per-em-PA-tan",
   "consejo": {
    "@es": "En este cruce se unen cuatro caminos.",
    "@en": "At this crossing there are four paths."
   }
  },
  "persimpangan": {
   "es": "cruce; intersección",
   "en": "cross-section; intersection",
   "pron": "per-sim-PANG-an",
   "consejo": {
    "@es": "Lugar donde se cruzan o se ramifican caminos.",
    "@en": "Place where roads are crossed or ramified."
   }
  },
  "bundaran": {
   "es": "rotonda",
   "en": "rotunda",
   "pron": "bun-DA-ran",
   "consejo": {
    "@es": "Intersección circular.",
    "@en": "Circular intersection."
   }
  },
  "belokan": {
   "es": "curva; giro",
   "en": "curve; turn",
   "pron": "be-LO-kan",
   "consejo": {
    "@es": "Lugar donde un camino cambia de dirección.",
    "@en": "Place where a road changes direction."
   }
  },
  "jembatan": {
   "es": "puente",
   "en": "bridge",
   "pron": "jem-BA-tan",
   "consejo": {
    "@es": "Estructura que permite pasar sobre un río o una vía.",
    "@en": "Structure that allows to pass on a river or a track."
   }
  },
  "lampu merah": {
   "es": "semáforo",
   "en": "traffic light",
   "pron": "LAM-pu ME-rah",
   "consejo": {
    "@es": "Literalmente, «luz roja»; se refiere al semáforo.",
    "@en": "Literally, «red light»; refers to the light."
   }
  },
  "lewati": {
   "es": "pasa por; pasa de largo",
   "en": "passes by; passes by",
   "pron": "le-WA-ti",
   "consejo": {
    "@es": "Instrucción para continuar más allá de un lugar.",
    "@en": "Instruction to continue beyond a place."
   }
  },
  "terus": {
   "es": "sigue; continúa",
   "en": "continues;",
   "pron": "te-RUS",
   "consejo": {
    "@es": "En una ruta, indica que se continúa en la misma dirección.",
    "@en": "On a route, it indicates that it is continued in the same direction."
   }
  },
  "mengerti": {
   "es": "entender; comprender",
   "en": "understand; understand",
   "pron": "me-NGER-ti",
   "consejo": {
    "@es": "Se usa para decir que se ha entendido algo.",
    "@en": "It's used to say that you've understood something."
   }
  },
  "rute": {
   "es": "ruta; recorrido",
   "en": "route; route",
   "pron": "RU-te",
   "consejo": {
    "@es": "Camino que se sigue para llegar a un lugar.",
    "@en": "The way to get to a place."
   }
  },
  "menyeberang": {
   "es": "cruzar; atravesar",
   "en": "cross; cross",
   "pron": "me-nye-BE-rang",
   "consejo": {
    "@es": "Se usa, por ejemplo, para cruzar una calle.",
    "@en": "It is used, for example, to cross a street."
   }
  },
  "lurus terus": {
   "es": "sigue todo recto",
   "en": "follow everything straight.",
   "pron": "LU-rus te-RUS",
   "consejo": {
    "@es": "Instrucción para no girar y continuar recto.",
    "@en": "Instruction not to turn and continue straight."
   }
  }
 },
