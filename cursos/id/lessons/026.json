   "titulo": {
    "@es": "Seguir una ruta",
    "@en": "Follow a route"
   },
   "texto": [
    {
     "@es": "**Lurus terus** significa seguir recto. **Sampai** puede indicar hasta qué punto continuar; **lewati** pide pasar por un lugar.",
     "@en": "**Lurus terus** means straight ahead. **Sampai** may indicate the extent to which to continue; **lewati** asks to pass through a place."
    }
   ]
  },
