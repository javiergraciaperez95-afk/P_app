      "@es": "Eso cambiaría quién realiza la acción.",
      "@en": "That would change who does the action."
     }
    },
    {
     "texto": {
      "@es": "El gobierno otorga un premio a la sociedad.",
      "@en": "The government awards an award to society."
     },
     "explicacion": {
      "@es": "La oración no dice eso.",
      "@en": "Prayer doesn't say that."
     }
    }
   ]
