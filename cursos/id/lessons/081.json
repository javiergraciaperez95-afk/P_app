  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿En qué tipo de oración el sujeto realiza la acción?",
    "@en": "In what kind of prayer does the subject perform the action?"
   },
   "id": "id081-1",
   "opciones": [
    {
     "texto": "kalimat aktif",
     "explicacion": {
      "@es": "El sujeto es quien hace la acción.",
      "@en": "The subject is the one who does the action."
     },
     "correcta": true
    },
    {
     "texto": "kalimat pasif",
     "explicacion": {
      "@es": "En la pasiva, el foco se pone en quien recibe la acción.",
      "@en": "In the passive, the focus is placed on the one who receives the action."
     }
    },
    {
     "texto": "penghargaan",
     "explicacion": {
      "@es": "Es un reconocimiento, no un tipo de oración.",
      "@en": "It's a recognition, not a kind of prayer."
     }
    }
   ]
  },
  {
   "tipo": "traduccion",
