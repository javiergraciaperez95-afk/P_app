 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Voz activa y pasiva",
    "@en": "Active and passive voice"
   },
   "texto": [
    {
     "@es": "En una oración activa, el sujeto realiza la acción: **Masyarakat menghormati pahlawan**. En la pasiva, quien recibe la acción puede pasar al inicio: **Pahlawan dihormati oleh masyarakat**.",
     "@en": "In an active prayer, the subject performs the action: **Masyarakat menghormati pahlawan**. In the passive, who receives the action can move to the beginning: **Pahlawan dihormati oleh masyarakat**."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Los prefijos meng- y di-",
    "@en": "The meng- and di- prefixes"
   },
   "texto": [
    {
     "@es": "En muchos verbos, la forma activa usa **meng-** y la pasiva **di-**: **mendukung → didukung**. El significado básico se conserva, pero cambia el foco de la oración.",
     "@en": "In many verbs, the active form uses **meng-** and the passive **di-**: **mendukung → didukung**. The basic meaning is preserved, but changes the focus of prayer."
    }
   ]
  },
  {
   "tipo": "vocabulario",
   "titulo": {
    "@es": "Vocabulario: hablar de acciones y reconocimientos",
    "@en": "Vocabulary: talk about actions and recognitions"
   },
