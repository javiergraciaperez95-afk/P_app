 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Expresar buenos deseos",
    "@en": "Express good wishes"
   },
   "texto": [
    {
     "@es": "**Semoga** ya aparece en A2; **mudah-mudahan** también significa «ojalá». Ambas expresiones suelen ir al principio de una frase sobre algo que se desea.",
     "@en": "**Semoga** already appears in A2; **mudah-mudahan** also means «I wish.». Both expressions usually go to the beginning of a sentence about something that is desired."
    },
    {
     "@es": "**Berharap** es esperar o desear que algo ocurra; no requiere una forma verbal especial después.",
     "@en": "**Berharap** is to expect or wish something to happen; it does not require a special verbal form later."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Hablar de planes y objetivos",
    "@en": "Talk about plans and objectives"
   },
   "texto": [
    {
     "@es": "**Tercapai** significa que una meta se alcanza; **terwujud**, que un deseo se hace realidad; **terlaksana**, que un plan se lleva a cabo. No confundas los tres resultados.",
     "@en": "**Tercapai** means that a goal is achieved; **terwujud**, that a desire is made true; **terlaksana**, that a plan is carried out. Don't confuse the three results."
    }
   ]
  },
  {
   "tipo": "vocabulario",
