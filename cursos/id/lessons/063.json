  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué fórmula sirve para felicitar por una graduación?",
    "@en": "What formula does it serve to congratulate you on a graduation?"
   },
   "id": "id063-1",
   "opciones": [
    {
     "texto": "Selamat atas kelulusan!",
     "explicacion": {
      "@es": "Se usa «selamat atas» para felicitar por un acontecimiento.",
      "@en": "«selamat atas» is used to congratulate on an event."
     },
     "correcta": true
    },
    {
     "texto": "Terima kasih atas kelulusan!",
     "explicacion": {
      "@es": "«Terima kasih» da las gracias, no felicita.",
      "@en": "«Terima kasih» thanks, doesn't congratulate."
     }
    },
    {
     "texto": "Sampai jumpa setelah kelulusan!",
     "explicacion": {
      "@es": "Es una despedida.",
      "@en": "It's a farewell."
     }
    }
   ]
  },
  {
   "tipo": "traduccion",
