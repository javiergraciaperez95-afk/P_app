 "titulo_ind": "Bertanya tentang tempat",
 "titulo_es": {
  "@es": "Preguntar por lugares",
  "@en": "Ask for places"
 },
 "palabras": {
  "tempat": {
   "es": "lugar",
   "en": "place",
   "pron": "tem-PAT",
   "consejo": {
    "@es": "Puede ser un sitio concreto o un lugar en general.",
    "@en": "It can be a specific place or a place in general."
   }
  },
  "arah": {
   "es": "dirección; orientación",
   "en": "direction; guidance",
   "pron": "A-rah",
   "consejo": {
    "@es": "Se usa para preguntar o dar indicaciones.",
    "@en": "It is used to ask or give directions."
   }
  },
  "sini": {
   "es": "aquí; acá",
   "en": "Here; here; here",
   "pron": "SI-ni",
   "consejo": {
    "@es": "Señala un lugar cercano a quien habla.",
    "@en": "He points to a place close to the one he's talking to."
   }
  },
  "situ": {
   "es": "ahí; allí cerca",
   "en": "There; there near",
   "pron": "SI-tu",
   "consejo": {
    "@es": "Señala un lugar cercano o ya conocido.",
    "@en": "It points to a place close to or already known."
   }
  },
  "sana": {
   "es": "allí; allá",
   "en": "There; there",
   "pron": "SA-na",
   "consejo": {
    "@es": "Señala un lugar más lejano.",
    "@en": "It points to a far more distant place."
   }
  },
  "bertanya": {
   "es": "preguntar",
   "en": "ask",
   "pron": "ber-TA-nya",
   "consejo": {
    "@es": "Verbo para hacer una pregunta.",
    "@en": "I'm going to ask a question."
   }
  },
  "denah": {
   "es": "plano",
   "en": "flat",
   "pron": "DE-nah",
   "consejo": {
    "@es": "Dibujo sencillo de la distribución o ubicación de lugares.",
    "@en": "Simple drawing of the distribution or location of places."
   }
  },
  "peta": {
   "es": "mapa",
   "en": "map",
   "pron": "PE-ta",
   "consejo": {
    "@es": "Mapa de una zona o región.",
    "@en": "Map of an area or region."
   }
  },
  "lapangan": {
   "es": "campo; explanada",
   "en": "field; explanade",
   "pron": "la-PANG-an",
   "consejo": {
    "@es": "Espacio abierto, por ejemplo, un campo deportivo.",
    "@en": "Open space, for example, a sports field."
   }
  },
  "rumah sakit": {
   "es": "hospital",
   "en": "hospital",
   "pron": "RU-mah SA-kit",
   "consejo": {
    "@es": "Expresión de dos palabras para «hospital».",
    "@en": "Two-word expression for «hospital»."
   }
  },
  "kantor pos": {
   "es": "oficina de correos",
   "en": "post office",
   "pron": "KAN-tor POS",
   "consejo": {
    "@es": "Lugar donde se envían cartas y paquetes.",
    "@en": "Place where letters and packages are sent."
   }
  },
  "seberang": {
   "es": "lado opuesto; enfrente",
   "en": "opposite side; opposite side",
   "pron": "se-BE-rang",
   "consejo": {
    "@es": "Se usa para indicar que algo está al otro lado.",
    "@en": "It's used to indicate that something is on the other side."
   }
  },
  "mencari": {
   "es": "buscar",
   "en": "search",
   "pron": "men-CHA-ri",
   "consejo": {
    "@es": "Verbo para tratar de encontrar algo.",
    "@en": "I'm going to try to find something."
   }
  },
  "bagaimana cara ke": {
   "es": "cómo llegar a",
   "en": "how to get to",
   "pron": "ba-gai-MA-na CHA-ra ke",
   "consejo": {
    "@es": "Expresión para pedir indicaciones hacia un lugar.",
    "@en": "Expression to ask for directions to a place."
   }
  }
