  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué expresa «Ayo ikut!»?",
    "@en": "What does «Ayo ikut!» express?"
   },
   "id": "id039-1",
   "opciones": [
    {
     "texto": {
      "@es": "Una invitación o un ánimo para participar.",
      "@en": "An invitation or a spirit to participate."
     },
     "explicacion": {
      "@es": "«Ayo» anima y «ikut» es participar.",
      "@en": "«Ayo» encourages and «ikut» is to participate."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Una prohibición para participar.",
      "@en": "A ban on participation."
     },
     "explicacion": {
      "@es": "Las prohibiciones se expresan con «jangan», «tidak boleh» o «dilarang».",
      "@en": "The prohibitions are expressed with «jangan», «tidak boleh» or «dilarang»."
     }
    },
    {
     "texto": {
      "@es": "El final de una actividad.",
      "@en": "The end of an activity."
     },
     "explicacion": {
      "@es": "«Berakhir» significa terminar.",
      "@en": "«Berakhir» means finish."
     }
    }
   ]
  },
