   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Active and passive voice",
     "texto": [
      "In an active sentence, the subject performs the action: **Masyarakat menghormati pahlawan**. In the passive, the one who receives the action can move to the front: **Pahlawan dihormati oleh masyarakat**."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "The prefixes meng- and di-",
     "texto": [
      "In many verbs, the active form uses **meng-** and the passive **di-**: **mendukung → didukung**. The basic meaning stays the same, but the focus of the sentence changes."
     ],
     "tutora": ""
    }
   ]
  },
