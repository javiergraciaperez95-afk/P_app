   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Expressing an interpretation",
     "texto": [
      "To comment on a story, mention a specific part and explain what message you understand. **Masuk akal** means \"to make sense\" or \"to be reasonable\"."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Giving an opinion and a reason",
     "texto": [
      "You can say whether you agree and justify it: **Saya setuju karena ..** (\"I agree because ..\"). Distinguish your interpretation from the events the story tells."
     ],
     "tutora": ""
    }
   ]
  },
