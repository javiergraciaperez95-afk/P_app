 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Expressing good wishes",
     "texto": [
      "**Semoga** already appears at A2; **mudah-mudahan** also means \"hopefully\". Both usually come at the start of a sentence about something you wish for.",
      "**Berharap** means to hope or to wish that something happens; it doesn't need a special verb form after it."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Talking about plans and goals",
     "texto": [
      "**Tercapai** means that a goal is reached; **terwujud**, that a wish comes true; **terlaksana**, that a plan is carried out. Don't confuse the three results."
     ],
     "tutora": ""
    }
   ]
  },
