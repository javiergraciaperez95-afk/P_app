   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Reading the response",
     "texto": [
      "A response should indicate what has been checked, what measure will be taken and within what deadline. **Sehari** means \"one day\"; it is formed with **se-** and a unit of time."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Closing politely",
     "texto": [
      "Thank the sender for the response and keep the details of the case. If the solution doesn't arrive, you can politely ask for an update."
     ],
     "tutora": ""
    }
   ]
  },
