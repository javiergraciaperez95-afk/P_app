   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Comparing and exaggerating",
     "texto": [
      "A **perumpamaan** compares two elements; expressions such as **ibarat**, **laksana** and **seperti** can introduce a simile. A hyperbole deliberately exaggerates to intensify an image.",
      "In a formal description, explain what idea the comparison communicates; it is not necessary to interpret it literally."
     ],
     "tutora": ""
    }
   ]
  },
