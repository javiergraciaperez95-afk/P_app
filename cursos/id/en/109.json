   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Natural collocations",
     "texto": [
      "A **collocation** is a combination that sounds natural to speakers. For example, **festival perdana** means \"inaugural festival\" and **pemandangan alam** is \"natural landscape\".",
      "Don't translate each combination word by word: learn which words usually go together, as in English, where we say \"heavy rain\" and not \"strong rain\"."
     ],
     "tutora": ""
    }
   ]
