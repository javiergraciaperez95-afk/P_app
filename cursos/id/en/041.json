   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Trying on and choosing",
     "texto": [
      "**Kamar pas** means \"fitting room\". **Coba baju ini** means \"try this garment on\". Indonesian adjectives don't mark gender. Depending on the sentence, **cocok** can mean \"suitable\" or \"to fit well\"."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Describing a garment",
     "texto": [
      "To describe a garment, you can mention the fabric, the pattern, the size, the sleeves and the collar. Unlike English, nouns don't change between singular and plural."
     ],
     "tutora": ""
    }
   ]
