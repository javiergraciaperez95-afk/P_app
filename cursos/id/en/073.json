    {
     "tipo": "explicacion",
     "titulo": "Information per serving",
     "texto": [
      "On a label, **per sajian** indicates the amount \"per serving\". The total amount in the package may cover more than one serving."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Comparing data",
     "texto": [
      "**Bandingkan** means \"compare\". You can compare one figure with another, as long as they refer to the same amount of food."
     ],
     "tutora": ""
    }
   ]
