 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Comparar dos mundos",
     "texto": [
      "**So với** A, B… = comparado con A, B…: «**So với** thành phố, nông thôn yên tĩnh hơn nhiều».",
      "**A khác (với) B** = A es distinto de B: «Cuộc sống ở quê **khác với** ở thành phố». **A giống (như) B** = A se parece a B: «Làng tôi **giống như** một bức tranh».",
      "**A thì…, còn B thì…** = A…, mientras que B… Es la forma más natural de poner dos cosas frente a frente: «Ở thành phố **thì** tiện, **còn** ở quê **thì** yên».",
      "**Ưu điểm** (ventaja) y **nhược điểm** (inconveniente) son las dos palabras clave para ordenar una opinión: «Ưu điểm lớn nhất là…», «Nhược điểm là…»."
     ],
     "tutora": ""
    }
   ]
  },
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Bài đọc · Hai nơi, hai nhịp sống",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Tôi lớn lên ở một làng nhỏ, nhưng đã sống ở Hà Nội mười năm nay.",
       "alumno": "Me crié en un pueblo pequeño, pero llevo diez años viviendo en Hanói.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Tôi lớn lên ở một làng nhỏ",
         "crecí en un pueblo pequeño"
        ],
        [
         "đã sống ở Hà Nội mười năm nay",
         "llevo viviendo en Hanói estos diez años"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "So với nông thôn, cuộc sống ở thành thị tiện nghi hơn nhiều: bệnh viện, trường học và dịch vụ gì cũng có.",
       "alumno": "Comparada con el campo, la vida en la ciudad es mucho más cómoda: hay hospitales, colegios y todo tipo de servicios.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "So với nông thôn",
         "comparado con el campo"
        ],
        [
         "cuộc sống ở thành thị tiện nghi hơn nhiều",
         "la vida urbana es mucho más cómoda"
        ],
        [
         "dịch vụ gì cũng có",
         "hay cualquier servicio"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Ưu điểm lớn nhất của thành phố là có nhiều cơ hội việc làm và thu nhập cao hơn.",
       "alumno": "La mayor ventaja de la ciudad es que hay muchas oportunidades de trabajo y los ingresos son más altos.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Ưu điểm lớn nhất của thành phố",
         "la mayor ventaja de la ciudad"
        ],
        [
         "có nhiều cơ hội việc làm",
         "hay muchas oportunidades de empleo"
        ],
        [
         "thu nhập cao hơn",
         "ingresos más altos"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Tuy nhiên, nhược điểm cũng không ít: không khí ô nhiễm, đường phố đông đúc và ngày nào cũng tắc đường.",
       "alumno": "Sin embargo, los inconvenientes no son pocos: aire contaminado, calles abarrotadas y atascos a diario.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "nhược điểm cũng không ít",
         "los inconvenientes tampoco son pocos"
        ],
        [
         "không khí ô nhiễm",
         "aire contaminado"
        ],
        [
         "đường phố đông đúc",
         "calles abarrotadas"
        ],
        [
         "ngày nào cũng tắc đường",
         "atascos todos los días"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Nhịp sống ở đây rất vội vàng. Ai cũng bận, đến hàng xóm cũng ít khi nói chuyện với nhau.",
       "alumno": "Aquí el ritmo de vida es de prisas. Todo el mundo está ocupado; ni los vecinos hablan apenas entre ellos.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Nhịp sống ở đây rất vội vàng",
         "el ritmo de vida aquí es muy apresurado"
        ],
        [
         "đến hàng xóm cũng ít khi nói chuyện",
         "hasta los vecinos rara vez hablan"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Ở quê thì khác hẳn. Buổi sáng, tôi thức dậy vì tiếng gà chứ không phải tiếng xe máy.",
       "alumno": "En el pueblo es completamente distinto. Por la mañana me despierta el canto del gallo, no el ruido de las motos.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Ở quê thì khác hẳn",
         "en el pueblo es totalmente distinto"
        ],
        [
         "thức dậy vì tiếng gà",
         "me despierto por el canto del gallo"
        ],
        [
         "chứ không phải tiếng xe máy",
         "y no por el ruido de las motos"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Bố mẹ tôi vẫn trồng rau và nuôi gà. Cuộc sống của họ chậm rãi, giống như ngày xưa.",
       "alumno": "Mis padres siguen cultivando verduras y criando gallinas. Su vida es pausada, como antes.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "vẫn trồng rau và nuôi gà",
         "siguen cultivando verdura y criando gallinas"
        ],
        [
         "chậm rãi",
         "pausada"
        ],
        [
         "giống như ngày xưa",
         "igual que antiguamente"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Ở thành phố thì chi phí sinh hoạt cao, còn ở quê thì gần như cái gì cũng rẻ.",
       "alumno": "En la ciudad el coste de la vida es alto, mientras que en el pueblo casi todo es barato.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Ở thành phố thì chi phí sinh hoạt cao",
         "en la ciudad el coste de la vida es alto"
        ],
        [
         "còn ở quê thì",
         "mientras que en el pueblo"
        ],
        [
         "gần như cái gì cũng rẻ",
         "casi todo es barato"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Nhưng điều tôi nhớ nhất là tình làng nghĩa xóm: nhà nào có việc là cả làng đến giúp.",
       "alumno": "Pero lo que más echo de menos es el cariño entre vecinos: cuando una casa tiene un apuro, todo el pueblo acude a ayudar.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "điều tôi nhớ nhất",
         "lo que más echo de menos"
        ],
        [
         "nhà nào có việc là cả làng đến giúp",
         "cuando alguna casa tiene algo, todo el pueblo viene a ayudar"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Có lẽ khi về hưu tôi sẽ về quê. Còn bây giờ, tôi vẫn cần thành phố để làm việc.",
       "alumno": "Quizá cuando me jubile vuelva al pueblo. Por ahora, sigo necesitando la ciudad para trabajar.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "khi về hưu tôi sẽ về quê",
         "cuando me jubile volveré al pueblo"
        ],
        [
         "Còn bây giờ",
         "por ahora, en cambio"
        ],
        [
         "tôi vẫn cần thành phố để làm việc",
         "sigo necesitando la ciudad para trabajar"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
