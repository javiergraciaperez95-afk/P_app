       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Carlos",
        "lengua": "estudio"
       },
       "estudio": "Tại sao lại kiêng màu trắng?",
       "alumno": "¿Y por qué se evita el blanco?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Tại sao lại kiêng màu trắng",
         "por qué se evita el color blanco"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Hoa",
        "lengua": "estudio"
       },
       "estudio": "Vì màu trắng là màu tang. Cũng vì thế, anh không nên mặc toàn đồ trắng hoặc toàn đồ đen.",
       "alumno": "Porque el blanco es el color del luto. Por eso mismo no deberías ir todo de blanco ni todo de negro.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "màu trắng là màu tang",
         "el blanco es el color del luto"
