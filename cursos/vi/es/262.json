    {
     "tipo": "test",
     "id": "vb262-3",
     "pregunta": {
      "texto": "¿Qué busca en un texto argumentativo?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "La tesis, las razones, la postura contraria y la conclusión.",
       "lengua": "alumno",
       "explicacion": "Son las partes que ayudan a seguir el razonamiento.",
       "correcta": true
      },
      {
