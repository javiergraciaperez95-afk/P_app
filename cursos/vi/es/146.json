      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Anh thích nói chuyện với khách hàng. Vì vậy, anh không bao giờ thấy chán.",
       "alumno": "Le gusta hablar con los clientes. Por eso nunca se aburre.",
