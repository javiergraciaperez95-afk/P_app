     "titulo": "Hội thoại · Ở sân bay Đà Nẵng",
     "frases": [
      {
       "quien": {
        "texto": "Carlos",
        "lengua": "estudio"
       },
       "estudio": "Chị ơi, cho tôi hỏi, chuyến bay đi Sài Gòn lúc mười giờ làm thủ tục ở quầy nào ạ?",
       "alumno": "Perdone, una pregunta: ¿en qué mostrador se factura el vuelo de las diez a Saigón?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "cho tôi hỏi",
         "permítame preguntar"
        ],
        [
         "chuyến bay đi Sài Gòn lúc mười giờ",
         "el vuelo a Saigón de las diez"
        ],
        [
         "làm thủ tục ở quầy nào",
         "en qué mostrador se factura"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nhân viên",
        "lengua": "estudio"
       },
       "estudio": "Dạ, chuyến đó bị hoãn rồi anh ạ. Chúng tôi vừa thông báo thì anh đến.",
       "alumno": "Ese vuelo se ha retrasado, señor. Acabábamos de anunciarlo cuando ha llegado usted.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "chuyến đó bị hoãn rồi",
         "ese vuelo ya ha sido retrasado"
        ],
        [
         "Chúng tôi vừa thông báo",
         "acabábamos de anunciarlo"
        ],
        [
         "thì anh đến",
         "cuando usted llegó"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Carlos",
        "lengua": "estudio"
       },
       "estudio": "Hoãn đến mấy giờ? Lý do là gì vậy chị?",
       "alumno": "¿Hasta qué hora? ¿Y cuál es el motivo?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Hoãn đến mấy giờ",
         "retrasado hasta qué hora"
        ],
        [
         "Lý do là gì",
         "cuál es el motivo"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nhân viên",
        "lengua": "estudio"
       },
       "estudio": "Dạ, vì lý do kỹ thuật ạ. Máy bay đang chuẩn bị cất cánh từ Hà Nội thì phát hiện có lỗi. Giờ bay mới là hai giờ chiều.",
       "alumno": "Por motivos técnicos. El avión se estaba preparando para despegar de Hanói cuando detectaron un fallo. La nueva hora de salida es a las dos de la tarde.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "vì lý do kỹ thuật",
         "por motivos técnicos"
        ],
        [
         "đang chuẩn bị cất cánh từ Hà Nội",
         "estaba preparándose para despegar de Hanói"
        ],
        [
         "thì phát hiện có lỗi",
         "cuando detectaron que había un fallo"
        ],
        [
         "Giờ bay mới",
         "la nueva hora de vuelo"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Carlos",
        "lengua": "estudio"
       },
       "estudio": "Hai giờ chiều à? Thế thì tôi lỡ chuyến nối đi Phú Quốc mất!",
       "alumno": "¿A las dos? ¡Pues entonces pierdo el enlace a Phú Quốc!",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Thế thì",
         "entonces"
        ],
        [
         "tôi lỡ chuyến nối đi Phú Quốc",
         "pierdo el vuelo de enlace a Phú Quốc"
