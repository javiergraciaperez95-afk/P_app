       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nhân viên",
        "lengua": "estudio"
       },
       "estudio": "Anh đừng lo. Trong khi anh chờ, tôi sẽ đổi vé chuyến nối cho anh, không mất thêm tiền.",
       "alumno": "No se preocupe. Mientras espera, le cambio el billete del enlace sin coste adicional.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Trong khi anh chờ",
