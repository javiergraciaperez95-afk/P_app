     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Tháng trước mình chuyển đến một khu phố mới ở Huế vì công ty đổi văn phòng.",
       "alumno": "El mes pasado me mudé a un barrio nuevo de Huế porque la empresa cambió de oficina.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Ban đầu mình hơi lo vì chưa quen đường và không biết hàng xóm.",
       "alumno": "Al principio estaba algo preocupado porque no conocía las calles ni a los vecinos.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Một cô hàng xóm chỉ cho mình chợ gần nhất, còn đồng nghiệp rủ mình đi ăn trưa.",
       "alumno": "Una vecina me indicó el mercado más cercano y un compañero me invitó a comer.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Dần dần mình thấy cuộc sống ở đây dễ chịu hơn; đi làm cũng chỉ mất mười lăm phút.",
       "alumno": "Poco a poco la vida aquí me resulta más agradable; además, tardo solo quince minutos en llegar al trabajo.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Cuối tháng này bạn đến chơi nhé, mình sẽ dẫn bạn đi quanh khu phố.",
       "alumno": "Ven a visitarme a final de mes; te enseñaré el barrio.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
