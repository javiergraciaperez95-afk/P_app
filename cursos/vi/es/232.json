     "titulo": "Bài đọc · Ít trẻ con hơn, nhiều người già hơn",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Việt Nam vẫn được coi là một nước trẻ, nhưng dân số đang già đi nhanh hơn nhiều người nghĩ.",
       "alumno": "Vietnam sigue considerándose un país joven, pero su población envejece más deprisa de lo que muchos creen.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
