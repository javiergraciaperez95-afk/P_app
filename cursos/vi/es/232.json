       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Tuổi thọ trung bình ngày càng cao, trong khi tỷ lệ sinh ở các thành phố lớn ngày càng thấp.",
       "alumno": "La esperanza de vida es cada vez mayor, mientras que la natalidad en las grandes ciudades es cada vez más baja.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Tuổi thọ trung bình ngày càng cao",
         "la esperanza de vida media es cada vez más alta"
        ],
        [
         "tỷ lệ sinh ở các thành phố lớn ngày càng thấp",
         "la natalidad en las grandes ciudades es cada vez más baja"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Ở Thành phố Hồ Chí Minh, mỗi phụ nữ trung bình chỉ sinh khoảng một con rưỡi, thấp nhất cả nước.",
       "alumno": "En Ciudad Ho Chi Minh, cada mujer tiene de media en torno a un hijo y medio, la cifra más baja del país.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "mỗi phụ nữ trung bình chỉ sinh khoảng một con rưỡi",
