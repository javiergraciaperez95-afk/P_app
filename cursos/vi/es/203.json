     "titulo": "Bài đọc · Thông báo đổi sách",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Cuối tháng này, nhà văn hóa quận tổ chức ngày đổi sách.",
       "alumno": "A finales de este mes, el centro cultural del distrito organiza una jornada de intercambio de libros.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Mỗi người có thể mang tối đa năm cuốn sách đã đọc để đổi lấy sách khác.",
       "alumno": "Cada persona puede traer como máximo cinco libros ya leídos para cambiarlos por otros.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Sách phải còn nguyên vẹn; ban tổ chức không nhận sách thiếu trang.",
       "alumno": "Los libros deben estar en buen estado; la organización no acepta libros a los que les falten páginas.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Chương trình bắt đầu lúc tám giờ sáng và kết thúc lúc bốn giờ chiều.",
       "alumno": "La actividad empieza a las ocho de la mañana y termina a las cuatro de la tarde.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Nếu trời mưa, hoạt động sẽ chuyển vào hội trường.",
       "alumno": "Si llueve, la actividad se trasladará al salón de actos.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Khu vực có ít chỗ đỗ xe, vì vậy ban tổ chức khuyên mọi người đi xe buýt.",
       "alumno": "La zona tiene pocas plazas de aparcamiento, así que la organización recomienda ir en autobús.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
