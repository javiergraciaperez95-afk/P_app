         "Về tuổi thơ ở một làng quê",
         "sobre la infancia en un pueblo"
        ],
        [
         "Nghe nói",
         "dicen que"
        ],
        [
         "đã được dịch ra tiếng Anh và tiếng Nhật",
         "ya ha sido traducido al inglés y al japonés"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Carlos",
        "lengua": "estudio"
       },
       "estudio": "Theo báo chí thì cuốn nào của ông ấy cũng bán chạy, phải không chị?",
