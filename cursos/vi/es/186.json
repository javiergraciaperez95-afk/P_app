       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Theo báo chí",
         "según la prensa"
        ],
        [
         "cuốn nào của ông ấy cũng bán chạy",
         "todos sus libros se venden mucho"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Chị Lan",
        "lengua": "estudio"
       },
       "estudio": "Ừ. Chị mới đọc đến chương năm mà đã thấy gây nghiện rồi. Đêm qua chị đọc đến hai giờ sáng.",
       "alumno": "Sí. Solo voy por el capítulo cinco y ya me tiene enganchada. Anoche estuve leyendo hasta las dos.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
