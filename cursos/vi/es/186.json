     "frases": [
      {
       "quien": {
        "texto": "Carlos",
        "lengua": "estudio"
       },
       "estudio": "Chị Lan đang đọc gì mà chăm chú thế?",
       "alumno": "¿Qué estás leyendo tan concentrada, Lan?",
       "literal": "",
       "estructura": "",
       "nota": [],
