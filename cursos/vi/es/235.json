   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Bài đọc · Một buổi chiều ở Hội An",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Hội An là một thành phố nho nhỏ nằm bên sông Thu Bồn, ở miền Trung Việt Nam.",
       "alumno": "Hội An es una ciudad pequeñita situada junto al río Thu Bồn, en el centro de Vietnam.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "một thành phố nho nhỏ",
         "una ciudad pequeñita"
        ],
        [
         "nằm bên sông Thu Bồn",
         "situada junto al río Thu Bồn"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Từ thế kỷ mười sáu đến thế kỷ mười tám, đây là một thương cảng nhộn nhịp, nơi thương nhân Nhật Bản, Trung Hoa và châu Âu đến buôn bán.",
       "alumno": "Entre los siglos XVI y XVIII fue un puerto comercial bullicioso, adonde acudían a comerciar mercaderes japoneses, chinos y europeos.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "đây là một thương cảng nhộn nhịp",
         "esto era un puerto comercial bullicioso"
        ],
        [
         "đến buôn bán",
         "venían a comerciar"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Vì thế, kiến trúc ở đây là sự kết hợp của nhiều nền văn hóa: nhà gỗ Việt, hội quán Trung Hoa và một cây cầu do người Nhật xây.",
       "alumno": "Por eso su arquitectura es una mezcla de varias culturas: casas vietnamitas de madera, casas de asamblea chinas y un puente construido por japoneses.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "kiến trúc ở đây là sự kết hợp của nhiều nền văn hóa",
         "la arquitectura de aquí es la combinación de muchas culturas"
        ],
        [
         "một cây cầu do người Nhật xây",
         "un puente construido por japoneses"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Khi con sông cạn dần, tàu lớn không vào được nữa và Hội An lặng lẽ bị lãng quên.",
       "alumno": "Cuando el río fue perdiendo profundidad, los grandes barcos ya no pudieron entrar y Hội An cayó calladamente en el olvido.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Khi con sông cạn dần",
         "cuando el río fue quedándose sin fondo"
        ],
        [
         "tàu lớn không vào được nữa",
         "los barcos grandes ya no podían entrar"
        ],
        [
         "Hội An lặng lẽ bị lãng quên",
         "Hội An fue olvidada en silencio"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Nhưng chính nhờ bị lãng quên mà phố cổ được bảo tồn gần như nguyên vẹn.",
       "alumno": "Pero precisamente gracias a ese olvido, el casco antiguo se conservó casi intacto.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "chính nhờ bị lãng quên",
         "precisamente gracias a ser olvidada"
        ],
        [
         "mà phố cổ được bảo tồn gần như nguyên vẹn",
         "el casco antiguo se conservó casi intacto"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Năm 1999, Hội An được công nhận là Di sản Văn hóa Thế giới.",
       "alumno": "En 1999, Hội An fue reconocida como Patrimonio de la Humanidad.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "được công nhận là",
         "fue reconocida como"
        ],
        [
         "Di sản Văn hóa Thế giới",
         "Patrimonio Cultural de la Humanidad"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Buổi chiều, tôi thong thả đi bộ qua những con phố với tường vàng và mái ngói phủ rêu xanh xanh.",
       "alumno": "Por la tarde paseé sin prisa por las calles de paredes amarillas y tejados cubiertos de un musgo verdoso.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "tôi thong thả đi bộ",
         "paseé sin prisa"
        ],
        [
         "tường vàng",
         "paredes amarillas"
        ],
        [
         "mái ngói phủ rêu xanh xanh",
         "tejados cubiertos de musgo verdoso"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Gió từ sông thổi nhè nhẹ. Một bà cụ chầm chậm đẩy xe bán chè, mỉm cười với du khách.",
       "alumno": "Del río soplaba una brisa suavecita. Una anciana empujaba despacito su carrito de dulces y sonreía a los visitantes.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Gió từ sông thổi nhè nhẹ",
         "el viento del río sopla suavecito"
        ],
        [
         "chầm chậm đẩy xe bán chè",
         "empuja despacito el carrito de dulces"
        ],
        [
         "mỉm cười với du khách",
         "sonríe a los turistas"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Khi trời tối, hàng nghìn chiếc đèn lồng được thắp lên, cả phố cổ lung linh như trong truyện cổ tích.",
       "alumno": "Al anochecer se encienden miles de farolillos y todo el casco antiguo centellea como en un cuento.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "hàng nghìn chiếc đèn lồng được thắp lên",
         "se encienden miles de farolillos"
        ],
        [
         "cả phố cổ lung linh",
         "todo el casco antiguo centellea"
        ],
        [
         "như trong truyện cổ tích",
         "como en un cuento de hadas"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Ngày nay, mỗi năm có hàng triệu du khách đến đây. Câu hỏi là làm sao phát triển du lịch mà vẫn giữ được cái hồn của phố cổ.",
       "alumno": "Hoy llegan cada año millones de visitantes. La pregunta es cómo desarrollar el turismo sin perder el alma del casco antiguo.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "mỗi năm có hàng triệu du khách đến đây",
         "cada año vienen millones de turistas"
        ],
        [
         "làm sao phát triển du lịch",
         "cómo desarrollar el turismo"
        ],
        [
         "mà vẫn giữ được cái hồn của phố cổ",
         "y aun así conservar el alma del casco antiguo"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
   ]
