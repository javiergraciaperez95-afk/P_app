        "lengua": "alumno"
       },
       "estudio": "Công ty sẽ bảo trì đường ống ở phường Minh Khai vào thứ Năm, từ 8 đến 12 giờ.",
       "alumno": "La compañía realizará mantenimiento de tuberías en el barrio Minh Khai el jueves, de 8:00 a 12:00.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Trong thời gian đó, một số tòa nhà có thể bị ngắt nước.",
       "alumno": "Durante ese periodo, algunos edificios podrían quedarse sin agua.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Người dân nên dự trữ đủ nước sinh hoạt trước 8 giờ sáng.",
       "alumno": "Se recomienda a los residentes almacenar suficiente agua antes de las 8:00.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Nếu công việc hoàn thành sớm, dịch vụ sẽ được khôi phục ngay.",
       "alumno": "Si el trabajo termina antes, el servicio se restablecerá de inmediato.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Trường hợp sau 12 giờ vẫn chưa có nước, vui lòng liên hệ số hỗ trợ 1900 1234.",
       "alumno": "Si después de las 12:00 aún no hay agua, llame al número de asistencia 1900 1234.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
