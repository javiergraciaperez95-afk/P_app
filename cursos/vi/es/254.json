  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Bài đọc · Tám câu nên biết",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "«Có công mài sắt, có ngày nên kim.» Ai kiên trì mài một thanh sắt thì sẽ có ngày nó thành cây kim. Câu này khuyên ta đừng bỏ cuộc.",
       "alumno": "«Quien se afana en limar el hierro, un día tendrá una aguja». Quien lima con constancia una barra de hierro acabará viéndola convertida en aguja. Aconseja no rendirse.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Có công mài sắt",
         "si te esfuerzas en limar el hierro"
        ],
        [
         "có ngày nên kim",
         "llegará el día en que se haga aguja"
        ],
        [
         "Câu này khuyên ta đừng bỏ cuộc",
         "esta frase nos aconseja no rendirnos"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "«Vạn sự khởi đầu nan.» Việc gì cũng khó lúc bắt đầu. Người ta nói câu này để động viên người mới học, mới làm.",
       "alumno": "«Todo comienzo es difícil». Cualquier cosa cuesta al principio. Se dice para animar a quien empieza a estudiar o a trabajar.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Vạn sự khởi đầu nan",
         "todas las cosas son difíciles al empezar"
        ],
        [
         "Việc gì cũng khó lúc bắt đầu",
         "cualquier asunto es difícil al comenzar"
        ],
        [
         "để động viên người mới học, mới làm",
         "para animar al que acaba de empezar"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "«Đi một ngày đàng, học một sàng khôn.» Đi xa một ngày là học được rất nhiều điều. Câu này nói về giá trị của việc đi đây đi đó.",
       "alumno": "«Un día de camino, un cedazo de sabiduría». Un día de viaje enseña muchísimas cosas. Habla del valor de ver mundo.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Đi một ngày đàng",
         "andar un día de camino"
        ],
        [
         "học một sàng khôn",
         "aprender un cedazo de sabiduría"
        ],
        [
         "giá trị của việc đi đây đi đó",
         "el valor de ir de un lado a otro"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "«Gần mực thì đen, gần đèn thì sáng.» Ở gần người xấu thì dễ thành xấu, ở gần người tốt thì tốt lên. Cha mẹ hay nói câu này khi con chọn bạn.",
       "alumno": "«Cerca de la tinta, negro; cerca de la lámpara, luminoso». Junto a gente mala es fácil volverse malo; junto a gente buena, uno mejora. Los padres lo dicen mucho cuando los hijos eligen amigos.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Gần mực thì đen",
         "cerca de la tinta te vuelves negro"
        ],
        [
         "gần đèn thì sáng",
         "cerca de la lámpara, luminoso"
        ],
        [
         "Cha mẹ hay nói câu này khi con chọn bạn",
         "los padres lo dicen cuando el hijo elige amigos"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "«Uống nước nhớ nguồn.» Khi uống nước, hãy nhớ đến nơi nước chảy ra. Nghĩa là phải biết ơn tổ tiên và những người đã giúp mình.",
       "alumno": "«Al beber agua, acuérdate de la fuente». Cuando bebas, recuerda de dónde mana el agua. Es decir: hay que ser agradecido con los antepasados y con quienes nos ayudaron.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Uống nước nhớ nguồn",
         "al beber agua, recuerda la fuente"
        ],
        [
         "nơi nước chảy ra",
         "el lugar de donde mana el agua"
        ],
        [
         "phải biết ơn tổ tiên",
         "hay que agradecer a los antepasados"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "«Lá lành đùm lá rách.» Chiếc lá còn lành bọc lấy chiếc lá đã rách: người có điều kiện giúp người gặp khó khăn. Câu này thường thấy trên báo sau mỗi mùa bão lũ.",
       "alumno": "«La hoja sana envuelve a la hoja rota». La hoja entera arropa a la que está rasgada: quien puede ayuda a quien lo pasa mal. Se lee mucho en la prensa después de cada temporada de tifones.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Chiếc lá còn lành bọc lấy chiếc lá đã rách",
         "la hoja aún sana envuelve a la ya rota"
        ],
        [
         "người có điều kiện giúp người gặp khó khăn",
         "quien tiene medios ayuda a quien tiene dificultades"
        ],
        [
         "sau mỗi mùa bão lũ",
         "tras cada temporada de tifones y riadas"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "«Tốt gỗ hơn tốt nước sơn.» Gỗ tốt quan trọng hơn lớp sơn đẹp: tính cách quý hơn vẻ ngoài.",
       "alumno": "«Mejor buena madera que buena pintura». Importa más la buena madera que la capa bonita: el carácter vale más que la apariencia.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Tốt gỗ hơn tốt nước sơn",
         "mejor madera buena que pintura buena"
        ],
        [
         "tính cách quý hơn vẻ ngoài",
         "el carácter vale más que la apariencia"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "«Nước đến chân mới nhảy.» Chờ nước lên đến chân rồi mới nhảy: để đến phút cuối mới làm. Sinh viên trước ngày thi hiểu câu này hơn ai hết!",
       "alumno": "«No salta hasta que el agua le llega a los pies». Esperar a tener el agua en los pies para saltar: dejarlo todo para el último minuto. ¡Los estudiantes, la víspera del examen, la entienden mejor que nadie!",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Chờ nước lên đến chân rồi mới nhảy",
         "esperar a que el agua suba hasta los pies para saltar"
        ],
        [
         "để đến phút cuối mới làm",
         "dejarlo para el último minuto"
        ],
        [
         "hiểu câu này hơn ai hết",
         "lo entienden mejor que nadie"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
