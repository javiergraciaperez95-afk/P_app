 "etapas": [
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Bài đọc · Một năm nhìn lại",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Sở dĩ tôi đến Việt Nam là vì công việc, nhưng tôi ở lại là vì con người ở đây.",
       "alumno": "Si vine a Vietnam fue por trabajo, pero si me quedé fue por su gente.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Sở dĩ tôi đến Việt Nam là vì công việc",
         "si vine a Vietnam fue por el trabajo"
        ],
        [
         "tôi ở lại là vì con người ở đây",
         "me quedé por la gente de aquí"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Lúc đầu tôi rất bỡ ngỡ: ngay cả việc qua đường cũng làm tôi sợ.",
       "alumno": "Al principio estaba muy perdido: hasta cruzar la calle me daba miedo.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Lúc đầu tôi rất bỡ ngỡ",
         "al principio estaba muy desorientado"
        ],
        [
         "ngay cả việc qua đường cũng làm tôi sợ",
         "incluso cruzar la calle me asustaba"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Tuy học tiếng Việt mỗi ngày nhưng ba tháng đầu tôi chẳng hiểu ai nói gì cả.",
       "alumno": "Aunque estudiaba vietnamita todos los días, los tres primeros meses no entendía nada de lo que decía nadie.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Tuy học tiếng Việt mỗi ngày",
         "aunque estudiaba vietnamita cada día"
        ],
        [
         "nhưng ba tháng đầu",
         "(pero) los tres primeros meses"
        ],
        [
         "tôi chẳng hiểu ai nói gì cả",
         "no entendía nada de lo que decía nadie"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Tôi ngại nói đến nỗi đi chợ chỉ dám chỉ tay vào thứ mình muốn mua.",
       "alumno": "Me daba tanto corte hablar que en el mercado solo me atrevía a señalar con el dedo lo que quería.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Tôi ngại nói đến nỗi",
         "me daba tanto apuro hablar que"
        ],
        [
         "đi chợ chỉ dám chỉ tay",
         "en el mercado solo me atrevía a señalar"
        ],
        [
         "vào thứ mình muốn mua",
         "lo que quería comprar"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Nhờ hàng xóm và đồng nghiệp kiên nhẫn nên dần dần tôi tự tin hơn.",
       "alumno": "Gracias a la paciencia de los vecinos y los compañeros, poco a poco gané confianza.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Nhờ hàng xóm và đồng nghiệp kiên nhẫn",
         "gracias a que vecinos y compañeros tuvieron paciencia"
        ],
        [
         "nên dần dần tôi tự tin hơn",
         "por eso poco a poco tuve más confianza"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Càng nói nhiều, tôi càng ít sợ mắc lỗi. Hóa ra người Việt rất vui khi thấy người nước ngoài cố gắng nói tiếng của họ.",
       "alumno": "Cuanto más hablaba, menos miedo tenía a equivocarme. Resulta que a los vietnamitas les alegra mucho ver a un extranjero esforzarse en hablar su lengua.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Càng nói nhiều, tôi càng ít sợ mắc lỗi",
         "cuanto más hablaba, menos temía equivocarme"
        ],
        [
         "Hóa ra",
         "resulta que"
        ],
        [
         "người Việt rất vui khi thấy người nước ngoài cố gắng",
         "los vietnamitas se alegran mucho al ver a un extranjero esforzarse"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Tôi không những học được một ngôn ngữ mà còn hiểu thêm một nền văn hóa.",
       "alumno": "No solo he aprendido una lengua, sino que además he llegado a entender una cultura.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "không những học được một ngôn ngữ",
         "no solo he aprendido una lengua"
        ],
        [
         "mà còn hiểu thêm một nền văn hóa",
         "sino que además entiendo mejor una cultura"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Giá mà ngày đầu tiên có ai nói với tôi rằng mọi chuyện sẽ ổn thì tôi đã đỡ lo biết bao.",
       "alumno": "Si el primer día alguien me hubiera dicho que todo iba a salir bien, ¡cuánto me habría ahorrado de preocupación!",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Giá mà ngày đầu tiên có ai nói với tôi",
         "si el primer día alguien me hubiera dicho"
        ],
        [
         "rằng mọi chuyện sẽ ổn",
         "que todo iría bien"
        ],
        [
         "thì tôi đã đỡ lo biết bao",
         "cuánto menos me habría preocupado"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Bây giờ, hễ đi xa vài ngày là tôi lại nhớ phở và tiếng xe máy. Không ngờ mình lại gắn bó với nơi này đến thế.",
       "alumno": "Ahora, en cuanto paso unos días fuera, echo de menos el phở y el ruido de las motos. No me imaginaba que llegaría a tenerle tanto apego a este sitio.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "hễ đi xa vài ngày là tôi lại nhớ",
         "siempre que me voy unos días, echo de menos"
        ],
        [
         "Không ngờ mình lại gắn bó với nơi này đến thế",
         "no esperaba tenerle tanto apego a este lugar"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Tôi mong rằng một năm nữa, khi đọc lại những dòng này, tiếng Việt của tôi đã ở trình độ B2.",
       "alumno": "Espero que dentro de un año, cuando relea estas líneas, mi vietnamita ya esté en el nivel B2.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Tôi mong rằng",
         "espero que"
        ],
        [
         "khi đọc lại những dòng này",
         "cuando relea estas líneas"
        ],
        [
         "tiếng Việt của tôi đã ở trình độ B2",
         "mi vietnamita ya esté en el nivel B2"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
   ]
