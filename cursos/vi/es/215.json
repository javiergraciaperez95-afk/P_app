       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Minh",
        "lengua": "estudio"
       },
       "estudio": "Nhưng dữ liệu thì ngày càng nhiều mà.",
       "alumno": "Pero es que datos hay cada vez más.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
