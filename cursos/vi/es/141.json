     "tipo": "dialogo",
     "titulo": "Hội thoại · La enciclopedia",
     "frases": [
      {
       "quien": {
        "texto": "Nam",
        "lengua": "estudio"
       },
       "estudio": "Anh đọc sách gì mà hay thế?",
       "alumno": "¿Qué lees que te tiene tan enganchado?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Anh",
         "sujeto"
        ],
        [
         "đọc sách gì",
         "qué libro lees"
        ],
        [
         "mà hay thế",
         "que es tan interesante"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Peter",
        "lengua": "estudio"
       },
       "estudio": "Hiệu sách vừa mới nhận được quyển Từ điển bách khoa Việt Nam. Tôi sắp đi Việt Nam nên tôi mua để đọc thêm về đất nước và con người Việt Nam.",
       "alumno": "A la librería acaba de llegar la Enciclopedia de Vietnam. Me voy pronto a Vietnam, así que la he comprado para saber más sobre el país y su gente.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Hiệu sách",
         "sujeto (la librería)"
        ],
        [
         "vừa mới nhận được",
         "acaba de recibir"
        ],
        [
