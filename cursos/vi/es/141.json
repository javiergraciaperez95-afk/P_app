         "la Enciclopedia de Vietnam"
        ],
        [
         "Tôi sắp đi Việt Nam",
         "voy a ir pronto a Vietnam"
        ],
        [
         "nên",
         "por eso"
        ],
        [
         "tôi mua để đọc thêm",
         "la compré para leer más"
        ],
        [
         "về đất nước và con người Việt Nam",
         "sobre el país y la gente"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Peter",
        "lengua": "estudio"
       },
       "estudio": "Càng biết nhiều về lịch sử, địa lý và văn hóa Việt Nam thì chuyến đi của tôi sẽ càng thú vị. Ví dụ, anh có biết núi nào cao nhất ở Việt Nam không?",
       "alumno": "Cuanto más sepa de la historia, la geografía y la cultura, más interesante será el viaje. Por ejemplo, ¿sabes cuál es la montaña más alta de Vietnam?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "về lịch sử, địa lý và văn hóa Việt Nam",
         "sobre la historia, geografía y cultura"
        ],
        [
         "chuyến đi của tôi",
         "mi viaje"
        ],
        [
         "Ví dụ",
         "por ejemplo"
        ],
        [
         "núi nào cao nhất ở Việt Nam",
         "qué montaña es la más alta de Vietnam"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nam",
        "lengua": "estudio"
       },
       "estudio": "Ồ, xin lỗi, địa lý không phải là môn học hấp dẫn đối với tôi.",
       "alumno": "Uy, lo siento, la geografía no es lo mío.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Ồ",
         "uy"
        ],
        [
         "xin lỗi",
         "lo siento"
        ],
        [
         "địa lý",
         "sujeto (la geografía)"
        ],
        [
         "không phải là",
         "no es"
        ],
        [
         "môn học hấp dẫn",
         "una asignatura interesante"
        ],
        [
         "đối với tôi",
         "para mí"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Peter",
        "lengua": "estudio"
       },
       "estudio": "Đó là núi Fansipan, cao khoảng ba nghìn một trăm bốn mươi bảy mét. Một câu hỏi nữa: ở Việt Nam có bao nhiêu dân tộc?",
       "alumno": "Es el Fansipan, de unos 3.147 metros. Otra pregunta: ¿cuántos pueblos o etnias hay en Vietnam?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Đó là núi Fansipan",
