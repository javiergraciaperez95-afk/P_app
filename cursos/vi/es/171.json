     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Muốn sống lành mạnh, bạn không cần phải thay đổi tất cả cùng một lúc. Hãy bắt đầu từ những thói quen nhỏ.",
       "alumno": "Para llevar una vida sana no hace falta cambiarlo todo de golpe. Empieza por los hábitos pequeños.",
