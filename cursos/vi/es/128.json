     "tipo": "dialogo",
     "titulo": "Hội thoại 1 · ¿Cuándo ir a Vietnam?",
     "frases": [
      {
       "quien": {
        "texto": "Richard",
        "lengua": "estudio"
       },
       "estudio": "Anh Nam, mùa nào đẹp nhất để đi thăm Việt Nam?",
       "alumno": "Nam, ¿cuál es la mejor época para visitar Vietnam?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Anh Nam",
         "vocativo"
        ],
        [
         "mùa nào",
         "qué estación"
        ],
        [
         "đẹp nhất",
         "la mejor"
        ],
        [
         "để đi thăm Việt Nam",
         "para visitar Vietnam"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nam",
        "lengua": "estudio"
       },
       "estudio": "Rất khó nói. Mình thích mùa thu nhất.",
       "alumno": "Es difícil decirlo. A mí me gusta más el otoño.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Rất khó nói",
         "es difícil decirlo"
        ],
        [
         "Mình",
         "sujeto (yo, entre amigos)"
        ],
        [
         "thích mùa thu nhất",
         "me gusta más el otoño"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nam",
        "lengua": "estudio"
       },
       "estudio": "Mùa thu ở Việt Nam rất đẹp: thời tiết không những đẹp mà còn dễ chịu nữa.",
       "alumno": "El otoño en Vietnam es precioso: el tiempo no solo es bueno, sino también agradable.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Mùa thu ở Việt Nam",
         "sujeto"
        ],
        [
         "rất đẹp",
         "muy bonito"
        ],
        [
         "thời tiết",
         "sujeto"
        ],
        [
         "không những đẹp mà còn dễ chịu nữa",
         "no solo bueno sino también agradable"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "David",
        "lengua": "estudio"
       },
       "estudio": "Tôi đồng ý. Mùa thu trời mát, hơn nữa ít khi có mưa! Nhưng tôi ghét mùa đông: trời không những lạnh mà còn ẩm nữa!",
       "alumno": "Estoy de acuerdo. En otoño hace fresco y además casi no llueve. ¡Pero odio el invierno: no solo hace frío, sino que también hay mucha humedad!",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Tôi đồng ý",
         "estoy de acuerdo"
        ],
        [
         "Mùa thu trời mát",
         "en otoño hace fresco"
        ],
        [
         "hơn nữa",
         "además"
        ],
        [
         "ít khi có mưa",
         "casi no llueve"
        ],
        [
         "Nhưng",
         "pero"
        ],
        [
         "tôi ghét mùa đông",
         "odio el invierno"
        ],
        [
         "trời không những lạnh mà còn ẩm nữa",
         "no solo frío sino también húmedo"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nam",
        "lengua": "estudio"
       },
       "estudio": "Đúng thế, nhiệt độ trung bình vào mùa đông chỉ khoảng mười một độ.",
       "alumno": "Así es: la temperatura media en invierno es de solo unos once grados.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Đúng thế",
         "así es"
        ],
        [
         "nhiệt độ trung bình",
         "sujeto (la temperatura media)"
        ],
        [
         "vào mùa đông",
         "en invierno"
        ],
        [
         "chỉ khoảng mười một độ",
         "solo unos once grados"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Richard",
        "lengua": "estudio"
       },
       "estudio": "Tôi nghĩ rằng ở Việt Nam không có mùa đông.",
       "alumno": "Creía que en Vietnam no había invierno.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Tôi",
         "sujeto"
        ],
        [
         "nghĩ rằng",
         "pensaba que"
        ],
        [
         "ở Việt Nam",
         "en Vietnam"
        ],
        [
         "không có mùa đông",
         "no hay invierno"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nam",
        "lengua": "estudio"
       },
       "estudio": "Có chứ! Miền Bắc Việt Nam có bốn mùa như châu Âu. Miền Nam chỉ có hai mùa: mùa mưa và mùa khô.",
       "alumno": "¡Claro que sí! El norte tiene cuatro estaciones, como Europa. El sur solo tiene dos: la de lluvias y la seca.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
