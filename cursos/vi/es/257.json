  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Bài đọc · Bếp của bà",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Mỗi khi trời mưa, tôi lại nhớ cái bếp của bà.",
       "alumno": "Cada vez que llueve, me acuerdo de la cocina de mi abuela.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Mỗi khi trời mưa",
         "cada vez que llueve"
        ],
        [
         "tôi lại nhớ cái bếp của bà",
         "vuelvo a acordarme de la cocina de la abuela"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Đó là một gian bếp nho nhỏ, tường đen vì khói, nằm lặng lẽ sau nhà như một người già ít nói.",
       "alumno": "Era una cocina pequeñita, con las paredes negras de humo, callada detrás de la casa como un viejo de pocas palabras.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "một gian bếp nho nhỏ",
         "una cocina pequeñita"
        ],
        [
         "tường đen vì khói",
         "paredes negras por el humo"
        ],
        [
         "nằm lặng lẽ sau nhà",
         "(estaba) callada detrás de la casa"
        ],
        [
         "như một người già ít nói",
         "como un anciano de pocas palabras"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Mưa rơi lách tách trên mái hiên. Trong bếp, lửa cũng lách tách trả lời.",
       "alumno": "La lluvia repiqueteaba en el alero. Dentro, el fuego le contestaba chisporroteando.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Mưa rơi lách tách trên mái hiên",
         "la lluvia cae repiqueteando sobre el alero"
        ],
        [
         "lửa cũng lách tách trả lời",
         "el fuego también contesta chisporroteando"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Bà ngồi đó, lưng còng, đôi bàn tay nhăn nứt tựa như vỏ cây, chầm chậm cho thêm củi.",
       "alumno": "La abuela se sentaba allí, encorvada, con unas manos arrugadas y agrietadas como corteza de árbol, echando leña despacito.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "lưng còng",
         "la espalda encorvada"
        ],
        [
         "đôi bàn tay nhăn nứt tựa như vỏ cây",
         "las dos manos arrugadas y agrietadas igual que corteza"
        ],
        [
         "chầm chậm cho thêm củi",
         "añadiendo leña despacito"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Cái bếp thở ra từng làn khói mỏng. Khói bay lên gác bếp, quấn lấy những bắp ngô treo từ mùa trước.",
       "alumno": "La cocina exhalaba hilos finos de humo. El humo subía al altillo y se enroscaba en las mazorcas colgadas desde la cosecha anterior.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Cái bếp thở ra từng làn khói mỏng",
         "la cocina exhala hilo a hilo un humo fino"
        ],
        [
         "Khói bay lên gác bếp",
         "el humo sube al altillo"
        ],
        [
         "quấn lấy những bắp ngô treo từ mùa trước",
         "se enrosca en las mazorcas colgadas desde la temporada anterior"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Mùi khoai nướng thoang thoảng. Bà lấy củ khoai trong tro ra, thổi phù phù, rồi bẻ đôi cho tôi phần to hơn.",
       "alumno": "Llegaba, leve, el olor del boniato asado. La abuela sacaba el boniato de la ceniza, soplaba, fu, fu, y lo partía en dos para darme el trozo más grande.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Mùi khoai nướng thoang thoảng",
         "el olor a boniato asado llega levemente"
        ],
        [
         "lấy củ khoai trong tro ra",
         "saca el boniato de la ceniza"
        ],
        [
         "thổi phù phù",
         "sopla, fu, fu"
        ],
        [
         "bẻ đôi cho tôi phần to hơn",
         "lo parte en dos y me da la parte mayor"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Bà không nói «bà thương cháu». Bà chỉ nói: «Ăn đi cho nóng.»",
       "alumno": "La abuela no decía «te quiero». Solo decía: «Come, que está caliente».",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Bà không nói «bà thương cháu»",
         "la abuela no decía «te quiero»"
        ],
        [
         "Ăn đi cho nóng",
         "come ahora que está caliente"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Ngoài kia gió rì rào qua hàng tre, thì thầm những chuyện tôi không hiểu. Trong này chỉ có hơi ấm và ánh lửa chập chờn trên mặt bà.",
       "alumno": "Fuera, el viento pasaba rumoroso entre los bambúes, susurrando cosas que yo no entendía. Dentro solo había calor y la luz del fuego yendo y viniendo sobre la cara de la abuela.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "gió rì rào qua hàng tre",
         "el viento rumorea entre la hilera de bambúes"
        ],
        [
         "thì thầm những chuyện tôi không hiểu",
         "susurra historias que no entiendo"
        ],
        [
         "ánh lửa chập chờn trên mặt bà",
         "la luz del fuego parpadea en la cara de la abuela"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Bây giờ bà mất đã mười năm. Nhà tôi ở tầng mười hai, bếp điện sáng bóng, không khói, không tro.",
       "alumno": "Hace ya diez años que murió. Vivo en un duodécimo piso, con una vitrocerámica reluciente, sin humo y sin ceniza.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "bà mất đã mười năm",
         "la abuela murió hace ya diez años"
        ],
        [
         "bếp điện sáng bóng",
         "la cocina eléctrica reluciente"
        ],
        [
         "không khói, không tro",
         "sin humo, sin ceniza"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Nhưng cứ nghe mưa là tôi lại thấy đói. Không phải đói khoai. Đói cái hơi ấm ấy.",
       "alumno": "Pero es oír la lluvia y me entra hambre. No hambre de boniato. Hambre de aquel calor.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "cứ nghe mưa là tôi lại thấy đói",
         "es oír la lluvia y vuelvo a tener hambre"
        ],
        [
         "Không phải đói khoai",
         "no es hambre de boniato"
        ],
        [
