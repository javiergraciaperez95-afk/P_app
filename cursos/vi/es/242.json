   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Bài đọc · Quyền được yên tĩnh",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Mười giờ đêm thứ ba. Nhà hàng xóm tôi vẫn hát karaoke, loa quay ra đường. Con tôi sáng mai phải thi.",
       "alumno": "Diez de la noche de un martes. En casa de mi vecino siguen con el karaoke, el altavoz mirando a la calle. Mi hijo tiene un examen mañana por la mañana.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Nhà hàng xóm tôi vẫn hát karaoke",
         "en casa de mi vecino siguen cantando karaoke"
        ],
        [
         "loa quay ra đường",
         "el altavoz orientado a la calle"
        ],
        [
         "Con tôi sáng mai phải thi",
         "mi hijo tiene examen mañana por la mañana"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Chuyện này có lẽ quen thuộc với bất cứ ai sống ở thành phố Việt Nam.",
       "alumno": "Esto probablemente le resulta familiar a cualquiera que viva en una ciudad vietnamita.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "quen thuộc với bất cứ ai",
         "familiar para cualquiera"
        ],
        [
         "sống ở thành phố Việt Nam",
         "que viva en una ciudad vietnamita"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Rõ ràng, tiếng ồn không chỉ là chuyện khó chịu. Các nghiên cứu cho thấy sống lâu trong tiếng ồn gây mất ngủ, căng thẳng và cả bệnh tim.",
       "alumno": "Está claro que el ruido no es solo una molestia. Los estudios muestran que vivir mucho tiempo con ruido provoca insomnio, estrés e incluso enfermedades del corazón.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Rõ ràng, tiếng ồn không chỉ là chuyện khó chịu",
         "claramente, el ruido no es solo algo molesto"
        ],
        [
         "sống lâu trong tiếng ồn",
         "vivir mucho tiempo entre ruido"
        ],
        [
         "gây mất ngủ, căng thẳng và cả bệnh tim",
         "causa insomnio, estrés e incluso cardiopatías"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Không thể phủ nhận rằng ca hát là một nét văn hóa vui vẻ của người Việt. Đám cưới, sinh nhật, tân gia: dịp nào cũng có hát hò.",
       "alumno": "No se puede negar que cantar es un rasgo alegre de la cultura vietnamita. Bodas, cumpleaños, inauguraciones: en cualquier ocasión se canta.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Không thể phủ nhận rằng",
         "no se puede negar que"
        ],
        [
         "ca hát là một nét văn hóa vui vẻ",
         "cantar es un rasgo cultural alegre"
        ],
        [
         "dịp nào cũng có hát hò",
         "en cualquier ocasión hay canto"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Đúng là ai cũng có quyền vui chơi. Nhưng quyền của người này kết thúc ở nơi quyền của người khác bắt đầu.",
       "alumno": "Es verdad que todos tenemos derecho a divertirnos. Pero el derecho de uno termina donde empieza el de otro.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Đúng là ai cũng có quyền vui chơi",
         "es cierto que todos tienen derecho a divertirse"
        ],
        [
         "quyền của người này kết thúc ở nơi",
         "el derecho de una persona termina donde"
        ],
        [
         "quyền của người khác bắt đầu",
         "empieza el derecho de otra"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Điều đáng lo ngại là nhiều người coi việc phàn nàn về tiếng ồn là «khó tính». Người bị làm phiền lại thấy ngại, còn người gây ồn thì không.",
       "alumno": "Lo preocupante es que mucha gente considera «quisquilloso» a quien se queja del ruido. El molestado es quien siente apuro; el que hace ruido, no.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Điều đáng lo ngại là",
         "lo preocupante es que"
        ],
        [
         "coi việc phàn nàn về tiếng ồn là «khó tính»",
         "consideran «exigente» quejarse del ruido"
        ],
        [
         "Người bị làm phiền lại thấy ngại",
         "el molestado es quien siente apuro"
        ],
        [
         "còn người gây ồn thì không",
         "y el que hace ruido, no"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Phải chăng chúng ta đã quá quen với tiếng ồn đến mức không còn coi nó là một vấn đề?",
       "alumno": "¿No será que nos hemos acostumbrado tanto al ruido que ya no lo vemos como un problema?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Phải chăng chúng ta đã quá quen với tiếng ồn",
         "no será que nos hemos acostumbrado demasiado al ruido"
        ],
        [
         "đến mức không còn coi nó là một vấn đề",
         "hasta el punto de ya no considerarlo un problema"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Luật thì đã có: sau mười giờ đêm, gây ồn quá mức có thể bị xử phạt. Điều đáng tiếc là hầu như không ai bị phạt cả.",
       "alumno": "La ley ya existe: después de las diez de la noche, hacer un ruido excesivo puede ser sancionado. Lo lamentable es que casi nadie recibe una multa.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Luật thì đã có",
         "la ley ya existe"
        ],
        [
         "gây ồn quá mức có thể bị xử phạt",
         "hacer ruido excesivo puede ser sancionado"
        ],
        [
         "hầu như không ai bị phạt cả",
         "casi nadie es multado"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Cũng có tín hiệu đáng mừng: một số phường đã lập đường dây nóng, và ngày càng nhiều người trẻ dám lên tiếng.",
       "alumno": "También hay señales alentadoras: algunos barrios han abierto un teléfono de quejas, y cada vez más jóvenes se atreven a protestar.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Cũng có tín hiệu đáng mừng",
         "también hay señales alentadoras"
        ],
        [
         "một số phường đã lập đường dây nóng",
         "algunos barrios han creado una línea directa"
        ],
        [
         "ngày càng nhiều người trẻ dám lên tiếng",
         "cada vez más jóvenes se atreven a alzar la voz"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Đã đến lúc chúng ta coi sự yên tĩnh là một quyền, chứ không phải một món quà. Và mọi thay đổi bắt đầu từ việc vặn nhỏ cái loa của chính mình.",
       "alumno": "Ha llegado la hora de ver el silencio como un derecho, no como un regalo. Y todo cambio empieza por bajar el volumen de nuestro propio altavoz.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Đã đến lúc chúng ta coi sự yên tĩnh là một quyền",
         "ha llegado la hora de que consideremos la tranquilidad un derecho"
        ],
        [
         "chứ không phải một món quà",
         "y no un regalo"
        ],
        [
         "vặn nhỏ cái loa của chính mình",
         "bajar el volumen del propio altavoz"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
