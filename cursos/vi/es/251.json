        ],
        [
         "rất mong chị cho chúng tôi biết",
         "le agradeceríamos que nos lo hiciera saber"
        ],
        [
         "chậm nhất là thứ hai tuần sau",
         "como muy tarde el lunes próximo"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Chúng tôi sẽ gửi bản hợp đồng chính thức trong vòng hai ngày làm việc sau khi nhận được phản hồi của chị.",
       "alumno": "Le enviaremos el contrato definitivo en un plazo de dos días hábiles tras recibir su respuesta.",
       "literal": "",
