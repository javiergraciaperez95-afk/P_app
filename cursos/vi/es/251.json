        [
         "chúng tôi xin phép dời lịch hẹn",
         "pedimos permiso para aplazar la cita"
        ],
        [
         "từ thứ ba sang thứ năm tuần sau",
         "del martes al jueves de la semana próxima"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Chúng tôi rất xin lỗi vì sự bất tiện này và mong chị thông cảm.",
       "alumno": "Lamentamos mucho esta molestia y le pedimos disculpas.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "rất xin lỗi vì sự bất tiện này",
         "lamentamos mucho este inconveniente"
        ],
        [
         "mong chị thông cảm",
         "esperamos que lo comprenda"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Thứ hai, tôi xin gửi kèm bản thảo hợp đồng. Xin vui lòng xem tệp đính kèm, đặc biệt là điều khoản số bốn về thời hạn thanh toán.",
       "alumno": "En segundo lugar, le adjunto el borrador del contrato. Le ruego que vea el archivo adjunto, en especial la cláusula cuarta, sobre el plazo de pago.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "tôi xin gửi kèm bản thảo hợp đồng",
         "le adjunto el borrador del contrato"
        ],
        [
         "Xin vui lòng xem tệp đính kèm",
         "le ruego vea el archivo adjunto"
        ],
        [
         "điều khoản số bốn về thời hạn thanh toán",
         "la cláusula cuatro sobre el plazo de pago"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Nếu chị muốn chỉnh sửa điểm nào, rất mong chị cho chúng tôi biết chậm nhất là thứ hai tuần sau.",
       "alumno": "Si desea modificar algún punto, le agradeceríamos que nos lo comunicara como muy tarde el lunes de la semana próxima.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Nếu chị muốn chỉnh sửa điểm nào",
