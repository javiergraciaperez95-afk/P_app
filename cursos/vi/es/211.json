     "frases": [
      {
       "quien": {
        "texto": "Vợ",
        "lengua": "estudio"
       },
       "estudio": "Anh Tuấn này, tháng này mình lại tiêu quá ngân sách rồi. Giá cả leo thang từng ngày.",
       "alumno": "Tuấn, este mes hemos vuelto a pasarnos del presupuesto. Los precios se disparan día a día.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
