       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Tuấn",
        "lengua": "estudio"
       },
       "estudio": "Em nói phải. Mình nên có một quỹ dự phòng, ít nhất đủ sống ba tháng, phòng khi ốm đau hay thất nghiệp.",
       "alumno": "Tienes razón. Deberíamos tener un fondo de emergencia, al menos para vivir tres meses, por si hay una enfermedad o un despido.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
