        [
         "rồi dọn dẹp nhà cửa",
         "y luego recojo la casa"
        ],
        [
         "cả ngày",
         "todo el día"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Nhưng tuần trước, thay vì ở nhà, tôi đi cắm trại với nhóm bạn cũ.",
       "alumno": "Pero la semana pasada, en vez de quedarme en casa, me fui de acampada con mis viejos amigos.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "thay vì ở nhà",
         "en vez de quedarme en casa"
        ],
        [
         "đi cắm trại",
         "fui de acampada"
        ],
        [
         "với nhóm bạn cũ",
         "con el grupo de viejos amigos"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Cả nhóm đều đi, trừ Tuấn vì anh ấy phải biểu diễn ở một đám cưới.",
       "alumno": "Fue todo el grupo, menos Tuấn, que tenía que actuar en una boda.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Cả nhóm đều đi",
         "fue todo el grupo"
        ],
        [
         "trừ Tuấn",
         "menos Tuấn"
        ],
        [
         "vì anh ấy phải biểu diễn",
