        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Ngoài lều và đồ ăn ra, chúng tôi còn mang theo một cây đàn ghi-ta.",
       "alumno": "Además de las tiendas y la comida, nos llevamos una guitarra.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Ngoài lều và đồ ăn ra",
         "además de las tiendas y la comida"
