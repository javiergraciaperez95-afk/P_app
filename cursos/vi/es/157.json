      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Chúng tôi dựng lều bên bờ sông, cách thành phố khoảng sáu mươi cây số.",
       "alumno": "Montamos las tiendas a la orilla del río, a unos sesenta kilómetros de la ciudad.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "dựng lều bên bờ sông",
         "montamos la tienda junto a la orilla del río"
