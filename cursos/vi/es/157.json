      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Buổi tối, mọi người đốt lửa, nướng thịt và hát đến khuya.",
       "alumno": "Por la noche encendimos un fuego, hicimos carne a la brasa y cantamos hasta tarde.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "đốt lửa",
         "encender fuego"
        ],
        [
         "nướng thịt",
         "asar carne"
