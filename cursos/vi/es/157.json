     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Cuối tuần, tôi thường ngủ nướng đến mười giờ, rồi dọn dẹp nhà cửa cả ngày.",
       "alumno": "Los fines de semana suelo quedarme en la cama hasta las diez y luego me paso el día ordenando la casa.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "thường ngủ nướng đến mười giờ",
         "suelo quedarme en la cama hasta las diez"
