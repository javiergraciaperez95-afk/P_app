 "etapas": [
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Bài đọc · Một tuần không điện thoại",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Một nghiên cứu gần đây cho thấy người Việt trẻ dùng điện thoại trung bình hơn sáu tiếng mỗi ngày.",
       "alumno": "Un estudio reciente muestra que los jóvenes vietnamitas usan el móvil una media de más de seis horas al día.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Một nghiên cứu gần đây cho thấy",
         "un estudio reciente muestra"
        ],
        [
         "trung bình hơn sáu tiếng mỗi ngày",
         "de media más de seis horas cada día"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Tôi là một trong số đó. Sáng nào thức dậy, việc đầu tiên tôi làm là cầm điện thoại lên và đọc từng thông báo.",
       "alumno": "Yo soy uno de ellos. Todas las mañanas, lo primero que hago al despertarme es coger el móvil y leer las notificaciones una por una.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Tôi là một trong số đó",
         "yo soy uno de ellos"
        ],
        [
         "việc đầu tiên tôi làm",
         "lo primero que hago"
        ],
        [
         "cầm điện thoại lên",
         "coger el móvil"
        ],
        [
         "đọc từng thông báo",
         "leer cada notificación, una por una"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Mỗi lần chờ thang máy, mỗi lần ngồi trên xe buýt, tay tôi lại tự động lướt màn hình.",
       "alumno": "Cada vez que espero el ascensor, cada vez que voy sentado en el autobús, mi mano se pone sola a pasar pantallas.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Mỗi lần chờ thang máy",
         "cada vez que espero el ascensor"
        ],
        [
         "tay tôi lại tự động lướt màn hình",
         "mi mano vuelve a deslizar la pantalla sola"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Trong bữa cơm, mọi người trong nhà tôi đều nhìn xuống: mỗi người một màn hình, không ai trò chuyện với ai.",
       "alumno": "Durante la comida, en mi casa todos miramos hacia abajo: cada uno con su pantalla, y nadie habla con nadie.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "mọi người trong nhà tôi đều nhìn xuống",
         "todos en mi casa miramos hacia abajo"
        ],
        [
         "mỗi người một màn hình",
         "cada persona, una pantalla"
        ],
        [
         "không ai trò chuyện với ai",
         "nadie charla con nadie"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Dạo này tôi khó ngủ, mắt mỏi và cổ đau. Bác sĩ nói ánh sáng xanh và tư thế cúi đầu là nguyên nhân.",
       "alumno": "Últimamente duermo mal, tengo los ojos cansados y me duele el cuello. El médico dice que la causa son la luz azul y la postura con la cabeza agachada.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "tôi khó ngủ, mắt mỏi và cổ đau",
         "me cuesta dormir, ojos cansados y dolor de cuello"
        ],
        [
         "ánh sáng xanh và tư thế cúi đầu",
         "la luz azul y la postura de cabeza agachada"
        ],
        [
         "là nguyên nhân",
         "son la causa"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Vì vậy, tôi quyết định thử «cai» điện thoại trong một tuần.",
       "alumno": "Por eso decidí probar a «desengancharme» del móvil durante una semana.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "tôi quyết định thử «cai» điện thoại",
         "decidí probar a desengancharme del móvil"
        ],
        [
         "trong một tuần",
         "durante una semana"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Ngày đầu tiên khó khăn nhất: tôi đếm từng phút và cứ năm phút lại sờ vào túi áo.",
       "alumno": "El primer día fue el más duro: contaba cada minuto y cada cinco me tocaba el bolsillo.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "tôi đếm từng phút",
         "contaba minuto a minuto"
        ],
        [
         "cứ năm phút lại sờ vào túi áo",
         "cada cinco minutos me tocaba el bolsillo"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Nhưng từng ngày trôi qua, tôi thấy nhẹ nhõm hơn. Tôi đọc hết một cuốn sách và nói chuyện mặt đối mặt với từng người trong gia đình.",
       "alumno": "Pero, día tras día, me fui sintiendo más ligero. Me leí un libro entero y hablé cara a cara con cada uno de mi familia.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "từng ngày trôi qua",
         "según pasaba cada día"
        ],
        [
         "tôi thấy nhẹ nhõm hơn",
         "me sentía más aliviado"
        ],
        [
         "nói chuyện mặt đối mặt với từng người",
         "hablé cara a cara con cada persona"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Tôi không bỏ hẳn điện thoại, vì mọi công việc của tôi đều cần nó. Nhưng bây giờ tôi tự giới hạn: sau chín giờ tối, điện thoại ở chế độ im lặng.",
       "alumno": "No he dejado el móvil del todo, porque todo mi trabajo depende de él. Pero ahora me pongo un límite: después de las nueve de la noche, el móvil en silencio.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Tôi không bỏ hẳn điện thoại",
         "no he dejado el móvil del todo"
        ],
        [
         "mọi công việc của tôi đều cần nó",
         "todos mis trabajos lo necesitan"
        ],
        [
         "tôi tự giới hạn",
         "me limito yo mismo"
        ],
        [
         "điện thoại ở chế độ im lặng",
         "el móvil en modo silencio"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Điện thoại thông minh, nhưng người dùng phải thông minh hơn.",
       "alumno": "El teléfono es inteligente, pero quien lo usa tiene que serlo más.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Điện thoại thông minh",
         "el teléfono inteligente"
        ],
        [
         "người dùng phải thông minh hơn",
         "el usuario debe ser más inteligente"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
   ]
