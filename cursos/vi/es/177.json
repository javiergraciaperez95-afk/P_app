     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Ngày nay, càng ngày càng nhiều người Việt Nam mua sắm trực tuyến thay vì ra cửa hàng.",
       "alumno": "Hoy en día, cada vez más vietnamitas compran por internet en vez de ir a la tienda.",
