   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Bài đọc · Ba thế hệ dưới một mái nhà",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Nhà tôi có ba thế hệ sống chung: ông bà, bố mẹ và hai anh em tôi.",
       "alumno": "En mi casa vivimos juntas tres generaciones: mis abuelos, mis padres y mi hermano y yo.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "ba thế hệ sống chung",
         "tres generaciones que viven juntas"
        ],
        [
         "hai anh em tôi",
         "mi hermano y yo"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Ông tôi hiền lắm. Hễ có thời gian là ông kể chuyện ngày xưa cho chúng tôi nghe.",
       "alumno": "Mi abuelo es muy bueno. Siempre que tiene tiempo nos cuenta historias de antes.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Hễ có thời gian",
         "siempre que tiene tiempo"
        ],
        [
         "là ông kể chuyện ngày xưa",
         "nos cuenta historias de antes"
        ],
        [
         "cho chúng tôi nghe",
         "para que las oigamos"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Bà tôi thì rất cưng cháu. Mỗi khi mẹ mắng em tôi, bà lại dỗ nó.",
       "alumno": "Mi abuela, en cambio, mima mucho a los nietos. Cada vez que mi madre regaña a mi hermano pequeño, ella va y lo consuela.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "rất cưng cháu",
         "mima mucho a los nietos"
        ],
        [
         "Mỗi khi mẹ mắng em tôi",
         "cada vez que mamá regaña a mi hermano"
        ],
        [
         "bà lại dỗ nó",
         "la abuela va y lo consuela"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Em trai tôi mới bảy tuổi và nghịch lắm. Hễ không ai để ý là nó trèo lên cây.",
       "alumno": "Mi hermano tiene solo siete años y es muy travieso. En cuanto nadie lo mira, se sube a un árbol.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "mới bảy tuổi",
         "solo tiene siete años"
        ],
        [
         "nghịch lắm",
         "muy travieso"
        ],
        [
         "Hễ không ai để ý",
         "siempre que nadie se fija"
        ],
        [
         "là nó trèo lên cây",
         "se sube al árbol"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Bố tôi khá nghiêm khắc. Bố thường nói: «Nếu không nghe lời thì đừng xem tivi nữa!»",
       "alumno": "Mi padre es bastante estricto. Suele decir: «¡Si no haces caso, se acabó la tele!».",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "khá nghiêm khắc",
         "bastante estricto"
        ],
        [
         "Nếu không nghe lời",
         "si no obedeces"
        ],
        [
         "thì đừng xem tivi nữa",
         "pues no veas más la tele"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Thỉnh thoảng anh em tôi cũng cãi nhau, nhưng chỉ một lúc sau là làm lành ngay.",
       "alumno": "A veces mi hermano y yo también discutimos, pero al rato ya hemos hecho las paces.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "cũng cãi nhau",
         "también discutimos"
        ],
        [
         "chỉ một lúc sau",
         "solo un rato después"
        ],
        [
         "là làm lành ngay",
         "ya hacemos las paces"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Mẹ tôi là người chăm sóc cả nhà. Ai ốm mẹ cũng biết phải làm gì.",
       "alumno": "Mi madre es la que cuida de todos. Enferme quien enferme, ella sabe qué hacer.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "người chăm sóc cả nhà",
         "la persona que cuida de toda la casa"
        ],
        [
         "Ai ốm mẹ cũng biết",
         "enferme quien enferme, mamá sabe"
        ],
        [
         "phải làm gì",
         "qué hay que hacer"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Cứ đến Tết là họ hàng ở khắp nơi về sum họp, nhà tôi đông như một cái chợ.",
       "alumno": "En cuanto llega el Tết, los parientes vienen de todas partes a reunirse y mi casa parece un mercado.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Cứ đến Tết là",
         "en cuanto llega el Tết"
        ],
        [
         "họ hàng ở khắp nơi",
         "los parientes de todas partes"
        ],
        [
         "về sum họp",
         "vuelven a reunirse"
        ],
        [
         "đông như một cái chợ",
         "llena como un mercado"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Sống chung nhiều thế hệ không phải lúc nào cũng dễ, nhưng tôi thấy gia đình mình rất đoàn kết.",
       "alumno": "Vivir varias generaciones juntas no siempre es fácil, pero veo a mi familia muy unida.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Sống chung nhiều thế hệ",
         "vivir juntas varias generaciones"
        ],
        [
         "không phải lúc nào cũng dễ",
         "no siempre es fácil"
        ],
        [
         "rất đoàn kết",
         "muy unida"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
   ]
