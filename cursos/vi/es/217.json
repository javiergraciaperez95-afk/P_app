     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Tháng 11 năm 1997, Việt Nam chính thức kết nối Internet. Lúc đó, rất ít người hiểu nó dùng để làm gì.",
       "alumno": "En noviembre de 1997, Vietnam se conectó oficialmente a internet. Entonces muy poca gente entendía para qué servía.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Việt Nam chính thức kết nối Internet",
         "Vietnam se conecta oficialmente a internet"
