     "titulo": "Bài đọc · Những ngôi làng không có người trẻ",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Về quê tôi vào một ngày thường, bạn sẽ không gặp một ai dưới bốn mươi tuổi, trừ trẻ con.",
       "alumno": "Si vas a mi pueblo un día cualquiera, no te encontrarás ni a una sola persona de menos de cuarenta años, salvo los niños.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Về quê tôi vào một ngày thường",
         "si vuelves a mi pueblo un día normal"
        ],
        [
         "bạn sẽ không gặp một ai dưới bốn mươi tuổi",
         "no encontrarás ni a una persona de menos de cuarenta"
