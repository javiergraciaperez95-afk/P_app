       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Làm ruộng thì vất vả mà thu nhập chẳng được bao nhiêu. Không ai muốn con mình khổ như mình cả.",
       "alumno": "Trabajar el campo es duro y apenas da dinero. Nadie quiere que sus hijos lo pasen tan mal como él.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
