    {
     "tipo": "dialogo",
     "titulo": "Hội thoại · Trong phòng sếp",
     "frases": [
      {
       "quien": {
        "texto": "Minh",
        "lengua": "estudio"
       },
       "estudio": "Chị Lan, em xin phép nói chuyện thẳng thắn với chị về lương của em.",
       "alumno": "Lan, me gustaría hablar contigo con franqueza sobre mi sueldo.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "em xin phép nói chuyện thẳng thắn",
         "pido permiso para hablar con franqueza"
        ],
        [
         "về lương của em",
         "sobre mi sueldo"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Chị Lan",
        "lengua": "estudio"
       },
       "estudio": "Ừ, em cứ nói.",
       "alumno": "Sí, dime.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "em cứ nói",
         "habla con libertad"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Minh",
        "lengua": "estudio"
       },
       "estudio": "Em làm ở đây được hai năm rồi. Năm nay em đảm nhận thêm dự án ngân hàng và mang về ba hợp đồng mới. Em đề xuất tăng lương mười lăm phần trăm.",
       "alumno": "Llevo dos años aquí. Este año me he hecho cargo además del proyecto del banco y he traído tres contratos nuevos. Propongo una subida del quince por ciento.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "đảm nhận thêm dự án ngân hàng",
         "me he hecho cargo además del proyecto del banco"
        ],
        [
         "mang về ba hợp đồng mới",
         "he traído tres contratos nuevos"
        ],
        [
         "Em đề xuất tăng lương mười lăm phần trăm",
         "propongo una subida de sueldo del quince por ciento"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Chị Lan",
        "lengua": "estudio"
       },
       "estudio": "Chị công nhận đóng góp của em. Nhưng ngân sách năm nay có hạn. Chị không thể tăng mười lăm phần trăm, trừ khi giám đốc đồng ý.",
       "alumno": "Reconozco tu aportación. Pero el presupuesto de este año es limitado. No puedo subirte un quince por ciento, a no ser que el director lo apruebe.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Chị công nhận đóng góp của em",
         "reconozco tu aportación"
        ],
        [
         "ngân sách năm nay có hạn",
         "el presupuesto de este año es limitado"
        ],
        [
         "trừ khi giám đốc đồng ý",
         "a no ser que el director esté de acuerdo"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Minh",
        "lengua": "estudio"
       },
       "estudio": "Giả sử giám đốc không đồng ý thì chị có thể đề xuất mức nào?",
       "alumno": "Supongamos que el director no acepta: ¿qué cifra podrías proponer tú?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Giả sử giám đốc không đồng ý",
         "supongamos que el director no acepta"
        ],
        [
         "chị có thể đề xuất mức nào",
         "qué nivel podrías proponer"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Chị Lan",
        "lengua": "estudio"
       },
       "estudio": "Chị có thể xem xét tám phần trăm ngay từ tháng sau, với điều kiện là em cam kết ở lại công ty ít nhất hai năm nữa.",
       "alumno": "Podría estudiar un ocho por ciento desde el mes que viene, con la condición de que te comprometas a quedarte en la empresa al menos dos años más.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Chị có thể xem xét tám phần trăm",
         "puedo considerar un ocho por ciento"
        ],
        [
         "với điều kiện là em cam kết ở lại công ty",
         "con la condición de que te comprometas a quedarte en la empresa"
        ],
        [
         "ít nhất hai năm nữa",
         "al menos dos años más"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Minh",
        "lengua": "estudio"
       },
       "estudio": "Tám phần trăm thì hơi thấp so với mong muốn của em. Em sẵn sàng cam kết, miễn là có thêm khoản thưởng theo dự án.",
       "alumno": "Un ocho por ciento queda algo por debajo de lo que esperaba. Estoy dispuesto a comprometerme, con tal de que haya además una prima por proyecto.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "hơi thấp so với mong muốn của em",
         "algo bajo comparado con lo que deseo"
        ],
        [
         "Em sẵn sàng cam kết",
         "estoy dispuesto a comprometerme"
        ],
        [
         "miễn là có thêm khoản thưởng theo dự án",
         "con tal de que haya además una prima por proyecto"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Chị Lan",
        "lengua": "estudio"
       },
       "estudio": "Thưởng theo dự án thì chị đồng ý. Giả sử em mang về thêm hai hợp đồng trong quý tới, em sẽ được thưởng một tháng lương.",
       "alumno": "Lo de la prima por proyecto, de acuerdo. Pongamos que traes dos contratos más el próximo trimestre: recibirías una paga extra de un mes.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Thưởng theo dự án thì chị đồng ý",
         "la prima por proyecto, la acepto"
        ],
        [
         "Giả sử em mang về thêm hai hợp đồng trong quý tới",
         "pongamos que traes dos contratos más el trimestre próximo"
        ],
        [
         "em sẽ được thưởng một tháng lương",
         "te premiarán con un mes de sueldo"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Minh",
        "lengua": "estudio"
       },
       "estudio": "Vậy là tám phần trăm cộng với thưởng. Em nghĩ đây là thỏa thuận đôi bên cùng có lợi.",
       "alumno": "O sea, un ocho por ciento más la prima. Creo que es un acuerdo bueno para las dos partes.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "tám phần trăm cộng với thưởng",
         "ocho por ciento más prima"
        ],
        [
         "thỏa thuận đôi bên cùng có lợi",
         "un acuerdo que beneficia a ambas partes"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Chị Lan",
        "lengua": "estudio"
       },
       "estudio": "Chị cũng nghĩ thế. Tuần sau chị sẽ gửi em hợp đồng mới. Em đàm phán khá lắm đấy!",
       "alumno": "Yo también lo creo. La semana que viene te mando el contrato nuevo. ¡Negocias bastante bien!",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "chị sẽ gửi em hợp đồng mới",
         "te enviaré el contrato nuevo"
        ],
        [
         "Em đàm phán khá lắm đấy",
         "negocias bastante bien, ¿eh?"
        ]
       ],
       "parrafo": 0
      }
     ]
