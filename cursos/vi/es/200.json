     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Minh mới hai mươi sáu tuổi, nhưng từ nhỏ anh đã mơ ước có một quán cà phê sách của riêng mình.",
