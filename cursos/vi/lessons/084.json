 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Puntualidad: sớm, trễ, hơi … một chút",
    "@en": "Punctuality: sớm, trễ, hơi, một chút"
   },
   "texto": [
    {
     "@es": "**đúng giờ** = puntual · **sớm** = pronto · **trễ** (sur) / **muộn** (norte) = tarde.",
     "@en": "**đúng giờ** = punctual · **sớm** = soon · **trễ** (south) / **muộn** (north) = late."
    },
    {
     "@es": "**hơi … một chút** = un poquito: **Chúng tôi đến hơi sớm một chút.** = Hemos llegado un poquito pronto. · **hơi mệt một chút** = un poco cansado.",
     "@en": "**hơi … một chút** = a little bit: **Chúng tôi đến hơi sớm một chút.** = We have arrived a little soon. · **hơi mệt một chút** = a little tired."
    },
    {
     "@es": "**Đến sớm còn hơn đến trễ.** = Más vale llegar pronto que tarde.",
     "@en": "**Đến sớm còn hơn đến trễ.** = It is better to be here soon than late."
    },
    {
     "@es": "Si alguien se disculpa por llegar pronto, se responde **Thế thì càng tốt chứ sao!** = ¡Pues mejor todavía!",
     "@en": "If anyone apologizes for coming soon, **Thế thì càng tốt chứ sao!** is answered = Well, better yet!"
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Cuanto más… más: càng … càng",
    "@en": "The more the: càng … càng"
   },
   "texto": [
    {
     "@es": "**càng** + A + **càng** + B = cuanto más A, más B: **Càng sớm càng tốt.** = Cuanto antes, mejor. · **Càng nhiều càng tốt.** = Cuantos más, mejor.",
     "@en": "**càng** + A + **càng** + B = the more A, the more B: **Càng sớm càng tốt.** = The sooner, the better. · **Càng nhiều càng tốt.** = The more, the better."
    },
    {
     "@es": "**càng ngày càng** = cada día más: **Em càng ngày càng đẹp.** = Estás cada día más guapa. · **Anh học càng ngày càng giỏi.** = Cada día estudias mejor.",
     "@en": "**càng ngày càng** = every day more: **Em càng ngày càng đẹp.** = You are increasingly beautiful. · **Anh học càng ngày càng giỏi.** = Every day you study better."
    },
    {
     "@es": "**Khách càng đông càng vui.** = Cuanta más gente, más alegría (se dice mucho en las fiestas).",
     "@en": "**Khách càng đông càng vui.** = The more people, the more joy (much is said at parties)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "¿Qué te pasa? có sao không",
    "@en": "\"What is wrong with you?\" said sao không."
   },
   "texto": [
    {
     "@es": "**Anh làm sao vậy?** = ¿Qué te pasa? · **Anh có sao không?** = ¿Estás bien? (tras un golpe, por ejemplo) → **Tôi không sao.** = Estoy bien.",
     "@en": "**Anh làm sao vậy?** = What's the matter with you? · **Anh có sao không?** = Are you okay? (after a hit, for example) → **Tôi không sao.** = I'm fine."
    },
    {
     "@es": "**Không sao.** = No pasa nada.",
     "@en": "**Không sao.** = It's okay."
    }
   ]
  },
