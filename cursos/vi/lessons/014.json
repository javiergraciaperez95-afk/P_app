   "tipo": "explicacion",
   "titulo": {
    "@es": "Países y nacionalidades",
    "@en": "Countries and nationalities"
   },
   "texto": [
    {
     "@es": "País = **nước** + nombre: **nước Việt Nam** = Vietnam, **nước Mỹ** = Estados Unidos.",
     "@en": "Country = **nước** + name: **nước Việt Nam** = Vietnam, **nước Mỹ** = United States."
    },
    {
     "@es": "Nacionalidad = **người** (persona) + país: **người Việt Nam** (o **người Việt**) = vietnamita; **người Tây Ban Nha** = español/a.",
     "@en": "Nationality = **người** (person) + country: **người Việt Nam** (or **người Việt**) = Vietnamese; **người Tây Ban Nha** = Spanish."
    },
    {
     "@es": "Idioma = **tiếng** + país: **tiếng Việt** = el vietnamita, **tiếng Anh** = el inglés, **tiếng Tây Ban Nha** = el español.",
     "@en": "Language = **tiếng** + country: **tiếng Việt** = Vietnamese, **tiếng Anh** = English, **tiếng Tây Ban Nha** = Spanish."
    },
    {
     "@es": "Para preguntar: **Bạn là người nước nào?** = ¿De qué país eres? (lit. «¿eres persona de qué país?»). **nào** (cuál) va detrás del nombre, en el sitio de la respuesta.",
     "@en": "To ask: **Bạn là người nước nào?** = What country are you from? (lit. «¿eres persona de qué país?»). **nào** (which) goes behind the name, on the site of the answer."
    }
   ]
