  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Nguyên âm · Las últimas vocales",
    "@en": "Nguyên âm · The last vowels"
   },
   "texto": [
    {
     "@es": "Con estas terminamos todas las vocales del vietnamita. Muchas no existen en español: lo mejor es escucharlas y repetirlas.",
     "@en": "With these we end all the Vietnamese vowels. Many do not exist in Spanish: the best thing is to listen to them and repeat them."
    },
    {
     "@es": "**oa**: «ua», como en «agua»: **hoa** ≈ «jua».",
     "@en": "**oa**: «ua», as in «water»: **hoa** ∞ «jua»."
    },
    {
     "@es": "**uô**: u + ô: «uo» (siempre con consonante detrás: **muốn**, **buổi**).",
     "@en": "**uô**: u + ô: «uo» (always with consonant behind: **muốn**, **buổi**)."
    },
    {
     "@es": "**ơi**: ơ + i: una «e» relajada + i: **mời** ≈ «méi».",
     "@en": "**ơi**: ơ + i: one «e» relaxed + i: **mời** ≈ «méi»."
    },
    {
     "@es": "**ua**: u + a: «ua» de «cuatro» (sin consonante detrás): **mua** ≈ «mua».",
     "@en": "**ua**: u + a: «ua» from «4» (no consonant behind): **mua** ∞ «mua»."
    },
    {
     "@es": "**ưa**: ư + a: **chưa**, **sữa**.",
     "@en": "**ưa**: ư + a: **chưa**, **sữa**."
    },
    "**uôi**: u + ô + i: «uoi»: **muối**, **chuối**.",
    {
     "@es": "**ươi**: ư + ơ + i: **người**, **mười**.",
     "@en": "**ươi**: ư + ơ + i: **người**, **mười**."
    },
    {
     "@es": "**oa** y **uô** pueden llevar consonante final; las otras cinco siempre terminan la sílaba.",
     "@en": "**oa** and **uô** can carry final consonant; the other five always finish the syllable."
    }
   ]
  },
