   "id": "t11-lai",
   "opciones": [
    {
     "texto": {
      "@es": "«En cambio»: algo distinto de lo esperado",
      "@en": "«Instead»: something different than expected"
     },
     "explicacion": {
      "@es": "Ellos querían invitar, pero son los padres quienes invitan.",
      "@en": "They wanted to invite, but it's the parents who invite."
     },
     "correcta": true
    },
    {
     "texto": "«Otra vez»",
     "explicacion": {
      "@es": "Aquí no; va delante del verbo con sentido de contraste.",
      "@en": "Not here; it goes in front of the verb with a sense of contrast."
     }
    },
    {
     "texto": "«Ya»",
     "explicacion": {
      "@es": "«Ya» es «rồi».",
      "@en": "«Now.» is «rồi»."
     }
    },
    {
     "texto": "«Todavía»",
     "explicacion": {
      "@es": "«Todavía» es «vẫn».",
      "@en": "«Still.» is «vẫn»."
     }
    }
   ]
  },
  {
