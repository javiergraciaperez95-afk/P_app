  {
   "tipo": "test",
   "pregunta": {
    "@es": "«Muốn đi đâu thì đi» significa…",
    "@en": "«Muốn đi đâu thì đi» means"
   },
   "id": "t11-muonthi",
   "opciones": [
    {
     "texto": {
      "@es": "Ve donde quieras.",
      "@en": "Go wherever you want."
     },
     "explicacion": {
      "@es": "muốn … thì … = lo que quieras.",
      "@en": "muốn-thì-what you want."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "¿Adónde quieres ir?",
      "@en": "Where do you want to go?"
     },
     "explicacion": {
      "@es": "No es pregunta.",
      "@en": "It's not a question."
     }
    },
    {
     "texto": {
      "@es": "No quiero ir.",
      "@en": "I don't want to go."
     },
     "explicacion": {
      "@es": "No hay negación.",
      "@en": "There's no denial."
     }
    },
    {
     "texto": {
      "@es": "Quiero ir contigo.",
      "@en": "I want to go with you."
     },
     "explicacion": {
      "@es": "No aparece «với».",
      "@en": "«với» does not appear."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
