   "titulo": {
    "@es": "Cantidades: thiếu, thừa, vắng, đầy",
    "@en": "Quantities: thiếu, thừa, vắng, đầy"
   },
   "texto": [
    {
     "@es": "**thiếu** = faltar · **đủ** = bastar · **thừa** = sobrar: **Phòng này thừa bàn.** = En esta sala sobran mesas.",
     "@en": "**thiếu** = missing · **đủ** = sufficient · **thừa** = left: **Phòng này thừa bàn.** = In this room there are left tables."
    },
    {
     "@es": "**đông** = lleno de gente · **vắng** = vacío (de gente): **Buổi tối các đường phố vắng người.** = Por la noche las calles están vacías. (Solo para personas.)",
     "@en": "**đông** = full of people · **vắng** = empty (of people): **Buổi tối các đường phố vắng người.** = In the evening the streets are empty. (For people only.)"
    },
    {
     "@es": "**đầy** = lleno (de cosas): **Chai này đầy nước.** = Esta botella está llena de agua.",
     "@en": "**đầy** = full (of things): **Chai này đầy nước.** = This bottle is full of water."
    }
   ]
  },
  {
   "tipo": "dialogo",
   "titulo": {
    "@es": "Ejemplos: cantidades",
    "@en": "Examples: quantities"
