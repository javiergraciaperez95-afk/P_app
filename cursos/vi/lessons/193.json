   "frase": "Phải có vé mới vào được.",
   "id": "vb193-10",
   "opciones": [
    {
     "texto": {
      "@es": "Solo se puede entrar con entrada.",
      "@en": "You can only go in with an entrance."
     },
     "explicacion": {
      "@es": "phải… mới… = solo así.",
      "@en": "\"phải\" mới \"= just like that."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "No hace falta entrada para entrar.",
      "@en": "You don't have to get in."
     },
     "explicacion": {
      "@es": "Al contrario.",
      "@en": "On the contrary."
     }
    },
    {
     "texto": {
      "@es": "Hay que entrar para comprar la entrada.",
      "@en": "We have to go in to buy the ticket."
     },
     "explicacion": {
      "@es": "Al revés.",
      "@en": "The other way around."
     }
    },
    {
     "texto": {
      "@es": "Las entradas son nuevas.",
      "@en": "The tickets are new."
     },
     "explicacion": {
      "@es": "Aquí «mới» no es «nuevo».",
      "@en": "«mới» here is not «new»."
     }
    }
   ]
  },
