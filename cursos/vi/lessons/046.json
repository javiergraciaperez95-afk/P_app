 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Comparar: adjetivo + hơn",
    "@en": "Compare: adjective + hơn"
   },
   "texto": [
    {
     "@es": "**hơn** detrás del adjetivo = «más»: **rẻ hơn** = más barato · **gần hơn** = más cerca.",
     "@en": "**hơn** behind the adjective = «more»: **rẻ hơn** = cheaper · **gần hơn** = closer."
    },
    {
     "@es": "Con qué se compara va detrás: **Nhà này to hơn nhà kia.** = Esta casa es más grande que aquella.",
     "@en": "What is the comparison with the following: **Nhà này to hơn nhà kia.** = This house is bigger than that."
    },
    {
     "@es": "**thích … hơn** = preferir: **Tôi thích cái này hơn.** = Prefiero este.",
     "@en": "**thích … hơn** = prefer: **Tôi thích cái này hơn.** = I prefer this one."
    },
    {
     "@es": "**Cái nào?** = ¿Cuál? · **Anh thích cái nào?** = ¿Cuál te gusta?",
     "@en": "**Cái nào?** = Which one? · **Anh thích cái nào?** = Which one do you like?"
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Plurales: những y các",
    "@en": "Plurals: những and cc"
   },
   "texto": [
    {
     "@es": "Normalmente no hace falta plural: **Tôi có ba cái ghế** ya se entiende.",
     "@en": "It is not usually necessary to plural: **Tôi có ba cái ghế** is already understood."
    },
    {
     "@es": "**những** delante = «unos, los» (algunos): **những cái bàn** = las mesas · **những người nước ngoài** = los extranjeros.",
     "@en": "**những** in front = «one, the» (some): **những cái bàn** = tables · **những người nước ngoài** = foreigners."
    },
    {
     "@es": "**các** delante = «todos los»: **các ông các bà** = señoras y señores · **các con** = los hijos (todos).",
     "@en": "**các** ahead = «all»: **các ông các bà** = ladies and gentlemen · **các con** = children (all)."
    },
    {
     "@es": "• Muy útil en familia: **Chào các bác!** = ¡Hola a todos (los tíos)!",
     "@en": "• Very useful in family: **Chào các bác!** = Hello to all (the guys)!"
    }
   ]
  },
