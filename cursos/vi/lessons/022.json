   "frase": "Ai đi mua cam?",
   "id": "b3l-tr-ai",
   "opciones": [
    {
     "texto": {
      "@es": "¿Quién va a comprar naranjas?",
      "@en": "Who's going to buy oranges?"
     },
     "explicacion": {
      "@es": "ai = quién; đi mua = ir a comprar.",
      "@en": "ai = who; đi mua = go shopping."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "¿Adónde vas a comprar naranjas?",
      "@en": "Where are you going to buy oranges?"
     },
     "explicacion": {
      "@es": "«¿Adónde?» sería «đâu».",
      "@en": "«Where?» would be «đâu»."
     }
    },
    {
     "texto": {
      "@es": "¿Quién vende naranjas?",
      "@en": "Who sells oranges?"
     },
     "explicacion": {
      "@es": "Vender es «bán».",
      "@en": "Selling is «bán»."
     }
    },
    {
     "texto": {
      "@es": "Voy a comprar naranjas.",
      "@en": "I'm going to buy oranges."
     },
     "explicacion": {
      "@es": "«ai» lo convierte en pregunta: ¿quién?",
      "@en": "«ai» makes it a question: who?"
     }
    }
   ]
  },
