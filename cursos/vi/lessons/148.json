  {
   "tipo": "traduccion",
   "pregunta": {
    "@es": "¿Qué significa?",
    "@en": "What does that mean?"
   },
   "frase": "Tiếng ồn làm tôi đau đầu.",
   "id": "vb148-8",
   "opciones": [
    {
     "texto": {
      "@es": "El ruido me da dolor de cabeza.",
      "@en": "The noise gives me a headache."
     },
     "explicacion": {
      "@es": "cosa + làm + persona + cómo se queda.",
      "@en": "thing + làm + person + how you stay."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Hago ruido cuando me duele la cabeza.",
      "@en": "I make a noise when my head hurts."
     },
     "explicacion": {
      "@es": "Quien provoca el dolor es el ruido.",
      "@en": "The one who causes the pain is the noise."
     }
    },
    {
     "texto": {
      "@es": "Me duele la cabeza, por eso hago ruido.",
      "@en": "My head hurts, that's why I make a noise."
     },
     "explicacion": {
      "@es": "Está al revés.",
      "@en": "It's the other way around."
     }
    },
    {
     "texto": {
      "@es": "No oigo nada por el dolor de cabeza.",
      "@en": "I can't hear anything from the headache."
     },
     "explicacion": "No."
    }
   ]
  },
  {
   "tipo": "traduccion",
   "pregunta": {
    "@es": "¿Qué significa?",
    "@en": "What does that mean?"
