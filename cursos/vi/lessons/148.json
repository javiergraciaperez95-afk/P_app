     "explicacion": {
      "@es": "do… nên… (formal).",
      "@en": "do-nên-o (formal)."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Aunque hace mal tiempo, el vuelo sale puntual.",
      "@en": "Although it's been a while, the flight's on time."
     },
     "explicacion": {
      "@es": "No hay «aunque».",
      "@en": "No «though»."
     }
    },
    {
     "texto": {
      "@es": "Gracias al buen tiempo, el vuelo llegó pronto.",
      "@en": "Thanks to the good weather, the flight arrived soon."
