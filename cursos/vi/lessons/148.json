    {
     "texto": {
      "@es": "Si hace mal tiempo, no habrá vuelo.",
      "@en": "If it's been a while, there won't be a flight."
     },
     "explicacion": {
      "@es": "No es una condición.",
      "@en": "It's not a condition."
     }
    }
   ]
