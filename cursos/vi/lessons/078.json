   "tipo": "explicacion",
   "titulo": {
    "@es": "Hace… y dentro de…",
    "@en": "It does and inside"
   },
   "texto": [
    {
     "@es": "**cách đây** + tiempo = hace: **cách đây hai năm** = hace dos años · **cách đây hai ngày** = hace dos días.",
     "@en": "**cách đây** + time = ago: **cách đây hai năm** = two years ago · **cách đây hai ngày** = two days ago."
    },
    {
     "@es": "tiempo + **nữa** = dentro de: **mười năm nữa** = dentro de diez años · **hai tháng nữa** = dentro de dos meses.",
     "@en": "time + **nữa** = within: **mười năm nữa** = within ten years · **hai tháng nữa** = within two months."
    },
    {
     "@es": "**năm ngoái** = el año pasado · **sang năm** (o **năm sau**) = el año que viene.",
     "@en": "**năm ngoái** = last year · **sang năm** (or **năm sau**) = next year."
    }
   ]
  },
  {
   "tipo": "dialogo",
