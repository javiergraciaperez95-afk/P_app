  {
   "tipo": "traduccion",
   "pregunta": {
    "@es": "¿Qué significa?",
    "@en": "What does that mean?"
   },
   "frase": "Hôm qua mất điện, hôm nay lại mất điện.",
   "id": "vb198-10",
   "opciones": [
    {
     "texto": {
      "@es": "Ayer se fue la luz y hoy se ha ido otra vez.",
      "@en": "Yesterday the light went out and today it's gone again."
     },
     "explicacion": {
      "@es": "lại + verbo = otra vez.",
      "@en": "lại + verb = again."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Ayer se fue la luz, hoy no.",
      "@en": "The light went out yesterday, not today."
     },
     "explicacion": {
      "@es": "Hoy también.",
      "@en": "Today too."
     }
    },
    {
     "texto": {
      "@es": "Hoy vuelve la luz.",
      "@en": "The light is coming back today."
     },
     "explicacion": "No."
    },
    {
     "texto": {
      "@es": "Siempre hay luz.",
      "@en": "There's always light."
     },
     "explicacion": {
      "@es": "Al contrario.",
      "@en": "On the contrary."
     }
    }
   ]
  },
  {
   "tipo": "traduccion",
   "pregunta": {
    "@es": "¿Qué significa?",
    "@en": "What does that mean?"
   },
   "frase": "Theo bác sĩ, ông ấy sẽ ra viện vào tuần sau.",
   "id": "vb198-11",
   "opciones": [
    {
     "texto": {
      "@es": "Según el médico, le darán el alta la semana que viene.",
      "@en": "According to the doctor, you will be discharged next week."
     },
     "explicacion": {
      "@es": "theo + fuente.",
      "@en": "Theo + source."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "El médico se va la semana que viene.",
      "@en": "The doctor's leaving next week."
     },
     "explicacion": {
      "@es": "El que sale es el paciente.",
      "@en": "The one who comes out is the patient."
     }
    },
    {
     "texto": {
      "@es": "Sigue al médico por el hospital.",
      "@en": "Follow the doctor through the hospital."
     },
     "explicacion": {
      "@es": "Aquí «theo» es «según».",
      "@en": "«theo» here is «according to»."
     }
    },
    {
     "texto": {
      "@es": "Le dieron el alta la semana pasada.",
      "@en": "He was discharged last week."
     },
     "explicacion": {
      "@es": "«tuần sau» es la que viene.",
      "@en": "«tuần sau» is the one coming."
     }
    }
   ]
  },
  {
   "tipo": "traduccion",
   "pregunta": {
    "@es": "¿Qué significa?",
