     "explicacion": {
      "@es": "Al contrario.",
      "@en": "On the contrary."
     }
    },
    {
     "texto": {
      "@es": "No se lo recordé.",
      "@en": "I didn't remind him."
     },
     "explicacion": {
      "@es": "Sí, tres veces.",
      "@en": "Yeah, three times."
     }
    },
    {
     "texto": {
      "@es": "Se me olvidó a mí.",
      "@en": "I forgot."
     },
     "explicacion": "No."
    }
   ]
