   "tipo": "explicacion",
   "titulo": {
    "@es": "Clasificadores nuevos",
    "@en": "New classifiers"
   },
   "texto": [
    {
     "@es": "Ya conoces **cái, con, cuốn/quyển, tờ, quả, đứa, người**. Estos son más:",
     "@en": "You know **cái, con, cuốn/quyển, tờ, quả, đứa, người**. These are more:"
    },
    {
     "@es": "**bức** (cosas planas: fotos, cartas, cuadros): **bức ảnh, bức thư, bức tranh**.",
     "@en": "**bức** (flat things: photos, letters, paintings): **bức ảnh, bức thư, bức tranh**."
    },
    {
     "@es": "**tấm** (piezas planas: espejos, tablas): **tấm gương**.",
     "@en": "**tấm** (flat parts: mirrors, tables): **tấm gương**."
    },
    {
     "@es": "**đôi** (un par): **đôi giày, đôi đũa** · **chiếc** (una pieza de un par): **chiếc giày, chiếc đũa**.",
     "@en": "**đôi** (one pair): **đôi giày, đôi đũa** · **chiếc** (one piece of one pair): **chiếc giày, chiếc đũa**."
    },
    {
     "@es": "**bộ** (un juego): **bộ bàn ghế** (juego de mesa y sillas), **bộ ấm chén** (juego de té).",
     "@en": "**bộ** (one game): **bộ bàn ghế** (table and chair game), **bộ ấm chén** (tea game)."
    },
    {
     "@es": "**bài** (textos): **bài báo, bài hát, bài thơ** · **cuộc** (actividades, reuniones): **cuộc họp**.",
     "@en": "**bài** (texts): **bài báo, bài hát, bài thơ** · **cuộc** (activities, meetings): **cuộc họp**."
    },
    {
     "@es": "**vị** (personas, muy respetuoso): **vị khách** (el invitado). En el restaurante: **Các vị uống gì?** = ¿Qué toman ustedes?",
     "@en": "**vị** (people, very respectful): **vị khách** (the guest). In the restaurant: **Các vị uống gì?** = What do you have?"
    },
    {
     "@es": "Orden completo: **número + clasificador + nombre + adjetivo + này**: **hai quả cam tươi này** = estas dos naranjas frescas.",
     "@en": "Full order: **número + clasificador + nombre + adjetivo + này**: **hai quả cam tươi này** = these two fresh oranges."
    }
   ]
