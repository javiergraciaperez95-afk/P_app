   "texto": [
    {
     "@es": "**Ngày mai anh có rỗi không?** = ¿Estás libre mañana? (rỗi = libre, en el norte; es lo mismo que **rảnh**).",
     "@en": "**Ngày mai anh có rỗi không?** You're free tomorrow?rỗi = free, in the north; it's the same thing that **rảnh**)."
    },
    {
     "@es": "Antes de contestar: **Để tôi nghĩ xem.** = Déjame pensarlo.",
     "@en": "Before you answer: **Để tôi nghĩ xem.** = Let me think about it."
    },
    {
     "@es": "**Hình như ngày mai tôi bận lắm.** = Parece que mañana estoy muy ocupado (hình như = parece que).",
     "@en": "**Hình như ngày mai tôi bận lắm.** = It seems that I am very busy tomorrow (hình như = seems to)."
    },
    {
     "@es": "Si no se puede: **Tiếc quá!** = ¡Qué pena!",
     "@en": "If you can't: **Tiếc quá!** = What a shame!"
    },
    {
     "@es": "Días alrededor de hoy: **hôm kia** (anteayer) · hôm qua · hôm nay · ngày mai · **ngày kia** (pasado mañana).",
     "@en": "Days around today: **hôm kia** (before yesterday) · hôm qua · hôm nay · ngày mai · **ngày kia** (the day after tomorrow)."
    }
   ]
  },
