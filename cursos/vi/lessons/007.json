 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "¿Qué? o ¿cuál?: gì y nào (en la librería)",
    "@en": "What? or which?: gì and nào (in the bookstore)"
   },
   "texto": [
    {
     "@es": "**gì** = qué, sin clasificador: **Anh muốn mua gì?** = ¿Qué quieres comprar?",
     "@en": "**gì** = what, without classifier: **Anh muốn mua gì?** = What do you want to buy?"
    },
    {
     "@es": "**nào** = cuál, con clasificador: **Anh muốn mua cuốn sách nào?** = ¿Qué libro (cuál) quieres comprar? → **Cuốn này.** = Este.",
     "@en": "**nào** = which, with classifier: **Anh muốn mua cuốn sách nào?** = What book (which) do you want to buy? → **Cuốn này.** = This one."
    },
    {
     "@es": "El clasificador se pone cuando hablas de algo concreto (**cuốn sách này** = este libro), pero no cuando hablas en general: **Sách ở đây rẻ lắm.** = Aquí los libros son muy baratos.",
     "@en": "The classifier is put when you talk about something specific (**cuốn sách này** = this book), but not when you talk in general: **Sách ở đây rẻ lắm.** = Here the books are very cheap."
    }
   ]
  },
