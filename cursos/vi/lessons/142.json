 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Hecho por: do",
    "@en": "Done by:"
   },
   "texto": [
    {
     "@es": "**do** + quien lo hace + verbo = hecho por: **Món ăn do mẹ tôi nấu ngon lắm.** = La comida que ha hecho mi madre está riquísima.",
     "@en": "**do** + who does it + verb = made by: **Món ăn do mẹ tôi nấu ngon lắm.** = The food that my mother has made is very rich."
    },
    {
     "@es": "**Bức ảnh này do bố tôi chụp.** = Esta foto la hizo mi padre. Es muy útil para alabar: **Món này do mẹ nấu à? Ngon quá!**",
     "@en": "**Bức ảnh này do bố tôi chụp.** = This picture was made by my father. It is very useful to praise: * * Mon này do mẹ nấu à? Ngon quá!"
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Volverse: trở nên y trở thành",
    "@en": "Back: trở nên and trở thành"
   },
   "texto": [
    {
     "@es": "**trở nên** + adjetivo: **Ngày mai thời tiết sẽ trở nên xấu.** = Mañana el tiempo empeorará.",
     "@en": "**trở nên** + adjective: **Ngày mai thời tiết sẽ trở nên xấu.** = Tomorrow time will get worse."
    },
    {
     "@es": "**trở thành** + nombre: **Anh tôi muốn trở thành luật sư.** = Mi hermano quiere hacerse abogado.",
     "@en": "**trở thành** + name: **Anh tôi muốn trở thành luật sư.** = My brother wants to become a lawyer."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Una y otra vez: đi … lại",
    "@en": "Time and time again: đi-lại"
   },
   "texto": [
    {
     "@es": "verbo + **đi** + verbo + **lại** = una y otra vez: **Tôi đọc đi đọc lại bài này nhưng chưa hiểu.** = He leído este texto una y otra vez, pero aún no lo entiendo.",
     "@en": "verb + **đi** + verb + **lại** = over and over: **Tôi đọc đi đọc lại bài này nhưng chưa hiểu.** = I have read this text over and over, but I still don't understand it."
    },
    {
     "@es": "**Anh ấy hỏi đi hỏi lại tôi.** = Me preguntó una y otra vez.",
     "@en": "**Anh ấy hỏi đi hỏi lại tôi.** = He asked me over and over again."
    }
   ]
  },
