   "titulo": {
    "@es": "¿De qué está hecho? bằng",
    "@en": "What is it made of? bằng"
   },
   "texto": [
    {
     "@es": "**bằng** + material = hecho de: **Bức tranh này bằng lụa.** = Este cuadro es de seda. · **Ngôi nhà của tôi bằng gạch.** = Mi casa es de ladrillo.",
     "@en": "**bằng** + material = made of: **Bức tranh này bằng lụa.** = This box is made of silk. · **Ngôi nhà của tôi bằng gạch.** = My house is made of brick."
    },
    {
     "@es": "Materiales: **gỗ** (madera), **vải** (tela), **lụa** (seda), **nhựa** (plástico), **thủy tinh** (cristal), **sứ** (porcelana), **bạc** (plata), **vàng** (oro), **gạch** (ladrillo), **sơn mài** (laca), **bông** (algodón).",
     "@en": "Materials: **gỗ** (wood), **vải** (fabric), **lụa** (silk), **nhựa** (plastic), **thủy tinh** (glass), **sứ** (porcelain), **bạc** (silver), **vàng** (gold), **gạch** (brick), **sơn mài** (lacquer), **bông** (cotton)."
    }
   ]
