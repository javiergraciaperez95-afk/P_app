    {
     "texto": {
      "@es": "Como nadie dice nada, sigo estudiando.",
      "@en": "As no one says anything, I'm still studying."
     },
     "explicacion": {
      "@es": "No es causa.",
      "@en": "It's not a cause."
     }
    },
    {
     "texto": {
      "@es": "Nadie me dice que estudie.",
      "@en": "Nobody tells me to study."
     },
     "explicacion": "No."
    },
    {
     "texto": {
      "@es": "Si alguien me lo dice, dejaré de estudiar.",
      "@en": "If anyone tells me, I'll stop studying."
     },
     "explicacion": {
      "@es": "Al contrario.",
      "@en": "On the contrary."
     }
    }
   ]
