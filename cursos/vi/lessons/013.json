 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Palabras con «máy» (máquina)",
    "@en": "«máy» (machine)"
   },
   "texto": [
    {
     "@es": "Muchas cosas modernas se forman con **máy** (máquina) + otra palabra:",
     "@en": "Many modern things are formed with **máy** (machine) + another word:"
    },
    {
     "@es": "**máy lạnh** = aire acondicionado (máquina + frío) · **máy bay** = avión (máquina + volar) · **xe máy** = moto (vehículo + máquina) · **máy chụp hình** = cámara de fotos.",
     "@en": "**máy lạnh** = air conditioning (machine + cold) · **máy bay** = plane (machine + fly) · **xe máy** = motorbike (vehicle + machine) · **máy chụp hình** = photo camera."
    },
    {
     "@es": "En casa también oirás **tắm hoa sen** = ducha (lit. «ducharse con flor de loto», por la forma del grifo) y **bồn tắm** = bañera.",
     "@en": "At home you will also hear **tắm hoa sen** = shower (lit. «shower with lotus flower», by the shape of the tap) and **bồn tắm** = bathtub."
    }
   ]
  },
