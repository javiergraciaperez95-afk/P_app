 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Ngữ pháp · nếu… thì… (si…, entonces…)",
    "@en": "Ngữ pháp · nếu-thì-h( if, then)"
   },
   "texto": [
    {
     "@es": "**nếu** = si · **thì** = entonces. Funciona como en español: **Nếu tôi bị bệnh thì tôi sẽ đi khám bệnh** = si me pongo enfermo, iré al médico.",
     "@en": "**nếu** = yes · **thì** = then. It works as in Spanish: **Nếu tôi bị bệnh thì tôi sẽ đi khám bệnh** = if I get sick, I'll go to the doctor."
    },
    {
     "@es": "**thì** se puede quitar a veces, pero es muy normal ponerlo.",
     "@en": "**thì** can be removed sometimes, but it is very normal to put it."
    }
   ]
  },
