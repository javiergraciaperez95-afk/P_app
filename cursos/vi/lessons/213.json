     "explicacion": {
      "@es": "No fue.",
      "@en": "It wasn't."
     }
    },
    {
     "texto": {
      "@es": "No quise ir a la entrevista.",
      "@en": "I didn't want to go to the interview."
     },
     "explicacion": {
      "@es": "No pudo.",
      "@en": "He couldn't."
     }
    }
   ]
