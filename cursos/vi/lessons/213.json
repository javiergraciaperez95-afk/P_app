  {
   "tipo": "traduccion",
   "pregunta": {
    "@es": "¿Qué significa?",
    "@en": "What does that mean?"
   },
   "frase": "Đáng lẽ công ty phải thông báo sớm hơn.",
   "id": "vb213-10",
   "opciones": [
    {
     "texto": {
      "@es": "La empresa tendría que haber avisado antes.",
      "@en": "The company should have called it in earlier."
     },
     "explicacion": {
      "@es": "đáng lẽ… phải… = queja o reproche.",
      "@en": "đáng lẽ-phải-h. is a complaint or reproach."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "La empresa avisó pronto.",
      "@en": "The company called soon."
     },
     "explicacion": {
      "@es": "No lo hizo.",
      "@en": "He didn't."
     }
    },
    {
     "texto": {
      "@es": "La empresa avisará pronto.",
      "@en": "The company will be warning soon."
     },
     "explicacion": {
      "@es": "No es futuro.",
      "@en": "It's not future."
     }
    },
    {
     "texto": {
      "@es": "No hacía falta avisar.",
      "@en": "There was no need to warn."
     },
     "explicacion": {
      "@es": "Al contrario.",
      "@en": "On the contrary."
     }
    }
   ]
  },
  {
   "tipo": "traduccion",
   "pregunta": {
    "@es": "¿Qué significa?",
    "@en": "What does that mean?"
   },
   "frase": "Lỡ anh ấy từ chối thì mình tính sao?",
   "id": "vb213-11",
   "opciones": [
    {
     "texto": {
      "@es": "¿Y si se niega? ¿Qué hacemos?",
      "@en": "What if he refuses? What do we do?"
     },
     "explicacion": {
      "@es": "lỡ… thì… = ¿y si pasa lo malo?",
      "@en": "lỡ… thìWhat if the bad thing happens?"
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Como se ha negado, no hacemos nada.",
      "@en": "As it has been denied, we do nothing."
     },
     "explicacion": {
      "@es": "Aún no ha pasado.",
      "@en": "It hasn't happened yet."
     }
    },
    {
     "texto": {
      "@es": "Si acepta, lo celebramos.",
      "@en": "If you accept, we celebrate."
     },
     "explicacion": {
      "@es": "«từ chối» es negarse.",
      "@en": "«từ chối» is to refuse."
     }
    },
    {
     "texto": {
      "@es": "Ojalá se niegue.",
      "@en": "I wish you'd refuse."
     },
     "explicacion": "No."
    }
   ]
  },
  {
   "tipo": "traduccion",
   "pregunta": {
    "@es": "¿Qué significa?",
    "@en": "What does that mean?"
   },
   "frase": "Giả sử anh là giám đốc, anh sẽ làm gì?",
   "id": "vb213-12",
   "opciones": [
    {
     "texto": {
      "@es": "Supongamos que fueras el director: ¿qué harías?",
      "@en": "Suppose you were the director, what would you do?"
     },
     "explicacion": {
      "@es": "giả sử = hipótesis.",
      "@en": "giả sử = hypothesis."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Eres el director, ¿qué haces?",
      "@en": "You're the director, what are you doing?"
     },
     "explicacion": {
      "@es": "No lo es.",
      "@en": "It's not."
     }
    },
    {
     "texto": {
      "@es": "Cuando seas director, ¿qué harás?",
      "@en": "When you're a director, what are you gonna do?"
     },
     "explicacion": {
      "@es": "No es una previsión.",
      "@en": "It's not a foresight."
     }
    },
    {
     "texto": {
      "@es": "El director no hace nada.",
      "@en": "The director doesn't do anything."
     },
     "explicacion": "No."
    }
   ]
  },
  {
   "tipo": "traduccion",
   "pregunta": {
    "@es": "¿Qué significa?",
    "@en": "What does that mean?"
   },
   "frase": "Chẳng may hôm đó tôi bị ốm nên không đi phỏng vấn được.",
   "id": "vb213-13",
   "opciones": [
    {
     "texto": {
      "@es": "Por desgracia ese día estaba enfermo y no pude ir a la entrevista.",
      "@en": "Unfortunately that day I was sick and I couldn't go to the interview."
