     "explicacion": {
      "@es": "«chẳng may» es mala suerte.",
      "@en": "«chẳng may» is bad luck."
     }
    },
    {
     "texto": {
      "@es": "Fui a la entrevista enfermo.",
      "@en": "I went to the sick interview."
