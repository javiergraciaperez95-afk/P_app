       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Theo truyền thuyết, lịch sử Việt Nam bắt đầu từ các vua Hùng, cách đây khoảng bốn nghìn năm.",
       "alumno": "According to legend, Vietnam's history begins with the Hùng kings, about four thousand years ago.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Theo truyền thuyết",
