   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Reading · Things to do and not to do",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Với nhiều gia đình Việt Nam, Tết không chỉ là dịp nghỉ ngơi mà còn là lúc nhớ về tổ tiên.",
       "alumno": "For many Vietnamese families, Tết is not only a time to rest, but also a moment to remember the ancestors.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Trước Tết, nhà nào cũng phải dọn dẹp thật sạch mới đón được năm mới.",
       "alumno": "Before Tết, every household has to clean thoroughly in order to welcome the new year.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "nhà nào cũng phải dọn dẹp thật sạch",
         "every household must clean thoroughly"
        ],
        [
         "mới đón được năm mới",
         "only then can you welcome the new year"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Người ta cũng cố trả hết nợ của năm cũ để khỏi mang xui xẻo sang năm mới.",
       "alumno": "People also try to pay off all the debts of the old year so as not to bring bad luck into the new one.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "cố trả hết nợ của năm cũ",
         "they try to pay off all the debts of the old year"
        ],
        [
         "để khỏi mang xui xẻo sang năm mới",
         "so as not to bring bad luck into the new year"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Chiều ba mươi Tết, cả nhà bày mâm ngũ quả lên bàn thờ và thắp hương mời tổ tiên về ăn Tết.",
       "alumno": "On the afternoon of the last day of the year, the whole family places the five-fruit tray on the altar and lights incense to invite the ancestors to come and celebrate Tết.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Chiều ba mươi Tết",
         "the afternoon of the 30th (the eve of Tết)"
        ],
        [
         "bày mâm ngũ quả lên bàn thờ",
         "places the five-fruit tray on the altar"
        ],
        [
         "thắp hương",
         "lights incense"
        ],
        [
         "mời tổ tiên về ăn Tết",
         "invites the ancestors to come and celebrate Tết"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Theo quan niệm của một số gia đình, người đầu tiên bước vào nhà sau giao thừa được gọi là người xông đất. Họ thường mong đó là người vui vẻ, thuận lợi để năm mới may mắn.",
       "alumno": "According to the belief of some families, the first person to enter the house after midnight is called xông đất. They usually hope it's someone cheerful and lucky, to bring good fortune in the new year.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Trong ba ngày Tết có nhiều điều kiêng kỵ. Đừng quét nhà ngày mồng một, kẻo quét hết tài lộc ra ngoài.",
       "alumno": "During the three days of Tết there are many things to avoid. Don't sweep the house on the first day, in case you sweep all the good fortune out.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "có nhiều điều kiêng kỵ",
         "there are many taboos"
        ],
        [
         "Đừng quét nhà ngày mồng một",
         "don't sweep the house on the first day"
        ],
        [
         "kẻo quét hết tài lộc ra ngoài",
         "in case you sweep all the good fortune out"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Cũng chớ cãi nhau hay làm vỡ bát đĩa, kẻo cả năm gặp chuyện không vui.",
       "alumno": "Nor should you argue or break plates, in case there are unhappy events all year.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "chớ cãi nhau hay làm vỡ bát đĩa",
         "you mustn't argue or break crockery"
        ],
        [
         "kẻo cả năm gặp chuyện không vui",
         "in case there are unpleasant things all year"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Trẻ em thì thích nhất là đi chúc Tết ông bà để được nhận lì xì.",
       "alumno": "What children enjoy most is going to wish their grandparents a happy new year to receive the red envelope.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "đi chúc Tết ông bà",
         "going to wish grandparents a happy new year"
        ],
        [
         "để được nhận lì xì",
         "to receive the red envelope"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Một số người trẻ ngày nay không tin vào những điều kiêng kỵ ấy nữa. Dù vậy, có gia đình vẫn giữ một vài phong tục để ông bà vui lòng.",
       "alumno": "Some young people today no longer believe in those taboos. Even so, some families keep some customs to please the grandparents.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
