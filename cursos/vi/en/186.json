        [
         "mà chăm chú thế",
         "that you're so absorbed"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Chị Lan",
        "lengua": "estudio"
       },
       "estudio": "À, một cuốn tiểu thuyết của Nguyễn Nhật Ánh. Em nghe nói đến tác giả này chưa?",
       "alumno": "Oh, a novel by Nguyễn Nhật Ánh. Have you heard of this author?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "một cuốn tiểu thuyết của Nguyễn Nhật Ánh",
         "a novel by Nguyễn Nhật Ánh"
        ],
        [
         "Em nghe nói đến tác giả này chưa",
         "have you heard of this author?"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Carlos",
        "lengua": "estudio"
       },
       "estudio": "Em nghe thầy Quang nói là sách của ông ấy rất dễ đọc với người nước ngoài.",
       "alumno": "I've heard Professor Quang say that his books are very easy to read for foreigners.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Em nghe thầy Quang nói là",
         "I heard Professor Quang say that"
        ],
        [
         "rất dễ đọc với người nước ngoài",
         "very easy to read for foreigners"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Chị Lan",
        "lengua": "estudio"
       },
       "estudio": "Đúng thế. Lối viết của ông nhẹ nhàng mà sâu sắc. Theo chị, đây là cuốn hay nhất.",
       "alumno": "That's right. His style is light and yet deep. In my opinion, this is his best.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Lối viết của ông nhẹ nhàng mà sâu sắc",
         "his style is light but deep"
        ],
        [
         "Theo chị",
         "in my opinion"
        ],
        [
         "đây là cuốn hay nhất",
         "this is the best (book)"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Carlos",
        "lengua": "estudio"
       },
       "estudio": "Sách kể về gì hả chị?",
       "alumno": "What's it about?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Sách kể về gì",
         "what the book is about"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Chị Lan",
        "lengua": "estudio"
       },
       "estudio": "Về tuổi thơ ở một làng quê. Nghe nói sách đã được dịch ra tiếng Anh và tiếng Nhật rồi.",
       "alumno": "It's about childhood in a village. They say it's already been translated into English and Japanese.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Về tuổi thơ ở một làng quê",
         "about childhood in a village"
        ],
