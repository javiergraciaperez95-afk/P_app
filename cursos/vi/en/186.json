     "titulo": "Dialogue · At the bookshop café",
     "frases": [
      {
       "quien": {
        "texto": "Carlos",
        "lengua": "estudio"
       },
       "estudio": "Chị Lan đang đọc gì mà chăm chú thế?",
       "alumno": "What are you reading so intently, Lan?",
       "literal": "",
       "estructura": "",
       "nota": [],
