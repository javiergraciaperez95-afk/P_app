        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Carlos",
        "lengua": "estudio"
       },
       "estudio": "Theo báo chí thì cuốn nào của ông ấy cũng bán chạy, phải không chị?",
       "alumno": "According to the press, all his books sell really well, don't they?",
       "literal": "",
       "estructura": "",
       "nota": [],
