 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "để (to, in order to)",
     "texto": [
      "**để** + verb says why something is done, like «to» in «I came to study»: **Tôi đến Việt Nam để học tiếng Việt** = I came to Vietnam to study Vietnamese."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "cho (for someone)",
     "texto": [
      "**cho** is also «for», but **for a person** (the recipient): **Tôi sẽ mua một cái áo sơ mi cho bạn** = I'll buy you a shirt (for you).",
      "Summary: **để** + verb (to do something) · **cho** + person (for someone)."
     ],
     "tutora": ""
    }
   ]
  },
