         "fined for posting fake news"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Các chuyên gia khuyên nên bảo vệ thông tin cá nhân và không chia sẻ những gì mình không muốn cả thế giới biết.",
       "alumno": "Experts advise protecting personal data and not sharing what you don't want the whole world to know.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Các chuyên gia khuyên",
         "experts advise"
        ],
