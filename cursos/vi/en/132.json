 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Leaving a message",
     "texto": [
      "**Làm ơn cho tôi nói chuyện với anh Nam.** = Could I speak to Nam, please?",
      "**Rất tiếc, anh ấy vừa mới đi ngân hàng.** = Sorry, he has just gone to the bank.",
      "**Anh có nhắn gì không?** = Would you like to leave a message? · **Làm ơn nhắn anh ấy gọi điện cho tôi.** = Please tell him to call me.",
      "**Anh yên tâm, tôi sẽ chuyển lời.** = Don't worry, I'll pass it on."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Oneself: tự … lấy",
     "texto": [
      "**tự** before the verb and/or **lấy** after it = doing it on your own, without help:",
      "**Tôi tự dịch bài thơ này.** = **Tôi dịch lấy bài thơ này.** = **Tôi tự dịch lấy bài thơ này.** = I translated this poem on my own.",
      "**Anh Thảo tự chữa xe đạp.** = Thảo fixed the bike himself.",
      "And remember: **một mình** = alone (without company): **Tối qua tôi ở nhà một mình.** = Last night I was at home alone."
     ],
     "tutora": ""
    }
   ]
  },
