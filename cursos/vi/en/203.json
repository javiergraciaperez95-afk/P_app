     "tipo": "texto",
     "titulo": "Reading · Book exchange notice",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Cuối tháng này, nhà văn hóa quận tổ chức ngày đổi sách.",
       "alumno": "At the end of this month, the district cultural centre is holding a book exchange day.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Mỗi người có thể mang tối đa năm cuốn sách đã đọc để đổi lấy sách khác.",
       "alumno": "Each person can bring up to five books they have already read to swap for others.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Sách phải còn nguyên vẹn; ban tổ chức không nhận sách thiếu trang.",
       "alumno": "The books must be in good condition; the organisers do not accept books with missing pages.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Chương trình bắt đầu lúc tám giờ sáng và kết thúc lúc bốn giờ chiều.",
       "alumno": "The event starts at eight in the morning and ends at four in the afternoon.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Nếu trời mưa, hoạt động sẽ chuyển vào hội trường.",
       "alumno": "If it rains, the activity will move into the hall.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Khu vực có ít chỗ đỗ xe, vì vậy ban tổ chức khuyên mọi người đi xe buýt.",
       "alumno": "The area has few parking spaces, so the organisers recommend going by bus.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
