        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Một cô hàng xóm chỉ cho mình chợ gần nhất, còn đồng nghiệp rủ mình đi ăn trưa.",
       "alumno": "One neighbour showed me the nearest market, and a colleague invited me to lunch.",
       "literal": "",
