       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Dần dần mình thấy cuộc sống ở đây dễ chịu hơn; đi làm cũng chỉ mất mười lăm phút.",
       "alumno": "Little by little life here feels more pleasant; besides, it only takes me fifteen minutes to get to work.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Cuối tháng này bạn đến chơi nhé, mình sẽ dẫn bạn đi quanh khu phố.",
       "alumno": "Come and visit at the end of the month; I'll show you around the neighbourhood.",
