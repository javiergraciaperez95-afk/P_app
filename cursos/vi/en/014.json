 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Countries and nationalities",
     "texto": [
      "Country = **nước** + name: **nước Việt Nam** = Vietnam, **nước Mỹ** = the United States.",
      "Nationality = **người** (person) + country: **người Việt Nam** (or **người Việt**) = Vietnamese; **người Tây Ban Nha** = Spanish.",
      "Language = **tiếng** + country: **tiếng Việt** = Vietnamese (the language), **tiếng Anh** = English, **tiếng Tây Ban Nha** = Spanish.",
      "To ask: **Bạn là người nước nào?** = What country are you from? (lit. «are you a person of which country?»). **nào** (which) goes after the noun, in the place of the answer."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Where are you coming from? (ở đâu đến)",
     "texto": [
      "**Anh ở đâu đến?** or **Anh từ đâu đến?** = Where are you coming from? (lit. «from where do you arrive?»).",
      "You answer with the place: **Tôi ở Tây Ban Nha đến.** / **Tôi từ Madrid đến.** = I come from Spain / from Madrid.",
      "**người nước ngoài** = foreigner. **nước ngoài** = a foreign country (lit. «outside country»). **Pháp** = France."
     ],
     "tutora": ""
    }
   ]
  },
