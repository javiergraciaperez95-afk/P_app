     "tipo": "texto",
     "titulo": "How to apply for a library card",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Để đăng ký thẻ, bạn cần điền mẫu đơn và xuất trình giấy tờ tùy thân tại quầy.",
       "alumno": "To apply for the card, you need to fill in the form and show an identity document at the counter.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Người dưới mười sáu tuổi phải có chữ ký của cha mẹ hoặc người giám hộ.",
       "alumno": "People under sixteen need the signature of a parent or guardian.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Mỗi lần bạn được mượn tối đa bốn cuốn sách trong ba tuần.",
       "alumno": "Each time, you can borrow up to four books for three weeks.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Có thể gia hạn một lần nếu sách chưa được người khác đặt trước.",
       "alumno": "It can be renewed once if no one else has reserved the book.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Sách quá hạn bị tính phí theo số ngày chậm.",
       "alumno": "Overdue books are charged according to the number of days late.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
