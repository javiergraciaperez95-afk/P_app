  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Eight sayings worth knowing",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "«Có công mài sắt, có ngày nên kim.» Ai kiên trì mài một thanh sắt thì sẽ có ngày nó thành cây kim. Câu này khuyên ta đừng bỏ cuộc.",
       "alumno": "«Whoever toils at filing iron will one day have a needle». Whoever steadily files a bar of iron ends up seeing it turned into a needle. It advises not giving up.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Có công mài sắt",
         "if you toil at filing iron"
        ],
        [
         "có ngày nên kim",
         "the day will come when it becomes a needle"
        ],
        [
         "Câu này khuyên ta đừng bỏ cuộc",
         "this saying advises us not to give up"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "«Vạn sự khởi đầu nan.» Việc gì cũng khó lúc bắt đầu. Người ta nói câu này để động viên người mới học, mới làm.",
       "alumno": "«Every beginning is difficult». Anything costs something at the start. It's said to encourage someone who is starting to study or work.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Vạn sự khởi đầu nan",
         "all things are difficult at the start"
        ],
        [
         "Việc gì cũng khó lúc bắt đầu",
         "any task is hard to begin with"
        ],
        [
         "để động viên người mới học, mới làm",
         "to encourage someone who is just starting out"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "«Đi một ngày đàng, học một sàng khôn.» Đi xa một ngày là học được rất nhiều điều. Câu này nói về giá trị của việc đi đây đi đó.",
       "alumno": "«A day on the road, a sieve of wisdom». A day's journey teaches a great many things. It speaks of the value of seeing the world.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Đi một ngày đàng",
         "going a day's journey on the road"
        ],
        [
         "học một sàng khôn",
         "learning a sieve of wisdom"
        ],
        [
         "giá trị của việc đi đây đi đó",
         "the value of travelling about"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "«Gần mực thì đen, gần đèn thì sáng.» Ở gần người xấu thì dễ thành xấu, ở gần người tốt thì tốt lên. Cha mẹ hay nói câu này khi con chọn bạn.",
       "alumno": "«Near the ink, black; near the lamp, bright». Close to bad people it's easy to turn bad; close to good people, one improves. Parents often say this when their children choose friends.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Gần mực thì đen",
         "near the ink you turn black"
        ],
        [
         "gần đèn thì sáng",
         "near the lamp, bright"
        ],
        [
         "Cha mẹ hay nói câu này khi con chọn bạn",
         "parents say this when a child chooses friends"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "«Uống nước nhớ nguồn.» Khi uống nước, hãy nhớ đến nơi nước chảy ra. Nghĩa là phải biết ơn tổ tiên và những người đã giúp mình.",
       "alumno": "«When you drink water, remember the source». When you drink, remember where the water springs from. That is: one must be grateful to the ancestors and to those who helped us.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Uống nước nhớ nguồn",
         "when you drink water, remember the source"
        ],
        [
         "nơi nước chảy ra",
         "the place where the water springs from"
        ],
        [
         "phải biết ơn tổ tiên",
         "one must be grateful to the ancestors"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "«Lá lành đùm lá rách.» Chiếc lá còn lành bọc lấy chiếc lá đã rách: người có điều kiện giúp người gặp khó khăn. Câu này thường thấy trên báo sau mỗi mùa bão lũ.",
       "alumno": "«The healthy leaf shelters the torn leaf». The whole leaf wraps around the torn one: whoever can, helps whoever is struggling. It is often quoted in the press after each typhoon season.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Chiếc lá còn lành bọc lấy chiếc lá đã rách",
         "the healthy leaf wraps around the torn one"
        ],
        [
         "người có điều kiện giúp người gặp khó khăn",
         "whoever has means helps whoever has difficulties"
        ],
        [
         "sau mỗi mùa bão lũ",
         "after each typhoon and flood season"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "«Tốt gỗ hơn tốt nước sơn.» Gỗ tốt quan trọng hơn lớp sơn đẹp: tính cách quý hơn vẻ ngoài.",
       "alumno": "«Better good wood than good paint». Good wood matters more than a nice coat of paint: character is worth more than appearance.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Tốt gỗ hơn tốt nước sơn",
         "better good wood than good paint"
        ],
        [
         "tính cách quý hơn vẻ ngoài",
         "character is worth more than appearance"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "«Nước đến chân mới nhảy.» Chờ nước lên đến chân rồi mới nhảy: để đến phút cuối mới làm. Sinh viên trước ngày thi hiểu câu này hơn ai hết!",
       "alumno": "«He doesn't jump until the water reaches his feet». Waiting for the water to reach your feet before jumping: leaving everything to the last minute. Students, on the eve of an exam, understand it better than anyone!",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Chờ nước lên đến chân rồi mới nhảy",
         "waiting for the water to reach your feet before jumping"
        ],
        [
         "để đến phút cuối mới làm",
         "leaving it to the last minute"
        ],
        [
         "hiểu câu này hơn ai hết",
         "they understand it better than anyone"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Ngoài ra còn hai câu ngắn rất hay dùng: «Có chí thì nên» (có quyết tâm thì thành công) và «Chậm mà chắc» (làm chậm nhưng chắc chắn).",
       "alumno": "There are also two very short and very common ones: «Where there's a will, there's a way» (with determination you succeed) and «Slow but sure».",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Có chí thì nên",
         "with will, you get somewhere"
        ],
        [
         "có quyết tâm thì thành công",
         "with determination you succeed"
        ],
        [
         "Chậm mà chắc",
         "slow but sure"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
   ]
