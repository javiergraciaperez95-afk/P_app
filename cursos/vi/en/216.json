        [
         "tôi tự giới hạn",
         "I set limits on myself"
        ],
        [
         "điện thoại ở chế độ im lặng",
         "the phone on silent mode"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Điện thoại thông minh, nhưng người dùng phải thông minh hơn.",
       "alumno": "The phone is smart, but the user must be smarter.",
       "literal": "",
       "estructura": "",
