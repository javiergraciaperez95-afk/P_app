   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Reading · It's never too late to learn",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Ngày xưa, người ta nghĩ rằng việc học kết thúc khi ta rời ghế nhà trường. Ngày nay, quan niệm đó đã lạc hậu.",
       "alumno": "People used to think learning ended when you left school. Today that idea has become outdated.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "việc học kết thúc",
         "learning ends"
        ],
        [
         "khi ta rời ghế nhà trường",
         "when you leave the school desk"
        ],
        [
         "quan niệm đó đã lạc hậu",
         "that idea is outdated"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Công nghệ thay đổi nhanh đến mức những kỹ năng học hôm nay có thể không còn dùng được sau năm năm nữa.",
       "alumno": "Technology changes so fast that what is learned today may no longer be useful within five years.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "thay đổi nhanh đến mức",
         "technology changes so fast that"
        ],
        [
         "những kỹ năng học hôm nay",
         "the skills learned today"
        ],
        [
         "có thể không còn dùng được",
         "may no longer be useful"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Vì vậy, học suốt đời không còn là một lựa chọn mà là một nhu cầu của thị trường lao động.",
       "alumno": "So lifelong learning is no longer an option, but a necessity of the labour market.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "học suốt đời",
         "lifelong learning"
        ],
        [
         "không còn là một lựa chọn",
         "is no longer an option"
        ],
        [
         "mà là một nhu cầu",
         "but a necessity"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Đối với người đi làm, các khóa học trực tuyến là giải pháp linh hoạt nhất: họ có thể học bất cứ lúc nào, ở bất cứ đâu.",
       "alumno": "For people who work, online courses are the most flexible solution: you can study at any time and from any place.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Đối với người đi làm",
         "for people who work"
        ],
        [
         "các khóa học trực tuyến",
         "online courses"
        ],
        [
         "là giải pháp linh hoạt nhất",
         "are the most flexible solution"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Về mặt chi phí, học trực tuyến cũng rẻ hơn nhiều so với học ở trường; nhiều nền tảng thậm chí còn miễn phí.",
       "alumno": "As regards cost, studying online is also much cheaper than studying at a centre; many platforms are even free.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Về mặt chi phí",
         "as regards cost"
        ],
        [
         "rẻ hơn nhiều so với học ở trường",
         "much cheaper than studying at a centre"
        ],
        [
         "nhiều nền tảng thậm chí còn miễn phí",
         "many platforms are even free"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Tuy nhiên, xét về hiệu quả thì mọi chuyện không đơn giản như vậy.",
       "alumno": "However, if we look at effectiveness, things aren't that simple.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "xét về hiệu quả",
         "if we consider effectiveness"
        ],
        [
         "thì mọi chuyện không đơn giản như vậy",
         "things aren't that simple"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Học một mình trước màn hình đòi hỏi tính tự giác và kỷ luật rất cao. Thiếu sự tương tác với thầy cô và bạn bè, nhiều người nhanh chóng mất động lực.",
       "alumno": "Studying alone in front of a screen demands a great deal of initiative and discipline. Without interaction with teachers and classmates, many people quickly lose motivation.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "đòi hỏi tính tự giác và kỷ luật rất cao",
         "demands very high initiative and discipline"
        ],
        [
         "Thiếu sự tương tác",
         "without interaction"
        ],
        [
         "nhiều người nhanh chóng mất động lực",
         "many people quickly lose motivation"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Theo một số nghiên cứu, chỉ khoảng mười phần trăm người đăng ký học hết một khóa học miễn phí.",
       "alumno": "According to some studies, only around ten per cent of those who sign up finish a free course.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Theo một số nghiên cứu",
         "according to some studies"
        ],
        [
         "chỉ khoảng mười phần trăm người đăng ký",
         "only about ten per cent of those enrolled"
        ],
        [
         "học hết một khóa học miễn phí",
         "finish a free course"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Về phần tôi, tôi cho rằng cách tốt nhất là kết hợp cả hai: học lý thuyết trên mạng và thực hành với người thật.",
       "alumno": "As for me, I think the best approach is to combine both: theory online and practice with real people.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Về phần tôi",
         "as for me"
        ],
        [
         "cách tốt nhất là kết hợp cả hai",
         "the best way is to combine both"
        ],
        [
         "học lý thuyết trên mạng",
         "learning the theory online"
        ],
        [
         "thực hành với người thật",
         "practising with real people"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Dù học bằng cách nào, điều quan trọng nhất vẫn là giữ được niềm vui khi học.",
       "alumno": "However you study, the most important thing is still not to lose the joy of learning.",
       "literal": "",
       "estructura": "",
       "nota": [],
