      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Hạn hán kéo dài khiến cho hàng trăm nghìn gia đình thiếu nước ngọt để uống và để tưới lúa.",
       "alumno": "Prolonged drought means that hundreds of thousands of families lack fresh water to drink and to water the rice.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Hạn hán kéo dài",
         "prolonged drought"
        ],
