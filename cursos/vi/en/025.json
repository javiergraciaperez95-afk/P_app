   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Wanting and liking",
     "texto": [
      "**muốn** + verb = to want to do something: **Tôi muốn uống nước** = I want to drink water. **Bạn muốn ăn gì?** = What do you want to eat?",
      "**thích** + verb or thing = to like: **Bạn thích uống cam vắt không?** = Do you like freshly squeezed orange juice?",
      "As always, you answer with the verb: **Thích.** (I like it) / **Thích lắm.** (I like it a lot) / **Không (thích).** (I don't like it).",
      "Culture: **cà phê sữa đá** (coffee with condensed milk and ice) and **phở** are two Vietnamese classics."
     ],
     "tutora": ""
    }
   ]
