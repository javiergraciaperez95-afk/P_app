   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Made by: do",
     "texto": [
      "**do** + who does it + verb = made by: **Món ăn do mẹ tôi nấu ngon lắm.** = The food my mother cooks is very tasty.",
      "**Bức ảnh này do bố tôi chụp.** = This photo was taken by my father. It's very useful for praising: **Món này do mẹ nấu à? Ngon quá!**"
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Becoming: trở nên and trở thành",
     "texto": [
      "**trở nên** + adjective: **Ngày mai thời tiết sẽ trở nên xấu.** = Tomorrow the weather will get worse.",
      "**trở thành** + noun: **Anh tôi muốn trở thành luật sư.** = My older brother wants to become a lawyer."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Over and over: đi … lại",
     "texto": [
      "verb + **đi** + verb + **lại** = over and over: **Tôi đọc đi đọc lại bài này nhưng chưa hiểu.** = I've read this text over and over, but I still don't understand it.",
      "**Anh ấy hỏi đi hỏi lại tôi.** = He asked me over and over."
     ],
     "tutora": ""
    }
   ]
  },
