     "titulo": "Reading · Grandmother's kitchen",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Mỗi khi trời mưa, tôi lại nhớ cái bếp của bà.",
       "alumno": "Every time it rains, I remember my grandmother's kitchen.",
       "literal": "",
       "estructura": "",
       "nota": [],
