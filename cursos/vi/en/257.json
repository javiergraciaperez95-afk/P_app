        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Bây giờ bà mất đã mười năm. Nhà tôi ở tầng mười hai, bếp điện sáng bóng, không khói, không tro.",
       "alumno": "She has been gone for ten years now. I live on the twelfth floor, with a gleaming electric hob, no smoke and no ash.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
