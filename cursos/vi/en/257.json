        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Bà ngồi đó, lưng còng, đôi bàn tay nhăn nứt tựa như vỏ cây, chầm chậm cho thêm củi.",
       "alumno": "Grandmother would sit there, hunched, with wrinkled hands cracked like tree bark, slowly adding firewood.",
