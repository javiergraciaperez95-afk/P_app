       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Mưa rơi lách tách trên mái hiên. Trong bếp, lửa cũng lách tách trả lời.",
       "alumno": "The rain pattered on the eaves. Inside, the fire answered back, crackling.",
       "literal": "",
