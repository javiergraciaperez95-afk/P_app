      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Nhưng cứ nghe mưa là tôi lại thấy đói. Không phải đói khoai. Đói cái hơi ấm ấy.",
       "alumno": "But hearing the rain makes me hungry again. Not for sweet potato. For that warmth.",
       "literal": "",
       "estructura": "",
       "nota": [],
