     "titulo": "Reading · The fifteenth day of the eighth month",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Tết Trung thu được tổ chức vào ngày rằm tháng tám âm lịch, khi trăng tròn và sáng nhất trong năm.",
       "alumno": "The Mid-Autumn Festival is celebrated on the 15th day of the eighth lunar month, when the moon is rounder and brighter than at any other time of the year.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "được tổ chức",
         "is celebrated"
        ],
