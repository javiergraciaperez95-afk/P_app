       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Sau đó, cả nhà tụ họp ngoài sân để phá cỗ và ngắm trăng.",
       "alumno": "Afterwards, the whole family gathers in the courtyard to eat the sweets and gaze at the moon.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "cả nhà tụ họp ngoài sân",
         "the whole family gathers in the courtyard"
        ],
        [
