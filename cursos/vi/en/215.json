        "lengua": "estudio"
       },
       "estudio": "Thế thì vẫn cần người kiểm tra lại.",
       "alumno": "So someone still needs to check it.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
