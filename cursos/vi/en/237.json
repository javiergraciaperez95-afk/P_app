       "quien": {
        "texto": "Carlos",
        "lengua": "estudio"
       },
       "estudio": "Thật ạ? Sao anh ấy không nói thẳng?",
       "alumno": "Really? Why doesn't he say so plainly?",
       "literal": "",
       "estructura": "",
       "nota": [],
