       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Chị Lan",
        "lengua": "estudio"
       },
       "estudio": "À, «để tôi xem đã» thường có nghĩa là «không» đấy em ạ.",
       "alumno": "Ah, «let me look at it» usually means «no».",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
