       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Chị Lan",
        "lengua": "estudio"
       },
       "estudio": "Vì từ chối thẳng thừng dễ làm mất lòng. Người Việt thích giữ hòa khí và giữ thể diện cho nhau.",
       "alumno": "Because refusing outright easily offends. We Vietnamese like to keep harmony and make sure nobody loses face.",
       "literal": "",
       "estructura": "",
       "nota": [],
