      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Chỉ trong vài tuần, hàng triệu người lao động phải mang máy tính về nhà và học cách họp trực tuyến.",
       "alumno": "In just a few weeks, millions of workers had to take their computers home and learn to hold meetings by video call.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
