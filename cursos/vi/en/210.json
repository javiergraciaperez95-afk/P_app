         "learn to hold meetings online"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "May mà công nghệ đã sẵn sàng, không thì nhiều doanh nghiệp đã phải đóng cửa.",
       "alumno": "Thankfully the technology was ready; otherwise many companies would have had to close.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
