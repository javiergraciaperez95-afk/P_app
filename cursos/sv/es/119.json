       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Kund",
        "lengua": "estudio"
       },
       "estudio": "Kan ni skicka en skriftlig bekräftelse med sista giltighetsdag?",
       "alumno": "¿Pueden enviar una confirmación por escrito con el último día de vigencia?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Kundservice",
        "lengua": "estudio"
       },
       "estudio": "Självklart. Här är ditt ärendenummer.",
       "alumno": "Por supuesto. Aquí está tu número de caso.",
