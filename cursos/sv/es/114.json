     "titulo": "I kommunfullmäktige",
     "frases": [
      {
       "quien": {
        "texto": "Mira",
        "lengua": "alumno"
       },
       "estudio": "Jag föreslår ett pilotprojekt med billigare busskort under sex månader.",
       "alumno": "Propongo un proyecto piloto con abonos de autobús más baratos durante seis meses.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ali",
        "lengua": "estudio"
       },
       "estudio": "En invändning är att kommunen kan få högre kostnader.",
       "alumno": "Una objeción es que el municipio podría tener costes más altos.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Mira",
        "lengua": "alumno"
       },
       "estudio": "Det är möjligt. För att kunna bedöma effekten behöver vi mäta hur många fler som reser med buss.",
       "alumno": "Es posible. Para poder evaluar el efecto, tenemos que medir cuántas personas más viajan en autobús.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ali",
        "lengua": "estudio"
       },
       "estudio": "Om resultatet är positivt kan avgiften justeras efteråt.",
       "alumno": "Si el resultado es positivo, la tasa podrá ajustarse después.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
