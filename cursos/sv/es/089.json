     "titulo": "Ett förslag på mötet",
     "frases": [
      {
       "quien": {
        "texto": "Ali",
        "lengua": "estudio"
       },
       "estudio": "Vad skulle ni tycka om att plantera fler träd på gården?",
       "alumno": "¿Qué les parecería plantar más árboles en el patio?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Maja",
        "lengua": "alumno"
       },
       "estudio": "Det vore trevligt. Det skulle också ge skugga på sommaren.",
       "alumno": "Sería agradable. También daría sombra en verano.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ali",
        "lengua": "estudio"
       },
       "estudio": "Det innebär förstås en kostnad, men på lång sikt kan det bli bättre.",
       "alumno": "Claro que implica un coste, pero a largo plazo puede mejorar las cosas.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Maja",
        "lengua": "alumno"
       },
       "estudio": "Vi kan ta reda på priset innan vi bestämmer oss.",
       "alumno": "Podemos averiguar el precio antes de decidirnos.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
