       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Omar",
        "lengua": "alumno"
       },
       "estudio": "Då skulle fler kunna lämna bilen hemma.",
