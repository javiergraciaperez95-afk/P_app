        "texto": "Kim",
        "lengua": "alumno"
       },
       "estudio": "Självklart. Vill du ha mjölk i teet?",
       "alumno": "Claro. ¿Quieres leche en el té?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ali",
        "lengua": "estudio"
       },
       "estudio": "Nej tack, men lite socker.",
       "alumno": "No, gracias, pero un poco de azúcar.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Kim",
        "lengua": "alumno"
       },
       "estudio": "Varsågod. Betalar du här?",
       "alumno": "Aquí tienes. ¿Pagas aquí?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ali",
        "lengua": "estudio"
       },
       "estudio": "Ja, tack.",
       "alumno": "Sí, gracias.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
