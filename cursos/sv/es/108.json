     "frases": [
      {
       "quien": {
        "texto": "Nora",
        "lengua": "alumno"
       },
       "estudio": "Jag har sovit sämre den senaste tiden.",
       "alumno": "Últimamente he dormido peor.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Leo",
        "lengua": "estudio"
       },
       "estudio": "Tror du att arbetsbelastningen påverkar sömnen?",
       "alumno": "¿Crees que la carga de trabajo afecta al sueño?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nora",
        "lengua": "alumno"
       },
       "estudio": "Kanske, men det kan bero på flera saker. Jag har också ändrat min kvällsrutin.",
       "alumno": "Quizá, pero puede deberse a varias cosas. También he cambiado mi rutina de la tarde.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Leo",
        "lengua": "estudio"
       },
       "estudio": "Ju mer tid jag tar för återhämtning, desto bättre mår jag i längden.",
       "alumno": "Cuanto más tiempo dedico a recuperarme, mejor me encuentro a la larga.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
