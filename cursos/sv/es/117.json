   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Vid middagen",
     "frases": [
      {
       "quien": {
        "texto": "Nora",
        "lengua": "alumno"
       },
       "estudio": "Hur var vandringen i fjällen?",
       "alumno": "¿Qué tal fue la caminata por las montañas?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Leo",
        "lengua": "estudio"
       },
       "estudio": "Vädret var fint när vi började, men medan vi gick blev stigen allt smalare.",
       "alumno": "Hacía buen tiempo cuando empezamos, pero mientras caminábamos el sendero se iba haciendo cada vez más estrecho.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nora",
        "lengua": "alumno"
       },
       "estudio": "Vad hände sedan?",
       "alumno": "¿Qué pasó después?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Leo",
        "lengua": "estudio"
       },
       "estudio": "Vi upptäckte en omledning och tog en omväg. Till slut kom vi fram före mörkret.",
       "alumno": "Encontramos una ruta alternativa y dimos un rodeo. Al final llegamos antes de que oscureciera.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nora",
        "lengua": "alumno"
       },
       "estudio": "Skulle du göra om resan?",
       "alumno": "¿Repetirías el viaje?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Leo",
        "lengua": "estudio"
       },
       "estudio": "Absolut. I efterhand minns jag mest hur vackert det var.",
       "alumno": "Sin duda. En retrospectiva, recuerdo sobre todo lo bonito que era.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
