      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En högre avgift kan få hushåll att sortera mer.",
       "alumno": "Una tasa más alta puede hacer que los hogares separen más los residuos.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Samtidigt påverkas familjer med låg inkomst mer än hushåll som har större ekonomiska marginaler.",
       "alumno": "Al mismo tiempo, las familias con bajos ingresos se ven más afectadas que los hogares con más margen económico.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Kommunen överväger därför en kompensation för vissa hushåll.",
       "alumno": "Por eso, el municipio considera una compensación para algunos hogares.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
