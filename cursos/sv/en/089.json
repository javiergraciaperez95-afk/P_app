     "frases": [
      {
       "quien": {
        "texto": "Ali",
        "lengua": "estudio"
       },
       "estudio": "Vad skulle ni tycka om att plantera fler träd på gården?",
       "alumno": "What would you think of planting more trees in the courtyard?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Maja",
        "lengua": "alumno"
       },
       "estudio": "Det vore trevligt. Det skulle också ge skugga på sommaren.",
       "alumno": "That would be nice. It would also give shade in summer.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ali",
        "lengua": "estudio"
       },
       "estudio": "Det innebär förstås en kostnad, men på lång sikt kan det bli bättre.",
       "alumno": "Of course it involves a cost, but in the long term things could improve.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Maja",
        "lengua": "alumno"
       },
       "estudio": "Vi kan ta reda på priset innan vi bestämmer oss.",
       "alumno": "We can find out the price before we decide.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
