    {
     "tipo": "explicacion",
     "titulo": "Definite form",
     "texto": [
      "Swedish often adds an ending to the noun to say «the»: **en stol → stolen**, **ett bord → bordet**.",
      "**Var är…?** means «where is…?»."
     ],
     "tutora": ""
    }
   ]
