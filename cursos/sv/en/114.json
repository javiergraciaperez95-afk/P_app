       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ali",
        "lengua": "estudio"
       },
       "estudio": "Om resultatet är positivt kan avgiften justeras efteråt.",
       "alumno": "If the result is positive, the fee can be adjusted afterwards.",
