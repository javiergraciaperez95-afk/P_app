   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Linking words",
     "texto": [
      "**Därför** introduces a consequence in a main clause: **Det regnar. Därför stannar vi hemma.**",
      "**Trots att** means «although». In that subordinate clause, the subject comes before the verb."
     ],
     "tutora": ""
    }
   ]
  },
