       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Maja",
        "lengua": "alumno"
       },
       "estudio": "De kan ha använt olika mätperioder.",
       "alumno": "They may have used different measurement periods.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Omar",
        "lengua": "alumno"
       },
       "estudio": "Då bör vi kontrollera källorna innan vi drar en slutsats.",
       "alumno": "So we should check the sources before drawing a conclusion.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
