   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Complex narrative",
     "texto": [
      "The **preteritum** tells events set in the past: **Vi gick vilse** («We got lost»). The **perfekt** presents a past experience that is relevant now: **Vi har gått den vägen förut** («We have been down that path before»). **Medan** can place parallel actions; **till slut** introduces the outcome."
     ],
     "tutora": ""
    }
   ]
  },
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Vid middagen",
     "frases": [
      {
       "quien": {
        "texto": "Nora",
        "lengua": "alumno"
       },
       "estudio": "Hur var vandringen i fjällen?",
       "alumno": "How was the hike in the mountains?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Leo",
        "lengua": "estudio"
       },
       "estudio": "Vädret var fint när vi började, men medan vi gick blev stigen allt smalare.",
       "alumno": "The weather was nice when we started, but while we walked the path got narrower and narrower.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nora",
        "lengua": "alumno"
       },
       "estudio": "Vad hände sedan?",
       "alumno": "What happened next?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Leo",
        "lengua": "estudio"
       },
       "estudio": "Vi upptäckte en omledning och tog en omväg. Till slut kom vi fram före mörkret.",
       "alumno": "We found an alternative route and made a detour. In the end we got there before dark.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nora",
        "lengua": "alumno"
       },
       "estudio": "Skulle du göra om resan?",
       "alumno": "Would you do the trip again?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Leo",
        "lengua": "estudio"
       },
       "estudio": "Absolut. I efterhand minns jag mest hur vackert det var.",
       "alumno": "Absolutely. In hindsight, what I remember most is how beautiful it was.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
