  {
   "tipo": "dialogo",
   "titulo": "Ett formulär",
   "frases": [
    {
     "quien": "Amir",
     "sv": "Vad heter du?",
     "es": "¿Cómo te llamas?",
     "en": "What's your name?"
    },
    {
     "quien": "Lina",
     "sv": "Jag heter Lina Noor.",
     "es": "Me llamo Lina Noor.",
     "en": "My name is Lina Noor."
    },
    {
     "quien": "Amir",
     "sv": "Var bor du?",
     "es": "¿Dónde vives?",
     "en": "Where do you live?"
    },
    {
     "quien": "Lina",
     "sv": "Jag bor på Storgatan 12 i Malmö.",
     "es": "Vivo en Storgatan 12, en Malmö.",
     "en": "I live in Storgatan 12, in Malmö."
    },
    {
     "quien": "Amir",
     "sv": "Och vilket land kommer du från?",
     "es": "¿Y de qué país vienes?",
     "en": "And what country do you come from?"
    },
    {
     "quien": "Lina",
     "sv": "Jag kommer från Irak.",
     "es": "Vengo de Irak.",
     "en": "I'm from Iraq."
    }
   ]
  },
