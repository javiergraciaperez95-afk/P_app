  {
   "tipo": "dialogo",
   "titulo": "I mataffären",
   "frases": [
    {
     "quien": "Emma",
     "sv": "Ursäkta, hur mycket kostar potatisen?",
     "es": "Perdone, ¿cuánto cuestan las patatas?",
     "en": "Excuse me, how much are the potatoes?"
    },
    {
     "quien": "Nils",
     "sv": "Tio kronor kilot.",
     "es": "Diez coronas el kilo.",
     "en": "Ten kroner a kilo."
    },
    {
     "quien": "Emma",
     "sv": "Jag behöver ett kilo och två tomater.",
     "es": "Necesito un kilo y dos tomates.",
     "en": "I need a kilo and two tomatoes."
    },
    {
     "quien": "Nils",
     "sv": "Varsågod. Något mer?",
     "es": "Aquí tiene. ¿Algo más?",
     "en": "Here you go. Anything else?"
    },
    {
     "quien": "Emma",
     "sv": "Nej tack, det är bra.",
     "es": "No, gracias, está bien.",
     "en": "No, thank you, it's okay."
    }
   ]
  },
