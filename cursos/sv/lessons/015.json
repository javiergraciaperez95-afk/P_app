   },
   "texto": [
    {
     "@es": "**Hur mycket kostar det?** significa «¿Cuánto cuesta?».",
     "@en": "**Hur mycket kostar det?** means «How much is it?»."
    },
    {
     "@es": "**Jag behöver…** significa «Necesito…». Para pedir algo: **Jag skulle vilja ha…** (Quisiera…).",
     "@en": "**Jag behöver…** means «I need to». To ask for something: **Jag skulle vilja ha…** (I wish)."
    }
   ]
