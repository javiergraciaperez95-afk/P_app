   "frases": [
    {
     "quien": "Ali",
     "sv": "Ursäkta, hur kommer jag till stationen?",
     "es": "Perdone, ¿cómo llego a la estación?",
     "en": "Excuse me, how do I get to the station?"
    },
    {
     "quien": "Sofia",
     "sv": "Gå rakt fram och sväng till vänster vid torget.",
     "es": "Siga recto y gire a la izquierda en la plaza.",
     "en": "Go straight and turn left in the square."
    },
    {
     "quien": "Ali",
     "sv": "Är stationen nära?",
     "es": "¿Está cerca la estación?",
     "en": "Is the station close?"
    },
    {
     "quien": "Sofia",
     "sv": "Ja. Gå till höger efter den första korsningen.",
     "es": "Sí. Vaya a la derecha después del primer cruce.",
     "en": "Yeah. Go right after the first crossing."
    }
   ]
