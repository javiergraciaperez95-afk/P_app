   "texto": [
    {
     "@es": "**Jag tycker om kaffe** significa «Me gusta el café».",
     "@en": "**Jag tycker om kaffe** means «I like coffee.»."
    },
    {
     "@es": "Para decir que no te gusta algo: **Jag tycker inte om…**. El verbo no cambia con la persona.",
     "@en": "To say you don't like something: **Jag tycker inte om…**. The verb doesn't change with the person."
    }
