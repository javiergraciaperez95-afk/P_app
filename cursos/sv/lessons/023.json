   "texto": [
    {
     "@es": "Para hablar del tiempo suele usarse **det är**: **Det är soligt** (hace sol), **det är kallt** (hace frío).",
     "@en": "Time is usually used to talk about **det är**: **Det är soligt** (sun), **det är kallt** (cold)."
    },
    {
     "@es": "El verbo **regnar** significa llueve y **snöar**, nieva.",
     "@en": "The verb **regnar** means rain and **snöar**, nieva."
    }
   ]
