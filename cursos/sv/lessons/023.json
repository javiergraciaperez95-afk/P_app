  {
   "tipo": "dialogo",
   "titulo": "En svensk vinter",
   "frases": [
    {
     "quien": "Emma",
     "sv": "Hur är vädret i dag?",
     "es": "¿Qué tiempo hace hoy?",
     "en": "What's the time today?"
    },
    {
     "quien": "Nils",
     "sv": "Det är kallt och det snöar.",
     "es": "Hace frío y nieva.",
     "en": "It's cold and it's snowing."
    },
    {
     "quien": "Emma",
     "sv": "Är det alltid så på vintern?",
     "es": "¿Siempre es así en invierno?",
     "en": "Is it always like this in winter?"
    },
    {
     "quien": "Nils",
     "sv": "Nej, ibland är det soligt, men ofta är det molnigt.",
     "es": "No, a veces hace sol, pero a menudo está nublado.",
     "en": "No, sometimes it's sun, but it's often cloudy."
    }
   ]
  },
