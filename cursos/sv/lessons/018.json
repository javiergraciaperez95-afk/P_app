   "titulo": "Vid kassan",
   "frases": [
    {
     "quien": "Alex",
     "sv": "Vad kostar den här tröjan?",
     "es": "¿Cuánto cuesta este jersey?",
     "en": "How much is this sweater?"
    },
    {
     "quien": "Sofia",
     "sv": "Den kostar trehundra kronor.",
     "es": "Cuesta trescientas coronas.",
     "en": "It costs three hundred crowns."
    },
    {
     "quien": "Alex",
     "sv": "Har ni en annan storlek?",
     "es": "¿Tenéis otra talla?",
     "en": "Do you have another size?"
    },
    {
     "quien": "Sofia",
     "sv": "Ja, här är den. Vill du betala med kort?",
     "es": "Sí, aquí está. ¿Quieres pagar con tarjeta?",
     "en": "Yeah, here it is. You want to pay by card?"
    },
    {
     "quien": "Alex",
     "sv": "Ja, tack. Jag tar den.",
     "es": "Sí, gracias. Me la llevo.",
     "en": "Yes, thank you. I'll take it."
    }
   ]
