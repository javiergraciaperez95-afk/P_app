   "titulo": "Vad gör ni på fritiden?",
   "frases": [
    {
     "quien": "Johan",
     "sv": "Vad gör du på fritiden?",
     "es": "¿Qué haces en tu tiempo libre?",
     "en": "What are you doing in your free time?"
    },
    {
     "quien": "Kim",
     "sv": "Jag läser böcker och lyssnar på musik.",
     "es": "Leo libros y escucho música.",
     "en": "I read books and I hear music."
    },
    {
     "quien": "Johan",
     "sv": "Spelar du fotboll?",
     "es": "¿Juegas al fútbol?",
     "en": "You play football?"
    },
    {
     "quien": "Kim",
     "sv": "Nej, men jag cyklar och simmar ibland.",
     "es": "No, pero monto en bici y a veces nado.",
     "en": "No, but I go on a bike and sometimes swim."
    }
   ]
