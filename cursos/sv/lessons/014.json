  {
   "tipo": "dialogo",
   "titulo": "På kaféet",
   "frases": [
    {
     "quien": "Ali",
     "sv": "Hej! Kan jag få en kopp te och en smörgås?",
     "es": "¡Hola! ¿Me puede dar una taza de té y un bocadillo?",
     "en": "Hey! Can I have a cup of tea and a snack?"
    },
    {
     "quien": "Kim",
     "sv": "Självklart. Vill du ha mjölk i teet?",
     "es": "Claro. ¿Quieres leche en el té?",
     "en": "Sure. You want milk in tea?"
    },
    {
     "quien": "Ali",
     "sv": "Nej tack, men lite socker.",
     "es": "No, gracias, pero un poco de azúcar.",
     "en": "No, thanks, but a little sugar."
    },
    {
     "quien": "Kim",
     "sv": "Varsågod. Betalar du här?",
     "es": "Aquí tienes. ¿Pagas aquí?",
     "en": "Here you go. You pay here?"
    },
    {
     "quien": "Ali",
     "sv": "Ja, tack.",
     "es": "Sí, gracias.",
     "en": "Yes, thank you."
    }
   ]
  },
