 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Pedir con cortesía",
    "@en": "Ask with courtesy"
   },
   "texto": [
    {
     "@es": "**Jag vill ha en kaffe, tack** significa «Quiero un café, por favor».",
     "@en": "**Jag vill ha en kaffe, tack** means «I want a coffee, please.»."
    },
    {
     "@es": "**Kan jag få…?** es una forma amable de pedir: «¿Me puede dar…?».",
     "@en": "**Kan jag få…?** is a kind way to order: «Can you give me that?»."
    }
   ]
  },
