   "texto": [
    {
     "@es": "**Därför** introduce una consecuencia en una oración principal: **Det regnar. Därför stannar vi hemma.**",
     "@en": "**Därför** introduces a consequence in a main sentence: * * Det regnar. Därför stannar vi hemma. * *"
    },
    {
     "@es": "**Trots att** significa «aunque». En esa subordinada, el sujeto precede al verbo.",
     "@en": "**Trots att** means «though». In that subordinate, the subject precedes the verb."
    }
   ]
  },
