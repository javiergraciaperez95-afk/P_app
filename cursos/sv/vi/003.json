     "frases": [
      {
       "quien": {
        "texto": "Maria",
        "lengua": "estudio"
       },
       "estudio": "Hej, jag heter Maria. Varifrån kommer du?",
       "alumno": "Xin chào, tôi tên là Maria. Bạn đến từ đâu?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Leo",
        "lengua": "estudio"
       },
       "estudio": "Jag kommer från Spanien, men jag bor i Sverige nu.",
       "alumno": "Tôi đến từ Tây Ban Nha, nhưng bây giờ tôi sống ở Thụy Điển.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
