    {
     "tipo": "explicacion",
     "titulo": "Câu chuyện phức tạp",
     "texto": [
      "Thì **preteritum** kể về sự kiện đã diễn ra trong dĩ vãng: **Vi gick vilse** («Tụi tôi bị lạc đường»). **Perfekt** trình bày một trải nghiệm đã qua nhưng còn liên quan đến hiện tại: **Vi har gått den vägen förut** («Tụi tôi từng đi con đường đó rồi»). **Medan** diễn tả hành động song song; **till slut** giới thiệu phần kết."
     ],
     "tutora": ""
    }
   ]
  },
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Vid middagen",
     "frases": [
      {
       "quien": {
        "texto": "Nora",
        "lengua": "alumno"
       },
       "estudio": "Hur var vandringen i fjällen?",
       "alumno": "Chuyến đi bộ ở vùng núi thế nào?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Leo",
        "lengua": "estudio"
       },
       "estudio": "Vädret var fint när vi började, men medan vi gick blev stigen allt smalare.",
       "alumno": "Thời tiết đẹp khi bọn mình xuất phát, nhưng trong khi đi, lối mòn ngày một hẹp hơn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nora",
        "lengua": "alumno"
       },
       "estudio": "Vad hände sedan?",
       "alumno": "Sau đó thì sao?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Leo",
        "lengua": "estudio"
       },
       "estudio": "Vi upptäckte en omledning och tog en omväg. Till slut kom vi fram före mörkret.",
       "alumno": "Bọn tôi tìm được một tuyến đường thay thế và đi vòng. Cuối cùng bọn tôi đến nơi trước khi trời tối.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nora",
        "lengua": "alumno"
       },
       "estudio": "Skulle du göra om resan?",
       "alumno": "Bạn sẽ đi lại chuyến đó chứ?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Leo",
        "lengua": "estudio"
       },
       "estudio": "Absolut. I efterhand minns jag mest hur vackert det var.",
       "alumno": "Chắc chắn rồi. Nhìn lại, tôi nhớ nhất là khung cảnh đẹp đến nhường nào.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
