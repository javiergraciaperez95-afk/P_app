       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nils",
        "lengua": "estudio"
       },
       "estudio": "Nej, ibland är det soligt, men ofta är det molnigt.",
       "alumno": "Không, thỉnh thoảng trời có nắng, nhưng thường thì nhiều mây.",
       "literal": "",
