     "frases": [
      {
       "quien": {
        "texto": "Emma",
        "lengua": "alumno"
       },
       "estudio": "Hur är vädret i dag?",
       "alumno": "Thời tiết hôm nay thế nào?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nils",
        "lengua": "estudio"
       },
       "estudio": "Det är kallt och det snöar.",
       "alumno": "Trời lạnh và có tuyết rơi.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Emma",
        "lengua": "alumno"
       },
       "estudio": "Är det alltid så på vintern?",
       "alumno": "Mùa đông lúc nào cũng như vậy à?",
