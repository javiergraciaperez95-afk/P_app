     "frases": [
      {
       "quien": {
        "texto": "Maja",
        "lengua": "alumno"
       },
       "estudio": "Jag anser att centrum bör ha fler bilfria gator.",
       "alumno": "Tôi cho rằng trung tâm nên có nhiều đường dành cho người đi bộ hơn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Omar",
        "lengua": "alumno"
       },
       "estudio": "Jag kan stödja förslaget, förutsatt att kollektivtrafiken blir mer tillgänglig.",
       "alumno": "Tôi có thể ủng hộ đề xuất, miễn là giao thông công cộng dễ tiếp cận hơn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Maja",
        "lengua": "alumno"
       },
       "estudio": "Det är ett avgörande villkor. Ett exempel är att bussarna går oftare.",
       "alumno": "Đó là một điều kiện quyết định. Một ví dụ là xe buýt chạy thường xuyên hơn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Omar",
        "lengua": "alumno"
       },
       "estudio": "Då skulle fler kunna lämna bilen hemma.",
       "alumno": "Khi đó nhiều người hơn có thể để xe ở nhà.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
