       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Till slut kom jag fram, och jag lärde mig att alltid ta med en regnjacka.",
       "alumno": "Cuối cùng tôi cũng đến nơi, và tôi học được rằng luôn phải mang theo áo mưa.",
