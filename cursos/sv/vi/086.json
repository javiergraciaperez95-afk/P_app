      },
      {
       "quien": {
        "texto": "Ali",
        "lengua": "estudio"
       },
       "estudio": "Den var bättre än jag trodde. Det visade sig att berättelsen var både rolig och viktig.",
       "alumno": "Hay hơn mình nghĩ. Hóa ra câu chuyện vừa vui vừa quan trọng.",
