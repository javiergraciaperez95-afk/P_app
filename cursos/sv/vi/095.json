       "quien": {
        "texto": "Leo",
        "lengua": "estudio"
       },
       "estudio": "Hur vet vi om nyttan motsvarar kostnaden?",
       "alumno": "Làm sao chúng ta biết lợi ích có tương xứng với chi phí không?",
