     "frases": [
      {
       "quien": {
        "texto": "Ali",
        "lengua": "estudio"
       },
       "estudio": "Vad skulle ni tycka om att plantera fler träd på gården?",
       "alumno": "Bạn nghĩ sao về việc trồng thêm cây trong sân?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Maja",
        "lengua": "alumno"
       },
       "estudio": "Det vore trevligt. Det skulle också ge skugga på sommaren.",
       "alumno": "Sẽ rất tuyệt. Cũng sẽ mang lại bóng râm vào mùa hè.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ali",
        "lengua": "estudio"
       },
       "estudio": "Det innebär förstås en kostnad, men på lång sikt kan det bli bättre.",
       "alumno": "Tất nhiên điều đó kéo theo chi phí, nhưng về lâu dài có thể tốt hơn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Maja",
        "lengua": "alumno"
       },
       "estudio": "Vi kan ta reda på priset innan vi bestämmer oss.",
       "alumno": "Chúng ta có thể tìm hiểu giá trước khi quyết định.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
