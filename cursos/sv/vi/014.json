     "frases": [
      {
       "quien": {
        "texto": "Ali",
        "lengua": "estudio"
       },
       "estudio": "Hej! Kan jag få en kopp te och en smörgås?",
       "alumno": "Chào! Cho tôi xin một tách trà và một bánh mì kẹp được không?",
       "literal": "",
       "estructura": "",
