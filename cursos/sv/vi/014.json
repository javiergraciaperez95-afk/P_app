       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Kim",
        "lengua": "alumno"
       },
       "estudio": "Självklart. Vill du ha mjölk i teet?",
       "alumno": "Dĩ nhiên. Bạn có muốn cho sữa vào trà không?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ali",
        "lengua": "estudio"
       },
       "estudio": "Nej tack, men lite socker.",
       "alumno": "Không, cảm ơn, nhưng cho một chút đường.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Kim",
        "lengua": "alumno"
       },
       "estudio": "Varsågod. Betalar du här?",
       "alumno": "Của bạn đây. Bạn trả tiền ở đây à?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ali",
        "lengua": "estudio"
       },
       "estudio": "Ja, tack.",
       "alumno": "Vâng, cảm ơn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
