     "titulo": "En vanlig dag",
     "frases": [
      {
       "quien": {
        "texto": "David",
        "lengua": "alumno"
       },
       "estudio": "Jag vaknar klockan sju.",
       "alumno": "Tôi dậy vào bảy giờ.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "David",
        "lengua": "alumno"
       },
       "estudio": "Sedan äter jag frukost och går till jobbet.",
       "alumno": "Sau đó tôi ăn sáng và đi làm.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Emma",
        "lengua": "alumno"
       },
       "estudio": "När börjar du arbeta?",
       "alumno": "Khi nào bạn bắt đầu làm việc?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "David",
        "lengua": "alumno"
       },
       "estudio": "Jag börjar klockan åtta och slutar klockan fyra.",
       "alumno": "Tôi bắt đầu vào tám giờ và xong việc vào bốn giờ.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
