        "texto": "Sofia",
        "lengua": "alumno"
       },
       "estudio": "Gå rakt fram och sväng till vänster vid torget.",
       "alumno": "Đi thẳng rồi rẽ trái ở quảng trường.",
       "literal": "",
       "estructura": "",
