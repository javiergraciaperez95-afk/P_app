     "frases": [
      {
       "quien": {
        "texto": "Nora",
        "lengua": "alumno"
       },
       "estudio": "Jag har sovit sämre den senaste tiden.",
       "alumno": "Gần đây mình ngủ kém hơn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Leo",
        "lengua": "estudio"
       },
       "estudio": "Tror du att arbetsbelastningen påverkar sömnen?",
       "alumno": "Bạn có nghĩ khối lượng công việc ảnh hưởng đến giấc ngủ không?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nora",
        "lengua": "alumno"
       },
       "estudio": "Kanske, men det kan bero på flera saker. Jag har också ändrat min kvällsrutin.",
       "alumno": "Có lẽ, nhưng có thể do nhiều nguyên nhân. Mình cũng đã thay đổi thói quen buổi tối.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Leo",
        "lengua": "estudio"
       },
       "estudio": "Ju mer tid jag tar för återhämtning, desto bättre mår jag i längden.",
       "alumno": "Dành càng nhiều thời gian để hồi phục, về lâu dài mình càng thấy khỏe hơn.",
       "literal": "",
