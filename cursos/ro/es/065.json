    {
     "tipo": "explicacion",
     "titulo": "Preferencias",
     "texto": [
      "**Prefer** significa «prefiero» y **preferi**, «prefieres». **Mai degrabă** indica una preferencia relativa: «más bien» o «preferiblemente»."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Negociar",
     "texto": [
      "**Propun** presenta una propuesta. **Deocamdată** limita la decisión al momento actual: «por ahora»."
     ],
     "tutora": ""
    }
   ]
