    {
     "tipo": "explicacion",
     "titulo": "«A mânca»",
     "texto": [
      "Este verbo significa «comer»: **eu mănânc, tu mănânci, el/ea mănâncă, noi mâncăm, voi mâncați, ei/ele mănâncă**. La forma de «el/ea» coincide con «ei/ele»."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "«A bea»",
     "texto": [
      "Significa «beber»: **eu beau, tu bei, el/ea bea, noi bem, voi beți, ei/ele beau**. «Un pahar de apă» es «un vaso de agua»; «o felie de tort», «una porción de tarta»."
     ],
     "tutora": ""
    },
