    {
     "tipo": "explicacion",
     "titulo": "Những bộ phận cơ thể",
     "texto": [
      "**Picior** có thể nghĩa là «bàn chân» hoặc «chân», tùy ngữ cảnh; không có nghĩa là «ngứa». **Spate** là «lưng» và **măsea**, «răng hàm»."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Nói về việc đang xảy ra với ta",
     "texto": [
      "**Îmi curge nasul** nghĩa là «mũi tôi đang chảy». Đại từ **îmi** đứng trước động từ; trong tiếng Tây Ban Nha thường nói «me moquea la nariz»."
     ],
     "tutora": ""
    }
   ]
  },
