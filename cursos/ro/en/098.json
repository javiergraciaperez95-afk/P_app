    {
     "tipo": "explicacion",
     "titulo": "Asking politely",
     "texto": [
      "**Ați putea verifica…?** is equivalent to \"could you check…?\". Use the polite form, even when speaking to just one person."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Documenting the request",
     "texto": [
      "**Dovada plății** is the proof of payment; **în scris** indicates that you want the answer in writing."
     ],
     "tutora": ""
    }
   ]
