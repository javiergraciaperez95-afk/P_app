 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Dative",
     "texto": [
      "**Îi trimit bunicii o fotografie** means «I send a photo to the grandmother». **Îi** goes before the verb and **bunicii** identifies the recipient. In the plural: **Le scriu bunicilor** («I write to the grandparents»)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Comparison with English",
     "texto": [
      "Repeating the recipient is normal in Romanian: **îi** together with **bunicii**. English does not usually do this. The noun changes form: **bunică → bunicii**; in the plural, **bunicii → bunicilor**."
     ],
     "tutora": ""
    }
   ]
  },
