    },
    {
     "tipo": "explicacion",
     "titulo": "Agreement",
     "texto": [
      "**Disponibil** agrees with a male candidate; **disponibilă**, with a female one. **Experiență relevantă** means \"relevant experience\"."
     ],
     "tutora": ""
    }
   ]
