   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Means of transport",
     "texto": [
      "To say «by bus» or «by train», Romanian uses **cu** («with»): **cu autobuzul**, **cu trenul**. It is different from English, which uses «by»."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "A false friend",
     "texto": [
      "**Magazin** means «shop», not «magazine» (the printed kind). To ask about the ticket, **Cât costă biletul?** means «How much does the ticket cost?»."
     ],
     "tutora": ""
    }
   ]
  },
