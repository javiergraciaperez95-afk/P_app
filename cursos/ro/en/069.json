   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Impersonal form",
     "texto": [
      "**Se completează formularul** means «the form is filled in». The object of the action works as the subject and the verb agrees with it."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Agreement",
     "texto": [
      "With a plural noun, the verb is also plural: **se trimit documentele** («the documents are sent»)."
     ],
     "tutora": ""
    }
   ]
  },
