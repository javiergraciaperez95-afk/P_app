   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Compound past",
     "texto": [
      "**Am fost** means «I was» or «I have been»; **am mers**, «I went» or «I have gone». The auxiliary changes according to the person (**am, ai, a**), but the participle stays the same."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "An experience",
     "texto": [
      "**Unde ai fost?** means «Where have you been?». To talk about a visit, we can say **Am fost în Brașov** («I was in Brașov»)."
     ],
     "tutora": ""
    },
