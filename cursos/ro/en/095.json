   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Acknowledging and questioning",
     "texto": [
      "**A recunoaște** introduces something we admit; **a contesta** expresses that we put a statement in doubt."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Contrast",
     "texto": [
      "**Dimpotrivă** means \"on the contrary\". **În realitate** allows you to correct an impression with a more precise fact or interpretation."
     ],
     "tutora": ""
    }
   ]
  },
