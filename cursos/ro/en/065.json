   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Preferences",
     "texto": [
      "**Prefer** means «I prefer» and **preferi**, «you prefer». **Mai degrabă** shows a relative preference: «rather» or «preferably»."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Negotiating",
     "texto": [
      "**Propun** presents a suggestion. **Deocamdată** limits the decision to the present moment: «for now»."
     ],
     "tutora": ""
    }
   ]
  },
