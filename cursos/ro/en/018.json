   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "«A mânca»",
     "texto": [
      "This verb means «to eat»: **eu mănânc, tu mănânci, el/ea mănâncă, noi mâncăm, voi mâncați, ei/ele mănâncă**. The «el/ea» form is the same as «ei/ele»."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "«A bea»",
     "texto": [
      "It means «to drink»: **eu beau, tu bei, el/ea bea, noi bem, voi beți, ei/ele beau**. «Un pahar de apă» is «a glass of water»; «o felie de tort», «a slice of cake»."
     ],
     "tutora": ""
    },
