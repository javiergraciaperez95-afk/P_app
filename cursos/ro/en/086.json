   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Politeness",
     "texto": [
      "**Stimată doamnă** means \"Dear madam\". In a formal email, **vă** addresses a person with a polite form of address, even though it is a plural form."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Structure",
     "texto": [
      "**În legătură cu** means \"in connection with\". **Cu stimă** is a formal sign-off: \"Yours sincerely\"."
     ],
     "tutora": ""
    }
   ]
  },
