 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Qualifying a position",
     "texto": [
      "**Într-o anumită măsură** limits a statement: \"to a certain extent\". **Nuanțat** means that it takes differences or exceptions into account."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Strength of the argument",
     "texto": [
      "**Plauzibil** means \"plausible\"; **convingător**, \"convincing\". A plausible premise can support an argument without fully proving it."
     ],
     "tutora": ""
    }
   ]
  },
