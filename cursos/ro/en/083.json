   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Recommendation",
     "texto": [
      "**Recomandă** means \"recommends\". After **recomandă să**, the verb is in the subjunctive, just as after other verbs of wish or advice."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Information",
     "texto": [
      "**Expoziție** is \"exhibition\" and **ghid** is \"guide\". To pass on a recommendation, use **spune că** to report a fact or **recomandă să** to report a piece of advice."
     ],
     "tutora": ""
    }
   ]
  },
