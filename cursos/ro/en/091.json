    {
     "tipo": "explicacion",
     "titulo": "Time order",
     "texto": [
      "**Anterior** means \"previous\" and **ulterior**, \"later\". **Simultan** is equivalent to \"simultaneously\"."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Account",
     "texto": [
      "**Relatare** is \"account\" or \"narration\". **Cronologic** indicates that the facts follow the order in which they happened."
     ],
     "tutora": ""
    }
   ]
  },
