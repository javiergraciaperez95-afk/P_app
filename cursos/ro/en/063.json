 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Giving an opinion",
     "texto": [
      "**Părere** means «opinion» or «view». **Sunt de acord** expresses agreement; **nu sunt de acord** expresses disagreement."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Qualifying",
     "texto": [
      "**În parte** limits the agreement; **totuși** introduces an idea that contrasts with the previous one."
     ],
     "tutora": ""
    }
   ]
  },
