   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Orientation",
     "texto": [
      "**La nord de** means «north of»; **la vest de**, «west of». Directions are built with **la** and the compass point."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Location",
     "texto": [
      "**Se află** means «is located» or «is situated». **În apropiere** shows that something is nearby."
     ],
     "tutora": ""
    }
   ]
  },
