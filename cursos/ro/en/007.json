 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Possessives",
     "texto": [
      "The noun takes the definite article and then the possessive comes after it: **fratele meu** («my brother»), **sora mea** («my sister»). Unlike English, «my» does not go in front of the noun."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Agreement",
     "texto": [
      "The possessive agrees with the noun it refers to: **meu** (masculine singular), **mea** (feminine singular), **mei** (masculine plural), **mele** (feminine plural). The forms for «your» are **tău, ta, tăi, tale**."
     ],
     "tutora": ""
    }
   ]
  },
