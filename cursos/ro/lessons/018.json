 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": "«A mânca»",
   "texto": [
    {
     "@es": "Este verbo significa «comer»: **eu mănânc, tu mănânci, el/ea mănâncă, noi mâncăm, voi mâncați, ei/ele mănâncă**. La forma de «el/ea» coincide con «ei/ele».",
     "@en": "This verb means «eat»: **eu mănânc, tu mănânci, el/ea mănâncă, noi mâncăm, voi mâncați, ei/ele mănâncă**. The form of «el/ea» matches «ei/ele»."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": "«A bea»",
   "texto": [
    {
     "@es": "Significa «beber»: **eu beau, tu bei, el/ea bea, noi bem, voi beți, ei/ele beau**. «Un pahar de apă» es «un vaso de agua»; «o felie de tort», «una porción de tarta».",
     "@en": "It means «drink»: **eu beau, tu bei, el/ea bea, noi bem, voi beți, ei/ele beau**. «Un pahar de apă» is «a glass of water»; «o felie de tort», «a portion of cake»."
    }
   ]
  },
