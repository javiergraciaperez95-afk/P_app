 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": "«A se trezi»",
   "texto": [
    {
     "@es": "El infinitivo **a se trezi** significa «despertarse». En presente, el pronombre cambia: **mă trezesc, te trezești, se trezește, ne trezim, vă treziți, se trezesc**.",
     "@en": "The **a se trezi** infinitive means «despertarse». In the present, the pronoun changes: **mă trezesc, te trezești, se trezește, ne trezim, vă treziți, se trezesc**."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Orden de palabras",
    "@en": "Order of words"
   },
   "texto": [
    {
     "@es": "El pronombre reflexivo precede al verbo: **Mă trezesc dimineața** («Me despierto por la mañana»). No se pega al final del verbo, como el infinitivo español «despertar-se» no se escribe en rumano.",
     "@en": "The reflective pronoun precedes the verb: **Mă trezesc dimineața** («I wake up in the morning»). It does not stick at the end of the verb, as the Spanish infinitive «Wake up.» is not written in Romanian."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Dos «mañanas»",
    "@en": "Two «mornings»"
   },
   "texto": [
    {
     "@es": "**Dimineață** es la parte del día; **mâine** significa «mañana» como día siguiente. Son palabras distintas.",
     "@en": "**Dimineață** is the part of the day; **mâine** means «tomorrow» as the next day. They're different words."
    }
   ]
  },
