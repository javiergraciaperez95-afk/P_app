 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Saludar",
    "@en": "Say hello"
   },
   "texto": [
    {
     "@es": "**Bună ziua** es un saludo cortés que sirve durante el día y también equivale a «hola». **Bună** y **salut** son informales.",
     "@en": "**Bună ziua** is a courteous greeting that serves during the day and also equals «Hello.». **Bună** and **salut** are informal."
    },
    {
     "@es": "En **bună ziua**, «bună» concuerda con «ziua» (día, femenino). La expresión completa se usa como saludo; no se traduce palabra por palabra.",
     "@en": "In **bună ziua**, «bună» matches «ziua» (day, feminine). The full expression is used as a greeting; it does not translate word for word."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Presentarse",
    "@en": "To be presented"
   },
   "texto": [
    {
     "@es": "**Eu sunt Ana** significa «Soy Ana». El pronombre **eu** puede omitirse: **Sunt Ana** también es correcto.",
     "@en": "**Eu sunt Ana** means «I'm Ana.». The **eu** pronoun can be omitted: **Sunt Ana** is also correct."
    },
    {
     "@es": "**Încântat** lo dice un hombre; **încântată**, una mujer. El adjetivo concuerda con quien habla, como en español.",
     "@en": "**Încântat** says so by a man; **încântată**, a woman. The adjective agrees with the speaker, as in Spanish."
    }
   ]
  },
