   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Chi and quanto",
     "texto": [
      "**Aiuto chi ha bisogno** (I help whoever needs it); **quanto hai detto è importante** (what you said is important).",
      "They do not need an explicit noun antecedent."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Ciò and sé",
     "texto": [
      "**Ciò che mi interessa** (what interests me); **porta con sé il documento** (he/she carries the document with him/her).",
      "**Sé** usually appears after a preposition and can take an accent to tell it apart from **se** («if»)."
     ],
     "tutora": ""
    },
