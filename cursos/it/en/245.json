 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Frequent subjunctive",
     "texto": [
      "**Non so dove sia** (I don't know where it is), **Vorrei sapere quanto costi** (I would like to know how much it costs), **Mi chiedo chi fosse** (I wonder who he was).",
      "The mood depends on the context: not every indirect question requires the subjunctive."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Other expressions",
     "texto": [
      "**Non so come** (I don't know how), **cosa abbia detto** (whatever he or she has said).",
      "Example: **Non so come stia** (I don't know how he or she is)."
     ],
     "tutora": ""
    },
    {
