   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "The mixed conditional sentence",
     "texto": [
      "«Se avessi studiato medicina all'università» (in the past), «oggi sarei medico» (now). The unfulfilled past condition creates a counterfactual state in the present."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "The mood required by «come se»",
     "texto": [
      "It introduces a hypothetical or pretended comparison and always requires the subjunctive in its imperfect or trapassato tenses, never the indicative or conditional: «Si comporta come se non gli importasse nulla»."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Type of structure",
     "columnas": [
      {
       "texto": "Model sentence",
       "lengua": "alumno"
      },
      {
       "texto": "Time relationship",
       "lengua": "alumno"
      }
     ],
