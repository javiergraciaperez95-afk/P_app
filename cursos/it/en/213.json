   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "A pattern of agreement",
     "texto": [
      "With a main verb in the present, the present subjunctive usually expresses simultaneity and the passato an earlier time. With a main verb in the past, the imperfect usually expresses simultaneity and the trapassato an earlier time.",
      "It is a useful guide, not a mechanical rule: the real time, the intention and some constructions can change the choice."
     ],
     "tutora": ""
    },
