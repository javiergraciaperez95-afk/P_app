 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "The golden rule of verbal economy",
     "texto": [
      "**Same subject**: the speaker carries out both actions. It is linked with preposition + infinitive: **Spero di partire** (I hope to leave), **Penso di avere ragione** (I think I am right), **Vorrei restare** (I would like to stay). Saying «spero che io parta» sounds unnatural in Italian.",
      "**Different subject**: two different people are involved. It is linked with **che + subjunctive**: **Spero che tu parta** (I hope you leave), **Vorrei che tu restassi** (I would like you to stay)."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Main verb",
     "columnas": [
      {
       "texto": "Same subject (infinitive)",
       "lengua": "alumno"
      },
      {
       "texto": "Different subject (che + subjunctive)",
       "lengua": "alumno"
      }
     ],
