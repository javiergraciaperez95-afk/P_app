 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Rule for agreement of the relative possessive",
     "texto": [
      "«Lo scrittore **il cui** romanzo ha vinto...» (the noun romanzo is masculine singular → il cui).",
      "«Lo scrittore **la cui** opera è famosa...» (opera is feminine singular → la cui).",
      "«La poetessa **i cui** versi conosciamo...» (versi is masculine plural → i cui).",
      "«I filosofi **le cui** teorie studiamo...» (teorie is feminine plural → le cui)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "«Cui» with ordinary prepositions",
     "texto": [
      "Without a definite article, «cui» preceded by a preposition (a cui, di cui, per cui, con cui, in cui, da cui) works as an indirect object, a complement or an adverbial: «La persona a cui ho scritto» (the person I wrote to); «Il motivo per cui siamo qui»."
     ],
     "tutora": ""
    },
    {
