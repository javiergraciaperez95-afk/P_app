   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Commands and requests: «di + infinitive»",
     "texto": [
      "If someone says to you: «Aspetta qui!» (wait here!), when you report it you say: **Mi ha detto di aspettare qui** (he told me to wait here).",
      "«Chiedere di» is used for polite requests: **Gli ho chiesto di aiutarmi** (I asked him to help me)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Prohibition: «di non + infinitive»",
     "texto": [
      "If the order is negative: «Non fumare!» becomes **Mi ha detto di non fumare** (he told me not to smoke). «Non ti preoccupare!» becomes **Le ho detto di non preoccuparsi** (I told her not to worry)."
     ],
     "tutora": ""
    },
