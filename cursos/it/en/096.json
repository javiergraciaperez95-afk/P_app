 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Specific time values",
     "texto": [
      "**Da** indicates the starting point in the past that continues into the present: **Studio l'italiano da due anni** (I've been studying Italian for two years).",
      "**Per** indicates the overall duration planned or completed: **Ho camminato per due ore** (I walked for two hours).",
      "**Tra / fra** expresses the time remaining before something happens: **Il treno parte tra dieci minuti** (the train leaves in ten minutes).",
      "**Fino a** marks the end point or final limit: **L'ufficio è aperto fino alle diciotto** (the office is open until six)."
     ],
     "tutora": ""
    },
