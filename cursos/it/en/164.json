 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "«Ci» of place",
     "texto": [
      "It means «there» or «to that place»: **Vai spesso a Roma? Sì, ci vado ogni mese** (Do you often go to Rome? Yes, I go there every month); **Ci siamo stati l'anno scorso** (We were there last year)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "«Ci» of topic or belief",
     "texto": [
      "It replaces phrases like *credere a*, *pensare a*, *provare a*: **Pensi al nuovo progetto? Sì, ci penso continuamente**; **Credi alla sua versione? No, non ci credo affatto**."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Function",
     "columnas": [
