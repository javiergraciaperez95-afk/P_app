   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "How it is formed",
     "texto": [
      "**il / la / i / le** + **più** or **meno** + adjective + **di** or **del mondo**: **la donna più famosa** (the most famous woman), **il posto più bello del mondo** (the most beautiful place in the world).",
      "The adjective agrees with the noun, just as in all the other cases."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "With «di» and «in»",
     "texto": [
      "For the group **di** (of) is used: **la più alta di tutti** (the tallest of all). For a place **della** (of the) is used: **la più antica della regione** (the oldest in the region)."
     ],
     "tutora": ""
    },
