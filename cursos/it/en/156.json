   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Using dove or in cui",
     "texto": [
      "**Il paese dove sono nato è piccolo** = *Il paese in cui sono nato è piccolo* (The village where I was born is small). Both are correct, but «dove» is much more common and lighter in everyday spoken and written Italian."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Key rule",
     "texto": [
      "«Dove» is used only for antecedents that express a real or figurative place. It must never be used for time («l'anno in cui...», not *l'anno dove*)."
     ],
     "tutora": ""
    },
    {
