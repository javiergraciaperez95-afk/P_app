 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Choosing the preposition",
     "texto": [
      "**Parlare di** → *l'argomento di cui parliamo* (the topic we talk about).",
      "**Contare su** → *la persona su cui puoi contare* (the person you can count on).",
      "**Lavorare a** → *il progetto a cui dedico il mio tempo* (the project I devote my time to)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Cui never changes",
     "texto": [
      "Unlike «il quale / la quale / i quali / le quali», «cui» never changes form for gender or number: *gli amici con cui esco*, *le colleghe con cui collaboro*."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Governing verb",
     "columnas": [
      {
       "texto": "Structure with cui",
       "lengua": "alumno"
      },
      {
       "texto": "Example in English",
       "lengua": "alumno"
      }
     ],
