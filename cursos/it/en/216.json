      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Because it defines the profile or requirement wanted in a person who is not yet identified.",
       "lengua": "alumno",
       "explicacion": "The search does not refer to a specific person who has already been identified.",
       "correcta": true
      },
      {
       "texto": "Because the verb «parlare» is irregular and rules out the indicative.",
       "lengua": "alumno",
       "explicacion": "A false claim that ignores regular morphology.",
       "correcta": false
      },
      {
       "texto": "Because in all relative clauses the indicative is ungrammatical.",
