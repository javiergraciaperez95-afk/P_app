    {
     "tipo": "dialogo",
     "titulo": "Bisogna riciclare di più",
     "frases": [
      {
       "quien": {
        "texto": "Giulia",
        "lengua": "estudio"
       },
       "estudio": "Guarda quanta plastica c'è in questo parco: è un vero peccato!",
       "alumno": "Look how much plastic there is in this park: what a shame!",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "quanta plastica c'è",
         "how much plastic there is"
        ],
        [
         "è un vero peccato",
         "it's a real shame"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Matteo",
        "lengua": "estudio"
       },
       "estudio": "Hai ragione, bisogna riciclare di più per tutelare l'ambiente cittadino.",
       "alumno": "You're right, we need to recycle more to protect the city environment.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "bisogna riciclare di più",
         "we need to recycle more"
        ],
        [
         "per tutelare l'ambiente",
         "to protect the environment"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Giulia",
        "lengua": "estudio"
       },
       "estudio": "E per ridurre l'inquinamento dell'aria, dovremmo usare i mezzi pubblici.",
       "alumno": "And to reduce air pollution, we should use public transport.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "per ridurre l'inquinamento",
         "to reduce pollution"
        ],
        [
         "dovremmo usare i mezzi pubblici",
         "we should use public transport"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Matteo",
        "lengua": "estudio"
       },
       "estudio": "Esatto: ognuno di noi deve fare la propria parte per salvare il pianeta!",
       "alumno": "Exactly: each of us has to do our part to save the planet!",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "ognuno di noi",
         "each of us"
        ],
        [
         "per salvare il pianeta",
