 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Subject function",
     "texto": [
      "When the word replaced does the action of the subordinate clause: **Il treno che arriva al binario tre è in ritardo** (The train that arrives at platform three is running late).",
      "Here «che» replaces «il treno» as the subject of the verb «arriva»."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Direct object function",
     "texto": [
      "When the word replaced receives the action: **L'invito che abbiamo ricevuto è per sabato** (The invitation we received is for Saturday).",
      "No preposition is added when it works in this function."
     ],
     "tutora": ""
    },
    {
