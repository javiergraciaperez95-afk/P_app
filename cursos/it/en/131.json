   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Catalogue of triggers",
     "texto": [
      "**Verbs of thought or opinion**: credere, pensare, ritenere (**Ritengo che sia opportuno**, I consider it appropriate).",
      "**Verbs of will and wish**: volere, desiderare, preferire (**Voglio che tu ascolti**, I want you to listen).",
      "**Verbs of feeling and fear**: temere, avere paura che (**Temo che piova**, I fear it will rain).",
      "**Subordinating conjunctions**: benché, affinché, purché, prima che (**Purché tu sia d'accordo**, provided that you agree)."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
