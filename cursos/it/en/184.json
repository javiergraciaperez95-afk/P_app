     "id": "it184-5",
     "pregunta": {
      "texto": "What semantic function does the connector «per questo» have?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "Per questo il servizio sarà presto esteso a tutta la città.",
      "lengua": "estudio"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "It introduces the consequence caused by the good results of the pilot scheme.",
       "lengua": "alumno",
       "explicacion": "A conclusive consecutive link: proven cause → extension across the city.",
       "correcta": true
      },
      {
       "texto": "It sets up a future hypothetical condition depending on the weather.",
       "lengua": "alumno",
       "explicacion": "It does not form any conditional hypothesis with «se».",
       "correcta": false
