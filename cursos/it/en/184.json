    {
     "tipo": "test",
     "id": "it184-1",
     "pregunta": {
      "texto": "During the summer period, at what times will the municipal library be open?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Only from Monday to Friday in the morning, between 8:30 and 13:30.",
       "lengua": "alumno",
       "explicacion": "«Aperta dal lunedì al venerdì solo al mattino, dalle 8:30 alle 13:30».",
       "correcta": true
      },
      {
       "texto": "From Tuesday to Sunday, open all day without a break.",
       "lengua": "alumno",
       "explicacion": "It contradicts the closure on Saturdays and the morning-only opening from Monday to Friday.",
       "correcta": false
      },
      {
       "texto": "Only on Saturday afternoons for children's loans.",
       "lengua": "alumno",
       "explicacion": "On Saturday it stays completely closed to the public.",
       "correcta": false
      }
     ],
     "respuestas": {
