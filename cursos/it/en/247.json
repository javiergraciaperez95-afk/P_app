 "etapas": [
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "texto",
     "titulo": "The neighbourhood library",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Il comune ha avviato un progetto per riaprire la biblioteca di quartiere anche la sera.",
       "alumno": "The council has launched a project to reopen the neighbourhood library in the evenings as well.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "La decisione è nata dopo un sondaggio: molti residenti lavorano fino a tardi e non riescono a partecipare alle attività pomeridiane.",
       "alumno": "The decision came after a survey: many residents work late and cannot take part in the afternoon activities.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Due volontari coordinano gli incontri, mentre il personale seleziona libri e articoli accessibili anche a chi studia italiano.",
       "alumno": "Two volunteers coordinate the meetings, while the staff select books and articles that are also accessible to those who study Italian.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Il progetto dura sei mesi; alla fine, il comune valuterà presenze e proposte dei partecipanti.",
       "alumno": "The project lasts six months; at the end, the council will evaluate the attendance and the participants' proposals.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Se l'interesse resterà alto, gli orari serali saranno mantenuti.",
       "alumno": "If interest remains high, the evening timetables will be kept.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Gli organizzatori precisano però che la sala studio chiuderà durante i lavori di ristrutturazione.",
       "alumno": "The organisers clarify, however, that the study room will close during the renovation works.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
