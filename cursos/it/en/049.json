   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "The setting versus the event",
     "texto": [
      "The **imperfetto** paints the background: the weather, the time, age, mood or actions in progress (*Pioveva forte*, *Faceva molto caldo*, *Ero stanco*).",
      "The **passato prossimo** introduces the events that happen in that setting: the concrete actions that were completed (*Ieri sono andato al mare*, *A un certo punto è arrivato Luca*)."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Imperfetto (context) versus passato prossimo (event)",
     "columnas": [
      {
       "texto": "Imperfetto (background)",
       "lengua": "alumno"
      },
      {
       "texto": "Passato prossimo (single event)",
       "lengua": "alumno"
      }
     ],
