 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Purpose connectors with the subjunctive",
     "texto": [
      "«Vi spiego la procedura **affinché possiate** compilare il bando autonomamente» (so that you can fill in the call yourselves).",
      "«Parlo a voce alta **perché tutti sentano**» (so that everyone can hear).",
      "«Ha chiarito la regola **in modo che nessuno avesse** dubbi» (sequence of tenses in the past with the imperfect subjunctive)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Same subject versus different subjects",
     "texto": [
      "**Same subjects (infinitive)**: «Studio molto per superare l'esame» (I study / I pass).",
      "**Different subjects (subjunctive)**: «Ti presto il libro affinché tu possa studiare» (I lend you the book / you study)."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Structure",
