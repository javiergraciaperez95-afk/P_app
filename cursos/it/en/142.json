   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Present → imperfect",
     "texto": [
      "If someone says «sono stanco» (I'm tired, present), when reporting it in the past you say: **Ha detto che era stanco** (he said he was tired).",
      "The present of the direct quotation becomes the imperfect in the reported account."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Changes of person",
     "texto": [
      "Pronouns and verb persons adapt: «io» becomes «lui» or «lei». **Mi ha detto che non voleva venire** (he told me he didn't want to come)."
     ],
     "tutora": ""
    },
