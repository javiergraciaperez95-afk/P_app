     "pregunta": {
      "texto": "Why is the «h» written in «ho», «hai», «ha» and «hanno»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "To visually tell the verb forms apart from other homophones like «o», «a» or «anno».",
       "lengua": "alumno",
       "explicacion": "The «h» is completely silent, but essential in spelling.",
       "correcta": true
      },
      {
       "texto": "Because in Italian the initial «h» is pronounced as an aspirate.",
       "lengua": "alumno",
       "explicacion": "The «h» is never pronounced in modern Italian.",
       "correcta": false
      },
      {
       "texto": "To show that the subject of the sentence is plural.",
       "lengua": "alumno",
       "explicacion": "No, three of those four forms are singular (ho, hai, ha).",
       "correcta": false
      }
