    {
     "tipo": "texto",
     "titulo": "Un archivio ritrovato",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Quando il museo ha riaperto dopo i lavori, il personale ha trovato una scatola dietro un armadio. Conteneva fotografie e registri del vecchio teatro cittadino, chiuso nel 1952.",
       "alumno": "When the museum reopened after the renovation work, the staff found a box behind a wardrobe. It contained photographs and records from the old municipal theatre, closed in 1952.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "registri del vecchio teatro cittadino",
         "records from the old municipal theatre"
        ],
        [
         "chiuso nel 1952",
         "closed in 1952"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "La restauratrice, che stava catalogando i documenti, si è accorta che una fotografia mostrava un attore mai citato negli archivi. Il direttore ha chiesto a una storica di verificare il nome.",
       "alumno": "The restorer, who was cataloguing the documents, noticed that one photograph showed an actor never mentioned in the archives. The director asked a historian to verify the name.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "un attore mai citato negli archivi",
         "an actor never mentioned in the archives"
        ],
        [
         "di verificare il nome",
         "to verify the name"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Confrontando la foto con un giornale dell'epoca, lei ha scoperto che l'attore aveva lasciato la compagnia dopo una discussione.",
       "alumno": "By comparing the photo with a newspaper of the time, she discovered that the actor had left the company after an argument.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "aveva lasciato la compagnia",
         "had left the company"
        ],
        [
         "dopo una discussione",
         "after an argument"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Il museo preparerà una piccola mostra, ma prima contatterà i discendenti per chiedere il permesso di esporre le immagini.",
       "alumno": "The museum will prepare a small exhibition, but first it will contact the descendants to ask permission to display the images.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "per chiedere il permesso",
         "to ask for permission"
        ],
        [
         "di esporre le immagini",
         "to display the images"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
   ]
