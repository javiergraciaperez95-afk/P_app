   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Consistency of the auxiliary",
     "texto": [
      "If a verb takes **essere** in the passato prossimo (sono uscito, siamo partiti), it keeps **essere** in the pluperfect (ero uscito, eravamo partiti), with compulsory agreement in gender and number.",
      "If it takes **avere** (ho dormito, abbiamo preparato), it keeps **avere** (avevo dormito, avevamo preparato), with an invariable ending in **-o**."
     ],
     "tutora": ""
    },
