   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Senza + infinitive",
     "texto": [
      "**Senza dire niente** (without saying anything), **senza salutare** (without greeting).",
      "It shows that the action of the infinitive does not happen: **È uscito senza dire niente** (he went out without saying anything)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Per + infinitive",
     "texto": [
      "**Per capire** (in order to understand), **per arrivare** (in order to arrive).",
      "It shows purpose: **Per chiedere, bisogna essere gentili** (to ask, you have to be polite)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Scusarsi",
     "texto": [
      "**Scusarsi** (to apologise): **Senza scusarsi** (without apologising).",
      "It is a reflexive verb: **mi scuso** (I apologise)."
     ],
     "tutora": ""
    },
