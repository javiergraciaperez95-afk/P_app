      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "«Anche se» usually takes the indicative, whereas «sebbene» requires the subjunctive.",
       "lengua": "alumno",
       "explicacion": "A crucial mood distinction at Italian B1 level.",
       "correcta": true
      },
      {
       "texto": "«Anche se» can only be used at the end of the main clause.",
       "lengua": "alumno",
       "explicacion": "False: it can come before or after freely.",
       "correcta": false
      },
      {
       "texto": "«Anche se» rules out the use of verbs in the past tense.",
       "lengua": "alumno",
       "explicacion": "It is used in the present, past and future without restriction.",
       "correcta": false
      }
     ],
