   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Consequence versus cause",
     "texto": [
      "**Piove, quindi prendiamo l'ombrello** (it's raining, so we take the umbrella) versus *Prendiamo l'ombrello perché piove*."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Concession versus justification",
     "texto": [
      "**Anche se piove, esco senza fretta** (although it's raining, I go out without rushing); **Il treno è perfetto: infatti arriva sempre in perfetto orario** (the train is perfect: in fact it always arrives with clockwork punctuality)."
     ],
     "tutora": ""
    },
    {
