     "opciones": [
      {
       "texto": "A consequence drawn from the premise of the motorway traffic jam.",
       "lengua": "alumno",
       "explicacion": "«Quindi» acts as a concluding inferential connector («therefore»).",
       "correcta": true
      },
      {
       "texto": "An unreal hypothetical condition in the present.",
       "lengua": "alumno",
       "explicacion": "It does not express a subjunctive condition with «se».",
       "correcta": false
      },
      {
       "texto": "A flat opposition to the wishes of the other person.",
       "lengua": "alumno",
       "explicacion": "It does not introduce any contradictory objection.",
