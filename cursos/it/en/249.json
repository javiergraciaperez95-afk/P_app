 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Following complex instructions",
     "texto": [
      "It separates the mandatory steps, the alternative for those without a connection and the consequences of not responding in time.",
      "The expressions **solo se**, **se manca** and **trascorso tale termine** set out the conditions."
     ],
     "tutora": ""
    }
   ]
  },
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Rinnovare l'abbonamento",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Per rinnovare l'abbonamento, compilare il modulo online entro il 30 giugno e allegare una copia del documento.",
       "alumno": "To renew the subscription, fill in the form online before 30 June and attach a copy of the document.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "La richiesta viene accettata solo se i dati coincidono con quelli già registrati.",
       "alumno": "The application is accepted only if the data match those already registered.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Chi non dispone di una connessione può rivolgersi allo sportello al piano terra, dal lunedì al venerdì, dalle 9 alle 12.",
       "alumno": "Anyone who does not have a connection can go to the counter on the ground floor, from Monday to Friday, from 9 to 12.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Se manca un allegato, l'ufficio invia una notifica e concede dieci giorni per completare la domanda; trascorso tale termine, sarà necessario presentare una nuova richiesta.",
       "alumno": "If an attached document is missing, the office sends a notice and grants ten days to complete the application; once that deadline has passed, a new application will be necessary.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Durante i lavori, lo sportello si sposta temporaneamente nell'edificio accanto, ma gli orari restano invariati.",
       "alumno": "During the works, the counter moves temporarily to the building next door, but the opening hours do not change.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
