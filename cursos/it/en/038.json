   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "At the hotel",
     "texto": [
      "On arrival: **Ho una prenotazione** (I have a reservation).",
      "Rooms: **una camera singola** (single), **una camera doppia** (with two beds) and **una camera matrimoniale** (with a double bed). Nights: **per due notti**.",
      "To confirm: **Esatto** (that's right).",
      "Floors: **al primo piano**, **al secondo piano**, **al terzo piano**."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "If you don't feel well",
     "texto": [
      "**Come ti senti?** = how do you feel?",
      "**Non mi sento bene** = I don't feel well. **Sono malato** = I'm ill.",
      "Aches are expressed with **avere mal di**: **Ho mal di testa** (I have a headache), **Ho mal di stomaco** (I have a stomachache), **Ho mal di denti** (I have toothache).",
      "**Ho la febbre** = I have a fever."
     ],
     "tutora": ""
    }
   ]
  },
