   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "The classic rule: cities versus regions and countries",
     "texto": [
      "Use **a** with the names of **cities and towns**: **Vado a Roma**, **Abito a Firenze**, **Sono a Bologna**.",
      "Use **in** with the names of **countries, continents and regions**: **Vado in Italia**, **Vivo in Toscana**, **Viaggiamo in Europa**."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Everyday places and means of transport",
     "texto": [
      "With means of transport **in** is used: **in treno**, **in macchina**, **in aereo**.",
      "With certain urban places the usage is fixed: **a scuola**, **a casa**, **a teatro**, **a cena**; but **in ufficio**, **in banca**, **in farmacia**, **in biblioteca**, **in centro**."
     ],
     "tutora": ""
    },
