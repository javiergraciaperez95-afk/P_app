     "tipo": "test",
     "id": "it095-1",
     "pregunta": {
      "texto": "Which preposition must be used compulsorily before the name of a city such as Venice?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "La preposición «a»: «Vado a Venezia».",
       "lengua": "estudio",
       "explicacion": "Cities and towns canonically take the preposition «a».",
       "correcta": true
      },
      {
       "texto": "La preposición «in»: «Vado in Venezia».",
       "lengua": "estudio",
       "explicacion": "«In» is reserved for regions, nations and continents.",
       "correcta": false
      },
      {
       "texto": "La preposición «su»: «Vado su Venezia».",
       "lengua": "estudio",
       "explicacion": "An incorrect locative sense for indicating an urban destination.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
