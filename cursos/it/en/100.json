  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Stating your own opinion",
     "texto": [
      "**Secondo me...** (in my opinion / to my mind); **A mio parere...** (in my view); **Penso che... / Credo che...** (I think that / I believe that); **Mi sembra che...** (it seems to me that)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Showing agreement and disagreement",
     "texto": [
      "To express agreement: **Sono d'accordo con te** (I agree with you); **Hai perfettamente ragione** (you're completely right); **È vero** (it's true).",
      "To disagree politely: **Non sono d'accordo** (I don't agree); **Secondo me ti sbagli** (in my opinion you're mistaken); **Dipende da molti fattori** (it depends on many factors).",
      "To qualify a point: **Tuttavia** (however / nevertheless)."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Dialogue of an opinion debate",
     "columnas": [
