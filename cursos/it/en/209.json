     "id": "it209-4",
     "pregunta": {
      "texto": "What fundamental difference separates the simple gerund from the compound gerund?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "The simple gerund expresses simultaneity, while the compound marks a completed earlier action.",
       "lengua": "alumno",
       "explicacion": "An aspectual contrast between an ongoing process and an earlier event.",
       "correcta": true
      },
      {
       "texto": "The simple gerund is reserved for literature and the compound is used only in colloquial speech.",
       "lengua": "alumno",
       "explicacion": "Both belong to formal, standard registers.",
       "correcta": false
      },
      {
       "texto": "The compound gerund never takes attached clitic pronouns.",
       "lengua": "alumno",
       "explicacion": "It takes clitics attached to the auxiliary, without any problem.",
       "correcta": false
      }
     ],
