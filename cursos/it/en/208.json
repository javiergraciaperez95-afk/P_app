   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Choosing the auxiliary in the infinitive",
     "texto": [
      "**With avere**: transitive verbs («Dopo aver esaminato gli atti, il giudice emanò la sentenza») and most intransitive verbs.",
      "**With essere**: verbs of movement, changes of state and reflexive verbs, with compulsory agreement of the participle («Dopo essere arrivata alla stazione, Chiara chiamò un taxi»)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Pronouns with the compound infinitive",
     "texto": [
      "Clitic pronouns attach at the end of the shortened one-syllable auxiliary (**dopo averlo visto**, **dopo essersene andato**) or to the full infinitive: «Dopo avergli parlato, mi sono tranquillizzato»."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Auxiliary",
     "columnas": [
