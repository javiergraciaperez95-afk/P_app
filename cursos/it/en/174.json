   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Siccome and dato che",
     "texto": [
      "**Siccome** usually goes at the start: **Siccome piove, non esco** (since it's raining, I'm not going out).",
      "**Dato che** and **visto che** can go at the start or in the middle: **Visto che sei qui, parliamo** (since you're here, let's talk)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "With nouns",
     "texto": [
      "For a reason expressed with a noun, use **a causa di** or **per colpa di** (with a negative meaning): **a causa del traffico**, **per colpa della pioggia**. With a positive meaning: **grazie a**."
     ],
     "tutora": ""
    },
    {
