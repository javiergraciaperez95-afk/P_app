     "id": "it201-1",
     "pregunta": {
      "texto": "What feature defines the «strong preterite» pattern in Italian?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "An irregular stem shared by the 1st singular, 3rd singular and 3rd plural, unlike the regular forms for tu, noi and voi.",
       "lengua": "alumno",
       "explicacion": "It is the symmetrical rule for verbs such as fare, scrivere and dire.",
       "correcta": true
      },
      {
       "texto": "All persons are conjugated with identical endings, without variation.",
       "lengua": "alumno",
       "explicacion": "The tu, noi and voi forms go back to the regular stem of the present.",
       "correcta": false
      },
      {
       "texto": "It only exists for auxiliary verbs and disappears in the third conjugation.",
       "lengua": "alumno",
       "explicacion": "It appears in dozens of common verbs used in formal and literary language.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
