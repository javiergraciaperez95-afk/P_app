 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Regular endings",
     "texto": [
      "In -are: **parlai**, **parlasti**, **parlò**, **parlammo**, **parlaste**, **parlarono**.",
      "In -ere: **vendei / vendetti**, **vendesti**, **vendé / vendette**, **vendemmo**, **vendeste**, **venderono / vendettero**.",
      "In -ire: **sentii**, **sentisti**, **sentì**, **sentimmo**, **sentiste**, **sentirono**."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Use in literary and historical narrative",
     "texto": [
      "Unlike the passato prossimo, which links a completed event to the speaker's present, the passato remoto places the event in a time frame that is definitely closed or fixed by history: «Dante nacque nel 1265 e morì a Ravenna nel 1321»."
     ],
     "tutora": ""
    },
