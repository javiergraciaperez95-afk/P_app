   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Yes-or-no questions",
     "texto": [
      "«Vieni?» becomes **Mi ha chiesto se venivo** / **Mi ha chiesto se venissi** (he asked me if I was coming / if I would come). It is introduced with **se**.",
      "It has no question marks."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Questions with a question word",
     "texto": [
      "«Dove abiti?» becomes **Mi ha chiesto dove abitavo** (he asked me where I lived). «A che ora parte?» becomes **Mi ha chiesto a che ora partisse** (he asked me what time he was leaving)."
     ],
     "tutora": ""
    },
