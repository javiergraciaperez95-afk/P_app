        "texto": "Domani sarò a casa tutto il giorno. (Tomorrow I'll be at home all day.)",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "avere",
        "lengua": "estudio"
       },
       {
        "texto": "avr-",
        "lengua": "estudio"
       },
       {
        "texto": "Avremo tempo per parlare. (We'll have time to talk.)",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "venire",
        "lengua": "estudio"
       },
       {
        "texto": "verr-",
        "lengua": "estudio"
       },
       {
        "texto": "Verrai anche tu alla festa? (Will you come to the party too?)",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "andare",
        "lengua": "estudio"
       },
       {
        "texto": "andr-",
        "lengua": "estudio"
       },
       {
        "texto": "Andrò a piedi fino in centro. (I'll walk all the way to the centre.)",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "potere",
        "lengua": "estudio"
       },
       {
        "texto": "potr-",
        "lengua": "estudio"
       },
       {
        "texto": "Non potrò venire domani. (I won't be able to come tomorrow.)",
        "lengua": "alumno"
       }
      ]
     ],
