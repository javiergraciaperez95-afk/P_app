 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Rules of the consecutio temporum with the past",
     "texto": [
      "**Simultaneous / later**: «Pensavo che venisse» (I thought he was coming / would come); «Speravo che vincesse» (I hoped he would win).",
      "**Earlier in the past**: «Pensavo che fosse venuto» (I thought he had come); «Credevo che avessero capito» (I believed they had understood)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Forming the congiuntivo trapassato",
     "texto": [
      "It is built with the imperfect subjunctive of the auxiliary (**avessi**, **avesse**, **avessimo**, **aveste**, **avessero** / **fossi**, **fosse**, **fossimo**, **foste**, **fossero**) plus the past participle."
     ],
     "tutora": ""
    },
    {
