  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Background and events",
     "texto": [
      "**Era un giorno d'estate** (it was a summer day): the background, in the imperfect. **Il vecchio aprì la porta** (the old man opened the door): the event, in the passato remoto.",
      "This is how the setting of the story is told apart from the events."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Words for narrating",
     "texto": [
      "**Poi** (then), **dopo poco** (a little later), **in silenzio** (in silence).",
      "They help put the events in order."
     ],
     "tutora": ""
    }
   ]
  },
