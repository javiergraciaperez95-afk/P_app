     "pregunta": {
      "texto": "How is the temporal deictic «ieri» adapted when it passes into indirect speech in the past?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "It changes to «il giorno prima» or «il giorno precedente»",
       "lengua": "alumno",
       "explicacion": "It keeps the retrospective reference from the past.",
       "correcta": true
      },
      {
       "texto": "It is invariably kept as «ieri» with no textual alteration.",
       "lengua": "alumno",
       "explicacion": "It would falsely keep yesterday relative to the current speaker.",
       "correcta": false
      },
      {
       "texto": "It is replaced by «domani», indicating an action oriented towards the future.",
       "lengua": "alumno",
       "explicacion": "It reverses the temporal chronology towards the future.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
