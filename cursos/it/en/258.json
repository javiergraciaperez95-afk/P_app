 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "The future in the past",
     "texto": [
      "When the introductory verb is in the past (disse, promise, assicurò), the future action being reported must be expressed with the **condizionale passato**, never with the simple conditional: «Ci ha garantito che **avrebbe consegnato** la relazione il giorno dopo»."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Formal address in indirect speech",
     "texto": [
      "«Il direttore Le ha chiesto se desiderasse un caffè» (subordinate clause with the polite imperfect subjunctive)."
     ],
     "tutora": ""
    },
    {
