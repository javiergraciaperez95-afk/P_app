  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Compound infinitive",
     "texto": [
      "**aver + past participle** (for verbs with «avere»): **dopo aver mangiato**, **dopo aver finito**.",
      "**essere + past participle** (with verbs of movement): **dopo essere arrivato** (after having arrived). It agrees with the subject: *dopo essere arrivata*."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Time clauses with the indicative",
     "texto": [
      "**non appena** / **appena** (as soon as), **da quando** (since), **ogni volta che** (every time), **fino a quando** (until)."
     ],
     "tutora": ""
    },
    {
