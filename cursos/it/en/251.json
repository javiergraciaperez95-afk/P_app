      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "The TAEG covers all the ancillary costs, processing fees and taxes, reflecting the real cost.",
       "lengua": "alumno",
       "explicacion": "The TAEG is the comprehensive index of effective cost.",
       "correcta": true
      },
      {
       "texto": "The TAN is the amount the bank pays the customer for keeping their savings in the current account.",
       "lengua": "alumno",
       "explicacion": "It confuses the loan's interest with a remuneration of liabilities.",
       "correcta": false
      },
      {
       "texto": "There is no difference, and both abbreviations correspond to the same arithmetical calculation.",
       "lengua": "alumno",
       "explicacion": "It ignores the nature of bank formalisation costs.",
       "correcta": false
