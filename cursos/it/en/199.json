  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Third-person plural",
     "texto": [
      "**Vedere → videro** (see → they saw), **partire → partirono** (leave → they left), **arrivare → arrivarono** (arrive → they arrived), **dire → dissero** (say → they said).",
      "Many other passato remoto forms also appear in written stories."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "When you don't use it",
     "texto": [
      "In everyday conversation, and in northern Italy, the passato prossimo is used: **Ieri ho visto un film** (yesterday I saw a film).",
      "With **tanto tempo fa** (a long time ago) it sounds natural with the passato remoto."
     ],
     "tutora": ""
    }
   ]
  },
