     "opciones": [
      {
       "texto": "Because there are two different subjects: «io voglio» and «tu sia».",
       "lengua": "alumno",
       "explicacion": "The change of agent between the main clause and the subordinate clause requires the subjunctive.",
       "correcta": true
      },
      {
       "texto": "Because «felice» is an adjective that only agrees with the subjunctive.",
       "lengua": "alumno",
       "explicacion": "The choice of mood depends on the verb «volere» with a double subject.",
       "correcta": false
      },
      {
       "texto": "Because the sentence expresses a past action already completed.",
       "lengua": "alumno",
       "explicacion": "It expresses a present wish directed towards the listener.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
