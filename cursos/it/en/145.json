   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "The correspondence of tenses in the past",
     "texto": [
      "**Present → Imperfect**: «Ho mal di testa» becomes **Disse che aveva mal di testa** (he said he had a headache).",
      "**Passato prossimo → Trapassato prossimo**: «Ho finito ieri» becomes **Disse che aveva finito il giorno prima** (he said he had finished the day before).",
      "**Simple future → Past conditional**: «Partirò domani» becomes **Disse che sarebbe partito il giorno dopo** (he said he would leave the next day)."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
