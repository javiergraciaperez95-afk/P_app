     "opciones": [
      {
       "texto": "The preposition «per» followed by a simple infinitive («per superare l'esame»).",
       "lengua": "alumno",
       "explicacion": "The standard expression for a purpose complement in Italian.",
       "correcta": true
      },
      {
       "texto": "The causal conjunction «siccome» at the start of his reply.",
       "lengua": "alumno",
       "explicacion": "«Siccome» introduces earlier causes, not future goals.",
       "correcta": false
      },
      {
       "texto": "The question word «perché» used to ask questions.",
       "lengua": "alumno",
       "explicacion": "It is used to ask for the reason, not to state one's own purpose.",
