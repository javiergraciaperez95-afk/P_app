 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Inviting naturally",
     "texto": [
      "**Ti va una pizza?** (do you fancy a pizza?); **Ti va di venire?** (do you feel like coming?); **Vuoi venire con me?** (do you want to come with me?).",
      "The impersonal verb **andare a qualcuno** means \"to feel like\": **Ti va?** (do you fancy it?), **Vi va?** (do you all fancy it?)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Accepting, declining and apologising",
     "texto": [
      "To accept enthusiastically: **Volentieri!** (gladly!), **Perfetto!** (perfect!).",
      "To decline politely: **Mi dispiace, non posso** (I'm sorry, I can't); **Purtroppo sono impegnato** (unfortunately I'm busy).",
      "To apologise: **Scusa** (informal) or **Mi scusi** (formal)."
     ],
     "tutora": ""
    },
