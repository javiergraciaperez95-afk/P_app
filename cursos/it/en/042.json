 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Basic irregular past participles",
     "texto": [
      "High-frequency verbs: **fare → fatto**, **dire → detto**, **scrivere → scritto**, **aprire → aperto**, **chiudere → chiuso**, **mettere → messo**, **bere → bevuto**, **rispondere → risposto**. Careful! **Dare → dato** is completely regular in -ato."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "The time particle «fa»",
     "texto": [
      "It corresponds to English «ago»: **due giorni fa** (two days ago), **tre mesi fa** (three months ago), **un'ora fa** (an hour ago). It always comes after the time expression."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Past time markers",
     "texto": [
      "**Ieri** (yesterday), **l'altro ieri** (the day before yesterday), **la settimana scorsa** (last week). For «not yet», use **non ancora**: **Non ho ancora scritto la risposta**."
     ],
     "tutora": ""
    },
