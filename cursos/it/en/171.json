  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Singular versus plural",
     "texto": [
      "With a singular object: **Si vende un appartamento** (a flat is sold); with a plural object: **Si vendono appartamenti** (flats are sold).",
      "**Si affitta una camera** (a room is for rent) versus **Si affittano due camere** (two rooms are for rent)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Strict agreement of the transitive verb",
     "texto": [
      "The verb never stays in the singular by chance if the noun that follows is plural: **Qui si parlano quattro lingue** (four languages are spoken here)."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Number of the object",
     "columnas": [
      {
       "texto": "Italian construction",
       "lengua": "alumno"
      },
      {
       "texto": "English translation",
       "lengua": "alumno"
      }
     ],
