     "tipo": "dialogo",
     "titulo": "Annunci nel centro storico",
     "frases": [
      {
       "quien": {
        "texto": "Giulia",
        "lengua": "estudio"
       },
       "estudio": "Guarda questo cartello in vetrina: «Qui si vendono libri usati».",
       "alumno": "Look at this sign in the window: «Second-hand books are sold here».",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "qui si vendono",
         "are sold here"
        ],
        [
         "libri usati",
         "second-hand books"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Matteo",
        "lengua": "estudio"
       },
       "estudio": "Che bella libreria! E accanto c'è scritto che si affittano due camere per studenti.",
       "alumno": "What a lovely bookshop! And next to it, it says two rooms are for rent to students.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "si affittano due camere",
         "two rooms are for rent"
        ],
        [
         "per studenti",
         "to students"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Giulia",
        "lengua": "estudio"
       },
       "estudio": "In quest'agenzia invece si cerca una guida turistica per il museo.",
       "alumno": "At this agency, on the other hand, they are looking for a tourist guide for the museum.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "si cerca una guida",
         "they are looking for a guide"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Matteo",
        "lengua": "estudio"
       },
       "estudio": "Ottimo, così si offrono opportunità concrete ai giovani della città.",
       "alumno": "Great, so concrete opportunities are offered to the young people of the city.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "si offrono opportunità",
         "opportunities are offered"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
   ]
