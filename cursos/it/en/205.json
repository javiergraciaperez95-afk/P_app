  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "How it is formed",
     "texto": [
      "**avendo** or **essendo** + past participle: **avendo finito** (having finished), **essendo arrivato** (having arrived).",
      "Agreement works as in the past infinitive: **essendo arrivata** (having arrived, she)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "When it is used",
     "texto": [
      "In formal sentences and narratives: **Avendo speso troppo, sono stanco** (having spent too much, I am tired).",
      "In everyday speech the past infinitive is preferred: «dopo aver speso…»."
     ],
     "tutora": ""
    }
   ]
