 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Seguir una instrucción compleja",
     "texto": [
      "Separa los pasos obligatorios, la alternativa para quien no tiene conexión y las consecuencias de no responder a tiempo.",
      "Las expresiones **solo se**, **se manca** y **trascorso tale termine** delimitan las condiciones."
     ],
     "tutora": ""
    }
   ]
  },
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Rinnovare l'abbonamento",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Per rinnovare l'abbonamento, compilare il modulo online entro il 30 giugno e allegare una copia del documento.",
       "alumno": "Para renovar el abono, rellene el formulario en línea antes del 30 de junio y adjunte una copia del documento.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "La richiesta viene accettata solo se i dati coincidono con quelli già registrati.",
       "alumno": "La solicitud se acepta solo si los datos coinciden con los que ya están registrados.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Chi non dispone di una connessione può rivolgersi allo sportello al piano terra, dal lunedì al venerdì, dalle 9 alle 12.",
       "alumno": "Quien no disponga de conexión puede acudir a la ventanilla de la planta baja, de lunes a viernes, de 9 a 12.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Se manca un allegato, l'ufficio invia una notifica e concede dieci giorni per completare la domanda; trascorso tale termine, sarà necessario presentare una nuova richiesta.",
       "alumno": "Si falta un documento adjunto, la oficina envía una notificación y concede diez días para completar la solicitud; transcurrido ese plazo, será necesario presentar una nueva solicitud.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Durante i lavori, lo sportello si sposta temporaneamente nell'edificio accanto, ma gli orari restano invariati.",
       "alumno": "Durante las obras, la ventanilla se traslada temporalmente al edificio de al lado, pero los horarios no cambian.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
