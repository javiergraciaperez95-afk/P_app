     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Hace calor y hace sol.",
       "lengua": "alumno",
       "explicacion": "«Fa caldo» y «c'è il sole» expresan calor y tiempo soleado.",
       "correcta": true
      },
      {
       "texto": "Hace frío y hace viento.",
       "lengua": "alumno",
       "explicacion": "Para frío y viento se diría «Fa freddo e c'è vento».",
       "correcta": false
      },
      {
       "texto": "Llueve y está nublado.",
