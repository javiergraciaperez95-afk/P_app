     "id": "it034-7",
     "pregunta": {
      "texto": "¿Qué tiempo atmosférico se describe?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "Fa caldo e c'è il sole.",
      "lengua": "estudio"
