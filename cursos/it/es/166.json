     "pregunta": {
      "texto": "¿Cuál es la cuestión central que debate el pleno municipal?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "La posible peatonalización de la calle Roma para mejorar la convivencia urbana.",
       "lengua": "alumno",
       "explicacion": "Objeto formal del proyecto deliberado por el concejo municipal.",
       "correcta": true
      },
      {
       "texto": "La demolición de los antiguos puestos comerciales del mercado central.",
       "lengua": "alumno",
       "explicacion": "No se proyecta ninguna obra de demolición de instalaciones.",
       "correcta": false
      },
      {
