   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Formación del congiuntivo passato",
     "texto": [
      "Se compone del auxiliar en congiuntivo presente (**abbia**, **abbiamo**, **abbiate**, **abbiano** / **sia**, **siamo**, **siate**, **siano**) más el participio pasado del verbo.",
      "**Concordancia con essere**: «Credo che Chiara sia partita» frente a «Credo che i ragazzi siano partiti»."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Contraste de anterioridad frente a simultaneidad",
     "texto": [
      "**Simultáneo (presente)**: «Penso che Paolo lavori adesso» (pienso que trabaja ahora).",
      "**Anterior (passato)**: «Penso che Paolo abbia lavorato ieri» (pienso que trabajó ayer)."
     ],
     "tutora": ""
    },
