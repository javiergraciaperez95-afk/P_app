     "pregunta": {
      "texto": "¿Qué rasgo sintáctico diferencia a «perché» de «per» al expresar objetivos?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "«Perché» causal rige verbo conjugado; «per» de finalidad rige infinitivo cuando el sujeto coincide.",
       "lengua": "alumno",
       "explicacion": "Regla sintáctica fundamental de subordinación en italiano.",
       "correcta": true
      },
      {
       "texto": "«Per» sólo puede utilizarse con sustantivos de cantidad económica.",
       "lengua": "alumno",
       "explicacion": "Falso: se emplea con infinitivos de finalidad sin límite.",
       "correcta": false
      },
      {
       "texto": "«Perché» está prohibido en respuestas afirmativas.",
       "lengua": "alumno",
       "explicacion": "Es la conjunción de respuesta causal por excelencia.",
       "correcta": false
      }
     ],
     "respuestas": {
