     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Que el sujeto de la subordinada coincida con el sujeto de la oración principal",
       "lengua": "alumno",
       "explicacion": "«Dopo aver revisionato i dati, la ricercatrice stampò il saggio».",
       "correcta": true
      },
      {
       "texto": "Que la frase principal esté formulada obligatoriamente en modo subjuntivo",
       "lengua": "alumno",
       "explicacion": "Funciona habitualmente con indicativo, condicional o imperativo.",
       "correcta": false
      },
      {
       "texto": "Que el verbo subordinado sea exclusivamente intransitivo de movimiento",
       "lengua": "alumno",
       "explicacion": "Se usa primordialmente con verbos transitivos con el auxiliar «avere».",
       "correcta": false
      }
