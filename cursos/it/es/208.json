    {
     "tipo": "test",
     "id": "it208-4",
     "pregunta": {
      "texto": "¿Cómo se colocan los pronombres clíticos con el infinitivo pasado en «dopo averlo visto»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Se adhieren enclíticamente al final del auxiliar infinitivo apocopado",
       "lengua": "alumno",
       "explicacion": "«Aver» pierde la -e y recibe el pronombre «-lo».",
       "correcta": true
      },
      {
       "texto": "Se sitúan obligatoriamente separados entre «dopo» y el auxiliar",
       "lengua": "alumno",
       "explicacion": "Estructura agramatical en la lengua italiana.",
       "correcta": false
      },
      {
       "texto": "Se colocan al final del participio pasado conjugado",
       "lengua": "alumno",
       "explicacion": "El clítico no se une al participio cuando hay auxiliar en infinitivo.",
       "correcta": false
      }
     ],
     "respuestas": {
