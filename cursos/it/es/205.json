   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Cómo se forma",
     "texto": [
      "**avendo** o **essendo** + participio: **avendo finito** (habiendo terminado), **essendo arrivato** (habiendo llegado).",
      "La concordancia es igual que en el infinitivo pasado: **essendo arrivata** (habiendo llegado, ella)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Cuándo se usa",
     "texto": [
      "En frases formales y narraciones: **Avendo speso troppo, sono stanco** (habiendo gastado demasiado, estoy cansado).",
      "En el habla normal se prefiere el infinitivo pasado: «dopo aver speso…»."
     ],
     "tutora": ""
    }
   ]
