     "id": "it251-1",
     "pregunta": {
      "texto": "¿Cuál es la diferencia primordial entre el tipo nominal (TAN) y la tasa global (TAEG) en el contrato?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "El TAEG integra la totalidad de costes accesorios, gastos de tramitación e impuestos, reflejando el coste real",
       "lengua": "alumno",
       "explicacion": "El TAEG es el índice integral de coste efectivo.",
       "correcta": true
      },
      {
       "texto": "El TAN es la cuota que paga el banco al cliente por custodiar sus ahorros en la cuenta corriente",
       "lengua": "alumno",
       "explicacion": "Confunde el interés del préstamo con una remuneración de pasivo.",
       "correcta": false
      },
      {
       "texto": "No existe ninguna diferencia y ambas siglas corresponden al mismo cálculo aritmético",
       "lengua": "alumno",
       "explicacion": "Desconoce la naturaleza de los gastos de formalización bancaria.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
