      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Porque «telefonare» rige preposición «a» (indirecto) y «chiamare» es transitivo directo.",
