     "pregunta": {
      "texto": "¿Para qué se escribe la «h» en «ho», «hai», «ha» y «hanno»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Para distinguir visualmente las formas verbales de otras palabras homófonas como «o», «a» o «anno».",
       "lengua": "alumno",
       "explicacion": "La «h» es totalmente muda, pero imprescindible en la ortografía.",
       "correcta": true
      },
      {
       "texto": "Porque en italiano la «h» inicial se pronuncia aspirada.",
       "lengua": "alumno",
       "explicacion": "La «h» nunca se pronuncia en italiano moderno.",
       "correcta": false
      },
      {
       "texto": "Para indicar que el sujeto de la frase es plural.",
       "lengua": "alumno",
       "explicacion": "No, tres de esas cuatro formas son de singular (ho, hai, ha).",
       "correcta": false
      }
