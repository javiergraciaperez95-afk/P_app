    {
     "tipo": "traduccion",
     "id": "it134-6",
     "pregunta": {
      "texto": "¿Qué significa esta aclaración administrativa?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "Non occorre spedire i documenti originali per posta ordinaria.",
      "lengua": "estudio"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Que es suficiente aportar copias digitales sin tener que desprenderse de los originales físicos.",
       "lengua": "alumno",
       "explicacion": "«Non occorre» exime al usuario de remitir papel original por vía postal.",
       "correcta": true
      },
      {
       "texto": "Que la correspondencia por correo ordinario es la única vía admitida para reclamar.",
       "lengua": "alumno",
       "explicacion": "Señala exactamente lo opuesto: no hace falta recurrir al correo postal ordinario.",
       "correcta": false
      },
      {
