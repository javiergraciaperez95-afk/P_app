     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Con la desinencia «-ando»: «aspettare → aspettando».",
       "lengua": "alumno",
       "explicacion": "La primera conjugación adopta invariablemente la terminación «-ando».",
       "correcta": true
      },
      {
       "texto": "Con la desinencia «-endo»: «aspettare → aspettendo».",
       "lengua": "alumno",
       "explicacion": "La desinencia «-endo» es propia de las conjugaciones segunda y tercera.",
       "correcta": false
      },
      {
       "texto": "Con la desinencia «-ato»: «aspettare → aspettato».",
       "lengua": "alumno",
       "explicacion": "Eso es el participio pasado, no el gerundio.",
       "correcta": false
      }
