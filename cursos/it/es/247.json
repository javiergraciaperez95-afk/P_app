  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "texto",
     "titulo": "La biblioteca del barrio",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Il comune ha avviato un progetto per riaprire la biblioteca di quartiere anche la sera.",
       "alumno": "El municipio ha puesto en marcha un proyecto para reabrir la biblioteca del barrio también por la noche.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "La decisione è nata dopo un sondaggio: molti residenti lavorano fino a tardi e non riescono a partecipare alle attività pomeridiane.",
       "alumno": "La decisión nació tras una encuesta: muchos residentes trabajan hasta tarde y no pueden participar en las actividades de la tarde.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Due volontari coordinano gli incontri, mentre il personale seleziona libri e articoli accessibili anche a chi studia italiano.",
       "alumno": "Dos voluntarios coordinan los encuentros, mientras el personal selecciona libros y artículos accesibles también para quienes estudian italiano.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Il progetto dura sei mesi; alla fine, il comune valuterà presenze e proposte dei partecipanti.",
       "alumno": "El proyecto dura seis meses; al final, el municipio evaluará la asistencia y las propuestas de los participantes.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Se l'interesse resterà alto, gli orari serali saranno mantenuti.",
       "alumno": "Si el interés sigue siendo alto, se mantendrán los horarios nocturnos.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Gli organizzatori precisano però che la sala studio chiuderà durante i lavori di ristrutturazione.",
       "alumno": "Los organizadores aclaran, sin embargo, que la sala de estudio cerrará durante las obras de reforma.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
