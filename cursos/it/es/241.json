    {
     "tipo": "test",
     "id": "it241-1",
     "pregunta": {
      "texto": "¿Cómo se concuerda el participio en tiempos compuestos de verbos con «la» fija como «farcela» o «cavarsela»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Siempre en femenino singular «-a» por la presencia del clítico «la»",
       "lengua": "alumno",
       "explicacion": "«Ce l'ho fatta» / «Se la sono cavata».",
       "correcta": true
      },
      {
       "texto": "En masculino plural invariable «-i» siguiendo al sujeto lógico",
       "lengua": "alumno",
       "explicacion": "Vulneraría la regla de concordancia del clítico directo femenino.",
       "correcta": false
      },
      {
       "texto": "En masculino singular invariable «-o» como en los verbos transitivos con avere",
       "lengua": "alumno",
       "explicacion": "El auxiliar es «essere» y rige la concordancia con «la».",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
