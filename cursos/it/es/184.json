     "tipo": "test",
     "id": "it184-4",
     "pregunta": {
      "texto": "¿Qué balance arrojan los datos de la recogida selectiva en el barrio según el segundo comunicado?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Una reducción del veinte por ciento en los residuos no reciclables y ampliación del plan a toda la urbe.",
       "lengua": "alumno",
       "explicacion": "«Riduzione del venti per cento... il servizio sarà presto esteso a tutta la città».",
       "correcta": true
      },
      {
