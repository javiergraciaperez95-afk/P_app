    {
     "tipo": "test",
     "id": "it184-1",
     "pregunta": {
      "texto": "¿En qué franja horaria prestará servicio la biblioteca municipal durante el periodo estival?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Exclusivamente de lunes a viernes por la mañana, entre las 8:30 y las 13:30 horas.",
       "lengua": "alumno",
       "explicacion": "«Aperta dal lunedì al venerdì solo al mattino, dalle 8:30 alle 13:30».",
       "correcta": true
      },
      {
       "texto": "De martes a domingo en jornada ininterrumpida de mañana y tarde.",
       "lengua": "alumno",
       "explicacion": "Contradice el cierre de sábados y la limitación matinal de lunes a viernes.",
       "correcta": false
      },
      {
       "texto": "Únicamente los sábados por la tarde para préstamos infantiles.",
       "lengua": "alumno",
       "explicacion": "El sábado permanece totalmente cerrada al público.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
    {
     "tipo": "test",
     "id": "it184-2",
     "pregunta": {
      "texto": "¿Qué trámite documental se exige para darse de alta en el servicio de préstamo bibliotecario?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Presentar un documento oficial de identidad en vigor.",
       "lengua": "alumno",
       "explicacion": "«È necessario mostrare un documento d'identità valido».",
       "correcta": true
      },
      {
       "texto": "Abonar una tasa anual de cincuenta euros en la taquilla central.",
       "lengua": "alumno",
       "explicacion": "El texto no menciona ningún pago ni arancel económico.",
       "correcta": false
      },
      {
       "texto": "Aportar una carta de recomendación firmada por dos profesores.",
       "lengua": "alumno",
       "explicacion": "Requisito inventado sin respaldo en el comunicado cívico.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
