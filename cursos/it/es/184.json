     "id": "it184-3",
     "pregunta": {
      "texto": "¿Cómo pueden los usuarios devolver libros prestados si la biblioteca se encuentra cerrada?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Depositándolos en el buzón o caja habilitada en el exterior de la entrada.",
       "lengua": "alumno",
       "explicacion": "«Usare la scatola all'ingresso».",
       "correcta": true
      },
      {
       "texto": "Entregándoselos en mano a los agentes de la policía local.",
       "lengua": "alumno",
       "explicacion": "Procedimiento ajeno a las instrucciones del centro.",
       "correcta": false
      },
      {
       "texto": "Esperando obligatoriamente a la reapertura ordinaria del mes siguiente.",
       "lengua": "alumno",
       "explicacion": "Inexacto: el buzón permite devoluciones fuera de horario.",
       "correcta": false
      }
     ],
