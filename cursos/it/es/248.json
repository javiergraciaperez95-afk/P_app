     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Recomienda una modalidad mixta, sujeta a buenas condiciones organizativas.",
       "lengua": "alumno",
       "explicacion": "Combina beneficios, límites y condiciones.",
       "correcta": true
