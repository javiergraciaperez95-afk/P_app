     "id": "it248-1",
     "pregunta": {
      "texto": "¿Qué ventaja señalan algunos empleados?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Se pierde menos tiempo en los desplazamientos.",
       "lengua": "alumno",
       "explicacion": "Es una de las razones a favor del teletrabajo.",
       "correcta": true
      },
      {
       "texto": "Se separa siempre mejor el trabajo del tiempo libre.",
       "lengua": "alumno",
       "explicacion": "El texto presenta esto como una dificultad.",
       "correcta": false
      },
      {
       "texto": "La empresa garantiza automáticamente las mismas herramientas.",
       "lengua": "alumno",
       "explicacion": "Se presenta como una condición necesaria.",
       "correcta": false
      }
     ],
     "respuestas": {
