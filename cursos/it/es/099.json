     "tipo": "dialogo",
     "titulo": "Piani per il pomeriggio",
     "frases": [
      {
       "quien": {
        "texto": "Sara",
        "lengua": "estudio"
       },
       "estudio": "Se piove forte, resto a casa a leggere un buon libro.",
       "alumno": "Si llueve fuerte, me quedo en casa a leer un buen libro.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Se piove forte",
         "si llueve fuerte"
        ],
        [
