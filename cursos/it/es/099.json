         "me quedo en casa"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Luca",
        "lengua": "estudio"
       },
       "estudio": "Se fa freddo, io metto la sciarpa pesante e vado comunque in palestra.",
       "alumno": "Si hace frío, yo me pongo la bufanda gruesa y voy de todos modos al gimnasio.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Se fa freddo",
         "si hace frío"
        ],
        [
         "metto la sciarpa",
         "me pongo la bufanda"
        ],
        [
         "vado comunque",
         "voy de todos modos"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Sara",
        "lengua": "estudio"
       },
       "estudio": "Ma se non piove e il cielo è sereno, veniamo tutti al parco cittadino?",
       "alumno": "Pero si no llueve y el cielo está despejado, ¿vamos todos al parque de la ciudad?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "se non piove",
         "si no llueve"
        ],
        [
         "il cielo è sereno",
         "el cielo está despejado"
        ],
        [
         "veniamo tutti al parco",
         "vamos todos al parque"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Luca",
        "lengua": "estudio"
       },
       "estudio": "È possibile! Quindi aspettiamo le tre e decidiamo insieme che cosa fare.",
       "alumno": "¡Es posible! Así que esperamos a las tres y decidimos juntos qué hacer.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
