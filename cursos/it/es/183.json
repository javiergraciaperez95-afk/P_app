      {
       "quien": {
        "texto": "Matteo",
        "lengua": "estudio"
       },
       "estudio": "Hai ragione, bisogna riciclare di più per tutelare l'ambiente cittadino.",
       "alumno": "Tienes razón, hay que reciclar más para proteger el entorno urbano.",
       "literal": "",
       "estructura": "",
       "nota": [],
