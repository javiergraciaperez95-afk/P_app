     "pregunta": {
      "texto": "¿Cómo se adapta el deíctico temporal «ieri» al pasar al discurso indirecto en pasado?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Se transforma en «il giorno prima» o «il giorno precedente»",
       "lengua": "alumno",
       "explicacion": "Mantiene la referencia retrospectiva desde el pasado.",
       "correcta": true
      },
      {
       "texto": "Se conserva invariablemente como «ieri» sin ninguna alteración textual",
       "lengua": "alumno",
       "explicacion": "Mantendría falsamente el ayer relativo al hablante actual.",
       "correcta": false
      },
      {
       "texto": "Se sustituye por «domani» indicando una acción orientada hacia el porvenir",
       "lengua": "alumno",
       "explicacion": "Invierte la cronología temporal hacia el futuro.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
