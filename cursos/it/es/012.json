     "id": "it012-1",
     "pregunta": {
      "texto": "¿Cuál es la terminación de la segunda persona singular («tu») en los verbos en -are?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "-i",
       "lengua": "estudio",
       "explicacion": "En italiano regular, «tu» siempre termina en -i (tu parli, tu abiti).",
       "correcta": true
      },
      {
       "texto": "-as",
       "lengua": "estudio",
       "explicacion": "La terminación -as es del español, en italiano no se usa la -s final.",
       "correcta": false
      },
      {
       "texto": "-a",
       "lengua": "estudio",
       "explicacion": "La terminación -a corresponde a la tercera persona («lui/lei parla»).",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
