    {
     "tipo": "test",
     "id": "it012-2",
     "pregunta": {
      "texto": "¿Dónde recae el acento tónico en la forma de «loro» en los verbos en -are?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "En la raíz del verbo (esdrújula): «PAR-la-no», «A-bi-ta-no».",
       "lengua": "alumno",
       "explicacion": "El acento retrocede en la tercera persona plural.",
       "correcta": true
      },
      {
       "texto": "En la última sílaba: «parla-NÓ».",
       "lengua": "alumno",
       "explicacion": "En italiano nunca se acentúa la desinencia -ano.",
       "correcta": false
      },
      {
       "texto": "En la penúltima sílaba como en español: «par-LA-no».",
       "lengua": "alumno",
       "explicacion": "A diferencia del español «hablan», en italiano el acento recae en la antepenúltima.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
