      {
       "texto": "El auxiliar «essere»: «siamo partiti / sono partito».",
       "lengua": "alumno",
       "explicacion": "Al ser un verbo intransitivo de movimiento requiere el auxiliar essere.",
       "correcta": true
      },
      {
       "texto": "El auxiliar «avere»: «abbiamo partito».",
       "lengua": "alumno",
       "explicacion": "Los verbos de movimiento espacial no se conjugan con avere.",
       "correcta": false
      },
      {
       "texto": "Puede utilizar indistintamente avere o essere sin cambio alguno.",
       "lengua": "alumno",
       "explicacion": "La selección de essere es preceptiva.",
