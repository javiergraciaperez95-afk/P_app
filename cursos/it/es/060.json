     "pregunta": {
      "texto": "¿Por qué el participio termina en -a?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "La nuova mostra di pittura? L'ho vista sabato scorso.",
      "lengua": "estudio"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Porque concuerda con el pronombre directo femenino singular «la» (l'ho vista).",
       "lengua": "alumno",
       "explicacion": "Ante el auxiliar «avere», el pronombre directo elidido fuerza la concordancia en femenino.",
       "correcta": true
      },
      {
       "texto": "Porque el sujeto de la frase es una mujer.",
       "lengua": "alumno",
       "explicacion": "La concordancia con avere se rige por el pronombre directo antepuesto, no por el sujeto.",
       "correcta": false
      },
      {
       "texto": "Porque «mostra» es un verbo en forma participial.",
       "lengua": "alumno",
       "explicacion": "«Mostra» es un sustantivo femenino.",
