     "oir_frase": false,
     "opciones": [
      {
       "texto": "La preposición «a» (credere a, pensare a, rinunciare a).",
       "lengua": "estudio",
       "explicacion": "Regla de régimen sintáctico que distingue «ci» (+a) de «ne» (+di).",
       "correcta": true
      },
      {
       "texto": "La preposición «di» (parlare di, discutere di).",
       "lengua": "estudio",
       "explicacion": "«Di» exige obligatoriamente «ne».",
       "correcta": false
      },
