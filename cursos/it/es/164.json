     "id": "it164-1",
     "pregunta": {
      "texto": "¿Qué significado asume «ci» en la réplica «Sì, ci siamo stati l'anno scorso»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Significa «allí», retomando la ciudad de Venecia como complemento de lugar.",
       "lengua": "alumno",
       "explicacion": "Referencia locativa evidente a partir de la pregunta precedente.",
       "correcta": true
      },
      {
       "texto": "Significa «de eso», aludiendo a la compra de billetes.",
       "lengua": "alumno",
       "explicacion": "Confundiría el locativo «ci» con el partitivo temático «ne».",
       "correcta": false
      },
      {
       "texto": "Significa «nosotros», actuando como sujeto del verbo estar.",
       "lengua": "alumno",
       "explicacion": "«Ci» es adverbio o pronombre átono, no pronombre sujeto.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
