     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "«Anche se» rige habitualmente modo indicativo, mientras que «sebbene» exige subjuntivo.",
       "lengua": "alumno",
       "explicacion": "Distinción modal crucial en el nivel B1 de italiano.",
       "correcta": true
      },
      {
       "texto": "«Anche se» sólo puede emplearse al final de la oración principal.",
       "lengua": "alumno",
       "explicacion": "Falso: puede anteceder o posponerse libremente.",
       "correcta": false
      },
      {
       "texto": "«Anche se» prohíbe el uso de verbos en tiempo pasado.",
       "lengua": "alumno",
       "explicacion": "Se emplea en presente, pasado y futuro sin restricción.",
       "correcta": false
