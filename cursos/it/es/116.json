    {
     "tipo": "explicacion",
     "titulo": "Los dos valores del futuro",
     "texto": [
      "**Valor temporal de posterioridad**: se refiere a un hecho que sucederá más adelante: **Domani finiranno il progetto** (mañana terminarán el proyecto).",
      "**Valor conjetural o epistemico**: formula una suposición razonable sobre una situación actual desconocida: **Dov'è Paolo? — Sarà ancora in ufficio** (¿Dónde está Paolo? — Probablemente todavía está en la oficina)."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Oración",
     "columnas": [
      {
       "texto": "Valor del futuro",
       "lengua": "alumno"
      },
      {
       "texto": "Significado real",
       "lengua": "alumno"
      }
     ],
     "filas": [
      [
       {
        "texto": "Domani partiranno per Milano.",
        "lengua": "estudio"
       },
       {
        "texto": "Posterioridad temporal",
        "lengua": "alumno"
       },
       {
        "texto": "Saldrán mañana hacia Milán con certeza.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Lorenzo sarà in riunione adesso.",
        "lengua": "estudio"
       },
       {
        "texto": "Conjetura / probabilidad",
        "lengua": "alumno"
       },
       {
        "texto": "Supongo que Lorenzo está en reunión ahora.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Che ore sono? — Saranno le tre.",
        "lengua": "estudio"
       },
       {
        "texto": "Estimación aproximada",
        "lengua": "alumno"
       },
       {
        "texto": "Probablemente son alrededor de las tres.",
        "lengua": "alumno"
       }
      ]
     ],
     "nota": "",
     "tutora": ""
    }
   ]
