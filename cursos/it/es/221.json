    {
     "tipo": "test",
     "id": "it221-4",
     "pregunta": {
      "texto": "¿Por qué es incorrecto decir «*Se avrei avuto tempo, sarei venuto»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Porque la conjunción condicional «se» rechaza el modo condicional y exige congiuntivo",
       "lengua": "alumno",
       "explicacion": "«Se avessi avuto», nunca condicional en la prótasis.",
       "correcta": true
      },
      {
       "texto": "Porque el verbo «avere» no admite tiempos compuestos en la lengua italiana",
       "lengua": "alumno",
       "explicacion": "Admite y exige formas compuestas regulares.",
       "correcta": false
      },
      {
       "texto": "Porque el participio «venuto» solo puede conjugarse con verbos transitivos",
       "lengua": "alumno",
       "explicacion": "«Venire» es un verbo inacusativo intransitivo.",
       "correcta": false
      }
     ],
     "respuestas": {
