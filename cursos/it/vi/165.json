   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Quy tắc hòa hợp chặt chẽ",
     "texto": [
      "**lo** → phân từ đuôi **-o** (*L'ho visto*); **la** → phân từ đuôi **-a** (*L'ho vista*); **li** → phân từ đuôi **-i** (*Li ho comprati*); **le** → phân từ đuôi **-e** (*Le ho comprate*)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Lược âm trước nguyên âm",
     "texto": [
      "«Lo» và «la» thường bắt buộc rút thành **l'** trước các dạng của avere (*l'ho salutato*, *l'abbiamo conosciuta*). Những số nhiều «li» và «le» **không bao giờ** rút."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Đại từ",
