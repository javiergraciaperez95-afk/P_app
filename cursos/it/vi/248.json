  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Một đề xuất cân bằng",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Secondo alcuni dipendenti, lavorare da casa riduce il tempo perso negli spostamenti e rende più semplice organizzare gli impegni familiari.",
       "alumno": "Theo một số nhân viên, làm việc tại nhà giảm thời gian mất đi cho việc đi lại và giúp sắp xếp các cam kết gia đình dễ dàng hơn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Altri, però, segnalano che la distanza rende più difficile chiedere aiuto e separare il lavoro dal tempo libero.",
       "alumno": "Nhưng những người khác chỉ ra rằng khoảng cách khiến việc nhờ giúp đỡ trở nên khó hơn và khó tách công việc khỏi thời gian rảnh.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "L'articolo non sostiene che una modalità sia sempre migliore: suggerisce di alternare giornate in ufficio e giornate a distanza.",
       "alumno": "Bài báo không khẳng định rằng một phương thức nào luôn tốt hơn: nó gợi ý luân phiên những ngày làm ở văn phòng và những ngày làm từ xa.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "La proposta funziona, tuttavia, solo se l'azienda stabilisce obiettivi chiari e garantisce a tutti gli stessi strumenti.",
       "alumno": "Tuy nhiên, đề xuất này chỉ hiệu quả nếu công ty đặt ra mục tiêu rõ ràng và đảm bảo cho tất cả những công cụ giống nhau.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Senza queste condizioni, la flessibilità rischia di trasformarsi in isolamento.",
       "alumno": "Nếu không có những điều kiện này, tính linh hoạt có nguy cơ biến thành sự cô lập.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
