     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Lo spazio di coworking è aperto dal lunedì al venerdì, dalle otto alle venti.",
       "alumno": "Không gian coworking mở cửa từ thứ Hai đến thứ Sáu, từ tám đến hai mươi giờ.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Lo spazio di coworking",
         "không gian làm việc chung"
        ],
        [
         "è aperto",
         "đang mở cửa"
        ],
        [
         "dalle otto alle venti",
         "từ tám đến hai mươi giờ"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Per usare la sala riunioni è necessario prenotare almeno un giorno prima.",
       "alumno": "Để dùng phòng họp cần đặt chỗ trước tối thiểu một ngày.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Per usare la sala riunioni",
         "để dùng phòng họp"
        ],
        [
         "è necessario prenotare",
         "cần đặt chỗ"
        ],
        [
         "un giorno prima",
         "trước một ngày"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Le telefonate sono consentite nelle cabine al primo piano; nella zona comune bisogna parlare a bassa voce.",
       "alumno": "Cuộc gọi được phép thực hiện trong buồng ở tầng một; ở khu vực chung phải trao đổi nhỏ tiếng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Le telefonate sono consentite",
         "cuộc gọi được phép"
        ],
        [
         "nelle cabine al primo piano",
         "trong buồng ở tầng một"
        ],
        [
         "parlare a bassa voce",
         "trao đổi nhỏ tiếng"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Il caffè e le bevande calde sono inclusi, mentre le stampe si pagano a parte.",
       "alumno": "Cà phê và đồ uống ấm đã được bao gồm, còn bản in thì trả riêng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "bevande calde sono inclusi",
         "đồ uống ấm đã bao gồm"
        ],
        [
         "le stampe si pagano a parte",
         "bản in trả riêng"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Gli ospiti esterni possono entrare solo se accompagnati da un membro registrato della struttura.",
       "alumno": "Người bên ngoài chỉ được vào nếu đi cùng một thành viên đã đăng ký của cơ sở.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
