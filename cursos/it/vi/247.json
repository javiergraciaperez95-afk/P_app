 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Một sáng kiến của thành phố",
     "texto": [
      "Văn bản trình bày một dự án, các lý do thúc đẩy nó và một điều kiện để duy trì nó. Chú ý **dopo**, **alla fine**, **se** và **però**: chúng sắp xếp dữ liệu và sự tương phản."
     ],
     "tutora": ""
    }
   ]
  },
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Thư viện khu phố",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Il comune ha avviato un progetto per riaprire la biblioteca di quartiere anche la sera.",
       "alumno": "Thành phố đã đưa vào hoạt động một dự án để mở lại thư viện khu phố cả vào buổi tối.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "La decisione è nata dopo un sondaggio: molti residenti lavorano fino a tardi e non riescono a partecipare alle attività pomeridiane.",
       "alumno": "Quyết định ra đời sau một cuộc khảo sát: nhiều cư dân làm việc đến khuya và không thể tham gia các hoạt động buổi chiều.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Due volontari coordinano gli incontri, mentre il personale seleziona libri e articoli accessibili anche a chi studia italiano.",
       "alumno": "Hai tình nguyện viên điều phối các buổi gặp gỡ, còn nhân viên chọn sách và bài báo dễ tiếp cận, kể cả với những người đang học tiếng Ý.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Il progetto dura sei mesi; alla fine, il comune valuterà presenze e proposte dei partecipanti.",
       "alumno": "Dự án kéo dài sáu tháng; cuối cùng, thành phố sẽ đánh giá số người tham dự và các đề xuất của người tham gia.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Se l'interesse resterà alto, gli orari serali saranno mantenuti.",
       "alumno": "Nếu sự quan tâm vẫn cao, giờ buổi tối sẽ được duy trì.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Gli organizzatori precisano però che la sala studio chiuderà durante i lavori di ristrutturazione.",
       "alumno": "Tuy nhiên, ban tổ chức làm rõ rằng phòng học sẽ đóng cửa trong thời gian cải tạo.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
