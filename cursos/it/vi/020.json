   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Giới từ chỉ nơi chốn",
     "texto": [
      "**In** = trong. **Su** = trên. **Sotto** = dưới. **Dietro** = phía sau. **Tra** = giữa.",
      "**Davanti a** = phía trước. **Accanto a** = bên cạnh."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Giới từ + mạo từ",
     "texto": [
      "Trong tiếng Ý, giới từ **a, in, su, di, da** kết hợp với mạo từ thành một từ duy nhất. Đó là giới từ kết hợp.",
      "**su + il = sul** (sul tavolo), **su + la = sulla** (sulla sedia).",
      "**in + il = nel** (nel soggiorno), **in + la = nella** (nella borsa).",
      "**a + il = al**, **a + la = alla** (accanto alla lampada)."
     ],
     "tutora": ""
    },
