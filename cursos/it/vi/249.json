 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Làm theo một hướng dẫn phức tạp",
     "texto": [
      "Phân tách các bước bắt buộc, lựa chọn cho người không có kết nối và hậu quả của việc không trả lời kịp thời.",
      "Các cụm **solo se**, **se manca** và **trascorso tale termine** xác định rõ các điều kiện."
     ],
     "tutora": ""
    }
   ]
  },
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Gia hạn thẻ tháng",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Per rinnovare l'abbonamento, compilare il modulo online entro il 30 giugno e allegare una copia del documento.",
       "alumno": "Để gia hạn thẻ tháng, hãy điền mẫu trực tuyến trước ngày 30 tháng sáu và đính kèm một bản sao của tài liệu.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "La richiesta viene accettata solo se i dati coincidono con quelli già registrati.",
       "alumno": "Yêu cầu chỉ được chấp nhận nếu dữ liệu trùng khớp với những dữ liệu đã đăng ký.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Chi non dispone di una connessione può rivolgersi allo sportello al piano terra, dal lunedì al venerdì, dalle 9 alle 12.",
       "alumno": "Người không có kết nối có thể đến quầy ở tầng trệt, từ thứ Hai đến thứ Sáu, từ 9 giờ đến 12 giờ.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Se manca un allegato, l'ufficio invia una notifica e concede dieci giorni per completare la domanda; trascorso tale termine, sarà necessario presentare una nuova richiesta.",
       "alumno": "Nếu thiếu một giấy tờ đính kèm, văn phòng sẽ gửi thông báo và cho mười ngày để hoàn thành hồ sơ; sau thời hạn đó, phải nộp một đơn mới.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Durante i lavori, lo sportello si sposta temporaneamente nell'edificio accanto, ma gli orari restano invariati.",
       "alumno": "Trong thời gian cải tạo, quầy chuyển tạm thời sang tòa nhà bên cạnh, nhưng giờ làm việc không thay đổi.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
