     "tipo": "texto",
     "titulo": "Hướng dẫn sau buổi khám bệnh",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Dopo la visita, il medico consiglia di bere molta acqua e riposare per due giorni.",
       "alumno": "Sau khi khám, bác sĩ khuyên quý khách uống nhiều nước và nghỉ ngơi trong hai ngày.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Dopo la visita",
         "sau buổi khám"
        ],
        [
         "il medico consiglia",
         "bác sĩ khuyên"
        ],
        [
         "bere molta acqua",
         "uống nhiều nước"
        ],
        [
         "riposare per due giorni",
         "nghỉ ngơi trong hai ngày"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Prenda una compressa dopo pranzo e una dopo cena con un bicchiere d'acqua.",
       "alumno": "Quý khách hãy uống một viên sau bữa trưa và một viên sau bữa tối, kèm một ly nước.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Prenda una compressa",
         "quý khách uống một viên"
        ],
        [
         "dopo pranzo",
         "sau bữa trưa"
        ],
        [
         "dopo cena",
         "sau bữa tối"
        ],
        [
         "con un bicchiere d'acqua",
         "kèm một ly nước"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Non superi due compresse al giorno per nessun motivo.",
       "alumno": "Quý khách không vượt quá hai viên mỗi ngày, bất kể lý do gì.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Non superi",
         "không vượt quá"
        ],
        [
         "due compresse al giorno",
         "hai viên mỗi ngày"
        ],
        [
         "per nessun motivo",
         "bất kể lý do gì"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Se la febbre continua dopo venerdì, telefoni allo studio medico.",
       "alumno": "Nếu sốt tiếp tục sau thứ Sáu, quý khách hãy gọi điện cho phòng khám.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Se la febbre continua",
         "nếu sốt tiếp tục"
        ],
        [
         "dopo venerdì",
         "sau thứ Sáu"
        ],
        [
         "telefoni allo studio",
         "hãy gọi điện cho phòng khám"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Per il controllo non serve un nuovo appuntamento: passi in ambulatorio tra le nove e le undici.",
