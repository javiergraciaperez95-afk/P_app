    {
     "tipo": "dialogo",
     "titulo": "Xem một bức ảnh",
     "frases": [
      {
       "quien": {
        "texto": "Giulia",
        "lengua": "estudio"
       },
       "estudio": "Chi è, in questa foto?",
       "alumno": "Người này là ai trong bức ảnh này?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Chi è",
         "là ai"
        ],
        [
         "in questa foto",
         "trong bức ảnh này"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Paolo",
        "lengua": "estudio"
       },
       "estudio": "È mio fratello, Stefano. Ha venticinque anni.",
       "alumno": "Đó là anh trai tôi, Stefano. Anh ấy hai mươi lăm tuổi.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "mio fratello",
         "anh trai tôi (không có mạo từ)"
        ],
        [
         "Ha venticinque anni",
         "hai mươi lăm tuổi"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Giulia",
        "lengua": "estudio"
       },
       "estudio": "È molto alto! E lei, chi è?",
       "alumno": "Anh ấy rất cao! Còn cô ấy là ai?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "molto alto",
         "rất cao"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Paolo",
        "lengua": "estudio"
       },
       "estudio": "È sua moglie. Si chiama Elena.",
       "alumno": "Đó là vợ anh ấy. Cô ấy tên là Elena.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "sua moglie",
         "vợ anh ấy (không có mạo từ: gia đình số ít)"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Giulia",
        "lengua": "estudio"
       },
       "estudio": "Ha i capelli lunghi. È simpatica?",
       "alumno": "Cô ấy tóc dài. Cô ấy dễ mến không?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "i capelli lunghi",
         "tóc dài (trong tiếng Ý là số nhiều)"
        ],
        [
         "simpatica",
         "dễ mến"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Paolo",
        "lengua": "estudio"
       },
       "estudio": "Sì, è molto simpatica e divertente.",
       "alumno": "Vâng, cô ấy rất dễ mến và vui tính.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "divertente",
         "vui tính (đuôi -e: không đổi)"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Giulia",
        "lengua": "estudio"
       },
       "estudio": "Hanno figli?",
       "alumno": "Họ đã sinh con chưa?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Hanno",
         "họ sinh con"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Paolo",
        "lengua": "estudio"
       },
       "estudio": "Sì, hanno un figlio. Si chiama Matteo.",
       "alumno": "Vâng, họ đã sinh một con trai. Cậu bé tên là Matteo.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
