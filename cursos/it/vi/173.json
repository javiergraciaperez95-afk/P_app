   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Trình tự tường thuật",
     "texto": [
      "**Phát hiện**: Trong đợt thi công mở cửa lại bảo tàng, công nhân tìm thấy một chiếc hộp bị lãng quên sau một tủ, chứa tài liệu của nhà hát cũ đã đóng cửa năm 1952.",
      "**Điều bất thường**: Người phục chế nhận ra bức chân dung một diễn viên không được ghi trong biên bản chính thức.",
      "**Điều tra**: Một nhà sử học đối chiếu những thư viện báo chí thời đó và phát hiện một xung đột lao động dẫn đến việc diễn viên từ chức.",
      "**Quyết định đạo đức**: Trước khi trưng bày hiện vật cho công chúng, ban giám đốc sẽ quyết định xin sự đồng ý rõ ràng từ hậu duệ."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Thời điểm",
     "columnas": [
      {
       "texto": "Sự kiện tường thuật",
       "lengua": "alumno"
      },
      {
       "texto": "Tầm quan trọng về phương pháp",
       "lengua": "alumno"
      }
     ],
     "filas": [
      [
       {
        "texto": "Mở cửa lại sau thi công",
        "lengua": "alumno"
       },
       {
        "texto": "Phát hiện chiếc hộp có hồ sơ và ảnh nhà hát",
        "lengua": "alumno"
       },
       {
        "texto": "Thu hồi tài sản lưu trữ bị lãng quên từ năm 1952.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Lập danh mục ban đầu",
        "lengua": "alumno"
       },
       {
        "texto": "Người phục chế cảnh báo sự hiện diện của một diễn viên vô danh",
        "lengua": "alumno"
       },
       {
        "texto": "Nhận diện bằng hình ảnh một khoảng trống trong những danh mục của bảo tàng.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Điều tra báo chí",
        "lengua": "alumno"
       },
       {
        "texto": "Nhà sử học xác nhận tên sau khi tra cứu báo thời kỳ",
        "lengua": "alumno"
       },
       {
        "texto": "Tái dựng bối cảnh tiểu sử và nguyên nhân ra đi của ông.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Chuẩn bị triển lãm",
        "lengua": "alumno"
       },
       {
        "texto": "Liên hệ trước và tôn trọng với hậu duệ",
        "lengua": "alumno"
       },
       {
        "texto": "Thận trọng thể chế và tôn trọng đạo đức đối với ký ức gia đình.",
        "lengua": "alumno"
       }
      ]
     ],
     "nota": "",
     "tutora": ""
    }
   ]
  },
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Một kho lưu trữ được tìm lại",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Quando il museo ha riaperto dopo i lavori, il personale ha trovato una scatola dietro un armadio. Conteneva fotografie e registri del vecchio teatro cittadino, chiuso nel 1952.",
       "alumno": "Khi bảo tàng mở cửa lại sau đợt thi công, nhân viên đã tìm thấy một chiếc hộp sau một tủ. Bên trong là ảnh và hồ sơ của nhà hát cũ thuộc thành phố, đã đóng cửa năm 1952.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "registri del vecchio teatro cittadino",
         "«registri del vecchio teatro cittadino»: hồ sơ của nhà hát cũ thuộc thành phố"
        ],
        [
         "chiuso nel 1952",
         "«chiuso nel 1952»: đã đóng cửa năm 1952"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "La restauratrice, che stava catalogando i documenti, si è accorta che una fotografia mostrava un attore mai citato negli archivi. Il direttore ha chiesto a una storica di verificare il nome.",
       "alumno": "Người phục chế, khi đang lập danh mục những tài liệu, nhận ra một bức ảnh cho thấy một diễn viên chưa từng được trích dẫn trong hồ sơ lưu trữ. Giám đốc đã nhờ một nhà sử học kiểm chứng tên đó.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "un attore mai citato negli archivi",
         "«un attore mai citato negli archivi»: một diễn viên chưa từng được trích dẫn trong hồ sơ"
        ],
        [
         "di verificare il nome",
         "«di verificare il nome»: kiểm chứng tên đó"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Confrontando la foto con un giornale dell'epoca, lei ha scoperto che l'attore aveva lasciato la compagnia dopo una discussione.",
       "alumno": "Khi đối chiếu bức ảnh với một tờ báo thời kỳ đó, bà phát hiện diễn viên đã rời đoàn kịch sau một cuộc tranh cãi.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "aveva lasciato la compagnia",
         "«aveva lasciato la compagnia»: đã rời đoàn kịch"
        ],
        [
         "dopo una discussione",
         "«dopo una discussione»: sau một cuộc tranh cãi"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Il museo preparerà una piccola mostra, ma prima contatterà i discendenti per chiedere il permesso di esporre le immagini.",
       "alumno": "Bảo tàng sẽ chuẩn bị một triển lãm nhỏ, nhưng trước đó sẽ liên hệ với hậu duệ để xin phép trưng bày những hình ảnh.",
       "literal": "",
       "estructura": "",
       "nota": [],
