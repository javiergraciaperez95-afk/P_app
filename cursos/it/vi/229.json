 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Đại từ «chi» đi với động từ ở số ít",
     "texto": [
      "«**Chi** cerca trova» (kẻ tìm thì sẽ gặp); «Premio **chi** merita» (trao thưởng cho người xứng đáng). Động từ hòa hợp nghiêm ngặt ở ngôi thứ ba số ít, dù nghĩa bao hàm một tập thể nhiều cá nhân."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Đại từ trung tính «quanto»",
     "texto": [
      "«Farò **quanto** è in mio potere» (mình sẽ làm tất cả những gì nằm trong khả năng của mình); «Per **quanto** ne so, la riunione è confermata». Ở số nhiều, **quanti / quante** mang giá trị tập thể chỉ người: «Ringrazio **quanti** hanno collaborato» (mình cảm ơn tất cả những ai đã hợp tác)."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Đại từ quan hệ kép",
