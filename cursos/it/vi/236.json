 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "«Prima che» với thức giả định bắt buộc",
     "texto": [
      "Luôn đòi hỏi thức giả định vì hành động phụ chưa xảy ra tại thời điểm tham chiếu: «Partiamo **prima che faccia** buio» (chúng ta đi trước khi trời tối); «Uscì **prima che arrivasse** il temporale» (anh ấy ra ngoài trước khi cơn bão đến)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "«A meno che non» với giá trị điều kiện ngoại lệ",
     "texto": [
      "Diễn đạt một ngoại lệ duy nhất có thể làm vô hiệu hành động chính, đi với thức giả định và «non» đệm theo truyền thống: «Andremo al mare, **a meno che non piova** a dirotto» (chúng mình sẽ đi biển, trừ khi trời mưa như trút nước)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "«Finché» với thức chỉ định chỉ thời gian kéo dài",
     "texto": [
      "«**Finché c'è** vita, c'è speranza» (chừng nào còn sự sống thì còn hy vọng); «Restammo in biblioteca **finché non chiuse** i battenti» (chúng mình ở lại thư viện cho đến khi nó đóng cửa)."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
