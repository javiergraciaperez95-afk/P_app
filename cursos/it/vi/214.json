       {
        "texto": "contemporaneità",
        "lengua": "estudio"
       },
       {
        "texto": "Temo che non capisca la situazione.",
        "lengua": "estudio"
       },
       {
        "texto": "Mình lo rằng anh ấy không hiểu tình hình.",
        "lengua": "alumno"
