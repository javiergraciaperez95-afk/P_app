   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Cách hình thành thức giả định quá khứ",
     "texto": [
      "Gồm trợ động từ ở thức giả định hiện tại (**abbia**, **abbiamo**, **abbiate**, **abbiano** / **sia**, **siamo**, **siate**, **siano**) cộng với phân từ quá khứ của động từ.",
      "**Hòa hợp với essere**: «Credo che Chiara sia partita» so với «Credo che i ragazzi siano partiti»."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Đối lập về sự trước và sự đồng thời",
     "texto": [
      "**Đồng thời (hiện tại)**: «Penso che Paolo lavori adesso» (mình nghĩ Paolo đang làm việc bây giờ).",
      "**Trước đó (passato)**: «Penso che Paolo abbia lavorato ieri» (mình nghĩ Paolo đã làm việc hôm qua)."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Thì",
     "columnas": [
      {
       "texto": "Italiano",
       "lengua": "estudio"
