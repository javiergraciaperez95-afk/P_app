      [
       {
        "texto": "anteriorità (avere)",
        "lengua": "estudio"
       },
       {
        "texto": "Temo che abbia frainteso le mie parole.",
        "lengua": "estudio"
       },
       {
        "texto": "Mình lo rằng họ đã hiểu lầm lời mình nói.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "trước đó (essere giống đực)",
        "lengua": "alumno"
       },
       {
        "texto": "«È probabile che sia partito all'alba.»",
        "lengua": "alumno"
       },
       {
        "texto": "Có khả năng anh ấy đã rời đi lúc bình minh.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "trước đó (essere giống cái)",
        "lengua": "alumno"
       },
       {
        "texto": "Dubito che sia rimasta a casa.",
        "lengua": "estudio"
       },
       {
        "texto": "Mình ngờ rằng cô ấy đã ở nhà.",
        "lengua": "alumno"
       }
      ]
