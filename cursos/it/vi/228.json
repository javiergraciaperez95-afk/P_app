 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Quy tắc hòa hợp của đại từ sở hữu quan hệ",
     "texto": [
      "«Lo scrittore **il cui** romanzo ha vinto...» (danh từ romanzo là giống đực số ít → il cui).",
      "«Lo scrittore **la cui** opera è famosa...» (opera là giống cái số ít → la cui).",
      "«La poetessa **i cui** versi conosciamo...» (versi là giống đực số nhiều → i cui).",
      "«I filosofi **le cui** teorie studiamo...» (teorie là giống cái số nhiều → le cui)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "«Cui» với giới từ thông thường",
     "texto": [
      "Khi không có mạo từ xác định, «cui» đi sau giới từ (a cui, di cui, per cui, con cui, in cui, da cui) đảm nhiệm chức năng bổ ngữ gián tiếp, bổ ngữ phụ thuộc hoặc trạng ngữ: «La persona a cui ho scritto» (người mà mình đã viết thư cho); «Il motivo per cui siamo qui»."
     ],
     "tutora": ""
    },
