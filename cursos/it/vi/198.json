    {
     "tipo": "explicacion",
     "titulo": "Nền và các sự kiện",
     "texto": [
      "**Era un giorno d'estate** (là một ngày hè): phần nền, với imperfetto. **Il vecchio aprì la porta** (ông lão đã mở cửa): sự kiện, với passato remoto.",
      "Nhờ vậy có thể phân biệt khung câu chuyện với các biến cố."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Từ nối trong truyện kể",
     "texto": [
      "**Poi** (sau đó), **dopo poco** (sau một lát), **in silenzio** (trong im lặng).",
      "Chúng giúp sắp xếp thứ tự các sự việc."
     ],
     "tutora": ""
    }
   ]
