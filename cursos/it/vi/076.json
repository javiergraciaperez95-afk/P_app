     "filas": [
      [
       {
        "texto": "Tương lai thời gian",
        "lengua": "alumno"
       },
       {
        "texto": "Domani arriverà Marco.",
        "lengua": "estudio"
       },
       {
        "texto": "Hành động xảy ra sau theo trình tự thời gian",
        "lengua": "alumno"
       },
       {
        "texto": "Ngày mai Marco sẽ đến.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Tương lai phỏng đoán",
        "lengua": "alumno"
       },
       {
        "texto": "Dov'è Marco? — Sarà in ufficio.",
        "lengua": "estudio"
       },
       {
        "texto": "Giả thuyết về tình huống hiện tại",
        "lengua": "alumno"
       },
       {
        "texto": "Marco đâu? — Chắc giờ anh ấy đang ở văn phòng.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Phỏng đoán về tuổi",
        "lengua": "alumno"
       },
       {
        "texto": "Quanti anni hanno? — Avranno vent'anni.",
        "lengua": "estudio"
       },
       {
        "texto": "Ước lượng xấp xỉ hiện tại",
        "lengua": "alumno"
       },
       {
        "texto": "Họ bao nhiêu tuổi? — Chắc khoảng hai mươi tuổi.",
        "lengua": "alumno"
       }
      ]
     ],
     "nota": "",
     "tutora": ""
    }
