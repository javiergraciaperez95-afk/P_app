   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Luân phiên dove / in cui",
     "texto": [
      "**Il paese dove sono nato è piccolo** = *Il paese in cui sono nato è piccolo* (làng nơi mình sinh ra thì nhỏ). Cả hai đều đúng, nhưng «dove» thông dụng và nhẹ hơn nhiều trong ngôn ngữ nói và viết hằng ngày."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Giới hạn cơ bản",
     "texto": [
      "«Dove» chỉ dành cho tiền ngữ mang tính chất không gian, thực tế hoặc ẩn dụ. Không bao giờ dùng cho thời gian («l'anno in cui...», không *l'anno dove*)."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
