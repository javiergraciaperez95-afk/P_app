 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Este y aquel",
    "@en": "This and that"
   },
   "texto": [
    {
     "@es": "**Questo** es «este» y concuerda como un adjetivo en -o: **questo** vestito, **questa** giacca, **questi** pantaloni, **queste** scarpe.",
     "@en": "**Questo** is «This one» and matches as an adjective in -o: **questo** dress, **questa** giacca, **questi** pantoni, **queste** scarpe."
    },
    {
     "@es": "**Quello** es «ese, aquel». Delante de un nombre se comporta como el artículo: **quel** vestito, **quella** giacca, **quei** pantaloni, **quelle** scarpe.",
     "@en": "**Quello** is «That, that». In front of a name it behaves like the article: **quel** dressed, **quella** giacca, **quei** pantoni, **quelle** scarpe."
    }
   ]
  },
  {
   "tipo": "tabla",
   "titulo": {
    "@es": "Los demostrativos",
    "@en": "The demonstrative"
   },
