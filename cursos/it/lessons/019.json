 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Hay",
    "@en": "There's"
   },
   "texto": [
    {
     "@es": "«Hay» tiene dos formas. **C'è** para singular: **C'è un giardino** (hay un jardín). **Ci sono** para plural: **Ci sono quattro stanze** (hay cuatro habitaciones).",
     "@en": "«There's» has two forms. **C'è** for singular: **C'è un giardino** (there is a garden). **Ci sono** for plural: **Ci sono quattro stanze** (there are four rooms)."
    },
    {
     "@es": "Negación: **Non c'è** y **Non ci sono**.",
     "@en": "Denial: **Non c'è** and **Non ci sono**."
    },
    {
     "@es": "Para preguntar basta la entonación: **C'è un bagno?**",
     "@en": "To ask, the intonation is enough: **C'è un bagno?**"
    }
   ]
  },
