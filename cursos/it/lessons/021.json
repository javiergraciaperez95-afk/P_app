  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Las comidas y las partes del día",
    "@en": "The meals and the parts of the day"
   },
   "texto": [
    {
     "@es": "Las comidas tienen su propio verbo: **fare colazione** (desayunar), **pranzare** (comer a mediodía), **cenare** (cenar).",
     "@en": "The meals have their own verb: **fare colazione** (breakfast), **pranzare** (lunch at noon), **cenare** (dinner)."
    },
    {
     "@es": "Las partes del día: **la mattina** (por la mañana), **il pomeriggio** (por la tarde), **la sera** (al anochecer), **la notte** (por la noche). Sin preposición.",
     "@en": "The parts of the day: **la mattina** (morning), **il pomeriggio** (afternoon), **la sera** (evening), **la notte** (evening). No preposition."
    },
    {
     "@es": "**Ogni giorno** = todos los días. **Presto** = temprano, pronto. **Tardi** = tarde.",
     "@en": "**Ogni giorno** = every day. **Presto** = early, soon. **Tardi** = late."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Dos verbos irregulares que ya necesitas",
    "@en": "Two irregular verbs you already need"
   },
   "texto": [
    {
     "@es": "**Vado** = voy (de «andare»). **Faccio** = hago (de «fare»).",
     "@en": "**Vado** = go (from «andare»). **Faccio** = do (from «fare»)."
    },
    {
     "@es": "Con las horas se usa **alle**: **alle nove** (a las nueve).",
     "@en": "With the hours **alle**: **alle nove** is used (at 9: 00)."
    }
   ]
  },
