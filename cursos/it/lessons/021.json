 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Los verbos reflexivos",
    "@en": "The reflective verbs"
   },
   "texto": [
    {
     "@es": "Funcionan igual que en español: **mi alzo** (me levanto), **mi sveglio** (me despierto), **mi lavo** (me lavo), **mi vesto** (me visto).",
     "@en": "They work as in Spanish: **mi alzo** (I get up), **mi sveglio** (I wake up), **mi lavo** (I wash), **mi vesto** (I dress)."
    },
    {
     "@es": "Los pronombres son **mi, ti, si, ci, vi, si**. Fíjate en «nosotros»: es **ci**, no «nos».",
     "@en": "The pronouns are **mi, ti, si, ci, vi, si**. Look at «We»: it's **ci**, not «No.»."
    },
    {
     "@es": "En la negación, **non** va delante del pronombre: **Non mi alzo tardi**.",
     "@en": "In denial, **non** goes before the pronoun: **Non mi alzo tardi**."
    }
   ]
  },
  {
   "tipo": "tabla",
   "titulo": {
    "@es": "El verbo «alzarsi» (levantarse)",
    "@en": "The verb «alzarsi» (get up)"
   },
