 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Senza + infinitivo",
    "@en": "Senza + infinitive"
   },
   "texto": [
    {
     "@es": "**Senza dire niente** (sin decir nada), **senza salutare** (sin saludar).",
     "@en": "**Senza dire niente** (without saying anything), **senza salutare** (without saying hello)."
    },
    {
     "@es": "Indica que no se realiza la acción del infinitivo: **È uscito senza dire niente** (salió sin decir nada).",
     "@en": "It indicates that the action of the infinitive is not performed: **È uscito senza dire niente** (it came out without saying anything)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Per + infinitivo",
    "@en": "Per + infinitive"
   },
   "texto": [
    {
     "@es": "**Per capire** (para entender), **per arrivare** (para llegar).",
     "@en": "**Per capire** (to understand), **per arrivare** (to arrive)."
    },
    {
     "@es": "Indica finalidad: **Per chiedere, bisogna essere gentili** (para pedir, hay que ser amables).",
     "@en": "It indicates purpose: **Per chiedere, bisogna essere gentili** (to ask, you have to be kind)."
    }
   ]
  },
  {
