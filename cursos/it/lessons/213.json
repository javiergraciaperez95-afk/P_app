 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Una pauta de concordancia",
    "@en": "A concordance pattern"
   },
   "texto": [
    {
     "@es": "Con un verbo principal en presente, el congiuntivo presente suele expresar simultaneidad y el passato anterioridad. Con un principal en pasado, el imperfetto suele expresar simultaneidad y el trapassato anterioridad.",
     "@en": "With a main verb in the present, the present congiuntive usually expresses simultaneity and the previous passage. With a major in the past, imfetto usually expresses simultaneity and previously trapassate."
    },
    {
     "@es": "Es una pauta útil, no una regla mecánica: el tiempo real, la intención y algunas construcciones pueden cambiar la elección.",
     "@en": "It is a useful pattern, not a mechanical rule: real time, intent and some constructions can change the choice."
    }
   ]
  },
  {
   "tipo": "tabla",
   "titulo": {
