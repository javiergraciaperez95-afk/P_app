 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Para que",
    "@en": "For that"
   },
   "texto": [
    {
     "@es": "**Affinché** (para que) + congiuntivo: **Ti chiamo affinché tu venga** (te llamo para que vengas).",
     "@en": "**Affinché** (for you) + congiuntive: **Ti chiamo affinché tu venga** (I call you to come)."
    },
    {
     "@es": "Es más formal que «per».",
     "@en": "It's more formal than «per»."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Para no, con el fin de",
    "@en": "For no, in order to"
   },
   "texto": [
    {
     "@es": "**Per non** (para no), **in modo da** (de forma que), **allo scopo di** (con el fin de) + infinitivo: **Lavoro in modo da evitare il problema**.",
     "@en": "**Per non** (for no), **in modo da** (so that), **allo scopo di** (for the purpose of) + infinitive: **Lavoro in modo da evitare il problema**."
    },
    {
     "@es": "Son frases de objetivo sin cambiar el sujeto.",
     "@en": "They're target phrases without changing the subject."
    }
   ]
  },
