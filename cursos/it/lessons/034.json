   "texto": [
    {
     "@es": "Los meses van en **minúscula** y con **a** o **in**: **a luglio** o **in luglio**.",
     "@en": "The months go in **minúscula** and with **a** or **in**: **a luglio** or **in luglio**."
    },
    {
     "@es": "Las estaciones: **in primavera**, **in estate** (en verano), **in autunno**, **in inverno**.",
     "@en": "The stations: **in primavera**, **in estate** (in summer), **in autunno**, **in inverno**."
    },
    {
     "@es": "La fecha se dice con el artículo y el número normal, sin «de»: **il 3 dicembre** (el 3 de diciembre). Solo el día 1 es distinto: **il primo maggio**.",
     "@en": "The date is given with the article and the normal number, without «of»: **il 3 dicembre** (December 3). Only day 1 is different: **il primo maggio**."
    }
