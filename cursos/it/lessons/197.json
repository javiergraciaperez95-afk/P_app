 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Cuándo se usa",
    "@en": "When used"
   },
   "texto": [
    {
     "@es": "Se encuentra en relatos y biografías para presentar hechos pasados como concluidos: **nacque** (nació), **fu** (fue), **scrisse** (escribió).",
     "@en": "It is found in stories and biographies to present past facts as concluded: **nacque** (born), **fu** (was), **scrisse** (wrote)."
    },
    {
     "@es": "Su uso hablado cambia por región y estilo; no depende únicamente de que el hecho sea lejano.",
     "@en": "Their spoken use changes by region and style; it does not depend only on the fact being far away."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Formas más comunes",
    "@en": "More common forms"
   },
   "texto": [
    {
     "@es": "Verbos regulares: **parlai, parlasti, parlò, parlammo, parlaste, parlarono**. Irregulares frecuentes: **fu / furono** (ser), **ebbe / ebbero** (tener), **fece / fecero** (hacer), **disse / dissero** (decir).",
     "@en": "Regular verbs: **parlai, parlasti, parlò, parlammo, parlaste, parlarono**. Common irregulars: **fu / furono** (be), **ebbe / ebbero** (have), **fece / fecero** (do), **disse / dissero** (say)."
    },
    {
     "@es": "En una profesión sin determinante: **Nacque a Roma e fu medico** (nació en Roma y fue médico).",
     "@en": "In a profession without determinant: **Nacque a Roma e fu medico** (born in Rome and was a doctor)."
    }
   ]
  },
