  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Cómo se forma",
    "@en": "How it forms"
   },
   "texto": [
    {
     "@es": "**avendo** o **essendo** + participio: **avendo finito** (habiendo terminado), **essendo arrivato** (habiendo llegado).",
     "@en": "**avendo** or **essendo** + participle: **avendo finito** (having finished), **essendo arrivato** (having arrived)."
    },
    {
     "@es": "La concordancia es igual que en el infinitivo pasado: **essendo arrivata** (habiendo llegado, ella).",
     "@en": "The agreement is the same as in the infinite past: **essendo arrivata** (having arrived, it)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Cuándo se usa",
    "@en": "When used"
   },
   "texto": [
    {
     "@es": "En frases formales y narraciones: **Avendo speso troppo, sono stanco** (habiendo gastado demasiado, estoy cansado).",
     "@en": "In formal phrases and narrations: **Avendo speso troppo, sono stanco** (having spent too much, I am tired)."
    },
    {
     "@es": "En el habla normal se prefiere el infinitivo pasado: «dopo aver speso…».",
     "@en": "In normal speech, the infinite past is preferred: «dopo aver speso…»."
    }
   ]
