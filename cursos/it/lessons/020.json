 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Preposiciones de lugar",
    "@en": "Place assumptions"
   },
   "texto": [
    {
     "@es": "**In** = en, dentro de. **Su** = encima de. **Sotto** = debajo de. **Dietro** = detrás de. **Tra** = entre.",
     "@en": "**In** = in, inside. **Su** = above. **Sotto** = below. **Dietro** = behind. **Tra** = enter."
    },
    {
     "@es": "**Davanti a** = delante de. **Accanto a** = al lado de.",
     "@en": "**Davanti a** = in front of. **Accanto a** = next to."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Preposición + artículo",
    "@en": "Preposition + article"
   },
   "texto": [
    {
     "@es": "En italiano, las preposiciones **a, in, su, di, da** se funden con el artículo en una sola palabra. Son las preposiciones articuladas.",
     "@en": "In Italian, the **a, in, su, di, da** prepositions are founded with the article in one word. It's the articulated prepositions."
    },
    "**su + il = sul** (sul tavolo), **su + la = sulla** (sulla sedia).",
    "**in + il = nel** (nel soggiorno), **in + la = nella** (nella borsa).",
    {
     "@es": "**a + il = al**, **a + la = alla** (accanto alla lampada).",
     "@en": "**a + il = al**, **a + la = alla** (lampada)."
    }
   ]
  },
