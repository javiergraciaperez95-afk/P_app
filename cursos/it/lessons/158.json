 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Cómo se combinan",
    "@en": "How they combine"
   },
   "texto": [
    {
     "@es": "**me lo** (me lo), **te lo** (te lo), **glielo** (se lo, a él o ella), **ce lo** (nos lo), **ve lo** (os lo).",
     "@en": "**me lo** (me), **te lo** (you), **glielo** (you, him or her), **ce lo** (us), **ve lo** (you)."
    },
    {
     "@es": "Con «a él» y «a ella» se usa la misma forma: **glielo**.",
     "@en": "With «to him» and «to her», the same form is used: **glielo**."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "En imperativo y pasado",
    "@en": "In imperative and past"
   },
   "texto": [
    {
     "@es": "Con imperativos se unen al final: **dammelo** (dámelo), **dimmelo** (dímelo).",
     "@en": "With imperatives they join in the end: **dammelo** (give it to me), **dimmelo** (tell me)."
    },
    {
     "@es": "Delante de «ha» / «ho» a veces se contrae: **gliel'ho detto** (se lo he dicho).",
     "@en": "In front of «ha» / «ho» sometimes it is contracted: **gliel'ho detto** (I told you so)."
    }
   ]
  },
