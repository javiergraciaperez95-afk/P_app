 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Posibilidad: se + imperfetto de congiuntivo, condizionale presente",
    "@en": "Possibility: Congiuntive perfet + present condizionale"
   },
   "texto": [
    {
     "@es": "Lo que sería posible si ocurriera algo: **Se avessi tempo, potremmo partire** (si tuviera tiempo, podríamos salir).",
     "@en": "Which would be possible if something happened: **Se avessi tempo, potremmo partire** (if I had time, we could get out)."
    },
    {
     "@es": "Es el tipo II ya visto en el B1, con el condicional de cualquier verbo.",
     "@en": "It's type II already seen in the B1, with the parole of any verb."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Cortesía con condicional",
    "@en": "Conditional Courtesy"
   },
   "texto": [
    {
     "@es": "**Vorremmo** (querríamos), **accetterei** (aceptaría), **mi trasferirei** (me mudaría).",
     "@en": "**Vorremmo** (we would like), **accetterei** (I would accept), **mi trasferirei** (I would move)."
    },
    {
     "@es": "Es una manera educada de decir lo que harías.",
     "@en": "It's a polite way of saying what you'd do."
    }
   ]
  },
