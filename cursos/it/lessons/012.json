   },
   "id": "it012-2",
   "opciones": [
    {
     "texto": {
      "@es": "En la raíz del verbo (esdrújula): «PAR-la-no», «A-bi-ta-no».",
      "@en": "At the root of the verb (sdrujula): «PAR-la-no», «A-bi-ta-no»."
     },
     "explicacion": {
      "@es": "El acento retrocede en la tercera persona plural.",
      "@en": "The accent goes back on the third plural person."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "En la última sílaba: «parla-NÓ».",
      "@en": "In the last syllable: «parla-NÓ»."
     },
     "explicacion": {
      "@es": "En italiano nunca se acentúa la desinencia -ano.",
      "@en": "In Italian, disinence is never accentuated."
     }
    },
    {
     "texto": {
      "@es": "En la penúltima sílaba como en español: «par-LA-no».",
      "@en": "In the penultimate syllable as in Spanish: «- No.»."
     },
     "explicacion": {
      "@es": "A diferencia del español «hablan», en italiano el acento recae en la antepenúltima.",
      "@en": "Unlike the Spanish «Talk.», the accent in Italian is the last."
     }
    }
