   "pregunta": {
    "@es": "¿Cuál es la terminación de la segunda persona singular («tu») en los verbos en -are?",
    "@en": "What is the end of the second person singular («tu») in the verbs in -are?"
   },
   "id": "it012-1",
   "opciones": [
    {
     "texto": "-i",
     "explicacion": {
      "@es": "En italiano regular, «tu» siempre termina en -i (tu parli, tu abiti).",
      "@en": "In regular Italian, «tu» always ends in -i (your parli, your abiti)."
     },
     "correcta": true
    },
    {
     "texto": "-as",
     "explicacion": {
      "@es": "La terminación -as es del español, en italiano no se usa la -s final.",
      "@en": "The completion -as is of Spanish, in Italian the -s final is not used."
     }
    },
    {
     "texto": "-a",
     "explicacion": {
      "@es": "La terminación -a corresponde a la tercera persona («lui/lei parla»).",
      "@en": "The completion - a corresponds to the third person («lui/lei parla»)."
     }
    }
   ]
