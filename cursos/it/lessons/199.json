 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Plural de tercera persona",
    "@en": "Third-person plural"
   },
   "texto": [
    {
     "@es": "**Vedere → videro** (ver → vieron), **partire → partirono** (salir → salieron), **arrivare → arrivarono** (llegar → llegaron), **dire → dissero** (decir → dijeron).",
     "@en": "**Vedere → videro** (see → saw), **partire → partirono** (exit → came out), **arrivare → arrivarono** (arrive → arrived), **dire → dissero** (say → said)."
    },
    {
     "@es": "En relatos escritos también aparecen muchas otras formas del passato remoto.",
     "@en": "Many other forms of remote passage also appear in written accounts."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Cuando no lo usas",
    "@en": "When you don't use it"
   },
   "texto": [
    {
     "@es": "En conversación normal y en el norte de Italia se usa el passato prossimo: **Ieri ho visto un film** (ayer vi una película).",
     "@en": "In normal conversation and in northern Italy, the prossimo passage is used: **Ieri ho visto un film** (yesterday I saw a film)."
    },
    {
     "@es": "Con **tanto tempo fa** (hace mucho tiempo) suena natural con el pasado remoto.",
     "@en": "With **tanto tempo fa** (long ago) it sounds natural with the remote past."
    }
   ]
  },
