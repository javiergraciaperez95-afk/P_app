   "texto": [
    {
     "@es": "**Comprare** es un verbo regular en -are: **compro, compri, compra, compriamo**.",
     "@en": "**Comprare** is a regular verb in -are: **compro, compri, compra, compriamo**."
    },
    {
     "@es": "La forma de «nosotros» sirve también para proponer: **Compriamo la frutta?** (¿compramos fruta?), **Andiamo al supermercato** (vamos al supermercado).",
     "@en": "The form of «We» also serves to propose: **Compriamo la frutta?** (do we buy fruit?), **Andiamo al supermercato** (go to the supermarket)."
    },
    {
     "@es": "**Fare la spesa** = hacer la compra.",
     "@en": "**Fare la spesa** = make the purchase."
    }
   ]
  },
