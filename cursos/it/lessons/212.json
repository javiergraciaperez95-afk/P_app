 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Cómo se forma",
    "@en": "How it forms"
   },
   "texto": [
    {
     "@es": "**avessi / fossi** (congiuntivo imperfetto de avere o essere) + participio: **avessi detto** (hubieras dicho), **fossi stato** (hubiera sido).",
     "@en": "**avessi / fossi** (congiuntive imfetus de avere or essere) + participle: **avessi detto** (you would have said), **fossi stato** (would have been)."
    },
    {
     "@es": "Con **pensavo che** (pensaba que): **Pensavo che avessi finito** (pensaba que habías terminado).",
     "@en": "With **pensavo che** (I thought): **Pensavo che avessi finito** (I thought you were done)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Cuándo se usa",
    "@en": "When used"
   },
   "texto": [
    {
     "@es": "Después de un verbo en pasado (**pensavo che, credevo che, mi aveva detto che**): **Pensavo che fossi venuto** (pensaba que habías venido).",
     "@en": "After a verb in the past (**pensavo che, credevo che, mi aveva detto che**): **Pensavo che fossi venuto** (I thought you had come)."
    },
    {
     "@es": "También aparece en la condición irreal pasada, que se estudia en el capítulo 35.",
     "@en": "It also appears in the past unreal condition, which is studied in chapter 35."
    }
   ]
