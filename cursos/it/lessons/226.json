 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Dovunque y ovunque",
    "@en": "Dovanx and ovanx"
   },
   "texto": [
    {
     "@es": "**Dovunque vada** (donde vaya), **ovunque sia** (dondequiera que esté).",
     "@en": "**Dovunque vada** (wherever you go), **ovunque sia** (wherever you are)."
    },
    {
     "@es": "Ambas son sinónimas. Van con congiuntivo presente.",
     "@en": "Both are synonymous. They go with congiuntive present."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Comunque y qualsiasi",
    "@en": "Comanvil and qualsiasi"
   },
   "texto": [
    {
     "@es": "**Comunque vada** (pase lo que pase), **qualsiasi cosa** (cualquier cosa), **qualunque cosa** (cualquier cosa).",
     "@en": "**Comunque vada** (whatever happens), **qualsiasi cosa** (anything), **qualunque cosa** (anything)."
    },
    {
     "@es": "**Comunque** también significa «de todos modos».",
     "@en": "**Comunque** also means «anyway»."
    }
   ]
  },
