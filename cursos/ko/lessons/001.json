 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Letras que forman bloques",
    "@en": "Letras that form blocks"
   },
   "texto": [
    {
     "@es": "El hangul es un **alfabeto**: las letras se agrupan en **bloques silábicos**, no se escriben todas en fila.",
     "@en": "The hangul is a **alfabeto**: the letters are grouped in **bloques silábicos**, not all are written in row."
    },
    "가 = ㄱ + ㅏ; 나 = ㄴ + ㅏ.",
    {
     "@es": "Las vocales verticales van a la **derecha** de la consonante: 가, 거, 기. Las horizontales van **debajo**: 고, 구, 그.",
     "@en": "The vertical vowels go to the **derecha** of the consonant: 가, 거, 기. The horizontal range is **debajo**: 고, 구, 그."
    },
    {
     "@es": "Si una sílaba empieza fonéticamente por vocal, se escribe ㅇ delante como soporte gráfico: 아. En esa posición no representa consonante.",
     "@en": "If a syllable begins phonetically by vocal, it is written in front as a graphic support: 아. In that position it does not represent consonant."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Seis vocales",
    "@en": "Six vowels"
   },
   "texto": [
    {
     "@es": "ㅏ, ㅣ, ㅗ y ㅜ se pueden aproximar con vocales españolas, aunque la duración y el timbre dependen del hablante.",
     "@en": "The Spanish vowels can be approached, although the length and the doorbell depend on the speaker."
    },
    {
     "@es": "ㅓ no coincide exactamente con una vocal española: **ŏ** es una ayuda de lectura, no una transcripción fonética.",
     "@en": "The Spanish vowel is not exactly the same: **ŏ** is a reading aid, not a phonetic transcription."
    },
    {
     "@es": "ㅡ tampoco tiene equivalente exacto: se articula con los labios sin redondear; **ŭ** es solo una convención de apoyo.",
     "@en": "It has no exact equivalent either: it is articulated with unrounded lips; **ŭ** is just a support convention."
    }
   ]
  },
