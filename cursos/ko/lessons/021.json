   "titulo": {
    "@es": "¿Dónde está mi móvil?",
    "@en": "Where's my cell phone?"
   },
   "frases": [
    {
     "quien": "지은",
     "ko": "민수 씨, 제 휴대폰이 어디에 있어요?",
