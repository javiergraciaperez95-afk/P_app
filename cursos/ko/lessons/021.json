     "en": "Ah, there he is! He's right next to the bed.",
     "analisis": [
      [
       "저기 있어요",
       {
        "@es": "allí está",
        "@en": "There it is."
       }
      ],
      [
       "침대 옆에",
       {
        "@es": "al lado de la cama",
        "@en": "next to the bed"
       }
      ]
     ]
    },
    {
     "quien": "지은",
     "ko": "아, 고마워요!",
     "es": "¡Ah, gracias!",
     "en": "Oh, thank you!",
     "analisis": [
