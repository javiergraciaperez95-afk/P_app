     "en": "Minsu, where's my cell phone?",
     "analisis": [
      [
       "제 휴대폰이",
       {
        "@es": "mi móvil (sujeto)",
        "@en": "my mobile (subject)"
       }
      ]
     ]
    },
    {
     "quien": "민수",
     "ko": "책상 위에 없어요?",
     "es": "¿No está encima del escritorio?",
     "en": "He's not on the desk?",
     "analisis": [
      [
       "책상 위에",
       {
        "@es": "encima del escritorio",
        "@en": "on the desk"
       }
      ],
      [
       "없어요",
       {
        "@es": "no está",
        "@en": "He's not here."
       }
      ]
     ]
    },
    {
     "quien": "지은",
     "ko": "네, 없어요.",
     "es": "No, no está.",
     "en": "No, he's not.",
     "analisis": [
      [
       "네, 없어요",
       {
        "@es": "«sí, no está»: confirma la pregunta",
        "@en": "«Yeah, he's not here.»: confirms the question"
       }
      ]
     ]
    },
    {
     "quien": "민수",
     "ko": "그럼 가방 안에 있어요?",
     "es": "Entonces, ¿está dentro del bolso?",
     "en": "So, is it in the bag?",
     "analisis": [
      [
       "그럼",
       {
        "@es": "entonces",
        "@en": "then"
       }
      ],
      [
       "가방 안에",
       {
        "@es": "dentro del bolso",
        "@en": "inside the bag"
       }
      ]
     ]
    },
    {
     "quien": "지은",
     "ko": "아니요, 가방 안에도 없어요.",
     "es": "No, dentro del bolso tampoco está.",
     "en": "No, it's not inside the bag either.",
     "analisis": [
      [
       "안에도",
       {
        "@es": "dentro también (con 없어요: tampoco)",
        "@en": "inside also (with 없어요: neither)"
