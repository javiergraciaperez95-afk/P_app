   },
   "id": "ko065-1",
   "opciones": [
    {
     "texto": {
      "@es": "Hable despacio, por favor.",
      "@en": "Speak slowly, please."
     },
     "explicacion": {
      "@es": "천천히 = despacio. 말해 주세요 = dígame, háblame.",
      "@en": "천천히 = slow. 말해 주세요 = tell me, talk to me."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Hable más rápido, por favor.",
      "@en": "Talk faster, please."
     },
     "explicacion": {
      "@es": "Eso sería 빨리 말해 주세요.",
      "@en": "That would be 빨리 말해 주세요."
     }
    },
    {
     "texto": {
      "@es": "Hable usted solo.",
      "@en": "You talk to yourself."
     },
     "explicacion": {
      "@es": "No pide nada de hablar despacio.",
      "@en": "He's not asking for anything to speak slowly."
