{
 "capitulo": 12,
 "titulo_ko": "먹어 봤어요",
 "titulo_es": {
  "@es": "Probar algo: -아/어 보다",
  "@en": "Try something: -아/어 보다"
 },
 "palabras": {
  "먹어 보세요": {
   "es": "pruebe",
   "en": "Try",
   "pron": "mŏ-gŏ bo-se-yo"
  },
  "먹어 봤어요": {
   "es": "lo probé",
   "en": "I tried it.",
   "pron": "mŏ-gŏ bwa-ssŏ-yo"
  },
  "먹어 봐요": {
   "es": "lo pruebo, pruebas",
   "en": "I try it, I try it.",
