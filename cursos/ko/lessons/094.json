  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué expresa «한번 먹어 보세요»?",
    "@en": "What does «한번 먹어 보세요» express?"
   },
   "id": "ko094-1",
   "opciones": [
    {
     "texto": {
      "@es": "Una invitación cortés a probarlo una vez.",
      "@en": "A courteous invitation to try it once."
     },
     "explicacion": {
      "@es": "-아/어 보세요 sugiere probar la acción.",
      "@en": "-아/어 보세요 suggests testing the action."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Una orden de comerlo todo.",
      "@en": "An order to eat everything."
     },
     "explicacion": {
      "@es": "No se usa una forma de cantidad ni de terminarlo.",
      "@en": "You don't use a form of quantity or finish it."
     }
    },
    {
     "texto": {
      "@es": "Una afirmación de que ya lo probó.",
      "@en": "A statement that you've already proved it."
     },
     "explicacion": {
      "@es": "El pasado sería 먹어 봤어요.",
      "@en": "The past would be 먹어 봤어요."
     }
    }
   ]
  },
