{
 "capitulo": 13,
 "titulo_ko": "피곤해서",
 "titulo_es": {
  "@es": "Explicar con «porque»: -아/어서",
  "@en": "Explain with «because»: -아/어서"
 },
 "palabras": {
  "피곤해서": {
   "es": "porque estoy cansado",
   "en": "Because I'm tired.",
   "pron": "pi-gon-he-sŏ"
  },
  "가서": {
   "es": "fui y, y luego fui",
   "en": "I went and, and then I went",
   "pron": "ga-sŏ"
  },
  "먹어서": {
   "es": "comiendo, porque comí",
   "en": "eating, because I ate",
   "pron": "mŏ-gŏ-sŏ"
  },
  "바빠서": {
   "es": "porque estoy ocupado",
   "en": "Because I'm busy.",
   "pron": "ba-ppa-sŏ"
  },
  "배고파서": {
   "es": "porque tengo hambre",
   "en": "Because I'm hungry.",
   "pron": "be-go-pa-sŏ"
  },
  "늦어서": {
   "es": "porque llega tarde, porque llegó tarde",
   "en": "Because he's late, because he's late.",
   "pron": "nŭ-jŏ-sŏ"
  },
  "와서": {
   "es": "vine y, viniendo",
   "en": "I came and, coming.",
   "pron": "wa-sŏ"
  },
  "늦었어요": {
   "es": "llegaste tarde, llegué tarde",
   "en": "You're late, I'm late",
   "pron": "nŭ-jŏ-ssŏ-yo"
  },
  "일어났어요": {
   "es": "me levanté, te levantaste",
   "en": "I got up, you got up",
   "pron": "i-rŏ-na-ssŏ-yo"
  },
  "다음에는": {
   "es": "la próxima vez",
   "en": "next time",
   "pron": "da-ŭ-me-nŭn"
  },
  "버스가": {
   "es": "autobús + 가 (sujeto)",
   "en": "bus + ∞ (subject)",
   "pron": "bŏ-sŭ-ga",
   "oculta": true
  }
 },
 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Porque o y después",
    "@en": "Because or and then"
   },
   "texto": [
    {
     "@es": "Para unir dos frases con «porque» se usa **-아/어서** en el primer verbo. Lo que sigue es el resultado.",
     "@en": "To join two sentences with «because», **-아/어서** is used in the first verb. What follows is the result."
    },
    "피곤하다 → **피곤해서** (porque estoy cansado). 가다 → **가서** (fui y…).",
    "피곤**해서** 집에 갔어요 = como estaba cansado, me fui a casa."
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Orden de las ideas",
    "@en": "Order of ideas"
   },
   "texto": [
    {
     "@es": "En coreano la causa va primero y el resultado después, como en español.",
     "@en": "In Korean the cause goes first and the result later, as in Spanish."
    },
    {
     "@es": "Ya conoces **아파서** (porque estoy enfermo) de A1; ahora se usa con cualquier verbo o adjetivo.",
     "@en": "You know **아파서** (because I'm sick) of A1; now it's used with any verb or adjective."
    }
   ]
  },
