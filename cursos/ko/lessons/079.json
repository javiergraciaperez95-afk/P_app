  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué significa «피곤해서 쉬었어요»?",
    "@en": "What does «피곤해서 쉬었어요» mean?"
   },
   "id": "ko079-1",
   "opciones": [
    {
     "texto": {
      "@es": "Como estaba cansado, descansé.",
      "@en": "Since I was tired, I rested."
     },
     "explicacion": {
      "@es": "피곤해서 = porque estaba cansado. 쉬었어요 = descansé.",
      "@en": "피곤해서 = because I was tired. 쉬었어요 = rest."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Descansé y después estoy cansado.",
      "@en": "I got some rest and then I'm tired."
     },
     "explicacion": {
      "@es": "Eso cambia el orden de las ideas.",
      "@en": "That changes the order of ideas."
     }
    },
    {
     "texto": {
      "@es": "Estoy cansado, así que no descanso.",
      "@en": "I'm tired, so don't rest."
     },
     "explicacion": {
      "@es": "Eso sería 쉬지 않아요.",
      "@en": "That would be 쉬지 않아요."
     }
    }
   ]
