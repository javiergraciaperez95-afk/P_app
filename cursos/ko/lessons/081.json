 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Pero con -지만",
    "@en": "But with -지만"
   },
   "texto": [
    {
     "@es": "Para decir «pero» después de algo positivo o negativo se usa **-지만**.",
     "@en": "To say «but» after something positive or negative **-지만** is used."
    },
    "가다 → **가지만**, 먹다 → **먹지만**, 좋다 → **좋지만**, 비싸다 → **비싸지만**.",
    "음식은 **맛있지만** 비싸요 = la comida está rica, pero es cara."
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Frente a 하지만",
    "@en": "In front of 하지만"
   },
   "texto": [
    {
     "@es": "**하지만** (pero) va al principio de la frase; **-지만** va unido al verbo, dentro de la misma frase.",
     "@en": "**하지만** (but) goes to the beginning of the sentence; **-지만** goes to the verb, within the same sentence."
    },
    {
     "@es": "Ya conoces **하지만**, y **맵지만** de A1; ahora se usa en cualquier frase.",
     "@en": "You know **하지만**, and A1 **맵지만**; it is now used in any sentence."
    }
   ]
  },
