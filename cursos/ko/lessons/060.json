 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "En el hotel",
    "@en": "At the hotel"
   },
   "texto": [
    {
     "@es": "**방을 예약했어요** = he reservado una habitación.",
     "@en": "**방을 예약했어요** = I've booked a room."
    },
    {
     "@es": "En recepción te pedirán el pasaporte: **여권 좀 보여 주세요**.",
     "@en": "At the reception you will be asked for your passport: **여권 좀 보여 주세요**."
    },
    {
     "@es": "**아침 식사** = el desayuno (식사 es «comida» en el sentido de desayuno, almuerzo o cena).",
     "@en": "**아침 식사** = breakfast (식사 is «comida» in the sense of breakfast, lunch or dinner)."
    },
    {
     "@es": "**방은 오 층에 있어요** = la habitación está en la quinta planta.",
     "@en": "**방은 오 층에 있어요** = the room is on the fifth floor."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Si no te encuentras bien",
    "@en": "If you're not feeling well"
   },
   "texto": [
    {
     "@es": "**아파요** = duele; estoy malo. Lo que duele lleva 이/가: **머리가 아파요** (me duele la cabeza), **배가 아파요** (me duele la tripa), **목이 아파요** (me duele la garganta).",
     "@en": "**아파요** = hurts; I'm bad. What hurts takes 이/가: **머리가 아파요** (headache), **배가 아파요** (my stomach hurts), **목이 아파요** (my throat hurts)."
    },
    {
     "@es": "**어디가 아파요?** = ¿qué le duele? («¿dónde duele?»).",
     "@en": "**어디가 아파요?** = what hurts you? («Where does it hurt?»)."
    },
    {
     "@es": "**열이 있어요** = tengo fiebre. **감기에 걸렸어요** = estoy resfriado.",
     "@en": "**열이 있어요** = tengo fiebre. **감기에 걸렸어요** = I'm cold."
    },
    {
     "@es": "Las medicinas «se comen»: **약을 먹어요** = tomo la medicina. La farmacia es **약국**.",
     "@en": "«They eat.»: **약을 먹어요** = I take the medicine. The pharmacy is **약국**."
    },
    {
     "@es": "A quien está malo se le dice **푹 쉬세요** (descanse bien).",
     "@en": "Those who are bad are told **푹 쉬세요** (rest well)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Como…, por…: -아서 / -어서",
    "@en": "As in, for: -아서 / -어서"
   },
   "texto": [
    {
     "@es": "Para dar el motivo dentro de la misma frase, se quita 요 del presente y se añade **서**.",
     "@en": "To give the reason within the same sentence, it is removed 요 of the present and is added **서**."
    },
    "아파요 → **아파서**. **아파서** 학교에 못 가요 = como estoy malo, no puedo ir a la escuela.",
    {
     "@es": "La causa va primero y el resultado, después.",
     "@en": "The cause goes first and the result, then."
    }
   ]
  },
