 "bloques": [
  {
   "tipo": "texto",
   "titulo": {
    "@es": "Un plan sujeto al tiempo",
    "@en": "A plan subject to time"
   },
   "frases": [
    {
     "ko": "주말에 바다에 갈 수 있다면 기차를 타고 싶어요.",
     "es": "Si podemos ir al mar el fin de semana, quiero tomar el tren.",
     "en": "If we can go to the sea for the weekend, I want to take the train."
    },
    {
     "ko": "비가 올까 봐 일기예보를 확인했어요.",
     "es": "Revisé el pronóstico por si llovía.",
     "en": "I checked the prognosis in case it rained."
    },
    {
     "ko": "시간이 부족하다면 가까운 박물관에 갈 거예요.",
     "es": "Si nos falta tiempo, iremos a un museo cercano.",
     "en": "If we're short of time, we'll go to a nearby museum."
    },
    {
     "ko": "비가 많이 올지도 몰라서 우산도 준비했어요.",
     "es": "Como puede que llueva mucho, también preparé un paraguas.",
     "en": "As it may rain a lot, I also prepared an umbrella."
    },
    {
     "ko": "날씨가 좋다면 바닷가를 걸을 수 있어요.",
     "es": "Si hace buen tiempo, podemos caminar por la orilla.",
     "en": "If it's a good time, we can walk on the shore."
    }
   ]
  },
  {
   "tipo": "test",
