   },
   "id": "ko157-6",
   "opciones": [
    {
     "texto": {
      "@es": "No; el contexto decide si es una posibilidad real o hipotética.",
      "@en": "No; the context decides whether it is a real or hypothetical possibility."
     },
     "explicacion": {
      "@es": "-다면 plantea una condición como suposición, pero no la declara imposible.",
      "@en": "-다면 poses a condition as an assumption, but does not declare it impossible."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Sí, siempre describe algo imposible.",
      "@en": "Yeah, he always describes something impossible."
     },
     "explicacion": {
      "@es": "La forma no obliga a esa lectura.",
      "@en": "The form does not force that reading."
     }
    },
    {
     "texto": {
      "@es": "Sí, solo se usa para deseos.",
      "@en": "Yeah, it's just used for wishes."
     },
     "explicacion": {
      "@es": "Puede aparecer con distintos resultados.",
      "@en": "It can appear with different results."
     }
    }
   ]
