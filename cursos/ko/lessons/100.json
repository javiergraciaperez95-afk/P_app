  {
   "tipo": "test",
   "pregunta": "¿Qué añade -고 있어요 en «지금 공부하고 있어요»?",
   "id": "ko100-1",
   "opciones": [
    {
     "texto": {
      "@es": "Presenta el estudio como una acción en curso ahora.",
      "@en": "It presents the study as an ongoing action now."
     },
     "explicacion": {
      "@es": "El sufijo destaca el desarrollo de la acción.",
      "@en": "The suffix highlights the development of action."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Dice que estudiaré mañana.",
      "@en": "He says I'll study tomorrow."
     },
     "explicacion": {
      "@es": "Eso sería 내일 공부할 거예요.",
      "@en": "That would be 내일 공부할 거예요."
     }
    },
    {
     "texto": {
      "@es": "Solo puede significar un hábito diario.",
      "@en": "It can only mean a daily habit."
     },
     "explicacion": {
      "@es": "Un hábito suele expresarse con un adverbio como 매일.",
      "@en": "A habit is usually expressed with an adverbian like 매일."
     }
    }
