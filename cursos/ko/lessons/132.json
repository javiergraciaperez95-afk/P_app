   "id": "ko132-1",
   "opciones": [
    {
     "texto": "찍어 주세요",
     "explicacion": {
      "@es": "찍다 → 찍어 주세요: sáqueme.",
      "@en": "찍다 → 찍어 주세요: Get me out."
