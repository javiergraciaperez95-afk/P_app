     "correcta": true
    },
    {
     "texto": "찍지 마세요",
     "explicacion": {
      "@es": "Es «no saque».",
      "@en": "It's «do not take out»."
     }
    },
    {
     "texto": "찍으세요",
     "explicacion": {
      "@es": "Es «saque», orden cortés sin favor.",
      "@en": "It's «saque», courteous order without favor."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "Cap. 11. ¿Cómo pides que te expliquen una palabra otra vez?",
    "@en": "Cap. 11. How do you ask them to explain a word to you again?"
   },
   "id": "ko132-2",
   "opciones": [
    {
     "texto": "단어를 다시 설명해 주세요",
     "explicacion": {
      "@es": "다시 = otra vez; 설명해 주세요 = explíqueme.",
      "@en": "다시 = again; 설명해 주세요 = explain."
     },
     "correcta": true
    },
    {
     "texto": "단어를 다시 설명하세요",
     "explicacion": {
      "@es": "Es una instrucción cortés («explique»), no una petición de favor.",
      "@en": "It is a courteous instruction («explain»), not a request for favor."
     }
    },
    {
     "texto": "단어를 다시 설명하지 마세요",
     "explicacion": {
      "@es": "Significa «no explique la palabra otra vez».",
      "@en": "It means «Don't explain the word again.»."
     }
    }
   ]
  },
  {
