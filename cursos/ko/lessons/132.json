     "correcta": true
    },
    {
     "texto": {
      "@es": "Afirma que el tiempo era bueno ayer.",
      "@en": "He claims the weather was good yesterday."
     },
     "explicacion": {
      "@es": "No es una forma pasada.",
      "@en": "It's not a past way."
     }
    },
    {
     "texto": {
      "@es": "Significa «aunque hace buen tiempo».",
      "@en": "It means «Although it's been a while.»."
     },
     "explicacion": {
      "@es": "Para contraste se usa -지만.",
      "@en": "For contrast it is used -지만."
     }
    }
   ]
