     "tipo": "vocabulario",
     "titulo": "Vocabulario: contar un viaje",
     "palabras": [
      "보고",
      "먹고",
      "그래서",
      "그런데",
      "탔어요",
      "도착했어요",
      "구경했어요",
      "걸었어요",
      "찍었어요",
      "맛있었어요",
      "좋았어요",
