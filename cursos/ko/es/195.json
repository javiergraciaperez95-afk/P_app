       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "오늘 회의가 없잖아요. 그래서 일찍 퇴근한 것 같아요.",
       "alumno": "Hoy no hay reunión, ya sabes. Por eso parece que se fueron temprano.",
       "literal": "",
