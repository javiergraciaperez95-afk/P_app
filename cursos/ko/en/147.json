      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "친구와 주말마다 그곳에 가곤 했어요.",
       "alumno": "I used to go there every weekend with a friend.",
       "literal": "",
       "estructura": "",
       "nota": [],
