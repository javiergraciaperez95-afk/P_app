       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "우리가 갔던 서점은 지금 카페가 되었어요.",
       "alumno": "The bookshop we went to has now become a café.",
       "literal": "",
