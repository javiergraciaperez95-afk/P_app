 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Một sự việc đã qua được nhớ lại",
     "texto": [
      "**-았/었던** trình bày một hành động hay trải nghiệm như việc đã qua và có giới hạn, nhìn từ hiện tại: 가다 → **갔던 곳** (nơi tôi đã đi), 좋다 → **좋았던 날** (ngày đã tốt), 만나다 → **만났던 친구** (người bạn tôi đã gặp). Điều này không nhất thiết có nghĩa là tình huống không thể lặp lại."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Khác với -던 và -(으)ㄴ",
     "texto": [
      "**-던** thường nhấn mạnh việc đã quen, đang diễn ra hoặc không được trình bày như đã kết thúc. **-았/었던** thường trình bày hành động như đã hoàn tất. Ngữ cảnh có thể làm hai dạng này trùng nhau; nó không đơn thuần có nghĩa là «không còn nữa». **먹은 음식** là dạng quá khứ trung tính hơn."
     ],
     "tutora": ""
    },
