     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "유학을 시작한 뒤 한국 생활에 익숙해졌어요.",
       "alumno": "Sau khi bắt đầu du học, tôi đã quen với cuộc sống ở Hàn Quốc.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "처음에는 버스 타는 법을 몰랐지만 앱을 쓰게 됐어요.",
       "alumno": "Lúc đầu tôi không biết cách đi xe buýt, nhưng cuối cùng tôi đã dùng một ứng dụng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "동네 친구를 만나 한국어로 자주 이야기해요.",
       "alumno": "Tôi gặp một người bạn trong khu phố và hai người thường trò chuyện bằng tiếng Hàn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "매일 연습하면서 발음도 조금씩 좋아졌어요.",
       "alumno": "Khi luyện tập mỗi ngày, phát âm của tôi cũng tốt lên từng chút một.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "이제 혼자 시장에 갈 수 있게 되었어요.",
       "alumno": "Bây giờ tôi đã có thể đi chợ một mình.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
