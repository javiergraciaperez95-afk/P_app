   "pregunta": {
    "@es": "¿Qué indica la clase de una consonante?",
    "@en": "What does the class of a consonant indicate?"
   },
   "id": "th001-1",
   "opciones": [
    {
     "texto": {
      "@es": "Ayuda a calcular el tono.",
      "@en": "It helps to calculate the tone."
     },
     "explicacion": {
      "@es": "La consonante también representa un sonido.",
      "@en": "The consonant also represents a sound."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "El género de la palabra.",
      "@en": "The gender of the word."
     },
     "explicacion": {
      "@es": "El tailandés no marca género gramatical así.",
      "@en": "The Thai does not mark grammatical gender like this."
     }
    },
    {
     "texto": {
      "@es": "El tiempo del verbo.",
      "@en": "The verb time."
     },
     "explicacion": {
      "@es": "Los verbos no se conjugan por tiempo.",
      "@en": "Verbs don't get mixed up for a while."
     }
    }
   ]
