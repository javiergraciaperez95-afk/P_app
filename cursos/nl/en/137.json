   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Question words and V2 order",
     "texto": [
      "Open questions begin with a question word: «wie» (who), «wat» (what), «waar» (where) or «wanneer» (when). The question word is immediately followed by the conjugated verb in second position, and after it comes the subject («Waar werkt hij?», «Wanneer komt hij terug?»)."
     ],
     "tutora": ""
    }
   ]
  },
  {
