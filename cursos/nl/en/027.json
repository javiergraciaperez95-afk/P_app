   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Invitations and suggestions",
     "texto": [
      "To suggest a plan to friends, use «Zullen we... gaan?» (like English «shall we go...?»): «Zullen we vanavond naar de film gaan?» (Shall we go to the cinema tonight?). To express enthusiasm: «Leuk!» (Great! / How nice!). To invite someone to come along: «Kom je mee?» (Are you coming? / Are you coming with me?). To accept enthusiastically: «Ja, graag!» (Yes, I'd love to!). To apologise if you can't come: «Sorry, ik kan niet» (Sorry, I can't)."
     ],
     "tutora": ""
    }
   ]
  },
