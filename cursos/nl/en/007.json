   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Family and demonstratives",
     "texto": [
      "To introduce family members we use «Dit is...» (this is...) or «Dat is...» (that is...). To ask who someone is: «Wie is...?» (Who is...?). Notice the gender and the articles of family members: «de vader» (the father), «de moeder» (the mother), «de broer» (the brother), «de zus» (the sister), «de man» (the man/husband), «de vrouw» (the woman/wife), «de ouders» (the parents), and in the neuter gender «het kind» (the child/son)."
     ],
     "tutora": ""
    }
   ]
  },
