   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Furniture and position verbs",
     "texto": [
      "Dutch distinguishes the position of objects, as English does with «stand» and «lie»: «staan» (to stand: upright, or resting on a vertical base, like lamps, bottles or cupboards) and «liggen» (to lie: lying down or flat, like books, keys or rugs): «De lamp staat op de tafel» compared with «Het boek ligt op het bed». Remember the articles: «de tafel» (the table), «de stoel» (the chair), «het bed» (the bed), «de kast» (the cupboard), «de lamp» (the lamp)."
     ],
     "tutora": ""
    }
   ]
  },
