   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Inviting and replying",
     "texto": [
      "To suggest a joint plan, you say «Ga je mee naar...?» (Are you coming to...?). If you accept enthusiastically, you say «Ja, leuk!» (Yes, great!) or «Ja, graag!». If you cannot attend, the polite formula is «Sorry, dan kan ik niet; ik werk» (Sorry, then I can't; I'm working). To express regret, «Wat jammer!» (What a shame!) is used, and another time is suggested: «Zullen we zondag gaan?» (Shall we go on Sunday?)."
     ],
     "tutora": ""
    }
   ]
