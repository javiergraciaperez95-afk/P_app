   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Short notes and everyday errands",
     "texto": [
      "To leave messages at home or at work, direct but polite imperative phrases are used: «Haal straks brood en melk, alsjeblieft» (Buy some bread and milk later, please). «Boodschappen doen» means to do the household shopping, and adverbs such as «straks» (in a while / later) and «even» (a moment) qualify the time of the action."
     ],
     "tutora": ""
    }
   ]
  },
