     "id": "nl128-1",
     "pregunta": {
      "texto": "How is the «sch» group pronounced correctly in words like «school»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "With the «s» sound followed by the rough «ch» sound, without adding a vowel before it.",
       "lengua": "alumno",
       "explicacion": "It is pronounced /sx/, without placing any supporting «e» at the start.",
       "correcta": true
      },
      {
       "texto": "Exactly like the English «sh» sound.",
       "lengua": "alumno",
       "explicacion": "In standard Dutch it is not a postalveolar «sh» fricative, but /sx/.",
       "correcta": false
      },
      {
       "texto": "Like a simple «k», without pronouncing the «s».",
       "lengua": "alumno",
       "explicacion": "The initial «s» is always pronounced clearly.",
       "correcta": false
      }
     ],
