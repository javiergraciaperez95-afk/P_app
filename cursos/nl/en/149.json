   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Ordering in a restaurant",
     "texto": [
      "To order politely, «Ik wil graag...» (I'd like, please...) or «Mag ik...» (may I have...?) is used. To ask whether a dish includes a specific ingredient, the structure «Zit er... in?» (does it contain... / is there... in it?) is used. To ask for a dish to be prepared without that ingredient, «zonder...» (without...) is used."
     ],
     "tutora": ""
    }
   ]
  },
