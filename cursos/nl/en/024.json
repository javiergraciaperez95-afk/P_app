   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Means of transport and departures",
     "texto": [
      "To say how you travel, use «met», as in «met de trein» (by train), «met de bus» (by bus), «met de tram» (by tram), «met de fiets» (by bicycle). Unlike English «by train», Dutch keeps the article here. To ask when something leaves: «Hoe laat vertrekt de trein?» (What time does the train leave?). Things at the station: «het perron» (the platform), «de halte» (the bus/tram stop), «het kaartje» (the ticket). Key verbs: «vertrekken» (to leave / depart) and «aankomen» (to arrive)."
     ],
     "tutora": ""
    }
   ]
  },
