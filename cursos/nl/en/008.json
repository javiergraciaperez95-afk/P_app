   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Age with «zijn» and the months",
     "texto": [
      "As in English, Dutch expresses age with the verb «zijn» (to be): «Ik ben twintig jaar» (I am twenty years old). To ask: «Hoe oud ben je?» (How old are you?). For birthdays, the adjective «jarig» is used: «Wanneer ben je jarig?» (When is your birthday?), and you answer with the preposition «in»: «In mei» (In May)."
     ],
     "tutora": ""
    }
   ]
