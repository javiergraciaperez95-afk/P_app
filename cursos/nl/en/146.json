   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Describing a home",
     "texto": [
      "To describe the rooms, «er is» (there is, singular) or «er zijn» (there are, plural) is used: «Er is een woonkamer met veel licht» (there is a living room with a lot of light). To indicate the height, «op de... verdieping» is used (on the ... floor). The expression «dichtbij» means nearby, and «betaalbaar» describes an affordable price or rent."
     ],
     "tutora": ""
    }
   ]
  },
