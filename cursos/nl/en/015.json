 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Making appointments and suggestions with «zullen»",
     "texto": [
      "To make a polite suggestion to someone, use «Zullen we... + infinitive at the end?» (like English «shall we...?»): «Zullen we om tien uur afspreken?» (Shall we meet at ten?). To confirm you are available, say «Ik ben vrij» (I am free) or «Ik ben beschikbaar» (I am available). To say goodbye while fixing the meeting: «Tot morgen!» (See you tomorrow!)."
     ],
     "tutora": ""
    }
   ]
  },
