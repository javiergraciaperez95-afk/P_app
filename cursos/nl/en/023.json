   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Directions",
     "texto": [
      "To politely ask for help in the street: «Kunt u mij helpen?» (Could you help me?). The basic directions are: «rechtdoor» (straight on), «links» (to the left), «rechts» (to the right). To cross the street, use the separable verb «oversteken»: «steek daar de straat over» (cross the street there). For landmarks: «de eerste hoek» (the first corner), «de tweede hoek» (the second corner), «de brug» (the bridge)."
     ],
     "tutora": ""
    }
   ]
  },
