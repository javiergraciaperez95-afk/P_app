   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Asking about and expressing prices",
     "texto": [
      "To ask the price of a single item, you use «Hoeveel kost dit / deze appel?» (How much is...?). For several items in the plural, the -en form is used: «Hoeveel kosten drie appels?» (How much are...?). The expression «per stuk» means \"per unit\" or \"each\"."
     ],
     "tutora": ""
    }
   ]
  },
