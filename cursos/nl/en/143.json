     "pregunta": {
      "texto": "What is the difference between «kost» and «kosten» when asking prices?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "«Kost» is used for a single item and «kosten» for several items in the plural",
       "lengua": "alumno",
       "explicacion": "Agreement with the grammatical subject is required.",
       "correcta": true
      },
      {
       "texto": "«Kost» is the formal form with «u» and «kosten» the informal one",
       "lengua": "alumno",
       "explicacion": "Both forms depend on the number of the noun, not on the form of courtesy.",
       "correcta": false
      },
      {
       "texto": "«Kost» is used for food and «kosten» for clothing or objects",
       "lengua": "alumno",
       "explicacion": "The type of goods does not change the conjugation of the verb.",
       "correcta": false
      }
     ],
