   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Forming the plural",
     "texto": [
      "The vast majority of Dutch nouns form their plural by adding the ending «-en» (stoel -> stoelen, boek -> boeken). Nouns ending in an unstressed syllable such as -el, -em, -en or -er, and words of foreign origin, usually add «-s» (sleutel -> sleutels, tafel -> tafels). Some very frequent words have a special plural, such as «kind» (child), whose plural is «kinderen». All plurals take the article «de»."
     ],
     "tutora": ""
    }
   ]
  },
