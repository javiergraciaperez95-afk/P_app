     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Because «boek» is neuter and with «een» the adjective adds no -e, while with «de» it always adds -e",
       "lengua": "alumno",
       "explicacion": "This is the attributive inflection rule for «het» words with the indefinite article.",
       "correcta": true
      },
      {
       "texto": "Because «fiets» is plural and «boek» is singular",
       "lengua": "alumno",
       "explicacion": "Both words are in the singular.",
       "correcta": false
      },
      {
       "texto": "Because «nieuw» is an irregular adjective that only changes with vehicles",
       "lengua": "alumno",
       "explicacion": "The rule depends on the gender of the noun and the determiner, not on its meaning.",
       "correcta": false
      }
