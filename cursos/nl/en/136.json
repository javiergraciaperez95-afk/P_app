   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Yes-or-no questions and inversion",
     "texto": [
      "To form a closed question (one whose answer is yes or no), the conjugated verb must go at the start of the sentence, immediately followed by the subject: «Kom je vandaag naar de markt?» (Are you coming to the market today?). If the subject is «jij/je», remember that the verb loses its final -t in inversion («kom je?», «ga je?»)."
     ],
     "tutora": ""
    }
   ]
  },
