     "tipo": "test",
     "id": "nl136-1",
     "pregunta": {
      "texto": "How is a yes-or-no question structured in Dutch?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "With the conjugated verb in absolute first position",
       "lengua": "alumno",
       "explicacion": "The verb moves forward and is followed by the subject («Kom je...?», «Is de winkel...?»).",
       "correcta": true
      },
      {
       "texto": "By placing a fixed question particle at the end of the sentence",
       "lengua": "alumno",
       "explicacion": "Dutch does not add final particles for closed questions.",
       "correcta": false
      },
      {
       "texto": "By keeping exactly the same subject-verb order as the affirmative sentence",
       "lengua": "alumno",
       "explicacion": "The direct order («Je komt...») is only affirmative; it is not the standard question form.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
