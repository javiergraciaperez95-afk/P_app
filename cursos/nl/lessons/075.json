   "frases": [
    {
     "quien": "Noor",
     "nl": "Hoe kunnen we thuis minder afval weggooien?",
     "es": "¿Cómo podemos generar menos residuos en casa?",
     "en": "How can we generate less waste at home?"
    },
    {
     "quien": "Sara",
     "nl": "We kunnen verpakkingen hergebruiken.",
     "es": "Podemos reutilizar los envases.",
     "en": "We can reuse the containers."
    },
    {
     "quien": "Noor",
     "nl": "Wat doe je met plastic dat niet opnieuw gebruikt kan worden?",
