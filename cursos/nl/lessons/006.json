    {
     "texto": "zijn",
     "explicacion": {
      "@es": "Es el verbo copulativo básico e irregular («ser / estar»).",
      "@en": "It is the basic and irregular copulative verb («be / be»)."
     },
     "correcta": true
    },
    {
     "texto": "ben",
     "explicacion": {
      "@es": "Es la primera persona del presente («yo soy / estoy»).",
      "@en": "He is the first person in the present («I am / am»)."
     }
    },
    {
     "texto": "bent",
     "explicacion": {
      "@es": "Es la segunda persona («tú eres / estás»).",
      "@en": "It is the second person («you are»)."
     }
    }
   ]
  },
  {
   "tipo": "traduccion",
