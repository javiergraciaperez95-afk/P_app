   "frases": [
    {
     "quien": "Mila",
     "nl": "Ik twijfel of ik een nieuwe baan moet zoeken.",
     "es": "Dudo si debería buscar un nuevo trabajo.",
     "en": "I doubt if I should look for a new job."
    },
    {
     "quien": "Sara",
     "nl": "Als ik jou was, zou ik eerst de mogelijkheden vergelijken.",
     "es": "Si yo fuera tú, compararía primero las posibilidades.",
     "en": "If I were you, I'd first compare the possibilities."
    },
    {
     "quien": "Mila",
     "nl": "Waar moet ik op letten?",
     "es": "¿En qué debería fijarme?",
     "en": "What should I look at?"
    },
    {
     "quien": "Sara",
     "nl": "Denk na over de voordelen en de risico’s.",
     "es": "Piensa en las ventajas y los riesgos.",
     "en": "Think of the advantages and the risks."
    },
    {
     "quien": "Mila",
     "nl": "En als ik nog steeds twijfel?",
     "es": "¿Y si sigo teniendo dudas?",
     "en": "What if I still have doubts?"
    },
    {
     "quien": "Sara",
     "nl": "Praat met iemand die je vertrouwt voordat je kiest.",
     "es": "Habla con alguien en quien confíes antes de decidir.",
     "en": "Talk to someone you trust before you decide."
    }
   ]
