   "frases": [
    {
     "quien": "Luca",
     "nl": "Ik raak gefrustreerd als de afspraken niet worden nagekomen.",
     "es": "Me frustro cuando no se cumplen los acuerdos.",
     "en": "I'm frustrated when the agreements are not fulfilled."
    },
    {
     "quien": "Noor",
     "nl": "Dat begrijp ik. Ik had het druk en vergat het.",
     "es": "Lo entiendo. Estaba ocupado y se me olvidó.",
     "en": "I get it. I was busy and I forgot."
    },
    {
     "quien": "Luca",
     "nl": "Ik wil eerst uitleggen waarom dit belangrijk is.",
     "es": "Quiero explicar primero por qué esto es importante.",
     "en": "I want to explain first why this is important."
    },
    {
     "quien": "Noor",
     "nl": "Natuurlijk. Ik zal luisteren zonder je te onderbreken.",
     "es": "Claro. Escucharé sin interrumpirte.",
     "en": "Sure. I'll listen without interrupting you."
    },
    {
     "quien": "Luca",
     "nl": "Kunnen we samen een compromis vinden?",
     "es": "¿Podemos encontrar un compromiso juntos?",
     "en": "Can we find a compromise together?"
    },
    {
     "quien": "Noor",
     "nl": "Ja. Laten we respectvol naar een oplossing zoeken.",
     "es": "Sí. Busquemos una solución con respeto.",
     "en": "Yeah. Let's find a solution with respect."
    }
   ]
