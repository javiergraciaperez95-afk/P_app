    {
     "quien": "Noor",
     "nl": "Ja. Hij woonde naast ons toen ik jong was.",
     "es": "Sí. Vivía al lado de nuestra casa cuando era joven.",
     "en": "Yeah. He lived by our house when he was young."
    },
    {
     "quien": "Mila",
     "nl": "Wat een bijzondere herinnering.",
     "es": "Qué recuerdo tan especial.",
     "en": "What a special memory."
    },
    {
     "quien": "Noor",
     "nl": "Hij is inmiddels naar een andere stad verhuisd.",
     "es": "Desde entonces se ha mudado a otra ciudad.",
     "en": "Since then, he's moved to another city."
    },
    {
     "quien": "Mila",
     "nl": "Was hij verbaasd je te zien?",
     "es": "¿Le sorprendió verte?",
