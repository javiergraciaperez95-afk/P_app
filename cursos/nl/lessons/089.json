   "frases": [
    {
     "quien": "Mila",
     "nl": "Heb je al een keuze gemaakt?",
     "es": "¿Ya has tomado una decisión?",
     "en": "Have you made a decision yet?"
    },
    {
     "quien": "Luca",
     "nl": "Nog niet. De ene baan betaalt beter.",
     "es": "Todavía no. Un empleo está mejor pagado.",
     "en": "Not yet. A job is better paid."
    },
    {
     "quien": "Mila",
     "nl": "En wat is het voordeel van de andere?",
     "es": "¿Y cuál es la ventaja del otro?",
     "en": "And what's the advantage of the other?"
    },
    {
     "quien": "Luca",
     "nl": "Ik krijg daar meer vrijheid en kan thuiswerken.",
     "es": "Allí tengo más libertad y puedo teletrabajar.",
     "en": "I have more freedom there and I can telework."
    },
    {
     "quien": "Mila",
     "nl": "Welk criterium is voor jou beslissend?",
     "es": "¿Qué criterio es decisivo para ti?",
     "en": "What is the decisive criterion for you?"
    },
    {
     "quien": "Luca",
     "nl": "Een goede balans. Daarom kies ik waarschijnlijk voor de tweede baan.",
     "es": "Un buen equilibrio. Por eso probablemente elegiré el segundo empleo.",
     "en": "A good balance. That's why I'll probably pick second job."
    }
   ]
