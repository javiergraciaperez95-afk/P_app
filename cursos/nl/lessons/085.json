   },
   "frases": [
    {
     "quien": "Gast",
     "nl": "Ik wil een klacht indienen over mijn accommodatie.",
     "es": "Quiero presentar una reclamación sobre mi alojamiento.",
     "en": "I want to file a complaint about my accommodation."
    },
    {
     "quien": "Medewerker",
     "nl": "Wat is er precies gebeurd?",
     "es": "¿Qué ha ocurrido exactamente?",
     "en": "What exactly happened?"
    },
    {
     "quien": "Gast",
     "nl": "De kamer was niet klaar en er was geen warm water.",
     "es": "La habitación no estaba lista y no había agua caliente.",
     "en": "The room wasn't ready and there was no hot water."
    },
    {
     "quien": "Medewerker",
     "nl": "Dat is niet volgens onze afspraak.",
     "es": "Eso no se ajusta a lo acordado.",
     "en": "That's not in line with what was agreed."
    },
    {
     "quien": "Gast",
     "nl": "Ik verwacht een passende compensatie.",
     "es": "Espero una compensación adecuada.",
     "en": "I expect a proper compensation."
    },
    {
     "quien": "Medewerker",
     "nl": "We onderzoeken de klacht en nemen morgen contact met u op.",
     "es": "Investigaremos la reclamación y nos pondremos en contacto con usted mañana.",
     "en": "We'll investigate the claim and contact you tomorrow."
    }
   ]
