   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Invitaciones y propuestas",
     "texto": [
      "Para proponer un plan a amigos se utiliza «Zullen we... gaan?» (¿Vamos a...?): «Zullen we vanavond naar de film gaan?» (¿Vamos al cine esta noche?). Para expresar entusiasmo: «Leuk!» (¡Genial! / ¡Qué bien!). Para invitar a venir: «Kom je mee?» (¿Te vienes? / ¿Vienes conmigo?). Para aceptar con entusiasmo: «Ja, graag!» (¡Sí, encantado!). Para disculparte si no puedes: «Sorry, ik kan niet» (Lo siento, no puedo)."
     ],
     "tutora": ""
    }
   ]
