       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Tom",
        "lengua": "estudio"
       },
       "estudio": "Natuurlijk, wat viel je op?",
       "alumno": "Claro, ¿qué observaste?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Anna",
        "lengua": "estudio"
       },
       "estudio": "Je uitleg was duidelijk; bij de grafieken miste ik een toelichting.",
       "alumno": "Tu explicación fue clara; eché en falta una aclaración en los gráficos.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Tom",
        "lengua": "estudio"
       },
       "estudio": "Bedoel je dat ik de cijfers mondeling moet toelichten?",
       "alumno": "¿Quieres decir que debo explicar las cifras oralmente?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Anna",
        "lengua": "estudio"
       },
       "estudio": "Ja, dan kan het publiek de vergelijking beter volgen.",
       "alumno": "Sí, así el público podrá seguir mejor la comparación.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Tom",
        "lengua": "estudio"
       },
       "estudio": "Dank je, ik voeg bij de volgende versie een korte uitleg toe.",
       "alumno": "Gracias, añadiré una breve explicación en la próxima versión.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
