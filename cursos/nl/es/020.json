 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Tallas y el uso de «te»",
     "texto": [
      "Para preguntar por la talla se dice «Welke maat zoek je?» (¿Qué talla buscas?). El verbo probarse ropa es «passen»: «Wil je deze broek passen?» (¿Quieres probarte este pantalón?). Cuando una prenda no queda bien usamos «te» (demasiado): «hij is te klein» (es demasiado pequeño) o «hij is te groot» (es demasiado grande). Recuerda que a los objetos masculinos/femeninos se alude con «hij»: «de broek... hij is te klein»."
     ],
     "tutora": ""
    }
   ]
  },
