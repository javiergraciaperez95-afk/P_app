       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Noor",
        "lengua": "estudio"
       },
       "estudio": "Dat begrijp ik. Ik had het druk en vergat het.",
       "alumno": "Lo entiendo. Estaba ocupado y se me olvidó.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Luca",
        "lengua": "alumno"
       },
       "estudio": "Ik wil eerst uitleggen waarom dit belangrijk is.",
       "alumno": "Quiero explicar primero por qué esto es importante.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Noor",
        "lengua": "estudio"
       },
       "estudio": "Natuurlijk. Ik zal luisteren zonder je te onderbreken.",
       "alumno": "Claro. Escucharé sin interrumpirte.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Luca",
        "lengua": "alumno"
       },
       "estudio": "Kunnen we samen een compromis vinden?",
       "alumno": "¿Podemos encontrar un compromiso juntos?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Noor",
        "lengua": "estudio"
       },
       "estudio": "Ja. Laten we respectvol naar een oplossing zoeken.",
       "alumno": "Sí. Busquemos una solución con respeto.",
