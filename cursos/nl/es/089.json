       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Mila",
        "lengua": "estudio"
       },
       "estudio": "Welk criterium is voor jou beslissend?",
       "alumno": "¿Qué criterio es decisivo para ti?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Luca",
        "lengua": "alumno"
       },
