   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Los dos géneros gramaticales",
     "texto": [
      "En neerlandés existen dos artículos determinados: «de» (para palabras masculinas y femeninas agrupadas en género común, además de todos los plurales) y «het» (para palabras de género neutro y todos los diminutivos). Como no existe una regla fija universal para predecir si una palabra aislada lleva «de» o «het», la mejor estrategia pedagógica es aprender cada sustantivo desde el primer día junto con su artículo correspondiente."
     ],
     "tutora": ""
    }
   ]
