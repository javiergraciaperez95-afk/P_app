     "id": "nl135-1",
     "pregunta": {
      "texto": "¿Por qué se dice «de nieuwe fiets» pero «een nieuw boek»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Porque «boek» es neutro y con «een» el adjetivo no añade -e, mientras que con «de» siempre añade -e",
       "lengua": "alumno",
       "explicacion": "Es la regla de flexión atributiva para palabras het con artículo indefinido.",
       "correcta": true
      },
      {
       "texto": "Porque «fiets» es plural y «boek» es singular",
       "lengua": "alumno",
       "explicacion": "Ambas palabras están en singular.",
       "correcta": false
      },
      {
       "texto": "Porque «nieuw» es un adjetivo irregular que solo cambia con transportes",
       "lengua": "alumno",
       "explicacion": "La regla depende del género del sustantivo y del determinante, no del significado.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
