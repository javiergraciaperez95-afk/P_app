   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Invitar y responder",
     "texto": [
      "Para proponer un plan conjunto se dice «Ga je mee naar...?» (¿te vienes a...?). Si aceptas entusiasmado dices «Ja, leuk!» (¡sí, qué bien!) o «Ja, graag!». Si no puedes acudir, la fórmula cortés es «Sorry, dan kan ik niet; ik werk» (lo siento, entonces no puedo; trabajo). Para lamentarlo se usa «Wat jammer!» (¡qué pena / qué lástima!) y se sugiere otro momento: «Zullen we zondag gaan?» (¿vamos el domingo?)."
     ],
     "tutora": ""
    }
   ]
  },
