      },
      {
       "quien": {
        "texto": "Tom",
        "lengua": "estudio"
       },
       "estudio": "Toch zijn beide groepen het eens over betere verlichting.",
       "alumno": "Aun así, ambos grupos coinciden en que hace falta mejor iluminación.",
