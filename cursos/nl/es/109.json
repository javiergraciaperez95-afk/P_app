       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Anna",
        "lengua": "estudio"
       },
       "estudio": "Dat voorkomt dat kwetsbare huishoudens de kosten alleen dragen.",
       "alumno": "Eso evita que los hogares vulnerables asuman solos los costes.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Tom",
        "lengua": "estudio"
       },
       "estudio": "Zo koppelen we de klimaatdoelstelling aan een eerlijke uitvoering.",
