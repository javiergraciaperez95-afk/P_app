     "id": "nl128-1",
     "pregunta": {
      "texto": "¿Cómo se pronuncia adecuadamente el grupo «sch» en palabras como «school»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Con el sonido «s» seguido del sonido raspado «ch», sin añadir vocal previa",
       "lengua": "alumno",
       "explicacion": "Se articula /sx/, sin colocar ninguna «e» de apoyo al principio.",
       "correcta": true
      },
      {
       "texto": "Exactamente como una «sh» suave inglesa o francesa",
       "lengua": "alumno",
       "explicacion": "En neerlandés estándar no es una fricativa postalveolar «sh», sino /sx/.",
       "correcta": false
      },
      {
       "texto": "Como una «k» simple sin pronunciar la «s»",
       "lengua": "alumno",
       "explicacion": "La «s» inicial siempre se pronuncia claramente.",
       "correcta": false
      }
     ],
     "respuestas": {
