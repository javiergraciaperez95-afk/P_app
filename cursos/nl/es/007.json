   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "La familia y los demostrativos",
     "texto": [
      "Para presentar a las personas de la familia usamos «Dit is...» (este/esta es) o «Dat is...» (ese/aquel es). Para preguntar por la identidad de alguien: «Wie is...?» (¿Quién es...?). Observa el género y los artículos de los miembros de la familia: «de vader» (el padre), «de moeder» (la madre), «de broer» (el hermano), «de zus» (la hermana), «de man» (el hombre/esposo), «de vrouw» (la mujer/esposa), «de ouders» (los padres), y en género neutro «het kind» (el niño/hijo)."
     ],
     "tutora": ""
    }
   ]
