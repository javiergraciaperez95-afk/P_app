     "opciones": [
      {
       "texto": "Con el verbo conjugado en la primera posición absoluta",
       "lengua": "alumno",
       "explicacion": "Se adelanta el verbo y le sigue el sujeto («Kom je...?», «Is de winkel...?»).",
       "correcta": true
      },
      {
       "texto": "Colocando una partícula interrogativa fija al final de la frase",
       "lengua": "alumno",
       "explicacion": "El neerlandés no añade partículas finales para preguntas cerradas.",
       "correcta": false
      },
      {
       "texto": "Manteniendo exactamente el mismo orden de sujeto y verbo de la frase afirmativa",
       "lengua": "alumno",
       "explicacion": "El orden directo («Je komt...») solo es afirmativo, no forma estándar de pregunta.",
       "correcta": false
      }
