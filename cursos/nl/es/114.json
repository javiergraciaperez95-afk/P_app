       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Anna",
        "lengua": "estudio"
       },
       "estudio": "Toch kan een controversieel werk een belangrijk gesprek openen.",
       "alumno": "Aun así, una obra controvertida puede abrir una conversación importante.",
