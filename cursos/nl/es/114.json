       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Anna",
        "lengua": "estudio"
       },
       "estudio": "Waar ligt volgens jou de grens van de vrijheid van meningsuiting?",
       "alumno": "¿Dónde está para ti el límite de la libertad de expresión?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Tom",
        "lengua": "estudio"
       },
       "estudio": "Kunst mag uitdagen, zolang we ruimte laten voor verschillende interpretaties.",
