   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Cỡ và từ «te»",
     "texto": [
      "Để hỏi cỡ, nói «Welke maat zoek je?» (Bạn tìm cỡ nào?). Động từ thử đồ là «passen»: «Wil je deze broek passen?» (Bạn muốn thử chiếc quần này không?). Khi món đồ không vừa, ta dùng «te» (quá): «hij is te klein» (nó quá nhỏ) hoặc «hij is te groot» (nó quá rộng). Nhớ rằng đồ vật được gọi bằng «hij», dù thuộc giống đực hay giống cái: «de broek... hij is te klein»."
     ],
     "tutora": ""
    }
   ]
