        "texto": "Tom",
        "lengua": "estudio"
       },
       "estudio": "Is de klacht sinds gisteren verergerd?",
       "alumno": "Từ hôm qua triệu chứng đã nặng thêm không?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
