       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Anna",
        "lengua": "estudio"
       },
       "estudio": "Eén tablet per dag, zoals op het etiket staat.",
       "alumno": "Một viên mỗi ngày, như ghi trên nhãn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Tom",
        "lengua": "estudio"
       },
       "estudio": "Neem contact op als het erger wordt; dan bespreken we de vervolgstap.",
