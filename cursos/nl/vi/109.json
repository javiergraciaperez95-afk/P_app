        "lengua": "estudio"
       },
       "estudio": "De nieuwe heffing moet de uitstoot van auto's terugdringen.",
       "alumno": "Loại thuế mới phải làm giảm khí thải của ô tô.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Tom",
        "lengua": "estudio"
       },
       "estudio": "Maar is die maatregel betaalbaar voor iedereen?",
       "alumno": "Nhưng biện pháp đó phải chăng cho tất cả mọi người không?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Anna",
        "lengua": "estudio"
       },
       "estudio": "Mensen met een laag inkomen kunnen extra steun krijgen.",
       "alumno": "Những người thu nhập thấp có thể nhận thêm trợ cấp.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Tom",
        "lengua": "estudio"
       },
       "estudio": "Dan moet de overheid wel duidelijk maken wie daarvoor in aanmerking komt.",
       "alumno": "Vậy chính phủ phải làm rõ ai được quyền hưởng các khoản đó.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Anna",
        "lengua": "estudio"
       },
       "estudio": "Dat voorkomt dat kwetsbare huishoudens de kosten alleen dragen.",
       "alumno": "Điều đó ngăn những hộ dễ tổn thương phải tự gánh chi phí.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Tom",
        "lengua": "estudio"
       },
