        "texto": "Tom",
        "lengua": "estudio"
       },
       "estudio": "Dank je dat je dat zegt; waar loop je vooral tegenaan?",
       "alumno": "Cảm ơn bạn đã nói ra; bạn thấy khó nhất ở điều gì?",
       "literal": "",
       "estructura": "",
