       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Noor",
        "lengua": "estudio"
       },
       "estudio": "Dat begrijp ik. Ik had het druk en vergat het.",
       "alumno": "Tôi hiểu. Tôi bận nên quên mất.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Luca",
        "lengua": "alumno"
       },
       "estudio": "Ik wil eerst uitleggen waarom dit belangrijk is.",
       "alumno": "Mình muốn giải thích trước vì sao việc này quan trọng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Noor",
        "lengua": "estudio"
       },
       "estudio": "Natuurlijk. Ik zal luisteren zonder je te onderbreken.",
       "alumno": "Tất nhiên. Tôi sẽ lắng nghe mà không ngắt lời bạn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Luca",
        "lengua": "alumno"
       },
       "estudio": "Kunnen we samen een compromis vinden?",
       "alumno": "Mình cùng tìm một thỏa hiệp được không?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Noor",
        "lengua": "estudio"
       },
       "estudio": "Ja. Laten we respectvol naar een oplossing zoeken.",
       "alumno": "Vâng. Hãy cùng tìm giải pháp một cách tôn trọng nhau.",
       "literal": "",
       "estructura": "",
       "nota": [],
