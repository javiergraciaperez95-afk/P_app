{
 "capitulo": 38,
 "titulo_ja": "こうしき の ことば (1)",
 "titulo_es": {
  "@es": "Durante: にわたって y において",
  "@en": "During: にわたって and において"
 },
 "palabras": {
  "にわたって": {
   "es": "durante (todo un periodo)",
   "en": "for (an entire period)",
   "pron": "ni watatte"
  },
  "において": {
   "es": "en; en el ámbito de",
   "en": "in the field of",
   "pron": "ni oite"
  },
  "さんねん": {
   "es": "tres años",
   "en": "3 years",
   "pron": "sannen"
  },
  "けんきゅう": {
   "es": "investigación; estudio",
   "en": "research; study",
   "pron": "kenkyū"
  },
  "かいぎ": {
   "es": "reunión; conferencia",
   "en": "meeting; conference",
   "pron": "kaigi",
   "oculta": true
  },
  "おこなわれました": {
   "es": "se celebró; se llevó a cabo",
   "en": "was held; it was carried out",
   "pron": "okonawaremashita"
  },
  "かかりました": {
   "es": "llevó (tiempo); costó (de かかる)",
   "en": "it took (time); cost (from)",
   "pron": "kakarimashita"
  }
 },
 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "〜にわたって: durante; a lo largo de",
    "@en": "∞ にわたって: during; along"
   },
   "texto": [
    {
     "@es": "Indica que una acción o situación abarca un periodo o una extensión: sustantivo + **にわたって**. No implica necesariamente que ocurra sin interrupción: **さんねん にわたって けんきゅう しました** (investigué a lo largo de tres años).",
     "@en": "It indicates that an action or situation covers a period or extension: substantive + **にわたって**. It does not necessarily mean that it will happen without interruption: **さんねん にわたって けんきゅう しました** (I investigated over three years)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "〜において: en (un lugar o ámbito)",
    "@en": "- において: in (a place or area)"
   },
   "texto": [
    {
     "@es": "Sitúa formalmente un acto, evento o asunto: sustantivo + **において**. Es más propio de informes y anuncios que de conversación: **かいぎ は 東京 において おこなわれました** (la reunión se celebró en Tokio).",
     "@en": "It formally places an act, event or subject: substantive + **において**. It is more typical of reports and announcements than of conversation: **かいぎ は 東京 において おこなわれました** (the meeting was held in Tokyo)."
    }
   ]
  },
  {
   "tipo": "tabla",
   "titulo": {
    "@es": "Formal: tiempo y lugar",
    "@en": "Formal: time and place"
   },
