   "titulo": {
    "@es": "Cómo se combinan",
    "@en": "How they combine"
   },
   "texto": [
    {
     "@es": "日 (sol) + 本 (origen) = **日本**, «el origen del sol»: Japón.",
     "@en": "日 (sun) + 本 (origin) = **日本**, «el origen del sol»: Japan."
    },
    {
     "@es": "Los días de la semana llevan 日 al final, y los meses, 月: **日曜日** (domingo), **七月** (julio).",
     "@en": "The days of the week have been 日 in the end, and the months, 月: **日曜日** (Sunday), **七月** (July)."
    },
    {
     "@es": "Los precios se escriben con 円: **五百円** (500 yenes).",
     "@en": "The prices are written with 円: **五百円** (500 yen)."
    }
   ]
