 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "わざわざ: expresamente",
    "@en": "わざわざ: expressly"
   },
   "texto": [
    {
     "@es": "Para señalar que alguien hizo un esfuerzo especial o se tomó la molestia: **わざわざ きて くれて、 ありがとう** (gracias por venir expresamente). Puede expresar agradecimiento o, según el tono, reproche.",
     "@en": "To point out that someone made a special effort or took the trouble: **わざわざ きて くれて、 ありがとう** (thank you for coming expressly). It can express thanks or, depending on the tone, reproach."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "わざと: a propósito",
    "@en": "わざと: by the way"
   },
   "texto": [
    {
     "@es": "Para decir que lo has hecho con intención: **わざと へんじ を しなかった** (no contesté a propósito).",
     "@en": "To say that you have done so with intent: **わざと へんじ を しなかった** (I did not answer on purpose)."
    },
    {
     "@es": "**つい** puede indicar que algo ocurrió sin proponérselo, pero no es un antónimo exacto de **わざと**.",
     "@en": "**つい** may indicate that something happened without proposing it, but it is not an exact antonym of **わざと**."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "つい: sin querer",
    "@en": "つい: unintended"
   },
   "texto": [
    {
     "@es": "Para decir que has hecho algo sin pretenderlo, y que lo lamentas: **つい ねすぎて しまいました** (me quedé dormido sin querer).",
     "@en": "To say that you have done something unintended, and that you regret it: **つい ねすぎて しまいました** (I fell asleep unintentionally)."
    },
    {
     "@es": "Suele usarse con 〜て しまう (lección 038).",
     "@en": "It is used with the て しまう (lesson 038)."
    }
   ]
  },
