    {
     "@es": "La negación en pasado es **ませんでした**: **たべませんでした** (no comí).",
     "@en": "The denial in the past is **ませんでした**: **たべませんでした** (I did not eat)."
    },
    {
     "@es": "Como siempre, la forma es la misma para todas las personas.",
     "@en": "As always, the form is the same for all people."
    }
   ]
  },
