   "tipo": "explicacion",
   "titulo": {
    "@es": "El pasado: ました",
    "@en": "The past: ました"
   },
   "texto": [
    {
     "@es": "Para el pasado, **ます** cambia a **ました**: **たべます** → **たべました** (comí, he comido).",
     "@en": "For the past, **ます** changes to **ました**: **たべます** → **たべました** (I ate, I ate)."
