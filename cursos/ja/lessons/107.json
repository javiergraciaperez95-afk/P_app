   "titulo": {
    "@es": "〜かもしれません: quizá",
    "@en": "♪ かもしれません ♪ Maybe ♪"
   },
   "texto": [
    {
     "@es": "Verbo en forma normal + **かも しれません** = quizá: **あした は あめ が ふる かも しれません** (quizá llueva mañana).",
     "@en": "Normal verb + **かも しれません** = maybe: **あした は あめ が ふる かも しれません** (maybe it rains tomorrow)."
    },
    {
     "@es": "Con **かも しれません** no estás seguro: hay posibilidades.",
     "@en": "With **かも しれません** you're not sure: there are possibilities."
    }
   ]
  },
  {
   "tipo": "explicacion",
