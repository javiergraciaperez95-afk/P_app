  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "〜つもり です: intención",
    "@en": "〜つもり です: intention"
   },
   "texto": [
    {
     "@es": "Para decir lo que piensas hacer, verbo en forma de diccionario + **つもり です**: **あう つもり です** (tengo intención de quedar).",
     "@en": "To say what you plan to do, I verb in the form of a dictionary + **つもり です**: **あう つもり です** (I intend to stay)."
    },
    {
     "@es": "Es tu intención personal, aunque todavía no esté fijada en el calendario.",
     "@en": "It is your personal intention, even if it is not yet set in the calendar."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "〜よてい です: plan fijado",
    "@en": "- よてい です: plan set"
   },
   "texto": [
    {
     "@es": "Para un plan ya decidido, con fecha o en la agenda: verbo en forma de diccionario + **よてい です**: **いく よてい です** (tengo planeado ir).",
     "@en": "For a plan already decided, with date or on the agenda: verb in dictionary + **よてい です**: **いく よてい です** (I plan to go)."
    },
    {
     "@es": "Suena a algo que ya está apuntado. Se dice **よてい が あります** (tengo un plan).",
     "@en": "Sounds like something that's already pointed out. It's called **よてい が あります** (I have a plan)."
