 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "〜ばかりに: por culpa de (arrepentimiento)",
    "@en": "- ばかりに: because of (repentance)"
   },
   "texto": [
    {
     "@es": "Para decir que una causa, normalmente una pequeña, provocó un resultado negativo: verbo en forma た + **ばかり に**: **かさ を わすれた ばかりに、 ぬれて しまいました** (por haber olvidado el paraguas, me mojé).",
     "@en": "To say that a cause, usually a small one, caused a negative result: verb in shape た + **ばかり に**: **かさ を わすれた ばかりに、 ぬれて しまいました** (for having forgotten the umbrella, I got wet)."
    },
    {
     "@es": "Expresa que lo lamentas.",
     "@en": "You're sorry."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "〜ばかりだ: cada vez más",
    "@en": "- ばかりだ: increasing"
   },
   "texto": [
    {
     "@es": "Para decir que algo sigue en aumento o en descenso: verbo en forma normal + **ばかり だ**: **ねだん は あがる ばかりだ** (los precios no paran de subir).",
     "@en": "To say that something is still on the rise or down: verb in normal form + **ばかり だ**: **ねだん は あがる ばかりだ** (prices are still rising)."
    },
    {
     "@es": "No es lo mismo que **〜た ばかり** (acabo de).",
     "@en": "It's not the same as **〜た ばかり** (I just)."
    }
   ]
  },
