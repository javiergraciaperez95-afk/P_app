 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "〜んです: es que…",
    "@en": "- んです: it's that"
   },
   "texto": [
    {
     "@es": "Se añade a una frase para dar contexto o explicar algo: **あたま が いたい んです** (es que me duele la cabeza). Con verbos y adjetivos en -i se usa la forma plana + **んです**.",
     "@en": "It is added to a sentence to give context or explain something: **あたま が いたい んです** (it is that my head hurts). With verbs and adjectives in -i the flat shape + **んです** is used."
    },
    {
     "@es": "Con un sustantivo o un adjetivo en -na se usa **なんです**: **がくせい なんです** (es que soy estudiante), **しずか なんです** (es que es tranquilo).",
     "@en": "With a noun or adjective in -na **なんです**: **がくせい なんです** (I am a student), **しずか なんです** (I am quiet) is used."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "〜んです en preguntas",
    "@en": "- んです in questions."
   },
   "texto": [
    {
     "@es": "**〜んですか** pide o introduce una explicación: **どうした んです か** (¿qué ha pasado?). En el habla informal puede decirse **どうした の？**.",
     "@en": "**〜んですか** requests or introduces an explanation: **どうした んです か** (what happened?). In informal speech, you can say **どうした の？**."
    },
    {
     "@es": "Con sustantivos y adjetivos en -na, recuerda **なの？** en la forma informal: **ひま なの？** (¿es que tienes tiempo libre?).",
     "@en": "With nouns and adjectives in -na, remember **なの？** in the informal form: **ひま なの？** (do you have free time?)."
    }
   ]
  },
