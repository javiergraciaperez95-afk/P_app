   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "〜と いいました: said that…",
     "texto": [
      "Put the sentence in the plain form and add **と いいました**: **やまだ さん は あした くる と いいました** (Yamada said they would come tomorrow).",
      "**と** marks where what someone said begins."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "〜と いっていました: had said that…",
     "texto": [
      "To report something someone said a while ago, use **と いっていました**: **けんじ さん は あした やすみ だ と いっていました** (Ken had said that tomorrow is a holiday).",
      "When you report it to another person in plain speech, the quoted sentence stays in the plain form."
     ],
     "tutora": ""
    },
