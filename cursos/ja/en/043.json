     ],
     "nota": "",
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Adding nuance",
     "texto": [
      "**とても** = very: **とても いい です** (it's very good).",
      "**ちょっと** = a bit: **ちょっと たかい です** (it's a bit expensive).",
      "**あまり** + negative = not very: **あまり たかく ない です** (it's not very expensive)."
     ],
