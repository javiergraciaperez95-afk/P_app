   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "«ずに» is equivalent to «ないで» in \"without doing\", but it is more typical of a written or careful register.",
     "texto": [
      "With する it's used as «せずに». Don't confuse it with «ずにはいられない», which means being unable to avoid doing something.",
      "あさごはん を たべず に、 いえ を でました。 (I left the house without having breakfast.)",
      "じゅうぶん に かくにん せず に、 しりょう を おくって しまいました。 (I sent the document without checking it properly.)"
     ],
