   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "«やっと»: at last (with effort)",
     "texto": [
      "To say something arrives after a long wait or effort: **やっと しけん が おわった** (the exam finally ended).",
      "It's used when what was expected has cost effort."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "«ついに»: in the end",
     "texto": [
      "To mark that something finally happened after waiting: **ついに ゆめ が かなった** (my dream finally came true). It can be used for positive or negative results."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "«とうとう»: finally (something unwanted or inevitable)",
     "texto": [
      "To say something ended up happening after a process or a wait: **とうとう にほん へ いく こと に なりました** (it was finally decided that I would go to Japan). The tone depends on the context."
     ],
     "tutora": ""
    },
