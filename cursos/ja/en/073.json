   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Asking permission: 〜てもいいです",
     "texto": [
      "**〜て + も いい です** = it's OK to / I may.",
      "To ask: **しゃしん を とって も いい です か** (may I take photos?). To answer yes: **はい、 いい です** (yes, it's OK)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Prohibiting: 〜てはいけません",
     "texto": [
      "**〜て + は いけません** = you must not / it's not permitted.",
      "**さわって は いけません** (you must not touch). It's a more direct prohibition than **〜ないでください**, which asks someone not to do something."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Allowed and not allowed",
