   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "«だけ» means \"only\" and can go with an affirmative; «しか» requires a negative form.",
     "texto": [
      "水だけ飲みました: I only drank water. 水しか飲みませんでした: I drank nothing but water. しか doesn't mean \"only\" without the verb negation.",
      "みず だけ のみました。 (I only drank water.)",
      "みず しか のみません でした。 (I drank nothing but water.)"
     ],
