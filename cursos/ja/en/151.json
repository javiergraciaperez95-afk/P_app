   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "«にもかかわらず» expresses that the result happens despite the earlier condition.",
     "texto": [
      "It can follow a noun with の, a plain form or a quantity. It has a more written tone than «ても».",
      "あめ にも かかわらず、 こうえん は にぎわって いました。 (Despite the rain, the park was lively.)",
      "ねむかった にも かかわらず、 さいご まで ほん を よみました。 (Despite being sleepy, I read the book to the end.)"
     ],
