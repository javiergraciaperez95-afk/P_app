   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "When something happens",
     "texto": [
      "Put the verb phrase before the keyword. **いく とき** = when I go; **たべた とき** = when I ate.",
      "With **とき** the verb takes the dictionary or past form. You'll see that the meaning depends on the keyword, not the verb."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Before and after",
     "texto": [
      "**〜まえに** = before. It goes with the dictionary form of the verb: **ねる まえに** (before sleeping).",
      "**〜あと で** = after. It goes with the past form of the verb: **たべた あと で** (after eating)."
     ],
     "tutora": ""
    },
