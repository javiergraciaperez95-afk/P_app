   "piezas": [
    {
     "tipo": "texto",
     "titulo": "A school notice",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "学校 は、町 に 大雨 の 警報 が 発表された 場合、授業 を どうする か 保護者 に 連絡する。",
       "alumno": "If a heavy rain alert is announced in the town, the school will inform families what will happen with classes.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "警報 が 出た なら、子ども を 学校 へ 送らず、安全な 場所 で 待って ください。",
       "alumno": "If an alert has been issued, don't take the children to school; wait in a safe place.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "雨 が やんだ としても、川 に 近づいて は いけない。",
       "alumno": "Even if the rain stops, don't go near the river.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "運動場 に 水 が 残っている なら、午後 の 活動 は 中止する。",
       "alumno": "If water remains on the playground, the afternoon activities will be cancelled.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "たとえ 空 が 明るく なっても、学校 は 安全 を 確認してから 判断する。",
       "alumno": "Even if the sky clears, the school will decide after checking that it is safe.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
