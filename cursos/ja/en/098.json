   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "ても means «even if / even though» and says the condition does not prevent the result.",
     "texto": [
      "With verbs use the て form + も; with adjectives and nouns the corresponding form changes. Contrast with たら, which doesn't by itself express concession.",
      "あめ が ふって も、 さんぽ します。 (Even if it rains, I'll go out for a walk.)",
      "たかくて も、この くつ を かいます。 (Even if it's expensive, I'll buy these shoes.)"
     ],
     "tutora": ""
    }
   ]
  },
