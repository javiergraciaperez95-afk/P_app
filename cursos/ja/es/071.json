       {
        "texto": "Grupo 2: -eru / -iru",
        "lengua": "alumno"
       },
       {
        "texto": "quitan る y añaden て",
        "lengua": "alumno"
       },
       {
        "texto": "たべる (comer) → たべて",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Irregulares",
        "lengua": "alumno"
       },
       {
        "texto": "hay que memorizarlos",
        "lengua": "alumno"
       },
       {
        "texto": "する → して; くる → きて; いく → いって",
