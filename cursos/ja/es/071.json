        "lengua": "alumno"
       },
       {
        "texto": "cambian a いて",
        "lengua": "alumno"
       },
       {
        "texto": "かく (escribir) → かいて",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Grupo 1: acaban en ぐ",
        "lengua": "alumno"
       },
