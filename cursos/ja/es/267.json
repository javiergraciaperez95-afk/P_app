   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Una visita de voluntarios",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "先月、地域 の ボランティア が 被災地 の 村 を 訪れた。",
       "alumno": "El mes pasado, voluntarios de la zona visitaron una aldea afectada por un desastre.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "予定していた 家 を すべて 回る つもりだった が、雨 の あと 道路 が 通行止め に なり、最後 の 一軒 に は 行けず じまい だった。",
       "alumno": "Pensaban visitar todas las casas previstas, pero después de la lluvia cerraron la carretera y al final no pudieron llegar a la última.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "その 家 の 人 は、玄関 に 置いた 荷物 を 片付けない まま、避難所 で 生活していた。",
       "alumno": "La familia vivía en el refugio sin haber recogido las cosas que dejó en la entrada.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "ボランティア は 住民 の 希望 を 聞いた うえで、必要な 物 を 届けた。",
       "alumno": "Tras escuchar las peticiones de los residentes, los voluntarios llevaron los artículos necesarios.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "活動 の あと、参加者 は「一度 では 終わらない。支援 を 続けたい」と 話した。",
       "alumno": "Al terminar la actividad, los participantes dijeron: «Esto no acaba con una sola visita. Queremos seguir ayudando».",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
