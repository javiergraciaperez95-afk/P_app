   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Aviso de una escuela",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "学校 は、町 に 大雨 の 警報 が 発表された 場合、授業 を どうする か 保護者 に 連絡する。",
       "alumno": "Si se anuncia una alerta de lluvia intensa en la ciudad, la escuela avisará a las familias de qué ocurrirá con las clases.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "警報 が 出た なら、子ども を 学校 へ 送らず、安全な 場所 で 待って ください。",
       "alumno": "Si se ha emitido una alerta, no lleven a los niños a la escuela; esperen en un lugar seguro.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "雨 が やんだ としても、川 に 近づいて は いけない。",
       "alumno": "Aunque deje de llover, no se acerquen al río.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "運動場 に 水 が 残っている なら、午後 の 活動 は 中止する。",
       "alumno": "Si queda agua en el patio, se cancelarán las actividades de la tarde.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "たとえ 空 が 明るく なっても、学校 は 安全 を 確認してから 判断する。",
       "alumno": "Incluso si el cielo se despeja, la escuela decidirá después de comprobar que es seguro.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
