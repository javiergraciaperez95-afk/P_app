    {
     "tipo": "texto",
     "titulo": "Một chuyên mục bình luận",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "駅前 の 公園 を なくして 駐車場 を 作る 案 を めぐって、市民 の 意見 が 分かれている。",
       "alumno": "Ý kiến của người dân thành phố đang bị chia rẽ xoay quanh đề xuất bỏ công viên trước nhà ga và xây bãi đỗ xe.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "商店 の 人 は 車 で 来る 客 が 増える と 期待する が、近く の 住民 は 緑 が 減る こと を 心配している。",
       "alumno": "Những người buôn bán kỳ vọng số khách đến bằng ô tô sẽ tăng lên, nhưng cư dân gần đó lo rằng khu cây xanh sẽ giảm đi.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "市 の 調査 では、車 を 使う 人 より 徒歩 や バス を 利用する 人 の ほう が 多かった。",
       "alumno": "Theo khảo sát của thành phố, số người đi bộ hoặc đi xe buýt đã nhiều hơn số người sử dụng ô tô.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "この 数字 だけ で 結論 を 出す の では なく、住民 と 商店 の 両方 から 話 を 聞く 必要 が ある。",
       "alumno": "Không nên đi đến kết luận chỉ dựa trên những con số này; cần lắng nghe cả cư dân lẫn người buôn bán.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
