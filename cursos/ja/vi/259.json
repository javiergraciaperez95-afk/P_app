   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Một đêm ở nhà ga",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "終電 の 時間 が 近づく と、駅員 は 改札 の 前 で 乗客 に 注意を 呼びかけた。",
       "alumno": "Khi gần đến giờ chuyến tàu cuối, nhân viên nhà ga nhắc hành khách trước cổng soát vé.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "友人 は 表示 を 確かめない うち に 反対側 の ホーム へ 行ってしまった。",
       "alumno": "Bạn tôi đi sang sân ga phía đối diện trước khi kịp kiểm tra bảng hiển thị.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "発車 まで 時間 が なかった ので、私 は 急いで 案内板 を 見た。",
       "alumno": "Vì còn ít thời gian đến giờ khởi hành, tôi vội nhìn bảng chỉ dẫn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "電車 が 出てしまわない うち に、駅員 が 正しい ホーム を 教えてくれた。",
       "alumno": "Trước khi tàu rời đi, nhân viên nhà ga đã chỉ cho tôi sân ga đúng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "私たち は 無事 に 乗れた が、友人 は「説明 を 聞いた か と 思ったら、もう 電車 が 来た」と 笑った。",
       "alumno": "Chúng tôi lên tàu được an toàn, và bạn tôi cười: «Vừa tưởng nghe xong lời giải thích thì tàu đã đến rồi».",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
