   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Ghi chú của một buổi triển lãm",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "この 町 には、百年以上前 に 建てられた 駅舎 が 残っている。",
       "alumno": "Tại thị trấn này còn giữ được một tòa nhà nhà ga được xây hơn một trăm năm trước.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "建物 を 見る と、人々 の 暮らし は 時代 と ともに 変わる ものだ と 感じる。",
       "alumno": "Khi nhìn tòa nhà, người ta cảm thấy đời sống của con người thay đổi theo thời gian.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "学芸員 は「古い 物 を すぐ 捨てる ものではない」と 話した。",
       "alumno": "Cán bộ bảo tàng cho biết: «Không nên vứt ngay những đồ vật cũ».",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "修理 を 続けた 結果、今年 から 駅舎 の 一部 が 展示室 に なった。",
       "alumno": "Sau khi tiếp tục sửa chữa, từ năm nay một phần nhà ga đã trở thành phòng trưng bày.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "訪問者 は 当時 の 写真 を 見て、町 の 変化 を 記録する こと の 大切さ に 気づいた。",
       "alumno": "Khi xem những bức ảnh thời đó, khách tham quan đã nhận ra tầm quan trọng của việc ghi chép lại những thay đổi của thị trấn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
