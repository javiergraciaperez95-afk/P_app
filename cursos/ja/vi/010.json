   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Mẫu câu cơ bản: A は B です",
     "texto": [
      "Hầu như mọi điều bạn nói ở đầu đều theo khuôn này: **A は B です** (A là B).",
      "**は** là trợ từ đánh dấu **điều được nói đến** (chủ đề). Ở đây đọc là **wa**.",
      "**です** nghĩa là «là»: luôn đứng cuối và **không đổi** theo người. Đọc là «des», gần như không có âm u.",
      "**わたし は アンナ です** = Tôi là Anna. Từng từ một: «tôi — về phần — Anna — là»."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Mẫu câu để giới thiệu bản thân",
     "texto": [
      "**はじめまして** được nói lần đầu bạn gặp ai đó.",
      "Khi kết thúc phần giới thiệu: **よろしく おねがいします** (nghĩa đen là «tôi xin được đối đãi tốt»). Đây là câu không thể thiếu.",
      "Khi nói về người khác thì thêm **さん** sau tên: **たなか さん** (ông hoặc bà Tanaka). **Không bao giờ** gắn nó cho chính mình.",
      "Để chỉ quốc tịch, thêm **じん** vào sau tên nước: スペイン → **スペインじん** (người Tây Ban Nha), にほん → **にほんじん** (người Nhật)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Bạn đến từ đâu",
     "texto": [
      "**スペイン から きました** = tôi đến từ Tây Ban Nha. **から** là trợ từ «từ, từ...».",
      "Để hỏi tên một cách lịch sự: **おなまえ は？** (Tên của ngài là gì?)."
     ],
     "tutora": ""
    }
   ]
