    {
     "tipo": "texto",
     "titulo": "Thông báo của ủy ban thành phố",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "市 は 台風 の 前 に 避難所 を 開ける 予定 だ。",
       "alumno": "Thành phố dự kiến mở nơi sơ tán trước khi bão đến.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "担当者 は 設備 を 確認している が、実際 に 動かしてみない ことには 問題 が 分からない。",
       "alumno": "Người phụ trách kiểm tra thiết bị, nhưng nếu không vận hành thử thì không thể phát hiện được vấn đề.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "点検 が 終わり次第、職員 は 住民 に 避難所 を 案内する。",
       "alumno": "Ngay khi kiểm tra xong, nhân viên sẽ hướng dẫn cư dân đến nơi sơ tán.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "準備 の 速さ は 職員 の 人数 次第 で 変わる。",
       "alumno": "Tốc độ chuẩn bị phụ thuộc vào số lượng nhân viên.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "市 は 安全 を 確認してから、開設 の 時間 を 発表する。",
       "alumno": "Sau khi kiểm tra rằng an toàn, thành phố sẽ công bố giờ mở cửa.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
