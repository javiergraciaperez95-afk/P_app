 "etapas": [
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Một chuyến thăm của tình nguyện viên",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "先月、地域 の ボランティア が 被災地 の 村 を 訪れた。",
       "alumno": "Tháng trước, tình nguyện viên ở địa phương đã thăm một làng bị thiên tai.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "予定していた 家 を すべて 回る つもりだった が、雨 の あと 道路 が 通行止め に なり、最後 の 一軒 に は 行けず じまい だった。",
       "alumno": "Họ định thăm mọi ngôi nhà đã dự kiến, nhưng sau mưa, đường bị đóng và cuối cùng không đến được ngôi nhà cuối.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "その 家 の 人 は、玄関 に 置いた 荷物 を 片付けない まま、避難所 で 生活していた。",
       "alumno": "Gia đình ấy vẫn sống ở nơi trú ẩn mà chưa dọn những đồ đã để ở lối vào.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "ボランティア は 住民 の 希望 を 聞いた うえで、必要な 物 を 届けた。",
       "alumno": "Sau khi lắng nghe đề nghị của cư dân, tình nguyện viên đã mang đến những đồ cần thiết.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "活動 の あと、参加者 は「一度 では 終わらない。支援 を 続けたい」と 話した。",
       "alumno": "Sau hoạt động, người tham gia nói: 「一度 では 終わらない。支援 を 続けたい」 (Không thể kết thúc chỉ trong một lần. Chúng tôi muốn tiếp tục hỗ trợ.)",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
