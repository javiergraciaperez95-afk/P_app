 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Ôn tập cuối trình độ B1",
     "texto": [
      "Ba mươi câu hỏi về những chương 21 đến 30. Kết quả 24/30 cho thấy bạn nắm vững những nội dung này, nhưng riêng bài kiểm tra này không chứng nhận được trình độ B1.",
      "Mỗi câu hỏi cho biết chương của nó, để bạn biết cần ôn lại phần nào."
     ],
     "tutora": ""
    }
   ]
  },
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Chương 21–30. Một chuyến đi chơi trong mưa",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "週末、友達 と 山 へ 行く 予定 でした が、朝 から 雨 が 降って いました。友達 は「雨 でも 行ける んじゃないか」と 言いました。山 の 道 は ぬれていて 危ない ので、私たち は 駅 の 近く の 博物館 に 行きました。帰り に、友達 は「予定 を 変えた おかげで、新しい 展示 を 見られた」と 喜びました。",
       "alumno": "Cuối tuần tôi định đi núi cùng một người bạn, nhưng từ sáng trời đã mưa. Bạn tôi nói: «Mưa cũng đi được chứ nhỉ?». Vì đường lên núi ướt và nguy hiểm, chúng tôi đến một bảo tàng gần nhà ga. Trên đường về, bạn tôi vui mừng và nói: «Nhờ đổi kế hoạch mà chúng ta đã xem được một buổi trưng bày mới».",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
