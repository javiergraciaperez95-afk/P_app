   "etapa": "leer",
   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Thông báo của một trường học",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "学校 は、町 に 大雨 の 警報 が 発表された 場合、授業 を どうする か 保護者 に 連絡する。",
       "alumno": "Nếu thành phố công bố cảnh báo mưa lớn, nhà trường sẽ thông báo cho phụ huynh về việc sẽ làm gì với giờ học.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "警報 が 出た なら、子ども を 学校 へ 送らず、安全な 場所 で 待って ください。",
       "alumno": "Nếu cảnh báo đã được phát ra, đừng đưa trẻ em đến trường; hãy chờ ở nơi an toàn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "雨 が やんだ としても、川 に 近づいて は いけない。",
       "alumno": "Dù mưa đã tạnh, cũng không được tiến lại gần sông.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "運動場 に 水 が 残っている なら、午後 の 活動 は 中止する。",
       "alumno": "Nếu nước vẫn còn đọng trên sân, những hoạt động buổi chiều sẽ bị hủy.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "たとえ 空 が 明るく なっても、学校 は 安全 を 確認してから 判断する。",
       "alumno": "Dù bầu trời sáng hơn, nhà trường vẫn sẽ quyết định sau khi xác nhận là an toàn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
