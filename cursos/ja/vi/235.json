     "tipo": "texto",
     "titulo": "Báo cáo của một thư viện",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "図書館 は 先月、予約 の 新しい システム を 導入した。",
       "alumno": "Tháng trước, thư viện đã đưa vào một hệ thống đặt chỗ mới.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "その 結果、利用者 の 待ち時間 は 前より 短く なった。",
       "alumno": "Kết quả là thời gian chờ của người dùng đã ngắn hơn trước.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "便利 に なった ものの、高齢者 から は 操作 が 難しい という 意見 も 出ている。",
       "alumno": "Dù dịch vụ đã trở nên tiện lợi hơn, một số người cao tuổi nhận định rằng thao tác khó.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "職員 は 説明 の 方法 を 改善している が、すべて の 人 に 簡単 とは いえない。",
       "alumno": "Nhân viên đang cải thiện cách giải thích, nhưng không thể nói rằng nó đơn giản với mọi người.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "新しい 道具 を 入れる だけ では 十分 では なく、使う 人 の 状況 に 合わせる こと が 必要 だ。",
       "alumno": "Chỉ đưa vào một công cụ mới thì chưa đủ; cần điều chỉnh cho phù hợp với hoàn cảnh của người sử dụng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
