  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Một đề xuất giao thông",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "市役所 は、駅前 の 交通量 を 調べる ため、春 から 三か月 にわたって 車 と バス の 数 を 記録した。",
       "alumno": "Để nghiên cứu giao thông trước nhà ga, tòa thị chính đã ghi chép trong ba tháng số lượng xe hơi và xe buýt, từ mùa xuân.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "調査結果 を もとに、朝 の 通勤時間 に バス の 路線 を 一つ 増やす 計画 を 作った。",
       "alumno": "Dựa trên kết quả, tòa thị chính đã lập kế hoạch thêm một tuyến xe buýt vào giờ đi làm buổi sáng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "しかし、調査 は 駅 を 使う 人 を 主な 対象 に しており、近く に 住む 人 の 意見 は 十分 に 集められていない。",
       "alumno": "Tuy nhiên, cuộc khảo sát chủ yếu tập trung vào những người dùng nhà ga, và chưa thu thập đủ ý kiến của người dân sống gần đó.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "変更 に あたって、市役所 は 住民 に 意見 を 募集した。",
       "alumno": "Khi thực hiện thay đổi, tòa thị chính đã kêu gọi ý kiến của người dân.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "路線 の 開始 に 際して、駅 に 案内板 を 設置する 予定 だ。",
       "alumno": "Khi tuyến bắt đầu, dự kiến sẽ lắp đặt bảng chỉ dẫn tại nhà ga.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
