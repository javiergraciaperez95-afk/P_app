     "titulo": "Bài đọc 1: báo cáo về đặt chỗ",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "図書館 の 新しい 予約 システム は、利用者 の 待ち時間 を 短くした。",
       "alumno": "Hệ thống đặt chỗ mới của thư viện đã rút ngắn thời gian chờ của người sử dụng.",
