       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "調査結果 を もとに、朝 の バス路線 を 一つ 増やした。",
       "alumno": "Dựa trên kết quả, thành phố đã bổ sung một tuyến xe buýt buổi sáng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
