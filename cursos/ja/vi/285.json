   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Một sáng kiến địa phương",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "この 町 では、若者 が 町 を 離れつつあり、商店街 の 店 も 少しずつ 減っている。",
       "alumno": "Ở thị trấn này, thanh niên đang rời đi, và những cửa hàng ở phố buôn bán cũng dần giảm đi.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "市 は 地元 の 企業 と 協力して、夜間 の 職業講座 を 始めた。",
       "alumno": "Tòa thị chính đã phối hợp với những doanh nghiệp địa phương để bắt đầu những khóa đào tạo nghề buổi tối.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "参加者 は 仕事 の かたわら、週 に 二回、地域 の 教室 で 技術 を 学ぶ。",
       "alumno": "Người tham gia học kỹ thuật ở một lớp học địa phương hai buổi mỗi tuần, ngoài công việc của họ.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "責任者 は「この 講座 だけ で 町 の 問題 が すべて 解決する とは 言う まい。仕事 を しながら 学べる 場所 は 必要 だ」と 説明した。",
       "alumno": "Người phụ trách giải thích: «Tôi sẽ không khẳng định rằng riêng khóa học này sẽ giải quyết mọi vấn đề của thị trấn. Cần những nơi để người ta vừa làm việc vừa học được.»",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "一年後、参加者 の 一部 は 地元 の 会社 で 働き始めた。",
       "alumno": "Một năm sau, một phần người tham gia đã bắt đầu làm việc tại những công ty địa phương.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
