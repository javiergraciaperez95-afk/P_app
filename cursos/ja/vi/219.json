   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Một dự án của thành phố",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "町 の 図書館 を どこ に 建てる か、長い 間 意見 が 分かれていた。",
       "alumno": "Trong thời gian dài, ý kiến đã chia rẽ về việc nên xây thư viện của khu phố ở đâu.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "駅 の 近く は 便利 だが、土地 の 値段 が 高い。",
       "alumno": "Gần ga thì tiện lợi, nhưng mặt bằng đắt đỏ.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "公園 の となり を 選ぶ 人 も いた ものの、近所 の 人 は 静かな 場所 を 守りたい と 考えた。",
       "alumno": "Tuy một số người chọn sát công viên, dân khu phố lại muốn giữ một địa điểm yên tĩnh.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "何度も 話し合った あげく、古い 学校 を 直して 使う こと に なった。",
       "alumno": "Sau khi bàn bạc nhiều lần, cuối cùng họ quyết định sửa lại và sử dụng ngôi trường cũ.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "時間 は かかった が、みんな の 意見 を 聞いた だけに、今 の 場所 に 満足している 人 が 多い。",
       "alumno": "Tốn thời gian, nhưng vì đã lắng nghe ý kiến của mọi người, nên nhiều người hài lòng với địa điểm đã chọn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
