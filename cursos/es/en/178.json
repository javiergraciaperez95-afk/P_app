   "pron": "ber-DAD",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The «v» sounds like b: «ber-DAD». Many words ending in «-dad» are feminine.",
   "nota": "",
   "oculta": false
  },
  {
