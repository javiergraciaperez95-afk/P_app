   "significado": "headlines",
   "pron": "ti-tu-LA-res",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "Plural of «titular». The stress falls on «LA»: «ti-tu-LA-res».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "verdad",
