   "pron": "TAN-ta",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It changes with the noun: «tanto ruido», «tanta publicidad», «tantos anuncios».",
