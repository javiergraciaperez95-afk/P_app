   "pron": "sin-THE-ro",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It changes with gender: «sincero», «sincera». The noun is «la sinceridad».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "paciente",
   "significado": "patient",
   "pron": "pa-THYEN-te",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It works for a boy and for a girl: «un chico paciente», «una chica paciente».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "impaciente",
   "significado": "impatient",
   "pron": "im-pa-THYEN-te",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is the opposite of «paciente». Before p, the prefix in- is written im-.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "inseguro",
   "significado": "insecure",
   "pron": "in-se-GU-ro",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is «seguro» with the prefix in-, which gives the opposite meaning: «seguro», «inseguro».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "introvertido",
   "significado": "introverted",
   "pron": "in-tro-ber-TI-do",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
