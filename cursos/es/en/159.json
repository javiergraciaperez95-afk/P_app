   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "The accent shows the stress: ca-RÁC-ter. In the plural the stress moves: «caracteres», ca-rac-TE-res.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "sincero",
