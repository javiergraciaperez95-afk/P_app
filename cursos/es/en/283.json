 "titulo": {
  "estudio": "Las tildes",
  "alumno": "Written accents"
 },
 "intro": "Three rules explain almost every written accent in Spanish.",
 "palabras": [
  {
   "palabra": "tilde",
   "significado": "written accent mark",
   "pron": "TIL-de",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The tilde marks the syllable that sounds strongest. It is also called «acento escrito» or «acento ortográfico».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "sílaba",
   "significado": "syllable",
   "pron": "SI-la-ba",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "«Pa-pel» has two syllables. The syllable that sounds strongest is called the stressed syllable.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "aguda",
   "significado": "oxytone word (stressed on the last syllable)",
   "pron": "a-GU-da",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It takes a tilde if it ends in a vowel, n or s: «café», «jamón», «inglés». «Reloj» does not.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "llana",
   "significado": "paroxytone word (stressed on the second-to-last syllable)",
   "pron": "YA-na",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It takes a tilde if it does NOT end in a vowel, n or s: «árbol», «fácil», «lápiz». «Casa» does not. The ll sounds like y.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "esdrújula",
   "significado": "proparoxytone word (stressed on the third-to-last syllable)",
   "pron": "es-DRU-hu-la",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "All proparoxytone words take a tilde, with no exception: «médico», «teléfono», «sábado».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "árbol",
   "significado": "tree",
   "pron": "AR-bol",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It is paroxytone and ends in l, so it takes a tilde. Its plural, «árboles», takes one too.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "él",
   "significado": "he",
   "pron": "el",
   "ipa": "",
   "cat": "pronoun",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "With a tilde it is the pronoun «he». Without a tilde, «el» is the article: «el libro».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "sí",
   "significado": "yes",
   "pron": "si",
   "ipa": "",
   "cat": "adverb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "With a tilde it is «yes»; without it, «si» is «if». Compare: «sí, voy» and «si vienes».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "más",
   "significado": "more",
   "pron": "mas",
   "ipa": "",
   "cat": "adverb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "With a tilde it means «more»: «más café». Without it, «mas» is «but», an old-fashioned word.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "té",
   "significado": "tea",
   "pron": "te",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "With a tilde it is the drink. Without it, «te» is a pronoun: «te espero». It rhymes with «bebé».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "país",
   "significado": "country",
   "pron": "pa-IS",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "The tilde falls on the í, which sounds strong and separates from the a: «pa-ÍS», two syllables.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "lápiz",
   "significado": "pencil",
   "pron": "LA-pith",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It is paroxytone and ends in z, so it takes a tilde. In the plural the z becomes c: «lápices».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "vocal",
   "significado": "vowel",
   "pron": "bo-KAL",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "In Spanish the «v» sounds like «b», so «vocal» is pronounced «bo-KAL», stressed on the end.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "consonante",
   "significado": "consonant",
   "pron": "kon-so-NAN-te",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "Ends in «-nte», so the stress falls on the «NAN», the third syllable.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "artículo",
   "significado": "article (the, a)",
   "pron": "ar-TI-ku-lo",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It has an accent on the «TI», the stressed syllable, so it is a word with a tilde.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "nombra",
   "significado": "names (nombrar)",
   "pron": "NOM-bra",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «nombre», name. Here the verb means to name or mention something.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "bebida",
   "significado": "drink",
   "pron": "be-BI-da",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "From «beber». The «b» and the «v» sound the same in Spanish, so «bebida» has two «b» sounds.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "regla",
   "significado": "rule",
   "pron": "RRE-gla",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "A word that starts with «r» sounds strong here: «RRE-gla», with a rolled r at the beginning.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "llanas",
   "significado": "paroxytone (stressed on the second-to-last syllable)",
   "pron": "YA-nas",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The «ll» sounds like a «y» in most of Spain: «YA-nas», with the stress on the first syllable.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "justa",
   "significado": "right, exact (fair)",
   "pron": "HUS-ta",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The «j» sounds like an English «h», so «justa» sounds like «HUS-ta».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "maestra",
   "significado": "teacher (female)",
   "pron": "ma-ES-tra",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The masculine is «maestro». The «-a» ending marks the feminine, so «maestra» is for a woman.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "frunce",
   "significado": "frowns (fruncir)",
   "pron": "FRUN-the",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Before «e» the «c» sounds like «th» in Spain: «FRUN-the», so «fruncir» is pronounced «frun-THIR».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "manchados",
   "significado": "stained (plural, masculine)",
   "pron": "man-CHA-dos",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «manchar», to stain. Here it describes the fingers and ends in «-dos», plural.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "dudan",
   "significado": "they hesitate (dudar)",
   "pron": "DU-dan",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «duda», doubt. The «d» at the start is soft, almost like an English «th».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "ante",
   "significado": "before, in front of",
   "pron": "AN-te",
   "ipa": "",
   "cat": "preposition",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "A short word that means «in front of». It is not the same as «antes», which means «before» in time.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "rectángulo",
   "significado": "rectangle",
   "pron": "rek-TAN-gu-lo",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "Its stress falls on the «TAN». The tilde marks it, and «rec-» comes from «recto», straight.",
   "nota": "",
   "oculta": false
  }
 ],
