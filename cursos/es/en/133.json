   "significado": "probably; surely",
   "pron": "se-gu-ra-MEN-te",
   "ipa": "",
   "cat": "adverb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It does not mean «with total certainty»: it is closer to «probably».",
   "nota": "",
   "oculta": false
  },
