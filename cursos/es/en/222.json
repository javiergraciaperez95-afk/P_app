 "intro": "Verb phrases that add a shade of meaning: a sudden start, a slow process, an ending, a result.",
 "palabras": [
  {
   "palabra": "voy entendiendo",
   "significado": "I am gradually understanding",
   "pron": "boi en-ten-DYEN-do",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Ir» + gerund marks a slow process: «voy mejorando», «va oscureciendo».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "llevo leídos",
   "significado": "I have read so far",
   "pron": "YE-bo le-I-dos",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Llevar» + participle counts what is done so far and agrees: «llevo leídas diez páginas».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "acaba perdonándolo",
   "significado": "he/she ends up forgiving him",
   "pron": "a-KA-ba per-do-NAN-do-lo",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Acabar» + gerund is to end up doing something. It is not «acabar de», which means «a moment ago».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "llegó a escribir",
   "significado": "he/she went so far as to write",
   "pron": "ye-GO a es-kri-BIR",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Llegar a» + infinitive marks an extreme point: «llegó a gritar». The ll sounds y.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "me puse a leer",
   "significado": "I started reading",
   "pron": "me PU-se a le-ER",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Ponerse a» + infinitive is to start suddenly: «se puso a llover».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "se echa a llorar",
   "significado": "he/she bursts into tears",
   "pron": "se E-cha a yo-RAR",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Echarse a» is used with reír, llorar and correr: «se echó a reír». It is an abrupt start.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "tengo hecha",
   "significado": "I have (it) done",
   "pron": "TEN-go E-cha",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Tener» + participle gives the result: «tengo hecha la cena». The participle agrees with the thing done.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "vengo diciendo",
   "significado": "I have been saying (for some time)",
   "pron": "BEN-go di-THYEN-do",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Venir» + gerund: an action that lasts up to now. «Vengo diciéndolo desde hace años».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "anda buscando",
   "significado": "he/she is going around looking for",
   "pron": "AN-da bus-KAN-do",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Andar» + gerund: a repeated action with no fixed course: «anda buscando trabajo».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "poco a poco",
