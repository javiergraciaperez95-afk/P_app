   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is the imperfect subjunctive of «haber». With a participle it forms «si hubiera sabido». The h is silent.",
   "nota": "",
   "oculta": false
  },
