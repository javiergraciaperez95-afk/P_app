 "intro": "Compare three fictional versions of the same local news item and notice regional vocabulary and forms of address.",
 "palabras": [
  {
   "palabra": "variedad",
   "significado": "variety",
   "pron": "ba-rye-DAD",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "Spanish has many varieties. It is written with v and sounds like b: «ba-rye-DAD».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "ustedes",
   "significado": "you (plural)",
   "pron": "us-TE-des",
   "ipa": "",
   "cat": "pronoun",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It does not always indicate respect. In the Americas it is also used among friends and family.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "vosotros",
   "significado": "you (plural, informal, Spain)",
   "pron": "bo-SO-tros",
   "ipa": "",
   "cat": "pronoun",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It has its own forms: «vosotros habéis». In the Americas it is hardly used.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "autobús",
   "significado": "bus",
   "pron": "au-to-BUS",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It is the most general word. In Mexico you also hear «camión» and in Argentina, «colectivo».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "línea",
   "significado": "route, line",
   "pron": "LI-ne-a",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "You say «la línea 5». It has a tilde on the í: «LI-ne-a».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "colectivo",
   "significado": "city bus (Argentina)",
   "pron": "ko-lek-TI-bo",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "In Argentina «el colectivo» is the city bus. In other countries it means something else.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "parada",
   "significado": "bus stop",
   "pron": "pa-RA-da",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It comes from «parar». You say «la parada de autobús». It is feminine.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "ayuntamiento",
   "significado": "town council, town hall",
   "pron": "a-yun-ta-MYEN-to",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "The y of «ayuntamiento» sounds as in «yo»: «a-yun-ta-MYEN-to». It is widely used in local news.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "aviso",
   "significado": "notice",
   "pron": "a-BI-so",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It is written with v and sounds b. You say «un aviso» and «dar aviso».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "ruta",
   "significado": "route",
   "pron": "RRU-ta",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It is almost a synonym of «línea». The initial r sounds strong: «RRU-ta».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "abrieron",
   "significado": "opened (abrir)",
   "pron": "a-BRYE-ron",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «abrir», to open. The «v» is not here, but «ie» forms a diphthong «bryé».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "inauguraron",
   "significado": "inaugurated (inaugurar)",
   "pron": "i-nau-gu-RA-ron",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «inaugurar», to open officially. The «au» is a diphthong, read as one sound.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "probamos",
   "significado": "we tried (probar)",
   "pron": "pro-BA-mos",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «probar», to try. The «-amos» ending is the past for «nosotros».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "probaste",
   "significado": "you tried (probar)",
   "pron": "pro-BAS-te",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «probar». The «-aste» ending is the past for «tú», and with «vos» it is «probaste» too.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "apilan",
   "significado": "they pile up (apilar)",
   "pron": "a-PI-lan",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «pila», a pile. The «-an» ending is for «ellos» or «ellas».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "marquesina",
   "significado": "bus shelter, canopy",
   "pron": "mar-ke-SI-na",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "From «marquesa», a canopy. The «-ina» at the end names a shelter, like at a bus stop.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "callejero",
   "significado": "stray, of the street",
   "pron": "ka-ye-HE-ro",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «calle», street. A «perro callejero» is a dog that lives on the street.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "olfatea",
   "significado": "sniffs (olfatear)",
   "pron": "ol-fa-TE-a",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «olfato», sense of smell. Dogs «olfatean» to find things with their nose.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "tiñe",
   "significado": "tints, dyes (teñir)",
   "pron": "TI-nye",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «teñir», to dye or tint. The «ñ» is pronounced like «ny» in «canyon».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "faros",
   "significado": "headlights",
   "pron": "FA-ros",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "Plural of «faro». It also means lighthouse, but for cars it means headlights.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "encendidos",
   "significado": "lit, on (plural)",
   "pron": "en-then-DI-dos",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «encender», to switch on. The masculine plural agrees with «faros».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "goma",
   "significado": "rubber",
   "pron": "GO-ma",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "Rubber, like the material of tyres or an eraser. The «g» before «o» is hard.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "transporte",
   "significado": "transport",
   "pron": "trans-POR-te",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "From «transportar», to carry. The stress falls on «POR», the second syllable.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "textos",
   "significado": "texts",
   "pron": "TEKS-tos",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "Plural of «texto». The «x» sounds «ks», as in «texto».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "muestran",
   "significado": "they show (mostrar)",
   "pron": "MWES-tran",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «mostrar», to show. The «ue» forms a diphthong, read «we».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "patrones",
   "significado": "patterns",
   "pron": "pa-TRO-nes",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "Plural of «patrón», pattern or model. The stress falls on «TRO».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "regionales",
   "significado": "regional",
   "pron": "re-hyo-NA-les",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «región», region. The «io» is a diphthong, and the «g» before «i» sounds like «h».",
   "nota": "",
   "oculta": false
  }
 ],
