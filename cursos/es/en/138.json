     "id": "b7",
     "pregunta": {
      "texto": "Where do the pronouns go in a negative command?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Antes del verbo: no me lo digas.",
       "lengua": "estudio",
       "explicacion": "Yes! In the negative they go after «no» and before the verb.",
       "correcta": true
      },
      {
       "texto": "Al final del verbo: no digasmelo.",
       "lengua": "estudio",
       "explicacion": "Attached to the verb they only go in the affirmative: «dímelo».",
       "correcta": false
      },
      {
       "texto": "Antes de «no»: me lo no digas.",
       "lengua": "estudio",
       "explicacion": "«No» always goes before the pronouns.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
