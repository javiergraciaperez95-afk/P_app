 "intro": "Tickets, platforms, delays and the questions you need at a station or an airport.",
 "palabras": [
  {
   "palabra": "de ida y vuelta",
   "significado": "return, round-trip",
   "pron": "de I-da i BWEL-ta",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "A ticket for going and coming back. The «y» sounds like an i: de I-da i BWEL-ta.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "solo ida",
   "significado": "one way",
   "pron": "SO-lo I-da",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is a ticket without a return. Here «solo» has no accent.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "andén",
   "significado": "platform",
   "pron": "an-DEN",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It has an accent on the é because it ends in n and the stress is at the end: an-DÉN.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "retraso",
   "significado": "delay",
   "pron": "rre-TRA-so",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "You say «con retraso» or «de retraso»: «el tren lleva diez minutos de retraso».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "sale",
   "significado": "it leaves",
   "pron": "SA-le",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Timetables use the present: «el tren sale a las diez».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "llega",
   "significado": "it arrives",
   "pron": "YE-ga",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The ll sounds y. Timetables use the present: «llega a las doce».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "vuelo",
   "significado": "flight",
   "pron": "BWE-lo",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "You say «el vuelo sale» or «el vuelo llega». It comes from «volar».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "maleta",
   "significado": "suitcase",
   "pron": "ma-LE-ta",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It is feminine: «la maleta». Before travelling you say «hacer la maleta».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "puerta de embarque",
   "significado": "boarding gate",
   "pron": "PWER-ta de em-BAR-ke",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Embarcar» comes from «barco», although today it is also used with planes.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "facturar",
   "significado": "to check in luggage",
   "pron": "fak-tu-RAR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "At the airport you say «facturar la maleta». The c sounds k.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "asiento",
   "significado": "seat",
   "pron": "a-SYEN-to",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "On a plane it has a number and can be by the window or the aisle.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "tren",
   "significado": "train",
   "pron": "tren",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It has just one syllable: TREN. You take it at the station.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "equipaje",
   "significado": "luggage",
   "pron": "e-ki-PA-he",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It is masculine and usually not plural: «el equipaje». The j sounds h.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "directo",
   "significado": "direct",
   "pron": "di-REK-to",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It changes with the noun: «un tren directo», «una conexión directa».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "facturo",
   "significado": "check in (facturar)",
   "pron": "fak-TU-ro",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «facturar», to check in luggage. The stress is on TU.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "neblina",
   "significado": "mist",
   "pron": "ne-BLI-na",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The stress falls on BLI. The b sounds soft.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "altavoz",
   "significado": "loudspeaker",
   "pron": "al-ta-BOTH",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "The z at the end sounds like «th» in Spain.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "teje",
   "significado": "knits (tejer)",
   "pron": "TE-he",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «tejer», to knit. The j sounds like h.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "contra",
   "significado": "against",
   "pron": "KON-tra",
   "ipa": "",
   "cat": "preposition",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Means «against» or «leaning on». Not the same as «contrario».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "traqueteo",
   "significado": "rattling",
   "pron": "tra-ke-TE-o",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "The stress is on TE. The «eo» at the end is two separate syllables.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "ida",
   "significado": "outward journey",
   "pron": "I-da",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "Feminine noun. «Billete de ida» is a one-way ticket.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "entregarla",
   "significado": "hand it over (entregar)",
   "pron": "en-tre-gar-LA",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «entregar» with «la» at the end: to hand it over.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "avión",
   "significado": "plane",
   "pron": "a-BYON",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "The tilde on the ó shows the stress is on the last syllable.",
   "nota": "",
   "oculta": false
  }
