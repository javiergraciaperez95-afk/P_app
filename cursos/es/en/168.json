   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "After «que» comes the subjunctive: «es costumbre que los vecinos cenen juntos».",
   "nota": "",
   "oculta": false
  },
  {
