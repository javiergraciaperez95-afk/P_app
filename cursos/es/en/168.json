   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "You congratulate someone for something: «te felicito por tu boda». It comes from «feliz».",
   "nota": "",
   "oculta": false
  },
  {
