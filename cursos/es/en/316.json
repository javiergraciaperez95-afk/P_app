 "intro": "Read some booking conditions and separate three things: what is binding, what deadlines there are and what exceptions are hidden. At B2 the hard part is not the vocabulary, but the nuance.",
 "palabras": [
  {
   "palabra": "la condición",
   "significado": "a requirement that has to be met",
   "pron": "la kon-di-THYON",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "In conditions, almost everything important comes after a connector: «salvo que», «siempre que».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "el anticipo",
   "significado": "the part of the price paid in advance",
   "pron": "el an-ti-THI-po",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "Careful: this is not «anticipo» of time, it is money. Verb: anticipar.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "el reembolso",
   "significado": "the return of money paid",
   "pron": "el re-em-BOL-so",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "Verb: reembolsar. In a contract it appears as «no procede el reembolso».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "salvo que",
   "significado": "except if such a thing happens",
   "pron": "SAL-bo ke",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It takes the subjunctive: «salvo que llueva». It is one of the most frequent exceptions in contracts.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "conservar",
   "significado": "to keep something so as not to lose it",
   "pron": "kon-ser-BAR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "With documents, it means to keep them. Not to be confused with «conservar» a food.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "el comprobante",
   "significado": "a document that proves something was paid",
   "pron": "el kom-pro-BAN-te",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "Also «el justificante». It is used to make a claim later.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "los gastos",
   "significado": "the money something costs",
   "pron": "los GAS-tos",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "Careful: «gastos» in the plural usually refers to the extra costs: «gastos de cancelación».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "comprobar",
   "significado": "to check that something is true",
   "pron": "kom-pro-BAR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The stem is irregular: compruebo, compruebas. And note «comprobar que» + indicative: it is a fact.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "la estancia",
   "significado": "the time spent in a place",
   "pron": "la es-TAN-thya",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "Not to be confused with «la instancia», which is a document or an administrative level.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "retener",
   "significado": "not to give back part of the money",
   "pron": "re-te-NER",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Irregular: retengo, retienes. In contracts: «se retiene el veinte por ciento».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "presento",
   "significado": "I show up, I present (presentarse)",
   "pron": "pre-SEN-to",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «presentar». «Presentarse» means to appear somewhere, to show up at an event.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "envío",
   "significado": "I send (enviar)",
   "pron": "en-BI-o",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «enviar», to send. The accent on «í» separates the vowels «i» and «o».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "confirmada",
   "significado": "confirmed",
   "pron": "kon-fir-MA-da",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «confirmar». The feminine «-a» agrees with «reserva», which is feminine.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "importe",
   "significado": "amount (of money)",
   "pron": "im-POR-te",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "A sum of money to pay. It comes from «importar», which here means to cost.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "restante",
   "significado": "remaining",
   "pron": "res-TAN-te",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «resto», the rest. It describes what is still left to pay.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "abona",
   "significado": "pays (abonar)",
   "pron": "a-BO-na",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «abonar», to pay or credit a sum. The «-a» ending is for «usted» or «él».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "recepción",
   "significado": "reception desk, check-in",
   "pron": "re-thep-THYON",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "From «recibir», to receive. In a hotel it is the front desk where you arrive.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "cancelación",
   "significado": "cancellation",
   "pron": "kan-se-la-THYON",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "From «cancelar», to cancel. The «-ción» ending turns the verb into a noun.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "gratuita",
   "significado": "free of charge",
   "pron": "gra-TWI-ta",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «gratis», free. Feminine form, agreeing with «cancelación».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "retiene",
   "significado": "withholds (retener)",
   "pron": "re-TYE-ne",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «tener», to have, with «re-» meaning to hold back. The «ie» diphthong is «tye».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "total",
   "significado": "total, whole amount",
   "pron": "to-TAL",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "The sum of everything. The stress falls on the last syllable, «TAL».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "presenta",
   "significado": "presents, shows up (presentarse)",
   "pron": "pre-SEN-ta",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «presentar». Used with «se» it means to appear at a place, like at a booking.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "gasto",
   "significado": "expense, cost",
   "pron": "GAS-to",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "From «gastar», to spend. A «gasto» is money that goes out, the opposite of income.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "adicional",
   "significado": "additional",
   "pron": "a-di-thyo-NAL",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «adición», an addition. It is something extra added on top of the agreed price.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "cobra",
   "significado": "charges (cobrar)",
   "pron": "KO-bra",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «cobrar», to charge or collect payment. The «c» before «o» is a «k».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "finalizar",
   "significado": "to end, to finish",
   "pron": "fi-na-li-THAR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «final», the end. A more formal way to say «terminar».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "acordado",
   "significado": "agreed (acordar)",
   "pron": "a-kor-DA-do",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «acordar», to agree. The «-ado» is the past participle, used after «haber».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "condición",
   "significado": "condition",
   "pron": "kon-di-THYON",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "A requirement that must be met first. The «c» before «o» is «k», and «-ción» is the ending.",
   "nota": "",
   "oculta": false
  }
 ],
 "etapas": [
