 "intro": "The neuter lo: lo de, lo plus adjective plus que, lo mío, and the set phrases built on it.",
 "palabras": [
  {
   "palabra": "lo de ayer",
   "significado": "what happened yesterday",
   "pron": "lo de a-YER",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Lo de» + noun points to a matter both know about: «siento lo de ayer».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "lo de la mudanza",
   "significado": "the business of the move",
   "pron": "lo de la mu-DAN-tha",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Lo de la mudanza» sums up the whole matter without repeating details. The z sounds «th».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "lo bien que",
   "significado": "how well",
   "pron": "lo BYEN ke",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It adds force: «mira lo bien que canta». With adverbs, «lo» never changes form.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "lo cansada que",
   "significado": "how tired (feminine)",
   "pron": "lo kan-SA-da ke",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The adjective agrees: «lo cansada que estoy» (woman), «lo cansado que estoy» (man).",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "lo importante",
   "significado": "the important thing",
   "pron": "lo im-por-TAN-te",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Lo» + adjective turns a quality into an idea: «lo importante», «lo mejor».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "lo mío",
   "significado": "my thing; my business",
   "pron": "lo MI-o",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It can be your affairs or your talent: «cocinar no es lo mío». With «tuyo»: «lo tuyo».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "por lo visto",
   "significado": "apparently",
   "pron": "por lo BIS-to",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is used when telling something you have heard or seen: «por lo visto, no viene».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "por lo menos",
   "significado": "at least",
   "pron": "por lo ME-nos",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "You can also say «al menos». It shows a minimum amount.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "por lo general",
   "significado": "as a rule",
   "pron": "por lo he-ne-RAL",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Synonym: «en general». The g sounds like h: por lo he-ne-RAL.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "lo antes posible",
   "significado": "as soon as possible",
   "pron": "lo AN-tes po-SI-ble",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It never changes: «lo antes posible». It equals «cuanto antes».",
   "nota": "",
   "oculta": false
  },
  {
