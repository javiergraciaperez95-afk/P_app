   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Only for one o'clock you use «es». For all the other hours, «son».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "son las dos",
   "significado": "it is two o'clock",
