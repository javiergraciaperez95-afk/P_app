   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "3:45 is «las cuatro menos cuarto», which is the natural way to say it.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "a la una",
   "significado": "at one o'clock",
   "pron": "a la U-na",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
