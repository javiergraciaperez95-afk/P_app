 "intro": "Where to buy what, and whether the shop is open or closed.",
 "palabras": [
  {
   "palabra": "la panadería",
   "significado": "bakery",
   "pron": "la pa-na-de-RI-a",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "Many shops end in -ería: «pan» gives «panadería». It is feminine and the accent marks the í.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "la frutería",
   "significado": "greengrocer's",
   "pron": "la fru-te-RI-a",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It comes from «fruta» and also has an accent on the í: fru-te-RÍ-a. It is feminine.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "la carnicería",
   "significado": "butcher's",
   "pron": "la kar-ni-the-RI-a",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It comes from «carne». In Spain c before i sounds «th»: kar-ni-the-RÍ-a.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "la pescadería",
   "significado": "fishmonger's",
   "pron": "la pes-ka-de-RI-a",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It comes from «pescado»: la pescadería. There is often one in markets.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "el mercado",
   "significado": "market",
   "pron": "el mer-KA-do",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It is masculine: «el mercado». Inside there is often a greengrocer's, butcher's and fishmonger's.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "la librería",
   "significado": "bookshop",
   "pron": "la li-bre-RI-a",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "Careful: «librería» is the bookshop. «Library» in Spanish is «biblioteca».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "la zapatería",
   "significado": "shoe shop",
   "pron": "la tha-pa-te-RI-a",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It is written with z: zapato, zapatería. In Spain the z sounds «th».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "abierto",
   "significado": "open (masculine)",
   "pron": "a-BYER-to",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It agrees with the noun: «el mercado está abierto», «la tienda está abierta».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "cerrado",
   "significado": "closed (masculine)",
   "pron": "the-RRA-do",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is the opposite of abierto: «el bar está cerrado», «la tienda está cerrada».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "abre",
   "significado": "it opens",
   "pron": "A-bre",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "For opening times: «abre a las nueve». You ask: «¿A qué hora abre?».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "cierra",
   "significado": "it closes",
   "pron": "THYE-rra",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Cerrar changes e to ie: cierro, cierras, cierra. You ask: «¿A qué hora cierra?».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "comprar",
   "significado": "to buy",
   "pron": "kom-PRAR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is a regular -ar verb: compro, compras, compra. «¿Dónde puedo comprar pan?».",
   "nota": "",
   "oculta": false
  },
  {
