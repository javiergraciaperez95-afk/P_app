   "significado": "to sell",
   "pron": "ben-DER",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is the opposite of comprar. The shop sells, you buy: «¿Venden pescado?».",
   "nota": "",
   "oculta": false
  },
  {
