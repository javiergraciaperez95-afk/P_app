 "intro": "Buying, renting and repairing a home: the trades, the bills and what breaks.",
 "palabras": [
  {
   "palabra": "reforma",
   "significado": "renovation",
   "pron": "re-FOR-ma",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "You say «hacer una reforma» or «reformar» the kitchen. The verb and noun are family.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "albañil",
   "significado": "builder, bricklayer",
   "pron": "al-ba-NYIL",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "The ñ sounds «ny»: «al-ba-NYIL». He works with bricks, cement and walls.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "fontanero",
   "significado": "plumber",
   "pron": "fon-ta-NE-ro",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It comes from «fontana», fountain. In some countries in Latin America it is «plomero».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "ático",
   "significado": "top-floor flat",
   "pron": "A-ti-ko",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "The accent marks the strong syllable: «Á-ti-co». Many áticos have a terrace.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "inmobiliaria",
   "significado": "estate agent's",
   "pron": "in-mo-bi-LYA-rya",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It is the company; the person who works there is «el agente inmobiliario».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "acogedor",
   "significado": "cosy",
   "pron": "a-ko-he-DOR",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "In a flat advert, «acogedor» sometimes means «very small».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "dar a",
   "significado": "to look onto",
   "pron": "DAR a",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It takes «a»: «la ventana da a la calle», «da al mar».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "enchufe",
   "significado": "socket, plug",
   "pron": "en-CHU-fe",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "The «ch» sounds as in «chocolate». «Enchufar» means to plug in.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "bombilla",
   "significado": "light bulb",
   "pron": "bom-BI-ya",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The «ll» sounds «y»: «bom-BI-ya». When it stops giving light, «se ha fundido».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "gotera",
   "significado": "leak (in a roof)",
   "pron": "go-TE-ra",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It comes from «gota». If water falls from the ceiling, «hay una gotera».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "averiarse",
   "significado": "to break down",
   "pron": "a-be-RYAR-se",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "A machine breaks down, not a person: «se ha averiado la lavadora».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "presupuesto",
   "significado": "estimate, quote; budget",
   "pron": "pre-su-PWES-to",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "You ask for it before starting work. It is also the money you have for something.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "inquilino",
   "significado": "tenant",
   "pron": "in-ki-LI-no",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "The owner of the house is «el propietario»; the one who collects the rent, «el casero».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "comunidad de vecinos",
   "significado": "residents' association",
   "pron": "ko-mu-ni-DAD de be-THI-nos",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It brings together all the neighbours of a building, who pay the «gastos de comunidad» together.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "arreglarla",
   "significado": "to fix it (infinitive with «la»)",
   "pron": "a-rre-GLAR-la",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«la» refers to a feminine thing, like «la casa». «arreglarla» means to fix it.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "necesitamos",
   "significado": "we need (from «necesitar»)",
   "pron": "ne-se-si-TA-mos",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The stress is on «TA»: ne-se-si-TA-mos. Remember the «c» in «necesitar» is a «th» in Spain.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "fundido",
   "significado": "blown (of a bulb), melted",
   "pron": "fun-DI-do",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«se ha fundido» means the bulb has blown. It comes from «fundir», to melt.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "averió",
   "significado": "broke down (from «averiarse»)",
   "pron": "a-be-RYO",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The «ió» ending is stressed: a-be-RYO. «averiarse» means to break down.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "inquilinos",
   "significado": "tenants",
   "pron": "in-ki-LI-nos",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "«inquilino» is a person who rents. Notice the «i» at the start: in-ki-LI-nos.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "hablarán",
   "significado": "will talk (future of «hablar»)",
   "pron": "a-bla-RAN",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The «h» is silent. The future ending «-án» is stressed: a-bla-RAN.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "firmamos",
   "significado": "we sign (from «firmar»)",
   "pron": "fir-MA-mos",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«firmar» means to sign. The stress is on «MA»: fir-MA-mos.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "presupuestos",
   "significado": "quotes, estimates",
   "pron": "pre-su-PWES-tos",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "«presupuesto» is a written estimate of cost. The «ue» is one sound: pre-su-PWES-tos.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "gota",
   "significado": "drop",
   "pron": "GO-ta",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "«gota» is feminine: «la gota». The «g» before «o» is hard: GO-ta.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "nudillos",
   "significado": "knuckles",
   "pron": "nu-DI-llos",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "«nudillo» is a finger joint. The «ll» is pronounced «y» in most of Spain: nu-DI-yos.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "parpadea",
   "significado": "flickers (from «parpadear»)",
   "pron": "par-pa-DE-a",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«parpadear» means to blink or flicker. The stress is on «DE»: par-pa-DE-a.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "funde",
   "significado": "melts, blows (from «fundir»)",
   "pron": "FUN-de",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«se funde» means the bulb blows. The «u» is a clear vowel: FUN-de.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "pierden",
   "significado": "lose (from «perder»)",
   "pron": "pyer-DEN",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«perder» changes to «pierd-» in the present. The «ie» is one sound: pyer-DEN.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "recuperan",
   "significado": "recover, get back (from «recuperar»)",
   "pron": "re-ku-PE-ran",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«recuperar» means to get something back. The stress is on «PE»: re-ku-PE-ran.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "afectó",
   "significado": "affected (from «afectar»)",
   "pron": "a-fek-TO",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The accent on «afectó» marks the final stress: a-fek-TO. It is the past tense of «afectar».",
   "nota": "",
   "oculta": false
  }
 ],
