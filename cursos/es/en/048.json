   "significado": "them (masculine)",
   "pron": "los",
   "ipa": "",
   "cat": "pronoun",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It replaces several masculine or mixed things: «los zapatos» → «los quiero».",
   "nota": "",
   "oculta": false
  },
  {
