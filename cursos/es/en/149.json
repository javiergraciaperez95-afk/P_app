   "nota": "",
   "oculta": false
  },
  {
   "palabra": "goma",
   "significado": "rubber",
   "pron": "GO-ma",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "Rubber, the material of boots. The «g» before «o» is hard.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "chapoteo",
   "significado": "splashing",
   "pron": "cha-po-TE-o",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "The sound water makes when you step in it. Say «cha-po-TE-o».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "queja",
   "significado": "complains (quejarse)",
   "pron": "KE-ha",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «quejarse», to complain. «Nadie se queja» means nobody complains.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "resbaladizo",
   "significado": "slippery",
   "pron": "rres-ba-la-DI-tho",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
