 "titulo": {
  "estudio": "Ir e irse",
  "alumno": "To go and to leave"
 },
 "intro": "Verbs that change their meaning when they take me, te, se.",
 "palabras": [
  {
   "palabra": "irse",
   "significado": "to leave, to go away",
   "pron": "IR-se",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Ir» is to go to a place; «irse» is to leave it: «me voy». It is irregular: «me voy», «te vas».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "quedarse",
   "significado": "to stay",
   "pron": "ke-DAR-se",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Quedarse» is not leaving: «me quedo en casa». With «quedar» the meaning changes.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "quedar",
   "significado": "to arrange to meet; to be left",
   "pron": "ke-DAR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Quedar con alguien» is to arrange to meet: «he quedado con Ana». Also: «quedan dos».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "dormirse",
   "significado": "to fall asleep",
   "pron": "dor-MIR-se",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Dormir» is to be asleep; «dormirse» is to fall asleep: «me dormí en el metro».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "acordarse de",
   "significado": "to remember",
   "pron": "a-kor-DAR-se de",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Always with «de»: «me acuerdo de ti». Without «se», «acordar» is to agree.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "parecerse a",
   "significado": "to look like",
   "pron": "pa-re-THER-se a",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Always with «a»: «se parece a su madre». «Parecer» without «se» is «to seem».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "llevarse bien",
   "significado": "to get on well",
   "pron": "ye-BAR-se byen",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "You say «llevarse bien con alguien»: «nos llevamos muy bien». The opposite is «llevarse mal».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "comerse",
   "significado": "to eat up",
   "pron": "ko-MER-se",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "With «se» you eat it all: «se comió la tarta». It needs a whole amount.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "despedirse de",
   "significado": "to say goodbye to",
   "pron": "des-pe-DIR-se de",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "You say «despedirse de alguien»: «me despido de ti». It is pronominal.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "despedir",
   "significado": "to dismiss, to sack; to see off",
   "pron": "des-pe-DIR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Lo despidieron» means he lost his job. Do not confuse it with «despedirse».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "negarse a",
   "significado": "to refuse to",
   "pron": "ne-GAR-se a",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It goes with «a» + infinitive: «se niega a salir». «Negar» without «se» is to say it is not true.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "rato",
   "significado": "a while",
   "pron": "RRA-to",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "You say «un rato». The initial r sounds strong: RRA-to.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "quédate",
   "significado": "stay (imperative of «quedarse»)",
   "pron": "KE-da-te",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Imperative of «quedarse», to stay. The stress is on KE: KE-da-te.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "duermas",
   "significado": "you sleep (subjunctive of «dormir»)",
   "pron": "DUER-mas",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Subjunctive of «dormir», to sleep. The ue is a diphthong: DUER-mas.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "despido",
   "significado": "I say goodbye (from «despedirse»)",
   "pron": "des-PI-do",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «despedirse», to say goodbye. Stress on PI: des-PI-do.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "despidieron",
   "significado": "they dismissed (from «despedir»)",
   "pron": "des-pi-DIE-ron",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Past tense of «despedir», to dismiss from work. The ie is a diphthong.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "despidió",
   "significado": "said goodbye (from «despedirse»)",
   "pron": "des-pi-DIO",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Past tense of «despedirse», to say goodbye. The ió is a diphthong.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "niega",
   "significado": "refuses, denies (from «negar»)",
   "pron": "NIE-ga",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «negar», to deny. The ie is a diphthong: NIE-ga.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "rastro",
   "significado": "trace, mark",
   "pron": "RAS-tro",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "Masculine, «el rastro». The rr sound is strong at the start: RAS-tro.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "hamaca",
   "significado": "hammock",
   "pron": "a-MA-ka",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
