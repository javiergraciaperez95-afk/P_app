 "palabras": [
  {
   "palabra": "letra",
   "significado": "lyrics; letter",
   "pron": "LE-tra",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It is also each sign of the alphabet. In a song you say «la letra» and you sing it.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "cantante",
   "significado": "singer",
   "pron": "kan-TAN-te",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It works for a man and a woman: «el cantante», «la cantante». It comes from «cantar».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "grupo",
   "significado": "band; group",
   "pron": "GRU-po",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It is also any set of people or things. A music group is also called «banda».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "en directo",
   "significado": "live",
   "pron": "en di-REK-to",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "In Spain you say «en directo»; in other countries, «en vivo». A live concert is heard at that moment.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "gira",
   "significado": "tour",
   "pron": "HI-ra",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "You say «estar de gira». The g sounds like h: HI-ra.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "disco",
   "significado": "album; record",
   "pron": "DIS-ko",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "A band «saca» a disco when it releases it. Today it can also be heard online.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "ensayar",
   "significado": "to rehearse",
   "pron": "en-sa-YAR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Its noun is «ensayo». The y sounds like in «yo»: en-sa-YAR.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "ritmo",
   "significado": "rhythm",
   "pron": "RRIT-mo",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It starts with a strong rr: RRIT-mo. You say «llevar el ritmo» with your hands or feet.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "voz",
   "significado": "voice",
   "pron": "BOTH",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The plural is «voces»: the z changes to c. You say «tener buena voz».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "éxito",
   "significado": "hit; success",
   "pron": "EK-si-to",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "False friend: it means «success», not «exit». It has an accent: EK-si-to.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "violín",
   "significado": "violin",
   "pron": "byo-LIN",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
