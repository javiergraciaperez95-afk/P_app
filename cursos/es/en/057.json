 "titulo": {
  "estudio": "Voy a viajar",
  "alumno": "I'm going to travel"
 },
 "intro": "Ir a + infinitive: the easiest way to talk about your plans.",
 "palabras": [
  {
   "palabra": "voy",
   "significado": "I go (yo form of ir)",
   "pron": "boy",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Voy» is the yo form of «ir» in the present. It is written with v but sounds like b.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "vas",
   "significado": "you go (tú form of ir)",
   "pron": "bas",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Vas» is for «tú». With he or she you say «va».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "va",
   "significado": "he, she or you (usted) goes",
   "pron": "ba",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Va» has no h. «Ha» with h is another verb (haber).",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "vamos",
   "significado": "we go",
   "pron": "BA-mos",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Vamos a + infinitive» also invites others to do something together: «¡Vamos a comer!».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "vais",
   "significado": "you plural go (vosotros)",
   "pron": "bais",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Vais» is mainly used in Spain. In Latin America people say «ustedes van».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "van",
   "significado": "they or you plural (ustedes) go",
   "pron": "ban",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Van» works for they and ustedes. Only «ir» changes: «van a comer».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "a",
   "significado": "small word that links «ir» to the verb of the plan",
   "pron": "a",
   "ipa": "",
   "cat": "preposition",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "In «voy a viajar» the «a» is never missing: without it the sentence sounds incomplete.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "viajar",
   "significado": "to travel",
   "pron": "bya-HAR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is written with v and j, but sounds «bya-HAR», with j like a strong h.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "hacer",
   "significado": "to do, to make",
   "pron": "a-THER",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "After «ir a» the second verb never changes: «voy a hacer», «vamos a hacer».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "mañana",
   "significado": "tomorrow",
   "pron": "ma-NYA-na",
   "ipa": "",
   "cat": "adverb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It also means the first part of the day: «por la mañana». The context shows which one.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "el próximo",
   "significado": "next",
   "pron": "el PROK-si-mo",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It changes with the noun: «el próximo mes», «la próxima semana», «los próximos días».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "el mes",
   "significado": "the month",
   "pron": "el mes",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It is masculine: «el mes», «un mes». The plural is «los meses».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "llover",
   "significado": "to rain",
   "pron": "yo-BER",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is only used in the singular: «va a llover». The ll sounds like y.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "amiga",
   "significado": "friend (female)",
   "pron": "a-MI-ga",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "«Amiga» is feminine; for a boy it is «amigo». The g is hard: a-MI-ga.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "guardar",
   "significado": "to put away, to pack",
   "pron": "gwar-DAR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It also means «to keep» and «to save»: «guardar un secreto». The u is silent only in «gue/gui».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "bufanda",
   "significado": "scarf",
   "pron": "bu-FAN-da",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "You wear it around the neck when it is cold. It is feminine: «una bufanda».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "latir",
   "significado": "to beat (heart)",
   "pron": "la-TIR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It says what the heart does: «el corazón late». It is a regular -ir verb.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "prima",
   "significado": "cousin (female)",
   "pron": "PRI-ma",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The male cousin is «primo». «Primos» can mean cousins of both sexes.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "colina",
   "significado": "hill",
   "pron": "ko-LI-na",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It is smaller than a «montaña». The stress is on «li»: ko-LI-na.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "casas",
   "significado": "houses",
   "pron": "KA-sas",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It is the plural of «casa»: add -s. The c before a sounds like k.",
   "nota": "",
   "oculta": false
  }
 ],
