 "titulo": {
  "estudio": "Mismo idioma, varias voces",
  "alumno": "One language, many voices"
 },
 "intro": "Compare a few regional features without treating a country or continent as linguistically uniform.",
 "palabras": [
  {
   "palabra": "variedad",
   "significado": "variety",
   "pron": "ba-rye-DAD",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "A language has many varieties, regional or social. It ends in «-dad»: feminine.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "voseo",
   "significado": "use of «vos»",
   "pron": "bo-SE-o",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It comes from «vos». It is common in Argentina and Uruguay, and also appears in other regions.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "seseo",
   "significado": "pronouncing c and z as s",
   "pron": "se-SE-o",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It comes from «s». It is widespread in the Americas and is also heard in parts of Spain.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "región",
   "significado": "region",
   "pron": "rre-HYON",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "Its adjective is «regional». The g sounds strong, like an h: «rre-HYON».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "vosotros",
   "significado": "you (plural, informal, Spain)",
   "pron": "bo-SO-tros",
   "ipa": "",
   "cat": "pronoun",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It has its own forms: «vosotros tenéis», «habéis probado». In the Americas «ustedes» is used.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "antelación",
   "significado": "advance notice",
   "pron": "an-te-la-THYON",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "You say «con antelación»: «comprar el billete con antelación». It means «in good time».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "billete",
   "significado": "ticket",
   "pron": "bi-YE-te",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "In Spain you say «el billete» for the train; in the Americas, often «el boleto».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "cómodo",
   "significado": "comfortable",
   "pron": "KO-mo-do",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It has a tilde on the first o because it is proparoxytone: «KO-mo-do».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "pronombre",
   "significado": "pronoun",
   "pron": "pro-NOM-bre",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "«Yo», «tú», «vos» and «usted» are pronouns. Note the b before the r: «pro-NOM-bre».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "tratamiento",
   "significado": "form of address",
   "pron": "tra-ta-MYEN-to",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It can be «tú», «vos» or «usted». It comes from «tratar».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "probado",
   "significado": "tried (probar)",
   "pron": "pro-BA-do",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «probar», to try. The «-ado» ending is the past participle, used after «haber».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "nocturno",
   "significado": "night (adjective)",
   "pron": "nok-TUR-no",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «noche», night. The «c» before «t» is a hard «k» sound.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "usamos",
   "significado": "we use (usar)",
   "pron": "u-SA-mos",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «usar», to use. The «-amos» ending is for «nosotros».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "comprá",
   "significado": "buy (comprar, vos)",
   "pron": "kom-PRA",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "In Argentina «vos» uses «comprá» for the command. The stress is on the last syllable.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "servicio",
   "significado": "service",
   "pron": "ser-BI-thyo",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "A service you pay for or receive. The «v» sounds like «b», and the «c» like «th».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "pronombres",
   "significado": "pronouns",
   "pron": "pro-NOM-bres",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "Plural of «pronombre». It is a word that takes the place of a noun, like «yo» or «lo».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "distintos",
   "significado": "different (plural)",
   "pron": "dis-TIN-tos",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Distinto» means different. In Spanish it agrees with the noun, here «acentos».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "contexto",
   "significado": "context",
   "pron": "kon-TEKS-to",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "The «x» sounds like «ks». The stress falls on «TEKS», the second syllable.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "probaron",
   "significado": "they tried (probar)",
   "pron": "pro-BA-ron",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «probar», to try. The «-aron» ending is the past for «ellos» or «ustedes».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "encendidas",
   "significado": "lit, switched on",
   "pron": "en-then-DI-das",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «encender», to light up. The feminine plural «-das» agrees with «ventanas».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "red",
   "significado": "luggage rack",
   "pron": "RRED",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "Also means net or network. On trains, «la red» is the rack above the seats.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "compartimento",
   "significado": "compartment",
   "pron": "kom-par-ti-MEN-to",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "From «compartir», to share. A train compartment is a separate part of the carriage.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "distintas",
   "significado": "different (feminine plural)",
   "pron": "dis-TIN-tas",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The feminine plural of «distinto». It agrees with «voces», which are feminine.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "acentos",
   "significado": "accents",
   "pron": "a-THEN-tos",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "Plural of «acento». The «c» before «e» sounds like «th» in Spain. The «-tos» ends the plural.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "entienden",
   "significado": "they understand (entender)",
   "pron": "en-TYEN-den",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «entender», to understand. The «ie» diphthong is pronounced «tyen».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "esfuerzo",
   "significado": "effort",
   "pron": "es-FWER-tho",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "Noun from «esforzarse», to make an effort. The «z» is pronounced «th» in Spain.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "silbato",
   "significado": "whistle",
   "pron": "sil-BA-to",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "From «silbar», to whistle. A «silbato» is a small whistle, like the one of a train guard.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "raíles",
   "significado": "rails",
   "pron": "rra-I-les",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "Plural of «raíl». The accent on the «í» separates the vowels «a» and «i» into two syllables.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "apagan",
   "significado": "they switch off (apagar)",
   "pron": "a-PA-gan",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «apagar», to switch off. It is the opposite of «encender», to switch on.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "pálido",
   "significado": "pale",
   "pron": "PA-li-do",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "A word with an accent on the first syllable, «PA». It describes weak or faint colour.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "entrará",
   "significado": "will enter (entrar)",
   "pron": "en-tra-RA",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «entrar», to enter. The «-rá» ending is the future for «él» or «ella».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "despertará",
   "significado": "will wake (despertar)",
   "pron": "des-per-ta-RA",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «despertar», to wake up. The stress lands on the «-rá» at the end, the future.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "habitual",
   "significado": "usual, common",
   "pron": "a-bi-tu-AL",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The «h» is silent, so it starts with «a». It means something common and familiar.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "diferencias",
   "significado": "differences",
   "pron": "di-fe-REN-thyas",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "Plural of «diferencia». The «c» before «i» sounds like «th» in Spain, and «ia» is a diphthong.",
   "nota": "",
   "oculta": false
  }
 ],
