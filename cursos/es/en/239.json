   "significado": "to apologise",
   "pron": "dis-kul-PAR-se",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is pronominal: «me disculpo». You apologise to someone: «me disculpo contigo». The c sounds like k.",
   "nota": "",
   "oculta": false
  },
  {
