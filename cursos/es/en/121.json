   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Future of «volver» is regular: «volver» + «á». Both «v» sound like «b».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "golpes",
   "significado": "knocks, blows",
   "pron": "GOL-pes",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
