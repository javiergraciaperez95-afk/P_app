   "nota": "",
   "oculta": false
  },
  {
   "palabra": "recorre",
   "significado": "traces, travels over (from «recorrer»)",
   "pron": "rre-KO-rre",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It comes from «recorrer», a regular verb. The initial «r» is strong; the one inside is «rr».",
