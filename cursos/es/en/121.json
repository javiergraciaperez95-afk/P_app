   "pron": "her-SEIS",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It is the plural of «el jersey», which ends in -y, so the plural is «jerséis», with an accent mark.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "doblados",
   "significado": "folded",
   "pron": "do-BLA-dos",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
