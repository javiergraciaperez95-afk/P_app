   "consejo": "It is masculine: «el borde». «Al borde de» means right at the edge of something.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "intención",
   "significado": "intention",
   "pron": "in-ten-THYON",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
