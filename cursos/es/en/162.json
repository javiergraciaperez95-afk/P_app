   "pron": "tak",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "A sound word, second half of «tic tac». The c at the end sounds k.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "torcida",
   "significado": "crooked, twisted (fem.)",
