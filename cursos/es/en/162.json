   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "The «ua» is one syllable and the stress is on «der»: kwa-DER-no.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "recibe",
   "significado": "receives, welcomes (from recibir)",
   "pron": "rre-THI-be",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Form of «recibir». The initial r is strong and the c before i sounds th: rre-THI-be.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "toma",
   "significado": "takes (from tomar)",
   "pron": "TO-ma",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
