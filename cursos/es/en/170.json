   "oculta": false
  },
  {
   "palabra": "respuestas",
   "significado": "answers",
   "pron": "rres-PWES-tas",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "Plural of «respuesta». It comes from the verb «responder».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "miran",
