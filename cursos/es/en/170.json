   "pron": "sen-TA-dos",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Participle of «sentarse». It agrees with the people: «sentados».",
   "nota": "",
   "oculta": false
  },
  {
