   "significado": "plant",
   "pron": "PLAN-ta",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It is also a floor of a building: «la planta baja» is the ground floor.",
