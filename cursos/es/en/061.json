 "titulo": {
  "estudio": "Fui al mercado",
  "alumno": "I went to the market"
 },
 "intro": "Ser, ir, tener and hacer are irregular in the indefinido. Learn their forms with a day of shopping.",
 "palabras": [
  {
   "palabra": "fui",
   "significado": "I went, I was",
   "pron": "fwi",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Fui» works for both ir and ser; what follows tells you which.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "fue",
   "significado": "he or she went, it was",
   "pron": "fwe",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It has no accent: «fue» and «fui» have a single syllable.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "tuve",
   "significado": "I had",
   "pron": "TU-be",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The stem changes from «ten-» to «tuv-» and the ending loses its accent: tuve.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "tuviste",
   "significado": "you had",
   "pron": "tu-BIS-te",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "You say «tuviste», never «teniste»: the irregular stem stays all through the past.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "hice",
   "significado": "I did, I made",
   "pron": "I-the",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "In Spain the c sounds like «th»: «I-the». In Latin America it sounds like «s».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "hizo",
   "significado": "he or she did, made",
   "pron": "I-tho",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "To keep the sound, c turns into z: «hizo», not «hico».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "al mercado",
   "significado": "to the market",
   "pron": "al mer-KA-do",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«A» + «el» always merges: «al mercado», never «a el mercado».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "la compra",
   "significado": "the shopping",
   "pron": "la KOM-pra",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "«Hacer la compra» means buying the household food.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "muy bueno",
   "significado": "very good",
   "pron": "mwi BWE-no",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The adjective agrees: «muy bueno» with el mercado, «muy buena» with la película.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "la película",
   "significado": "the film, the movie",
   "pron": "la pe-LI-ku-la",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It has an accent on the í: «pe-LI-ku-la». You say «ver una película».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "fuiste",
   "significado": "you went, you were",
   "pron": "FWIS-te",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Ir» and «ser» share the past. For «tú» it is «fuiste», with no accent. «Fu» is one syllable.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "hicimos",
   "significado": "we did, we made",
   "pron": "i-THI-mos",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It comes from «hacer». Before i the c keeps its «th» sound in Spain: i-THI-mos. The h is silent.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "alba",
   "significado": "dawn",
   "pron": "AL-ba",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "A literary word for dawn. It is feminine: «el alba» uses «el» only to make the sound easier.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "olió",
   "significado": "it smelled",
   "pron": "o-LYO",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Oler» is regular in the past: «olió». In the present it becomes «huele». It is followed by «a»: «olió a naranjas».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "maduras",
   "significado": "ripe (feminine plural)",
   "pron": "ma-DU-ras",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It agrees with «naranjas»: feminine plural. The d between vowels is soft, never «th».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "fuego",
   "significado": "fire",
   "pron": "FWE-go",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "«Ue» is one syllable: FWE-go. It is masculine: «el fuego». «Colores de fuego» means red and orange.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "cono",
   "significado": "cone",
   "pron": "KO-no",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "A «cono de papel» is a paper cone for holding fruit or nuts. The c before o sounds k.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "rápidas",
   "significado": "quick, fast (feminine plural)",
   "pron": "RRA-pi-das",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The accent shows the stress on the first syllable. It agrees with «manos»: «manos rápidas».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "rojos",
   "significado": "red (masculine plural)",
   "pron": "RRO-hos",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It agrees with «tomates»: masculine plural. The j sounds like a strong h and the initial r is strong.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "tuvo",
   "significado": "he/she had",
   "pron": "TU-bo",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The stem changes to «tuv-» and there is no accent. «Tuvo frío» means «felt cold».",
   "nota": "",
   "oculta": false
  }
 ],
