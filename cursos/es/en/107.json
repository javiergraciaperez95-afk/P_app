   "significado": "to fry",
   "pron": "fre-IR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The i has an accent: «freír», «se fríe», «se fríen». A «frito» egg is the result.",
   "nota": "",
   "oculta": false
  },
  {
