 "intro": "The future also guesses things about the present: «estará en casa» means «she is probably at home».",
 "palabras": [
  {
   "palabra": "estará",
   "significado": "is probably (from «estar»)",
   "pron": "es-ta-RA",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "With the future you guess the present: «estará en casa» means «she is probably at home».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "será",
   "significado": "it must be (from «ser»)",
