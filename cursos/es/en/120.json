   "significado": "I imagine that",
   "pron": "me i-ma-HI-no ke",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It comes from «imaginarse», with «me». It is followed by the indicative: «me imagino que está cansada».",
   "nota": "",
   "oculta": false
  },
