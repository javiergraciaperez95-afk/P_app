     "pregunta": {
      "texto": "The cause comes first. Which word opens the sentence?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "____ llovía, nos quedamos en casa.",
      "lengua": "estudio"
     },
     "traduccion": "____ llovía, nos quedamos en casa.",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Como",
       "lengua": "estudio",
       "explicacion": "Yes! With a causal meaning, «como» opens the sentence.",
       "correcta": true
      },
      {
       "texto": "Porque",
       "lengua": "estudio",
       "explicacion": "«Porque» usually comes after the result: «nos quedamos porque llovía».",
       "correcta": false
      },
      {
       "texto": "Por",
       "lengua": "estudio",
       "explicacion": "«Por» needs a noun, not a verb like «llovía».",
       "correcta": false
      }
     ],
