   "significado": "to stay (quedarse)",
   "pron": "ke-DAR-me",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Quedarse» + «me» become «quedarme»: the pronoun goes at the end. The «qu» sounds k and the u is silent.",
   "nota": "",
   "oculta": false
  },
  {
