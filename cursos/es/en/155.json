   "significado": "we give, we take (dar, subjunctive)",
   "pron": "DE-mos",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Subjunctive of «dar»: «damos» → «demos». “Dar un paseo” is to take a walk.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "participar",
   "significado": "to take part, to join",
   "pron": "par-ti-thi-PAR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Regular verb, followed by «en»: «participar en el plan». The «ci» sounds “thi” in Spain.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "plan",
   "significado": "plan",
   "pron": "plan",
   "ipa": "",
   "cat": "noun",
