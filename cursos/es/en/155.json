   "significado": "they say (decir)",
   "pron": "DI-then",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Dicen que…» means “they say that…”, with no clear subject. The «c» before e sounds “th” in Spain.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "apetece",
   "significado": "appeals, one feels like (apetecer)",
   "pron": "a-pe-TE-the",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It works like «gustar»: «¿te apetece…?». The «c» before e sounds “th” in Spain: a-pe-TE-the.",
   "nota": "",
   "oculta": false
  },
  {
