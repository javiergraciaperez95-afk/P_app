   "nota": "",
   "oculta": false
  },
  {
   "palabra": "tutor",
   "significado": "tutor",
   "pron": "tu-TOR",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "A woman is «la tutora». It is also the legal guardian of a minor.",
   "nota": "",
   "oculta": false
  },
  {
