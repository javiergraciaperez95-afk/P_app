 "palabras": [
  {
   "palabra": "alquiler",
   "significado": "rent",
   "pron": "al-ki-LER",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It comes from «alquilar». You say «pagar el alquiler» and «el alquiler del piso».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "alquilar",
   "significado": "to rent",
   "pron": "al-ki-LAR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "On a sign, «se alquila» means the flat is available to live in, paying every month.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "amueblado",
   "significado": "furnished",
   "pron": "a-mwe-BLA-do",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It changes with the noun: «piso amueblado», «casa amueblada». The opposite is «vacío».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "exterior",
   "significado": "exterior-facing",
   "pron": "eks-te-RYOR",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "An exterior flat has its windows onto the street, not onto an inner courtyard.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "luminoso",
   "significado": "bright",
   "pron": "lu-mi-NO-so",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It comes from «luz»: lots of light comes in. It changes: «luminoso», «luminosa».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "calefacción",
   "significado": "heating",
   "pron": "ka-le-fak-THYON",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It ends in -ción: accent on the ó. It is used in winter; in summer there is air conditioning.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "ascensor",
   "significado": "lift",
   "pron": "as-then-SOR",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "The stress falls at the end: as-then-SOR. You say «subir en ascensor».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "gastos",
   "significado": "charges, expenses",
   "pron": "GAS-tos",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It is almost always plural. «Gastos incluidos» or «gastos no incluidos» says whether they are already in the price.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "fianza",
   "significado": "security deposit",
   "pron": "FYAN-tha",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It is paid at the start and is usually returned at the end if all is well. The z sounds «th».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "contrato",
   "significado": "contract",
   "pron": "kon-TRA-to",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "You say «firmar el contrato». Read it carefully before signing.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "dueño",
   "significado": "owner, landlord",
   "pron": "DWE-nyo",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It changes: «dueño», «dueña». The ñ sounds ny: DWE-nyo.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "al mes",
   "significado": "per month",
   "pron": "al mes",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It says how often something is paid: «750 euros al mes». «Por mes» is also heard.",
   "nota": "",
   "oculta": false
  },
  {
