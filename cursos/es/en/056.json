 "intro": "Quantity words change or stay the same depending on what comes after them.",
 "palabras": [
  {
   "palabra": "mucho",
   "significado": "a lot (of), much",
   "pron": "MU-cho",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Before a noun it changes: «mucho trabajo», «mucha gente». After a verb it does not: «trabajo mucho».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "poco",
   "significado": "little, not much",
   "pron": "PO-ko",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Poco dinero» says there is not enough; «un poco de dinero» says there is some available.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "bastante",
   "significado": "quite a lot (of), enough",
   "pron": "bas-TAN-te",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It does not change for gender: «bastante gente», «bastante dinero». The plural is «bastantes amigos».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "demasiado",
   "significado": "too, too much",
   "pron": "de-ma-SYA-do",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Before an adjective it does not change: «demasiado caro». Before a noun it does: «demasiada gente».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "muchas",
   "significado": "many (feminine)",
   "pron": "MU-chas",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It goes with feminine plural nouns: «muchas horas», «muchas casas». The ch sounds as in «chocolate».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "pocos",
   "significado": "few",
   "pron": "PO-kos",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It goes with masculine plural nouns: «pocos amigos», «pocos coches». It is the opposite of «muchos».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "la gente",
   "significado": "people",
   "pron": "la HEN-te",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "In Spanish it is singular: «la gente es simpática», not «la gente son simpáticas».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "el tiempo",
   "significado": "time",
   "pron": "el TYEM-po",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It also means the weather: «hace buen tiempo». The rest of the sentence tells you which one.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "el dinero",
   "significado": "money",
   "pron": "el di-NE-ro",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "In everyday use it is singular: «mucho dinero», «poco dinero».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "el ruido",
   "significado": "noise",
   "pron": "el RWI-do",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "The r at the start sounds strong, like «rr». The opposite of ruido is «silencio».",
   "nota": "",
   "oculta": false
  },
  {
