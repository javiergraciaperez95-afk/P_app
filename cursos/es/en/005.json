 "titulo": {
  "estudio": "Del once al cien",
  "alumno": "From eleven to one hundred"
 },
 "intro": "You already know zero to ten. From eleven on, some numbers are new words and others are joined together. From thirty-one to ninety-nine you write «y» between the tens and the units.",
 "palabras": [
  {
   "palabra": "once",
   "significado": "eleven",
   "pron": "ON-the",
   "ipa": "",
   "cat": "numeral",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It's written with c, but it sounds like th: «onthe».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "doce",
   "significado": "twelve",
   "pron": "DO-the",
   "ipa": "",
   "cat": "numeral",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Like «once», the c sounds like th in Spain.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "trece",
   "significado": "thirteen",
   "pron": "TRE-the",
   "ipa": "",
   "cat": "numeral",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Don't confuse it with «treinta», which is thirty.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "catorce",
   "significado": "fourteen",
   "pron": "ka-TOR-the",
   "ipa": "",
   "cat": "numeral",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The stressed syllable is «tor».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "quince",
   "significado": "fifteen",
   "pron": "KIN-the",
   "ipa": "",
   "cat": "numeral",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It's written with qu, but the u is not pronounced.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "dieciséis",
   "significado": "sixteen",
   "pron": "dye-thi-SEIS",
   "ipa": "",
   "cat": "numeral",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It's the only one in its series with an accent: dieciséis, but diecisiete.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "veinte",
   "significado": "twenty",
   "pron": "BEYN-te",
   "ipa": "",
   "cat": "numeral",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From veinte come veintiuno, veintidós… all joined, in one word.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "veintitrés",
   "significado": "twenty-three",
   "pron": "beyn-ti-TRES",
   "ipa": "",
   "cat": "numeral",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It's written as one word and with an accent on «trés».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "treinta",
   "significado": "thirty",
   "pron": "TREYN-ta",
   "ipa": "",
   "cat": "numeral",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The diphthong «ei» sounds like «ey».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "cuarenta",
   "significado": "forty",
   "pron": "kwa-REN-ta",
   "ipa": "",
   "cat": "numeral",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Careful: it's written «cuarenta», with u, not «quarenta».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "cincuenta",
   "significado": "fifty",
   "pron": "thin-KWEN-ta",
   "ipa": "",
   "cat": "numeral",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It's «cinco» + «cuenta», in a single word.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "cien",
   "significado": "one hundred",
   "pron": "THYEN",
   "ipa": "",
   "cat": "numeral",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Before a noun you say «cien»; «ciento» is used in 101 and above.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "años",
   "significado": "years",
   "pron": "A-nyos",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "The eñe sounds «ny».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "cuántos",
   "significado": "how many",
   "pron": "KWAN-tos",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It takes an accent when it asks about a quantity.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "alumnos",
   "significado": "pupils",
   "pron": "a-LUM-nos",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "Plural of «alumno». Here it means the students sitting in the class.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "traído",
   "significado": "brought (traer)",
   "pron": "tra-I-do",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The accent on «í» splits the vowels: say «tra-í-do» in three clear syllables.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "caja",
   "significado": "box",
   "pron": "KA-ha",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The «j» sounds like a soft «h», so say «caja» as KA-ha.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "botones",
   "significado": "buttons",
   "pron": "bo-TO-nes",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "Plural of «botón». The strong beat falls on the middle syllable: bo-TO-nes.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "colores",
   "significado": "colours",
   "pron": "ko-LO-res",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "Plural of «color». The stressed syllable is «lo»: co-LO-res.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "cuente",
   "significado": "count (contar)",
   "pron": "KWEN-te",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Subjunctive of «contar». After «pide que», Spanish uses this form instead of «cuenta».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "respira",
   "significado": "breathes (respirar)",
   "pron": "res-PI-ra",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «respirar». Say it slowly, res-PI-ra, as if you breathe between the syllables.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "hondo",
   "significado": "deeply",
   "pron": "ON-do",
   "ipa": "",
   "cat": "adverb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Same family as «fondo». Think of breathing all the way down, to the bottom of you.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "continúa",
   "significado": "goes on (continuar)",
   "pron": "kon-ti-NU-a",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The accent on «ú» marks the stress: kon-ti-NU-a, in four syllables. It comes from «continuar».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "contando",
   "significado": "counting (contar)",
   "pron": "kon-TAN-do",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The gerund ends in «-ando», for an action that is still going on.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "prisa",
   "significado": "hurry",
   "pron": "PRI-sa",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "Usually comes with «tener»: «tener prisa». The stress falls on PRI, the first syllable.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "escucha",
   "significado": "hears (escuchar)",
   "pron": "es-KU-cha",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «escuchar». The «cu» sounds like «k», and the final «cha» like «ch».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "setenta",
   "significado": "seventy",
   "pron": "se-TEN-ta",
   "ipa": "",
   "cat": "numeral",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Built from «siete» with the ending «-enta», like «sesenta» and «cuarenta».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "repartidos",
   "significado": "spread out (repartir)",
   "pron": "re-par-TI-dos",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The «-ido» ending marks a participle, here used like an adjective for «botones».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "ocasión",
   "significado": "occasion",
   "pron": "o-ka-SYON",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "«ocasión» ends in «-ón» with the accent. «ca» is «ka», and the stress lands on «-sión».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "salta",
   "significado": "skips (saltar)",
   "pron": "SAL-ta",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Same root as «salto». The stress falls on the first syllable: SAL-ta.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "tiza",
   "significado": "chalk",
   "pron": "TI-tha",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The «z» sounds like a soft «th», and the stress falls on the first syllable «TI».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "cifra",
   "significado": "figure (number)",
   "pron": "THI-fra",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The «ci» sounds like «thi», and the stress falls on the first syllable: THI-fra.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "vacía",
   "significado": "empty",
   "pron": "ba-THI-a",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It agrees with the feminine «caja», so it ends in «-a». The accent on «í» marks the stress.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "comprende",
   "significado": "understands (comprender)",
   "pron": "kom-PREN-de",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «comprender». The «pr» group is hard at first, so go slowly: kom-PREN-de.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "forma",
   "significado": "a way",
   "pron": "FOR-ma",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "Feminine: «una forma», «la forma». It also means shape, the outline of something.",
   "nota": "",
   "oculta": false
  }
