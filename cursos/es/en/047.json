 "titulo": {
  "estudio": "Habla más despacio",
  "alumno": "Speak more slowly"
 },
 "intro": "The «tú» command: how to ask a friend for something in class.",
 "palabras": [
  {
   "palabra": "habla",
   "significado": "speak!",
   "pron": "A-bla",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "To give an order to «tú», use the «él» form: «habla», not «hablas».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "come",
   "significado": "eat!",
   "pron": "KO-me",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is the same as «él come». Between friends it sounds kind: «come despacio».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "escribe",
   "significado": "write!",
   "pron": "es-KRI-be",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Same as «él escribe». The b sounds soft: «es-KRI-be».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "escucha",
   "significado": "listen!",
   "pron": "es-KU-cha",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Same as «él escucha». The ch sounds as in «chocolate».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "ven",
   "significado": "come!",
   "pron": "ben",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is irregular: «venir» gives «ven», not «vene». Learn it as a whole.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "haz",
   "significado": "do / make!",
   "pron": "ath",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is irregular: «hacer» gives «haz». The z sounds «th» in Spain.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "mira",
   "significado": "look!",
   "pron": "MI-ra",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It draws attention: «mira, un perro». It is regular.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "repite",
   "significado": "repeat!",
   "pron": "re-PI-te",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Very useful in class: «repite, por favor» when you do not understand.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "más despacio",
   "significado": "more slowly",
   "pron": "mas des-PA-thyo",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It goes with «habla»: «habla más despacio». The opposite is «más rápido».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "por favor",
   "significado": "please",
   "pron": "por fa-BOR",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It softens any order. It can go at the start or at the end.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "no hables",
   "significado": "don't speak",
   "pron": "no A-bles",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "With «no» the command changes: «habla» becomes «no hables».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "así",
   "significado": "like this, this way",
   "pron": "a-SI",
   "ipa": "",
   "cat": "adverb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The tilde falls on the «í»: «a-SI». Without it, the stress would move to the first syllable.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "escribas",
   "significado": "(you) write (escribir), in «no escribas» = don't write",
   "pron": "es-KRI-bas",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «escribir»: after «no» it changes to «escribas», not «escribes». It tells «tú» not to do it.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "luz",
   "significado": "light",
   "pron": "luth",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "In Spain the «z» sounds like «th»: «luth». In the plural it becomes «luces».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "dorada",
   "significado": "golden",
   "pron": "do-RA-da",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Feminine of «dorado», from «dorar», which is related to «oro» (gold). Stress «RA»: «do-RA-da».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "toca",
   "significado": "touches (tocar)",
   "pron": "TO-ka",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «tocar». The «c» before «a» is a hard «k»: «TO-ka». The same verb also means to play an instrument.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "cuadernos",
   "significado": "notebooks",
   "pron": "kwa-DER-nos",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "Stress «DER»: «kwa-DER-nos». The «cua» sounds like «kwa». The singular is «el cuaderno».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "sacan",
   "significado": "take out (sacar)",
   "pron": "SA-kan",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «sacar». The «c» before «a» is a hard «k»: «SA-kan». The ending «-an» is for «ellos».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "lápices",
   "significado": "pencils",
   "pron": "LA-pi-thes",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "The singular is «lápiz»; in the plural the «z» becomes «c»: «lápices». The tilde stays on «LA».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "silencio",
   "significado": "silence",
   "pron": "si-LEN-thyo",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "In Spain the «c» before «i» sounds like «th»: «si-LEN-thyo». «En silencio» means quietly.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "pájaro",
   "significado": "bird",
   "pron": "PA-ha-ro",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "The tilde is on the first syllable, and the «j» sounds like an «h»: «PA-ha-ro».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "pablo",
   "significado": "Pablo (a man's name)",
   "pron": "PA-blo",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "A man's name; names start with a capital letter in Spanish: «Pablo». Say it «PA-blo».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "camino",
   "significado": "path, way",
   "pron": "ka-MI-no",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "Stress «MI»: «ka-MI-no». It is related to «caminar», to walk. «Un camino de letras» is a trail of letters.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "redondas",
   "significado": "round",
   "pron": "rre-DON-das",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Feminine plural of «redondo». The first «r» is strong: «rre-DON-das». Use «redondo» for round things.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "hables",
   "significado": "(you) speak (hablar), in «no hables» = don't speak",
   "pron": "A-bles",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «hablar»: after «no» it becomes «hables», not «hablas». The «h» is silent: «A-bles».",
   "nota": "",
   "oculta": false
  }
 ],
