   "pron": "KU-bos",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "Plural of «cubo». The c before u sounds like «k».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "riendo",
