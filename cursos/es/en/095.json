         "verb head"
        ],
        [
         "muy buen tiempo",
         "direct object"
        ],
        [
         "muy",
         "adverb head"
        ],
        [
         "buen",
         "adjunct"
        ],
        [
         "tiempo",
         "noun head"
        ]
       ],
       "parrafo": 0
