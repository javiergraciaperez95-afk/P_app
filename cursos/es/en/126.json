 "titulo": {
  "estudio": "Tenga, haga, vaya",
  "alumno": "Irregular subjunctives: tenga, haga, vaya"
 },
 "intro": "The subjunctive starts from the «yo» form; six verbs have their own forms.",
 "palabras": [
  {
   "palabra": "tener",
   "significado": "to have",
   "pron": "te-NER",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «tengo» comes «tenga, tengas, tenga…»: the g of the «yo» form passes to the whole subjunctive.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "hacer",
   "significado": "to do; to make",
   "pron": "a-THER",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Hago» gives «haga, hagas…». The c of the infinitive disappears: now it is a g.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "decir",
   "significado": "to say; to tell",
   "pron": "de-THIR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Digo» gives «diga, digas…». The e of «decir» becomes i and a g appears.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "salir",
   "significado": "to go out; to leave",
   "pron": "sa-LIR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Salgo» gives «salga, salgas…». It is the same g that «tener» and «venir» have.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "ir",
   "significado": "to go",
   "pron": "ir",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It does not follow the «yo» form: «voy» but «vaya, vayas». It is one of the six rebels.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "ser",
   "significado": "to be",
   "pron": "ser",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Another rebel: «soy» but «sea, seas». You have to memorise it.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "saber",
   "significado": "to know (a fact)",
   "pron": "sa-BER",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Sé» but «sepa, sepas». With a clear p; it does not look like «sabe».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "dar",
   "significado": "to give",
   "pron": "dar",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Dé» has an accent so it is not confused with «de». The others: «des, dé, demos, deis, den».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "conocer",
   "significado": "to know (a person or place)",
   "pron": "ko-no-THER",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Conozco» gives «conozca, conozcas…». The c sounds like th: «ko-NOTH-ka».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "médico",
   "significado": "doctor",
   "pron": "ME-di-ko",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It has an accent on the first e. For a woman: «la médica».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "grave",
   "significado": "serious",
   "pron": "GRA-be",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It works for a man and a woman. If something «no es grave», there is no need to worry.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "razón",
   "significado": "reason; being right",
   "pron": "rra-THON",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "«Tener razón» means being correct. In English you say «to be right».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "vayas",
   "significado": "you go (ir)",
   "pron": "BA-yas",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Subjunctive of «ir» for tú. It is irregular: it does not come from «voy». The v sounds b.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "tengas",
   "significado": "you have (tener)",
   "pron": "TEN-gas",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Subjunctive of «tener» for tú. It comes from «tengo»: the g stays.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "sepa",
   "significado": "he / she knows (saber)",
   "pron": "SE-pa",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Subjunctive of «saber» for yo, él or usted. It is one of the six irregular ones.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "esté",
   "significado": "he / she is (estar)",
   "pron": "es-TE",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Subjunctive of «estar» for yo, él or usted. The accent separates it from «este» (this).",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "salgas",
   "significado": "you leave (salir)",
   "pron": "SAL-gas",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Subjunctive of «salir» for tú. It comes from «salgo»: «salgo» → «salgas».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "conozcas",
   "significado": "you meet; you know (conocer)",
   "pron": "ko-NOTH-kas",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Subjunctive of «conocer» for tú. It comes from «conozco»: the c and z sound th.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "des",
   "significado": "you give (dar)",
   "pron": "des",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Subjunctive of «dar» for tú. It has no accent. «Dé» (él) has one so it is not «de».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "hojea",
   "significado": "flicks through (hojear)",
   "pron": "o-HE-a",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «hoja» (page): to turn the pages quickly. The h is silent and the j sounds h.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "anciana",
   "significado": "elderly woman",
   "pron": "an-THYA-na",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The c sounds th: «an-THYA-na». The masculine is «anciano». It is a respectful word.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "baldosas",
   "significado": "floor tiles",
   "pron": "bal-DO-sas",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The singular is «baldosa». You say «suelo de baldosas» for a floor covered with tiles.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "hagas",
   "significado": "you do; you make (hacer)",
   "pron": "A-gas",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Subjunctive of «hacer» for tú. It comes from «hago»; the h is silent: «A-gas».",
   "nota": "",
   "oculta": false
  }
 ],
