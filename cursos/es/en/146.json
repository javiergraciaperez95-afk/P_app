 "intro": "Connectors to organise a longer opinion: start, add, contrast and close.",
 "palabras": [
  {
   "palabra": "en primer lugar",
   "significado": "first of all",
   "pron": "en pri-MER lu-GAR",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It opens a series of ideas. Then you can continue with «en segundo lugar» or «además».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "además",
   "significado": "besides; what is more",
   "pron": "a-de-MAS",
   "ipa": "",
   "cat": "adverb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It adds an idea in the same direction. It usually starts a sentence, with a comma: «Además, es barato».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "por un lado",
   "significado": "on the one hand",
   "pron": "por un LA-do",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It almost always goes with «por otro lado»: «por un lado… por otro lado…».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "por otro lado",
   "significado": "on the other hand",
   "pron": "por O-tro LA-do",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It presents the other side of the same thing. Sometimes it contrasts and sometimes it adds.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "sin embargo",
   "significado": "however",
   "pron": "sin em-BAR-go",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It marks a contrast with what came before. It is two words, followed by a comma.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "en cambio",
   "significado": "on the other hand; whereas",
   "pron": "en KAM-byo",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It compares two different things or people: «él lee; ella, en cambio, escribe».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "por eso",
   "significado": "that is why",
   "pron": "por E-so",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It gives the result of what you have just said. It is written as two words.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "en resumen",
   "significado": "in short",
   "pron": "en rre-SU-men",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It closes a text with the main idea. It is similar to «en conclusión».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "creo que",
   "significado": "I think that",
   "pron": "KRE-o ke",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It gives your opinion. When you affirm, the next verb is indicative: «creo que es buena idea».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "en mi opinión",
   "significado": "in my opinion",
   "pron": "en mi o-pi-NYON",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is used to give your point of view. It starts the sentence, followed by a comma.",
   "nota": "",
   "oculta": false
  },
