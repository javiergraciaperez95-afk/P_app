   "pron": "a-kwer-DAS",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Present of «acordarse», for «tú». It means you remember.",
   "nota": "",
   "oculta": false
  },
  {
