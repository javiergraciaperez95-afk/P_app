   "significado": "the letter h",
   "pron": "la A-che",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The letter h. In Spanish it never sounds.",
   "nota": "",
   "oculta": false
  },
  {
