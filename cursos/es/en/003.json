   "significado": "you say, it's said",
   "pron": "se DI-the",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It's used to ask what something is called.",
   "nota": "",
   "oculta": false
  },
  {
