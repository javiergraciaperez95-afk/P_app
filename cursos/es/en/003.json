   "significado": "the letter j",
   "pron": "la HO-ta",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The letter j. It sounds like a rougher English h.",
   "nota": "",
   "oculta": false
  },
  {
