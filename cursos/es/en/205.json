 "intro": "The perfect subjunctive: «haya» plus the participle, for something that should already have happened.",
 "palabras": [
  {
   "palabra": "haya",
   "significado": "have (haber), subjunctive",
   "pron": "A-ya",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It always goes with a participle: «haya llegado». The h is silent: A-ya.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "hayas",
   "significado": "you have (haber), subjunctive",
   "pron": "A-yas",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is the tú form: «espero que hayas llegado». With the participle it forms the perfect subjunctive.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "hayamos",
   "significado": "we have (haber), subjunctive",
   "pron": "a-YA-mos",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is the nosotros form: «ojalá hayamos acertado». The stress falls on «ya».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "hayan",
   "significado": "they have (haber), subjunctive",
   "pron": "A-yan",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is the form for ellos and ustedes: «no creo que hayan salido». The initial h is silent.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "me extraña que",
   "significado": "it surprises me that",
   "pron": "me eks-TRA-nya ke",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It expresses surprise and asks for the subjunctive: «me extraña que no haya llamado».",
   "nota": "",
   "oculta": false
  },
  {
