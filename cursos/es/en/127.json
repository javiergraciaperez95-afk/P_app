   "nota": "",
   "oculta": false
  },
  {
   "palabra": "que descanses",
   "significado": "rest well",
   "pron": "ke des-KAN-ses",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It comes from «descansar». The c sounds like k before a: «des-KAN-ses».",
