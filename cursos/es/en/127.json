 "intro": "Hopes and good wishes: ojalá, espero que, and the short wishes that begin with que.",
 "palabras": [
  {
   "palabra": "ojalá",
   "significado": "I hope; if only",
   "pron": "o-ha-LA",
   "ipa": "",
   "cat": "interjection",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It always takes the subjunctive: «ojalá haga sol». It is a word of Arabic origin.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "esperar que",
   "significado": "to hope that",
   "pron": "es-pe-RAR ke",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "With another person, subjunctive: «espero que vengas». With the same one, infinitive: «espero venir».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "que te mejores",
   "significado": "get well soon",
   "pron": "ke te me-HO-res",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "You say it to someone ill. It is a wish, so it has «que» and the subjunctive.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "que aproveche",
   "significado": "enjoy your meal",
   "pron": "ke a-pro-BE-che",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "You say it when passing people eating. The v sounds like b: «a-pro-BE-che».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "que tengas suerte",
   "significado": "good luck",
   "pron": "ke TEN-gas SWER-te",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It fits before an exam. You can also say «buena suerte».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "que lo pases bien",
   "significado": "have a good time",
   "pron": "ke lo PA-ses byen",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
