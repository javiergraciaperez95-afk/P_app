 "intro": "Jewellery, keepsakes and the things that go in a toilet bag.",
 "palabras": [
  {
   "palabra": "joya",
   "significado": "jewel, piece of jewellery",
   "pron": "HO-ya",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The j sounds like an h: «HO-ya». The shop where they are sold is called «joyería».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "anillo",
   "significado": "ring",
   "pron": "a-NI-yo",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "The double l sounds like «y»: a-NI-yo. A wedding ring is called «alianza».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "collar",
   "significado": "necklace",
   "pron": "ko-YAR",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "The double l sounds «y»: ko-YAR. It is also the band a dog wears round its neck.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "pendientes",
   "significado": "earrings",
   "pron": "pen-DYEN-tes",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It is almost always plural: «unos pendientes». A single piece is «un pendiente».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "pulsera",
   "significado": "bracelet",
   "pron": "pul-SE-ra",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It comes from «pulso» (pulse): the bracelet goes round the wrist, where you feel the pulse.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "oro",
   "significado": "gold",
   "pron": "O-ro",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "To say what material something is made of, use «de»: «un anillo de oro».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "plata",
   "significado": "silver",
   "pron": "PLA-ta",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "In many countries of Latin America «plata» also means «money».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "recuerdo",
   "significado": "keepsake, souvenir; memory",
   "pron": "rre-KWER-do",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It has two meanings: what you remember and the object you keep. It comes from «recordar».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "perfume",
   "significado": "perfume",
   "pron": "per-FU-me",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It is masculine: «el perfume». The stress is on the syllable «fu»: per-FU-me.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "peine",
   "significado": "comb",
   "pron": "PEI-ne",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It has the diphthong «ei»: PEI-ne. The verb is «peinar» or «peinarse».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "secador",
   "significado": "hairdryer",
   "pron": "se-ka-DOR",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It comes from «secar» (to dry). You say «secador de pelo» or just «secador».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "tirita",
   "significado": "plaster, band-aid",
   "pron": "ti-RI-ta",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It comes from «tira» (strip). In parts of Latin America people say «curita».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "pintarse",
   "significado": "to put on make-up",
   "pron": "pin-TAR-se",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "With body parts you use the article: «me pinto los labios», not «mis labios».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "bolsa de aseo",
   "significado": "toilet bag",
   "pron": "BOL-sa de a-SE-o",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "«Aseo» is personal hygiene. On a trip, all your bathroom things go in the «bolsa de aseo».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "metido",
   "significado": "put in (from «meter»)",
   "pron": "me-TI-do",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Past participle of «meter»; «has metido» means you have put something in.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "llevar",
   "significado": "to wear / to carry",
   "pron": "ye-BAR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Llevar» means both carrying and wearing something on the body.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "perderlo",
   "significado": "to lose it",
   "pron": "per-DER-lo",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "With the pronoun attached: «perder» plus «lo» gives «perderlo».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "déjalo",
   "significado": "leave it (informal command)",
   "pron": "DE-ha-lo",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Informal command of «dejar»; the accent goes on the é of «déjalo».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "daño",
   "significado": "harm, pain",
   "pron": "DA-nyo",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
