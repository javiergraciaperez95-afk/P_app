   "nota": "",
   "oculta": false
  },
  {
   "palabra": "mete",
   "significado": "put in (informal command)",
   "pron": "ME-te",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Informal command of «meter»: it means put in.",
   "nota": "",
   "oculta": false
  },
  {
