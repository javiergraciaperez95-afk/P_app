     "traduccion": "Hace falta que ____ una foto.",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "traigas",
       "lengua": "estudio",
       "explicacion": "Yes! «Hace falta que» takes the subjunctive; from «traigo» comes «traigas».",
       "correcta": true
      },
      {
       "texto": "traes",
       "lengua": "estudio",
       "explicacion": "«Traes» is the ordinary present: it does not express need.",
       "correcta": false
      },
      {
       "texto": "traer",
       "lengua": "estudio",
       "explicacion": "The infinitive does not work after «que»: a conjugated verb is needed.",
       "correcta": false
      }
