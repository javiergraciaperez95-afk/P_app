 "intro": "Fruit, vegetables and quantities, and how to ask for them at a stall.",
 "palabras": [
  {
   "palabra": "kilo",
   "significado": "kilogram",
   "pron": "KI-lo",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It takes «de» before the product, with no article: «un kilo de tomates».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "medio kilo",
   "significado": "half a kilo",
   "pron": "ME-dyo KI-lo",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "With «kilo» you say «medio»; with «docena», «media»: «media docena».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "docena",
   "significado": "dozen",
   "pron": "do-THE-na",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It is common with eggs: «una docena de huevos». «Media docena» is six.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "litro",
   "significado": "litre",
   "pron": "LI-tro",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It measures liquids: «un litro de leche». For solid things you use the kilo.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "lata",
   "significado": "tin, can",
   "pron": "LA-ta",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "You say «una lata de atún». It is also the container of many soft drinks.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "botella",
   "significado": "bottle",
   "pron": "bo-TE-ya",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The «ll» sounds like y: «bo-TE-ya». You say «una botella de agua».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "lechuga",
   "significado": "lettuce",
   "pron": "le-CHU-ga",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The «ch» sounds as in «chocolate». It is feminine: «una lechuga».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "tomates",
   "significado": "tomatoes",
   "pron": "to-MA-tes",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It is masculine: «un tomate», «unos tomates». The stressed syllable is «ma».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "fresas",
   "significado": "strawberries",
   "pron": "FRE-sas",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "In Spain and Mexico it is «fresa»; in Chile and Argentina, «frutilla».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "huevos",
   "significado": "eggs",
   "pron": "WE-bos",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "The h is silent: «WE-bos». It is masculine: «un huevo», «unos huevos».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "plátanos",
   "significado": "bananas",
   "pron": "PLA-ta-nos",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "In Spain «plátano» is the yellow fruit; in some countries it is «banana».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "zanahorias",
   "significado": "carrots",
   "pron": "tha-na-O-ryas",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The h is silent and is written in the middle: «tha-na-O-rya». It is feminine.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "me pone",
   "significado": "could I have (polite request)",
   "pron": "me PO-ne",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«¿Me pone…?» is a polite request to a seller, with «usted». You can also say «póngame».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "nada más",
   "significado": "nothing else",
   "pron": "NA-da MAS",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "You say it when you finish shopping. With «no»: «no quiero nada más».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "atún",
   "significado": "tuna",
   "pron": "a-TUN",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "The tilde on «ú» marks the stress on the last syllable: «a-TUN».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "lámparas",
   "significado": "lamps",
   "pron": "LAM-pa-ras",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The tilde on the first «a» makes it a word stressed on the third-last syllable: «LAM-pa-ras».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "acomoda",
   "significado": "arranges (acomodar)",
   "pron": "a-ko-MO-da",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Verb «acomodar». The «c» before «o» is hard, like «k».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "dulces",
   "significado": "sweet (pl.)",
   "pron": "DUL-thes",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The «c» before «e» sounds like «th» in Spain. Say «DUL-thes».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "mimbre",
   "significado": "wicker",
   "pron": "MIM-bre",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "The «m» before «b» is still a «m». The word is soft and light.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "lechugas",
   "significado": "lettuces",
   "pron": "le-CHU-gas",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "«ch» is one sound, as in «church». Say «le-CHU-gas».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "huelen",
   "significado": "they smell (oler)",
   "pron": "WE-len",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «oler», but the o becomes «ue»: «huelen». The h is silent.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "rocío",
   "significado": "dew",
   "pron": "ro-THI-o",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "The tilde on «í» breaks the diphthong, so «io» is two syllables: «ro-THI-o».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "piel",
   "significado": "skin, peel",
   "pron": "PYEL",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "«ie» is a diphthong, so it is said as one syllable: «PYEL».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "limones",
   "significado": "lemons",
   "pron": "li-MO-nes",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "Words ending in a vowel or «s» stress the penultimate syllable: «li-MO-nes».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "capa",
   "significado": "layer",
   "pron": "KA-pa",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The «c» before «a» is hard, like «k». Stress is on the first syllable: «KA-pa».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "paja",
   "significado": "straw",
   "pron": "PA-ha",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The j sounds like «h», so it is «PA-ha». Think of straw in a barn.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "cebollas",
   "significado": "onions",
   "pron": "the-BO-yas",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "«ce» is «th» in Spain, and «ll» sounds like «y»: «the-BO-yas».",
