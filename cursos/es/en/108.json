 "intro": "How to order drinks and food to share in a bar, and who pays.",
 "palabras": [
  {
   "palabra": "tomar algo",
   "significado": "to go for a drink or a bite",
   "pron": "to-MAR AL-go",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is used to meet up: «¿Tomamos algo?» can be a coffee or a beer.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "caña",
   "significado": "small draught beer",
   "pron": "KA-nya",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "In Spain you ask for «una caña»; the size changes by area. It sounds «KA-nya».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "tapa",
   "significado": "small portion of food",
   "pron": "TA-pa",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "In many bars in Spain a «tapa» is a small portion eaten with a drink.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "ración",
   "significado": "large portion to share",
   "pron": "rra-THYON",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It is bigger than a tapa. The «ci» sounds «thi»: «rra-THYON».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "refresco",
   "significado": "soft drink",
   "pron": "rre-FRES-ko",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It comes from «refrescar»: a cold drink to quench your thirst.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "barra",
   "significado": "bar counter",
   "pron": "BA-rra",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The «rr» rolls strongly: «BA-rra». You have something «en la barra» or at a table.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "propina",
   "significado": "tip",
   "pron": "pro-PI-na",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It is feminine: «la propina». The amount changes by country and venue.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "vegetariana",
   "significado": "vegetarian (woman)",
   "pron": "be-he-ta-RYA-na",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "A woman says «soy vegetariana»; a man, «soy vegetariano». The v sounds b.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "ricas",
   "significado": "tasty",
   "pron": "RRI-kas",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "With «estar», «rico» talks about taste and agrees: rico, rica, ricos, ricas.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "croquetas",
   "significado": "croquettes",
   "pron": "kro-KE-tas",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "They are often made with ham, chicken or cheese. You ask for «una ración de croquetas».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "picar algo",
   "significado": "to have a nibble",
   "pron": "pi-KAR AL-go",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "With «picar» you eat a little and share: «picamos algo».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "te invito yo",
   "significado": "it's on me",
   "pron": "te in-BI-to YO",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Here «invitar» means paying for someone else. Among friends you also say «hoy invito yo».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "con hielo",
   "significado": "with ice",
   "pron": "kon YE-lo",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The h is silent and the «ie» sounds «ye»: «kon YE-lo».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "sin alcohol",
   "significado": "alcohol-free",
   "pron": "sin al-ko-OL",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is said of drinks: «una cerveza sin alcohol». The word «sin» never changes.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "picamos",
   "significado": "we nibble (picar)",
   "pron": "pi-KA-mos",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«picar» in a bar means to eat small snacks. The «c» before «a» is «k».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "jamón",
   "significado": "ham",
   "pron": "ha-MON",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "The j is «h», so it is «ha-MON». Spain is famous for jamón serrano.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "refrescos",
   "significado": "soft drinks",
   "pron": "rre-FRES-kos",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "Initial «r» is strong, so it is «rre-FRES-kos». It comes from «refrescar».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "vasos",
   "significado": "glasses",
   "pron": "BA-sos",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "The «v» sounds like «b»: «BA-sos». Think of glasses on a bar counter.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "limpios",
   "significado": "clean (pl.)",
   "pron": "LIM-pyos",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
