  },
  {
   "palabra": "estación",
   "significado": "station",
   "pron": "es-ta-THYON",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The accent on «ó» shows the stress is on the last syllable. In the plural it disappears: «estaciones».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "trenes",
   "significado": "trains",
   "pron": "TRE-nes",
