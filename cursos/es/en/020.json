   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "Plural of «tren». Since it ends in a consonant, you add «-es»: «un tren», «dos trenes».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "visitantes",
   "significado": "visitors",
   "pron": "bi-si-TAN-tes",
