   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "With «de» it expresses probability: «debe de estar enfermo». Without «de» it is usually obligation: «debe estudiar».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "lo más probable es que",
