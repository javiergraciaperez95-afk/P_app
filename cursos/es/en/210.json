 "intro": "Guessing about the past: the conditional, the two perfects and «deber de».",
 "palabras": [
  {
   "palabra": "serían",
   "significado": "it must have been (ser)",
   "pron": "se-RI-an",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "With times, the conditional gives an approximate time in the past: «serían las tres».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "sería",
   "significado": "it must have been (ser)",
   "pron": "se-RI-a",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "In the past it serves to guess: «sería el vecino» means «it was probably the neighbour».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "estaría",
   "significado": "he must have been (estar)",
   "pron": "es-ta-RI-a",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It guesses something from the past: «estaría en casa» means «he was probably at home».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "habrá abierto",
   "significado": "must have opened",
   "pron": "a-BRA a-BYER-to",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is a future perfect that guesses: «¿quién la habrá abierto?» asks who may have opened it.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "habría llegado",
   "significado": "would have arrived",
   "pron": "a-BRI-a ye-GA-do",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is the conditional perfect: it guesses something before another past fact. «Ya habría llegado.»",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "deber de",
   "significado": "must (probability)",
