 "titulo": {
  "estudio": "Me puse nervioso",
  "alumno": "I got nervous"
 },
 "intro": "Spanish has several verbs for «become». Each one tells a different kind of change.",
 "palabras": [
  {
   "palabra": "me puse",
   "significado": "I got; I became (for a while)",
   "pron": "me PU-se",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Ponerse» + adjective tells a passing state, often a reaction: «me puse rojo».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "se volvió",
   "significado": "became (a deep change)",
   "pron": "se bol-BYO",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Volverse» + adjective speaks of a lasting change of character: «se volvió muy serio».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "se hizo",
   "significado": "became (profession, belief)",
   "pron": "se I-tho",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Hacerse» + noun tells a choice or a path: «se hizo médica».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "se quedó",
   "significado": "ended up; was left",
   "pron": "se ke-DO",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Quedarse» shows the state you end up in: «se quedó sin trabajo», «me quedé sorprendido».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "se convirtió en",
   "significado": "turned into",
   "pron": "se kon-bir-TYO en",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It always takes «en» and a noun: «se convirtió en una estrella».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "llegó a ser",
   "significado": "came to be; ended up as",
   "pron": "ye-GO a ser",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It tells an achievement after a process: «llegó a ser campeona». The ll sounds like y.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "nervioso",
   "significado": "nervous",
   "pron": "ner-BYO-so",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It changes with the person: «nervioso» for him, «nerviosa» for her. «Ponerse nervioso» is very common.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "famoso",
   "significado": "famous",
   "pron": "fa-MO-so",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The stress is on «MO»: fa-MO-so. It changes with gender: «famoso», «famosa».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "rojo",
   "significado": "red",
   "pron": "RRO-ho",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The initial r sounds strong and the j like h: RRO-ho. «Ponerse rojo» means to blush.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "cantante",
   "significado": "singer",
   "pron": "kan-TAN-te",
   "ipa": "",
   "cat": "noun",
   "genero": "m/f",
   "plural": "",
   "definida": "",
   "consejo": "It works for a man and a woman: «un cantante», «una cantante». Only the article changes.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "estrella",
   "significado": "star",
   "pron": "es-TRE-ya",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The ll sounds like y: es-TRE-ya. It has two meanings: the one in the sky and the famous person.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "médica",
   "significado": "doctor (woman)",
   "pron": "ME-di-ka",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The accent marks the stress: ME-di-ka. For a man, «médico».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "convertido",
   "significado": "turned into (convertir)",
   "pron": "kon-ber-TI-do",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Past participle of «convertir». The «v» sounds like «b».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "campeona",
   "significado": "champion (woman)",
   "pron": "kam-pe-O-na",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "Feminine of «campeón». The ending «-a» shows a woman.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "apagan",
   "significado": "turn off (apagar)",
   "pron": "a-PA-gan",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Apagar» means to turn off. «Se apagan» here means the lights go off.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "foco",
   "significado": "spotlight",
   "pron": "FO-ko",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "A light that shines on one spot of the stage. The «c» sounds like «k».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "pie",
   "significado": "feet (de pie: standing)",
   "pron": "PYE",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "«De pie» means standing up. Say «PYE», with «ie» as one sound.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "manga",
   "significado": "sleeve",
   "pron": "MAN-ga",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The sleeve of a shirt. The «g» before «a» is hard.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "reverencia",
   "significado": "bow",
   "pron": "re-be-REN-thya",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "A respectful bow. The «v» sounds like «b», and «cia» is «thya» in Spain.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "escondía",
   "significado": "used to hide (esconder)",
   "pron": "es-kon-DI-a",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Imperfect of «esconder». It describes a habit in the past.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "aplaudir",
   "significado": "to applaud (aplaudir)",
   "pron": "a-pla-DIR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Infinitive of «aplaudir». It follows «solo pueden», as in «can only applaud».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "quedó",
   "significado": "was left (quedar)",
   "pron": "ke-DO",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Past tense of «quedar», for «él» or «ella». It can mean she was left speechless.",
   "nota": "",
   "oculta": false
  }
