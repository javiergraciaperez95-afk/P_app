   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Subjunctive of «vivir» for yo or él. The v sounds like b: «BI-ba».",
   "nota": "",
   "oculta": false
  },
