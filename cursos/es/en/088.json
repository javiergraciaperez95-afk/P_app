 "intro": "Polite requests with me gustaría, quería, quisiera and podría, at a hotel desk.",
 "palabras": [
  {
   "palabra": "me gustaría",
   "significado": "I would like",
   "pron": "me gus-ta-RI-a",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Softer than «quiero»: «me gustaría una mesa». Perfect for polite requests.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "quería",
   "significado": "I wanted; I would like (polite)",
   "pron": "ke-RI-a",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Although it looks like past, here it softens the request: «quería una habitación» sounds more polite than «quiero».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "podría",
   "significado": "could you; I could",
   "pron": "po-DRI-a",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "With usted, «¿podría ayudarme?» is more polite than «¿puede ayudarme?».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "quisiera",
   "significado": "I would like (very polite)",
   "pron": "ki-SYE-ra",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is the most elegant form: «quisiera una habitación». You hear it a lot in hotels and shops.",
   "nota": "",
   "oculta": false
  },
  {
