 "intro": "Reading a formal letter: what it promises, what conditions it sets and how caution sounds.",
 "palabras": [
  {
   "palabra": "reclamación",
   "significado": "complaint, claim",
   "pron": "rre-kla-ma-THYON",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It is feminine and ends in -ción: «la reclamación». The verb is «reclamar».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "justificante",
   "significado": "receipt, proof",
   "pron": "hus-ti-fi-KAN-te",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "You say «justificante de pago». It ends in -e and is masculine: «el justificante».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "tramitar",
   "significado": "to process",
   "pron": "tra-mi-TAR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It comes from «trámite». A company «tramita» a complaint when it handles it.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "plazo",
   "significado": "deadline, time limit",
   "pron": "PLA-tho",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It is masculine: «el plazo». The z sounds like th: PLA-tho. You say «dentro del plazo».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "reembolso",
   "significado": "refund",
   "pron": "rre-em-BOL-so",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It is masculine: «el reembolso». It has two e's in a row because it joins «re-» and «embolso».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "expediente",
   "significado": "file, case file",
   "pron": "eks-pe-DYEN-te",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It is masculine: «el expediente». The x sounds «ks»: eks-pe-DYEN-te.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "si procede",
   "significado": "if applicable",
   "pron": "si pro-THE-de",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is an administrative formula. Here «procede» means «it applies» or «it is appropriate».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "aprobar",
   "significado": "to approve",
   "pron": "a-pro-BAR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The o becomes «ue»: «apruebo». If a refund is approved, it is granted.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "aportar",
   "significado": "to provide, to contribute",
   "pron": "a-por-TAR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "You provide data or documents: «aportar un dato adicional». It is a regular verb.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "implicar",
   "significado": "to imply",
   "pron": "im-pli-KAR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It often goes with «que»: «no implica que…». The c becomes qu before e: «implique».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "confirman",
   "significado": "they confirm (confirmar)",
   "pron": "kon-FIR-man",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«confirmar» means to make sure something is true.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "recepción",
   "significado": "receipt, reception",
   "pron": "rre-thep-THYON",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "From «recibir», to receive. Ends in -ción.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "revisarán",
   "significado": "they will review (revisar)",
   "pron": "rre-bi-sa-RAN",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Future of «revisar», to check carefully.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "harán",
   "significado": "they will do (hacer)",
   "pron": "a-RAN",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Future of «hacer». The h is silent.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "falta",
   "significado": "is missing (faltar)",
   "pron": "FAL-ta",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«faltar» means to be missing or lacking.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "contacto",
   "significado": "contact",
   "pron": "kon-TAK-to",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "«ponerse en contacto» means to get in touch with someone.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "condicional",
   "significado": "conditional",
   "pron": "kon-di-thyo-NAL",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Depends on a condition: «si fuera necesario».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "prudente",
   "significado": "cautious",
   "pron": "pru-DEN-te",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Someone careful. Its opposite is «imprudente».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "confirmamos",
   "significado": "we confirm (confirmar)",
   "pron": "kon-fir-MA-mos",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
