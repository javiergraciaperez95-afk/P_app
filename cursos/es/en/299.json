   "nota": "",
   "oculta": false
  },
  {
   "palabra": "recibido",
   "significado": "received (recibir)",
   "pron": "rre-thi-BI-do",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
