 "titulo": {
  "estudio": "Fiestas y celebraciones",
  "alumno": "Festivals and celebrations"
 },
 "intro": "Birthdays, weddings and important dates of the year in Spain.",
 "palabras": [
  {
   "palabra": "fiesta",
   "significado": "party, festival",
   "pron": "FYES-ta",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "«Estar de fiesta» means having fun. It is also an official day off: «un día de fiesta».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "boda",
   "significado": "wedding",
   "pron": "BO-da",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "You say «ir a una boda». The «novios» are the two people getting married.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "Navidad",
   "significado": "Christmas",
   "pron": "na-bi-DAD",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It takes a capital and is singular: «la Navidad». «Las Navidades» are the whole holiday period.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "Nochebuena",
   "significado": "Christmas Eve",
   "pron": "no-che-BWE-na",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It is written as one word. Many families have a long dinner that night.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "Nochevieja",
   "significado": "New Year's Eve",
   "pron": "no-che-BYE-ha",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It is the «old night», the last of the year. It is written as one word and v sounds like b.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "Reyes Magos",
   "significado": "the Three Kings, 6 January",
   "pron": "RE-yes MA-gos",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It is shortened to «los Reyes»: «el día de Reyes». It is always plural.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "regalar",
   "significado": "to give as a present",
   "pron": "re-ga-LAR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The person who gets the gift goes with «le»: «le regalo flores a mi madre».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "invitar",
   "significado": "to invite",
   "pron": "in-bi-TAR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "You say «invitar a alguien a algo»: «te invito a mi fiesta». It also means paying: «te invito a un café».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "celebrar",
   "significado": "to celebrate",
   "pron": "the-le-BRAR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "You celebrate a birthday or a wedding. The verb is regular: «celebro», «celebras».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "brindar",
   "significado": "to make a toast",
   "pron": "brin-DAR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "You say «brindar por algo»: «brindamos por tu cumpleaños». When toasting you say «¡salud!».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "tarta",
   "significado": "cake",
   "pron": "TAR-ta",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "In Spain it is «tarta»; in many Latin American countries it is «pastel» or «torta».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "velas",
   "significado": "candles",
   "pron": "BE-las",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "On a birthday cake you «blow» the candles. A «vela» is also a boat's sail.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "uvas",
   "significado": "grapes",
   "pron": "U-bas",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "On New Year's Eve people eat twelve «uvas», one with each chime. The u sounds as in «uno».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "felicidades",
   "significado": "congratulations",
   "pron": "fe-li-thi-DA-des",
   "ipa": "",
   "cat": "interjection",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is always plural: «¡felicidades!». It is said on birthdays, at weddings and with good news.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "celebro",
   "significado": "I celebrate (celebrar)",
   "pron": "the-LE-bro",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Verb «celebrar». The c before «e» sounds like «th» in Spain.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "invito",
   "significado": "I invite (invitar)",
   "pron": "im-BI-to",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "In Spanish «v» sounds like «b», so it is «im-BI-to». The infinitive is «invitar».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "brindamos",
   "significado": "we toast (brindar)",
   "pron": "brin-DA-mos",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Brindar» means to raise a glass. The «d» between vowels is soft.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "colocan",
   "significado": "they place (colocar)",
   "pron": "ko-LO-kan",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The «c» before «o» is hard, like «k». The stress falls on «LO».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "abiertos",
   "significado": "open (pl.)",
   "pron": "a-BYER-tos",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«ie» forms a diphthong in an unstressed syllable, so it is «BYER». It comes from «abrir».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "campanadas",
   "significado": "chimes, bell strokes",
   "pron": "kam-pa-NA-das",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It comes from «campana» (bell). On New Year's Eve Spain hears twelve chimes.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "uva",
   "significado": "grape",
   "pron": "U-ba",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The «v» sounds like «b», so it is «U-ba». On New Year's Eve you eat one per chime.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "sabor",
   "significado": "taste, flavour",
   "pron": "sa-BOR",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It ends in the consonant -r, so the stress is on the last syllable: «sa-BOR».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "chocan",
   "significado": "they clink (chocar)",
   "pron": "CHO-kan",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Chocar» also means to clink glasses. The «ch» is a single sound, as in «church».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "pintan",
   "significado": "they paint (pintar)",
   "pron": "PIN-tan",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Here «pintar» means colouring the sky. Think of fireworks lighting up the night.",
   "nota": "",
   "oculta": false
  }
 ],
