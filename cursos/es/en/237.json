  },
  {
   "palabra": "digas",
   "significado": "you say (decir), subjunctive",
   "pron": "DI-gas",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "After «no» and a wish or request, Spanish uses the subjunctive: «digas».",
