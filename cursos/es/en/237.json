  },
  {
   "palabra": "intenta",
   "significado": "tries (intentar)",
   "pron": "in-TEN-ta",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «intentar», to try. Often followed by «no».",
   "nota": "",
