 "capitulo": 1,
 "titulo": {
  "estudio": "¡Hola!",
  "alumno": "Hello!"
 },
 "intro": "First lesson. Today you learn to say hello, to say goodbye and to say thank you in Spanish.",
 "palabras": [
  {
   "palabra": "hola",
   "significado": "hello, hi",
   "pron": "O-la",
   "ipa": "",
   "cat": "interjection",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The h is silent in Spanish: «hola» sounds like «ola».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "adiós",
   "significado": "goodbye",
   "pron": "a-DYOS",
   "ipa": "",
   "cat": "interjection",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It works for any goodbye. The «d» sits in the middle and is soft: «a-DYOS».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "buenos días",
   "significado": "good morning",
   "pron": "BWE-nos DI-as",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It's used from the moment you get up until lunchtime.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "buenas tardes",
   "significado": "good afternoon",
   "pron": "BWE-nas TAR-des",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From after lunch until it gets dark.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "buenas noches",
   "significado": "good evening, good night",
   "pron": "BWE-nas NO-ches",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "When you arrive at night and also when you go to bed.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "gracias",
   "significado": "thank you",
   "pron": "GRA-thyas",
   "ipa": "",
   "cat": "interjection",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "In Spain, c before i or e sounds like the English th; in Latin America it sounds like s.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "de nada",
   "significado": "you're welcome",
   "pron": "de NA-da",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It's the normal answer to «gracias».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "hasta luego",
   "significado": "see you later",
   "pron": "AS-ta LWE-go",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The «h» of «hasta» is silent, so it sounds like «asta»; «luego» means «later».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "qué tal",
   "significado": "how are you?",
   "pron": "ke TAL",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "An informal question about how someone is doing. Same as «¿cómo estás?».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "encantado",
   "significado": "pleased to meet you (a man)",
   "pron": "en-kan-TA-do",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "A man says it when he meets someone. It means «I'm glad to meet you».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "encantada",
   "significado": "pleased to meet you (a woman)",
   "pron": "en-kan-TA-da",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "A woman says it. Only the ending changes: -o / -a.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "muy",
   "significado": "very",
   "pron": "mwi",
   "ipa": "",
   "cat": "adverb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It goes in front: «muy bien», never «bien muy».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "bien",
   "significado": "well, fine",
   "pron": "byen",
   "ipa": "",
   "cat": "adverb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "A single syllable. It has no accent mark.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "y",
   "significado": "and",
   "pron": "i",
   "ipa": "",
   "cat": "conjunction",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It sounds like the letter i. Before a word starting with i it is written «e»: «padre e hijo».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "tú",
   "significado": "you (informal)",
   "pron": "tu",
   "ipa": "",
   "cat": "pronoun",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It takes an accent when it's the pronoun; «tu casa», without one, is possessive.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "salga",
   "significado": "comes up (salir)",
   "pron": "SAL-ga",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «salir». After «antes de que» Spanish uses the subjunctive «salga», not «sale».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "empuja",
   "significado": "pushes (empujar)",
   "pron": "em-PU-ha",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The «j» is a throaty h, not the English «j». Say «em-PU-ha», with the stress on «PU».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "puerta",
   "significado": "door",
   "pron": "PWER-ta",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The «ue» begins with a quick w sound: «PWER-ta». Think of «puerto», which starts the same way.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "huele",
   "significado": "smells (oler)",
   "pron": "WE-le",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «oler», but the o becomes «hue»: «huele», «huelo». The h is silent.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "harina",
   "significado": "flour",
   "pron": "a-RI-na",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The «h» is silent, so the word sounds like it starts with a vowel: «a-RI-na», stress on «RI».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "recién",
   "significado": "freshly (just)",
   "pron": "rre-THYEN",
   "ipa": "",
   "cat": "adverb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Its first «r» is strong: «rre-THYEN». It shortens «recientemente» and goes before a participle, «recién hecho».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "detrás",
   "significado": "behind (detrás de)",
   "pron": "de-TRAS",
   "ipa": "",
   "cat": "preposition",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It usually comes with «de», as in «detrás del mostrador». The stress is on «TRAS», the last syllable.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "mostrador",
   "significado": "counter",
   "pron": "mos-tra-DOR",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It comes from «mostrar», to show things. The ending «-dor» often names the place or tool for an action.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "coloca",
   "significado": "places (colocar)",
   "pron": "ko-LO-ka",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The «c» before «o» sounds like a hard «k»: «ko-LO-ka». The stress falls on the middle «LO».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "barras",
   "significado": "baguettes (barra)",
   "pron": "BA-ras",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "A single «r» between vowels is a light tap of the tongue: «BA-ras». It is the plural of «barra».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "pan",
   "significado": "bread",
   "pron": "PAN",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "Short and firm: «PAN», with an open «a» like the vowel in English «father».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "dice",
   "significado": "says (decir)",
   "pron": "DI-the",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Irregular: «decir» changes its «e» to «i» here. The «c» before «i» sounds like «th» in Spain.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "ella",
   "significado": "she",
   "pron": "E-ya",
   "ipa": "",
   "cat": "pronoun",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The double «ll» sounds like the English «y» in «yes»: «E-ya». The stress is on the first syllable.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "contesta",
   "significado": "answers (contestar)",
   "pron": "kon-TES-ta",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The «c» before «o» sounds like «k», and the stress falls on the middle syllable «TES».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "sonrisa",
   "significado": "smile",
   "pron": "son-RRI-sa",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It comes from «sonreír». After «n», the «r» is strong and trilled: «son-RRI-sa».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "oscura",
   "significado": "dark (feminine)",
   "pron": "os-KU-ra",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It agrees with a feminine noun, as in «la calle oscura». The «c» before «u» sounds like «k».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "parece",
   "significado": "seems (parecer)",
   "pron": "pa-RE-the",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Like «parecer», it works for impressions: «parece bien», «parece que llueve». The «c» before «e» sounds like «th».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "lugar",
   "significado": "place",
   "pron": "lu-GAR",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "The «g» before «a» is hard, like the «g» in «gato». The stress falls on the last syllable.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "esperan",
   "significado": "they wait (esperar)",
   "pron": "es-PE-ran",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Besides «wait», «esperar» also means «hope». The «p» is dry, with no puff of air.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "primeros",
   "significado": "first (plural)",
   "pron": "pri-ME-ros",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The plural of «primero». The single «r» between vowels is light: «pri-ME-ros», stress on «ME».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "vecinos",
   "significado": "neighbours",
   "pron": "be-THI-nos",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "In Spanish «v» sounds like «b», and the «c» before «i» is «th» in Spain: «be-THI-nos».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "bolsillos",
   "significado": "pockets",
   "pron": "bol-SI-yos",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "From «bolso» (bag). The ending «-illo» makes it small, like a little bag. The «ll» sounds like «y».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "protegerse",
   "significado": "to protect oneself (protegerse)",
   "pron": "pro-te-HER-se",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The «g» before «e» sounds like «h»: «pro-te-HER-se». The ending «-se» turns the action back on oneself.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "frío",
   "significado": "cold",
   "pron": "FRI-o",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "The accent on «í» splits the vowels into two syllables: «FRI-o», not one.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "pide",
   "significado": "asks for (pedir)",
   "pron": "PI-de",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Irregular: «pedir» changes its «e» to «i» in this form. The «d» between vowels is soft, almost like «th».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "barra",
   "significado": "baguette",
   "pron": "BA-rra",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The double «rr» is a strong, rolled «r»: «BA-rra». Compare «barras», which has a single light «r».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "charla",
   "significado": "chats (charlar)",
   "pron": "CHAR-la",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The «ch» sounds like the «ch» in English «church». The same word is also a noun, «una charla».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "marcharse",
   "significado": "leaving (marcharse)",
   "pron": "mar-CHAR-se",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Al» plus an infinitive means «when», as in «al marcharse». The «ch» sounds like «ch» in «church».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "despide",
   "significado": "says goodbye (despedirse)",
   "pron": "des-PI-de",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Like «pide», the «e» becomes «i». The «se» in front makes the verb reflexive: «se despide».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "campana",
   "significado": "bell",
   "pron": "kam-PA-na",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The «c» before «a» sounds like «k». Its diminutive, «campanilla», is a smaller version of it.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "suena",
   "significado": "rings (sonar)",
   "pron": "SWE-na",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «sonar», where the o becomes «ue»: «suena», «suenan». The s sounds soft, like «swe».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "veces",
   "significado": "times (dos veces: twice)",
   "pron": "BE-thes",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The plural of «vez». Use «una vez» for once and «dos veces» for twice, as in «a veces».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "prepara",
   "significado": "gets ready (preparar)",
   "pron": "pre-PA-ra",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «preparar». Stress the middle syllable «pa», which sounds close to the English word «prepare».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "otra",
   "significado": "another (one more)",
   "pron": "O-tra",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The feminine form of «otro». Use it with feminine nouns, like «otra bandeja» or «otra vez».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "bandeja",
   "significado": "tray",
   "pron": "ban-DE-ha",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The «j» is a breathy h sound. Stress falls on «de», as in «ban-DE-ha», the tray a waiter carries.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "día",
   "significado": "day",
   "pron": "DI-a",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "The accent on the «i» splits the two vowels: «dí-a». Without it, the word would sound like one syllable.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "empezar",
   "significado": "to begin (empezar)",
   "pron": "em-pe-THAR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "In Spain the z sounds like a soft «th». The stress lands on the last syllable: «em-pe-THAR».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "días",
   "significado": "days (in «buenos días»: good morning)",
   "pron": "DI-as",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "The plural of «día». Say «buenos días» in the morning, roughly until midday, as a greeting.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "señora",
   "significado": "Mrs. (señora Ruiz)",
   "pron": "se-NYO-ra",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The «ñ» sounds like «ny», as in «canyon». Use «señora» with a last name to be polite.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "buenos",
   "significado": "good (in «buenos días»)",
   "pron": "BWE-nos",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "A form of «bueno» used with «días»; before a masculine noun it shortens to «buen», as in «buen día».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "buenas",
   "significado": "good (in «buenas tardes»)",
