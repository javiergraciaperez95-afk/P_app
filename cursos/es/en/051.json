   "significado": "tip, point",
   "pron": "PUN-ta",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "Stress on the first syllable: «PUN-ta». «La punta de los dedos» means the fingertips.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "debajo",
   "significado": "underneath",
   "pron": "de-BA-ho",
   "ipa": "",
   "cat": "adverb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The j sounds like h: «de-BA-ho». The opposite is «encima». With a noun: «debajo de la mesa».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "historia",
   "significado": "story",
   "pron": "is-TO-rya",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
