   "significado": "burns (arder)",
   "pron": "AR-de",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «arder», to burn or glow. Stress on the first syllable: «AR-de». The d is soft.",
