   "oculta": false
  },
  {
   "palabra": "gustan",
   "significado": "are pleasing (gustar)",
   "pron": "GUS-tan",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Plural form: it agrees with the thing you like. «Me gustan los libros» (the books are pleasing to me).",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "antiguos",
   "significado": "old, ancient",
   "pron": "an-TI-gwos",
