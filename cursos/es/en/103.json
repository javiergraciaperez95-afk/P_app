 "intro": "Asking for permission, giving it, refusing it kindly, and reading the signs that forbid things.",
 "palabras": [
  {
   "palabra": "se puede",
   "significado": "may I come in; is it allowed",
   "pron": "se PWE-de",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "At an open door you ask «¿se puede?». Also: «¿se puede aparcar aquí?».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "te importa si",
   "significado": "do you mind if (tú)",
   "pron": "te im-POR-ta si",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is a kind way to ask a friend for permission. After «si» comes the present.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "le importa si",
   "significado": "do you mind if (usted)",
   "pron": "le im-POR-ta si",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is the same with usted. It is the polite form for elders or strangers.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "claro que sí",
   "significado": "of course",
   "pron": "KLA-ro ke SI",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is a kind, clear answer that gives permission. It sounds better than a plain «sí».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "por supuesto",
   "significado": "of course",
   "pron": "por su-PWES-to",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It means «claro». It is said with a smile to give permission.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "adelante",
   "significado": "go ahead, come in",
   "pron": "a-de-LAN-te",
   "ipa": "",
   "cat": "interjection",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "You say it to someone knocking or asking to speak: it means «come in».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "cómo no",
   "significado": "of course",
   "pron": "KO-mo no",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is another kind way of saying yes. It is heard a lot in Latin America.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "está prohibido",
   "significado": "it is forbidden",
   "pron": "es-TA pro-i-BI-do",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Signs say it. An infinitive follows: «está prohibido fumar».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "no se puede",
   "significado": "you can't, not allowed",
   "pron": "no se PWE-de",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It says something is not allowed: «no se puede aparcar». It takes an infinitive.",
   "nota": "",
   "oculta": false
  },
  {
