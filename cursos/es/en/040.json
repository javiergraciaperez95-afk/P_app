   "pron": "KA-si NUN-ka",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Very rarely.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "casi siempre",
