   "significado": "regards",
   "pron": "un sa-LU-do",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is a correct closing for almost everything: neither too cold nor too warm.",
   "nota": "",
   "oculta": false
  },
  {
