   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is used with friends and family. In Spain the z sounds «th»: un a-BRA-tho.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "atentamente",
