 "intro": "How to open and close a message to a friend and an email to someone you do not know.",
 "palabras": [
  {
   "palabra": "estimada",
   "significado": "dear (formal)",
   "pron": "es-ti-MA-da",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is the formal greeting: «Estimada señora Ruiz:». For a man, «estimado». A colon follows.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "querida",
   "significado": "dear (informal)",
   "pron": "ke-RI-da",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is used with friends and family: «Querida Ana:». For a man, «querido».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "le escribo para",
   "significado": "I am writing to (formal)",
   "pron": "le es-KRI-bo PA-ra",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is the usted formula: «Le escribo para pedir información».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "te escribo para",
   "significado": "I am writing to (informal)",
   "pron": "te es-KRI-bo PA-ra",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is the tú formula, for friends: «Te escribo para darte las gracias».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "adjunto",
   "significado": "I attach (from adjuntar)",
   "pron": "ad-HUN-to",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is «adjuntar» in yo: «adjunto mis datos». The j sounds h: ad-HUN-to.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "datos",
   "significado": "details, data",
   "pron": "DA-tos",
