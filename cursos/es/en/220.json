    {
     "tipo": "vocabulario",
     "titulo": "Verbs with two readings",
     "palabras": [
      "decir que",
      "sentir que",
      "insistir en que",
      "recordar que",
      "comprender que",
      "el hecho de que",
      "no digo que",
      "no significa que",
      "preocuparse",
      "confiar en",
      "abrigo"
     ]
    }
   ]
