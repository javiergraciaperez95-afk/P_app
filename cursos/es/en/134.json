   "oculta": false
  },
  {
   "palabra": "escrita",
   "significado": "written (feminine)",
   "pron": "es-KRI-ta",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
