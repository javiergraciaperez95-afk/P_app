 "palabras": [
  {
   "palabra": "ojalá",
   "significado": "I hope; if only",
   "pron": "o-ha-LA",
   "ipa": "",
   "cat": "interjection",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It always asks for the subjunctive. Its tense changes the meaning: hope, unreal wish or regret.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "ojalá hubiera",
   "significado": "if only I had",
   "pron": "o-ha-LA u-BYE-ra",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "With a participle it expresses a regret: what did not happen and you wish had. It equals «I wish I had».",
   "nota": "",
   "oculta": false
  },
  {
