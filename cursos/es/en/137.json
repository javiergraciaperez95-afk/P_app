 "intro": "If you speak of something specific, indicative; if it is something you are looking for or that does not exist, subjunctive.",
 "palabras": [
  {
   "palabra": "buscar",
   "significado": "to look for",
   "pron": "bus-KAR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Before e it is written «qu»: «busque», «busques». That way the c keeps sounding like k.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "necesitar",
   "significado": "to need",
   "pron": "ne-the-si-TAR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The c sounds th: «ne-the-si-TAR». With a person: «necesito a alguien que…».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "alguien que",
   "significado": "someone who",
   "pron": "AL-gyen ke",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "If you do not know who it is, the verb goes in the subjunctive: «busco a alguien que hable chino».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "algo que",
   "significado": "something that",
   "pron": "AL-go ke",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Necesito algo que sea fácil» asks for an undefined thing, hence the subjunctive.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "un lugar donde",
   "significado": "a place where",
   "pron": "un lu-GAR DON-de",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Donde» without an accent joins the sentence. If the place is unknown, subjunctive.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "no hay nadie que",
   "significado": "there is nobody who",
   "pron": "no ai NA-dye ke",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "What does not exist cannot be pointed at: the verb goes in the subjunctive.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "cualquier",
   "significado": "any",
   "pron": "kwal-KYER",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It goes before a noun and drops the final «a» of «cualquiera»: «cualquier piso».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "terraza",
   "significado": "terrace",
   "pron": "te-RRA-tha",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The rr sounds strong in the middle: «te-RRA-tha». It is feminine: «una terraza».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "jardín",
   "significado": "garden",
   "pron": "har-DIN",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "The j sounds h: «har-DIN». The accent marks the last syllable.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "tranquilo",
   "significado": "quiet; calm",
   "pron": "tran-KI-lo",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The «qu» sounds k: «tran-KI-lo». A quiet street is a street without noise.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "céntrico",
   "significado": "central",
   "pron": "THEN-tri-ko",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It ends in -o, so it changes: «céntrica». The accent is on the first syllable.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "permitir",
   "significado": "to allow",
   "pron": "per-mi-TIR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Permitir que» + subjunctive: «no permiten que entren perros».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "alquilar",
   "significado": "to rent",
   "pron": "al-ki-LAR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It serves both the one who pays and the one who lets: «alquilo un piso» or «alquilo mi piso».",
   "nota": "",
   "oculta": false
  },
  {
