   "significado": "flat; apartment",
   "pron": "PI-so",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "In Spain it is the normal word; in other countries you say «departamento» or «apartamento».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "alquile",
   "significado": "rent out (alquilar, subjunctive)",
   "pron": "al-KI-le",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «alquilar», to rent. After «no conozco a nadie que», the subjunctive appears.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "permitan",
   "significado": "allow (permitir, subjunctive)",
   "pron": "per-MI-tan",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «permitir», to allow. After «donde», the subjunctive is used: «permitan».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "parques",
   "significado": "parks",
   "pron": "PAR-kes",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "Green public areas with trees. «Parque» is masculine, so it's «los parques».",
   "nota": "",
   "oculta": false
  },
