 "intro": "How to say what your body feels and how you feel: tengo sed, estoy triste.",
 "palabras": [
  {
   "palabra": "tengo sed",
   "significado": "I need something to drink",
   "pron": "TEN-go sed",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Body sensations take «tener»: «tengo sed». You do not say «estoy sed».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "hambre",
   "significado": "the need to eat",
   "pron": "AM-bre",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It is feminine, but takes «el» because of the sound: «el hambre», but «mucha hambre».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "tengo sueño",
   "significado": "I want to sleep",
