   "nota": "",
   "oculta": false
  },
  {
   "palabra": "preguntó",
   "significado": "asked (preguntar)",
   "pron": "pre-gun-TO",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Past tense of «preguntar», for «él» or «ella». The accent marks the stress.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "siendo",
