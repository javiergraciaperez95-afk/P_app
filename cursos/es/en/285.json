 "intro": "Spanish words that look like English words and mean something else.",
 "palabras": [
  {
   "palabra": "embarazada",
   "significado": "pregnant",
   "pron": "em-ba-ra-THA-da",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Embarazada» is not «embarrassed». To feel embarrassed you say «avergonzado».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "actualmente",
   "significado": "currently, at the moment",
   "pron": "ak-twal-MEN-te",
   "ipa": "",
   "cat": "adverb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It means «now», not «actually». For «actually» you say «en realidad».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "sensible",
   "significado": "sensitive",
   "pron": "sen-SI-ble",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is «sensitive». For English «sensible» (of good judgement) you say «sensato».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "constipado",
   "significado": "having a cold",
   "pron": "kons-ti-PA-do",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "In Spain, «estar constipado» means having a cold. English «constipated» is something else.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "carpeta",
   "significado": "folder",
   "pron": "kar-PE-ta",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It is a «folder», not a «carpet». The floor covering is called «alfombra» or «moqueta».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "librería",
   "significado": "bookshop",
   "pron": "li-bre-RI-a",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It is not «library». To borrow books you go to the «biblioteca».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "éxito",
   "significado": "success",
   "pron": "EK-si-to",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It is «success», not «exit». The way out of a place is called «salida».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "asistir a",
   "significado": "to attend",
   "pron": "a-sis-TIR a",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "You say «asistir a una reunión». For «to assist» you say «ayudar».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "realizar",
   "significado": "to carry out",
   "pron": "rre-a-li-THAR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is «to carry out». For «to realise» you say «darse cuenta de».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "soportar",
   "significado": "to put up with",
   "pron": "so-por-TAR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It means «to put up with». For «to support» you say «apoyar».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "pretender",
   "significado": "to intend",
   "pron": "pre-ten-DER",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is «to intend». For «to pretend» you say «fingir».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "largo",
   "significado": "long",
   "pron": "LAR-go",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is «long», not «large». For «large» you say «grande».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "discutir",
   "significado": "to argue",
   "pron": "dis-ku-TIR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "In everyday use it is «to argue». To chat about a topic you say «hablar de».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "parientes",
   "significado": "relatives",
   "pron": "pa-RYEN-tes",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "They are «relatives», not «parents». Parents are called «padres».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "constipada",
   "significado": "having a cold",
   "pron": "kons-ti-PA-da",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Common in Spain for a bad cold. The stress falls on «PA» and the feminine ending «-da» shows a woman.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "soporta",
   "significado": "puts up with, bears (soportar)",
   "pron": "so-POR-ta",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «soportar», to bear. Think of a pillar that supports weight: the root is «porte».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "entrevistas",
   "significado": "interviews",
   "pron": "en-tre-BIS-tas",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "Plural of «entrevista». The «v» sounds like «b», so it is «en-tre-BIS-tas».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "cuidan",
   "significado": "they look after (cuidar)",
   "pron": "KWI-dan",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «cuidado», care. The «ui» is read as «wi», so the word starts with a «kw» sound.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "pretendo",
   "significado": "I intend (pretender)",
   "pron": "pre-TEN-do",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «pretender», to intend or aim for. The «e» before «nd» keeps its sound.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "asistieron",
   "significado": "they attended (asistir)",
   "pron": "a-sis-TYE-ron",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «asistir», to attend. The «ie» forms a diphthong: «TYE».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "tapas",
   "significado": "covers",
   "pron": "TA-pas",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "Here it means the covers of a book. In Spain «tapas» also means small snacks served with drinks.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "central",
   "significado": "central",
   "pron": "then-TRAL",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The «c» before «e» sounds like «th» in Spain. The stress falls on «TRAL» at the end.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "recorren",
   "significado": "they walk through (recorrer)",
   "pron": "re-KO-rren",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «correr», to run, with «re-» meaning through or across. The «rr» in the middle is strong.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "pasillos",
   "significado": "corridors, aisles",
   "pron": "pa-SI-yos",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "Plural of «pasillo». The «ll» sounds like a «y» in most of Spain.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "inclinada",
   "significado": "tilted, bent",
   "pron": "in-kli-NA-da",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «inclinar», to tilt. The feminine «-a» agrees with «la cabeza», which is feminine.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "extranjera",
   "significado": "foreign",
   "pron": "eks-tran-HE-ra",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The «j» sounds like an English «h», so the stress is on «HE»: «eks-tran-HE-ra».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "librera",
   "significado": "bookseller (woman)",
   "pron": "li-BRE-ra",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "From «libro», book. The ending «-era» names the person who works with that thing.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "agradecida",
   "significado": "grateful",
   "pron": "a-gra-de-THI-da",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «agradecer», to thank. The «c» sounds like «th» here, so «-thi-da».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "llegaba",
   "significado": "was arriving (llegar)",
   "pron": "ye-GA-ba",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «llegar», to arrive. The «ll» sounds like «y» here, and the «-aba» ending is the past tense.",
