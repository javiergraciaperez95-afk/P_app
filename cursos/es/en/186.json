   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It comes from «parte»: «repartir» is to give each one their share.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "campaña",
   "significado": "campaign",
   "pron": "kam-PA-nya",
