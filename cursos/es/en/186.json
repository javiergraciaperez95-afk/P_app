   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The ñ sounds like «ny»: «kam-PA-nya». A clean-up campaign collects rubbish.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "soledad",
   "significado": "loneliness",
   "pron": "so-le-DAD",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It ends in «-dad», like «ciudad». It is feeling alone, even with people around.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "solidario",
   "significado": "supportive; caring",
