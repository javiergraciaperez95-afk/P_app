 "intro": "Check what really supports a survey and whether the headline promises more than the data allows us to claim.",
 "palabras": [
  {
   "palabra": "el dato",
   "significado": "concrete information that has been measured",
   "pron": "el DA-to",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "«Dato» is the piece of information; the plural «datos» is the usual form. You «contrastas» a dato, you check it against other sources.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "la encuesta",
   "significado": "study that asks questions to a group of people",
   "pron": "la en-KWES-ta",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "You «realizas» or «llevas a cabo» a survey; you do not «haces» one in a formal text.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "el encuestado",
   "significado": "person who answers a survey",
   "pron": "el en-kwes-TA-do",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "Feminine: la encuestada. Verb: encuestar.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "el porcentaje",
   "significado": "a part out of a hundred",
   "pron": "el por-then-TA-he",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "Mind the pronunciation: por-then-TA-he. The «j» sounds strong.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "representativo",
   "significado": "that reflects the group studied well",
   "pron": "re-pre-sen-ta-TI-bo",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "You say «representativo de», not «representativo a»: «una muestra representativa de la ciudad».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "concluir",
   "significado": "to reach an idea after analysing the data",
   "pron": "kon-klo-IR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Irregular: concluyo, concluyes. And after «concluir que» the subjunctive is usual if it is a hypothesis.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "la muestra",
   "significado": "group of people or cases that is studied",
   "pron": "la MWES-tra",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "Not to be confused with «la muestra» of a shop or a trade fair.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "el titular",
   "significado": "the large sentence a news item starts with",
   "pron": "el ti-tu-LAR",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It also means «persona que tiene un título». The context makes it clear.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "el sesgo",
   "significado": "an inclination that distorts a result",
   "pron": "el SES-go",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "You say «un sesgo de selección». Verb: sesgar.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "la evidencia",
   "significado": "proof that supports a claim",
   "pron": "la e-vi-DEN-thya",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "In academic Spanish, «evidencia» is required for a strong claim, not an impression.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "usan",
   "significado": "they use (usar)",
   "pron": "U-san",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «usar», to use. The «-an» ending is for «ellos» or «ellas».",
   "nota": "",
   "oculta": false
  },
  {
