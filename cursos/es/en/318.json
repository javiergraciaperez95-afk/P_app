   "significado": "summed up (resumir)",
   "pron": "rre-su-MYO",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «resumir», to summarise. The accent on the «ó» marks the past tense for «él» or «ella».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "respondió",
   "significado": "answered (responder)",
   "pron": "res-pon-DYO",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
