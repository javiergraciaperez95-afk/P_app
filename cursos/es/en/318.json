   "nota": "",
   "oculta": false
  },
  {
   "palabra": "tema",
   "significado": "topic, subject",
   "pron": "TE-ma",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "Though it ends in «-a», «tema» is masculine: «el tema». Remember the article to use it right.",
   "nota": "",
   "oculta": false
  },
  {
