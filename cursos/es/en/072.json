   "significado": "bread",
   "pron": "el pan",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It is masculine, so «el pan» becomes «lo». You never say «la pan».",
   "nota": "",
   "oculta": false
  },
  {
