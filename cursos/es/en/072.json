 "intro": "Lo, la, los and las replace something you already know, so you do not repeat the noun.",
 "palabras": [
  {
   "palabra": "lo",
   "significado": "it or him (direct object)",
   "pron": "lo",
   "ipa": "",
   "cat": "pronoun",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It replaces a masculine noun you already know and goes before the verb: «el pan» → «lo compro».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "la",
   "significado": "her or it (direct object)",
   "pron": "la",
   "ipa": "",
   "cat": "pronoun",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It replaces a feminine noun: «la casa» → «la veo». It is not the article «la» of «la casa».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "los",
   "significado": "them (masculine plural)",
   "pron": "los",
   "ipa": "",
   "cat": "pronoun",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It replaces several masculine things or people: «los libros» → «los busco».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "las",
   "significado": "them (feminine plural)",
   "pron": "las",
   "ipa": "",
   "cat": "pronoun",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It replaces several feminine things or people: «las llaves» → «las tengo».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "veo",
   "significado": "I see (ver)",
   "pron": "BE-o",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It comes from «ver». The two vowels are read separately: BE-o.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "compro",
   "significado": "I buy (comprar)",
   "pron": "KOM-pro",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «comprar». The final o means «yo»: «lo compro» is «I buy it».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "busco",
   "significado": "I look for (buscar)",
   "pron": "BUS-ko",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «buscar». No «a» before a thing, but yes before a person: «busco a Ana».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "tengo",
   "significado": "I have (tener)",
   "pron": "TEN-go",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «tener», irregular only with yo: «tengo», but «tienes», «tiene».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "conozco",
   "significado": "I know (conocer)",
   "pron": "ko-NOTH-ko",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Irregular with yo: «conozco». With a person it takes «a»: «conozco a Ana» or «la conozco».",
   "nota": "",
   "oculta": false
  },
  {
