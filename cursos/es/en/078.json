 "titulo": {
  "estudio": "Tanto como",
  "alumno": "As much as"
 },
 "intro": "Comparing amounts and saying something is equal: more books than, as many hours as, more than a hundred, the same as.",
 "palabras": [
  {
   "palabra": "tanto",
   "significado": "so much, as much",
   "pron": "TAN-to",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "With a noun it changes: «tantos libros», «tantas horas». With a verb it does not: «no gasto tanto como tú».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "tantas",
   "significado": "as many (feminine plural)",
   "pron": "TAN-tas",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It agrees with a feminine plural noun: «tantas horas como tú». «Como» comes after.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "más de",
   "significado": "more than (before a number)",
   "pron": "mas de",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Before a number you use «de», not «que»: «más de cien euros».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "menos de",
   "significado": "less than (before a number)",
   "pron": "ME-nos de",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Like «más de»: «menos de mil euros». It goes before a number.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "el mismo",
   "significado": "the same",
   "pron": "el MIS-mo",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It agrees with the noun: «el mismo horario». «Que» comes after: «el mismo horario que tú».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "la misma",
   "significado": "the same (feminine)",
   "pron": "la MIS-ma",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is feminine: «la misma calle». Plural: «las mismas». It can take «que»: «la misma que tú».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "igual que",
   "significado": "just like",
   "pron": "i-GWAL ke",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It says two things are alike: «sonríe igual que él». It never changes.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "el doble",
   "significado": "twice as much",
   "pron": "el DO-ble",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "You say «el doble de» something: «el doble de pan». It is masculine and singular.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "la mitad",
   "significado": "half",
   "pron": "la mi-TAD",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It is feminine although it ends in -d: «la mitad del pan». You do not say «el mitad».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "ganar",
   "significado": "to earn; to win",
   "pron": "ga-NAR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It works for money and for matches: «gana mil euros» and «gana el partido». It is regular.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "gastar",
   "significado": "to spend",
   "pron": "gas-TAR",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is the opposite of saving: «gasto poco dinero». It is regular.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "el precio",
   "significado": "the price",
   "pron": "el PRE-thyo",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It is read PRE-thyo. Do not mix it up with «aprecio», which means affection.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "el horario",
   "significado": "the schedule, opening hours",
   "pron": "el o-RA-ryo",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It is masculine: «el horario». It is about hours: «el horario de la tienda».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "al mes",
   "significado": "per month",
   "pron": "al mes",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "With money you say «al mes»: «gana mil euros al mes». Also «al día» and «al año».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "gasto",
   "significado": "I spend (gastar)",
   "pron": "GAS-to",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «gastar», to spend money. The -o ending means «I».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "ochocientos",
   "significado": "eight hundred",
   "pron": "o-cho-THYEN-tos",
   "ipa": "",
   "cat": "numeral",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Ocho means eight. The c before e is a «th» in Spain.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "panaderías",
   "significado": "bakeries",
   "pron": "pa-na-de-RI-as",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The í keeps the i and a apart, so say RI-as in two syllables.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "hornea",
   "significado": "bakes (hornear)",
   "pron": "or-NE-a",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «hornear», to bake. The h is silent, and e and a are separate.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "rincones",
   "significado": "corners",
   "pron": "rrin-THO-nes",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "A starting r is strong, and the c before o sounds like «th».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "hombres",
   "significado": "men",
   "pron": "OM-bres",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "Plural of «hombre». The h is silent, the b sounds soft.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "viejos",
   "significado": "old (plural, masculine)",
   "pron": "BYE-hos",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The v sounds like b, and the j sounds like h.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "tantos",
   "significado": "so many",
   "pron": "TAN-tos",
   "ipa": "",
   "cat": "adjective",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Its feminine form is «tantas». Use it to compare amounts.",
   "nota": "",
   "oculta": false
  }
 ],
