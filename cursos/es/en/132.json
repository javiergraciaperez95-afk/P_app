 "intro": "Judgements and possibility take the subjunctive; affirmative certainty takes the indicative.",
 "palabras": [
  {
   "palabra": "es importante que",
   "significado": "it is important that",
   "pron": "es im-por-TAN-te ke",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is a judgement: the next verb goes in the subjunctive. With no subject, use the infinitive: «es importante reciclar».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "es necesario que",
   "significado": "it is necessary that",
   "pron": "es ne-the-SA-ryo ke",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Always subjunctive if you name who acts: «es necesario que todos reciclemos».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "es normal que",
   "significado": "it is normal that",
   "pron": "es nor-MAL ke",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Even if the fact is real, the judgement asks for the subjunctive: «es normal que esté cansado».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "es posible que",
   "significado": "it is possible that",
   "pron": "es po-SI-ble ke",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Possibility is not certainty, so it goes with the subjunctive: «es posible que llueva».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "es una pena que",
   "significado": "it is a pity that",
   "pron": "es U-na PE-na ke",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It expresses regret. With «una» in front: «es una pena que no vengas».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "está bien que",
   "significado": "it is good that",
   "pron": "es-TA byen ke",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It approves something. The opposite is «está mal que». Both ask for the subjunctive.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "es verdad que",
   "significado": "it is true that",
   "pron": "es ber-DAD ke",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It presents something as real, so it goes with the indicative: «es verdad que tienes razón».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "está claro que",
   "significado": "it is clear that",
   "pron": "es-TA KLA-ro ke",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Affirmative certainty: indicative. If you negate («no está claro que»), you move to the subjunctive.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "es evidente que",
   "significado": "it is obvious that",
   "pron": "es e-bi-DEN-te ke",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is spelled with «v»: «e-bi-DEN-te». It goes with the indicative.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "no es verdad que",
   "significado": "it is not true that",
   "pron": "no es ber-DAD ke",
   "ipa": "",
   "cat": "set expression",
   "genero": "",
   "plural": "",
   "definida": "",
