   "pron": "FIN-je",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «fingir». The g before e sounds like a soft h in Spain: FIN-je.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "cruza",
   "significado": "crosses (cruzar)",
   "pron": "KRU-tha",
   "ipa": "",
