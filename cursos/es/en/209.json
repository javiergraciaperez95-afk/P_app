   "significado": "greet (saludar)",
   "pron": "sa-lu-DA-mos",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «saludar», to greet: the «-amos» ending is for nosotros.",
   "nota": "",
   "oculta": false
  },
  {
