   "significado": "looked at (mirar)",
   "pron": "mi-RO",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Past tense of «mirar», he or she. The accent marks the last syllable.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "siguió",
   "significado": "continued (seguir)",
   "pron": "si-GIO",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Past tense of «seguir». The «gu» before i is the sound g, as in «gato»; the stress is at the end.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "llevara",
   "significado": "were (llevar) for, subjunctive",
   "pron": "ye-BA-ra",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "The imperfect subjunctive of «llevar». Here it means «had been here».",
   "nota": "",
   "oculta": false
  },
  {
