 "intro": "Big numbers for prices, years and populations, and the ordinals first, second and third.",
 "palabras": [
  {
   "palabra": "cien",
   "significado": "one hundred",
   "pron": "THYEN",
   "ipa": "",
   "cat": "numeral",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "On its own or before a noun: «cien euros». With another number it changes: «ciento uno».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "ciento",
   "significado": "a hundred (before another number)",
   "pron": "THYEN-to",
   "ipa": "",
   "cat": "numeral",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It covers 101 to 199: «ciento diez», «ciento veinte». Never «ciento y cinco».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "doscientos",
   "significado": "two hundred",
   "pron": "dos-THYEN-tos",
   "ipa": "",
   "cat": "numeral",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It agrees with the noun: «doscientos euros», but «doscientas personas».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "quinientos",
   "significado": "five hundred",
   "pron": "ki-NYEN-tos",
   "ipa": "",
   "cat": "numeral",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "It is irregular: you say «quinientos», never «cincocientos».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "setecientos",
   "significado": "seven hundred",
   "pron": "se-te-THYEN-tos",
   "ipa": "",
   "cat": "numeral",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "You say «setecientos», without the i of «siete». Mind the stress: «se-te-THYEN-tos».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "novecientos",
   "significado": "nine hundred",
   "pron": "no-be-THYEN-tos",
   "ipa": "",
   "cat": "numeral",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "You say «novecientos», not «nuevecientos». Like the other hundreds, it is a single word.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "mil",
   "significado": "a thousand",
   "pron": "mil",
   "ipa": "",
   "cat": "numeral",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Never «un mil». And it does not change: «dos mil», «tres mil».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "un millón",
   "significado": "a million",
   "pron": "un mi-YON",
   "ipa": "",
   "cat": "numeral",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "Before a noun it takes «de»: «un millón de euros».",
   "nota": "",
   "oculta": false
  },
  {
