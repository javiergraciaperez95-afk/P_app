   "significado": "comes in (entrar)",
   "pron": "EN-tra",
   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "From «entrar», a regular -ar verb: «entro», «entras», «entra». The stress falls on the first syllable.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "poemas",
