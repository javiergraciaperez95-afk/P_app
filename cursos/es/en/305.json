   "ipa": "",
   "cat": "verb",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Ends in «-o» for «yo». The stress falls on «KU», as in «escuchas».",
   "nota": "",
   "oculta": false
  },
