 "intro": "Where each word puts its stress, and when to write the accent mark.",
 "palabras": [
  {
   "palabra": "sílaba",
   "significado": "syllable",
   "pron": "SI-la-ba",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "Clap once per syllable: ca-sa is two, mú-si-ca is three.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "tilde",
   "significado": "written accent mark",
   "pron": "TIL-de",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It only goes on vowels and shows where the stress falls: café, árbol.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "fuerza",
   "significado": "strength; here, the stress",
   "pron": "FWER-tha",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "The stressed syllable sounds a little louder and longer.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "palabra",
   "significado": "word",
   "pron": "pa-LA-bra",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "Three syllables, stress on the middle one: pa-LA-bra.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "canción",
   "significado": "song",
   "pron": "kan-THYON",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "It ends in n and the stress is at the end: that is why it has an accent.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "música",
   "significado": "music",
   "pron": "MU-si-ka",
   "ipa": "",
   "cat": "noun",
   "genero": "f",
   "plural": "",
   "definida": "",
   "consejo": "Stress on the first syllable: MÚ-si-ca. Words like this always have an accent.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "café",
   "significado": "coffee; café",
   "pron": "ka-FE",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "Without the accent you would read CA-fe. The accent moves the stress to the end.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "árbol",
   "significado": "tree",
   "pron": "AR-bol",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It ends in l, which asks for final stress, but sounds ÁR-bol: hence the accent.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "final",
   "significado": "end",
   "pron": "fi-NAL",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "It ends in l and the stress is at the end, as expected: no accent needed.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "país",
   "significado": "country",
   "pron": "pa-IS",
   "ipa": "",
   "cat": "noun",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "The accent splits a and i into two syllables: pa-ís.",
   "nota": "",
   "oculta": false
  },
  {
