   "cat": "động từ",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Trước e viết là «gu»: «llegue», «llegues». Nhờ vậy giữ được âm g.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "leer",
