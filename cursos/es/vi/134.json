 "intro": "Thói quen dùng thức chỉ định; sự việc tương lai chưa xảy ra, sau «cuando» hoặc «en cuanto», dùng thức giả định.",
 "palabras": [
  {
   "palabra": "cuando",
   "significado": "khi nào",
   "pron": "KWAN-do",
   "ipa": "",
   "cat": "liên từ",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Không dấu thì nối hai hành động. Có dấu, «¿cuándo?», là câu hỏi.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "en cuanto",
   "significado": "ngay khi",
   "pron": "en KWAN-to",
   "ipa": "",
   "cat": "liên từ",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Cho biết điều gì xảy ra ngay lập tức. Nếu là tương lai, đi với thức giả định: «en cuanto llegue».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "tiempo",
   "significado": "thời gian",
   "pron": "TYEM-po",
   "ipa": "",
   "cat": "danh từ",
   "genero": "m",
   "plural": "",
   "definida": "",
   "consejo": "«Tener tiempo» nghĩa là rảnh rỗi. Cũng có nghĩa là thời tiết: «hace buen tiempo».",
   "nota": "",
   "oculta": false
  },
  {
