   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Sau «entre», «tú» và «yo» được giữ nguyên: «entre tú y yo». Không nói «entre ti y mí».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "según",
   "significado": "theo",
   "pron": "se-GUN",
