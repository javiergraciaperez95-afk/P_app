   "significado": "với bạn",
   "pron": "kon-TI-go",
   "ipa": "",
   "cat": "đại từ",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Là «con» + «ti» gộp thành một từ: «voy contigo». Không nói «con ti» hay «con tú».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "mí",
   "significado": "tôi (sau giới từ)",
   "pron": "mi",
   "ipa": "",
   "cat": "đại từ",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Sau giới từ, «yo» thành «mí»: «para mí». Có dấu sắc; «mi» không dấu nghĩa là “của tôi”.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "ti",
   "significado": "bạn (sau giới từ)",
   "pron": "ti",
   "ipa": "",
   "cat": "đại từ",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Sau giới từ, «tú» thành «ti»: «para ti», «sin ti». Không bao giờ có dấu sắc.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "sí",
   "significado": "bản thân (phản thân)",
   "pron": "si",
   "ipa": "",
   "cat": "đại từ",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "Có dấu sắc là “vâng” và cũng là đại từ phản thân: «habla de sí misma». Không dấu, «si» nghĩa là “nếu”.",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "entre tú y yo",
   "significado": "riêng giữa bạn và tôi",
   "pron": "EN-tre tu i yo",
