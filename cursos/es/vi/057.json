   "pron": "boy",
   "ipa": "",
   "cat": "động từ",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Voy» là dạng yo của «ir» ở thì hiện tại. Viết bằng v nhưng đọc như b.",
   "nota": "",
   "oculta": false
  },
  {
