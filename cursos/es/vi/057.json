   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Van» dùng cho họ và ustedes. Chỉ có «ir» thay đổi: «van a comer».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "a",
   "significado": "từ nhỏ nối «ir» với động từ của kế hoạch",
