   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Vas» dùng với «tú». Với anh ấy hoặc cô ấy thì nói «va».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "va",
   "significado": "anh ấy, cô ấy hoặc ông/bà (usted) đi, sẽ",
