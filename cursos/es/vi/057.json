   "ipa": "",
   "cat": "động từ",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Va» không có h. «Ha» có h là một động từ khác (haber).",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "vamos",
   "significado": "chúng ta đi, chúng ta sẽ",
   "pron": "BA-mos",
   "ipa": "",
   "cat": "động từ",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Vamos a + động từ nguyên mẫu» còn dùng để rủ người khác cùng làm gì đó: «¡Vamos a comer!».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "vais",
   "significado": "các bạn đi, các bạn sẽ (vosotros)",
