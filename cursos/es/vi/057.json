   "ipa": "",
   "cat": "động từ",
   "genero": "",
   "plural": "",
   "definida": "",
   "consejo": "«Vais» chủ yếu dùng ở Tây Ban Nha. Ở châu Mỹ Latin người ta nói «ustedes van».",
   "nota": "",
   "oculta": false
  },
  {
   "palabra": "van",
   "significado": "họ hoặc các vị (ustedes) đi, sẽ",
