     "frases": [
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "工作中遇到「求职」的问题，你会先跟谁商量？",
       "alumno": "If a problem related to «job hunting» comes up at work, who would you talk to first?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
