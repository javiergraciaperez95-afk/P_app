    },
    {
     "tipo": "explicacion",
     "titulo": "Positions",
     "texto": [
      "**上面** is on top; **下面**, under; **里面**, inside; **外面**, outside; **前面**, in front; **后面**, behind; **旁边**, beside; **中间**, in the middle. In English, prepositions also go before the noun, as in «on the table»; in Mandarin, these place words usually go after it."
     ],
     "tutora": ""
    }
