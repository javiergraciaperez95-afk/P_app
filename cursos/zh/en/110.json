       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "要是中间出了问题怎么办？",
