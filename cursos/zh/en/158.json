     "frases": [
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "想改善「医疗服务」，你觉得可以从什么习惯开始？",
       "alumno": "To improve «medical care», which habit do you think is best to start with?",
       "literal": "",
       "estructura": "",
