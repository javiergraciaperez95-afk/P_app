     "frases": [
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "复习「听说读写综合练习」时，你打算先做哪种练习？",
       "alumno": "When reviewing «integrated listening, speaking, reading and writing practice», what kind of practice would you do first?",
