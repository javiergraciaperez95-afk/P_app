     "tipo": "texto",
     "titulo": "Reading: evaluating arguments",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "讨论「让步关系」时，要区分事实、推论和个人立场。",
       "alumno": "When discussing «concession», you must distinguish facts, inferences and personal positions.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "说明证据的来源并回应反例，结论才更有说服力。",
       "alumno": "Explaining where the evidence comes from and responding to counterexamples strengthens the conclusion.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "提出解决办法时，还要考虑它会影响哪些人以及需要哪些资源。",
       "alumno": "When proposing a solution, you must also consider who it will affect and what resources it requires.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "清楚的结论要回应问题，并以具体细节为依据。",
       "alumno": "A clear conclusion answers the question and is based on concrete details.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
