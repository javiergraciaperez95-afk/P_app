{
 "capitulo": 13,
 "titulo_zh": "请求和消息",
 "titulo_es": {
  "@es": "Peticiones y mensajes",
  "@en": "Requests and messages"
 },
 "palabras": {
  "让": {
   "es": "dejar; hacer que; pedir a alguien que",
   "en": "to leave; to do that; to ask someone to",
   "pron": "RÀNG",
   "consejo": {
    "@es": "Va seguido de la persona y de la acción.",
    "@en": "It's followed by the person and the action."
   }
  },
  "希望": {
   "es": "esperar; desear",
   "en": "wait; wish",
   "pron": "XĪWÀNG",
   "consejo": {
    "@es": "Expresa un deseo o una esperanza.",
    "@en": "It expresses a desire or hope."
   }
  },
  "事情": {
   "es": "asunto; cosa que ocurre",
   "en": "subject; what happens",
   "pron": "SHÌQING",
   "consejo": {
    "@es": "Se refiere a un hecho o a un asunto.",
    "@en": "It means a fact or a matter."
   }
  },
  "饭馆": {
   "es": "restaurante",
   "en": "restaurant",
   "pron": "FÀNGUǍN",
   "consejo": {
    "@es": "Es un lugar para comer.",
    "@en": "It's a place to eat."
   }
  },
  "忙": {
   "es": "ocupado/a; estar ocupado/a",
   "en": "to be occupied;",
   "pron": "MÁNG",
   "consejo": {
    "@es": "Describe a alguien que tiene cosas que hacer.",
    "@en": "He describes someone who has things to do."
   }
  },
  "他们": {
   "es": "ellos; ellas",
   "en": "They; they",
   "pron": "TĀMEN",
   "consejo": {
    "@es": "Pronombre plural de tercera persona.",
    "@en": "Third-person plural name."
   }
  },
  "点": {
   "es": "pedir; escoger comida",
   "en": "order; choose food",
   "pron": "DIǍN",
   "consejo": {
    "@es": "En un restaurante es un verbo: pedir un plato.",
    "@en": "In a restaurant it's a verb: order a dish."
   }
  },
  "点菜": {
   "es": "pedir platos; ordenar comida",
   "en": "order dishes; order food",
   "pron": "DIǍN CÀI",
   "consejo": {
    "@es": "Es la expresión habitual en un restaurante.",
    "@en": "It's the usual expression in a restaurant."
   }
  },
  "打电话": {
   "es": "llamar por teléfono",
   "en": "phone calls",
   "pron": "DǍ DIÀNHUÀ",
   "consejo": {
    "@es": "Literalmente, «hacer una llamada».",
    "@en": "Literally, «make a call»."
   }
  },
  "等 一下": {
   "es": "esperar un momento",
   "en": "Wait a minute.",
   "pron": "DĚNG YÍXIÀ",
   "consejo": {
    "@es": "一下 suaviza la petición y marca una duración breve.",
    "@en": "一下 softens the request and marks a short duration."
   }
  },
  "不 忙": {
   "es": "no estar ocupado/a",
   "en": "not to be busy",
   "pron": "BÙ MÁNG",
   "consejo": {
    "@es": "Se usa para contestar si alguien tiene tiempo.",
    "@en": "It's used to answer if anyone has time."
   }
  },
  "帮 个 忙": {
   "es": "hacer un favor; echar una mano",
   "en": "do a favor; give a hand",
   "pron": "BĀNG GÈ MÁNG",
   "consejo": {
    "@es": "Es una forma separable de pedir ayuda.",
    "@en": "It's a separable way to ask for help."
   }
  },
  "一 件 事情": {
   "es": "un asunto; una cosa",
   "en": "a matter; one thing",
   "pron": "YÍ JIÀN SHÌQING",
   "consejo": {
    "@es": "件 cuenta asuntos o cosas.",
    "@en": "件 counts matters or things."
   }
  },
  "让 我 说": {
   "es": "déjame hablar",
   "en": "Let me talk.",
   "pron": "RÀNG WǑ SHUŌ",
   "consejo": {
    "@es": "让 introduce a la persona que hará la acción.",
    "@en": "让 introduces the person who will do the action."
   }
  },
  "希望 你 快乐": {
   "es": "espero que seas feliz",
   "en": "I hope you're happy.",
   "pron": "XĪWÀNG NǏ KUÀILÈ",
   "consejo": {
    "@es": "Expresa un deseo dirigido a otra persona.",
    "@en": "It expresses a wish addressed to another person."
   }
  },
  "给 老师 打电话": {
   "es": "llamar al profesor",
   "en": "call the teacher",
   "pron": "GĚI LǍOSHĪ DǍ DIÀNHUÀ",
   "consejo": {
    "@es": "给 indica a quién se llama.",
    "@en": "给 indicates who it is called."
   }
  }
 },
 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Pedir y permitir",
    "@en": "Ask and allow"
   },
   "texto": [
    {
     "@es": "**让 + persona + verbo** significa «dejar que alguien haga algo» o pedirle que lo haga: **让我说** = deja que hable.",
     "@en": "**让 + persona + verbo** means «let someone do something» or ask you to do it: **让我说** = let me speak."
    },
    {
     "@es": "**点** también significa «pedir» cuando hablamos de comida: **点菜** = pedir platos. No lo confundas con **点** en la hora, ya vista en HSK 1. **帮个忙** es una manera frecuente de pedir un favor.",
     "@en": "**点** also means «order» when we talk about food: **点菜** = order dishes. Don't confuse him with **点** in the hour, already seen in HSK 1. **帮个忙** is a frequent way to ask for a favor."
    }
   ]
  },
