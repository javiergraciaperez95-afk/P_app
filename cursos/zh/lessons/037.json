    "@en": "It presents the action as brief."
   }
  },
  "想 一 想": {
   "es": "pensarlo un momento",
   "en": "think for a moment.",
   "pron": "XIǍNG YÌ XIǍNG",
   "consejo": {
    "@es": "Presenta la acción como breve.",
    "@en": "It presents the action as brief."
   }
  },
  "问 一 问": {
