 "titulo_es": {
  "@es": "Saludos y cortesía",
  "@en": "Greetings and courtesy"
 },
 "palabras": {
  "早上": {
   "es": "mañana (parte del día)",
   "en": "morning (part of the day)",
   "pron": "ZǍOSHANG"
  },
  "上午": {
   "es": "mañana; antes del mediodía",
   "en": "morning; before noon",
   "pron": "SHÀNGWǓ"
  },
  "中午": {
   "es": "mediodía",
   "en": "noon",
   "pron": "ZHŌNGWǓ"
  },
  "下午": {
   "es": "tarde; después del mediodía",
   "en": "after noon;",
   "pron": "XIÀWǓ"
  },
  "晚上": {
   "es": "noche; tarde-noche",
   "en": "night; late-night",
   "pron": "WǍNSHANG"
  },
  "早安": {
   "es": "buenos días",
   "en": "Good morning.",
   "pron": "ZǍO'ĀN"
  },
  "晚安": {
   "es": "buenas noches (al despedirse)",
   "en": "good night (when you say goodbye)",
   "pron": "WǍN'ĀN"
  },
  "大家": {
   "es": "todo el mundo; todos",
   "en": "all;",
   "pron": "DÀJIĀ"
  },
  "您好": {
   "es": "hola (cortés)",
   "en": "Hello (courteous)",
   "pron": "NÍN HǍO"
  },
  "喂": {
   "es": "hola (al teléfono)",
   "en": "Hello (on the phone)",
   "pron": "WÈI"
  },
  "对不起": {
   "es": "lo siento; disculpe",
   "en": "I'm sorry; I'm sorry.",
   "pron": "DUÌBUQǏ"
  },
  "没关系": {
   "es": "no pasa nada",
   "en": "It's okay.",
   "pron": "MÉI GUĀNXI"
  },
  "不客气": {
   "es": "de nada",
   "en": "You're welcome.",
   "pron": "BÚ KÈQI"
  }
