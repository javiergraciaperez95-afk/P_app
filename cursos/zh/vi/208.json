 },
 "intro": "Đơn vị HSK 6: Học từ vựng dành cho sản xuất và công nghiệp, ôn lại cách phát âm và kiểm tra nghĩa do nguồn đưa ra. Luyện tập sự ưu tiên và khuyến nghị với cấu trúc 与其……不如…….",
 "palabras": [],
 "etapas": [
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Đối thoại: so sánh các lựa chọn",
     "frases": [
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "比较商品时，除了价格和质量，你还会根据什么来判断？",
       "alumno": "Khi so sánh sản phẩm, ngoài giá cả và chất lượng, bạn còn dựa vào tiêu chí nào để đánh giá?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "我倾向于从两个角度分析，不过两者的依据并不相同。",
       "alumno": "Tôi nghiêng về việc phân tích từ hai góc nhìn, nhưng cơ sở của hai góc nhìn này không giống nhau.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "哪些证据支持这两种观点？",
       "alumno": "Những dữ liệu nào hỗ trợ từng quan điểm?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "有些数据能说明趋势，却不能代表所有情况。",
       "alumno": "Một số dữ liệu cho thấy xu hướng, nhưng không đại diện cho mọi trường hợp.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "那么结论应该怎样表述？",
       "alumno": "Vậy kết luận nên được diễn đạt thế nào?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "应说明目前能确认什么，也要指出仍待验证的部分。",
       "alumno": "Nên nói rõ những gì hiện có thể xác nhận và chỉ ra phần nào còn cần kiểm chứng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Đọc: so sánh các lựa chọn",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "比较商品时，价格只是一个标准。",
       "alumno": "Khi so sánh sản phẩm, giá chỉ là một tiêu chí.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "还要核对质量、使用条件和售后服务，才能判断它是否真正合适。",
       "alumno": "Còn phải kiểm tra chất lượng, điều kiện sử dụng và dịch vụ hậu mãi thì mới kết luận được nó thực sự vừa vặn không.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "评估一种方案时，应同时考虑短期效果、长期影响和执行成本。",
       "alumno": "Khi đánh giá một đề xuất, cần cân nhắc đồng thời hiệu quả trước mắt, tác động lâu dài và chi phí thực hiện.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "若结果与预期不同，就要检查哪些条件没有得到充分考虑。",
       "alumno": "Nếu kết quả khác với dự kiến thì cần xem lại những điều kiện nào chưa được cân nhắc đầy đủ.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "因此，结论应说明方案在哪些条件下才适用。",
       "alumno": "Vì vậy, kết luận phải nêu rõ đề xuất này được áp dụng trong những điều kiện nào.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
