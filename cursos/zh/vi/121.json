    {
     "tipo": "dialogo",
     "titulo": "Đối thoại: lập kế hoạch ôn tập",
     "frases": [
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "复习「听说读写综合练习」时，你打算先做哪种练习？",
       "alumno": "Khi ôn «Bài luyện tổng hợp nghe nói đọc viết», bạn sẽ làm dạng bài nào trước?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "我想先听听不同人的看法。",
       "alumno": "Trước hết tôi muốn lắng nghe quan điểm của nhiều người.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "如果大家的意见不一样呢？",
       "alumno": "Nếu ý kiến của mọi người không giống nhau thì sao?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "我们可以把理由写下来，再一起讨论。",
       "alumno": "Chúng ta ghi lại lý do rồi cùng thảo luận.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Đọc: lập kế hoạch ôn tập",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "复习「听说读写综合练习」时，先了解题型，再按计划练习。",
       "alumno": "Khi ôn «Bài luyện tổng hợp nghe nói đọc viết», trước hết nên tìm hiểu dạng đề, rồi luyện tập theo kế hoạch.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "做完练习后，分析错误原因比重复同一类题更有效。",
       "alumno": "Sau khi làm bài, phân tích nguyên nhân sai thường hữu ích hơn việc lặp lại cùng một loại đề.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "比较几种办法时，可以先说明各自的优点和不足。",
       "alumno": "Khi so sánh vài phương án, hãy bắt đầu bằng việc nêu ưu điểm và hạn chế của từng phương án.",
       "literal": "",
       "estructura": "",
       "nota": [],
