     "tipo": "dialogo",
     "titulo": "Đối thoại: phối hợp trong công việc",
     "frases": [
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "工作中遇到「团队与职责」的问题，你会先跟谁商量？",
       "alumno": "Nếu gặp vấn đề liên quan đến «Đội nhóm và trách nhiệm» trong công việc, bạn sẽ bàn bạc với ai trước?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "我认为这个办法可行，不过还需要考虑具体条件。",
       "alumno": "Tôi cho rằng cách này khả thi, nhưng vẫn cần cân nhắc các điều kiện cụ thể.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "你最担心哪一部分？",
       "alumno": "Bạn lo nhất về phần nào?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "如果时间不够，原来的安排可能就不合适。",
       "alumno": "Nếu thiếu thời gian thì e rằng kế hoạch ban đầu sẽ không còn phù hợp.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "那我们能不能准备一个替代方案？",
       "alumno": "Vậy chúng ta chuẩn bị một phương án thay thế được không?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "可以，同时说明每种选择的利弊。",
       "alumno": "Được; đồng thời chúng ta cũng sẽ nêu rõ lợi và hại của từng lựa chọn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Đọc: phối hợp trong công việc",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "处理工作中的「团队与职责」，需要明确分工和时间安排。",
       "alumno": "Giải quyết «Đội nhóm và trách nhiệm» trong công việc cần làm rõ phân công và sắp xếp thời gian.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "遇到变化时，及时沟通通常比等到最后补救更有效。",
       "alumno": "Khi hoàn cảnh thay đổi, trao đổi kịp thời thường hiệu quả hơn việc chờ đến cuối rồi mới bù đắp.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "提出解决办法时，还要考虑它会影响哪些人以及需要哪些资源。",
       "alumno": "Khi đề xuất một giải pháp, cũng cần cân nhắc nó ảnh hưởng đến ai và cần những nguồn lực nào.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "清楚的结论要回应问题，并以具体细节为依据。",
       "alumno": "Kết luận rõ ràng phải trả lời được vấn đề và dựa trên những chi tiết cụ thể.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
