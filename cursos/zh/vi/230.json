   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Đối thoại: nói về sức khỏe",
     "frases": [
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "想改善「医学证据」，你觉得可以从什么习惯开始？",
       "alumno": "Để cải thiện «Bằng chứng y học», theo bạn nên bắt đầu từ thói quen nào?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "这个方案可能解决眼前的问题，却也会带来新的影响。",
       "alumno": "Đề xuất này có thể giải quyết vấn đề trước mắt, nhưng cũng có thể kéo theo những tác động khác.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "怎样区分直接影响和间接影响？",
       "alumno": "Làm sao để phân biệt tác động trực tiếp và tác động gián tiếp?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "先观察短期结果，再跟踪后续变化。",
       "alumno": "Trước hết tôi sẽ theo dõi kết quả ngắn hạn, sau đó theo dõi những thay đổi về sau.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "如果结果因情况而异呢？",
       "alumno": "Và nếu kết quả thay đổi tùy theo hoàn cảnh thì sao?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "就要限定结论的范围，不能把个别情况说成普遍规律。",
       "alumno": "Khi đó cần giới hạn phạm vi của kết luận, không nên coi một trường hợp riêng lẻ là quy luật chung.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Đọc: nói về sức khỏe",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "改善「医学证据」要结合个人情况，不能照搬别人的做法。",
       "alumno": "Để cải thiện «Bằng chứng y học», cần tính đến hoàn cảnh cá nhân và không nên bắt chước máy móc cách làm của người khác.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "如果出现明显或持续的症状，应及时向专业人员求助。",
       "alumno": "Nếu xuất hiện triệu chứng rõ rệt hoặc kéo dài, nên kịp thời nhờ đến chuyên gia.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "不同群体可能从同一变化中得到不同结果，所以不能只听一种声音。",
       "alumno": "Các nhóm người khác nhau có thể nhận kết quả khác nhau từ cùng một thay đổi, nên không thể chỉ nghe một tiếng nói.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "比较各方的经历与证据，有助于解释各方结论为何不同。",
       "alumno": "So sánh trải nghiệm và bằng chứng của từng bên giúp giải thích vì sao kết luận của họ không giống nhau.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "如果仍有疑问，应当承认，而不是把它们隐藏起来。",
       "alumno": "Nếu vẫn còn nghi vấn, nên thừa nhận thay vì che giấu.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
