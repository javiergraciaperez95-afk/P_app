   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Đối thoại: đề xuất biện pháp môi trường",
     "frases": [
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "面对「气候变化」，个人和社区分别能做什么？",
       "alumno": "Trước «Biến đổi khí hậu», cá nhân và cộng đồng có thể làm những gì?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "这个方案可能解决眼前的问题，却也会带来新的影响。",
       "alumno": "Đề xuất này có thể giải quyết vấn đề trước mắt, nhưng cũng có thể kéo theo những tác động khác.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "怎样区分直接影响和间接影响？",
       "alumno": "Làm sao để phân biệt tác động trực tiếp và tác động gián tiếp?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "先观察短期结果，再跟踪后续变化。",
       "alumno": "Trước hết tôi sẽ theo dõi kết quả ngắn hạn, sau đó theo dõi những thay đổi về sau.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "如果结果因情况而异呢？",
       "alumno": "Và nếu kết quả thay đổi tùy theo hoàn cảnh thì sao?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "就要限定结论的范围，不能把个别情况说成普遍规律。",
       "alumno": "Khi đó cần giới hạn phạm vi của kết luận, không nên coi một trường hợp riêng lẻ là quy luật chung.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Đọc: đề xuất biện pháp môi trường",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "应对「气候变化」需要长期措施，也需要社区参与。",
       "alumno": "Ứng phó với «Biến đổi khí hậu» cần những biện pháp lâu dài và sự tham gia của cộng đồng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "持续记录变化，才能判断哪些做法有效，哪些还需要调整。",
       "alumno": "Ghi nhận các thay đổi một cách liên tục cho phép đánh giá biện pháp nào hiệu quả và biện pháp nào cần điều chỉnh.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "不同群体可能从同一变化中得到不同结果，所以不能只听一种声音。",
       "alumno": "Các nhóm người khác nhau có thể nhận kết quả khác nhau từ cùng một thay đổi, nên không thể chỉ nghe một tiếng nói.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "比较各方的经历与证据，有助于解释各方结论为何不同。",
       "alumno": "So sánh trải nghiệm và bằng chứng của từng bên giúp giải thích vì sao kết luận của họ không giống nhau.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "如果仍有疑问，应当承认，而不是把它们隐藏起来。",
       "alumno": "Nếu vẫn còn nghi vấn, nên thừa nhận thay vì che giấu.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
