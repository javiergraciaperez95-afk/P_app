  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Đối thoại: so sánh các lựa chọn",
     "frases": [
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "比较商品时，除了价格和质量，你还会根据什么来判断？",
       "alumno": "Khi so sánh sản phẩm, ngoài giá cả và chất lượng, bạn còn dựa vào tiêu chí nào để đánh giá?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "目前的材料支持一个初步判断，但还不足以证明因果关系。",
       "alumno": "Các tài liệu hiện có ủng hộ một nhận định sơ bộ, nhưng chưa đủ để chứng minh quan hệ nhân quả.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "还需要哪些补充信息？",
       "alumno": "Cần bổ sung những thông tin nào nữa?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "需要扩大样本，并比较不同群体的处境。",
       "alumno": "Cần mở rộng mẫu khảo sát và so sánh hoàn cảnh của các nhóm người đa dạng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "如果新材料与原来的结论相反呢？",
       "alumno": "Và nếu các tài liệu mới trái với kết luận ban đầu thì sao?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "那就应修正判断，并说明证据的适用范围。",
       "alumno": "Khi đó cần điều chỉnh nhận định và giải thích phạm vi áp dụng của bằng chứng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Đọc: so sánh các lựa chọn",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "比较商品时，价格只是一个标准。",
       "alumno": "Khi so sánh sản phẩm, giá chỉ là một tiêu chí.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "还要核对质量、使用条件和售后服务，才能判断它是否真正合适。",
       "alumno": "Còn phải kiểm tra chất lượng, điều kiện sử dụng và dịch vụ hậu mãi thì mới kết luận được nó thực sự vừa vặn không.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "分析时应区分可以观察到的事实与个人解释，也要比较不同立场所依据的材料。",
       "alumno": "Khi phân tích, cần phân biệt các sự kiện có thể quan sát với những cách giải thích cá nhân, và so sánh các nguồn tài liệu làm cơ sở cho từng lập trường.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "即使材料呈现相似趋势，也不能在缺乏证据时直接断定因果关系。",
       "alumno": "Dù tài liệu cho thấy xu hướng tương tự, cũng không thể khẳng định quan hệ nhân quả khi thiếu bằng chứng đầy đủ.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "结尾应概括主要结论，同时说明证据的局限和结论适用的范围。",
       "alumno": "Phần kết nên tóm tắt kết luận chính, đồng thời nêu rõ giới hạn của bằng chứng và phạm vi của điều được khẳng định.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
