   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Đối thoại: nêu một nhu cầu công cộng",
     "frases": [
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "讨论「司法与法院」时，社区最需要先了解什么？",
       "alumno": "Khi bàn về «Tư pháp và tòa án», cộng đồng cần tìm hiểu trước thông tin gì?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "这个方案可能解决眼前的问题，却也会带来新的影响。",
       "alumno": "Đề xuất này có thể giải quyết vấn đề trước mắt, nhưng cũng có thể kéo theo những tác động khác.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "怎样区分直接影响和间接影响？",
       "alumno": "Làm sao để phân biệt tác động trực tiếp và tác động gián tiếp?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "先观察短期结果，再跟踪后续变化。",
       "alumno": "Trước hết tôi sẽ theo dõi kết quả ngắn hạn, sau đó theo dõi những thay đổi về sau.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "如果结果因情况而异呢？",
       "alumno": "Và nếu kết quả thay đổi tùy theo hoàn cảnh thì sao?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "就要限定结论的范围，不能把个别情况说成普遍规律。",
       "alumno": "Khi đó cần giới hạn phạm vi của kết luận, không nên coi một trường hợp riêng lẻ là quy luật chung.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Đọc: nêu một nhu cầu công cộng",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "改善「司法与法院」相关的公共服务，首先要了解居民的实际需要。",
       "alumno": "Để cải thiện các dịch vụ công liên quan đến «Tư pháp và tòa án», trước hết phải tìm hiểu nhu cầu thực tế của cư dân.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "收集意见之后，应说明如何处理，并让结果可以查询。",
       "alumno": "Sau khi thu thập ý kiến, nên giải thích cách xử lý và công khai để mọi người tra cứu kết quả.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "不同群体可能从同一变化中得到不同结果，所以不能只听一种声音。",
       "alumno": "Các nhóm người có thể chịu tác động theo cách riêng trước cùng một thay đổi, vì vậy không đủ nếu chỉ lắng nghe một tiếng nói.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "比较各方的经历与证据，有助于解释各方结论为何不同。",
       "alumno": "So sánh kinh nghiệm và bằng chứng của từng bên giúp giải thích vì sao kết luận của họ lại không giống nhau.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "如果仍有疑问，应当承认，而不是把它们隐藏起来。",
       "alumno": "Nếu vẫn còn băn khoăn thì nên thừa nhận điều đó thay vì che giấu.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
