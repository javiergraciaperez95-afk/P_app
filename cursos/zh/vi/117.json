     "tipo": "dialogo",
     "titulo": "Đối thoại: làm rõ một cấu trúc",
     "frases": [
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "学习「经历与变化」时，哪一点最容易混淆？",
       "alumno": "Khi học «Trải nghiệm và thay đổi», điểm nào thường dễ bị nhầm lẫn nhất?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "我觉得先了解实际情况比较好。",
       "alumno": "Tôi nghĩ tốt hơn là bắt đầu bằng việc tìm hiểu tình hình thực tế.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "你能举一个例子吗？",
       "alumno": "Bạn nêu được một ví dụ không?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "可以，我们先从身边的事情说起。",
       "alumno": "Được; chúng ta bắt đầu từ việc gần gũi.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Đọc: làm rõ một cấu trúc",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "学习「经历与变化」时，不要只背结构形式。",
       "alumno": "Khi học «Trải nghiệm và thay đổi», không nên chỉ học thuộc hình thức cấu trúc.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "比较语境、语序和语气，才能判断表达是否合适。",
       "alumno": "So sánh ngữ cảnh, trật tự từ và giọng điệu thì mới đánh giá được cách diễn đạt đã thật sự phù hợp chưa.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "先把问题说清楚，再举一个例子，最后说明自己的想法。",
       "alumno": "Trước tiên nêu vấn đề cho rõ, sau đó đưa ra một ví dụ, cuối cùng nói ý kiến của mình.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
