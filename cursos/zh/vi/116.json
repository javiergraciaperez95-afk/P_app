   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Đối thoại: làm rõ một cấu trúc",
     "frases": [
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "学习「程度与比较」时，哪一点最容易混淆？",
       "alumno": "Khi học «Mức độ và so sánh», điểm nào thường dễ bị nhầm lẫn nhất?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "我们可以先做一个简单的计划。",
       "alumno": "Chúng ta bắt đầu với một kế hoạch đơn giản.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "要是中间出了问题怎么办？",
       "alumno": "Nếu giữa chừng xảy ra vấn đề thì sao?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "到时候再调整，先把眼前的事情做好。",
       "alumno": "Đến lúc đó sẽ điều chỉnh, trước hết cứ làm tốt việc trước mắt.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Đọc: làm rõ một cấu trúc",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "学习「程度与比较」时，不要只背结构形式。",
       "alumno": "Khi học «Mức độ và so sánh», không nên chỉ học thuộc hình thức cấu trúc.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "比较语境、语序和语气，才能判断表达是否合适。",
       "alumno": "So sánh ngữ cảnh, trật tự từ và giọng điệu thì mới đánh giá được cách diễn đạt đã thật sự phù hợp chưa.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "如果条件发生变化，原来的决定也可以重新考虑。",
       "alumno": "Nếu hoàn cảnh thay đổi thì quyết định ban đầu cũng được xem xét lại.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
