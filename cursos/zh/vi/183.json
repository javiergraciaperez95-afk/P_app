     "frases": [
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "看到关于「HSK五级综合练习」的消息，你会先核实什么？",
       "alumno": "Khi đọc tin về «Bài luyện tổng hợp HSK 5», bạn sẽ kiểm tra điều gì trước?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "我查了几份材料，发现不同来源的说法并不完全一样。",
       "alumno": "Tôi đã tra cứu vài tài liệu và thấy các nguồn không hoàn toàn trùng khớp.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "你打算怎样核实？",
       "alumno": "Bạn định kiểm chứng thế nào?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "我会先比较出处，再看论据是否一致。",
       "alumno": "Trước hết tôi sẽ so sánh nguồn gốc, sau đó xem các lập luận có nhất quán không.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "如果核实后仍有差异呢？",
       "alumno": "Nếu sau khi kiểm chứng vẫn còn chênh lệch thì sao?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "那就说明不同观点，并把证据的局限写清楚。",
       "alumno": "Khi đó tôi sẽ nêu rõ các quan điểm đối lập và ghi rõ những hạn chế của bằng chứng.",
       "literal": "",
       "estructura": "",
