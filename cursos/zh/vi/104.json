   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Đối thoại: nói về sức khỏe",
     "frases": [
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "想改善「症状与看病」，你觉得可以从什么习惯开始？",
       "alumno": "Để cải thiện «Triệu chứng và khám bệnh», bạn nghĩ nên bắt đầu bằng việc gì trong sinh hoạt?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "我们可以先做一个简单的计划。",
       "alumno": "Chúng ta bắt đầu với một kế hoạch đơn giản.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "要是中间出了问题怎么办？",
       "alumno": "Nếu giữa chừng xảy ra vấn đề thì sao?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "到时候再调整，先把眼前的事情做好。",
       "alumno": "Đến lúc đó sẽ điều chỉnh, trước hết cứ làm tốt việc trước mắt.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Đọc: nói về sức khỏe",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "改善「症状与看病」要结合个人情况，不能照搬别人的做法。",
       "alumno": "Để cải thiện «Triệu chứng và khám bệnh», cần kết hợp hoàn cảnh cá nhân và không chép nguyên xi cách làm của người khác.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "如果出现明显或持续的症状，应及时向专业人员求助。",
       "alumno": "Nếu xuất hiện triệu chứng rõ rệt hoặc kéo dài, nên kịp thời nhờ đến chuyên gia.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "如果条件发生变化，原来的决定也可以重新考虑。",
       "alumno": "Nếu hoàn cảnh thay đổi thì quyết định ban đầu cũng được xem xét lại.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
