   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Đối thoại: tổ chức một dự án",
     "frases": [
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "做「学习与计划」相关的项目时，你觉得应该先准备什么？",
       "alumno": "Khi làm một dự án liên quan đến «Học tập và kế hoạch», bạn nghĩ nên chuẩn bị gì trước?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "我觉得先了解实际情况比较好。",
       "alumno": "Tôi nghĩ tốt hơn là bắt đầu bằng việc tìm hiểu tình hình thực tế.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "你能举一个例子吗？",
       "alumno": "Bạn nêu được một ví dụ không?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "可以，我们先从身边的事情说起。",
       "alumno": "Được; chúng ta bắt đầu từ việc gần gũi.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Đọc: tổ chức một dự án",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "研究「学习与计划」时，先提出清楚的问题，再选择资料和方法。",
       "alumno": "Khi nghiên cứu «Học tập và kế hoạch», trước hết phải đặt ra một câu hỏi rõ ràng rồi mới chọn tài liệu và phương pháp.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "比较不同材料之后，结论才有充分的依据。",
       "alumno": "Sau khi so sánh nhiều tài liệu, kết luận mới đủ căn cứ vững chắc.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "先把问题说清楚，再举一个例子，最后说明自己的想法。",
       "alumno": "Trước tiên nêu vấn đề cho rõ, sau đó đưa ra một ví dụ, cuối cùng nói ý kiến của mình.",
       "literal": "",
       "estructura": "",
