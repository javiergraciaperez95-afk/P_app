    {
     "tipo": "dialogo",
     "titulo": "Đối thoại: so sánh các lựa chọn",
     "frases": [
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "比较商品时，除了价格和质量，你还会根据什么来判断？",
       "alumno": "Khi so sánh sản phẩm, ngoài giá cả và chất lượng, bạn còn dựa vào tiêu chí nào để đánh giá?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "我想先听听不同人的看法。",
       "alumno": "Trước hết tôi muốn lắng nghe quan điểm của nhiều người.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "如果大家的意见不一样呢？",
       "alumno": "Nếu ý kiến của mọi người không giống nhau thì sao?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "我们可以把理由写下来，再一起讨论。",
       "alumno": "Chúng ta ghi lại lý do rồi cùng thảo luận.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Đọc: đối chiếu các lựa chọn",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "比较商品时，价格只是一个标准。",
       "alumno": "Khi so sánh sản phẩm, giá chỉ là một tiêu chí.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "还要核对质量、使用条件和售后服务，才能判断它是否真正合适。",
       "alumno": "Còn phải kiểm tra chất lượng, điều kiện sử dụng và dịch vụ hậu mãi thì mới kết luận được nó thực sự vừa vặn không.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "比较几种办法时，可以先说明各自的优点和不足。",
       "alumno": "Khi so sánh vài phương án, hãy bắt đầu bằng việc nêu ưu điểm và hạn chế của từng phương án.",
       "literal": "",
       "estructura": "",
       "nota": [],
