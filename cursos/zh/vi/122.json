     "tipo": "dialogo",
     "titulo": "Đối thoại: lập kế hoạch ôn tập",
     "frases": [
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "复习「HSK四级总复习」时，你打算先做哪种练习？",
       "alumno": "Khi ôn «Ôn tập tổng kết HSK 4», bạn sẽ làm dạng bài nào trước?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "我们可以先做一个简单的计划。",
       "alumno": "Chúng ta bắt đầu với một kế hoạch đơn giản.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "要是中间出了问题怎么办？",
       "alumno": "Nếu giữa chừng xảy ra vấn đề thì sao?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "到时候再调整，先把眼前的事情做好。",
       "alumno": "Đến lúc đó sẽ điều chỉnh, trước hết cứ làm tốt việc trước mắt.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Đọc: lập kế hoạch ôn tập",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "复习「HSK四级总复习」时，先了解题型，再按计划练习。",
       "alumno": "Khi ôn «Ôn tập tổng kết HSK 4», trước hết nên tìm hiểu dạng đề, rồi luyện tập theo kế hoạch.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "做完练习后，分析错误原因比重复同一类题更有效。",
       "alumno": "Sau khi làm bài, phân tích nguyên nhân sai thường hữu ích hơn việc lặp lại cùng một loại đề.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "如果条件发生变化，原来的决定也可以重新考虑。",
       "alumno": "Nếu hoàn cảnh thay đổi thì quyết định ban đầu cũng được xem xét lại.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
