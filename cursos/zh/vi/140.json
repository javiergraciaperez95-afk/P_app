    {
     "tipo": "dialogo",
     "titulo": "Đối thoại: tổ chức một dự án",
     "frases": [
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "做「资料与证据」相关的项目时，你觉得应该先准备什么？",
       "alumno": "Trong một dự án về «Nguồn tư liệu và bằng chứng», nên chuẩn bị gì trước?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "我认为这个办法可行，不过还需要考虑具体条件。",
       "alumno": "Tôi cho rằng cách này khả thi, nhưng vẫn cần cân nhắc các điều kiện cụ thể.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "你最担心哪一部分？",
       "alumno": "Bạn lo nhất về phần nào?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "如果时间不够，原来的安排可能就不合适。",
       "alumno": "Nếu thiếu thời gian thì e rằng kế hoạch ban đầu sẽ không còn phù hợp.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "那我们能不能准备一个替代方案？",
       "alumno": "Vậy chúng ta chuẩn bị một phương án thay thế được không?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "可以，同时说明每种选择的利弊。",
       "alumno": "Được; đồng thời chúng ta cũng sẽ nêu rõ lợi và hại của từng lựa chọn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Đọc: tổ chức một dự án",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "研究「资料与证据」时，先提出清楚的问题，再选择资料和方法。",
       "alumno": "Khi nghiên cứu «Nguồn tư liệu và bằng chứng», trước hết phải đặt ra một câu hỏi rõ ràng rồi mới chọn tài liệu và phương pháp.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "比较不同材料之后，结论才有充分的依据。",
       "alumno": "Sau khi so sánh nhiều tài liệu, kết luận mới đủ căn cứ vững chắc.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "提出解决办法时，还要考虑它会影响哪些人以及需要哪些资源。",
       "alumno": "Khi đề xuất một giải pháp, cũng cần cân nhắc nó ảnh hưởng đến ai và cần những nguồn lực nào.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "清楚的结论要回应问题，并以具体细节为依据。",
       "alumno": "Kết luận rõ ràng phải trả lời được vấn đề và dựa trên những chi tiết cụ thể.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
