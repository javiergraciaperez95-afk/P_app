   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Đối thoại: nói về sức khỏe",
     "frases": [
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "想改善「医疗服务」，你觉得可以从什么习惯开始？",
       "alumno": "Để cải thiện «Chăm sóc y tế», bạn nghĩ nên bắt đầu bằng việc gì trong sinh hoạt?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "我认为这个办法可行，不过还需要考虑具体条件。",
       "alumno": "Tôi cho rằng cách này khả thi, nhưng vẫn cần cân nhắc các điều kiện cụ thể.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "你最担心哪一部分？",
       "alumno": "Bạn lo nhất về phần nào?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "如果时间不够，原来的安排可能就不合适。",
       "alumno": "Nếu thiếu thời gian thì e rằng kế hoạch ban đầu sẽ không còn phù hợp.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "那我们能不能准备一个替代方案？",
       "alumno": "Vậy chúng ta chuẩn bị một phương án thay thế được không?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "可以，同时说明每种选择的利弊。",
       "alumno": "Được; đồng thời chúng ta cũng sẽ nêu rõ lợi và hại của từng lựa chọn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Đọc: nói về sức khỏe",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "改善「医疗服务」要结合个人情况，不能照搬别人的做法。",
       "alumno": "Để cải thiện «Chăm sóc y tế», cần kết hợp hoàn cảnh cá nhân và không chép nguyên xi cách làm của người khác.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "如果出现明显或持续的症状，应及时向专业人员求助。",
       "alumno": "Nếu xuất hiện triệu chứng rõ rệt hoặc kéo dài, nên kịp thời nhờ đến chuyên gia.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "提出解决办法时，还要考虑它会影响哪些人以及需要哪些资源。",
       "alumno": "Khi đề xuất một giải pháp, cũng cần cân nhắc nó ảnh hưởng đến ai và cần những nguồn lực nào.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "清楚的结论要回应问题，并以具体细节为依据。",
       "alumno": "Kết luận rõ ràng phải trả lời được vấn đề và dựa trên những chi tiết cụ thể.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
