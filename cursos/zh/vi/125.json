   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Đối thoại: kể một quyết định",
     "frases": [
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "谈到「个人选择」，你觉得哪一个选择最重要？",
       "alumno": "Khi nói về «Quyết định cá nhân», bạn thấy quyết định nào quan trọng nhất?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "我认为这个办法可行，不过还需要考虑具体条件。",
       "alumno": "Tôi cho rằng cách này khả thi, nhưng vẫn cần cân nhắc các điều kiện cụ thể.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "你最担心哪一部分？",
       "alumno": "Bạn lo nhất về phần nào?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "如果时间不够，原来的安排可能就不合适。",
       "alumno": "Nếu thiếu thời gian thì e rằng kế hoạch ban đầu sẽ không còn phù hợp.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "那我们能不能准备一个替代方案？",
       "alumno": "Vậy chúng ta chuẩn bị một phương án thay thế được không?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "可以，同时说明每种选择的利弊。",
       "alumno": "Được; đồng thời chúng ta cũng sẽ nêu rõ lợi và hại của từng lựa chọn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Đọc: kể một quyết định",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "谈到「个人选择」，每个人的经历和选择都不一样。",
       "alumno": "Khi nói về «Quyết định cá nhân», mỗi người sống những trải nghiệm riêng và tự đưa ra quyết định của mình.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "回顾一段经历时，既要看当时的条件，也要看后来作出的决定。",
       "alumno": "Khi nhớ lại một trải nghiệm, nên xem xét cả hoàn cảnh lúc đó lẫn các quyết định về sau.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "提出解决办法时，还要考虑它会影响哪些人以及需要哪些资源。",
       "alumno": "Khi đề xuất một giải pháp, cũng cần cân nhắc nó ảnh hưởng đến ai và cần những nguồn lực nào.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "清楚的结论要回应问题，并以具体细节为依据。",
       "alumno": "Kết luận rõ ràng phải trả lời được vấn đề và dựa trên những chi tiết cụ thể.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
