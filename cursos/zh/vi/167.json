    {
     "tipo": "dialogo",
     "titulo": "Đối thoại: nói về công nghệ",
     "frases": [
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "使用「数据与分析」时，怎样兼顾方便和安全？",
       "alumno": "Khi sử dụng «Dữ liệu và phân tích», làm sao để cân bằng giữa tiện lợi và an toàn?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "我认为这个办法可行，不过还需要考虑具体条件。",
       "alumno": "Tôi cho rằng cách này khả thi, nhưng vẫn cần cân nhắc các điều kiện cụ thể.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "你最担心哪一部分？",
       "alumno": "Bạn lo nhất về phần nào?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "如果时间不够，原来的安排可能就不合适。",
       "alumno": "Nếu thiếu thời gian thì e rằng kế hoạch ban đầu sẽ không còn phù hợp.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "那我们能不能准备一个替代方案？",
       "alumno": "Vậy chúng ta chuẩn bị một phương án thay thế được không?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "可以，同时说明每种选择的利弊。",
       "alumno": "Được; đồng thời chúng ta cũng sẽ nêu rõ lợi và hại của từng lựa chọn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Đọc: nói về công nghệ",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "数字工具让「数据与分析」相关的信息更容易获得。",
       "alumno": "Các công cụ số làm cho thông tin liên quan đến «Dữ liệu và phân tích» dễ tiếp cận hơn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "使用时仍要考虑隐私和安全，例如检查权限、核实链接。",
       "alumno": "Tuy vậy, khi dùng vẫn phải cân nhắc đến quyền riêng tư và an toàn, chẳng hạn kiểm tra quyền truy cập và xác minh đường liên kết.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "提出解决办法时，还要考虑它会影响哪些人以及需要哪些资源。",
       "alumno": "Khi đề xuất một giải pháp, cũng cần cân nhắc nó ảnh hưởng đến ai và cần những nguồn lực nào.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "清楚的结论要回应问题，并以具体细节为依据。",
       "alumno": "Kết luận rõ ràng phải trả lời được vấn đề và dựa trên những chi tiết cụ thể.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
