     "frases": [
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "面对「生态系统」，个人和社区分别能做什么？",
       "alumno": "Trước «Hệ sinh thái», cá nhân và cộng đồng có thể làm những gì?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "目前的材料支持一个初步判断，但还不足以证明因果关系。",
       "alumno": "Tài liệu hiện có cho phép đưa ra một kết luận tạm thời, nhưng không đủ để chứng minh quan hệ nhân quả.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "还需要哪些补充信息？",
       "alumno": "Cần bổ sung những thông tin nào nữa?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "需要扩大样本，并比较不同群体的处境。",
       "alumno": "Cần mở rộng mẫu khảo sát và so sánh hoàn cảnh của các nhóm người khác nhau.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "如果新材料与原来的结论相反呢？",
       "alumno": "Và nếu các vật liệu mới trái với kết luận ban đầu thì sao?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "那就应修正判断，并说明证据的适用范围。",
       "alumno": "Khi đó cần điều chỉnh kết luận và giải thích phạm vi áp dụng của bằng chứng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Đọc: đề xuất biện pháp môi trường",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "应对「生态系统」需要长期措施，也需要社区参与。",
       "alumno": "Ứng phó với «Hệ sinh thái» cần những biện pháp lâu dài và sự tham gia của cộng đồng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "持续记录变化，才能判断哪些做法有效，哪些还需要调整。",
       "alumno": "Ghi nhận các thay đổi một cách liên tục cho phép đánh giá biện pháp nào hiệu quả và biện pháp nào cần điều chỉnh.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "分析时应区分可以观察到的事实与个人解释，也要比较不同立场所依据的材料。",
       "alumno": "Khi phân tích, cần phân biệt các sự kiện có thể quan sát với những cách giải thích cá nhân, và so sánh các nguồn tài liệu làm cơ sở cho từng lập trường.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "即使材料呈现相似趋势，也不能在缺乏证据时直接断定因果关系。",
       "alumno": "Dù tài liệu cho thấy xu hướng tương tự, cũng không thể khẳng định quan hệ nhân quả khi thiếu bằng chứng đầy đủ.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "结尾应概括主要结论，同时说明证据的局限和结论适用的范围。",
       "alumno": "Phần kết nên tóm tắt kết luận chính, đồng thời nêu rõ giới hạn của bằng chứng và phạm vi của điều được khẳng định.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
