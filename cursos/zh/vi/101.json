    {
     "tipo": "dialogo",
     "titulo": "Đối thoại: chuẩn bị chuyến đi",
     "frases": [
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "安排「安排旅行与住宿」时，什么细节最容易被忽略？",
       "alumno": "Khi tổ chức «Sắp xếp chuyến đi và chỗ ở», chi tiết nào thường dễ bị bỏ qua?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "我们可以先做一个简单的计划。",
       "alumno": "Chúng ta bắt đầu với một kế hoạch đơn giản.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "要是中间出了问题怎么办？",
       "alumno": "Nếu giữa chừng xảy ra vấn đề thì sao?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "到时候再调整，先把眼前的事情做好。",
       "alumno": "Đến lúc đó sẽ điều chỉnh, trước hết cứ làm tốt việc trước mắt.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Đọc: chuẩn bị chuyến đi",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "安排「安排旅行与住宿」相关的行程时，要同时考虑路线、交通和住宿。",
       "alumno": "Khi sắp xếp hành trình liên quan đến «Sắp xếp chuyến đi và chỗ ở», phải cân nhắc đồng thời tuyến đường, phương tiện và nơi ở.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "提前确认信息，可以减少临时改变计划带来的麻烦。",
       "alumno": "Xác nhận thông tin trước sẽ giúp tránh được rắc rối khi phải thay đổi kế hoạch.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "如果条件发生变化，原来的决定也可以重新考虑。",
       "alumno": "Nếu hoàn cảnh thay đổi thì quyết định ban đầu cũng được xem xét lại.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
