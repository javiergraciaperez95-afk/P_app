     "tipo": "dialogo",
     "titulo": "Đối thoại: đề xuất biện pháp môi trường",
     "frases": [
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "面对「天气、季节与环境保护」，个人和社区分别能做什么？",
       "alumno": "Trước «Thời tiết, mùa và bảo vệ môi trường», cá nhân nên làm gì và cộng đồng nên làm gì?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "我想先听听不同人的看法。",
       "alumno": "Trước hết tôi muốn lắng nghe quan điểm của nhiều người.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "如果大家的意见不一样呢？",
       "alumno": "Nếu ý kiến của mọi người không giống nhau thì sao?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "我们可以把理由写下来，再一起讨论。",
       "alumno": "Chúng ta ghi lại lý do rồi cùng thảo luận.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Đọc: đề xuất biện pháp môi trường",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "应对「天气、季节与环境保护」需要长期措施，也需要社区参与。",
       "alumno": "Ứng phó với «Thời tiết, mùa và bảo vệ môi trường» cần những biện pháp lâu dài và sự tham gia của cộng đồng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "持续记录变化，才能判断哪些做法有效，哪些还需要调整。",
       "alumno": "Ghi chép liên tục những thay đổi thì mới đánh giá được biện pháp nào hiệu quả, biện pháp nào cần điều chỉnh.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "比较几种办法时，可以先说明各自的优点和不足。",
       "alumno": "Khi so sánh vài phương án, hãy bắt đầu bằng việc nêu ưu điểm và hạn chế của từng phương án.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
