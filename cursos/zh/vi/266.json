        "lengua": "estudio"
       },
       "estudio": "看到关于「数字媒体」的消息，你会先核实什么？",
       "alumno": "Khi đọc một tin tức về «Truyền thông số», bạn sẽ kiểm tra điều gì trước tiên?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
