     "tipo": "dialogo",
     "titulo": "Đối thoại: nhận xét một bài đọc",
     "frases": [
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "读到关于「搭配与组合」的文章时，你怎样找出中心意思？",
       "alumno": "Đọc một bài viết về «Kết hợp và tổ hợp từ», bạn sẽ tìm ý trung tâm bằng cách nào?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "目前的材料支持一个初步判断，但还不足以证明因果关系。",
       "alumno": "Các tài liệu hiện có cho phép đưa ra một kết luận tạm thời, nhưng không đủ để chứng minh quan hệ nhân quả.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "还需要哪些补充信息？",
       "alumno": "Cần bổ sung những thông tin nào nữa?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "需要扩大样本，并比较不同群体的处境。",
       "alumno": "Cần mở rộng mẫu khảo sát và so sánh hoàn cảnh của các nhóm người khác nhau.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "如果新材料与原来的结论相反呢？",
       "alumno": "Và nếu các vật liệu mới trái với kết luận ban đầu thì sao?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "那就应修正判断，并说明证据的适用范围。",
       "alumno": "Khi đó cần điều chỉnh kết luận và giải thích phạm vi áp dụng của bằng chứng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Đọc: nhận xét một bài đọc",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "阅读关于「搭配与组合」的文章时，可以先找作者的中心观点。",
       "alumno": "Khi đọc về «Kết hợp và tổ hợp từ», trước hết nên xác định ý trung tâm của tác giả.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "接着看例子怎样支持观点，最后用自己的话概括。",
       "alumno": "Sau đó, hãy xem các ví dụ hỗ trợ quan điểm như thế nào và tóm tắt lại bằng lời của chính bạn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "分析时应区分可以观察到的事实与个人解释，也要比较不同立场所依据的材料。",
       "alumno": "Khi phân tích, cần phân biệt các sự kiện có thể quan sát với những cách giải thích cá nhân, và so sánh các nguồn tài liệu làm cơ sở cho từng lập trường.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "即使材料呈现相似趋势，也不能在缺乏证据时直接断定因果关系。",
       "alumno": "Dù tài liệu cho thấy xu hướng tương tự, cũng không thể khẳng định quan hệ nhân quả khi thiếu bằng chứng đầy đủ.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "结尾应概括主要结论，同时说明证据的局限和结论适用的范围。",
       "alumno": "Phần kết nên tóm tắt kết luận chính, đồng thời nêu rõ giới hạn của bằng chứng và phạm vi của điều được khẳng định.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
