  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Đối thoại: kể một quyết định",
     "frases": [
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "谈到「变化与选择」，你觉得哪一个选择最重要？",
       "alumno": "Khi nói về «Kể về thay đổi và lựa chọn», bạn thấy quyết định nào quan trọng nhất?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "我想先听听不同人的看法。",
       "alumno": "Trước hết tôi muốn lắng nghe quan điểm của nhiều người.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "如果大家的意见不一样呢？",
       "alumno": "Nếu ý kiến của mọi người không giống nhau thì sao?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "我们可以把理由写下来，再一起讨论。",
       "alumno": "Chúng ta ghi lại lý do rồi cùng thảo luận.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Đọc: kể một quyết định",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "谈到「变化与选择」，每个人的经历和选择都不一样。",
       "alumno": "Trong «Kể về thay đổi và lựa chọn», mỗi người sống những trải nghiệm riêng và tự đưa ra quyết định của mình.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "回顾一段经历时，既要看当时的条件，也要看后来作出的决定。",
       "alumno": "Khi nhớ lại một trải nghiệm, nên xem xét cả hoàn cảnh lúc đó lẫn các quyết định về sau.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
