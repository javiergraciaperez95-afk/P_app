    },
    {
     "tipo": "texto",
     "titulo": "Đọc: kể một quyết định",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "谈到「回忆与经历」，每个人的经历和选择都不一样。",
       "alumno": "Khi nói về «Ký ức và trải nghiệm», mỗi người sống những trải nghiệm riêng và tự đưa ra quyết định của mình.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "回顾一段经历时，既要看当时的条件，也要看后来作出的决定。",
       "alumno": "Khi nhớ lại một trải nghiệm, nên xem xét cả hoàn cảnh lúc đó lẫn các quyết định về sau.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "提出解决办法时，还要考虑它会影响哪些人以及需要哪些资源。",
       "alumno": "Khi đề xuất một giải pháp, cũng cần cân nhắc nó ảnh hưởng đến ai và cần những nguồn lực nào.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "清楚的结论要回应问题，并以具体细节为依据。",
       "alumno": "Kết luận rõ ràng phải trả lời được vấn đề và dựa trên những chi tiết cụ thể.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
