    {
     "tipo": "dialogo",
     "titulo": "Đối thoại: kể một quyết định",
     "frases": [
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "谈到「身份与经历」，你觉得哪一个选择最重要？",
       "alumno": "Khi nói về «Danh tính và tiểu sử», bạn thấy quyết định nào quan trọng nhất?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "我查了几份材料，发现不同来源的说法并不完全一样。",
       "alumno": "Tôi đã tra cứu vài tài liệu và thấy các nguồn không hoàn toàn trùng khớp.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "你打算怎样核实？",
       "alumno": "Bạn định kiểm chứng thế nào?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "我会先比较出处，再看论据是否一致。",
       "alumno": "Trước hết tôi sẽ so sánh nguồn gốc, sau đó xem các lập luận có nhất quán không.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "如果核实后仍有差异呢？",
       "alumno": "Nếu sau khi kiểm chứng vẫn còn chênh lệch thì sao?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "那就说明不同观点，并把证据的局限写清楚。",
       "alumno": "Khi đó tôi sẽ nêu rõ các quan điểm đối lập và ghi rõ những hạn chế của bằng chứng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Đọc: kể một quyết định",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "谈到「身份与经历」，每个人的经历和选择都不一样。",
       "alumno": "Khi nói về «Danh tính và tiểu sử», mỗi người sống những trải nghiệm riêng và tự đưa ra quyết định của mình.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "回顾一段经历时，既要看当时的条件，也要看后来作出的决定。",
       "alumno": "Khi nhớ lại một trải nghiệm, nên xem xét cả hoàn cảnh lúc đó lẫn các quyết định về sau.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "如果只凭个人印象，容易忽略其他情况；因此要核对材料，并说明判断依据。",
       "alumno": "Nếu chỉ dựa vào ấn tượng cá nhân thì dễ bỏ sót các trường hợp còn lại; vì vậy cần đối chiếu tài liệu và giải thích cơ sở của phán đoán.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "组织短文时，可以先提出观点，再用事实或例子支持它。",
       "alumno": "Khi viết đoạn văn ngắn, hãy nêu quan điểm trước rồi dùng sự thật hoặc ví dụ để ủng hộ nó.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
