   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Đối thoại: làm rõ một cấu trúc",
     "frases": [
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "学习「趋向补语」时，哪一点最容易混淆？",
       "alumno": "Khi học «Bổ ngữ xu hướng», điểm nào thường dễ bị nhầm lẫn nhất?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "我想先听听不同人的看法。",
       "alumno": "Trước hết tôi muốn lắng nghe quan điểm của nhiều người.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "如果大家的意见不一样呢？",
       "alumno": "Nếu ý kiến của mọi người không giống nhau thì sao?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "我们可以把理由写下来，再一起讨论。",
       "alumno": "Chúng ta ghi lại lý do rồi cùng thảo luận.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Đọc: làm rõ một cấu trúc",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "学习「趋向补语」时，不要只背结构形式。",
       "alumno": "Khi học «Bổ ngữ xu hướng», không nên chỉ học thuộc hình thức cấu trúc.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "比较语境、语序和语气，才能判断表达是否合适。",
       "alumno": "Cần so sánh ngữ cảnh, trật tự từ và giọng điệu thì mới đánh giá được cách diễn đạt đã thật sự phù hợp chưa.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "比较几种办法时，可以先说明各自的优点和不足。",
       "alumno": "Khi so sánh vài phương án, hãy bắt đầu bằng việc nêu ưu điểm và hạn chế của từng phương án.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
