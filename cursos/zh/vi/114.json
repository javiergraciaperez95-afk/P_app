    },
    {
     "tipo": "texto",
     "titulo": "Đọc: làm rõ một cấu trúc",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "学习「把字句」时，不要只背结构形式。",
       "alumno": "Khi học «把 để tác động lên đối tượng», không nên chỉ học thuộc hình thức cấu trúc.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "比较语境、语序和语气，才能判断表达是否合适。",
       "alumno": "So sánh ngữ cảnh, trật tự từ và giọng điệu thì mới đánh giá được cách diễn đạt đã thật sự phù hợp chưa.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "先把问题说清楚，再举一个例子，最后说明自己的想法。",
       "alumno": "Trước tiên nêu vấn đề cho rõ, sau đó đưa ra một ví dụ, cuối cùng nói ý kiến của mình.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
