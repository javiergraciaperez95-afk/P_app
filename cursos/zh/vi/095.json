   "etapa": "leer",
   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Đối thoại: tìm sự thỏa thuận",
     "frases": [
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "遇到跟「友谊、帮助与矛盾」有关的分歧时，你通常怎么处理？",
       "alumno": "Khi xuất hiện bất đồng liên quan đến «Tình bạn, sự giúp đỡ và mâu thuẫn», bạn thường xử lý thế nào?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "我们可以先做一个简单的计划。",
       "alumno": "Chúng ta bắt đầu với một kế hoạch đơn giản.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "要是中间出了问题怎么办？",
       "alumno": "Nếu giữa chừng xảy ra vấn đề thì sao?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "到时候再调整，先把眼前的事情做好。",
       "alumno": "Đến lúc đó sẽ điều chỉnh, trước hết cứ làm tốt việc trước mắt.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Đọc: tìm sự thỏa thuận",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "处理「友谊、帮助与矛盾」相关的分歧时，先听完对方的想法很重要。",
       "alumno": "Khi bàn về bất đồng liên quan đến «Tình bạn, sự giúp đỡ và mâu thuẫn», nên lắng nghe người kia trước đã.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "表达自己的需要，也要尊重彼此的界限。",
