  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Đối thoại: so sánh các lựa chọn",
     "frases": [
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "比较商品时，除了价格和质量，你还会根据什么来判断？",
       "alumno": "Khi so sánh sản phẩm, ngoài giá cả và chất lượng, bạn còn dựa vào tiêu chí nào để đánh giá?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "这个方案可能解决眼前的问题，却也会带来新的影响。",
       "alumno": "Đề xuất này có thể giải quyết vấn đề trước mắt, nhưng cũng có thể kéo theo những tác động khác.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "怎样区分直接影响和间接影响？",
       "alumno": "Làm sao để phân biệt tác động trực tiếp và tác động gián tiếp?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "先观察短期结果，再跟踪后续变化。",
       "alumno": "Trước hết tôi sẽ theo dõi kết quả ngắn hạn, sau đó theo dõi những thay đổi về sau.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "如果结果因情况而异呢？",
       "alumno": "Và nếu kết quả thay đổi tùy theo hoàn cảnh thì sao?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "就要限定结论的范围，不能把个别情况说成普遍规律。",
       "alumno": "Khi đó cần giới hạn phạm vi của kết luận, không nên coi một trường hợp riêng lẻ là quy luật chung.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Đọc: so sánh các lựa chọn",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "比较商品时，价格只是一个标准。",
       "alumno": "Khi so sánh sản phẩm, giá chỉ là một tiêu chí.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "还要核对质量、使用条件和售后服务，才能判断它是否真正合适。",
       "alumno": "Còn phải kiểm tra chất lượng, điều kiện sử dụng và dịch vụ hậu mãi thì mới kết luận được nó thực sự vừa vặn không.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "不同群体可能从同一变化中得到不同结果，所以不能只听一种声音。",
       "alumno": "Các nhóm người có thể chịu tác động theo cách riêng trước cùng một thay đổi, vì vậy không đủ nếu chỉ lắng nghe một tiếng nói.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "比较各方的经历与证据，有助于解释各方结论为何不同。",
       "alumno": "So sánh kinh nghiệm và bằng chứng của từng bên giúp giải thích vì sao kết luận của họ lại không giống nhau.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "如果仍有疑问，应当承认，而不是把它们隐藏起来。",
       "alumno": "Nếu vẫn còn băn khoăn thì nên thừa nhận điều đó thay vì che giấu.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
