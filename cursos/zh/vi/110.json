    {
     "tipo": "texto",
     "titulo": "Đọc: đánh giá lập luận",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "讨论「让步与转折」时，要区分事实、推论和个人立场。",
       "alumno": "Khi thảo luận về «Nhượng bộ và đối lập», cần phân biệt sự thật, suy luận và lập trường cá nhân.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "说明证据的来源并回应反例，结论才更有说服力。",
       "alumno": "Nêu rõ nguồn gốc của bằng chứng và trả lời các phản ví dụ thì kết luận mới thêm sức thuyết phục.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "如果条件发生变化，原来的决定也可以重新考虑。",
       "alumno": "Nếu hoàn cảnh thay đổi thì quyết định ban đầu cũng được xem xét lại.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
