   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Đối thoại: nêu một nhu cầu công cộng",
     "frases": [
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "讨论「社会组织」时，社区最需要先了解什么？",
       "alumno": "Khi bàn về «Tổ chức xã hội dân sự», cộng đồng cần tìm hiểu trước thông tin gì?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "目前的材料支持一个初步判断，但还不足以证明因果关系。",
       "alumno": "Các tài liệu hiện có ủng hộ một nhận định sơ bộ, nhưng chưa đủ để chứng minh quan hệ nhân quả.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "还需要哪些补充信息？",
       "alumno": "Cần bổ sung những thông tin nào nữa?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "需要扩大样本，并比较不同群体的处境。",
       "alumno": "Cần mở rộng mẫu khảo sát và so sánh hoàn cảnh của các nhóm người đa dạng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "林娜",
        "lengua": "estudio"
       },
       "estudio": "如果新材料与原来的结论相反呢？",
       "alumno": "Và nếu các tài liệu mới trái với kết luận ban đầu thì sao?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "王明",
        "lengua": "estudio"
       },
       "estudio": "那就应修正判断，并说明证据的适用范围。",
       "alumno": "Khi đó cần điều chỉnh nhận định và giải thích phạm vi áp dụng của bằng chứng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Đọc: nêu một nhu cầu công cộng",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "改善「社会组织」相关的公共服务，首先要了解居民的实际需要。",
       "alumno": "Để cải thiện các dịch vụ công liên quan đến «Tổ chức xã hội dân sự», trước hết phải tìm hiểu nhu cầu thực tế của cư dân.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "收集意见之后，应说明如何处理，并让结果可以查询。",
       "alumno": "Sau khi thu thập ý kiến, nên giải thích cách xử lý và công khai để mọi người tra cứu kết quả.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "分析时应区分可以观察到的事实与个人解释，也要比较不同立场所依据的材料。",
       "alumno": "Khi phân tích, cần phân biệt các sự kiện có thể quan sát với những cách giải thích cá nhân, và so sánh các nguồn tài liệu làm cơ sở cho từng lập trường.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "即使材料呈现相似趋势，也不能在缺乏证据时直接断定因果关系。",
       "alumno": "Dù tài liệu cho thấy xu hướng tương tự, cũng không thể khẳng định quan hệ nhân quả khi thiếu bằng chứng đầy đủ.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "结尾应概括主要结论，同时说明证据的局限和结论适用的范围。",
       "alumno": "Phần kết nên tóm tắt kết luận chính, đồng thời nêu rõ giới hạn của bằng chứng và phạm vi của điều được khẳng định.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
