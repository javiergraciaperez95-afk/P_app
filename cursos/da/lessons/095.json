 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Obligación y permiso",
    "@en": "Obligation and permission"
   },
   "texto": [
    {
     "@es": "**Skal** = tener que: **Du skal hvile dig.** = Tienes que descansar.",
     "@en": "**Skal** = have to: **Du skal hvile dig.** = You have to rest."
    },
    {
     "@es": "**Må gerne** = puedes (con permiso): **Du må gerne bruge den.** = Puedes usarla. Con **må ikke** = no debes: **Du må ikke bruge den.** = No la debes usar.",
     "@en": "**Må gerne** = you can (with permission): **Du må gerne bruge den.** = You can use it. With **må ikke** = you should not: **Du må ikke bruge den.** = You should not use it."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Deducir y aconsejar",
    "@en": "Deduce and advise"
   },
   "texto": [
    {
     "@es": "**Må** también significa «debe de»: **Han må være træt.** = Debe de estar cansado.",
     "@en": "**Må** also means «must»: **Han må være træt.** = He must be tired."
    },
    {
     "@es": "**Bør** = deberías: **Du bør hvile dig lidt før festen.** = Deberías descansar un poco antes de la fiesta.",
     "@en": "**Bør** = you should: **Du bør hvile dig lidt før festen.** = You should rest a little before the party."
    },
    {
     "@es": "**Skal være** también puede ser lo que dicen los demás: **Hun skal være rig.** = Dicen que es rica.",
     "@en": "**Skal være** may also be what others say: **Hun skal være rig.** = They say it's rich."
    }
   ]
  },
