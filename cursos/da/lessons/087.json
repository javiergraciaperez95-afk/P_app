  {
   "tipo": "test",
   "pregunta": {
    "@es": "Cap. 20. ¿Cómo dices «si tuviera tiempo» en danés?",
    "@en": "Cap. 20. How do you say «if I had time» in Danish?"
   },
   "id": "da018-1",
   "opciones": [
    {
     "texto": "hvis jeg havde tid",
     "explicacion": {
      "@es": "«havde» = pretérito de «have».",
      "@en": "«havde» = «have» preteritus."
     },
     "correcta": true
    },
    {
     "texto": "hvis jeg har tid",
     "explicacion": {
      "@es": "Es real, no imaginario.",
      "@en": "It's real, not imaginary."
     }
    },
    {
     "texto": "hvis jeg haft tid",
     "explicacion": {
      "@es": "«haft» es participio y no encaja.",
      "@en": "«haft» is participle and does not fit."
     }
    }
   ]
  },
  {
   "tipo": "huecos",
   "pregunta": {
    "@es": "Cap. 20. pista: querría",
    "@en": "Cap. 20. Track: I'd like"
   },
   "frase": "Hvis jeg var rig, ___ jeg købe en bil.",
   "id": "da018-2",
   "opciones": [
    {
     "texto": "ville",
     "explicacion": {
      "@es": "«ville» + infinitivo = querría.",
      "@en": "«ville» + infinitive = I would want."
     },
     "correcta": true
    },
    {
     "texto": "vil",
     "explicacion": {
      "@es": "Es presente.",
      "@en": "He's present."
     }
    },
    {
     "texto": "har",
     "explicacion": {
      "@es": "Es presente de «have».",
      "@en": "It is present from «have»."
     }
    }
   ]
  },
  {
   "tipo": "traduccion",
   "pregunta": {
    "@es": "¿Qué significa?",
    "@en": "What does that mean?"
   },
   "frase": "Cap. 20. Hvis jeg havde haft tid, ville jeg være kommet.",
   "id": "da018-3",
   "opciones": [
    {
     "texto": {
      "@es": "Si hubiera tenido tiempo, habría venido.",
      "@en": "If I had time, I would have come."
     },
     "explicacion": {
      "@es": "Pasado imaginario.",
      "@en": "Imaginary past."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Si tengo tiempo, vengo.",
      "@en": "If I have time, I'll come."
     },
     "explicacion": {
      "@es": "Eso sería real.",
      "@en": "That would be real."
     }
    },
    {
     "texto": {
      "@es": "Si tuviera tiempo, vendría.",
      "@en": "If I had time, I'd come."
     },
     "explicacion": {
      "@es": "Eso sería presente imaginario, no pasado.",
      "@en": "That would be imaginary present, not past."
     }
    }
   ]
  },
  {
   "tipo": "test",
