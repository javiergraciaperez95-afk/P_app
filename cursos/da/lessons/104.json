 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Verbo y sustantivo",
    "@en": "Word and substantive"
   },
   "texto": [
    {
     "@es": "En vez de **efter at undersøgelsen blev afsluttet** (después de que el estudio fuera terminado) se dice **efter afslutningen af undersøgelsen** (después de la terminación del estudio).",
     "@en": "Instead of **efter at undersøgelsen blev afsluttet** (after the study was completed), **efter afslutningen af undersøgelsen** (after the study was completed) is said."
    },
    {
     "@es": "Los verbos se convierten en sustantivos con sufijos: **afslutte → afslutning** (terminar → terminación), **undersøge → undersøgelse** (investigar → investigación).",
     "@en": "The verbs become substantive with suffix: **afslutte → afslutning** (finish → termination), **undersøge → undersøgelse** (investigate → research)."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Qué cambia",
    "@en": "What changes"
   },
   "texto": [
    {
     "@es": "El sustantivo puede ir seguido de un complemento con **af** para indicar de qué acción o tema se habla: **afslutningen af undersøgelsen** = la terminación del estudio.",
     "@en": "The noun may be followed by a **af** supplement to indicate which action or theme is spoken of: **afslutningen af undersøgelsen** = the completion of the study."
    },
    {
     "@es": "Es más frecuente en prensa y documentos oficiales.",
     "@en": "It is more common in the press and official documents."
    }
   ]
  },
