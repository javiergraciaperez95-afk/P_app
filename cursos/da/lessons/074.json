 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Experiencias",
    "@en": "Experiences"
   },
   "texto": [
    {
     "@es": "Para decir si algo había pasado antes, usa **før** (antes), **aldrig** (nunca) o **endnu** (todavía).",
     "@en": "To say if anything had happened before, use **før** (before), **aldrig** (never) or **endnu** (still)."
    },
    {
     "@es": "Pregunta: **Havde du været i Danmark før?** = ¿Habías estado en Dinamarca antes?",
     "@en": "Question: **Havde du været i Danmark før?** = Have you been to Denmark before?"
    },
    {
     "@es": "Respuesta: **Nej, jeg havde aldrig været der.** = No, nunca había estado allí.",
     "@en": "Answer: **Nej, jeg havde aldrig været der.** = No, I had never been there."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Motivos",
    "@en": "Reasons"
   },
   "texto": [
    {
     "@es": "Lo que había pasado antes puede explicar lo que pasó después: **Jeg var træt, fordi jeg havde arbejdet hele dagen.** = Estaba cansado porque había trabajado todo el día.",
     "@en": "What had happened before can explain what happened next: **Jeg var træt, fordi jeg havde arbejdet hele dagen.** = I was tired because I had worked all day."
    },
    {
     "@es": "Con **fordi**, el auxiliar va delante del participio: **fordi jeg havde arbejdet**.",
     "@en": "With **fordi**, the auxiliary goes in front of the participle: **fordi jeg havde arbejdet**."
    }
   ]
  },
