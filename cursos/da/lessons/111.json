    {
     "texto": {
      "@es": "Anna y Peter vinieron juntos.",
      "@en": "Anna and Peter came together."
     },
     "explicacion": {
      "@es": "Eso sería «både… og».",
      "@en": "That would be «både… og»."
     }
    },
    {
     "texto": {
      "@es": "Anna vino, pero Peter no.",
      "@en": "Anna came, but Peter didn't."
     },
     "explicacion": {
      "@es": "Eso no es «hverken… eller».",
      "@en": "That's not «hverken… eller»."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "Cap. 27. ¿Qué significa «Her sælges brugte cykler»?",
