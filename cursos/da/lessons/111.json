  {
   "tipo": "test",
   "pregunta": {
    "@es": "Cap. 26. ¿Qué significa «Den roman har jeg læst»?",
    "@en": "Cap. 26. What does «Den roman har jeg læst» mean?"
   },
   "id": "da042-1",
   "opciones": [
    {
     "texto": {
      "@es": "Esa novela la he leído.",
      "@en": "I read that novel."
     },
     "explicacion": {
      "@es": "El objeto va delante para destacarlo.",
      "@en": "The object goes ahead to highlight it."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Yo he leído una novela.",
      "@en": "I've read a novel."
     },
     "explicacion": {
      "@es": "No destaca «esa novela».",
      "@en": "It does not stand out «that novel»."
     }
    },
    {
     "texto": {
      "@es": "Esa novela me ha leído.",
      "@en": "That novel has read me."
     },
     "explicacion": {
      "@es": "«læst» no cambia de sujeto.",
      "@en": "«læst» does not change subject."
     }
    }
   ]
  },
  {
   "tipo": "huecos",
   "pregunta": {
    "@es": "Cap. 26. pista: quien (sujeto)",
    "@en": "Cap. 26. Track: who (subject)"
   },
   "frase": "Det var Lars, ___ ringede.",
   "id": "da042-2",
   "opciones": [
    {
     "texto": "der",
     "explicacion": {
      "@es": "Con sujeto se usa «der».",
      "@en": "With subject is used «der»."
     },
     "correcta": true
    },
    {
     "texto": "som",
     "explicacion": {
      "@es": "Con objeto se usa «som», aquí el sujeto es Lars.",
      "@en": "For the purpose «som» is used, here the subject is Lars."
     }
    },
    {
     "texto": "hvad",
     "explicacion": {
      "@es": "Significa «qué».",
      "@en": "It means «what»."
     }
    }
   ]
  },
  {
   "tipo": "traduccion",
   "pregunta": {
    "@es": "¿Qué significa?",
