    {
     "texto": "Aquí vendí bicicletas usadas.",
     "explicacion": {
      "@es": "Eso sería pasado con «jeg».",
      "@en": "That would be past «jeg»."
     }
    },
    {
     "texto": {
      "@es": "Aquí venden bicicletas usadas.",
      "@en": "They sell used bicycles here."
     },
     "explicacion": {
      "@es": "Eso sería con sujeto «de».",
      "@en": "That would be «de» subject."
