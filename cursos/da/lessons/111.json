   "frase": "Cap. 26. Hverken Anna eller Peter kom til festen.",
   "id": "da042-3",
   "opciones": [
    {
     "texto": {
      "@es": "Ni Anna ni Peter vinieron a la fiesta.",
      "@en": "Neither Anna nor Peter came to the party."
     },
     "explicacion": {
      "@es": "«hverken… eller» = ni… ni.",
      "@en": "«hverken… eller» = neither."
