 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "La acción",
    "@en": "Action"
   },
   "texto": [
    {
     "@es": "Con **blive** (ser, pasar a ser) se describe el proceso o el momento de la acción: **Døren blev åbnet af vinden.** = La puerta fue abierta por el viento.",
     "@en": "**blive** (be, become) describes the process or time of action: **Døren blev åbnet af vinden.** = The door was opened by the wind."
    },
    {
     "@es": "Con **blive** puedes decir quién lo hizo con **af**.",
     "@en": "With **blive** you can tell who did it with **af**."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "El resultado",
    "@en": "The result"
   },
   "texto": [
    {
     "@es": "Con **være** se describe cómo está algo después de la acción: **Døren er åbnet.** = La puerta está abierta.",
     "@en": "**være** describes how something is after the action: **Døren er åbnet.** = The door is open."
    },
    {
     "@es": "Usa **være** para el estado que queda, y **blive** para lo que pasó.",
     "@en": "Use **være** for the remaining state, and **blive** for what happened."
    }
   ]
  },
