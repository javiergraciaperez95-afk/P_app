   "texto": [
    {
     "@es": "En una historia, el pluscuamperfecto cuenta lo que pasó antes. El pretérito cuenta lo que pasa en el momento.",
     "@en": "In a story, the perfect pluscuamperfect tells what happened before. The preterito tells what happens at the moment."
    },
    {
     "@es": "Ejemplo: **Toget var allerede kørt.** = El tren ya se había ido. Después: **Hun kom for sent.** = Llegó tarde.",
     "@en": "Example: **Toget var allerede kørt.** = The train was already gone. Then **Hun kom for sent.** was late."
    }
   ]
