 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Verbos con «at»",
    "@en": "Verbs with «at»"
   },
   "texto": [
    {
     "@es": "Muchos verbos van seguidos de **at** + infinitivo: **lover at** (prometer), **begynder at** (empezar), **prøver at** (intentar): **Jeg lovede at komme tidligt.** = Prometí venir temprano.",
     "@en": "Many verbs are followed by **at** + infinitive: **lover at** (promise), **begynder at** (start), **prøver at** (try): **Jeg lovede at komme tidligt.** = I promised to come early."
    },
    {
     "@es": "**Jeg begynder at blive sulten.** = Empiezo a tener hambre.",
     "@en": "**Jeg begynder at blive sulten.** = I'm starting to be hungry."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Expresiones con «at»",
    "@en": "Expressions with «at»"
   },
   "texto": [
    {
     "@es": "**Det er svært at** = es difícil: **Det er svært at vente så længe.** = Es difícil esperar tanto.",
     "@en": "**Det er svært at** = is difficult: **Det er svært at vente så længe.** = It is difficult to wait so long."
    },
    {
     "@es": "**Uden at** = sin: **Spis uden at vente.** = Come sin esperar.",
     "@en": "**Uden at** = without: **Spis uden at vente.** = Eat without waiting."
    },
    {
     "@es": "**I stedet for at** = en lugar de: **I stedet for at vente, gik jeg.** = En lugar de esperar, me fui.",
     "@en": "**I stedet for at** = instead of: **I stedet for at vente, gik jeg.** = Instead of waiting, I left."
    }
   ]
  },
