     "titulo": "Gratis transport?",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Flere borgere foreslår billigere offentlig transport for at mindske biltrafikken.",
       "alumno": "Varios ciudadanos proponen abaratar el transporte público para reducir el tráfico de coches.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "borgere",
         "ciudadanos"
        ],
        [
         "biltrafikken",
         "el tráfico de coches"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "De peger på, at en månedlig billet koster mere end tidligere.",
       "alumno": "Señalan que un abono mensual cuesta más que antes.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "peger på",
         "señalan"
        ],
        [
         "månedlig billet",
         "abono mensual"
        ],
        [
         "tidligere",
         "antes"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En lavere pris kan gøre det lettere for studerende og familier at vælge bussen.",
       "alumno": "Un precio más bajo puede facilitar que estudiantes y familias elijan el autobús.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "lavere",
         "más bajo"
        ],
        [
         "lettere",
         "más fácil"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Kritikere spørger dog, hvordan kommunen skal betale for ændringen.",
       "alumno": "Sin embargo, los críticos preguntan cómo pagará el municipio el cambio.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "kritikere",
         "críticos"
        ],
        [
         "betale for",
         "pagar por"
        ],
        [
         "ændringen",
         "el cambio"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Tallene tyder på en stigning i passagertallet, men de viser ikke alene, hvad der har forårsaget den.",
       "alumno": "Las cifras apuntan a un aumento del número de pasajeros, pero por sí solas no muestran qué lo ha causado.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "passagertallet",
         "número de pasajeros"
        ],
        [
         "alene",
         "por sí solas"
        ],
        [
         "forårsaget",
         "causado"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
   ]
