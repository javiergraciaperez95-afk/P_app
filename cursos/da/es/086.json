    {
     "tipo": "texto",
     "titulo": "En debat om lokalavisen",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "På et fiktivt debatforum diskuterer læserne en gratis nyhedsapp.",
       "alumno": "En un foro de debate ficticio, los lectores hablan de una aplicación gratuita de noticias.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "fiktivt debatforum",
         "foro de debate ficticio"
        ],
        [
         "nyhedsapp",
         "aplicación de noticias"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Ida synes, at alle bør kunne læse lokale nyheder uden betaling.",
       "alumno": "A Ida le parece que todos deberían poder leer noticias locales gratis.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "lokale nyheder",
         "noticias locales"
        ],
        [
         "uden betaling",
         "gratis"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Hun mener også, at annoncer skal være tydeligt markerede.",
       "alumno": "También opina que los anuncios deben estar claramente señalados.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "tydeligt markerede",
         "claramente señalados"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Niels svarer, at journalistik koster penge, og at læserne måske bør betale et lille abonnement.",
       "alumno": "Niels responde que el periodismo cuesta dinero y que quizá los lectores deberían pagar una pequeña suscripción.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "koster penge",
         "cuesta dinero"
        ],
        [
         "abonnement",
         "suscripción"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "De er enige om, at avisen skal rette fejl hurtigt.",
       "alumno": "Están de acuerdo en que el periódico debe corregir los errores pronto.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "enige om",
         "de acuerdo en"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "I tekstens faktaboks står der, at 200 personer har hentet appen på en måned. Resten af afsnittet viser læsernes holdninger.",
       "alumno": "En el recuadro informativo del texto dice que 200 personas descargaron la aplicación en un mes. El resto del párrafo presenta las opiniones de los lectores.",
