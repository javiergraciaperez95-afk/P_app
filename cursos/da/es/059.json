     "filas": [
      [
       {
        "texto": "Jeg har **ingen** rene sokker.",
        "lengua": "estudio"
       },
       {
        "texto": "No tengo ningún calcetín limpio.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "= Jeg har **ikke nogen** rene sokker.",
        "lengua": "estudio"
       },
       {
        "texto": "(lo mismo, más hablado)",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Der er **ingen** hjemme.",
        "lengua": "estudio"
       },
       {
        "texto": "No hay nadie en casa.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Jeg så **intet** / **ingenting**.",
        "lengua": "estudio"
       },
       {
        "texto": "No vi nada.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "= Jeg så **ikke noget**.",
        "lengua": "estudio"
       },
       {
        "texto": "(lo mismo, más hablado)",
        "lengua": "alumno"
       }
      ]
     ],
     "nota": "**intet** suena formal; al hablar se usa **ingenting** o **ikke noget**.",
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Verbos que acaban en -s",
     "columnas": [
      {
       "texto": "Danés",
       "lengua": "estudio"
      },
      {
       "texto": "Español",
       "lengua": "alumno"
      }
     ],
     "filas": [
      [
       {
        "texto": "Jeg **synes** …",
        "lengua": "estudio"
       },
       {
        "texto": "Opino…",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Det **lykkes** aldrig for mig.",
        "lengua": "estudio"
       },
       {
        "texto": "Nunca me sale bien.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "De **mødes**.",
        "lengua": "estudio"
       },
       {
        "texto": "Se ven (el uno al otro).",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "De **ses** tit.",
        "lengua": "estudio"
       },
       {
        "texto": "Se ven a menudo.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "De **skændes** altid.",
        "lengua": "estudio"
       },
       {
        "texto": "Siempre discuten.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "De skal **forloves / giftes**.",
        "lengua": "estudio"
       },
       {
        "texto": "Se van a prometer / casar.",
        "lengua": "alumno"
       }
      ]
     ],
     "nota": "La -s aquí = «el uno al otro», como nuestro «se» recíproco.",
     "tutora": ""
    }
   ]
