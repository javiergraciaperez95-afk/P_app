 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Ganas, fuerzas y necesidad",
     "texto": [
      "**Gider** = tener ganas: **Jeg gider ikke gå ud.** = No tengo ganas de salir.",
      "**Orker** = tener fuerzas o aguantar: **Jeg orker ikke mere.** = Ya no aguanto más.",
      "**Behøver** = necesitar; con **ikke** = no hace falta: **Du behøver ikke komme.** = No hace falta que vengas."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Matices de skal, må, bør y kan",
     "texto": [
      "**Skal** = obligación: **Du skal hvile dig.** = Tienes que descansar.",
      "**Må** = permiso o probabilidad: **Du må gerne bruge den.** = Puedes usarla. **Han må være træt.** = Debe de estar cansado.",
      "**Bør** = consejo: **Du bør hvile dig.** = Deberías descansar.",
      "**Kan** = posibilidad o capacidad: **Det kan ikke gøres.** = No puede hacerse."
     ],
     "tutora": ""
    },
