     "opciones": [
      {
       "texto": "En que la propuesta requiere sopesar efectos para distintos grupos.",
       "lengua": "alumno",
       "explicacion": "La noticia cita tiendas y municipio; la carta admite su preocupación y propone medir el tráfico.",
       "correcta": true
      },
      {
       "texto": "En que las plazas de aparcamiento deben eliminarse de inmediato.",
       "lengua": "alumno",
       "explicacion": "Ninguno afirma que ya esté decidido.",
       "correcta": false
      },
      {
       "texto": "En que no se debe celebrar una consulta pública.",
       "lengua": "alumno",
       "explicacion": "La noticia menciona una consulta y la carta no la rechaza.",
       "correcta": false
