 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Comparar fuentes",
     "texto": [
      "Observa quién habla, a quién se dirige y qué quiere conseguir. Una noticia suele resumir hechos y declaraciones; una carta de opinión defiende una postura."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Contrastar razones",
     "texto": [
      "**på den ene side … på den anden side** presenta dos lados; **derimod** y **til gengæld** contrastan elementos. La coincidencia temática no implica acuerdo."
     ],
     "tutora": ""
    }
   ]
  },
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Nyhedsartikel: Flere grønne områder",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Kommunen overvejer at omdanne en parkeringsplads til en offentlig park.",
       "alumno": "El municipio estudia convertir un aparcamiento en un parque público.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "overvejer",
         "estudia"
        ],
        [
         "omdanne",
         "transformar"
        ],
        [
         "offentlig",
         "público"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Ifølge forslaget skal området give plads til træer, bænke og regnvandsbede.",
       "alumno": "Según la propuesta, la zona daría cabida a árboles, bancos y jardines de lluvia.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "give plads til",
         "dar cabida a"
        ],
        [
         "regnvandsbede",
         "jardines de lluvia"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Kommunen fremhæver, at flere grønne områder kan dæmpe varmen om sommeren.",
       "alumno": "El municipio destaca que más zonas verdes pueden reducir el calor en verano.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "fremhæver",
         "destaca"
        ],
        [
         "dæmpe",
         "reducir"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Nogle butikker frygter dog, at færre parkeringspladser vil gøre det sværere for kunder at komme frem.",
       "alumno": "Sin embargo, algunas tiendas temen que menos plazas de aparcamiento dificulten la llegada de clientes.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "frygter",
         "temen"
        ],
        [
         "kunder",
         "clientes"
        ],
        [
         "komme frem",
         "llegar"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En beslutning ventes efter den offentlige høring i næste måned.",
       "alumno": "Se espera una decisión después de la consulta pública del mes que viene.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "ventes",
         "se espera"
        ],
        [
         "offentlige høring",
         "consulta pública"
        ]
       ],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Læserbrev: Parken bør prioriteres",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Det er forståeligt, at butikkerne er bekymrede, men kommunen bør prioritere et sundt bymiljø.",
       "alumno": "Es comprensible que las tiendas estén preocupadas, pero el municipio debería priorizar un entorno urbano saludable.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "forståeligt",
         "comprensible"
        ],
        [
         "prioritere",
         "priorizar"
        ],
        [
         "bymiljø",
         "entorno urbano"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "De fleste kunder kommer allerede med bus eller cykel, og området mangler skygge.",
       "alumno": "La mayoría de los clientes ya viene en autobús o bicicleta, y a la zona le falta sombra.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "mangler",
         "carece de"
        ],
        [
         "skygge",
         "sombra"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En park kan desuden gøre gaden mere attraktiv for både beboere og besøgende.",
       "alumno": "Además, un parque puede hacer la calle más atractiva tanto para residentes como para visitantes.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "attraktiv",
         "atractivo"
        ],
        [
         "både beboere og besøgende",
         "tanto residentes como visitantes"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Kommunen bør måle trafikken i en prøveperiode, før den træffer den endelige beslutning.",
       "alumno": "El municipio debería medir el tráfico durante un periodo de prueba antes de tomar la decisión definitiva.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "prøveperiode",
         "periodo de prueba"
        ],
        [
         "endelige",
         "definitiva"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
   ]
