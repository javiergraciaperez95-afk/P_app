   "etapa": "leer",
   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Kortere ventetid",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En regional rapport viser, at ventetiden på flere behandlinger er steget det seneste år.",
       "alumno": "Un informe regional muestra que el tiempo de espera de varios tratamientos ha aumentado durante el último año.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "regional rapport",
         "informe regional"
        ],
        [
         "steget",
         "aumentado"
        ],
        [
         "det seneste år",
         "el último año"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Rapporten peger især på mangel på personale og begrænset kapacitet.",
       "alumno": "El informe señala sobre todo la falta de personal y la capacidad limitada.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "især",
         "sobre todo"
        ],
        [
         "mangel på",
         "falta de"
        ],
        [
         "begrænset",
         "limitada"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Regionen foreslår derfor at udvide forebyggelsen og flytte nogle kontroller til lokale klinikker.",
       "alumno": "Por eso la región propone ampliar la prevención y trasladar algunos controles a clínicas locales.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "udvide",
         "ampliar"
        ],
        [
         "flytte",
         "trasladar"
        ],
        [
         "lokale klinikker",
         "clínicas locales"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Ifølge rapporten kan det frigøre tid til patienter med større behov.",
       "alumno": "Según el informe, eso puede liberar tiempo para pacientes con mayor necesidad.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "ifølge",
         "según"
        ],
        [
         "frigøre",
         "liberar"
        ],
        [
         "behov",
         "necesidad"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Forslaget kræver dog nye investeringer, og virkningen skal vurderes efter et år.",
       "alumno": "Sin embargo, la propuesta requiere nuevas inversiones y su efecto deberá evaluarse al cabo de un año.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "virkningen",
         "el efecto"
        ],
        [
         "vurderes",
         "evaluarse"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
   ]
  },
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Presentar propuestas",
     "texto": [
      "**foreslå** = proponer; **prioritere** = priorizar; **på længere sigt** = a largo plazo. Una propuesta puede describir un objetivo, no un resultado ya conseguido."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Causa y propósito",
     "texto": [
      "**fordi** introduce una causa; **for at** expresa propósito; **derfor** presenta una consecuencia y suele ir seguido del verbo antes del sujeto: **Derfor bør kommunen…**"
     ],
     "tutora": ""
    }
   ]
  },
