    {
     "tipo": "texto",
     "titulo": "En plan for bymidten",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Før kommunen træffer en beslutning, bør den tage højde for konsekvenserne for butikkerne.",
       "alumno": "Antes de tomar una decisión, el municipio debería tener en cuenta las consecuencias para las tiendas.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "træffer en beslutning",
         "toma una decisión"
        ],
        [
         "tage højde for",
         "tener en cuenta"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Flere handlende har allerede taget stilling til forslaget.",
       "alumno": "Varios comerciantes ya se han pronunciado sobre la propuesta.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "handlende",
         "comerciantes"
        ],
        [
         "taget stilling til",
         "se han pronunciado sobre"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Nogle lægger mærke til, at færre biler giver mere plads til fodgængere.",
       "alumno": "Algunos observan que menos coches dejan más espacio a los peatones.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "lægger mærke til",
         "observan"
        ],
        [
         "fodgængere",
         "peatones"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Andre peger på, at ændringen kan føre til mindre handel i begyndelsen.",
       "alumno": "Otros señalan que el cambio puede conducir a una reducción del comercio al principio.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "peger på",
         "señalan"
        ],
        [
         "føre til",
         "conducir a"
        ],
        [
         "i begyndelsen",
         "al principio"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En holdbar løsning kræver derfor, at kommunen lytter til begge grupper.",
       "alumno": "Por eso, una solución sostenible requiere que el municipio escuche a ambos grupos.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "holdbar",
         "sostenible; duradera"
        ],
        [
         "begge",
         "ambos"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
   ]
