    {
     "tipo": "texto",
     "titulo": "Automatisering på kontoret",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Flere virksomheder afprøver nu digitale værktøjer, der kan løse rutineopgaver.",
       "alumno": "Más empresas están probando herramientas digitales que pueden resolver tareas rutinarias.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "afprøver",
         "prueban"
        ],
        [
         "rutineopgaver",
         "tareas rutinarias"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Det betyder ikke nødvendigvis, at medarbejderne bliver overflødige.",
       "alumno": "Eso no significa necesariamente que los empleados vayan a sobrar.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "nødvendigvis",
         "necesariamente"
        ],
        [
         "medarbejderne",
         "los empleados"
        ],
        [
         "overflødige",
         "prescindibles"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Nogle opgaver forsvinder, mens andre kræver mere kontrol og faglig vurdering.",
       "alumno": "Algunas tareas desaparecen, mientras que otras requieren más supervisión y criterio profesional.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "forsvinder",
         "desaparecen"
        ],
        [
         "kontrol",
         "supervisión"
        ],
        [
         "faglig vurdering",
         "criterio profesional"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Arbejdsgiverne forventes at tilbyde efteruddannelse, hvis nye systemer ændrer arbejdet.",
       "alumno": "Se espera que los empleadores ofrezcan formación continua si los nuevos sistemas cambian el trabajo.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "arbejdsgiverne",
         "los empleadores"
        ],
        [
         "tilbyde",
         "ofrecer"
        ],
        [
         "systemer",
         "sistemas"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Gevinsten afhænger derfor både af teknologien og af, hvordan den indføres.",
       "alumno": "Por eso, el beneficio depende tanto de la tecnología como de cómo se introduzca.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "gevinsten",
         "el beneficio"
        ],
        [
         "afhænger",
         "depende"
        ],
        [
         "indføres",
         "se introduce"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
   ]
  },
