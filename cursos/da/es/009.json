        "lengua": "estudio"
       },
       {
        "texto": "Muchas gracias",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**Tusind tak**",
        "lengua": "estudio"
       },
       {
        "texto": "Mil gracias (muy usado)",
        "lengua": "alumno"
       }
      ],
      [
