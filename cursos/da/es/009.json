     "filas": [
      [
       {
        "texto": "**Godmorgen!**",
        "lengua": "estudio"
       },
       {
        "texto": "¡Buenos días!",
        "lengua": "alumno"
       },
       {
        "texto": "Saludo de mañana.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**Goddag!**",
        "lengua": "estudio"
       },
       {
        "texto": "¡Buenos días! / ¡Buen día!",
        "lengua": "alumno"
       },
       {
        "texto": "Saludo diurno, algo más formal que «hej».",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**Godaften!**",
        "lengua": "estudio"
       },
       {
        "texto": "¡Buenas tardes/noches!",
        "lengua": "alumno"
       },
       {
        "texto": "Saludo de tarde-noche.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**Hej!**",
        "lengua": "estudio"
       },
       {
        "texto": "¡Hola! / ¡Adiós!",
        "lengua": "alumno"
       },
       {
        "texto": "Cotidiano y válido a cualquier hora.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**Dav!**",
        "lengua": "estudio"
       },
       {
        "texto": "¡Hola!",
        "lengua": "alumno"
       },
       {
        "texto": "Informal; se usa sobre todo al saludar.",
        "lengua": "alumno"
       }
      ]
     ],
     "nota": "El límite entre **godmorgen** y **goddag** no depende de una hora fija; **hej** es la opción cotidiana más versátil.",
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "¿Qué tal?",
     "columnas": [
      {
       "texto": "Danés",
       "lengua": "estudio"
      },
      {
       "texto": "Español",
       "lengua": "alumno"
      }
     ],
     "filas": [
      [
       {
        "texto": "**Hvordan har du det?**",
        "lengua": "estudio"
       },
       {
        "texto": "¿Qué tal estás?",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "(Jeg har det) **fint / godt**.",
        "lengua": "estudio"
       },
       {
        "texto": "Estoy bien.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "(Jeg har det) **ikke så godt**.",
        "lengua": "estudio"
       },
       {
        "texto": "No muy bien.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**Hvordan går det?**",
        "lengua": "estudio"
       },
       {
        "texto": "¿Qué tal va?",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "(Det går) **godt**.",
        "lengua": "estudio"
       },
       {
        "texto": "Va bien.",
        "lengua": "alumno"
       }
      ]
     ],
     "nota": "Se suele responder brevemente, por ejemplo **fint/godt** o **ikke så godt**. Según la situación, la conversación puede continuar o terminar ahí.",
     "tutora": ""
    },
