       {
        "texto": "**Hvor ser du godt ud** i aften!",
        "lengua": "estudio"
       },
       {
        "texto": "¡Qué guapo/a estás esta noche!",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Det er **vel nok** et flot slips!",
        "lengua": "estudio"
       },
       {
        "texto": "¡Qué corbata más bonita!",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**Sikken en flot kjole!**",
        "lengua": "estudio"
       },
       {
        "texto": "¡Qué vestido más bonito!",
        "lengua": "alumno"
       }
      ],
