    {
     "tipo": "texto",
     "titulo": "En ny app til lokalavisen",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En fiktiv lokalavis lancerer en app, hvor læserne kan følge nyheder fra deres område.",
       "alumno": "Un periódico local ficticio lanza una aplicación en la que los lectores pueden seguir las noticias de su zona.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "fiktiv lokalavis",
         "periódico local ficticio"
        ],
        [
         "følge nyheder",
         "seguir las noticias"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Nogle artikler er gratis, mens andre kræver et abonnement.",
       "alumno": "Algunos artículos son gratis, mientras que otros requieren una suscripción.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "kræver et abonnement",
         "requieren una suscripción"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "I en faktaboks står der, at 350 personer har downloadet appen på tre uger.",
       "alumno": "En un recuadro informativo se indica que 350 personas descargaron la aplicación en tres semanas.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "faktaboks",
         "recuadro informativo"
        ],
        [
         "personer",
         "personas"
        ],
        [
         "på tre uger",
         "en tres semanas"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Flere læsere synes, at det er praktisk, men andre mener, at lokale nyheder bør være gratis.",
       "alumno": "A varios lectores les parece práctico, pero otros opinan que las noticias locales deberían ser gratuitas.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "flere læsere",
         "varios lectores"
        ],
        [
         "bør være gratis",
         "deberían ser gratuitas"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Redaktionen siger, at den vil spørge brugerne før en større ændring.",
       "alumno": "La redacción dice que preguntará a los usuarios antes de hacer un cambio importante.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "spørge brugerne",
         "preguntar a los usuarios"
        ],
        [
         "større ændring",
         "cambio importante"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
