    {
     "tipo": "tabla",
     "titulo": "¿Qué te pasa?",
     "columnas": [
      {
       "texto": "Danés",
       "lengua": "estudio"
      },
      {
       "texto": "Español",
       "lengua": "alumno"
      }
     ],
     "filas": [
      [
       {
        "texto": "Jeg er **syg**.",
        "lengua": "estudio"
       },
       {
        "texto": "Estoy enfermo.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Jeg har det **ikke så godt**.",
        "lengua": "estudio"
       },
       {
        "texto": "No me encuentro bien.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Jeg skal **kaste op**.",
        "lengua": "estudio"
       },
       {
        "texto": "Voy a vomitar.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Jeg har **feber**.",
        "lengua": "estudio"
       },
       {
        "texto": "Tengo fiebre.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Jeg har **ondt i** halsen.",
        "lengua": "estudio"
       },
       {
        "texto": "Me duele la garganta.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Jeg har **hovedpine / mavepine**.",
        "lengua": "estudio"
       },
       {
        "texto": "Me duele la cabeza / la tripa.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Jeg har det **bedre**.",
        "lengua": "estudio"
       },
       {
        "texto": "Estoy mejor.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Jeg er **rask**.",
        "lengua": "estudio"
       },
       {
        "texto": "Estoy bien (sano).",
        "lengua": "alumno"
       }
      ]
     ],
     "nota": "**ondt i** + parte del cuerpo (con artículo): ondt i hoved**et**, ondt i ryg**gen**.",
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Consolar",
     "columnas": [
      {
       "texto": "Danés",
       "lengua": "estudio"
      },
      {
       "texto": "Español",
       "lengua": "alumno"
      }
     ],
     "filas": [
      [
       {
        "texto": "**Hvordan har du det nu?**",
        "lengua": "estudio"
       },
       {
        "texto": "¿Cómo estás ahora?",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**Gør det ondt?**",
        "lengua": "estudio"
       },
       {
        "texto": "¿Te duele?",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**Det er synd for dig.**",
        "lengua": "estudio"
       },
       {
        "texto": "¡Pobrecito!",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**Du skal se, det går snart over.**",
        "lengua": "estudio"
       },
       {
        "texto": "Ya verás, enseguida se pasa.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**Jeg håber, du snart bliver rask.**",
        "lengua": "estudio"
       },
       {
        "texto": "Espero que te mejores pronto.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**Jeg håber ikke, du har influenza.**",
        "lengua": "estudio"
       },
       {
        "texto": "Espero que no tengas gripe.",
        "lengua": "alumno"
       }
      ]
     ],
