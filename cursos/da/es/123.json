   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Et bibliotek for hele byen",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Kommunen overvejer at holde biblioteket åbent to aftener mere om ugen.",
       "alumno": "El municipio estudia abrir la biblioteca dos tardes más por semana.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "overvejer",
         "estudia"
        ],
        [
         "åbent",
         "abierto"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En brugerundersøgelse viser, at mange studerende mangler et roligt sted efter klokken seks.",
       "alumno": "Una encuesta a usuarios muestra que muchos estudiantes carecen de un lugar tranquilo después de las seis.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "brugerundersøgelse",
         "encuesta a usuarios"
        ],
        [
         "mangler",
         "carecen de"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Biblioteket skal dog bruge flere medarbejdere, hvis åbningstiden udvides.",
       "alumno": "Sin embargo, la biblioteca necesitará más empleados si se amplía el horario.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "åbningstiden",
         "el horario de apertura"
        ],
        [
         "udvides",
         "se amplía"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Nogle naboer frygter støj, mens andre mener, at længere åbningstid gør tilbuddet mere tilgængeligt.",
       "alumno": "Algunos vecinos temen el ruido, mientras que otros creen que un horario más largo hace el servicio más accesible.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "naboer",
         "vecinos"
        ],
        [
         "støj",
         "ruido"
        ],
        [
         "tilgængeligt",
         "accesible"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Kommunen foreslår en prøveperiode på tre måneder og vil derefter vurdere brugen og udgifterne.",
       "alumno": "El municipio propone un periodo de prueba de tres meses y después evaluará el uso y los gastos.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "prøveperiode",
         "periodo de prueba"
        ],
        [
         "udgifterne",
         "los gastos"
        ]
       ],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Kommentar fra en læser",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Det er en fornuftig idé, hvis kommunen offentliggør resultaterne fra prøveperioden.",
       "alumno": "Es una idea sensata si el municipio publica los resultados del periodo de prueba.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "fornuftig",
         "sensata"
        ],
        [
         "offentliggør",
         "publica"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Flere åbningstimer hjælper ikke meget, hvis der ikke er personale til at vejlede brugerne.",
       "alumno": "Más horas de apertura no ayudan mucho si no hay personal para orientar a los usuarios.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "vejlede",
         "orientar"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Til gengæld kan et åbent bibliotek give unge et trygt sted at læse og arbejde om aftenen.",
       "alumno": "Por otra parte, una biblioteca abierta puede ofrecer a los jóvenes un lugar seguro para leer y trabajar por la tarde-noche.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "trygt",
         "seguro"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Kommunen bør derfor undersøge både efterspørgslen og de samlede omkostninger.",
       "alumno": "Por eso, el municipio debería estudiar tanto la demanda como los costes totales.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "efterspørgslen",
         "la demanda"
        ],
        [
         "samlede omkostninger",
         "costes totales"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
   ]
