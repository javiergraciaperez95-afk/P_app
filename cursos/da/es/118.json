    {
     "tipo": "texto",
     "titulo": "Flere målinger er nødvendige",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En foreløbig måling viser en lille stigning i temperaturen.",
       "alumno": "Una medición provisional muestra un pequeño aumento de la temperatura.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "foreløbig",
         "provisional"
        ],
        [
         "stigning",
         "aumento"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Forskerne mener, at ændringen sandsynligvis hænger sammen med den varme sommer.",
       "alumno": "Los investigadores consideran que el cambio probablemente está relacionado con el verano cálido.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "hænger sammen med",
         "está relacionado con"
        ],
        [
         "varme",
         "cálido"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En enkelt måling kan dog ikke forklare udviklingen.",
       "alumno": "Sin embargo, una sola medición no puede explicar la evolución.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "en enkelt",
         "una sola"
        ],
        [
         "udviklingen",
         "la evolución"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Der skal indsamles data fra flere år, før man kan drage en sikker konklusion.",
       "alumno": "Hay que recopilar datos de varios años antes de poder extraer una conclusión segura.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "indsamles",
         "recopilarse"
        ],
        [
         "drage en sikker konklusion",
         "extraer una conclusión segura"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Derfor er påstanden om en permanent ændring endnu ikke dokumenteret.",
       "alumno": "Por eso, la afirmación de que se trata de un cambio permanente todavía no está documentada.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "permanent",
         "permanente"
        ],
        [
         "dokumenteret",
         "documentada"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
   ]
