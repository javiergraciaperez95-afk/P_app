 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Lo que tienes que recordar",
     "texto": [
      "1. Afirmación: **sagde, at** + orden subordinado. 2. Pregunta de sí o no: **spurgte, om** + orden subordinado. 3. Pregunta con palabra: **spurgte, hvor/hvornår** + orden subordinado.",
      "4. En una narración, suele cambiar el tiempo verbal; el contexto y la vigencia de la información también cuentan."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Ojo con «ikke» y «altid»",
     "texto": [
      "En la frase indirecta, **ikke** y **altid** van antes del verbo conjugado: **Han sagde, at han ikke havde tid.** = Dijo que no tenía tiempo.",
      "**Hun spurgte, om hun altid var sen.** = Preguntó si siempre llegaba tarde."
     ],
     "tutora": ""
    }
   ]
  },
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Lo que contó Louise",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Louise sagde, at hun ikke kunne komme til festen.",
       "alumno": "Louise dijo que no podía venir a la fiesta.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "sagde, at hun ikke kunne",
         "dijo que no podía"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Hun sagde også, at hun havde haft en svær uge.",
       "alumno": "También dijo que había tenido una semana difícil.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "havde haft",
         "había tenido"
        ],
        [
         "en svær uge",
         "una semana difícil"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Mette spurgte, om hun altid var så træt.",
       "alumno": "Mette preguntó si siempre estaba tan cansada.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "om hun altid var så træt",
         "si siempre estaba tan cansada"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Louise svarede, at hun ikke vidste det.",
       "alumno": "Louise respondió que no lo sabía.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "at hun ikke vidste",
         "que no lo sabía"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Men hun spurgte, hvornår de skulle mødes igen.",
       "alumno": "Pero preguntó cuándo volverían a quedar.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "hvornår de skulle mødes",
         "cuándo volverían a quedar"
        ]
       ],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "På et kursus",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "På et kursus fortalte Sara, at hun var flyttet til Danmark for tre år siden.",
       "alumno": "En un curso, Sara contó que se había mudado a Dinamarca hacía tres años.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "fortalte Sara, at",
         "Sara contó que"
        ],
        [
         "var flyttet",
         "se había mudado"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Hun sagde, at hun først havde svært ved at følge med i timerne.",
       "alumno": "Dijo que al principio le costaba seguir las clases.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "havde svært ved",
         "le costaba"
        ],
        [
         "følge med i timerne",
         "seguir las clases"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En studiegruppe havde hjulpet hende.",
       "alumno": "Un grupo de estudio la había ayudado.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "havde hjulpet",
         "había ayudado"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Læreren spurgte, om alle kendte de forskellige muligheder i uddannelsessystemet.",
       "alumno": "El profesor preguntó si todos conocían las distintas opciones del sistema educativo.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "spurgte, om",
         "preguntó si"
        ],
        [
         "forskellige muligheder",
         "distintas opciones"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Mikkel svarede, at han havde gået på en lille skole, og at hans søster havde valgt en anden vej.",
       "alumno": "Mikkel respondió que había ido a una escuela pequeña y que su hermana había elegido otro camino.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "svarede, at",
         "respondió que"
        ],
        [
         "havde valgt",
         "había elegido"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Efter timen sammenlignede de deres erfaringer. De havde gået i skole på forskellige måder, men begge ville fortsætte med at lære.",
       "alumno": "Después de clase compararon sus experiencias. Habían estudiado de maneras distintas, pero ambos querían seguir aprendiendo.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "sammenlignede",
         "compararon"
        ],
        [
         "erfaringer",
         "experiencias"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
   ]
