   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Verbs with «at»",
     "texto": [
      "Many verbs are followed by **at** + infinitive: **lover at** (to promise), **begynder at** (to start), **prøver at** (to try): **Jeg lovede at komme tidligt.** = I promised to come early.",
      "**Jeg begynder at blive sulten.** = I'm starting to get hungry."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Expressions with «at»",
     "texto": [
      "**Det er svært at** = it's difficult to: **Det er svært at vente så længe.** = It's hard to wait so long.",
      "**Uden at** = without: **Spis uden at vente.** = Eat without waiting.",
      "**I stedet for at** = instead of: **I stedet for at vente, gik jeg.** = Instead of waiting, I left."
     ],
     "tutora": ""
    },
