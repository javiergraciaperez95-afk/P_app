 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "What you need to remember",
     "texto": [
      "1. Statement: **sagde, at** + subordinate word order. 2. Yes/no question: **spurgte, om** + subordinate word order. 3. Question with a question word: **spurgte, hvor/hvornår** + subordinate word order.",
      "4. In a narrative, the verb tense usually changes; the context and whether the information still holds also matter."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Watch out for «ikke» and «altid»",
     "texto": [
      "In reported speech, **ikke** and **altid** go before the conjugated verb: **Han sagde, at han ikke havde tid.** = He said he didn't have time.",
      "**Hun spurgte, om hun altid var sen.** = She asked if she was always late."
     ],
     "tutora": ""
    }
   ]
  },
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "texto",
     "titulo": "What Louise said",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Louise sagde, at hun ikke kunne komme til festen.",
       "alumno": "Louise said she couldn't come to the party.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "sagde, at hun ikke kunne",
         "said she couldn't"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Hun sagde også, at hun havde haft en svær uge.",
       "alumno": "She also said she'd had a difficult week.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "havde haft",
         "had had"
        ],
        [
         "en svær uge",
         "a difficult week"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Mette spurgte, om hun altid var så træt.",
       "alumno": "Mette asked if she was always so tired.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "om hun altid var så træt",
         "if she was always so tired"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Louise svarede, at hun ikke vidste det.",
       "alumno": "Louise replied that she didn't know.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "at hun ikke vidste",
         "that she didn't know"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Men hun spurgte, hvornår de skulle mødes igen.",
       "alumno": "But she asked when they would meet again.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "hvornår de skulle mødes",
         "when they would meet again"
        ]
       ],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "På et kursus",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "På et kursus fortalte Sara, at hun var flyttet til Danmark for tre år siden.",
       "alumno": "At a course, Sara said she had moved to Denmark three years earlier.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "fortalte Sara, at",
         "Sara said that"
        ],
        [
         "var flyttet",
         "had moved"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Hun sagde, at hun først havde svært ved at følge med i timerne.",
       "alumno": "She said that at first she found it hard to keep up with the classes.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "havde svært ved",
         "found it hard"
        ],
        [
         "følge med i timerne",
         "keep up with the classes"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En studiegruppe havde hjulpet hende.",
       "alumno": "A study group had helped her.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "havde hjulpet",
         "had helped"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Læreren spurgte, om alle kendte de forskellige muligheder i uddannelsessystemet.",
       "alumno": "The teacher asked whether everyone knew the different options in the education system.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "spurgte, om",
         "asked whether"
        ],
        [
         "forskellige muligheder",
         "different options"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Mikkel svarede, at han havde gået på en lille skole, og at hans søster havde valgt en anden vej.",
       "alumno": "Mikkel replied that he had gone to a small school and that his sister had chosen another path.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "svarede, at",
         "replied that"
        ],
        [
         "havde valgt",
         "had chosen"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Efter timen sammenlignede de deres erfaringer. De havde gået i skole på forskellige måder, men begge ville fortsætte med at lære.",
       "alumno": "After class they compared their experiences. They had studied in different ways, but both wanted to keep learning.",
       "literal": "",
