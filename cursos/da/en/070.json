    },
    {
     "tipo": "explicacion",
     "titulo": "«Ville» doesn't change",
     "texto": [
      "**Ville** is the same for all persons: **jeg ville**, **du ville**, **han ville**, **vi ville**.",
      "After **ville** the infinitive always comes, without **at**: **ville komme**, **ville rejse**, **ville købe**."
     ],
     "tutora": ""
    }
   ]
