    {
     "tipo": "explicacion",
     "titulo": "Inviting",
     "texto": [
      "To invite, use **Har du lyst til at …?** = Do you feel like…? and **Hvad siger du til at …?** = What do you say to…?",
      "Example: **Hvad siger du til at mødes lørdag?** = How about meeting up on Saturday?"
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Saying thank you",
     "texto": [
      "To thank someone for something that happened: **Tak for sidst!** = Thanks for last time! To thank someone for an invitation: **Tak for invitationen.** = Thanks for the invitation.",
      "To finish: **Jeg glæder mig til at høre fra dig.** = I look forward to hearing from you."
     ],
     "tutora": ""
    },
