   "piezas": [
    {
     "tipo": "tabla",
     "titulo": "The four modal verbs",
     "columnas": [
      {
       "texto": "Danés",
       "lengua": "estudio"
      },
      {
       "texto": "Use",
       "lengua": "alumno"
      },
      {
       "texto": "Example",
       "lengua": "alumno"
      }
     ],
     "filas": [
      [
       {
        "texto": "**kan**",
        "lengua": "estudio"
       },
       {
        "texto": "can, know",
        "lengua": "alumno"
       },
       {
        "texto": "Jeg **kan** synge.",
        "lengua": "estudio"
       }
      ],
      [
       {
        "texto": "**må**",
        "lengua": "estudio"
       },
       {
        "texto": "permission / prohibition",
        "lengua": "alumno"
       },
       {
        "texto": "**Må** jeg …? · Du **må ikke** …",
        "lengua": "estudio"
       }
      ],
      [
       {
        "texto": "**vil**",
        "lengua": "estudio"
       },
       {
        "texto": "want",
        "lengua": "alumno"
       },
       {
        "texto": "Jeg **vil** gerne …",
        "lengua": "estudio"
       }
      ],
      [
       {
        "texto": "**skal**",
        "lengua": "estudio"
       },
       {
        "texto": "must, going to",
        "lengua": "alumno"
       },
       {
        "texto": "Jeg **skal** køre farmor hjem.",
        "lengua": "estudio"
       }
      ]
     ],
     "nota": "They take the infinitive without «at»: kan synge, må låne.",
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Permission and prohibition",
     "columnas": [
      {
       "texto": "Danés",
       "lengua": "estudio"
      },
      {
       "texto": "English",
       "lengua": "alumno"
      }
     ],
     "filas": [
      [
       {
        "texto": "**Må jeg (godt)** tale med Anna?",
        "lengua": "estudio"
       },
       {
        "texto": "May I speak to Anna?",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Ja, det **må du godt / gerne**.",
        "lengua": "estudio"
       },
       {
        "texto": "Yes, of course.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Du **må ikke** bruge min computer.",
        "lengua": "estudio"
       },
       {
        "texto": "You mustn't use my computer.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Du **må aldrig** ringe til mig på kontoret.",
        "lengua": "estudio"
       },
       {
        "texto": "Don't ever call me at the office.",
        "lengua": "alumno"
       }
      ]
     ],
     "nota": "Watch out! **må ikke** = must not (forbidden), not «you don't have to».",
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Watch out for «gå»",
     "texto": [
      "**gå** means only **to walk**. If you go by car, train or plane, you say **tage** or **rejse**:\n\n- Jeg **går** i skole. (on foot)\n- Jeg **tager** til Japan. / Jeg **rejser** til Japan."
     ],
     "tutora": "pensando"
    }
   ]
  },
  {
