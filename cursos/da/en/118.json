   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Degrees of certainty",
     "texto": [
      "**muligvis** = possibly; **sandsynligvis** = probably; **vist** = apparently; **måske** = perhaps. **Sikkert** can mean «certainly» or «for sure» depending on the context."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Attributing a claim",
     "texto": [
      "**ifølge forskerne** = according to the researchers; **rapporten vurderer** = the report considers; **det tyder på** = that points to. Attribution shows whose interpretation it is."
     ],
     "tutora": ""
    }
   ]
  },
