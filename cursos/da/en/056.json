       }
      ],
      [
       {
        "texto": "Nina har **selv** ryddet op.",
        "lengua": "estudio"
       },
       {
        "texto": "Nina tidied up herself.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**Selv** skufferne er i orden.",
        "lengua": "estudio"
       },
       {
        "texto": "Even the drawers are in order.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Hun er **både** lille **og** tyk.",
        "lengua": "estudio"
       },
       {
        "texto": "She's both short and fat.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "gift → **u**gift · moderne → **u**moderne",
        "lengua": "estudio"
       },
       {
        "texto": "married → single · modern → old-fashioned",
        "lengua": "alumno"
       }
      ]
     ],
     "nota": "**selv** in front of a noun = «even». **u-** = «un-, dis-, not».",
