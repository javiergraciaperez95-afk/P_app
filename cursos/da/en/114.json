 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Distinguishing fact and judgement",
     "texto": [
      "A percentage can be a fact; «urimelig» (unfair) is a judgement. A figure on its own doesn't prove the cause: look for comparison, period and group measured."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Expressing caution",
     "texto": [
      "**tyder på** = points to; **ser ud til** = seems; **der er risiko for** = there is a risk of. These expressions limit the claim instead of presenting it as certain."
     ],
     "tutora": ""
    }
   ]
  },
