     "filas": [
      [
       {
        "texto": "**Tak**",
        "lengua": "estudio"
       },
       {
        "texto": "Thanks",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**Mange tak**",
        "lengua": "estudio"
       },
       {
        "texto": "Thank you very much",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**Tusind tak**",
        "lengua": "estudio"
       },
       {
        "texto": "Thanks a million (very common)",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**Tak skal du have**",
        "lengua": "estudio"
       },
       {
        "texto": "Thank you (more emphatic)",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**Tak for mad**",
        "lengua": "estudio"
       },
       {
        "texto": "Thanks for the meal (after eating)",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**Tak for sidst**",
        "lengua": "estudio"
       },
       {
        "texto": "Thanks for the last get-together (party, visit or event)",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**Selv tak**",
        "lengua": "estudio"
       },
       {
        "texto": "You're welcome",
        "lengua": "alumno"
       }
      ]
     ],
     "nota": "",
