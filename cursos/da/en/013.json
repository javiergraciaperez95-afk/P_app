       },
       {
        "texto": "countries, cities and certain buildings or activities",
        "lengua": "alumno"
       },
       {
        "texto": "i Danmark, i Århus, i banken, i biografen, i kirke, i skole, i supermarkedet",
        "lengua": "estudio"
       }
      ],
      [
       {
        "texto": "**på**",
        "lengua": "estudio"
       },
       {
        "texto": "many Danish islands, areas and certain places",
        "lengua": "alumno"
       },
       {
        "texto": "på Fyn, på bordet, på 2. sal, på apoteket, på biblioteket, på arbejde, på universitetet, på ferie",
        "lengua": "estudio"
       }
      ],
      [
       {
        "texto": "**til**",
        "lengua": "estudio"
       },
       {
        "texto": "direction, events",
        "lengua": "alumno"
       },
       {
        "texto": "til fest, til Frankrig, til frisør, til læge, til koncert, til stranden",
        "lengua": "estudio"
       }
      ],
      [
       {
        "texto": "**hos**",
        "lengua": "estudio"
       },
       {
        "texto": "at someone's home / at someone's business",
