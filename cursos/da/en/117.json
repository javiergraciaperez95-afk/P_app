     "tipo": "texto",
     "titulo": "Kortere ventetid",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En regional rapport viser, at ventetiden på flere behandlinger er steget det seneste år.",
       "alumno": "A regional report shows that waiting times for several treatments have increased over the last year.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "regional rapport",
         "regional report"
        ],
        [
         "steget",
         "increased"
        ],
        [
         "det seneste år",
         "the last year"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Rapporten peger især på mangel på personale og begrænset kapacitet.",
       "alumno": "The report points mainly to a shortage of staff and limited capacity.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "især",
         "mainly"
        ],
        [
         "mangel på",
         "shortage of"
        ],
        [
         "begrænset",
         "limited"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Regionen foreslår derfor at udvide forebyggelsen og flytte nogle kontroller til lokale klinikker.",
       "alumno": "That's why the region proposes expanding prevention and moving some checks to local clinics.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "udvide",
         "expanding"
        ],
        [
         "flytte",
         "moving"
        ],
        [
         "lokale klinikker",
         "local clinics"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Ifølge rapporten kan det frigøre tid til patienter med større behov.",
       "alumno": "According to the report, this could free up time for patients with greater needs.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "ifølge",
         "according to"
        ],
        [
         "frigøre",
         "free up"
        ],
        [
         "behov",
         "need"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Forslaget kræver dog nye investeringer, og virkningen skal vurderes efter et år.",
       "alumno": "However, the proposal requires new investment, and its effect will need to be assessed after a year.",
       "literal": "",
