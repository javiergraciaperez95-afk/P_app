   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Et bibliotek for hele byen",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Kommunen overvejer at holde biblioteket åbent to aftener mere om ugen.",
       "alumno": "The council is considering keeping the library open two more evenings a week.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "overvejer",
         "is considering"
        ],
        [
         "åbent",
         "open"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En brugerundersøgelse viser, at mange studerende mangler et roligt sted efter klokken seks.",
       "alumno": "A user survey shows that many students lack a quiet place after six o'clock.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "brugerundersøgelse",
         "user survey"
        ],
        [
         "mangler",
         "lack"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Biblioteket skal dog bruge flere medarbejdere, hvis åbningstiden udvides.",
       "alumno": "However, the library will need more staff if opening hours are extended.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "åbningstiden",
         "opening hours"
        ],
        [
         "udvides",
         "are extended"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Nogle naboer frygter støj, mens andre mener, at længere åbningstid gør tilbuddet mere tilgængeligt.",
       "alumno": "Some residents fear noise, while others believe longer opening hours make the service more accessible.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "naboer",
         "residents"
        ],
        [
         "støj",
         "noise"
        ],
        [
         "tilgængeligt",
         "accessible"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Kommunen foreslår en prøveperiode på tre måneder og vil derefter vurdere brugen og udgifterne.",
       "alumno": "The council proposes a three-month trial period and will then assess usage and costs.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "prøveperiode",
         "trial period"
        ],
        [
         "udgifterne",
         "costs"
        ]
       ],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Kommentar fra en læser",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Det er en fornuftig idé, hvis kommunen offentliggør resultaterne fra prøveperioden.",
       "alumno": "It's a sensible idea if the council publishes the results of the trial period.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "fornuftig",
         "sensible"
        ],
        [
         "offentliggør",
         "publishes"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Flere åbningstimer hjælper ikke meget, hvis der ikke er personale til at vejlede brugerne.",
       "alumno": "More opening hours don't help much if there are no staff to guide users.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "vejlede",
         "guide"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Til gengæld kan et åbent bibliotek give unge et trygt sted at læse og arbejde om aftenen.",
       "alumno": "On the other hand, an open library can give young people a safe place to read and work in the evening.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "trygt",
         "safe"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Kommunen bør derfor undersøge både efterspørgslen og de samlede omkostninger.",
       "alumno": "So the council should examine both demand and total costs.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "efterspørgslen",
         "demand"
        ],
        [
         "samlede omkostninger",
         "total costs"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
   ]
