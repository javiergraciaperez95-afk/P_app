   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Reading particles",
     "texto": [
      "**jo** usually presents something as known or shared; **da** can reinforce a reaction or remind of something; **vel** usually softens an assumption or asks for confirmation. Intonation and context change the nuance."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Not translating word by word",
     "texto": [
      "Compare the whole sentence and the response it provokes. If a particle doesn't add a concrete fact, it can express attitude, emphasis or shared expectation."
     ],
     "tutora": ""
    }
   ]
  },
