        "texto": "købe",
        "lengua": "estudio"
       }
      ],
      [
       {
        "texto": "**å**",
        "lengua": "estudio"
       },
       {
        "texto": "very open o, like the «aw» in «law»",
        "lengua": "alumno"
       },
       {
        "texto": "blå, på",
        "lengua": "estudio"
       }
