      },
      {
       "texto": "Example",
       "lengua": "alumno"
      }
     ],
     "filas": [
      [
       {
        "texto": "**æ**",
        "lengua": "estudio"
       },
       {
        "texto": "very open e (between «e» in «bed» and «a» in «cat»)",
