    {
     "tipo": "texto",
     "titulo": "Automatisering på kontoret",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Flere virksomheder afprøver nu digitale værktøjer, der kan løse rutineopgaver.",
       "alumno": "More companies are now trying out digital tools that can solve routine tasks.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "afprøver",
         "are trying out"
        ],
        [
         "rutineopgaver",
         "routine tasks"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Det betyder ikke nødvendigvis, at medarbejderne bliver overflødige.",
       "alumno": "That doesn't necessarily mean that employees will become redundant.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "nødvendigvis",
         "necessarily"
        ],
        [
         "medarbejderne",
         "employees"
        ],
        [
         "overflødige",
         "redundant"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Nogle opgaver forsvinder, mens andre kræver mere kontrol og faglig vurdering.",
       "alumno": "Some tasks disappear, while others require more supervision and professional judgement.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "forsvinder",
         "disappear"
        ],
        [
         "kontrol",
         "supervision"
        ],
        [
         "faglig vurdering",
         "professional judgement"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Arbejdsgiverne forventes at tilbyde efteruddannelse, hvis nye systemer ændrer arbejdet.",
       "alumno": "Employers are expected to offer further training if new systems change the work.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "arbejdsgiverne",
         "employers"
        ],
        [
         "tilbyde",
         "offer"
        ],
        [
         "systemer",
         "systems"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Gevinsten afhænger derfor både af teknologien og af, hvordan den indføres.",
       "alumno": "So the benefit depends both on the technology and on how it is introduced.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "gevinsten",
         "the benefit"
        ],
        [
         "afhænger",
         "depends"
        ],
        [
         "indføres",
         "is introduced"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
   ]
