   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Nominalisation in context",
     "texto": [
      "Documents can turn actions into nouns: **undersøge → undersøgelse** (to investigate → investigation), **ansøge → ansøgning** (to apply → application). Nominal forms condense information, but they can hide who carries out the action."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Reading a decision",
     "texto": [
      "**besluttet** indicates something agreed; **foreslået** something proposed. **træder i kraft** means comes into force. Check dates and who it applies to."
     ],
     "tutora": ""
    }
   ]
  },
