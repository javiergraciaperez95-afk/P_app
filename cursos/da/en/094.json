 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Feeling like, having the energy, and needing",
     "texto": [
      "**Gider** = to feel like: **Jeg gider ikke gå ud.** = I don't feel like going out.",
      "**Orker** = to have the energy or to bear: **Jeg orker ikke mere.** = I can't take any more.",
      "**Behøver** = to need; with **ikke** = there's no need: **Du behøver ikke komme.** = You don't need to come."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Nuances of skal, må, bør and kan",
     "texto": [
      "**Skal** = obligation: **Du skal hvile dig.** = You have to rest.",
      "**Må** = permission or probability: **Du må gerne bruge den.** = You may use it. **Han må være træt.** = He must be tired.",
      "**Bør** = advice: **Du bør hvile dig.** = You should rest.",
      "**Kan** = possibility or ability: **Det kan ikke gøres.** = It can't be done."
     ],
     "tutora": ""
    },
