      [
       {
        "texto": "Jeg har det **ikke så godt**.",
        "lengua": "estudio"
       },
       {
        "texto": "Tôi không khỏe.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Jeg skal **kaste op**.",
        "lengua": "estudio"
       },
       {
        "texto": "Tôi sắp nôn.",
        "lengua": "alumno"
       }
