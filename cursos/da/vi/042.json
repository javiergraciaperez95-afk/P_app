      }
     ],
     "filas": [
      [
       {
        "texto": "**og / eller / men**",
        "lengua": "estudio"
       },
       {
        "texto": "và / hoặc / nhưng",
        "lengua": "alumno"
       },
       {
        "texto": "Michael er træt, **men** han vil ikke sove.",
        "lengua": "estudio"
       }
      ],
      [
       {
        "texto": "**for**",
        "lengua": "estudio"
       },
       {
        "texto": "vì, bởi vì",
        "lengua": "alumno"
       },
       {
        "texto": "Mattias er glad, **for** han elsker sin kæreste.",
        "lengua": "estudio"
       }
      ],
      [
       {
        "texto": "**så**",
        "lengua": "estudio"
       },
       {
        "texto": "vậy nên",
        "lengua": "alumno"
       },
       {
        "texto": "Cô ấy học, **så** cô ấy làm nhiều bài tập về nhà.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**fordi**",
        "lengua": "estudio"
       },
       {
        "texto": "bởi vì",
        "lengua": "alumno"
       },
       {
        "texto": "Cô ấy yêu anh ấy, **fordi** anh ấy dễ thương.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**mens**",
        "lengua": "estudio"
       },
