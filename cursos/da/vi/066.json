     "filas": [
      [
       {
        "texto": "**Vi vil gerne se spisekortet.**",
        "lengua": "estudio"
       },
       {
        "texto": "Mình muốn xem thực đơn.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**forret / hovedret / dessert**",
        "lengua": "estudio"
       },
       {
        "texto": "món khai vị / chính / tráng miệng",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Jeg vil gerne bestille **2 gange** suppe.",
        "lengua": "estudio"
       },
       {
        "texto": "Tôi đã muốn hai súp.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Jeg vil **hellere / helst** have …",
        "lengua": "estudio"
       },
       {
        "texto": "Tôi ưa… / Điều tôi muốn nhất là…",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Jeg er **vegetar**.",
        "lengua": "estudio"
       },
       {
        "texto": "Tôi ăn chay.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Jeg **bryder mig ikke om** østers.",
        "lengua": "estudio"
       },
       {
        "texto": "Tôi không ưa hàu lắm.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**Må vi bede om regningen?**",
        "lengua": "estudio"
       },
       {
        "texto": "Bạn mang hóa đơn cho mình được không?",
        "lengua": "alumno"
       }
      ]
