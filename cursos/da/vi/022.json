     "filas": [
      [
       {
        "texto": "**Må jeg tale med …?**",
        "lengua": "estudio"
       },
       {
        "texto": "Tôi trò chuyện với… được không?",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**Det er mig.**",
        "lengua": "estudio"
       },
       {
        "texto": "Là tôi đây.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**Hvem taler jeg med?**",
        "lengua": "estudio"
       },
       {
        "texto": "Tôi đang nói chuyện với ai đấy?",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**Er John hjemme?**",
        "lengua": "estudio"
       },
       {
        "texto": "John đang ở đó không?",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**Nummeret er optaget.**",
        "lengua": "estudio"
       },
       {
        "texto": "Đang bận.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**Kan jeg give ham en besked?**",
        "lengua": "estudio"
       },
       {
        "texto": "Tôi để lại lời nhắn được không?",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**Lige et øjeblik!**",
        "lengua": "estudio"
       },
       {
        "texto": "Chờ chút!",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**Du har fået forkert nummer.**",
        "lengua": "estudio"
       },
       {
        "texto": "Anh/chị đã gọi nhầm số.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**Jeg ringer igen senere.**",
        "lengua": "estudio"
       },
       {
        "texto": "Tôi sẽ gọi lại sau.",
        "lengua": "alumno"
       }
      ]
     ],
