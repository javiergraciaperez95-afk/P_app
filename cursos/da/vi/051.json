     "filas": [
      [
       {
        "texto": "Jeg vil **gerne** have kaffe.",
        "lengua": "estudio"
       },
       {
        "texto": "Tôi muốn cà phê.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Jeg vil **hellere** have te.",
        "lengua": "estudio"
       },
       {
        "texto": "Tôi ưa trà hơn.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Jeg vil **(aller) helst** have en kold øl.",
        "lengua": "estudio"
       },
       {
        "texto": "Điều tôi muốn nhất là một cốc bia lạnh.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Jeg **foretrækker** te.",
        "lengua": "estudio"
       },
       {
        "texto": "Tôi ưa trà hơn.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Jeg **kan bedre lide** kød.",
        "lengua": "estudio"
       },
       {
        "texto": "Tôi ưa thịt hơn.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Jeg **kan (aller) bedst lide** …",
        "lengua": "estudio"
       },
       {
        "texto": "Điều tôi ưa nhất là…",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Det **har jeg ikke noget imod**.",
        "lengua": "estudio"
       },
       {
        "texto": "Tôi không bận tâm.",
        "lengua": "alumno"
       }
      ]
     ],
     "nota": "gerne → hellere → helst, giống như tốt → tốt hơn → tốt nhất.",
