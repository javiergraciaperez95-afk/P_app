       "lengua": "estudio"
      },
      {
       "texto": "Tiếng Tây Ban Nha",
       "lengua": "alumno"
      }
     ],
     "filas": [
      [
       {
        "texto": "**Selve** værelset er flot.",
        "lengua": "estudio"
       },
       {
        "texto": "Chính căn phòng thì tuyệt đẹp.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Nina har **selv** ryddet op.",
        "lengua": "estudio"
       },
       {
        "texto": "Nina đã tự mình dọn dẹp.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**Selv** skufferne er i orden.",
        "lengua": "estudio"
       },
       {
        "texto": "Ngay cả những ngăn kéo cũng đúng thứ tự.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Hun er **både** lille **og** tyk.",
        "lengua": "estudio"
       },
       {
        "texto": "Cô ấy vừa thấp vừa mập.",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "gift → **u**gift · moderne → **u**moderne",
