       {
        "texto": "**Hvor ser du godt ud** i aften!",
        "lengua": "estudio"
       },
       {
        "texto": "Tối nay trông bạn đẹp ghê!",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "Det er **vel nok** et flot slips!",
        "lengua": "estudio"
       },
       {
        "texto": "Cà vạt đẹp ghê!",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**Sikken en flot kjole!**",
        "lengua": "estudio"
       },
       {
        "texto": "Váy đẹp ghê!",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**Sikket vejr!**",
        "lengua": "estudio"
       },
       {
        "texto": "Thời tiết thật đẹp!",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**Sikke smukke sko!**",
        "lengua": "estudio"
       },
       {
        "texto": "Giày đẹp ghê!",
        "lengua": "alumno"
       }
      ],
      [
       {
        "texto": "**Sikke smuk hun er!**",
        "lengua": "estudio"
