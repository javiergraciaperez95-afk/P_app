   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Muốn, có sức và cần",
     "texto": [
      "**Gider** = có hứng, muốn: **Jeg gider ikke gå ud.** = Mình không muốn ra ngoài.",
      "**Orker** = có sức hoặc chịu nổi: **Jeg orker ikke mere.** = Mình không chịu nổi nữa.",
      "**Behøver** = cần; với **ikke** = không cần: **Du behøver ikke komme.** = Bạn không cần đến đâu."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Sắc thái của skal, må, bør và kan",
     "texto": [
      "**Skal** = nghĩa vụ: **Du skal hvile dig.** = Bạn phải nghỉ ngơi.",
      "**Må** = cho phép hoặc khả năng cao: **Du må gerne bruge den.** = Bạn được phép dùng nó. **Han må være træt.** = Chắc anh ấy mệt.",
      "**Bør** = lời khuyên: **Du bør hvile dig.** = Bạn nên nghỉ ngơi.",
      "**Kan** = khả năng: **Det kan ikke gøres.** = Điều đó không thể làm được."
     ],
     "tutora": ""
    },
