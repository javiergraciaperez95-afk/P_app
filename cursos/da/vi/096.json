   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Động từ với «at»",
     "texto": [
      "Nhiều động từ đi kèm **at** + nguyên mẫu: **lover at** (hứa), **begynder at** (bắt đầu), **prøver at** (cố gắng): **Jeg lovede at komme tidligt.** = Mình đã hứa sẽ đến sớm.",
      "**Jeg begynder at blive sulten.** = Mình bắt đầu đói."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Thành ngữ với «at»",
     "texto": [
      "**Det er svært at** = thật khó để: **Det er svært at vente så længe.** = Thật khó để chờ lâu như vậy.",
      "**Uden at** = mà không: **Spis uden at vente.** = Ăn mà không chờ.",
      "**I stedet for at** = thay vì: **I stedet for at vente, gik jeg.** = Thay vì chờ, mình đã đi."
     ],
     "tutora": ""
    },
