    {
     "tipo": "explicacion",
     "titulo": "Cách trả lời",
     "texto": [
      "Tách các sự kiện, ý kiến và suy luận; chú ý ai là người đưa ra từng khẳng định và những từ nào giới hạn mức độ chắc chắn. Một số câu trả lời đòi hỏi kết nối hai phần của bài đọc."
     ],
     "tutora": ""
    }
   ]
  },
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Thư viện cho cả thành phố",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Kommunen overvejer at holde biblioteket åbent to aftener mere om ugen.",
       "alumno": "Thành phố đang cân nhắc mở thư viện thêm hai buổi tối mỗi tuần.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "overvejer",
         "cân nhắc"
        ],
        [
         "åbent",
         "mở cửa"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En brugerundersøgelse viser, at mange studerende mangler et roligt sted efter klokken seks.",
       "alumno": "Một khảo sát người dùng cho thấy nhiều sinh viên thiếu một nơi yên tĩnh sau sáu giờ.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "brugerundersøgelse",
         "thiếu"
        ],
        [
         "mangler",
         "thiếu"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Biblioteket skal dog bruge flere medarbejdere, hvis åbningstiden udvides.",
       "alumno": "Tuy nhiên, thư viện sẽ cần thêm nhân viên nếu giờ mở cửa được kéo dài.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "åbningstiden",
         "giờ mở cửa"
        ],
        [
         "udvides",
         "được kéo dài"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Nogle naboer frygter støj, mens andre mener, at længere åbningstid gør tilbuddet mere tilgængeligt.",
       "alumno": "Một số cư dân lo ngại tiếng ồn, trong khi những người khác cho rằng giờ mở cửa dài hơn khiến dịch vụ dễ tiếp cận hơn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "naboer",
         "cư dân"
        ],
        [
         "støj",
         "tiếng ồn"
        ],
        [
         "tilgængeligt",
         "dễ tiếp cận"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Kommunen foreslår en prøveperiode på tre måneder og vil derefter vurdere brugen og udgifterne.",
       "alumno": "Thành phố đề xuất thời gian thử nghiệm ba tháng và sau đó sẽ đánh giá việc sử dụng cùng các chi phí.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "prøveperiode",
         "thời gian thử nghiệm"
        ],
        [
         "udgifterne",
         "các chi phí"
        ]
       ],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Ý kiến của một độc giả",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Det er en fornuftig idé, hvis kommunen offentliggør resultaterne fra prøveperioden.",
       "alumno": "Đây là một ý tưởng hợp lý nếu thành phố công bố các kết quả của giai đoạn thử nghiệm.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "fornuftig",
         "hợp lý"
        ],
        [
         "offentliggør",
         "công bố"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Flere åbningstimer hjælper ikke meget, hvis der ikke er personale til at vejlede brugerne.",
       "alumno": "Thêm giờ mở cửa không giúp được nhiều nếu không có nhân viên hướng dẫn người dùng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "vejlede",
         "hướng dẫn"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Til gengæld kan et åbent bibliotek give unge et trygt sted at læse og arbejde om aftenen.",
       "alumno": "Mặt khác, một thư viện mở cửa có thể mang đến cho những người trẻ một nơi an toàn để đọc và làm việc vào buổi tối.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "trygt",
         "an toàn"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Kommunen bør derfor undersøge både efterspørgslen og de samlede omkostninger.",
       "alumno": "Vì vậy, thành phố nên nghiên cứu cả nhu cầu lẫn tổng chi phí.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
