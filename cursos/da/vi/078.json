       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Mette spurgte, om hun altid var så træt.",
       "alumno": "Mette hỏi liệu cô ấy có luôn mệt đến thế không.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "om hun altid var så træt",
         "liệu cô ấy luôn mệt đến thế"
