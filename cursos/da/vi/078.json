       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Men hun spurgte, hvornår de skulle mødes igen.",
       "alumno": "Nhưng cô ấy hỏi khi nào họ sẽ gặp lại nhau.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "hvornår de skulle mødes",
         "khi nào họ sẽ gặp lại"
        ]
       ],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Ở một khóa học",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "På et kursus fortalte Sara, at hun var flyttet til Danmark for tre år siden.",
       "alumno": "Ở một khóa học, Sara kể rằng cô ấy đã chuyển đến Đan Mạch ba năm trước.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "fortalte Sara, at",
         "Sara kể rằng"
        ],
        [
         "var flyttet",
         "đã chuyển đến"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Hun sagde, at hun først havde svært ved at følge med i timerne.",
       "alumno": "Cô ấy nói là lúc đầu cô ấy khó theo kịp những tiết học.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "havde svært ved",
         "khó"
        ],
        [
         "følge med i timerne",
         "theo kịp những tiết học"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En studiegruppe havde hjulpet hende.",
       "alumno": "Một nhóm học đã giúp cô ấy.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "havde hjulpet",
         "đã giúp"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Læreren spurgte, om alle kendte de forskellige muligheder i uddannelsessystemet.",
       "alumno": "Giáo viên hỏi liệu mọi người có biết những lựa chọn không giống nhau trong hệ thống giáo dục không.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "spurgte, om",
         "đã hỏi liệu"
        ],
        [
         "forskellige muligheder",
         "những lựa chọn không giống nhau"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Mikkel svarede, at han havde gået på en lille skole, og at hans søster havde valgt en anden vej.",
       "alumno": "Mikkel trả lời là anh ấy đã học ở một trường nhỏ và em gái anh ấy đã chọn một con đường riêng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "svarede, at",
         "trả lời là"
        ],
        [
         "havde valgt",
         "đã chọn"
