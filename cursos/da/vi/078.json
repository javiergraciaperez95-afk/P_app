       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Louise svarede, at hun ikke vidste det.",
       "alumno": "Louise trả lời là cô ấy không biết điều đó.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "at hun ikke vidste",
