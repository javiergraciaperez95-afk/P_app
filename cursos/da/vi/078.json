       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Hun sagde også, at hun havde haft en svær uge.",
       "alumno": "Cô ấy cũng nói là đã có một tuần khó khăn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
