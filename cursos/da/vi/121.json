   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "So sánh nguồn",
     "texto": [
      "Hãy xem ai nói, nói với ai và muốn đạt được điều gì. Một bản tin thường tóm tắt sự kiện và tuyên bố; một bài ý kiến bảo vệ một lập trường."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Đối chiếu lý lẽ",
     "texto": [
      "**på den ene side … på den anden side** trình bày hai phía; **derimod** và **til gengæld** đối chiếu các yếu tố. Có cùng chủ đề không có nghĩa là đồng ý với nhau."
     ],
     "tutora": ""
    }
   ]
  },
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Bản tin: Thêm nhiều khu vực xanh",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Kommunen overvejer at omdanne en parkeringsplads til en offentlig park.",
       "alumno": "Thành phố đang xem xét biến một bãi đỗ xe thành một công viên công cộng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "overvejer",
         "xem xét"
        ],
        [
         "omdanne",
         "biến đổi"
        ],
        [
         "offentlig",
         "công cộng"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Ifølge forslaget skal området give plads til træer, bænke og regnvandsbede.",
       "alumno": "Theo đề xuất, khu vực này sẽ có chỗ cho cây xanh, ghế dài và vườn hấp thụ nước mưa.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "give plads til",
         "có chỗ cho"
        ],
        [
         "regnvandsbede",
         "vườn hấp thụ nước mưa"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Kommunen fremhæver, at flere grønne områder kan dæmpe varmen om sommeren.",
       "alumno": "Thành phố nhấn mạnh rằng nhiều khu vực xanh hơn có thể làm giảm cái nóng vào mùa hè.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "fremhæver",
         "nhấn mạnh"
        ],
        [
         "dæmpe",
         "giảm bớt"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Nogle butikker frygter dog, at færre parkeringspladser vil gøre det sværere for kunder at komme frem.",
       "alumno": "Tuy nhiên, một số cửa hàng lo ngại rằng ít chỗ đỗ xe hơn sẽ khiến khách hàng khó đến nơi.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "frygter",
         "lo ngại"
        ],
        [
         "kunder",
         "khách hàng"
        ],
        [
         "komme frem",
         "đến nơi"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En beslutning ventes efter den offentlige høring i næste måned.",
       "alumno": "Một quyết định được kỳ vọng sau cuộc tham vấn công cộng vào tháng tới.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "ventes",
         "được kỳ vọng"
        ],
        [
         "offentlige høring",
         "tham vấn công cộng"
        ]
       ],
       "parrafo": 0
      }
     ]
    },
    {
     "tipo": "texto",
     "titulo": "Thư độc giả: Nên ưu tiên công viên",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Det er forståeligt, at butikkerne er bekymrede, men kommunen bør prioritere et sundt bymiljø.",
       "alumno": "Thật dễ hiểu khi các cửa hàng lo lắng, nhưng thành phố nên ưu tiên một môi trường đô thị lành mạnh.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "forståeligt",
         "dễ hiểu"
        ],
        [
         "prioritere",
         "ưu tiên"
        ],
        [
         "bymiljø",
         "môi trường đô thị"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "De fleste kunder kommer allerede med bus eller cykel, og området mangler skygge.",
       "alumno": "Hầu hết khách hàng đã đến bằng xe buýt hoặc xe đạp, và khu vực này thiếu bóng râm.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "mangler",
         "thiếu"
        ],
        [
         "skygge",
         "bóng râm"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En park kan desuden gøre gaden mere attraktiv for både beboere og besøgende.",
       "alumno": "Hơn nữa, một công viên có thể làm con phố hấp dẫn hơn cho cả cư dân lẫn khách tham quan.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "attraktiv",
         "hấp dẫn"
        ],
        [
         "både beboere og besøgende",
         "cả cư dân lẫn khách tham quan"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Kommunen bør måle trafikken i en prøveperiode, før den træffer den endelige beslutning.",
       "alumno": "Thành phố nên đo giao thông trong một giai đoạn thử nghiệm trước khi đưa ra quyết định cuối cùng.",
       "literal": "",
       "estructura": "",
