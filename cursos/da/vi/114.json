   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Giao thông miễn phí?",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Flere borgere foreslår billigere offentlig transport for at mindske biltrafikken.",
       "alumno": "Nhiều người dân đề xuất giảm giá giao thông công cộng để làm giảm lưu lượng xe hơi.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "borgere",
         "người dân"
        ],
        [
         "biltrafikken",
         "lưu lượng xe hơi"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "De peger på, at en månedlig billet koster mere end tidligere.",
       "alumno": "Họ chỉ ra rằng vé tháng hiện nay đắt hơn trước đây.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "peger på",
         "chỉ ra"
        ],
        [
         "månedlig billet",
         "vé tháng"
        ],
        [
         "tidligere",
         "trước đây"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En lavere pris kan gøre det lettere for studerende og familier at vælge bussen.",
       "alumno": "Một mức giá thấp hơn có thể giúp sinh viên và các gia đình dễ chọn xe buýt hơn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "lavere",
         "thấp hơn"
        ],
        [
         "lettere",
         "dễ hơn"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Kritikere spørger dog, hvordan kommunen skal betale for ændringen.",
       "alumno": "Tuy nhiên, những người chỉ trích hỏi thành phố sẽ trả tiền cho sự thay đổi này bằng cách nào.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "kritikere",
         "những người chỉ trích"
        ],
        [
         "betale for",
         "trả tiền cho"
        ],
        [
         "ændringen",
         "sự thay đổi"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Tallene tyder på en stigning i passagertallet, men de viser ikke alene, hvad der har forårsaget den.",
       "alumno": "Các con số cho thấy số lượng hành khách có xu hướng tăng, nhưng riêng chúng không cho biết điều gì đã gây ra điều đó.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "passagertallet",
         "số lượng hành khách"
