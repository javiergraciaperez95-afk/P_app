   "etapa": "leer",
   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Một nghiên cứu về thói quen đi lại",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En undersøgelse spørger pendlere, hvorfor de vælger bilen frem for bussen.",
       "alumno": "Một nghiên cứu hỏi những người đi làm hằng ngày vì sao họ chọn xe hơi thay vì xe buýt.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "pendlere",
         "người đi làm hằng ngày"
        ],
        [
         "frem for",
         "thay vì"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Mange nævner, at busserne går sjældent om aftenen.",
       "alumno": "Nhiều người đề cập rằng xe buýt hiếm khi chạy vào buổi tối.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "nævner",
         "đề cập"
        ],
        [
         "sjældent",
         "hiếm khi"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Kommunen har derfor udvidet aftenruterne i et forsøgsområde.",
       "alumno": "Vì vậy thành phố đã mở rộng các tuyến ban đêm ở một khu vực thí điểm.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "aftenruterne",
         "các tuyến ban đêm"
        ],
        [
         "forsøgsområde",
         "khu vực thí điểm"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Flere bruger dem allerede, selvom afgangene stadig er begrænsede.",
       "alumno": "Ngày càng nhiều người đã sử dụng chúng, mặc dù các chuyến xe vẫn còn hạn chế.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "afgangene",
         "các chuyến xe"
        ],
        [
         "begrænsede",
         "hạn chế"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Dette tyder på, at tilbuddet har potentiale, men undersøgelsen viser endnu ikke, om biltrafikken er faldet.",
       "alumno": "Điều này cho thấy dịch vụ có tiềm năng, nhưng nghiên cứu vẫn chưa cho biết lưu lượng xe hơi đã giảm hay chưa.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "tilbuddet",
         "dịch vụ"
        ],
        [
         "potentiale",
         "tiềm năng"
