 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Decir una fecha e invitar",
    "@en": "Say a date and invite"
   },
   "texto": [
    {
     "@es": "Los meses se escriben con minúscula. Una fecha puede escribirse «4. mai» y leerse «den fjerde mai» («el cuatro de mayo»). Bursdag significa cumpleaños.",
     "@en": "The months are written with a tiny. A date can be written «4. mai» and read «den fjerde mai» («on 4 May»). Bursdag means birthday."
    },
    {
     "@es": "En presente, invitere («invitar») pasa a inviterer y no cambia según la persona. Para agradecer, takk for invitasjonen significa «gracias por la invitación».",
     "@en": "In present, Invitere («invite») passes to Inviteer and does not change according to the person. To thank you, takk for invitasjonen means «Thank you for the invitation.»."
    }
   ]
  },
