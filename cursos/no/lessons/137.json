   "texto": [
    {
     "@es": "**Rettssikkerhet** es la protección frente a decisiones arbitrarias. **Uskyldspresumsjon** significa que una persona debe considerarse inocente mientras no se pruebe su culpabilidad.",
     "@en": "**Rettssikkerhet** is protection from arbitrary decisions. **Uskyldspresumsjon** means that a person must be considered innocent until proven guilty."
    },
    {
     "@es": "**Upartisk** significa imparcial; **uavhengig**, independiente.",
     "@en": "**Upartisk** means impartial; **uavhengig**, independent."
    }
