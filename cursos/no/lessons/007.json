   "id": "no007-1",
   "opciones": [
    {
     "texto": "Hvor gammel er du?",
     "explicacion": {
      "@es": "Es la fórmula habitual para preguntar la edad.",
      "@en": "It's the usual formula for asking the age."
     },
     "correcta": true
    },
    {
     "texto": "Hva heter du?",
     "explicacion": {
      "@es": "Pregunta el nombre.",
      "@en": "Ask the name."
     }
    },
    {
     "texto": "Hvordan går det?",
     "explicacion": {
      "@es": "Pregunta qué tal está alguien.",
      "@en": "Ask how someone's doing."
     }
    }
   ]
