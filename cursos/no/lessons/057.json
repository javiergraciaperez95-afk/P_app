   "texto": [
    {
     "@es": "**Hver dag** significa «cada día» y **hver uke**, «cada semana». **Sammen** es «juntos» y **alene**, «solo/a».",
     "@en": "**Hver dag** means «each day» and **hver uke**, «each week». **Sammen** is «together» and **alene**, «alone»."
    },
    {
     "@es": "**Middag** es la comida principal del día; puede ser al mediodía o por la tarde. No siempre equivale exactamente a «cena».",
     "@en": "**Middag** is the main meal of the day; it can be at noon or in the afternoon. It doesn't always exactly equal «dinner»."
    }
   ]
