 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Hablar de lo que comes",
    "@en": "Talk about what you eat"
   },
   "texto": [
    {
     "@es": "Liker significa «gustar»: Jeg liker ost equivale a «me gusta el queso». Para negar, ikke va después del verbo: Jeg liker ikke fisk («no me gusta el pescado»).",
     "@en": "Liker means «gustar»: Jeg liker ost equals «I like cheese.». To deny, ikke goes after the verb: Jeg liker ikke fisk («I don't like fish.»)."
    },
    {
     "@es": "Drikker es «bebo» o «bebe»; como otros verbos en presente, no cambia con jeg y du. Eller significa «o» cuando se elige entre opciones.",
     "@en": "Drikker is «bebo» or «baby»; like other verbs in present, it does not change with jeg and du. Eller means «or» when chosen between options."
    }
   ]
  },
