   "frases": [
    {
     "quien": "Nora",
     "no": "Etter at jeg leverer barna i barnehagen, går jeg på jobb.",
     "es": "Después de dejar a los niños en la guardería, voy al trabajo.",
     "en": "After I leave the kids in the nursery, I go to work.",
     "analisis": [
      [
       "Etter at jeg leverer barna",
       {
        "@es": "después de que dejo a los niños",
        "@en": "after I leave the children"
       }
      ],
      [
       "i barnehagen",
       {
        "@es": "en la guardería",
        "@en": "in day care"
       }
      ],
      [
       "går jeg på jobb",
       {
        "@es": "voy al trabajo",
        "@en": "I'm going to work."
       }
      ]
     ]
    },
    {
     "quien": "Amir",
     "no": "Henter partneren din dem om ettermiddagen?",
     "es": "¿Los recoge tu pareja por la tarde?",
     "en": "Does your partner pick them up in the afternoon?",
     "analisis": [
      [
       "Henter partneren din",
       {
        "@es": "¿los recoge tu pareja?",
        "@en": "Your partner pick them up?"
       }
      ],
      [
       "dem om ettermiddagen",
       {
        "@es": "a ellos por la tarde",
        "@en": "to them in the afternoon"
       }
      ]
     ]
    },
    {
     "quien": "Nora",
     "no": "Ja, men på fredag bytter vi.",
     "es": "Sí, pero el viernes nos turnamos.",
     "en": "Yeah, but on Friday we took turns.",
     "analisis": [
      [
       "på fredag",
       {
        "@es": "el viernes",
        "@en": "on Friday"
       }
      ],
      [
       "bytter vi",
       {
        "@es": "nos turnamos",
        "@en": "We took turns."
       }
      ]
     ]
    },
    {
     "quien": "Amir",
     "no": "Det er fint at begge kan dele på omsorgen.",
     "es": "Está bien que ambos puedan compartir los cuidados.",
     "en": "It's good that you both can share care.",
     "analisis": [
      [
