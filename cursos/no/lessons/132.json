 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Comparar modalidades",
    "@en": "Compare modalities"
   },
   "texto": [
    {
     "@es": "**Mens** puede presentar dos situaciones simultáneas o contrastarlas: **En hjemmeeksamen gir tid, mens en muntlig høring tester spontan forståelse**.",
     "@en": "**Mens** may present two simultaneous situations or contrast them: **En hjemmeeksamen gir tid, mens en muntlig høring tester spontan forståelse**."
    },
    {
     "@es": "Los sustantivos compuestos noruegos suelen escribirse juntos: **mappevurdering**, evaluación mediante una carpeta de trabajos.",
     "@en": "The Norwegian composite nouns are usually written together: **mappevurdering**, evaluation using a work folder."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Criterios claros",
    "@en": "Clear criteria"
   },
   "texto": [
    {
     "@es": "**Vurderingskriterier** son los criterios con los que se evalúa una tarea. Una modalidad puede favorecer la reflexión y otra medir la respuesta espontánea.",
     "@en": "**Vurderingskriterier** are the criteria with which a task is evaluated. One mode can favour reflection and another measure spontaneous response."
    }
   ]
  },
