   "tipo": "explicacion",
   "titulo": {
    "@es": "Cambiar o cancelar",
    "@en": "Change or cancel"
   },
   "texto": [
    {
     "@es": "Para cambiar una cita se indica qué se modifica y se propone una alternativa.",
     "@en": "To change an appointment, it indicates what is modified and proposes an alternative."
    },
    {
     "@es": "**Avlyse** es cancelar; **utsette** es posponer. No significan lo mismo: al posponer, la cita se mantiene para otro momento.",
     "@en": "**Avlyse** is cancelled; **utsette** is postponed. They don't mean the same thing: by postponing, the appointment is kept for another time."
    }
   ]
