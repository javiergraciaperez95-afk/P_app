   },
   "id": "no109-2",
   "opciones": [
    {
     "texto": "El propósito",
     "explicacion": {
      "@es": "«For å» introduce la razón práctica de una acción.",
      "@en": "«For å» introduces the practical reason for an action."
     },
     "correcta": true
    },
    {
     "texto": "Una acción pasada",
     "explicacion": {
      "@es": "El infinitivo con «for å» no marca pasado.",
      "@en": "The infinitive with «for å» does not mark past."
     }
    },
    {
     "texto": {
      "@es": "Una condición",
      "@en": "A condition"
     },
     "explicacion": {
      "@es": "«Hvis» introduce una condición.",
      "@en": "«Hvis» introduces a condition."
     }
    }
   ]
  },
