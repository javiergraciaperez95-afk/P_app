 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Presentar una reclamación",
    "@en": "Present a claim"
   },
   "texto": [
    {
     "@es": "**Begrunnelse** es la explicación de los motivos. **Innsigelse** es una objeción formal. **Vedlegg** es un documento añadido a una carta o solicitud.",
     "@en": "**Begrunnelse** is the explanation of the reasons. **Innsigelse** is a formal objection. **Vedlegg** is a document added to a letter or request."
    },
    {
     "@es": "En un escrito formal, indica a qué decisión te refieres, explica el motivo y adjunta la documentación pertinente.",
     "@en": "In a formal letter, it indicates to which decision you refer, explains the reason and encloses the relevant documentation."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Subordinadas de excepción",
    "@en": "Exceptional subordinates"
   },
   "texto": [
    {
     "@es": "**Med mindre** significa «a menos que» y presenta una excepción: **Saken avsluttes ikke med mindre nye opplysninger kommer fram**.",
     "@en": "**Med mindre** means «unless» and has an exception: **Saken avsluttes ikke med mindre nye opplysninger kommer fram**."
    },
    {
     "@es": "Después de **dersom** («si») y **med mindre**, la subordinada mantiene el orden sujeto + verbo.",
     "@en": "After **dersom** («si») and **med mindre**, the subordinate keeps the order subject + verb."
    }
   ]
  },
