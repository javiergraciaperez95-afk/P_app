   "opciones": [
    {
     "texto": {
      "@es": "Llevo dos años estudiando noruego.",
      "@en": "I've been studying Norwegian for two years."
     },
     "explicacion": {
      "@es": "La situación continúa hasta el presente.",
      "@en": "The situation continues to this day."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Estudié noruego durante dos años y ya terminé.",
      "@en": "I studied Norwegian for two years and I'm done."
     },
     "explicacion": {
      "@es": "La frase no indica que haya terminado.",
      "@en": "The sentence does not indicate that it is over."
     }
    },
    {
     "texto": {
      "@es": "Estudiaré noruego dentro de dos años.",
      "@en": "I'll be studying Norwegian in two years."
     },
     "explicacion": {
      "@es": "No expresa futuro.",
      "@en": "It does not express a future."
     }
    }
   ]
