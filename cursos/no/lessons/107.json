  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Cuándo se usa normalmente el pasado simple?",
    "@en": "When is the simple past usually used?"
   },
   "id": "no107-1",
   "opciones": [
    {
     "texto": {
      "@es": "Con un momento pasado terminado",
      "@en": "With a past moment over"
     },
     "explicacion": {
      "@es": "«I fjor» sitúa la acción en un periodo ya terminado.",
      "@en": "«I fjor» places the action in an already finished period."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Para una experiencia sin fecha concreta",
      "@en": "For an experience without a specific date"
     },
     "explicacion": {
      "@es": "A menudo se usa «har» más participio.",
      "@en": "«har» plus participle is often used."
     }
    },
    {
     "texto": {
      "@es": "Para una acción que sigue hasta hoy",
      "@en": "For an action that follows up to today"
     },
     "explicacion": {
      "@es": "El presente perfecto puede expresar continuidad.",
      "@en": "The perfect present can express continuity."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué es «studiepoeng»?",
    "@en": "What is «studiepoeng»?"
   },
   "id": "no107-2",
   "opciones": [
    {
     "texto": "Créditos académicos",
     "explicacion": {
      "@es": "Indican carga o progreso dentro de los estudios.",
      "@en": "They indicate burden or progress within the studies."
     },
     "correcta": true
    },
    {
     "texto": "Una calificación",
     "explicacion": {
      "@es": "«Karakter» es una nota.",
      "@en": "«Karakter» is a note."
     }
    },
    {
     "texto": {
      "@es": "Una clase magistral",
      "@en": "A master class"
     },
     "explicacion": {
      "@es": "«Forelesning» significa clase magistral.",
      "@en": "«Forelesning» means master class."
     }
    }
   ]
  },
  {
   "tipo": "traduccion",
