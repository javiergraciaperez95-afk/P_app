   "frases": [
    {
     "quien": "Lege",
     "no": "Folkehelse handler ikke bare om personlige valg.",
     "es": "La salud pública no depende solo de las decisiones personales.",
     "en": "Public health does not depend only on personal decisions.",
     "analisis": [
      [
       "Folkehelse handler",
       {
        "@es": "la salud pública trata",
        "@en": "public health"
       }
      ],
      [
       "ikke bare om personlige valg",
       {
        "@es": "no solo de decisiones personales",
        "@en": "not only personal decisions"
       }
      ]
     ]
    },
    {
     "quien": "Rådgiver",
     "no": "Levekår og tilgang til helsetjenester spiller også inn.",
     "es": "Las condiciones de vida y el acceso a los servicios sanitarios también influyen.",
     "en": "Living conditions and access to health services also influence.",
     "analisis": [
      [
       "Levekår",
       {
        "@es": "condiciones de vida",
        "@en": "living conditions"
       }
      ],
      [
       "tilgang til helsetjenester",
       {
        "@es": "acceso a servicios sanitarios",
        "@en": "access to health services"
       }
      ],
      [
       "spiller også inn",
       {
        "@es": "también influyen",
        "@en": "they also influence"
       }
      ]
     ]
    },
    {
     "quien": "Lege",
     "no": "Er ulikhetene større i noen områder?",
     "es": "¿Son mayores las desigualdades en algunas zonas?",
     "en": "Are inequalities in some areas greater?",
     "analisis": [
      [
       "ulikhetene",
       {
        "@es": "las desigualdades",
        "@en": "inequalities"
       }
      ],
      [
       "større i noen områder",
       {
        "@es": "mayores en algunas zonas",
        "@en": "in some areas"
       }
      ]
     ]
    },
    {
     "quien": "Rådgiver",
     "no": "Ja, og ressursfordeling kan være en del av forklaringen.",
     "es": "Sí, y la distribución de recursos puede ser parte de la explicación.",
     "en": "Yes, and the distribution of resources can be part of the explanation.",
     "analisis": [
      [
       "ressursfordeling",
       {
        "@es": "distribución de recursos",
        "@en": "distribution of resources"
       }
      ],
      [
       "en del av forklaringen",
       {
        "@es": "parte de la explicación",
        "@en": "part of the explanation"
       }
      ]
     ]
    },
    {
     "quien": "Lege",
     "no": "Tilgjengelighet på individnivå og strukturnivå må vurderes.",
     "es": "Hay que evaluar la accesibilidad en los niveles individual y estructural.",
     "en": "Accessibility at individual and structural levels needs to be assessed.",
     "analisis": [
      [
       "tilgjengelighet",
       {
        "@es": "accesibilidad",
        "@en": "accessibility"
       }
      ],
      [
       "på individnivå og strukturnivå",
       {
        "@es": "en los niveles individual y estructural",
        "@en": "at individual and structural levels"
       }
      ],
      [
       "må vurderes",
       {
        "@es": "debe evaluarse",
        "@en": "to be evaluated"
       }
      ]
