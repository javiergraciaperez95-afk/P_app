 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Hablar de migración",
    "@en": "Talk about migration"
   },
   "texto": [
    {
     "@es": "**Innvandring** es migración hacia un país; **innvandrer** es una persona que ha inmigrado. **Flyktning** es una persona que ha tenido que huir de su país.",
     "@en": "**Innvandring** is migration to a country; **innvandrer** is a person who has immigrated. **Flyktning** is a person who has had to flee his country."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Participar en la sociedad",
    "@en": "Participating in society"
   },
   "texto": [
    {
     "@es": "**Integrering** es participar en la sociedad manteniendo la dignidad y los derechos. **Inkludering** significa que las personas tengan acceso y se sientan bienvenidas.",
     "@en": "**Integrering** is to participate in society while maintaining dignity and rights. **Inkludering** means that people have access and feel welcome."
    }
   ]
  },
