   },
   "frase": "Selv om noen møter fordommer, kan de likevel delta.",
   "id": "no124-3",
   "opciones": [
    {
     "texto": {
      "@es": "Aunque algunas personas sufren prejuicios, aun así pueden participar.",
      "@en": "Although some people are prejudiced, they can still participate."
     },
     "explicacion": {
      "@es": "«Selv om» y «likevel» expresan concesión y contraste.",
      "@en": "«Selv om» and «likevel» express concession and contrast."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Como no hay prejuicios, nadie necesita participar.",
      "@en": "Since there are no prejudices, no one needs to participate."
     },
     "explicacion": {
      "@es": "La frase afirma lo contrario.",
      "@en": "The sentence states otherwise."
     }
    },
    {
     "texto": {
      "@es": "Algunas personas participan porque son refugiadas.",
      "@en": "Some people are involved because they are refugees."
     },
     "explicacion": {
      "@es": "No establece esa causa.",
      "@en": "It doesn't establish that cause."
