  {
   "tipo": "dialogo",
   "titulo": {
    "@es": "Participar en el barrio",
    "@en": "Participate in the neighborhood"
   },
   "frases": [
    {
     "quien": "Lærer",
     "no": "Hva kan gjøre det lettere for nye innbyggere å føle tilhørighet?",
     "es": "¿Qué puede facilitar que los nuevos residentes sientan que pertenecen?",
     "en": "What can make it easier for new residents to feel they belong?",
     "analisis": [
      [
       "Hva kan gjøre det lettere",
       {
        "@es": "qué puede facilitar",
        "@en": "what it can facilitate"
       }
      ],
      [
       "for nye innbyggere",
       {
        "@es": "para los nuevos residentes",
        "@en": "for new residents"
       }
      ],
      [
       "å føle tilhørighet",
       {
        "@es": "sentir pertenencia",
        "@en": "to feel belonging"
       }
      ]
     ]
    },
    {
     "quien": "Elev",
     "no": "En møteplass der folk kan delta sammen.",
     "es": "Un lugar de encuentro donde la gente pueda participar junta.",
     "en": "A meeting place where people can participate together.",
     "analisis": [
      [
       "En møteplass",
       {
        "@es": "un lugar de encuentro",
        "@en": "a meeting place"
       }
      ],
      [
       "der folk kan delta sammen",
       {
        "@es": "donde la gente puede participar junta",
        "@en": "where people can participate together"
       }
      ]
     ]
    },
    {
     "quien": "Lærer",
     "no": "Ja, språkopplæring og kontakt med naboer kan også hjelpe.",
     "es": "Sí, la enseñanza de idiomas y el contacto con los vecinos también pueden ayudar.",
     "en": "Yes, language teaching and contact with neighbours can also help.",
     "analisis": [
      [
       "språkopplæring",
       {
        "@es": "enseñanza de idiomas",
        "@en": "language education"
       }
      ],
      [
       "kontakt med naboer",
       {
        "@es": "contacto con los vecinos",
        "@en": "contact with the neighbors"
       }
      ],
      [
       "kan også hjelpe",
       {
        "@es": "también pueden ayudar",
        "@en": "can also help"
       }
      ]
     ]
    },
    {
     "quien": "Elev",
     "no": "Selv om noen møter fordommer, kan de likevel delta i samfunnet.",
     "es": "Aunque algunas personas sufren prejuicios, aun así pueden participar en la sociedad.",
     "en": "Although some people are prejudiced, they can still participate in society.",
     "analisis": [
      [
       "Selv om noen møter fordommer",
       {
        "@es": "aunque algunas personas sufren prejuicios",
        "@en": "although some people suffer from prejudice"
       }
      ],
      [
       "kan de likevel delta",
       {
        "@es": "aun así pueden participar",
        "@en": "They can still participate."
       }
      ],
      [
       "i samfunnet",
       {
        "@es": "en la sociedad",
        "@en": "in society"
       }
      ]
     ]
    },
    {
     "quien": "Lærer",
     "no": "Riktig. Alle skal ha likeverd og vern mot diskriminering.",
     "es": "Correcto. Todas las personas deben tener igualdad de dignidad y protección contra la discriminación.",
     "en": "Right. All persons must have equal dignity and protection against discrimination.",
     "analisis": [
      [
       "Alle skal ha",
       {
        "@es": "todas las personas deben tener",
        "@en": "all people must have"
       }
      ],
      [
       "likeverd",
       {
        "@es": "igualdad de dignidad",
        "@en": "equality of dignity"
       }
      ],
      [
       "vern mot diskriminering",
       {
        "@es": "protección contra la discriminación",
        "@en": "protection against discrimination"
       }
      ]
     ]
    }
   ]
