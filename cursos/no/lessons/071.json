  {
   "tipo": "test",
   "pregunta": {
    "@es": "¿Qué estructura expresa un plan decidido?",
    "@en": "What structure does a determined plan express?"
   },
   "id": "no071-2",
   "opciones": [
    {
     "texto": "Skal + infinitivo",
     "explicacion": {
      "@es": "«Jeg skal flytte» significa que tengo el plan de mudarme.",
      "@en": "«Jeg skal flytte» means I have a plan to move."
     },
     "correcta": true
    },
    {
     "texto": "Skal + å + infinitivo",
     "explicacion": {
      "@es": "Después de «skal» no se añade «å».",
      "@en": "«skal» is not added after «å»."
     }
    },
    {
     "texto": "Infinitivo + skal",
     "explicacion": {
      "@es": "El verbo conjugado va antes del infinitivo.",
      "@en": "The conjugated verb goes before the infinitive."
     }
    }
   ]
