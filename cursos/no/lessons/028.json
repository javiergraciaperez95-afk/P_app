   "titulo": {
    "@es": "Hablar de planes de viaje",
    "@en": "Talk about travel plans"
   },
   "texto": [
    {
     "@es": "Skal + infinitivo expresa un plan: Jeg skal reise («voy a viajar»). Después de skal, el verbo va en infinitivo sin å.",
     "@en": "Skal + infinitive expresses a plan: Jeg skal reise («I'll travel.»). After skal, the verb goes in infinitive without å."
    },
    {
     "@es": "Fly significa «avión» y flyplass, «aeropuerto». Pass es «pasaporte», no «paso»: se parece a la palabra española, pero el significado es distinto.",
     "@en": "Fly means «aircraft» and flyplass, «airport». Pass is «passport», not «step»: it looks like the Spanish word, but the meaning is different."
    }
   ]
  },
