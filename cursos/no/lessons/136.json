   "frase": "Domstolen vurderer bevisene før den avsier dom.",
   "id": "no136-2",
   "opciones": [
    {
     "texto": {
      "@es": "El tribunal valora las pruebas antes de dictar sentencia.",
      "@en": "The court values the evidence before giving a judgement."
     },
     "explicacion": {
      "@es": "«Avsi dom» significa dictar sentencia.",
      "@en": "«Avsi dom» means sentencing."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "El acusado apela las pruebas antes del juicio.",
      "@en": "The defendant appeals to the evidence before the trial."
     },
     "explicacion": {
      "@es": "La frase no dice que la persona acusada apele.",
      "@en": "The sentence does not say that the accused person stinks."
     }
    },
    {
     "texto": {
      "@es": "El juez declara antes de presentar las pruebas.",
      "@en": "The judge declares before presenting the evidence."
     },
     "explicacion": {
      "@es": "La frase presenta el orden al revés.",
      "@en": "The phrase presents the order backwards."
     }
    }
   ]
