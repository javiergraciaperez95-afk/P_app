  {
   "tipo": "dialogo",
   "titulo": {
    "@es": "Una visita con la arrendadora",
    "@en": "A visit with the landlord"
   },
   "frases": [
    {
     "quien": "Mina",
     "no": "Takk for visningen. Kan jeg spørre om noen ting?",
     "es": "Gracias por la visita. ¿Puedo preguntar algunas cosas?",
     "en": "Thanks for the visit. Can I ask you a few things?",
     "analisis": [
      [
       "Takk for visningen",
       {
        "@es": "gracias por la visita",
        "@en": "Thank you for the visit."
       }
      ],
      [
       "Kan jeg spørre",
       {
        "@es": "puedo preguntar",
        "@en": "I can ask."
       }
      ],
      [
       "om noen ting",
       {
        "@es": "por algunas cosas",
        "@en": "for some things"
       }
      ]
     ]
    },
    {
     "quien": "Utleier",
     "no": "Selvfølgelig. Hva vil du vite?",
     "es": "Por supuesto. ¿Qué quieres saber?",
     "en": "Of course. What do you want to know?",
     "analisis": [
      [
       "Selvfølgelig",
       {
        "@es": "por supuesto",
        "@en": "Of course."
       }
      ],
      [
       "Hva vil du vite",
       {
        "@es": "qué quieres saber",
        "@en": "What do you want to know?"
       }
      ]
     ]
    },
    {
     "quien": "Mina",
     "no": "Ligger vaskerommet i samme etasje?",
     "es": "¿Está el cuarto de lavandería en la misma planta?",
     "en": "Is the laundry room on the same floor?",
     "analisis": [
      [
       "Ligger vaskerommet",
       {
        "@es": "está el cuarto de lavandería",
        "@en": "There's the laundry room."
       }
      ],
      [
       "i samme etasje",
       {
        "@es": "en la misma planta",
        "@en": "on the same floor"
       }
      ]
     ]
    },
    {
     "quien": "Utleier",
     "no": "Ja, og det finnes en heis. Balkongen er også ganske stor.",
     "es": "Sí, y hay un ascensor. El balcón también es bastante grande.",
     "en": "Yeah, and there's an elevator. The balcony is also quite large.",
     "analisis": [
      [
       "det finnes en heis",
       {
        "@es": "hay un ascensor",
        "@en": "There's an elevator."
       }
      ],
      [
       "Balkongen er også ganske stor",
       {
        "@es": "el balcón también es bastante grande",
        "@en": "the balcony is also quite large"
       }
      ]
     ]
    },
    {
     "quien": "Mina",
     "no": "Jeg merker litt støy fra trafikken. Er det alltid så mye støy?",
     "es": "Noto algo de ruido del tráfico. ¿Siempre hay tanto ruido?",
     "en": "I can feel some traffic noise. Is there always that much noise?",
     "analisis": [
      [
       "Jeg merker litt støy",
       {
        "@es": "noto algo de ruido",
        "@en": "I can feel some noise."
       }
      ],
      [
       "fra trafikken",
       {
        "@es": "del tráfico",
        "@en": "traffic"
       }
      ],
      [
       "alltid så mye støy",
       {
        "@es": "siempre tanto ruido",
        "@en": "always so much noise"
       }
      ]
     ]
    },
    {
     "quien": "Utleier",
     "no": "Det er roligere om kvelden, men du kan undersøke det selv.",
     "es": "Está más tranquilo por la tarde, pero puedes comprobarlo tú misma.",
     "en": "It's quieter in the afternoon, but you can check it out yourself.",
     "analisis": [
      [
       "Det er roligere om kvelden",
       {
        "@es": "está más tranquilo por la tarde",
        "@en": "is quieter in the afternoon"
       }
      ],
      [
       "du kan undersøke det selv",
       {
        "@es": "puedes comprobarlo tú misma",
        "@en": "You can check it out yourself."
       }
      ]
     ]
    },
    {
     "quien": "Mina",
     "no": "Jeg vil også sjekke om det er fuktig i kjelleren.",
     "es": "También quiero comprobar si hay humedad en el sótano.",
     "en": "I also want to check for moisture in the basement.",
     "analisis": [
      [
       "Jeg vil også sjekke",
       {
        "@es": "también quiero comprobar",
        "@en": "I also want to check."
       }
      ],
      [
       "om det er fuktig",
       {
        "@es": "si está húmedo",
        "@en": "if it's wet"
       }
      ],
      [
       "i kjelleren",
       {
        "@es": "en el sótano",
        "@en": "in the basement"
       }
      ]
     ]
    },
    {
     "quien": "Utleier",
     "no": "Det er lurt. Naboene pleier å være stille.",
     "es": "Es buena idea. Los vecinos suelen ser tranquilos.",
     "en": "That's a good idea. Neighbors are usually quiet.",
     "analisis": [
