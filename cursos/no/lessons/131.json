 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Citar y reformular",
    "@en": "Quotation and reformulation"
   },
   "texto": [
    {
     "@es": "**Et sitat** reproduce palabras exactas; **en parafrase** expresa la idea con una formulación propia. En ambos casos se indica la fuente.",
     "@en": "**Et sitat** reproduces exact words; **en parafrase** expresses the idea with its own formulation. In both cases the source is indicated."
    },
    {
     "@es": "**Etterprøvbar** significa que otras personas pueden comprobar la información.",
     "@en": "**Etterprøvbar** means that other people can check the information."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Evitar el plagio",
    "@en": "Avoid plagiarism"
   },
   "texto": [
    {
     "@es": "Una **kildehenvisning** señala de dónde procede una idea. Presentar palabras o ideas ajenas como propias puede considerarse **plagiat**.",
     "@en": "A **kildehenvisning** points to where an idea comes from. To present other words or ideas as their own can be considered **plagiat**."
    }
   ]
  },
