   "titulo": {
    "@es": "Compartir una foto",
    "@en": "Share a photo"
   },
   "frases": [
    {
     "quien": "Nora",
     "no": "Kan jeg dele bildet fra arrangementet?",
     "es": "¿Puedo compartir la foto del evento?",
     "en": "Can I share the photo of the event?",
     "analisis": [
      [
       "Kan jeg dele",
       {
        "@es": "puedo compartir",
        "@en": "I can share"
       }
      ],
      [
       "bildet fra arrangementet",
       {
        "@es": "la foto del evento",
        "@en": "the photo of the event"
       }
      ]
     ]
    },
    {
     "quien": "Amir",
     "no": "Spør de andre først. Bildet viser personopplysninger.",
     "es": "Pregunta primero a los demás. La foto muestra datos personales.",
     "en": "Ask the others first. The photo shows personal data.",
     "analisis": [
      [
       "Spør de andre først",
       {
        "@es": "pregunta primero a los demás",
        "@en": "first question to others"
       }
      ],
      [
       "bildet viser",
       {
        "@es": "la foto muestra",
        "@en": "the photo shows"
       }
      ],
      [
       "personopplysninger",
       {
        "@es": "datos personales",
        "@en": "personal data"
       }
      ]
     ]
    },
    {
     "quien": "Nora",
     "no": "Jeg kan få samtykke fra alle.",
     "es": "Puedo pedir permiso a todos.",
     "en": "I can ask everyone for permission.",
     "analisis": [
      [
       "Jeg kan få samtykke",
       {
        "@es": "puedo conseguir consentimiento",
        "@en": "I can get consent."
       }
      ],
      [
       "fra alle",
       {
        "@es": "de todos",
        "@en": "of all"
       }
      ]
     ]
    },
    {
     "quien": "Amir",
     "no": "Husk opphavsretten også. Hvem tok bildet?",
     "es": "Recuerda también los derechos de autor. ¿Quién hizo la foto?",
     "en": "It also recalls copyright. Who took the picture?",
     "analisis": [
      [
       "Husk opphavsretten",
       {
        "@es": "recuerda los derechos de autor",
        "@en": "recalls copyright"
       }
      ],
      [
       "Hvem tok bildet",
       {
        "@es": "quién hizo la foto",
        "@en": "who took the picture"
       }
      ]
     ]
    },
    {
     "quien": "Nora",
     "no": "Fotografen ga meg tillatelse til å dele det, hvis jeg krediterer henne.",
     "es": "El fotógrafo me dio permiso para compartirla si le doy reconocimiento.",
     "en": "The photographer gave me permission to share it if I give it recognition.",
     "analisis": [
      [
       "Fotografen ga meg tillatelse",
       {
        "@es": "el fotógrafo me dio permiso",
        "@en": "The photographer gave me permission."
       }
      ],
      [
       "til å dele det",
       {
        "@es": "para compartirla",
        "@en": "to share it"
       }
      ],
      [
       "hvis jeg krediterer henne",
       {
        "@es": "si le doy reconocimiento",
        "@en": "If I give him recognition"
       }
      ]
     ]
    },
    {
