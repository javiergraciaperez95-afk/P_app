 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Proteger los datos personales",
    "@en": "Protect personal data"
   },
   "texto": [
    {
     "@es": "**Personvern** es la protección de la vida privada. **Personopplysning** es un dato que puede identificar a una persona. **Samtykke** es permiso dado de forma voluntaria.",
     "@en": "**Personvern** is the protection of private life. **Personopplysning** is a data that can identify a person. **Samtykke** is a permit given on a voluntary basis."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Usar contenido ajeno",
    "@en": "Use foreign content"
   },
   "texto": [
    {
     "@es": "**Opphavsrett** protege obras originales. Al compartir una foto o un texto, respeta el permiso y menciona quién lo creó cuando corresponda.",
     "@en": "**Opphavsrett** protects original works. By sharing a photo or text, it respects the permission and mentions who created it where appropriate."
    }
   ]
  },
  {
