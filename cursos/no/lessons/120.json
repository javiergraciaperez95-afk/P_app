   "titulo": {
    "@es": "La sociedad del bienestar",
    "@en": "The welfare society"
   },
   "texto": [
    {
     "@es": "**Velferdsstat** es un estado que ofrece servicios y ayudas sociales. Algunas prestaciones dependen de la situación y los ingresos de cada persona.",
     "@en": "**Velferdsstat** is a state that offers services and social assistance. Some benefits depend on the situation and income of each person."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Solicitar una ayuda",
    "@en": "Request help"
   },
   "texto": [
    {
     "@es": "**Bostøtte** es una ayuda para gastos de vivienda. **Behovsprøvd** significa que la ayuda depende de una evaluación de las necesidades y los ingresos.",
     "@en": "**Bostøtte** is an aid for housing costs. **Behovsprøvd** means that the aid depends on an assessment of needs and income."
    }
   ]
  },
