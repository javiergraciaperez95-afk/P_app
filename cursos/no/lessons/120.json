     "explicacion": {
      "@es": "No todas las personas reciben la ayuda automáticamente.",
      "@en": "Not all people get help automatically."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Que se concede a todas las personas",
      "@en": "That is granted to all people"
     },
     "explicacion": {
      "@es": "La palabra indica que hay una evaluación.",
      "@en": "The word indicates that there is an evaluation."
     }
    },
    {
     "texto": {
      "@es": "Que solo se puede solicitar en internet",
      "@en": "Which can only be ordered on the Internet"
     },
     "explicacion": {
      "@es": "No describe el canal de solicitud.",
      "@en": "He doesn't describe the application channel."
     }
    }
