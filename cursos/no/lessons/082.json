   "id": "no082-1",
   "opciones": [
    {
     "texto": "Un consejo",
     "explicacion": {
      "@es": "«Du bør følge rådet» significa «deberías seguir el consejo».",
      "@en": "«Du bør følge rådet» means «You should follow the advice.»."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Una obligación estricta",
      "@en": "A strict obligation"
     },
     "explicacion": {
      "@es": "«Må» expresa una obligación más clara.",
      "@en": "«Må» expresses a clearer obligation."
     }
    },
    {
     "texto": "Una acción pasada",
     "explicacion": {
      "@es": "«Bør» no es una forma de pasado.",
      "@en": "«Bør» is not a form of past."
     }
    }
   ]
  },
