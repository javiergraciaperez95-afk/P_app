    "@en": "What does «vedlegg» mean?"
   },
   "id": "no089-1",
   "opciones": [
    {
     "texto": {
      "@es": "Archivo adjunto",
      "@en": "Enclosure"
     },
     "explicacion": {
      "@es": "Es un archivo que se añade a un correo o mensaje.",
      "@en": "It is a file that is added to an email or message."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Asunto",
      "@en": "Subject"
     },
     "explicacion": {
      "@es": "«Emne» significa asunto.",
      "@en": "«Emne» means business."
     }
    },
    {
     "texto": {
      "@es": "Destinatario",
      "@en": "Addressee"
     },
     "explicacion": {
      "@es": "«Mottaker» significa destinatario.",
      "@en": "«Mottaker» means recipient."
     }
    }
   ]
  },
  {
   "tipo": "test",
   "pregunta": {
