      "@en": "«Legge ved skjemaet» is attached the form."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Que borre el correo.",
      "@en": "Let him erase the mail."
     },
     "explicacion": {
      "@es": "No le pide que borre nada.",
      "@en": "He doesn't ask you to erase anything."
     }
    },
    {
     "texto": {
      "@es": "Que cambie la fecha de la cita.",
      "@en": "Let him change the date of the appointment."
     },
     "explicacion": {
      "@es": "Solo dice que el correo trata de la cita.",
      "@en": "He just says the mail is about the date."
