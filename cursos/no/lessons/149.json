      "@en": "«Håndtere» is managing."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "El informe elimina la necesidad de revisar un caso.",
      "@en": "The report eliminates the need to review a case."
     },
     "explicacion": {
      "@es": "No es lo que dice.",
      "@en": "It's not what he says."
     }
    },
    {
     "texto": {
      "@es": "La evaluación de riesgos elige quién recibe un salario.",
      "@en": "The risk assessment chooses who receives a salary."
     },
     "explicacion": {
      "@es": "No se menciona el salario.",
      "@en": "The salary is not mentioned."
     }
    }
   ]
