   "texto": [
    {
     "@es": "**Å varsle** er å melde fra om kritikkverdige forhold. En **varslingsrutine** forklarer hvordan meldingen skal håndteres.",
     "@en": "**Å varsle** er å melde fra om kritikkverdige forhold. In **varslingsrutine** forklarer hvordan meldingen skal håndteres."
    },
    {
     "@es": "En **avviksrapport** registrerer et avvik slik at arbeidsplassen kan undersøke årsaken og forebygge gjentakelse.",
     "@en": "In **avviksrapport** registrerer et avvik slik at arbeidsplassen kan undersøke årsaken og forebygge gjentakelse."
    }
   ]
  },
