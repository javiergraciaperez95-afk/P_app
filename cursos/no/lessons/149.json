      "@es": "Sirve para examinar qué ocurrió.",
      "@en": "It serves to examine what happened."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Una decisión de vacaciones",
      "@en": "A holiday decision"
     },
     "explicacion": {
      "@es": "No es un informe de incidencias.",
      "@en": "It's not an incident report."
     }
    },
    {
     "texto": {
      "@es": "El horario de una reunión sindical",
      "@en": "The schedule of a trade union meeting"
     },
     "explicacion": {
      "@es": "No es su función.",
      "@en": "It's not his function."
     }
    }
   ]
