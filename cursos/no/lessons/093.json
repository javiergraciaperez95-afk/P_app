   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Preguntar la distancia",
    "@en": "Ask the distance"
   },
   "texto": [
    {
     "@es": "**Er det langt herfra?** significa «¿Está lejos de aquí?». **Til fots** es «a pie» y **omtrent** significa «aproximadamente».",
     "@en": "**Er det langt herfra?** means «Is it far from here?». **Til fots** is «on foot» and **omtrent** means «aproximadamente»."
    }
   ]
