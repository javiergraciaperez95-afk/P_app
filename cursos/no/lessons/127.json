   "id": "no127-1",
   "opciones": [
    {
     "texto": {
      "@es": "Una posibilidad o interpretación",
      "@en": "A possibility or interpretation"
     },
     "explicacion": {
      "@es": "La expresión evita presentar la conclusión como segura.",
      "@en": "The expression avoids presenting the conclusion as safe."
     },
     "correcta": true
    },
    {
     "texto": {
      "@es": "Una causa demostrada",
      "@en": "A proven cause"
     },
     "explicacion": {
      "@es": "«Kan tyde på» no confirma una causa.",
      "@en": "«Kan tyde på» does not confirm a cause."
     }
    },
    {
     "texto": {
      "@es": "Una instrucción médica",
      "@en": "A medical instruction"
     },
     "explicacion": {
