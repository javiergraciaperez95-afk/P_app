   "tipo": "explicacion",
   "titulo": {
    "@es": "Matizar una afirmación",
    "@en": "Matizing an affirmation"
   },
   "texto": [
    {
     "@es": "**Det kan tyde på at ...** significa «eso puede indicar que...». La expresión presenta una interpretación posible, no una certeza.",
     "@en": "**Det kan tyde på at ...** means «that may indicate that...». The expression presents a possible interpretation, not a certainty."
    },
    {
     "@es": "**Å skyldes** señala una causa; **å lindre** es aliviar y **å forverre** es empeorar.",
     "@en": "**Å skyldes** points to a cause; **å lindre** is to relieve and **å forverre** is to worsen."
    }
   ]
  },
