 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Nombrar a la pareja",
    "@en": "Appoint the couple"
   },
   "texto": [
    {
     "@es": "**Samboer** es una pareja que convive sin estar necesariamente casada; **ektefelle** es cónyuge. **Likestilling** significa igualdad de derechos y oportunidades.",
     "@en": "**Samboer** is a couple who live without necessarily being married; **ektefelle** is a spouse. **Likestilling** means equal rights and opportunities."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Conectores en pareja",
    "@en": "Coupled connectors"
   },
   "texto": [
    {
     "@es": "**Både ... og** significa «tanto ... como»; **verken ... eller**, «ni ... ni». Con **verken ... eller**, la negación está dentro de la expresión y no se añade otra negación.",
     "@en": "**Både ... og** means «as... as well as»; **verken ... eller**, «ni ... ni». With **verken ... eller**, denial is within the expression and no other denial is added."
    }
   ]
  },
