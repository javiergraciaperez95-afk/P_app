    "@es": "Una conversación sobre el reparto",
    "@en": "A conversation about the cast"
   },
   "frases": [
    {
     "quien": "Lea",
     "no": "Hvordan fordeler dere husarbeidet?",
     "es": "¿Cómo reparten las tareas domésticas?",
     "en": "How do they share domestic tasks?",
     "analisis": [
      [
       "Hvordan fordeler dere",
       {
        "@es": "cómo reparten",
        "@en": "how they share"
       }
      ],
      [
       "husarbeidet",
       {
        "@es": "las tareas domésticas",
        "@en": "domestic tasks"
       }
      ]
     ]
    },
    {
     "quien": "Omar",
     "no": "Vi prøver å dele det rettferdig.",
     "es": "Intentamos repartirlo de forma equitativa.",
     "en": "We're trying to share it in an equitable manner.",
     "analisis": [
      [
       "Vi prøver å dele",
       {
        "@es": "intentamos repartir",
        "@en": "We're trying to split."
       }
      ],
      [
       "det rettferdig",
       {
        "@es": "de forma equitativa",
        "@en": "in an equitable manner"
       }
      ]
     ]
    },
    {
     "quien": "Lea",
     "no": "Jobber dere begge heltid?",
     "es": "¿Trabajáis ambos a jornada completa?",
     "en": "You both work full time?",
     "analisis": [
      [
       "Jobber dere begge",
       {
        "@es": "trabajáis ambos",
        "@en": "You both work."
       }
      ],
      [
       "heltid",
       {
        "@es": "a jornada completa",
        "@en": "full-time"
       }
      ]
     ]
    },
    {
     "quien": "Omar",
     "no": "Nei, partneren min jobber deltid og har fleksitid.",
     "es": "No, mi pareja trabaja a jornada parcial y tiene horario flexible.",
     "en": "No, my partner works part-time and has flexible hours.",
     "analisis": [
      [
       "partneren min jobber deltid",
       {
        "@es": "mi pareja trabaja a jornada parcial",
        "@en": "my partner works part-time"
       }
      ],
      [
       "har fleksitid",
       {
        "@es": "tiene horario flexible",
        "@en": "has flexible schedule"
       }
      ]
     ]
    },
    {
     "quien": "Lea",
     "no": "Da kan dere både hente barna og lage middag.",
     "es": "Entonces podéis tanto recoger a los niños como preparar la cena.",
     "en": "Then you can both pick up the kids and make dinner.",
     "analisis": [
      [
       "både hente barna og lage middag",
       {
        "@es": "tanto recoger a los niños como preparar la cena",
        "@en": "both pick up the children and prepare dinner"
       }
      ]
     ]
    },
    {
     "quien": "Omar",
     "no": "Ja. Vi vil verken at en person gjør alt, eller at oppgavene fordeles ulikt.",
     "es": "Sí. No queremos ni que una persona lo haga todo ni que las tareas se repartan de forma desigual.",
     "en": "Yeah. We do not want a person to do everything, nor do we want tasks to be unevenly shared.",
     "analisis": [
      [
       "verken at en person gjør alt",
       {
        "@es": "ni que una persona lo haga todo",
        "@en": "or that a person does everything"
       }
      ],
      [
       "oppgavene fordeles ulikt",
       {
        "@es": "las tareas se repartan de forma desigual",
        "@en": "tasks are unevenly distributed"
       }
      ]
     ]
    }
