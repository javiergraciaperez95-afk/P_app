   "pregunta": {
    "@es": "¿Por qué puede sonar distinto el habla rápida?",
    "@en": "Why can fast speech sound different?"
   },
   "id": "no033-3",
   "opciones": [
    {
     "texto": {
      "@es": "Algunas sílabas átonas se reducen y las palabras se enlazan.",
      "@en": "Some atone syllables are reduced and words are linked."
     },
     "explicacion": {
      "@es": "Es un proceso habitual del habla conectada.",
      "@en": "It's a regular process of connected speech."
     },
     "correcta": true
    },
    {
     "texto": "Porque desaparecen todas las vocales tónicas.",
     "explicacion": "No."
    },
    {
     "texto": {
      "@es": "Porque cada palabra cambia de significado.",
      "@en": "Because every word changes meaning."
