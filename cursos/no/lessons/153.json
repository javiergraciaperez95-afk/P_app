 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": "Normering",
   "texto": [
    {
     "@es": "**Normering** fastsetter hvordan en skriftlig språkform kan skrives. En **rettskrivingsendring** kan påvirke hvilke former som regnes som tillatte.",
     "@en": "**Normering** fastsetter hvordan in skriftlig språkform kan skrives. In **rettskrivingsendring** kan påvirke hvilke former som regnes som tillatte."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Språk og historie",
    "@en": "Språk og history"
   },
   "texto": [
    {
     "@es": "Språknormer er resultat av historiske valg og språkpolitikk. De endres over tid, men språkbrukerne følger ikke alltid endringene samtidig.",
     "@en": "Språknormer resultat av historiske valg og språkpolitikk. De endres over tid, men språkbrukerne følger ikke altid endringene samtidig."
    }
   ]
  },
