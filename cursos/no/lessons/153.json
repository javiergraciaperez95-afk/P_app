  {
   "tipo": "texto",
   "titulo": "To syn på en språkendring",
   "frases": [
    {
     "no": "Et normeringsvedtak kan åpne for flere godkjente former.",
     "es": "Una decisión normativa puede permitir varias formas aceptadas.",
     "en": "A regulatory decision may allow for several accepted forms.",
     "analisis": [
      [
       "normeringsvedtak",
       {
        "@es": "decisión normativa",
        "@en": "policy decision"
       }
      ],
      [
       "godkjente former",
       {
        "@es": "formas aceptadas",
        "@en": "accepted forms"
       }
      ]
     ]
    },
    {
     "no": "Noen språkbrukere foretrekker en bokmålsnær form.",
     "es": "Algunos usuarios de la lengua prefieren una forma cercana al bokmål.",
     "en": "Some language users prefer a form close to the bokmål.",
     "analisis": [
      [
       "språkbrukere",
       {
        "@es": "usuarios de la lengua",
        "@en": "language users"
       }
      ],
      [
       "bokmålsnær form",
       {
        "@es": "forma cercana al bokmål",
        "@en": "shape close to the bokmål"
       }
      ]
     ]
    },
    {
     "no": "Andre mener at talemålsendringer bør gjenspeiles i skrift.",
     "es": "Otros consideran que los cambios en el habla deberían reflejarse por escrito.",
     "en": "Others believe that changes in speech should be reflected in writing.",
     "analisis": [
      [
       "talemålsendringer",
       {
        "@es": "cambios en el habla",
        "@en": "changes in speech"
       }
      ],
      [
       "gjenspeiles i skrift",
       {
        "@es": "reflejarse por escrito",
        "@en": "be reflected in writing"
       }
      ]
     ]
    },
    {
     "no": "Språkdebatten handler også om hvem som får påvirke normen.",
     "es": "El debate lingüístico también trata de quién puede influir en la norma.",
     "en": "The language debate also deals with who can influence the rule.",
     "analisis": [
      [
       "språkdebatten",
       {
        "@es": "el debate lingüístico",
        "@en": "the language debate"
       }
      ],
      [
       "påvirke normen",
       {
        "@es": "influir en la norma",
        "@en": "influence the rule"
       }
      ]
     ]
    },
    {
     "no": "Samnorsk var et historisk prosjekt for å føre bokmål og nynorsk nærmere hverandre.",
     "es": "El noruego unificado fue un proyecto histórico para acercar el bokmål y el nynorsk.",
     "en": "The unified Norwegian was a historic project to bring the bokmål and nynorsk closer together.",
     "analisis": [
      [
       "historisk prosjekt",
       {
        "@es": "proyecto histórico",
        "@en": "historical project"
       }
      ],
      [
       "føre bokmål og nynorsk nærmere hverandre",
       {
        "@es": "acercar el bokmål y el nynorsk entre sí",
        "@en": "bring the bokmål and the nynorsk closer together"
       }
      ]
     ]
    },
    {
     "no": "I dag står målfrihet og språklig mangfold sentralt i diskusjonen.",
     "es": "Hoy, la libertad de elegir forma escrita y la diversidad lingüística ocupan un lugar central en el debate.",
     "en": "Today, the freedom to choose a written form and linguistic diversity are at the heart of the debate.",
     "analisis": [
      [
       "målfrihet",
       {
        "@es": "libertad de elegir forma escrita",
        "@en": "freedom to choose a written form"
       }
      ],
      [
       "språklig mangfold",
       {
        "@es": "diversidad lingüística",
        "@en": "linguistic diversity"
       }
      ]
     ]
    },
    {
     "no": "En rettskrivingsnorm må kunne forstås av språkbrukerne.",
     "es": "Los usuarios de la lengua deben poder entender una norma ortográfica.",
     "en": "Language users should be able to understand an orthographic standard.",
     "analisis": [
      [
       "rettskrivingsnorm",
       {
        "@es": "norma ortográfica",
        "@en": "orthographic standard"
       }
      ],
      [
       "kunne forstås",
       {
        "@es": "poder entenderse",
        "@en": "can be understood"
       }
      ]
     ]
    }
   ]
