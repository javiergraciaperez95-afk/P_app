 "bloques": [
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Comparar medidas",
    "@en": "Compare Measures"
   },
   "texto": [
    {
     "@es": "**Skattelette** significa reducción de impuestos; **omfordeling** es una distribución distinta de recursos.",
     "@en": "**Skattelette** means tax reduction; **omfordeling** is a different distribution of resources."
    },
    {
     "@es": "Una evaluación puede comparar quién obtiene beneficios, cuáles son los costes y qué efectos se esperan a corto o largo plazo.",
     "@en": "An assessment can compare who gets benefits, what the costs are and what effects are expected in the short to long term."
    }
   ]
  },
  {
   "tipo": "explicacion",
   "titulo": {
    "@es": "Presentar una reserva",
    "@en": "Present a reservation"
   },
   "texto": [
    {
     "@es": "**Avveining** es una valoración entre ventajas y costes. **Gjennomførbar** significa que una propuesta puede realizarse en la práctica.",
     "@en": "**Avveining** is a value between advantages and costs. **Gjennomførbar** means that a proposal can be made in practice."
    }
   ]
  },
