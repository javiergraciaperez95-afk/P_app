   "frases": [
    {
     "quien": "Lærer",
     "no": "I skjønnlitteratur kan fortellerstemmen påvirke hvordan vi oppfatter hovedpersonen.",
     "es": "En la literatura de ficción, la voz narrativa puede influir en cómo percibimos al protagonista.",
     "en": "In fiction literature, the narrative voice can influence how we perceive the protagonist.",
     "analisis": [
      [
       "fortellerstemmen",
       {
        "@es": "la voz narrativa",
        "@en": "the narrative voice"
       }
      ],
      [
       "oppfatter hovedpersonen",
       {
        "@es": "percibimos al protagonista",
        "@en": "We perceive the protagonist"
       }
      ]
     ]
    },
    {
     "quien": "Elev",
     "no": "Er synsvinkelen alltid den samme?",
     "es": "¿El punto de vista es siempre el mismo?",
     "en": "Is the point of view always the same?",
     "analisis": [
      [
       "synsvinkelen",
       {
        "@es": "el punto de vista",
        "@en": "the point of view"
       }
      ],
      [
       "alltid den samme",
       {
        "@es": "siempre el mismo",
        "@en": "always the same"
       }
      ]
     ]
    },
    {
     "quien": "Lærer",
     "no": "Nei, den kan skifte, og handlingen blir sett fra en annen side.",
     "es": "No, puede cambiar y la trama se ve desde otra perspectiva.",
     "en": "No, it can change and the plot is seen from another perspective.",
     "analisis": [
      [
       "kan skifte",
       {
        "@es": "puede cambiar",
        "@en": "can change"
       }
      ],
      [
       "handlingen blir sett",
       {
        "@es": "la trama se ve",
        "@en": "the plot is seen"
       }
      ],
      [
       "fra en annen side",
       {
        "@es": "desde otra perspectiva",
        "@en": "from another perspective"
       }
      ]
     ]
    },
    {
     "quien": "Elev",
     "no": "Hva gjør skildringen av hovedpersonen interessant?",
     "es": "¿Qué hace interesante el retrato del protagonista?",
     "en": "What makes the portrait of the protagonist interesting?",
     "analisis": [
      [
       "skildringen av hovedpersonen",
       {
        "@es": "el retrato del protagonista",
        "@en": "the portrait of the protagonist"
       }
      ],
      [
       "interessant",
       {
        "@es": "interesante",
        "@en": "Interesting."
       }
      ]
     ]
    },
    {
     "quien": "Lærer",
     "no": "Karakterutviklingen skjer gradvis, men noe blir stående usagt.",
     "es": "La evolución del personaje ocurre gradualmente, pero algo queda sin decir.",
     "en": "The character's evolution is gradually happening, but something remains unsaid.",
     "analisis": [
      [
       "karakterutviklingen skjer gradvis",
       {
        "@es": "la evolución ocurre gradualmente",
        "@en": "the evolution occurs gradually"
       }
      ],
      [
       "stående usagt",
       {
        "@es": "sin decir",
        "@en": "Unspoken"
       }
      ]
     ]
    },
    {
     "quien": "Elev",
     "no": "Er underteksten tydelig?",
     "es": "¿El subtexto está claro?",
     "en": "Is the subtext clear?",
     "analisis": [
      [
       "underteksten",
       {
        "@es": "el subtexto",
        "@en": "the subtext"
       }
      ],
      [
       "tydelig",
       {
        "@es": "claro",
        "@en": "Of course."
       }
      ]
     ]
    },
    {
     "quien": "Lærer",
     "no": "Ikke alltid. Symbolikken kan tolkes på flere måter.",
     "es": "No siempre. El simbolismo puede interpretarse de varias maneras.",
     "en": "Not always. Symbolism can be interpreted in several ways.",
     "analisis": [
      [
       "symbolikken",
       {
        "@es": "el simbolismo",
        "@en": "symbolism"
       }
      ],
      [
       "kan tolkes",
       {
        "@es": "puede interpretarse",
        "@en": "can be interpreted"
       }
      ],
      [
       "på flere måter",
       {
        "@es": "de varias maneras",
        "@en": "in various ways"
       }
      ]
     ]
    }
   ]
