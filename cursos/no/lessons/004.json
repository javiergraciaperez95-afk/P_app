   "texto": [
    {
     "@es": "Hvor kommer du fra? significa «¿De dónde eres?». La respuesta sigue el orden normal: sujeto + verbo + fra + país.",
     "@en": "Hvor kommer du fra? means «Where are you from?». The answer follows the normal order: subject + verb + fra + country."
    },
    {
     "@es": "Los nombres de países empiezan con mayúscula; los gentilicios se escriben con minúscula. El gentilicio suele tener la misma forma para hombres y mujeres: norsk, spansk, svensk.",
     "@en": "The names of countries begin with capital; the Gentiles are written with tiny. Gentilice is usually the same for men and women: norsk, spansk, svensk."
    }
   ]
  },
