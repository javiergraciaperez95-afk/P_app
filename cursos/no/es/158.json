      {
       "quien": {
        "texto": "Lea",
        "lengua": "estudio"
       },
       "estudio": "Jo mer jeg sykler, jo mindre drivstoff bruker jeg.",
       "alumno": "Cuanto más voy en bicicleta, menos combustible uso.",
