      {
       "quien": {
        "texto": "Omar",
        "lengua": "alumno"
       },
       "estudio": "Selv om det er langt, kan du sykle noen dager i uka.",
       "alumno": "Aunque está lejos, puedes ir en bicicleta algunos días de la semana.",
