     "tipo": "texto",
     "titulo": "Una idea para el edificio",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Beboerne ønsker en møteplass der de kan snakke sammen.",
       "alumno": "Los residentes quieren un lugar de encuentro donde puedan hablar juntos.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Beboerne ønsker",
         "los residentes quieren"
        ],
        [
         "en møteplass",
         "un lugar de encuentro"
        ],
        [
         "der de kan snakke sammen",
         "donde pueden hablar juntos"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Styret har et møte på torsdag.",
       "alumno": "La junta tiene una reunión el jueves.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Styret har et møte",
         "la junta tiene una reunión"
        ],
        [
         "på torsdag",
         "el jueves"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En beboer foreslår et fellesrom i kjelleren.",
       "alumno": "Un residente propone una sala común en el sótano.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "En beboer foreslår",
         "un residente propone"
        ],
        [
         "et fellesrom i kjelleren",
         "una sala común en el sótano"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "De andre lytter til forslaget og diskuterer det.",
       "alumno": "Los demás escuchan la propuesta y la debaten.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "De andre lytter",
         "los demás escuchan"
        ],
        [
         "til forslaget",
         "la propuesta"
        ],
        [
         "diskuterer det",
         "la debaten"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Styret vedtar å undersøke kostnaden først.",
       "alumno": "La junta acuerda examinar primero el coste.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Styret vedtar",
         "la junta acuerda"
        ],
        [
         "å undersøke kostnaden",
         "examinar el coste"
        ],
        [
         "først",
         "primero"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Hvis alle bidrar, kan rommet bli en møteplass for fellesskapet.",
       "alumno": "Si todos contribuyen, la sala puede convertirse en un lugar de encuentro para la comunidad.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Hvis alle bidrar",
         "si todos contribuyen"
        ],
        [
         "kan rommet bli",
