        ],
        [
         "en møteplass for fellesskapet",
         "en un lugar de encuentro para la comunidad"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Beboerne må snakke med hverandre før de tar en beslutning.",
       "alumno": "Los residentes tienen que hablar entre sí antes de tomar una decisión.",
       "literal": "",
