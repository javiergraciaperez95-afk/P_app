     "titulo": "Comentar una novela",
     "frases": [
      {
       "quien": {
        "texto": "Lærer",
        "lengua": "estudio"
       },
       "estudio": "I skjønnlitteratur kan fortellerstemmen påvirke hvordan vi oppfatter hovedpersonen.",
       "alumno": "En la literatura de ficción, la voz narrativa puede influir en cómo percibimos al protagonista.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "fortellerstemmen",
         "la voz narrativa"
        ],
        [
         "oppfatter hovedpersonen",
         "percibimos al protagonista"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Elev",
        "lengua": "estudio"
       },
       "estudio": "Er synsvinkelen alltid den samme?",
       "alumno": "¿El punto de vista es siempre el mismo?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "synsvinkelen",
         "el punto de vista"
        ],
        [
         "alltid den samme",
         "siempre el mismo"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Lærer",
        "lengua": "estudio"
       },
       "estudio": "Nei, den kan skifte, og handlingen blir sett fra en annen side.",
       "alumno": "No, puede cambiar y la trama se ve desde otra perspectiva.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "kan skifte",
         "puede cambiar"
        ],
        [
         "handlingen blir sett",
         "la trama se ve"
        ],
        [
         "fra en annen side",
         "desde otra perspectiva"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Elev",
        "lengua": "estudio"
       },
       "estudio": "Hva gjør skildringen av hovedpersonen interessant?",
       "alumno": "¿Qué hace interesante el retrato del protagonista?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "skildringen av hovedpersonen",
         "el retrato del protagonista"
        ],
        [
         "interessant",
         "interesante"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Lærer",
        "lengua": "estudio"
       },
       "estudio": "Karakterutviklingen skjer gradvis, men noe blir stående usagt.",
       "alumno": "La evolución del personaje ocurre gradualmente, pero algo queda sin decir.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "karakterutviklingen skjer gradvis",
         "la evolución ocurre gradualmente"
        ],
        [
         "stående usagt",
         "sin decir"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Elev",
        "lengua": "estudio"
       },
       "estudio": "Er underteksten tydelig?",
       "alumno": "¿El subtexto está claro?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "underteksten",
         "el subtexto"
        ],
        [
         "tydelig",
         "claro"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Lærer",
        "lengua": "estudio"
       },
       "estudio": "Ikke alltid. Symbolikken kan tolkes på flere måter.",
       "alumno": "No siempre. El simbolismo puede interpretarse de varias maneras.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "symbolikken",
         "el simbolismo"
        ],
        [
         "kan tolkes",
