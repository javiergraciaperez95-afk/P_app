     "tipo": "dialogo",
     "titulo": "¿Quién puede usar la nueva solución?",
     "frases": [
      {
       "quien": {
        "texto": "Sana",
        "lengua": "alumno"
       },
       "estudio": "Innloggingsløsningen må oppfylle strenge sikkerhetskrav.",
       "alumno": "El sistema de inicio de sesión debe cumplir estrictos requisitos de seguridad.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "innloggingsløsningen",
         "el sistema de inicio de sesión"
        ],
        [
         "sikkerhetskrav",
         "requisitos de seguridad"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Sana",
        "lengua": "alumno"
       },
       "estudio": "Samtidig må løsningen være brukervennlig.",
       "alumno": "Al mismo tiempo, el sistema debe ser fácil de usar.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "samtidig",
         "al mismo tiempo"
        ],
        [
         "brukervennlig",
         "fácil de usar"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Amir",
        "lengua": "estudio"
       },
       "estudio": "Universell utforming kan gjøre tjenesten tilgjengelig for flere.",
       "alumno": "El diseño universal puede hacer que el servicio sea accesible para más personas.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "universell utforming",
         "diseño universal"
        ],
        [
         "tilgjengelig",
         "accesible"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Sana",
        "lengua": "alumno"
       },
       "estudio": "En skjermleser kan hjelpe personer med nedsatt syn.",
       "alumno": "Un lector de pantalla puede ayudar a personas con visión reducida.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "skjermleser",
         "lector de pantalla"
        ],
        [
         "nedsatt syn",
         "visión reducida"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Sana",
        "lengua": "alumno"
       },
       "estudio": "Vi må begrense hvilke personopplysninger tjenesten lagrer.",
       "alumno": "Tenemos que limitar qué datos personales guarda el servicio.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "personopplysninger",
         "datos personales"
        ],
        [
         "lagrer",
         "almacena"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Sana",
        "lengua": "alumno"
       },
       "estudio": "Noen trenger brukerstøtte eller et analogt alternativ.",
       "alumno": "Algunas personas necesitan asistencia al usuario o una alternativa analógica.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "brukerstøtte",
         "asistencia al usuario"
        ],
        [
         "analogt alternativ",
         "alternativa analógica"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Amir",
        "lengua": "estudio"
       },
       "estudio": "Digital inkludering krever at vi ser tjenesten fra brukerens perspektiv.",
       "alumno": "La inclusión digital requiere que veamos el servicio desde la perspectiva del usuario.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "digital inkludering",
         "inclusión digital"
        ],
        [
         "brukerens perspektiv",
         "la perspectiva del usuario"
        ]
