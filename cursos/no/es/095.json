        "texto": "Nora",
        "lengua": "estudio"
       },
       "estudio": "Hei, det er Nora. Jeg blir forsinket.",
       "alumno": "Hola, soy Nora. Voy con retraso.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Amir",
        "lengua": "estudio"
       },
       "estudio": "Takk for beskjeden. Rekker du møtet klokka fire?",
       "alumno": "Gracias por avisar. ¿Llegas a la reunión de las cuatro?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nora",
        "lengua": "estudio"
       },
       "estudio": "Nei, jeg rekker ikke møtet før klokka fem.",
       "alumno": "No, no llego a la reunión antes de las cinco.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Amir",
        "lengua": "estudio"
       },
       "estudio": "Da kan vi møtes senere. Ring meg når du er framme.",
       "alumno": "Entonces podemos vernos más tarde. Llámame cuando llegues.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nora",
        "lengua": "estudio"
       },
       "estudio": "Det passer. Jeg legger igjen en beskjed hvis planen endrer seg.",
       "alumno": "Me va bien. Dejaré un mensaje si cambia el plan.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
