      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Jeg foreslår at vi bruker én felles mappe i en prøveperiode på to uker.",
       "alumno": "Propongo que usemos una carpeta compartida durante un periodo de prueba de dos semanas.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Vi kan ta hensyn til tilgang og datasikkerhet før vi begynner.",
       "alumno": "Podemos tener en cuenta el acceso y la seguridad de los datos antes de empezar.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Etter perioden samler vi tilbakemeldinger og vurderer resultatet.",
       "alumno": "Al terminar el periodo, recogeremos comentarios y evaluaremos el resultado.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
