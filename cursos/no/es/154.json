    {
     "tipo": "dialogo",
     "titulo": "Comprobar una foto",
     "frases": [
      {
       "quien": {
        "texto": "Journalist",
        "lengua": "estudio"
       },
       "estudio": "En melding hevder at dette bildet viser en hendelse i dag.",
       "alumno": "Un mensaje afirma que esta imagen muestra un suceso de hoy.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "En melding hevder",
         "un mensaje afirma"
        ],
        [
         "dette bildet viser",
         "esta imagen muestra"
        ],
        [
         "en hendelse i dag",
         "un suceso de hoy"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Redaktør",
        "lengua": "estudio"
       },
       "estudio": "Ifølge bildeteksten er bildet datert for fem år siden.",
       "alumno": "Según el pie de foto, la imagen está fechada hace cinco años.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Ifølge bildeteksten",
         "según el pie de foto"
        ],
        [
         "er bildet datert",
         "la imagen está fechada"
        ],
        [
         "for fem år siden",
         "hace cinco años"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Journalist",
        "lengua": "estudio"
       },
       "estudio": "Da mangler bildet viktig kontekst.",
       "alumno": "Entonces, a la imagen le falta contexto importante.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Da mangler bildet",
         "entonces a la imagen le falta"
        ],
        [
         "viktig kontekst",
         "contexto importante"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Redaktør",
        "lengua": "estudio"
       },
       "estudio": "Ja. Påstanden er villedende, men bildet er ikke manipulert.",
       "alumno": "Sí. La afirmación es engañosa, pero la imagen no está manipulada.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Påstanden er villedende",
         "la afirmación es engañosa"
        ],
        [
         "bildet er ikke manipulert",
         "la imagen no está manipulada"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Journalist",
        "lengua": "estudio"
       },
       "estudio": "Vi må faktasjekke meldingen før ryktet spres.",
       "alumno": "Tenemos que verificar el mensaje antes de que se difunda el rumor.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Vi må faktasjekke meldingen",
         "tenemos que verificar el mensaje"
        ],
        [
         "før ryktet spres",
         "antes de que se difunda el rumor"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Redaktør",
        "lengua": "estudio"
       },
       "estudio": "Hun sa at hun hadde sett bildet før.",
       "alumno": "Dijo que ya había visto la imagen.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Hun sa",
         "dijo"
        ],
        [
         "at hun hadde sett bildet før",
         "que ya había visto la imagen"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
