 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Proteger los datos personales",
     "texto": [
      "**Personvern** es la protección de la vida privada. **Personopplysning** es un dato que puede identificar a una persona. **Samtykke** es permiso dado de forma voluntaria."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Usar contenido ajeno",
     "texto": [
      "**Opphavsrett** protege obras originales. Al compartir una foto o un texto, respeta el permiso y menciona quién lo creó cuando corresponda."
     ],
     "tutora": ""
    }
   ]
  },
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Compartir una foto",
     "frases": [
      {
       "quien": {
        "texto": "Nora",
        "lengua": "estudio"
       },
       "estudio": "Kan jeg dele bildet fra arrangementet?",
       "alumno": "¿Puedo compartir la foto del evento?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Kan jeg dele",
         "puedo compartir"
        ],
        [
         "bildet fra arrangementet",
         "la foto del evento"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Amir",
        "lengua": "estudio"
       },
       "estudio": "Spør de andre først. Bildet viser personopplysninger.",
       "alumno": "Pregunta primero a los demás. La foto muestra datos personales.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Spør de andre først",
         "pregunta primero a los demás"
        ],
        [
         "bildet viser",
         "la foto muestra"
        ],
        [
         "personopplysninger",
         "datos personales"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nora",
        "lengua": "estudio"
       },
       "estudio": "Jeg kan få samtykke fra alle.",
       "alumno": "Puedo pedir permiso a todos.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Jeg kan få samtykke",
         "puedo conseguir consentimiento"
        ],
        [
         "fra alle",
         "de todos"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Amir",
        "lengua": "estudio"
       },
       "estudio": "Husk opphavsretten også. Hvem tok bildet?",
       "alumno": "Recuerda también los derechos de autor. ¿Quién hizo la foto?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Husk opphavsretten",
         "recuerda los derechos de autor"
        ],
        [
         "Hvem tok bildet",
         "quién hizo la foto"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nora",
        "lengua": "estudio"
       },
       "estudio": "Fotografen ga meg tillatelse til å dele det, hvis jeg krediterer henne.",
       "alumno": "El fotógrafo me dio permiso para compartirla si le doy reconocimiento.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Fotografen ga meg tillatelse",
         "el fotógrafo me dio permiso"
        ],
        [
         "til å dele det",
         "para compartirla"
        ],
        [
         "hvis jeg krediterer henne",
         "si le doy reconocimiento"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Amir",
        "lengua": "estudio"
       },
       "estudio": "Da bør du nevne opphavspersonen og sjekke lisensen.",
       "alumno": "Entonces deberías mencionar al autor y revisar la licencia.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "nevne opphavspersonen",
         "mencionar al autor"
        ],
        [
         "sjekke lisensen",
         "revisar la licencia"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
