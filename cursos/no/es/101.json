       },
       "estudio": "Ja, hvis du tar oppvasken etter middagen på fredag.",
       "alumno": "Sí, si tú lavas los platos después de la cena del viernes.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Linn",
        "lengua": "estudio"
       },
       "estudio": "Avtale. Da skriver jeg oppgavene på tavla.",
       "alumno": "De acuerdo. Entonces escribo las tareas en la pizarra.",
       "literal": "",
       "estructura": "",
       "nota": [],
