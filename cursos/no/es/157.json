 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Comprar con criterio",
     "texto": [
      "**Forbruk** es consumo. **Bærekraftig** describe algo que puede mantenerse a largo plazo con menor impacto ambiental. **Matsvinn** es comida que se tira sin aprovecharse."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Reducir residuos",
     "texto": [
      "**Gjenbruk** es reutilización; **resirkulere**, reciclar. **Engangs-** significa de un solo uso, como en **engangsplast** (plástico desechable)."
     ],
     "tutora": ""
    }
   ]
  },
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Comprar con menos residuos",
     "frases": [
      {
       "quien": {
        "texto": "Kunde",
        "lengua": "estudio"
       },
       "estudio": "Har dere en holdbar flaske uten engangsplast?",
       "alumno": "¿Tienen una botella duradera sin plástico desechable?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "en holdbar flaske",
         "una botella duradera"
        ],
        [
         "uten engangsplast",
         "sin plástico desechable"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Butikkansatt",
        "lengua": "estudio"
       },
       "estudio": "Ja, denne kan gjenbrukes mange ganger.",
       "alumno": "Sí, esta se puede reutilizar muchas veces.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "denne kan gjenbrukes",
         "esta se puede reutilizar"
        ],
        [
         "mange ganger",
         "muchas veces"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Kunde",
        "lengua": "estudio"
       },
       "estudio": "Hva gjør dere med emballasjen?",
       "alumno": "¿Qué hacen con el embalaje?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Hva gjør dere",
         "qué hacen"
        ],
        [
         "med emballasjen",
         "con el embalaje"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Butikkansatt",
        "lengua": "estudio"
       },
       "estudio": "Vi resirkulerer det som kan brukes på nytt.",
       "alumno": "Reciclamos lo que se puede volver a usar.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Vi resirkulerer",
         "reciclamos"
        ],
        [
         "det som kan brukes på nytt",
         "lo que se puede volver a usar"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Kunde",
        "lengua": "estudio"
       },
       "estudio": "Jeg vil også redusere matsvinnet hjemme.",
       "alumno": "También quiero reducir el desperdicio de comida en casa.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Jeg vil også redusere",
         "también quiero reducir"
        ],
        [
         "matsvinnet hjemme",
         "el desperdicio de comida en casa"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Butikkansatt",
        "lengua": "estudio"
       },
       "estudio": "Planlegg måltidene, så kjøper du bare det du trenger.",
       "alumno": "Planifica las comidas y así solo compras lo que necesitas.",
       "literal": "",
       "estructura": "",
       "nota": [],
