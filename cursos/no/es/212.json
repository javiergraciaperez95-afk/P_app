     "tipo": "dialogo",
     "titulo": "Una conversación sobre servicios sanitarios",
     "frases": [
      {
       "quien": {
        "texto": "Lege",
        "lengua": "estudio"
       },
       "estudio": "Folkehelse handler ikke bare om personlige valg.",
       "alumno": "La salud pública no depende solo de las decisiones personales.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Folkehelse handler",
         "la salud pública trata"
        ],
        [
         "ikke bare om personlige valg",
         "no solo de decisiones personales"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Rådgiver",
        "lengua": "estudio"
       },
       "estudio": "Levekår og tilgang til helsetjenester spiller også inn.",
       "alumno": "Las condiciones de vida y el acceso a los servicios sanitarios también influyen.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Levekår",
         "condiciones de vida"
        ],
        [
         "tilgang til helsetjenester",
         "acceso a servicios sanitarios"
        ],
        [
         "spiller også inn",
         "también influyen"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Lege",
        "lengua": "estudio"
       },
       "estudio": "Er ulikhetene større i noen områder?",
       "alumno": "¿Son mayores las desigualdades en algunas zonas?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "ulikhetene",
         "las desigualdades"
        ],
        [
         "større i noen områder",
         "mayores en algunas zonas"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Rådgiver",
        "lengua": "estudio"
       },
       "estudio": "Ja, og ressursfordeling kan være en del av forklaringen.",
       "alumno": "Sí, y la distribución de recursos puede ser parte de la explicación.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "ressursfordeling",
         "distribución de recursos"
        ],
        [
         "en del av forklaringen",
         "parte de la explicación"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Lege",
        "lengua": "estudio"
       },
       "estudio": "Tilgjengelighet på individnivå og strukturnivå må vurderes.",
       "alumno": "Hay que evaluar la accesibilidad en los niveles individual y estructural.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "tilgjengelighet",
         "accesibilidad"
        ],
        [
         "på individnivå og strukturnivå",
         "en los niveles individual y estructural"
        ],
        [
         "må vurderes",
         "debe evaluarse"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Rådgiver",
        "lengua": "estudio"
       },
       "estudio": "Et samfunnsansvar er å bedre tilgangen for alle.",
       "alumno": "Una responsabilidad social es mejorar el acceso para todos.",
       "literal": "",
       "estructura": "",
       "nota": [],
