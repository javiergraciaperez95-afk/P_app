       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Personal",
        "lengua": "alumno"
       },
       "estudio": "Legg ved kursbeviset. Du kan levere alt ved denne skranken.",
       "alumno": "Adjunte el certificado del curso. Puede entregarlo todo en este mostrador.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
