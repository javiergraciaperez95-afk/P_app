 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Acta escrita de una reunión",
     "texto": [
      "Un **referat** resume lo que se dijo y acordó. Una **protokoll** documenta las decisiones formales.",
      "Cada **oppfølgingspunkt** debe tener una persona responsable y un plazo."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Formulaciones precisas",
     "texto": [
      "Distingue entre una propuesta, una decisión y una objeción. Si hay desacuerdo, el acta puede registrarlo sin presentarlo como una decisión."
     ],
     "tutora": ""
    }
   ]
  },
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Después de la reunión sobre el horario de trabajo",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Møtelederen oppsummerer beslutningsgrunnlaget før saken avgjøres.",
       "alumno": "El moderador resume la base para decidir antes de que se resuelva el asunto.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "møtelederen",
         "el moderador"
        ],
        [
         "beslutningsgrunnlaget",
         "la base para decidir"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Referatet skiller mellom forslag og vedtak.",
       "alumno": "El acta distingue entre propuestas y resoluciones.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "referatet",
         "el acta"
        ],
        [
         "vedtak",
         "resoluciones"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En innsigelse blir tatt med selv om flertallet er enig.",
       "alumno": "Se incluye una objeción aunque la mayoría esté de acuerdo.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "innsigelse",
         "objeción"
        ],
        [
         "blir tatt med",
         "se incluye"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Hvert oppfølgingspunkt får en ansvarshavende og en tidsfrist.",
       "alumno": "Cada punto de seguimiento recibe una persona responsable y un plazo.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "oppfølgingspunkt",
         "punto de seguimiento"
        ],
        [
         "ansvarshavende",
         "persona responsable"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Saksframlegget journalføres sammen med protokollen.",
       "alumno": "La propuesta documentada se registra junto con el acta formal.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "saksframlegget",
         "la propuesta documentada"
        ],
        [
         "journalføres",
         "se registra"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Møtelederen presiserer at beslutningen ikke var enstemmig.",
       "alumno": "El moderador precisa que la decisión no fue unánime.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "presiserer",
         "precisa"
        ],
        [
         "enstemmig",
         "unánime"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Senere kontrollerer gruppen om pålegget er fulgt opp.",
       "alumno": "Más adelante, el grupo comprueba si se ha cumplido la orden.",
       "literal": "",
       "estructura": "",
       "nota": [],
