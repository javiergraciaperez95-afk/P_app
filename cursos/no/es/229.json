   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "¿Por qué vemos este contenido?",
     "frases": [
      {
       "quien": {
        "texto": "Nora",
        "lengua": "estudio"
       },
       "estudio": "Anbefalingssystemet bygger på aktiviteten min.",
       "alumno": "El sistema de recomendación se basa en mi actividad.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "anbefalingssystemet",
         "el sistema de recomendación"
        ],
        [
         "aktiviteten min",
         "mi actividad"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Emil",
        "lengua": "estudio"
       },
       "estudio": "Ja, personalisering kan gjøre innholdsstrømmen mer relevant.",
       "alumno": "Sí, la personalización puede hacer más relevante el flujo de contenidos.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "personalisering",
         "personalización"
        ],
        [
         "innholdsstrømmen",
         "el flujo de contenidos"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nora",
        "lengua": "estudio"
       },
       "estudio": "Samtidig kan algoritmisk utvalg begrense synligheten til andre synspunkter.",
       "alumno": "Al mismo tiempo, una selección algorítmica puede limitar la visibilidad de otros puntos de vista.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "algoritmisk utvalg",
         "selección algorítmica"
        ],
        [
         "synligheten",
         "la visibilidad"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Emil",
        "lengua": "estudio"
       },
       "estudio": "Plattformens inntektsmodell kan påvirke hvilke innlegg som får rekkevidde.",
       "alumno": "El modelo de ingresos de la plataforma puede influir en qué publicaciones alcanzan difusión.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "inntektsmodell",
         "modelo de ingresos"
        ],
        [
         "rekkevidde",
         "alcance"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nora",
        "lengua": "estudio"
       },
       "estudio": "Høyt engasjement kan gi et innlegg større spredning.",
       "alumno": "Una interacción alta puede dar más difusión a una publicación.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "engasjement",
         "interacción"
        ],
        [
         "spredning",
         "difusión"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Emil",
        "lengua": "estudio"
       },
       "estudio": "Men plattformansvar omfatter også moderering.",
       "alumno": "Pero la responsabilidad de la plataforma también incluye la moderación.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "plattformansvar",
         "responsabilidad de la plataforma"
        ],
        [
         "moderering",
         "moderación"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nora",
        "lengua": "estudio"
       },
       "estudio": "Innholdet bør ikke eksponeres bare fordi det deles raskt.",
       "alumno": "El contenido no debería exponerse solo porque se comparte rápido.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "eksponeres",
         "se expone"
        ],
        [
         "deles raskt",
         "se comparte rápido"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
   ]
