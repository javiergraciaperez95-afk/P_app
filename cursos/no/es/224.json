     "titulo": "Elegir una herramienta para el equipo",
     "frases": [
      {
       "quien": {
        "texto": "Lea",
        "lengua": "estudio"
       },
       "estudio": "Mitt standpunkt er at vi bør prøve verktøyet i én måned.",
       "alumno": "Mi postura es que deberíamos probar la herramienta durante un mes.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Omar",
        "lengua": "alumno"
       },
       "estudio": "Hva er premisset for prøveperioden?",
       "alumno": "¿Cuál es la premisa del periodo de prueba?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Lea",
        "lengua": "estudio"
       },
       "estudio": "Vi må kunne måle om det sparer tid.",
       "alumno": "Tenemos que poder medir si ahorra tiempo.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Omar",
        "lengua": "alumno"
       },
       "estudio": "Til tross for kostnaden kan det gjøre samarbeidet enklere.",
       "alumno": "A pesar del coste, puede facilitar la colaboración.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Lea",
        "lengua": "estudio"
       },
       "estudio": "Det er en god innvending. Vi bør også undersøke datasikkerheten.",
       "alumno": "Es una buena objeción. También deberíamos comprobar la seguridad de los datos.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Omar",
        "lengua": "alumno"
       },
       "estudio": "Like fullt kan vi anbefale en avgrenset prøveperiode.",
       "alumno": "Aun así, podemos recomendar un periodo de prueba limitado.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Lea",
        "lengua": "estudio"
       },
       "estudio": "Enig, hvis vi evaluerer resultatet sammen.",
       "alumno": "De acuerdo, si evaluamos juntos el resultado.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
