    {
     "tipo": "explicacion",
     "titulo": "Dar indicaciones",
     "texto": [
      "**Gå rett fram** significa «sigue recto». **Ta til høyre/venstre** significa «gira a la derecha/izquierda». **Ved siden av** quiere decir «al lado de»."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Preguntar la distancia",
     "texto": [
      "**Er det langt herfra?** significa «¿Está lejos de aquí?». **Til fots** es «a pie» y **omtrent** significa «aproximadamente»."
     ],
     "tutora": ""
    }
   ]
