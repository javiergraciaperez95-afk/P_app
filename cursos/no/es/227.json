       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Hvis en leverandør stanser, kan det oppstå knapphet på råvarer.",
       "alumno": "Si un proveedor se detiene, puede surgir escasez de materias primas.",
       "literal": "",
       "estructura": "",
