     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En lang forsyningskjede kan gjøre landet sårbart.",
       "alumno": "Una cadena de suministro larga puede hacer que el país sea vulnerable.",
       "literal": "",
       "estructura": "",
       "nota": [],
