        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Derfor planlegger vi bedre beredskap.",
       "alumno": "Por eso planificamos una mejor preparación.",
