    {
     "tipo": "dialogo",
     "titulo": "Leer antes de firmar",
     "frases": [
      {
       "quien": {
        "texto": "Mina",
        "lengua": "estudio"
       },
       "estudio": "Jeg har fått leiekontrakten. Kan vi gå gjennom vilkårene?",
       "alumno": "He recibido el contrato de alquiler. ¿Podemos repasar las condiciones?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Jeg har fått",
         "he recibido"
        ],
        [
         "leiekontrakten",
         "el contrato de alquiler"
        ],
        [
         "gå gjennom vilkårene",
         "repasar las condiciones"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Utleier",
        "lengua": "estudio"
       },
       "estudio": "Ja. Det står at depositumet skal stå på en depositumskonto.",
       "alumno": "Sí. El contrato dice que la fianza debe depositarse en una cuenta específica para fianzas.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Det står at",
         "dice que"
        ],
        [
         "depositumet skal stå",
         "la fianza debe estar"
        ],
        [
         "på en depositumskonto",
         "en una cuenta para el depósito"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Mina",
        "lengua": "estudio"
       },
       "estudio": "Når begynner oppsigelsestiden å løpe?",
       "alumno": "¿Cuándo empieza a contar el plazo de preaviso?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Når gjelder",
         "desde cuándo se aplica"
        ],
        [
         "oppsigelsestiden",
         "el plazo de preaviso"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Utleier",
        "lengua": "estudio"
       },
       "estudio": "Den begynner når oppsigelsen er levert skriftlig.",
       "alumno": "Empieza cuando se entrega el aviso por escrito.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Den begynner",
         "empieza"
        ],
        [
         "når oppsigelsen er levert skriftlig",
         "cuando se entrega el aviso por escrito"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Mina",
        "lengua": "estudio"
       },
       "estudio": "Og hva skjer hvis jeg betaler husleien for sent?",
       "alumno": "¿Y qué pasa si pago el alquiler tarde?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "hva skjer",
         "qué pasa"
        ],
        [
         "hvis jeg betaler husleien for sent",
         "si pago el alquiler tarde"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Utleier",
        "lengua": "estudio"
       },
       "estudio": "Da må du betale innen fristen som står i kontrakten.",
       "alumno": "Entonces tienes que pagar para la fecha límite que aparece en el contrato.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Da må du betale",
         "entonces tienes que pagar"
        ],
        [
         "innen fristen",
         "antes del plazo"
        ],
        [
         "som står i kontrakten",
         "que aparece en el contrato"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Mina",
        "lengua": "estudio"
       },
       "estudio": "Fint. Jeg vil lese alt nøye før jeg underskriver.",
       "alumno": "Bien. Quiero leerlo todo con atención antes de firmar.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Jeg vil lese alt nøye",
         "quiero leerlo todo con atención"
        ],
        [
         "før jeg underskriver",
         "antes de firmar"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Utleier",
        "lengua": "estudio"
       },
       "estudio": "Det er lurt. Vi kan også avtale innflytting skriftlig.",
       "alumno": "Es buena idea. También podemos acordar por escrito la fecha de entrada.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Vi kan også avtale",
         "también podemos acordar"
        ],
        [
         "innflytting skriftlig",
         "la entrada a la vivienda por escrito"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
   ]
