       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Språkdebatten handler også om hvem som får påvirke normen.",
       "alumno": "El debate lingüístico también trata de quién puede influir en la norma.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "språkdebatten",
         "el debate lingüístico"
        ],
        [
         "påvirke normen",
         "influir en la norma"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Samnorsk var et historisk prosjekt for å føre bokmål og nynorsk nærmere hverandre.",
       "alumno": "El noruego unificado fue un proyecto histórico para acercar el bokmål y el nynorsk.",
       "literal": "",
       "estructura": "",
       "nota": [],
