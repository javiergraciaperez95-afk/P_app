     "tipo": "texto",
     "titulo": "Dos perspectivas sobre el cambio lingüístico",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Et normeringsvedtak kan åpne for flere godkjente former.",
       "alumno": "Una decisión normativa puede permitir varias formas aceptadas.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
