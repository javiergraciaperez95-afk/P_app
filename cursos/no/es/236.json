      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "I dag står målfrihet og språklig mangfold sentralt i diskusjonen.",
       "alumno": "Hoy, la libertad de elegir forma escrita y la diversidad lingüística ocupan un lugar central en el debate.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "målfrihet",
         "libertad de elegir forma escrita"
        ],
        [
         "språklig mangfold",
         "diversidad lingüística"
        ]
       ],
       "parrafo": 0
