       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Noen språkbrukere foretrekker en bokmålsnær form.",
       "alumno": "Algunos usuarios de la lengua prefieren una forma cercana al bokmål.",
       "literal": "",
       "estructura": "",
       "nota": [],
