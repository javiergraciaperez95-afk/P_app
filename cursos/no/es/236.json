      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En rettskrivingsnorm må kunne forstås av språkbrukerne.",
       "alumno": "Los usuarios de la lengua deben poder entender una norma ortográfica.",
