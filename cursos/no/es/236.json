        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Andre mener at talemålsendringer bør gjenspeiles i skrift.",
       "alumno": "Otros consideran que los cambios en el habla deberían reflejarse por escrito.",
       "literal": "",
       "estructura": "",
       "nota": [],
