     "tipo": "texto",
     "titulo": "Una opinión sobre las lenguas",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Innledning: Norge har flere språk og dialekter.",
       "alumno": "Introducción: Noruega tiene varias lenguas y dialectos.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Innledning",
         "introducción"
        ],
        [
         "Norge har flere språk og dialekter",
         "Noruega tiene varias lenguas y dialectos"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Etter min mening er dette mangfoldet en viktig del av samfunnet.",
       "alumno": "En mi opinión, esta diversidad es una parte importante de la sociedad.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Etter min mening",
         "en mi opinión"
        ],
        [
         "dette mangfoldet",
         "esta diversidad"
        ],
        [
         "en viktig del av samfunnet",
         "una parte importante de la sociedad"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "For det første gir språk mennesker tilhørighet.",
       "alumno": "En primer lugar, las lenguas dan pertenencia a las personas.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "For det første",
         "en primer lugar"
        ],
        [
         "gir språk",
         "las lenguas dan"
        ],
        [
         "mennesker tilhørighet",
         "pertenencia a las personas"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "På den andre siden kan ulike dialekter være vanskelige å forstå.",
       "alumno": "Por otro lado, puede ser difícil entender dialectos distintos.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "På den andre siden",
         "por otro lado"
        ],
        [
         "ulike dialekter",
         "dialectos distintos"
        ],
        [
         "være vanskelige å forstå",
         "ser difíciles de entender"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Likevel bør vi lytte og spørre når vi ikke forstår.",
       "alumno": "Aun así, debemos escuchar y preguntar cuando no entendemos.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Likevel bør vi",
         "aun así debemos"
        ],
        [
         "lytte og spørre",
         "escuchar y preguntar"
        ],
        [
         "når vi ikke forstår",
         "cuando no entendemos"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Avslutningsvis mener jeg at språklig variasjon bør beskyttes.",
       "alumno": "Para concluir, creo que la variación lingüística debe protegerse.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Avslutningsvis",
         "para concluir"
        ],
