       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Alle familiemedlemmene tar med noe til måltidet.",
       "alumno": "Todos los miembros de la familia llevan algo para la comida.",
       "literal": "",
       "estructura": "",
       "nota": [],
