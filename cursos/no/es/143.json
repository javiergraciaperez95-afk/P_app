        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Alt arbeidet blir fordelt mellom generasjonene.",
       "alumno": "Todo el trabajo se reparte entre las generaciones.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
