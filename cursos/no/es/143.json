     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Hele familien møtes hos besteforeldrene på søndag.",
       "alumno": "Toda la familia se reúne en casa de los abuelos el domingo.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
