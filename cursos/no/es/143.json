         "para la comida"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Besteforeldrene passer på barnebarna mens foreldrene lager mat.",
       "alumno": "Los abuelos cuidan a los nietos mientras los padres preparan la comida.",
       "literal": "",
       "estructura": "",
       "nota": [],
