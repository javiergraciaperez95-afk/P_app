   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Nombrar a la pareja",
     "texto": [
      "**Samboer** es una pareja que convive sin estar necesariamente casada; **ektefelle** es cónyuge. **Likestilling** significa igualdad de derechos y oportunidades."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Conectores en pareja",
     "texto": [
      "**Både ... og** significa «tanto ... como»; **verken ... eller**, «ni ... ni». Con **verken ... eller**, la negación está dentro de la expresión y no se añade otra negación."
     ],
     "tutora": ""
    }
   ]
  },
