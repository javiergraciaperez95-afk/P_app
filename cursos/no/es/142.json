     "frases": [
      {
       "quien": {
        "texto": "Lea",
        "lengua": "estudio"
       },
       "estudio": "Hvordan fordeler dere husarbeidet?",
       "alumno": "¿Cómo reparten las tareas domésticas?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Hvordan fordeler dere",
         "cómo reparten"
        ],
        [
         "husarbeidet",
         "las tareas domésticas"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Omar",
        "lengua": "alumno"
       },
       "estudio": "Vi prøver å dele det rettferdig.",
       "alumno": "Intentamos repartirlo de forma equitativa.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Vi prøver å dele",
         "intentamos repartir"
        ],
        [
         "det rettferdig",
         "de forma equitativa"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Lea",
        "lengua": "estudio"
       },
       "estudio": "Jobber dere begge heltid?",
       "alumno": "¿Trabajáis ambos a jornada completa?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Jobber dere begge",
         "trabajáis ambos"
        ],
        [
         "heltid",
         "a jornada completa"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Omar",
        "lengua": "alumno"
       },
       "estudio": "Nei, partneren min jobber deltid og har fleksitid.",
       "alumno": "No, mi pareja trabaja a jornada parcial y tiene horario flexible.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "partneren min jobber deltid",
         "mi pareja trabaja a jornada parcial"
        ],
        [
         "har fleksitid",
         "tiene horario flexible"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Lea",
        "lengua": "estudio"
       },
       "estudio": "Da kan dere både hente barna og lage middag.",
       "alumno": "Entonces podéis tanto recoger a los niños como preparar la cena.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "både hente barna og lage middag",
         "tanto recoger a los niños como preparar la cena"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Omar",
        "lengua": "alumno"
       },
       "estudio": "Ja. Vi vil verken at én person skal gjøre alt, eller at oppgavene skal fordeles ulikt.",
       "alumno": "Sí. No queremos ni que una persona haga todo ni que las tareas se repartan de forma desigual.",
       "literal": "",
       "estructura": "",
       "nota": [],
