        "texto": "Lars",
        "lengua": "alumno"
       },
       "estudio": "Utstillingen er gratis, men foredraget koster penger.",
       "alumno": "La exposición es gratis, pero la conferencia cuesta dinero.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Utstillingen er gratis",
         "la exposición es gratis"
        ],
        [
         "foredraget koster penger",
         "la conferencia cuesta dinero"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Mina",
        "lengua": "estudio"
       },
       "estudio": "Må jeg melde meg på?",
       "alumno": "¿Tengo que inscribirme?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
