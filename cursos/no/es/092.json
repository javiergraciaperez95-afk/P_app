      },
      {
       "quien": {
        "texto": "Lars",
        "lengua": "alumno"
       },
       "estudio": "Det er et foredrag i kulturhuset og en utstilling i salen.",
       "alumno": "Hay una conferencia en el centro cultural y una exposición en la sala.",
