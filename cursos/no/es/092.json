      {
       "quien": {
        "texto": "Lars",
        "lengua": "alumno"
       },
       "estudio": "Ja, påmelding er nødvendig. Du finner nettsiden i meldingen.",
       "alumno": "Sí, la inscripción es necesaria. Encontrarás la página web en el mensaje.",
       "literal": "",
