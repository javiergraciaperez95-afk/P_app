    {
     "tipo": "texto",
     "titulo": "Una reseña breve",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Romanen gir et sterkt helhetsinntrykk, særlig fordi fortellerstemmen er nyansert.",
       "alumno": "La novela deja una impresión general fuerte, especialmente porque la voz narrativa está matizada.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "sterkt helhetsinntrykk",
         "una impresión general fuerte"
        ],
        [
         "fortellerstemmen er nyansert",
         "la voz narrativa está matizada"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Handlingen er engasjerende, selv om midtdelen er litt ujevn.",
       "alumno": "La trama engancha, aunque la parte central es algo irregular.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Handlingen er engasjerende",
         "la trama engancha"
        ],
        [
         "midtdelen er litt ujevn",
         "la parte central es algo irregular"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Skildringen av hovedpersonen er treffende og overbevisende.",
       "alumno": "El retrato del protagonista es acertado y convincente.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "skildringen av hovedpersonen",
         "el retrato del protagonista"
        ],
        [
         "treffende og overbevisende",
         "acertado y convincente"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En svakhet er at avslutningen kommer brått.",
       "alumno": "Un punto débil es que el final llega de repente.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "En svakhet",
         "un punto débil"
        ],
        [
         "avslutningen kommer brått",
         "el final llega de repente"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Likevel mener jeg at romanen er anbefalingsverdig for målgruppen.",
       "alumno": "Aun así, creo que la novela es recomendable para ese público.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Likevel mener jeg",
         "aun así, creo"
        ],
        [
         "anbefalingsverdig for målgruppen",
         "recomendable para el público destinatario"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Leseren får utbytte av både symbolikken og den nyanserte skildringen.",
       "alumno": "El lector saca provecho tanto del simbolismo como del retrato matizado.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "får utbytte av",
         "saca provecho de"
        ],
        [
         "symbolikken og den nyanserte skildringen",
         "el simbolismo y el retrato matizado"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
   ]
