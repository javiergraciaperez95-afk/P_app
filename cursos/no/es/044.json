   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Prohibiciones",
     "texto": [
      "**Ikke** va antes del verbo en una orden negativa: **Ikke gå inn!** («¡No entres!»).",
      "**Må ikke + infinitivo** expresa prohibición: **Du må ikke parkere her** («No puedes aparcar aquí»). No equivale a «no hace falta»."
     ],
     "tutora": ""
    }
   ]
