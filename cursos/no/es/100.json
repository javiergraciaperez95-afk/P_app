        "texto": "Ivo",
        "lengua": "estudio"
       },
       "estudio": "Er soverommet ved siden av badet?",
       "alumno": "¿El dormitorio está al lado del baño?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Maja",
        "lengua": "alumno"
       },
       "estudio": "Ja. Det lille rommet øverst i gangen kan brukes som kontor.",
       "alumno": "Sí. La habitación pequeña al fondo del pasillo se puede usar como despacho.",
       "literal": "",
       "estructura": "",
       "nota": [],
