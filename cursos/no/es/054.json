   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Describir los pasos",
     "texto": [
      "Para contar una receta, **først** significa «primero», **så** significa «luego» y **til slutt** significa «por último».",
      "En noruego, el presente puede describir instrucciones generales: **Vi koker poteten** («cocemos la patata»). La forma verbal no cambia según quién realiza la acción."
     ],
     "tutora": ""
    }
   ]
