     "titulo": "Pintar los bancos del patio",
     "frases": [
      {
       "quien": {
        "texto": "Ada",
        "lengua": "alumno"
       },
       "estudio": "Vi bør male benkene på lørdag fordi malingen flasser av.",
       "alumno": "Deberíamos pintar los bancos el sábado porque la pintura se está descascarando.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Bo",
        "lengua": "alumno"
       },
       "estudio": "Jeg kan hjelpe, men jeg er ikke tilgjengelig før klokka to.",
       "alumno": "Puedo ayudar, pero no estoy disponible antes de las dos.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ada",
        "lengua": "alumno"
       },
       "estudio": "Det går bra. Hvis vi begynner klokka to, rekker vi én benk.",
       "alumno": "No pasa nada. Si empezamos a las dos, nos dará tiempo a pintar un banco.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Bo",
        "lengua": "alumno"
       },
       "estudio": "Da kan jeg ta med verktøy, og du kan kjøpe maling.",
       "alumno": "Entonces yo puedo traer las herramientas y tú comprar la pintura.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
