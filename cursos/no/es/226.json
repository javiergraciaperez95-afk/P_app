    {
     "tipo": "dialogo",
     "titulo": "En søknad om beskyttelse",
     "frases": [
      {
       "quien": {
        "texto": "Sara",
        "lengua": "estudio"
       },
       "estudio": "Asylsøkeren venter på svar om oppholdstillatelsen.",
       "alumno": "El solicitante de asilo espera una respuesta sobre el permiso de residencia.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "asylsøkeren",
         "el solicitante de asilo"
        ],
        [
         "oppholdstillatelsen",
         "el permiso de residencia"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ali",
        "lengua": "alumno"
       },
       "estudio": "Behandlingstiden kan variere fra sak til sak.",
       "alumno": "El tiempo de tramitación puede variar de un expediente a otro.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "behandlingstiden",
         "el tiempo de tramitación"
        ],
        [
         "fra sak til sak",
         "de un expediente a otro"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Sara",
        "lengua": "estudio"
       },
       "estudio": "Ja, saksbehandlingen avhenger blant annet av dokumentasjonen.",
       "alumno": "Sí, la tramitación depende, entre otras cosas, de la documentación.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "saksbehandlingen",
         "la tramitación"
        ],
        [
         "avhenger",
         "depende"
        ],
        [
         "blant annet",
         "entre otras cosas"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ali",
        "lengua": "alumno"
       },
       "estudio": "Noen får midlertidig beskyttelse mens søknaden vurderes.",
       "alumno": "Algunas personas reciben protección temporal mientras se evalúa la solicitud.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "midlertidig beskyttelse",
         "protección temporal"
        ],
        [
         "vurderes",
         "se evalúa"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Sara",
        "lengua": "estudio"
       },
       "estudio": "Andre har klageadgang dersom de får avslag.",
       "alumno": "Otras tienen derecho a recurrir si reciben una denegación.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "klageadgang",
         "derecho a recurrir"
        ],
        [
         "avslag",
         "denegación"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ali",
        "lengua": "alumno"
       },
       "estudio": "En returordning må ta hensyn til situasjonen i hjemlandet.",
       "alumno": "Un programa de retorno debe tener en cuenta la situación en el país de origen.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "returordning",
         "programa de retorno"
        ],
        [
         "ta hensyn til",
         "tener en cuenta"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Sara",
        "lengua": "estudio"
       },
       "estudio": "Arbeidsinnvandring krever ofte kompetansegodkjenning.",
       "alumno": "La inmigración laboral a menudo requiere el reconocimiento de cualificaciones.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "arbeidsinnvandring",
         "inmigración laboral"
        ],
        [
         "kompetansegodkjenning",
         "reconocimiento de cualificaciones"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
