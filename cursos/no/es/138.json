       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Sana",
        "lengua": "alumno"
       },
       "estudio": "Flott. Jeg rydder boden min, og naboen rydder boden sin.",
       "alumno": "Muy bien. Ordeno mi trastero y el vecino ordena el suyo.",
       "literal": "",
       "estructura": "",
       "nota": [],
