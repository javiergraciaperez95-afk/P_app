         "qué tareas"
        ],
        [
         "har vi",
         "tenemos"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Sana",
        "lengua": "alumno"
       },
       "estudio": "Vi skal sortere avfallet og rydde fellesarealet.",
       "alumno": "Vamos a separar los residuos y ordenar la zona común.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "sortere avfallet",
         "separar los residuos"
        ],
        [
         "rydde fellesarealet",
         "ordenar la zona común"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nils",
        "lengua": "alumno"
       },
       "estudio": "Jeg tar med arbeidshanskene mine.",
       "alumno": "Llevo mis guantes de trabajo.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Jeg tar med",
         "llevo"
