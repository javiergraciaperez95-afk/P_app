     "titulo": "El sábado comunitario",
     "frases": [
      {
       "quien": {
        "texto": "Sana",
        "lengua": "alumno"
       },
       "estudio": "Vi har dugnad i borettslaget på lørdag.",
       "alumno": "El sábado hacemos una jornada de trabajo comunitario voluntario en la cooperativa de viviendas.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Vi har dugnad",
         "tenemos trabajo comunitario"
        ],
        [
         "i borettslaget",
         "en la comunidad de viviendas"
        ],
        [
         "på lørdag",
         "el sábado"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nils",
        "lengua": "alumno"
       },
       "estudio": "Hvilke oppgaver har vi?",
       "alumno": "¿Qué tareas tenemos?",
