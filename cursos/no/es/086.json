    {
     "tipo": "dialogo",
     "titulo": "¿Autobús o tren?",
     "frases": [
      {
       "quien": {
        "texto": "Sara",
        "lengua": "estudio"
       },
       "estudio": "Jeg vil sammenligne buss og tog.",
       "alumno": "Quiero comparar el autobús y el tren.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Jeg vil sammenligne",
         "quiero comparar"
        ],
        [
         "buss og tog",
         "autobús y tren"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Omar",
        "lengua": "alumno"
       },
       "estudio": "Toget er raskere enn bussen.",
       "alumno": "El tren es más rápido que el autobús.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
