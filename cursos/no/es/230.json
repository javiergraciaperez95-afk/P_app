   "piezas": [
    {
     "tipo": "test",
     "id": "no230-1",
     "pregunta": {
      "texto": "¿Qué permite la «etterprøvbarhet»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Que otras personas revisen el fundamento de una afirmación",
       "lengua": "alumno",
       "explicacion": "Una afirmación verificable permite comprobar sus bases.",
       "correcta": true
      },
      {
       "texto": "Que una insinuación se convierta automáticamente en un hecho",
       "lengua": "alumno",
       "explicacion": "Hace falta documentación.",
       "correcta": false
      },
      {
       "texto": "Que se eliminen las opiniones de una fuente",
       "lengua": "alumno",
       "explicacion": "La definición no trata de eso.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
     "explicacion": "",
     "autoevaluacion": false
    },
    {
     "tipo": "traduccion",
     "id": "no230-2",
     "pregunta": {
      "texto": "Traduce la frase.",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "En antydning er ikke det samme som dokumentasjon.",
      "lengua": "estudio"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Una insinuación no es lo mismo que una prueba documental.",
       "lengua": "alumno",
       "explicacion": "Distingue entre una insinuación y la documentación que la respalda.",
       "correcta": true
      },
      {
       "texto": "Una prueba documental es siempre una insinuación.",
       "lengua": "alumno",
       "explicacion": "La frase separa los dos conceptos.",
       "correcta": false
      },
      {
       "texto": "Una afirmación factual no puede comprobarse.",
       "lengua": "alumno",
       "explicacion": "No lo afirma.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
