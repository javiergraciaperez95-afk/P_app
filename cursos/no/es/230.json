    {
     "tipo": "test",
     "id": "no230-6",
     "pregunta": {
      "texto": "¿Qué significa «motstridende opplysninger»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Datos contradictorios",
       "lengua": "alumno",
       "explicacion": "Las versiones no coinciden entre sí.",
       "correcta": true
      },
      {
