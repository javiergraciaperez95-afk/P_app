    {
     "tipo": "test",
     "id": "no230-4",
     "pregunta": {
      "texto": "¿Qué hace una salvedad?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "Hva gjør et forbehold?",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "Delimita cuán segura puede ser una conclusión.",
       "lengua": "alumno",
       "explicacion": "Reduce el alcance de lo que se afirma.",
       "correcta": true
      },
      {
       "texto": "Garantiza que una fuente sea correcta.",
       "lengua": "alumno",
       "explicacion": "No garantiza eso.",
       "correcta": false
      },
      {
       "texto": "Sustituye la documentación de una afirmación.",
       "lengua": "alumno",
       "explicacion": "No tiene esa función.",
       "correcta": false
      }
     ],
     "respuestas": {
      "lengua": "estudio",
      "textos": []
     },
