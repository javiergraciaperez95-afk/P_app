 "etapas": [
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Dos lectores evalúan el mismo artículo",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Artikkelen viser til tre kilder, men dokumentasjonsgrunnlaget er ulikt.",
       "alumno": "El artículo cita tres fuentes, pero la base documental es desigual.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "viser til",
         "cita"
        ],
        [
         "dokumentasjonsgrunnlaget",
         "la base documental"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En leser mener at påstanden er etterprøvbar.",
       "alumno": "Un lector considera que la afirmación es verificable.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "mener at",
         "considera que"
        ],
        [
         "etterprøvbar",
         "verificable"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En annen er mer forbeholden fordi kildene gir motstridende opplysninger.",
       "alumno": "Otro es más prudente porque las fuentes ofrecen datos contradictorios.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "forbeholden",
         "prudente"
        ],
        [
         "motstridende opplysninger",
         "datos contradictorios"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Begge prøver å ettergå faktapåstanden før de deler artikkelen.",
       "alumno": "Ambos intentan comprobar la afirmación factual antes de compartir el artículo.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "ettergå",
         "comprobar"
        ],
        [
         "faktapåstanden",
         "la afirmación factual"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Hvis usikkerhetsgraden er høy, bør journalisten presisere hva som fortsatt er uklart.",
       "alumno": "Si el grado de incertidumbre es alto, el periodista debería precisar qué sigue sin estar claro.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "usikkerhetsgraden",
         "el grado de incertidumbre"
        ],
        [
         "presisere",
         "precisar"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En antydning er ikke det samme som dokumentasjon.",
       "alumno": "Una insinuación no es lo mismo que una prueba documental.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "antydning",
         "insinuación"
        ],
        [
         "ikke det samme som",
         "no es lo mismo que"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En etterrettelig oppsummering bør ta med relevante forbehold.",
       "alumno": "Un resumen riguroso debería incluir las salvedades pertinentes.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "etterrettelig",
         "riguroso"
        ],
        [
         "forbehold",
         "salvedades"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
   ]
  },
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Verificación y salvedades",
     "texto": [
      "**Etterprøvbarhet** significa que otras personas pueden comprobar el fundamento de una afirmación. Un **forbehold** limita el grado de certeza con que podemos concluir."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Reformular con precisión",
     "texto": [
      "Al resumir una fuente, distingue entre lo que documenta y lo que solo sugiere. Puedes usar expresiones como **según**, **parece que** y **no está claro si**."
     ],
     "tutora": ""
    }
   ]
  },
