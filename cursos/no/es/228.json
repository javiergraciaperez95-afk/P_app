 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Selección y presentación",
     "texto": [
      "**Vinkling** es el enfoque con que se presenta una noticia. El **kildegrunnlag** indica en qué fuentes se apoya.",
      "Una **motstemme** aporta una perspectiva distinta. Su presencia no garantiza por sí sola que la información esté equilibrada."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Responsabilidad editorial",
     "texto": [
      "**Redaksjonelt ansvar** comprende las decisiones sobre qué se publica, cómo se contextualiza y qué datos se comprueban."
     ],
     "tutora": ""
    }
   ]
  },
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "¿Qué se incluye en una noticia?",
     "frases": [
      {
       "quien": {
        "texto": "Redaktør",
        "lengua": "estudio"
       },
       "estudio": "Redaksjonell linje kan påvirke hvilke saker avisen velger.",
       "alumno": "La línea editorial puede influir en qué asuntos elige el periódico.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "redaksjonell linje",
         "línea editorial"
        ],
        [
         "hvilke saker",
         "qué asuntos"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Reporter",
        "lengua": "estudio"
       },
       "estudio": "En tydelig vinkling kan komme fram gjennom bildebruk.",
       "alumno": "Un enfoque claro puede percibirse mediante el uso de imágenes.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "tydelig vinkling",
         "enfoque claro"
        ],
        [
         "bildebruk",
         "uso de imágenes"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Redaktør",
        "lengua": "estudio"
       },
       "estudio": "Da bør vi også kontrollere kildegrunnlaget.",
       "alumno": "Entonces también deberíamos comprobar la base de fuentes.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "kontrollere",
         "comprobar"
        ],
        [
         "kildegrunnlaget",
         "la base de fuentes"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Reporter",
        "lengua": "estudio"
       },
       "estudio": "Sitatkontroll kan avdekke feil før publisering.",
       "alumno": "La verificación de citas puede detectar errores antes de publicar.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "sitatkontroll",
         "verificación de citas"
        ],
        [
         "før publisering",
         "antes de publicar"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Redaktør",
        "lengua": "estudio"
       },
       "estudio": "En reportasje bør kontekstualisere opplysningene.",
       "alumno": "Un reportaje debería contextualizar la información.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "reportasje",
         "reportaje"
        ],
        [
         "kontekstualisere",
         "contextualizar"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Reporter",
        "lengua": "estudio"
       },
       "estudio": "Og en motstemme kan vise at saken har flere sider.",
       "alumno": "Y una voz discrepante puede mostrar que el asunto tiene varias facetas.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "motstemme",
         "voz discrepante"
        ],
        [
         "flere sider",
         "varias facetas"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Redaktør",
        "lengua": "estudio"
       },
       "estudio": "Overskriften må ikke love mer enn teksten dokumenterer.",
       "alumno": "El titular no debe prometer más de lo que documenta el texto.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
