    {
     "tipo": "dialogo",
     "titulo": "Participar en el barrio",
     "frases": [
      {
       "quien": {
        "texto": "Lærer",
        "lengua": "estudio"
       },
       "estudio": "Hva kan gjøre det lettere for nye innbyggere å føle tilhørighet?",
       "alumno": "¿Qué puede facilitar que los nuevos residentes sientan que pertenecen?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Hva kan gjøre det lettere",
         "qué puede facilitar"
        ],
        [
         "for nye innbyggere",
         "para los nuevos residentes"
        ],
        [
         "å føle tilhørighet",
         "sentir pertenencia"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Elev",
        "lengua": "estudio"
       },
       "estudio": "En møteplass der folk kan delta sammen.",
       "alumno": "Un lugar de encuentro donde la gente pueda participar junta.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "En møteplass",
         "un lugar de encuentro"
        ],
        [
         "der folk kan delta sammen",
         "donde la gente puede participar junta"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Lærer",
        "lengua": "estudio"
       },
       "estudio": "Ja, språkopplæring og kontakt med naboer kan også hjelpe.",
       "alumno": "Sí, la enseñanza de idiomas y el contacto con los vecinos también pueden ayudar.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "språkopplæring",
         "enseñanza de idiomas"
        ],
        [
         "kontakt med naboer",
         "contacto con los vecinos"
        ],
        [
         "kan også hjelpe",
         "también pueden ayudar"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Elev",
        "lengua": "estudio"
       },
       "estudio": "Selv om noen møter fordommer, kan de likevel delta i samfunnet.",
       "alumno": "Aunque algunas personas sufren prejuicios, aun así pueden participar en la sociedad.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Selv om noen møter fordommer",
         "aunque algunas personas sufren prejuicios"
        ],
        [
         "kan de likevel delta",
         "aun así pueden participar"
        ],
        [
         "i samfunnet",
         "en la sociedad"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Lærer",
        "lengua": "estudio"
       },
       "estudio": "Riktig. Alle skal ha likeverd og vern mot diskriminering.",
       "alumno": "Correcto. Todas las personas deben tener igualdad de dignidad y protección contra la discriminación.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Alle skal ha",
         "todas las personas deben tener"
        ],
        [
         "likeverd",
         "igualdad de dignidad"
        ],
        [
         "vern mot diskriminering",
         "protección contra la discriminación"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
   ]
