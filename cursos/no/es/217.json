       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Lærer",
        "lengua": "estudio"
       },
       "estudio": "Ja. Regissøren har endret rekkefølgen i handlingen.",
       "alumno": "Sí. El director ha cambiado el orden de la trama.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "regissøren",
         "el director"
        ],
        [
