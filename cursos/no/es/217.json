        "texto": "Elev",
        "lengua": "estudio"
       },
       "estudio": "Har du sett filmatiseringen av romanen?",
       "alumno": "¿Has visto la adaptación cinematográfica de la novela?",
       "literal": "",
       "estructura": "",
       "nota": [],
