         "personas entrevistadas"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Elev",
        "lengua": "estudio"
       },
       "estudio": "Er lydsporet realistisk?",
       "alumno": "¿La pista de sonido es realista?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "lydsporet",
         "la pista de sonido"
        ],
        [
         "realistisk",
