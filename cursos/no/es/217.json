       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Elev",
        "lengua": "estudio"
       },
       "estudio": "Skuespillerne tolker hovedpersonene på en annen måte.",
       "alumno": "Los actores interpretan a los protagonistas de otra manera.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "skuespillerne",
         "los actores"
        ],
        [
         "tolker hovedpersonene",
         "interpretan a los protagonistas"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Lærer",
        "lengua": "estudio"
       },
       "estudio": "Dokumentaren bruker også originale opptak og intervjupersoner.",
       "alumno": "El documental también usa grabaciones originales y personas entrevistadas.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
