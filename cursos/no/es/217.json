        "lengua": "estudio"
       },
       "estudio": "Noen sceneskifter virker dramatisert.",
       "alumno": "Algunos cambios de escena parecen dramatizados.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
