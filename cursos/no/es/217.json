        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Lærer",
        "lengua": "estudio"
       },
       "estudio": "Ja, bakgrunnsmusikken skaper en rolig stemning.",
       "alumno": "Sí, la música de fondo crea una atmósfera tranquila.",
       "literal": "",
       "estructura": "",
       "nota": [],
