     "frases": [
      {
       "quien": {
        "texto": "Innbygger",
        "lengua": "estudio"
       },
       "estudio": "Jeg trenger juridisk bistand etter et vedtak.",
       "alumno": "Necesito asesoramiento jurídico después de una resolución.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "juridisk bistand",
         "asesoramiento jurídico"
        ],
        [
         "etter et vedtak",
         "después de una resolución"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Rådgiver",
        "lengua": "estudio"
       },
       "estudio": "Du kan be om rettshjelp og spørre om innsynsrett.",
       "alumno": "Puedes pedir asistencia jurídica y preguntar por el derecho de acceso a información.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "rettshjelp",
         "asistencia jurídica"
        ],
        [
         "innsynsrett",
         "derecho de acceso a información"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Innbygger",
        "lengua": "estudio"
       },
       "estudio": "Gjelder klageretten også i denne saken?",
       "alumno": "¿Se aplica también el derecho a reclamar en este caso?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "klageretten",
         "el derecho a reclamar"
        ],
        [
         "i denne saken",
         "en este caso"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Rådgiver",
        "lengua": "estudio"
       },
       "estudio": "Det må vurderes konkret. Du kan få advokatbistand.",
       "alumno": "Hay que valorarlo en concreto. Puedes recibir asistencia de un abogado.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "vurderes konkret",
         "se valora en concreto"
        ],
        [
         "advokatbistand",
         "asistencia de un abogado"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Innbygger",
        "lengua": "estudio"
       },
       "estudio": "Hvordan sikres rettssikkerheten?",
       "alumno": "¿Cómo se garantiza la seguridad jurídica?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "sikres",
         "se garantiza"
        ],
        [
         "rettssikkerheten",
         "la seguridad jurídica"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Rådgiver",
        "lengua": "estudio"
       },
       "estudio": "Uavhengige og upartiske vurderinger beskytter den enkelte.",
       "alumno": "Las valoraciones independientes e imparciales protegen a cada persona.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "uavhengige og upartiske vurderinger",
         "valoraciones independientes e imparciales"
        ],
        [
         "beskytter den enkelte",
         "protegen a cada persona"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Innbygger",
        "lengua": "estudio"
       },
       "estudio": "Og uskyldspresumsjonen gjelder mens saken behandles?",
       "alumno": "¿Y se aplica la presunción de inocencia mientras se tramita el caso?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "uskyldspresumsjonen",
         "la presunción de inocencia"
        ],
        [
         "mens saken behandles",
         "mientras se tramita el caso"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Rådgiver",
        "lengua": "estudio"
       },
       "estudio": "Ja, den tiltalte regnes som uskyldig inntil skyld er bevist.",
       "alumno": "Sí, se considera inocente al acusado hasta que se demuestre su culpabilidad.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "den tiltalte regnes som uskyldig",
         "se considera inocente al acusado"
        ],
        [
