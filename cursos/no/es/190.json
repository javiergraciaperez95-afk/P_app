        "texto": "Deltaker",
        "lengua": "estudio"
       },
       "estudio": "Da kan vi holde møtet fra ni til halv ti.",
       "alumno": "Entonces podemos reunirnos de nueve a nueve y media.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Koordinator",
        "lengua": "estudio"
       },
       "estudio": "Det passer. Jeg sender en oppdatert invitasjon.",
       "alumno": "De acuerdo. Enviaré una invitación actualizada.",
       "literal": "",
