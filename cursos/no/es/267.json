       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Edda",
        "lengua": "estudio"
       },
       "estudio": "Det er sant. Jeg vil nyansere påstanden: korte møter passer for enkle saker.",
       "alumno": "Es cierto. Matizaré mi afirmación: las reuniones cortas sirven para asuntos sencillos.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nils",
        "lengua": "alumno"
       },
       "estudio": "Og lengre møter bør ha en tydelig saksliste.",
       "alumno": "Y las reuniones largas deberían tener un orden del día claro.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
