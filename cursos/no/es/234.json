      },
      {
       "quien": {
        "texto": "Nils",
        "lengua": "alumno"
       },
       "estudio": "Slike språkholdninger kan skape en statusforskjell mellom dialekter.",
       "alumno": "Esas actitudes lingüísticas pueden crear una diferencia de estatus entre dialectos.",
