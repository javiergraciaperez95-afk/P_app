       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Rana",
        "lengua": "alumno"
       },
       "estudio": "Da kan du bruke ulike språkvarianter etter situasjonen.",
       "alumno": "Entonces puedes usar distintas variantes lingüísticas según la situación.",
       "literal": "",
       "estructura": "",
       "nota": [],
