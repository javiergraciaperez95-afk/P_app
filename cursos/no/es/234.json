       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nils",
        "lengua": "alumno"
       },
       "estudio": "Ja, kodeveksling er vanlig i et flerspråklig miljø.",
       "alumno": "Sí, la alternancia de códigos es habitual en un entorno multilingüe.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "kodeveksling",
         "alternancia de códigos"
        ],
        [
         "flerspråklig miljø",
         "entorno multilingüe"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Rana",
        "lengua": "alumno"
       },
       "estudio": "Noen mener at standardtalemål gir høyere status.",
       "alumno": "Algunas personas consideran que el habla estándar da más estatus.",
