    {
     "tipo": "explicacion",
     "titulo": "La sociedad del bienestar",
     "texto": [
      "**Velferdsstat** es un estado que ofrece servicios y ayudas sociales. Algunas prestaciones dependen de la situación y los ingresos de cada persona."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Solicitar una ayuda",
     "texto": [
      "**Bostøtte** es una ayuda para gastos de vivienda. **Behovsprøvd** significa que la ayuda depende de una evaluación de las necesidades y los ingresos."
     ],
     "tutora": ""
    }
   ]
  },
