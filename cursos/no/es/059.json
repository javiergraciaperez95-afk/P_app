   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Avisos de retraso",
     "texto": [
      "**Forsinket** significa «con retraso» y **avlyst**, «cancelado/a». **I tide** significa «a tiempo».",
      "**På grunn av** introduce la causa: **forsinket på grunn av trafikken** («con retraso debido al tráfico»). La forma definida **trafikken** suele traducirse como «el tráfico»."
     ],
     "tutora": ""
    }
   ]
