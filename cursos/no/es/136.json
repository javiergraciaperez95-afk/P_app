     "tipo": "dialogo",
     "titulo": "Una visita con la arrendadora",
     "frases": [
      {
       "quien": {
        "texto": "Mina",
        "lengua": "estudio"
       },
       "estudio": "Takk for visningen. Kan jeg spørre om noen ting?",
       "alumno": "Gracias por enseñarme la vivienda. ¿Puedo hacerle algunas preguntas?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Takk for visningen",
         "gracias por la visita"
        ],
        [
         "Kan jeg spørre",
         "puedo preguntar"
        ],
        [
         "om noen ting",
         "por algunas cosas"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Utleier",
        "lengua": "estudio"
       },
       "estudio": "Selvfølgelig. Hva vil du vite?",
       "alumno": "Por supuesto. ¿Qué quieres saber?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Selvfølgelig",
         "por supuesto"
        ],
        [
         "Hva vil du vite",
         "qué quieres saber"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Mina",
        "lengua": "estudio"
       },
       "estudio": "Ligger vaskerommet i samme etasje?",
       "alumno": "¿Está el cuarto de lavandería en la misma planta?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Ligger vaskerommet",
         "está el cuarto de lavandería"
        ],
        [
         "i samme etasje",
         "en la misma planta"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Utleier",
        "lengua": "estudio"
       },
       "estudio": "Ja, og det finnes en heis. Balkongen er også ganske stor.",
       "alumno": "Sí, y hay un ascensor. El balcón también es bastante grande.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "det finnes en heis",
         "hay un ascensor"
        ],
        [
         "Balkongen er også ganske stor",
         "el balcón también es bastante grande"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Mina",
        "lengua": "estudio"
       },
       "estudio": "Jeg merker litt støy fra trafikken. Er det alltid så mye støy?",
       "alumno": "Noto algo de ruido del tráfico. ¿Siempre hay tanto ruido?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Jeg merker litt støy",
         "noto algo de ruido"
        ],
        [
         "fra trafikken",
         "del tráfico"
        ],
        [
         "alltid så mye støy",
         "siempre tanto ruido"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Utleier",
        "lengua": "estudio"
       },
       "estudio": "Det er roligere om kvelden, men du kan undersøke det selv.",
       "alumno": "Por la noche hay menos ruido, pero puedes comprobarlo por ti misma.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Det er roligere om kvelden",
         "está más tranquilo por la noche"
        ],
        [
         "du kan undersøke det selv",
         "puedes comprobarlo tú misma"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Mina",
        "lengua": "estudio"
       },
       "estudio": "Jeg vil også sjekke om det er fuktig i kjelleren.",
       "alumno": "También quiero comprobar si hay humedad en el sótano.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Jeg vil også sjekke",
         "también quiero comprobar"
        ],
        [
         "om det er fuktig",
         "si está húmedo"
        ],
        [
         "i kjelleren",
         "en el sótano"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Utleier",
        "lengua": "estudio"
       },
       "estudio": "Det er lurt. Naboene pleier å være stille.",
       "alumno": "Es buena idea. Los vecinos suelen ser tranquilos.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
