        "lengua": "alumno"
       },
       "estudio": "Det går en komedie klokka sju.",
       "alumno": "Có một vở hài kịch lúc bảy giờ.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Leo",
        "lengua": "alumno"
       },
       "estudio": "Det passer. Skal vi bestille billetter nå?",
       "alumno": "Được thôi. Mình đặt vé ngay bây giờ nhé?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ida",
        "lengua": "alumno"
