 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Phân chia trách nhiệm",
     "texto": [
      "**Omsorg** là sự chăm sóc. **Foreldrepermisjon** là quyền nghỉ phép chăm con sau khi sinh hoặc nhận con nuôi. Trong tiếng Na Uy, **forelder** là một cha/mẹ và **foreldre** là cha mẹ (số nhiều)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Sau một mệnh đề phụ",
     "texto": [
      "Nếu một câu bắt đầu bằng **etter at** («sau khi») đứng trước, mệnh đề chính đảo chủ ngữ và động từ: **Etter at jeg leverer barna, går jeg på jobb**. Trong tiếng Tây Ban Nha không có kiểu đảo này."
     ],
     "tutora": ""
    }
   ]
  },
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Chia việc chăm sóc",
     "frases": [
      {
       "quien": {
        "texto": "Nora",
        "lengua": "estudio"
       },
       "estudio": "Etter at jeg leverer barna i barnehagen, går jeg på jobb.",
       "alumno": "Sau khi đưa bọn trẻ đến nhà trẻ, mình đi làm.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Etter at jeg leverer barna",
         "sau khi mình đưa bọn trẻ"
        ],
        [
         "i barnehagen",
         "ở nhà trẻ"
        ],
        [
         "går jeg på jobb",
         "mình đi làm"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Amir",
        "lengua": "estudio"
       },
       "estudio": "Henter partneren din dem om ettermiddagen?",
       "alumno": "Người bạn đời có đón chúng vào buổi chiều không?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Henter partneren din",
         "người bạn đời có đón"
        ],
        [
         "dem om ettermiddagen",
         "chúng vào buổi chiều"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nora",
        "lengua": "estudio"
       },
       "estudio": "Ja, men på fredag bytter vi.",
       "alumno": "Vâng, nhưng thứ Sáu này hai người thay phiên nhau.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "på fredag",
         "thứ Sáu này"
        ],
        [
         "bytter vi",
         "hai người thay phiên nhau"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Amir",
        "lengua": "estudio"
       },
       "estudio": "Det er fint at begge kan dele på omsorgen.",
       "alumno": "Thật tốt khi cả hai có thể chia sẻ việc chăm sóc.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Det er fint",
         "thật tốt"
        ],
        [
         "begge kan dele på omsorgen",
         "cả hai có thể chia sẻ việc chăm sóc"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nora",
        "lengua": "estudio"
       },
       "estudio": "Vi fordeler oppgavene slik at vi kan gå hjem tidligere.",
       "alumno": "Hai người phân chia công việc để có thể về nhà sớm hơn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Vi fordeler oppgavene",
         "hai người phân chia công việc"
        ],
        [
         "slik at vi kan gå hjem tidligere",
         "để có thể về nhà sớm hơn"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Amir",
        "lengua": "estudio"
       },
       "estudio": "Har dere omsorgsdager hvis et barn blir sykt?",
       "alumno": "Bên bạn có ngày nghỉ chăm sóc nếu con bị ốm không?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Har dere omsorgsdager",
         "bên bạn có ngày nghỉ chăm sóc"
        ],
        [
         "hvis et barn blir sykt",
         "nếu con bị ốm"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
