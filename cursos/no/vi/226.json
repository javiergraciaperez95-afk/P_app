   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Nguyên nhân và hoàn cảnh",
     "texto": [
      "**Fluktårsak** mô tả lý do một người phải rời bỏ nhà của họ. Một **asylsøker** là người xin tị nạn và chờ hồ sơ bảo vệ được xử lý.",
      "Di cư lao động và di cư đoàn tụ gia đình là hai lý do riêng biệt để chuyển đến một nước khác."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Một mô tả nhiều sắc thái",
     "texto": [
      "Một **oppholdstillatelse** là giấy tờ cho ở lại kèm những điều kiện nhất định. Bảo vệ tạm thời không nhất thiết bao hàm việc ở lại lâu dài."
     ],
     "tutora": ""
    }
   ]
  },
