        "texto": "Khách",
        "lengua": "alumno"
       },
       "estudio": "Jeg ser etter en lett jakke til kjølige dager.",
       "alumno": "Mình tìm một chiếc áo khoác nhẹ cho những ngày se lạnh.",
       "literal": "",
