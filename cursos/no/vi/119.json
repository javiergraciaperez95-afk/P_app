      },
      {
       "quien": {
        "texto": "Người bán hàng",
        "lengua": "alumno"
       },
       "estudio": "Denne modellen er laget av bomull og polyester. Den koster 699 kroner. Vil du prøve den?",
       "alumno": "Mẫu này được làm từ cotton và polyester. Giá 699 kroner. Bạn có muốn thử không?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Khách",
        "lengua": "alumno"
       },
       "estudio": "Ja. Jeg bruker vanligvis størrelse S, men vil gjerne prøve en større størrelse.",
       "alumno": "Vâng. Mình thường mặc cỡ S, nhưng muốn thử cỡ lớn hơn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Người bán hàng",
        "lengua": "alumno"
       },
       "estudio": "Her er størrelse M. Prøverommet er til venstre.",
       "alumno": "Đây là cỡ M. Phòng thử đồ ở bên trái.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Khách",
        "lengua": "alumno"
       },
       "estudio": "Hvis den ikke passer hjemme, kan jeg bytte den?",
       "alumno": "Nếu về nhà không vừa thì mình có đổi được không?",
       "literal": "",
       "estructura": "",
