         "trong khu chung cư"
        ],
        [
         "på lørdag",
         "thứ Bảy"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nils",
        "lengua": "alumno"
       },
       "estudio": "Hvilke oppgaver har vi?",
       "alumno": "Những việc nào cần làm?",
