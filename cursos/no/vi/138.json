       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nils",
        "lengua": "alumno"
       },
       "estudio": "Jeg tar med arbeidshanskene mine.",
       "alumno": "Mình mang theo găng tay lao động của mình.",
