       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Sana",
        "lengua": "alumno"
       },
       "estudio": "Flott. Jeg rydder boden min, og naboen rydder boden sin.",
       "alumno": "Tốt. Mình dọn kho đồ của mình, và người hàng xóm dọn kho đồ của họ.",
