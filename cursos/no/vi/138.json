     "frases": [
      {
       "quien": {
        "texto": "Sana",
        "lengua": "alumno"
       },
       "estudio": "Vi har dugnad i borettslaget på lørdag.",
       "alumno": "Thứ Bảy này mình làm một ngày lao động tình nguyện ở khu chung cư.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Vi har dugnad",
         "mình có một ngày lao động tình nguyện"
