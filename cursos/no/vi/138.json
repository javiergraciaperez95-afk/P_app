       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Sana",
        "lengua": "alumno"
       },
       "estudio": "Vi skal sortere avfallet og rydde fellesarealet.",
       "alumno": "Mình sẽ phân loại rác và dọn khu vực chung.",
       "literal": "",
       "estructura": "",
       "nota": [],
