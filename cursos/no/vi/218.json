       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Likevel mener jeg at romanen er anbefalingsverdig for målgruppen.",
       "alumno": "Dù vậy, mình cho rằng cuốn tiểu thuyết đáng khuyến nghị cho đối tượng ấy.",
       "literal": "",
