    {
     "tipo": "explicacion",
     "titulo": "Diễn đạt một đánh giá nhiều sắc thái",
     "texto": [
      "**Helhetsinntrykk** tổng kết ấn tượng chung. **Et forbehold** là một điều bảo lưu hoặc sự dè dặt.",
      "Trong một bài điểm sách, bạn nêu bật được một ưu điểm và nhắc đến một giới hạn, mà không trình bày cuốn sách như hoàn hảo hay vô dụng."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Đề xuất đúng đắn",
     "texto": [
      "**Engasjerende** nghĩa là giữ được sự quan tâm; **ujevn** nghĩa là không đồng đều chất lượng ở mọi phần. Giải thích cuốn sách phù hợp với ai."
     ],
     "tutora": ""
    }
   ]
