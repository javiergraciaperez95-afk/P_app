   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Núi hay bờ biển",
     "frases": [
      {
       "quien": {
        "texto": "Ari",
        "lengua": "estudio"
       },
       "estudio": "Skal vi leie en hytte ved fjorden i juli?",
       "alumno": "Mình thuê một túp lều bên fiord vào tháng Bảy nhé?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Liv",
        "lengua": "estudio"
       },
       "estudio": "Det høres fint ut. Et vandrerhjem ved kysten er kanskje billigere.",
       "alumno": "Nghe hay đấy. Một nhà nghỉ thanh niên ở bờ biển có lẽ rẻ hơn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ari",
        "lengua": "estudio"
       },
       "estudio": "Jeg vil gjerne ha noen rolige dager uten bil.",
       "alumno": "Mình muốn có vài ngày yên tĩnh không dùng xe ô tô.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Liv",
        "lengua": "estudio"
       },
       "estudio": "Da tar vi toget til Voss og leier en liten hytte der.",
       "alumno": "Vậy mình đi tàu đến Voss và thuê một túp lều nhỏ ở đó.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ari",
        "lengua": "estudio"
       },
       "estudio": "God idé. Vi skal sammenligne prisene før vi bestiller.",
       "alumno": "Ý hay đấy. Mình sẽ so sánh giá trước khi đặt.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
