       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Amir",
        "lengua": "estudio"
       },
       "estudio": "Da kan vi møtes senere. Ring meg når du er framme.",
       "alumno": "Vậy mình có thể gặp nhau sau. Gọi cho mình khi bạn đến nhé.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
