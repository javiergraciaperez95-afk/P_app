        "texto": "Lea",
        "lengua": "estudio"
       },
       "estudio": "Jeg vil sykle til jobb, men det er langt.",
       "alumno": "Mình muốn đi làm bằng xe đạp, nhưng chỗ làm xa lắm.",
       "literal": "",
       "estructura": "",
       "nota": [],
