        "lengua": "alumno"
       },
       "estudio": "Ja. Det lille rommet øverst i gangen kan brukes som kontor.",
       "alumno": "Vâng. Căn phòng nhỏ ở cuối hành lang có thể dùng làm phòng làm việc.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
