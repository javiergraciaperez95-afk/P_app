       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Maja",
        "lengua": "alumno"
       },
       "estudio": "Bare senga og skapet på soverommet.",
       "alumno": "Chỉ có giường và tủ trong phòng ngủ.",
