     "frases": [
      {
       "quien": {
        "texto": "Pårørende",
        "lengua": "estudio"
       },
       "estudio": "Moren min bor i en omsorgsbolig.",
       "alumno": "Mẹ mình sống trong một nhà ở kèm dịch vụ chăm sóc.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Moren min bor",
         "mẹ mình sống"
        ],
        [
         "i en omsorgsbolig",
         "trong một nhà ở kèm dịch vụ chăm sóc"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Veileder",
        "lengua": "estudio"
       },
       "estudio": "Får hun hjelp fra hjemmetjenesten?",
       "alumno": "Bà nhận được trợ giúp từ dịch vụ chăm sóc tại nhà không?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Får hun hjelp",
         "bà nhận được trợ giúp"
        ],
        [
         "fra hjemmetjenesten",
         "từ dịch vụ chăm sóc tại nhà"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Pårørende",
        "lengua": "estudio"
       },
       "estudio": "Ja, en helsefagarbeider kommer to ganger i uka.",
       "alumno": "Vâng, một nhân viên chăm sóc sức khỏe đến hai lần mỗi tuần.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "en helsefagarbeider kommer",
         "một nhân viên chăm sóc sức khỏe đến"
        ],
        [
         "to ganger i uka",
         "hai lần mỗi tuần"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Veileder",
        "lengua": "estudio"
       },
       "estudio": "Trenger hun også tilsyn om natten?",
       "alumno": "Bà cần người trông nom vào ban đêm không?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Trenger hun",
         "bà cần"
        ],
        [
         "tilsyn om natten",
         "người trông nom vào ban đêm"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Pårørende",
        "lengua": "estudio"
       },
       "estudio": "Nei, hun er ganske selvhjulpen, men jeg trenger avlastning.",
       "alumno": "Không, bà khá tự lập, nhưng mình cần nghỉ ngơi một chút.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "hun er ganske selvhjulpen",
         "bà khá tự lập"
        ],
        [
         "jeg trenger avlastning",
         "mình cần nghỉ ngơi"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Veileder",
        "lengua": "estudio"
       },
       "estudio": "Kommunen har et dagtilbud og et avlastningstilbud.",
       "alumno": "Đô thị cung cấp một dịch vụ ban ngày và một dịch vụ nghỉ ngơi.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Kommunen har",
