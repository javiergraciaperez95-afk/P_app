   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Đàm phán ở nơi làm việc",
     "texto": [
      "**Tariffavtale** là thỏa ước tập thể giữa đại diện người lao động và người sử dụng lao động. Nó dễ quy định lương và giờ làm việc.",
      "**Medbestemmelse** nghĩa là người lao động tham gia vào những quyết định ảnh hưởng đến công việc của họ."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Điều kiện và thay đổi",
     "texto": [
      "Một **drøftingsmøte** là cuộc họp để những bên trao đổi quan điểm trước khi ra quyết định. Những đề xuất phải được đánh giá theo điều kiện thỏa thuận."
     ],
     "tutora": ""
    }
   ]
  },
