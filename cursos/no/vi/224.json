     "frases": [
      {
       "quien": {
        "texto": "Lea",
        "lengua": "estudio"
       },
       "estudio": "Mitt standpunkt er at vi bør prøve verktøyet i én måned.",
       "alumno": "Quan điểm của mình là bên mình nên thử công cụ trong một tháng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Omar",
        "lengua": "alumno"
       },
       "estudio": "Hva er premisset for prøveperioden?",
       "alumno": "Tiền đề của giai đoạn thử nghiệm là gì?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Lea",
        "lengua": "estudio"
       },
       "estudio": "Vi må kunne måle om det sparer tid.",
       "alumno": "Bên mình phải đo được xem nó tiết kiệm thời gian không.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Omar",
        "lengua": "alumno"
       },
       "estudio": "Til tross for kostnaden kan det gjøre samarbeidet enklere.",
       "alumno": "Bất chấp chi phí, nó dễ làm việc hợp tác hơn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Lea",
        "lengua": "estudio"
       },
       "estudio": "Det er en god innvending. Vi bør også undersøke datasikkerheten.",
       "alumno": "Đó là một phản đối hay. Bên mình cũng nên kiểm tra an toàn dữ liệu.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Omar",
        "lengua": "alumno"
       },
       "estudio": "Like fullt kan vi anbefale en avgrenset prøveperiode.",
       "alumno": "Dù vậy, bên mình đề xuất được một giai đoạn thử nghiệm giới hạn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Lea",
        "lengua": "estudio"
       },
       "estudio": "Enig, hvis vi evaluerer resultatet sammen.",
       "alumno": "Đồng ý, nếu bên mình đánh giá kết quả cùng nhau.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
