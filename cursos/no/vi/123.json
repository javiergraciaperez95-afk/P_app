    {
     "tipo": "texto",
     "titulo": "Phiếu hướng dẫn máy pha cà phê",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Advarsel: Sett apparatet på et tørt, stabilt underlag. Kontroller at ledningen ikke er skadet. Fyll vannbeholderen før du slår på apparatet. Ikke åpne lokket mens vannet varmes. Koble fra støpselet før rengjøring. Vent til apparatet er kaldt.",
       "alumno": "Cảnh báo: Đặt thiết bị trên bề mặt khô và chắc chắn. Kiểm tra xem dây điện có bị hỏng không. Đổ đầy bình chứa trước khi bật thiết bị. Không mở nắp khi nước đang nóng. Rút phích cắm trước khi lau chùi. Chờ đến khi thiết bị nguội.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
  },
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Cảnh báo và mệnh lệnh",
     "texto": [
      "Trong một hướng dẫn, **må ikke** diễn tả điều cấm («không được»), còn **skal** có thể đánh dấu một bước bắt buộc. Đọc trước những cảnh báo. **Koble fra støpselet før rengjøring** nghĩa là «Rút phích cắm trước khi lau chùi».",
      "Những từ nối thời gian **før**, **mens** và **etter** chỉ lúc thực hiện hành động. Phiếu này là bài luyện ngôn ngữ; luôn làm theo hướng dẫn của thiết bị thật."
     ],
     "tutora": ""
    }
   ]
