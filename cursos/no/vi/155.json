       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nora",
        "lengua": "estudio"
       },
       "estudio": "Jeg kan få samtykke fra alle.",
       "alumno": "Mình xin được sự đồng ý của tất cả mọi người.",
       "literal": "",
       "estructura": "",
       "nota": [],
