 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Bảo vệ dữ liệu cá nhân",
     "texto": [
      "**Personvern** là sự bảo vệ đời sống riêng tư. **Personopplysning** là dữ liệu có thể nhận diện một người. **Samtykke** là sự cho phép được đưa ra một cách tự nguyện."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Dùng nội dung của người khác",
     "texto": [
      "**Opphavsrett** bảo vệ tác phẩm gốc. Khi chia sẻ ảnh hay văn bản, hãy tôn trọng sự cho phép và ghi nhận ai là người tạo ra khi cần."
     ],
     "tutora": ""
    }
   ]
  },
