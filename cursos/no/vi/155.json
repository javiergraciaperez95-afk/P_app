     "frases": [
      {
       "quien": {
        "texto": "Nora",
        "lengua": "estudio"
       },
       "estudio": "Kan jeg dele bildet fra arrangementet?",
       "alumno": "Mình chia sẻ bức ảnh của sự kiện này được không?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
