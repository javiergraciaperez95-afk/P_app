       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Amir",
        "lengua": "estudio"
       },
       "estudio": "Spør de andre først. Bildet viser personopplysninger.",
       "alumno": "Hãy hỏi những người khác trước. Bức ảnh thể hiện dữ liệu cá nhân.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Spør de andre først",
         "hãy hỏi những người khác trước"
