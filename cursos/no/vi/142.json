    {
     "tipo": "explicacion",
     "titulo": "Gọi tên người bạn đời",
     "texto": [
      "**Samboer** là một cặp đôi sống chung mà không nhất thiết đã kết hôn; **ektefelle** là vợ/chồng. **Likestilling** nghĩa là bình đẳng về quyền và cơ hội."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Liên từ trong cặp đôi",
     "texto": [
      "**Både ... og** nghĩa là «vừa... vừa...»; **verken ... eller**, «không... cũng không...». Với **verken ... eller**, phủ định nằm trong cấu trúc và không thêm phủ định nào khác."
     ],
     "tutora": ""
    }
   ]
