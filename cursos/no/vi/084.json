   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Nêu một vấn đề",
     "texto": [
      "**Bestilling** là đơn đặt hàng; **pakke**, gói hàng. **Mangle** nghĩa là thiếu một thứ gì đó và **ødelagt** nghĩa là bị hỏng."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Yêu cầu một cách giải quyết",
     "texto": [
      "Để yêu cầu hỗ trợ, bạn có thể **kontakte kundeservice** («liên hệ bộ phận chăm sóc khách hàng») và cung cấp **ordrenummer** («số đơn hàng»). **Sende en ny vare** là gửi một món hàng mới."
     ],
     "tutora": ""
    }
   ]
  },
