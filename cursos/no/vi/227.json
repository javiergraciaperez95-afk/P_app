   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Chuỗi cung ứng và tính dễ tổn thương",
     "texto": [
      "**forsyningskjede** (chuỗi cung ứng) mô tả những giai đoạn đưa một sản phẩm từ nguyên liệu thô đến người tiêu dùng. Nếu một giai đoạn hỏng, toàn bộ chuỗi dễ bị gián đoạn.",
      "**An ninh lương thực** nghĩa là mọi người được tiếp cận ổn định với thực phẩm đủ và an toàn."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Hậu quả và biện pháp",
     "texto": [
      "**Thích ứng khí hậu** giảm thiệt hại do biến đổi khí hậu gây ra, trong khi **giảm phát thải** hạn chế nguyên nhân của nó. Một **kinh tế tuần hoàn** nỗ lực giữ vật liệu được sử dụng lâu hơn."
     ],
     "tutora": ""
    }
   ]
  },
