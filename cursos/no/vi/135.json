         "điện có được bao gồm"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Eva",
        "lengua": "alumno"
       },
       "estudio": "Nei, det står i annonsen at strøm ikke er inkludert.",
       "alumno": "Không, quảng cáo ghi rằng điện không được bao gồm.",
       "literal": "",
       "estructura": "",
