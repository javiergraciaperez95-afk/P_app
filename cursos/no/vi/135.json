     "tipo": "dialogo",
     "titulo": "Một quảng cáo trên mạng",
     "frases": [
      {
       "quien": {
        "texto": "Eva",
        "lengua": "alumno"
       },
       "estudio": "Jeg fant en boligannonse for en leiebolig i sentrum.",
       "alumno": "Mình đã tìm thấy một quảng cáo về một căn nhà cho thuê ở trung tâm.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Jeg fant",
         "đã tìm thấy"
        ],
        [
         "en boligannonse",
         "một quảng cáo nhà ở"
        ],
        [
         "for en leiebolig",
         "về một căn nhà cho thuê"
        ],
        [
         "i sentrum",
         "ở trung tâm"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Marius",
        "lengua": "estudio"
       },
       "estudio": "Er boligen romslig?",
       "alumno": "Căn nhà có rộng rãi không?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Er boligen",
         "căn nhà"
        ],
        [
         "romslig",
         "rộng rãi"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Eva",
        "lengua": "alumno"
       },
       "estudio": "Ja, den har to soverom, og husleien er tolv tusen kroner per måned.",
       "alumno": "Vâng, nhà có hai phòng ngủ và tiền thuê là mười hai nghìn kroner mỗi tháng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "den har to soverom",
         "nhà có hai phòng ngủ"
