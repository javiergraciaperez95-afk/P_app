        [
         "per måned",
         "mỗi tháng"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Marius",
        "lengua": "estudio"
       },
       "estudio": "Er strøm inkludert?",
       "alumno": "Điện có được bao gồm không?",
