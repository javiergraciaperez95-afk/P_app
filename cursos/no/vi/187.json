        "texto": "Marta",
        "lengua": "alumno"
       },
       "estudio": "Vi kan prøve fleksibel starttid i to uker.",
       "alumno": "Bên mình thử được giờ vào làm linh hoạt trong hai tuần.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ola",
        "lengua": "alumno"
       },
       "estudio": "Det kan gjøre det lettere å unngå rushtiden, men møtene må fortsatt starte samlet.",
       "alumno": "Điều đó giúp tránh giờ cao điểm, nhưng những cuộc họp vẫn phải bắt đầu cùng cả đội.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Marta",
        "lengua": "alumno"
       },
       "estudio": "Da kan vi registrere når folk begynner, og evaluere etter forsøket.",
       "alumno": "Vậy bên mình ghi lại khi mọi người bắt đầu làm việc và đánh giá sau thử nghiệm.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Ola",
        "lengua": "alumno"
       },
       "estudio": "Greit, hvis alle får velge mellom klokka sju og ni.",
       "alumno": "Được, nếu mỗi người được chọn giữa 7 giờ và 9 giờ.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
