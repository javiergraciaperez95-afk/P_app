   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Bàn về một cuốn tiểu thuyết",
     "texto": [
      "**Fortellerstemme** là giọng kể câu chuyện; **synsvinkel** là điểm nhìn mà từ đó câu chuyện được kể.",
      "**Undertekst** là điều văn bản gợi ra mà không diễn đạt trực tiếp. Một diễn giải được xem là **flertydig** (chấp nhận nhiều nghĩa)."
     ],
     "tutora": ""
    }
   ]
  },
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Bình luận về một cuốn tiểu thuyết",
     "frases": [
      {
       "quien": {
        "texto": "Lærer",
        "lengua": "estudio"
       },
       "estudio": "I skjønnlitteratur kan fortellerstemmen påvirke hvordan vi oppfatter hovedpersonen.",
       "alumno": "Trong văn học hư cấu, giọng kể dễ ảnh hưởng đến lối ta cảm nhận nhân vật chính.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "fortellerstemmen",
         "giọng kể"
        ],
        [
         "oppfatter hovedpersonen",
         "ta cảm nhận nhân vật chính"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Elev",
        "lengua": "estudio"
       },
       "estudio": "Er synsvinkelen alltid den samme?",
       "alumno": "Điểm nhìn luôn giống nhau không?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "synsvinkelen",
         "điểm nhìn"
        ],
        [
         "alltid den samme",
         "luôn giống nhau"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Lærer",
        "lengua": "estudio"
       },
       "estudio": "Nei, den kan skifte, og handlingen blir sett fra en annen side.",
       "alumno": "Không, nó dễ thay đổi, và cốt truyện được nhìn từ phía kia.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "kan skifte",
         "dễ thay đổi"
        ],
        [
         "handlingen blir sett",
         "cốt truyện được nhìn"
        ],
        [
         "fra en annen side",
         "từ phía kia"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Elev",
        "lengua": "estudio"
       },
       "estudio": "Hva gjør skildringen av hovedpersonen interessant?",
       "alumno": "Điều gì làm lối khắc họa nhân vật chính thú vị?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "skildringen av hovedpersonen",
         "lối khắc họa nhân vật chính"
        ],
        [
         "interessant",
         "thú vị"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Lærer",
        "lengua": "estudio"
       },
       "estudio": "Karakterutviklingen skjer gradvis, men noe blir stående usagt.",
       "alumno": "Sự phát triển nhân vật diễn ra dần dần, nhưng vẫn còn điều chưa được nêu ra.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "karakterutviklingen skjer gradvis",
         "sự phát triển diễn ra dần dần"
        ],
        [
         "stående usagt",
         "chưa được nêu ra"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Elev",
        "lengua": "estudio"
       },
       "estudio": "Er underteksten tydelig?",
       "alumno": "Ẩn ý rõ ràng không?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "underteksten",
         "ẩn ý"
        ],
        [
         "tydelig",
         "rõ ràng"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Lærer",
        "lengua": "estudio"
       },
       "estudio": "Ikke alltid. Symbolikken kan tolkes på flere måter.",
       "alumno": "Không phải lần nào. Chủ nghĩa biểu tượng dễ được diễn giải theo nhiều lối.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
