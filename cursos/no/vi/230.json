 "etapas": [
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Hai độc giả đánh giá cùng một bài viết.",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Artikkelen viser til tre kilder, men dokumentasjonsgrunnlaget er ulikt.",
       "alumno": "Bài viết trích dẫn ba nguồn, nhưng cơ sở tài liệu không đồng đều.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "viser til",
         "trích dẫn"
        ],
        [
         "dokumentasjonsgrunnlaget",
         "cơ sở tài liệu"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En leser mener at påstanden er etterprøvbar.",
       "alumno": "Một độc giả cho rằng khẳng định kiểm chứng được.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "mener at",
         "cho rằng"
        ],
        [
         "etterprøvbar",
         "kiểm chứng được"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En annen er mer forbeholden fordi kildene gir motstridende opplysninger.",
       "alumno": "Người kia thận trọng hơn vì những nguồn đưa ra thông tin mâu thuẫn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "forbeholden",
         "thận trọng"
        ],
        [
         "motstridende opplysninger",
         "thông tin mâu thuẫn"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Begge prøver å ettergå faktapåstanden før de deler artikkelen.",
       "alumno": "Cả hai đều cố kiểm chứng khẳng định thực tế trước khi chia sẻ bài viết.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "ettergå",
         "kiểm chứng"
        ],
        [
         "faktapåstanden",
         "khẳng định thực tế"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Hvis usikkerhetsgraden er høy, bør journalisten presisere hva som fortsatt er uklart.",
       "alumno": "Nếu mức độ không chắc chắn cao, nhà báo nên làm rõ điều vẫn còn không rõ ràng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "usikkerhetsgraden",
         "mức độ không chắc chắn"
        ],
        [
         "presisere",
         "làm rõ"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En antydning er ikke det samme som dokumentasjon.",
       "alumno": "Một ám chỉ không giống với bằng chứng tài liệu.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "antydning",
         "ám chỉ"
        ],
        [
         "ikke det samme som",
         "không giống với"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En etterrettelig oppsummering bør ta med relevante forbehold.",
       "alumno": "Một bản tổng kết chặt chẽ nên đưa vào những điều bảo lưu liên quan.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "etterrettelig",
         "chặt chẽ"
        ],
        [
         "forbehold",
         "điều bảo lưu"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
   ]
