   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Nói về phẩm chất của bạn",
     "texto": [
      "Trong buổi phỏng vấn, người ta có thể hỏi về **kvalifikasjoner** (trình độ chuyên môn), kinh nghiệm và cách bạn làm việc với người khác. **Fleksibel** nghĩa là bạn có thể thích nghi; **nøyaktig**, bạn làm việc cẩn thận."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Sở hữu ngôi thứ ba",
     "texto": [
      "**Hans** nghĩa là «của anh ấy» (nam); **hennes**, «của cô ấy» (nữ); **deres**, «của họ» hoặc «của các bạn». Khác với **min/mi/mitt/mine**, các dạng này không đổi theo giống hay số của vật được sở hữu: **hans CV**, **hennes erfaring**, **deres arbeidsplass**."
     ],
     "tutora": ""
    }
   ]
