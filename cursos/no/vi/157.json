   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Mua sắm cân nhắc",
     "texto": [
      "**Forbruk** là tiêu dùng. **Bærekraftig** mô tả điều duy trì được lâu dài với tác động môi trường thấp hơn. **Matsvinn** là thực phẩm bị bỏ đi mà không được tận dụng."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Giảm rác thải",
     "texto": [
      "**Gjenbruk** là tái sử dụng; **resirkulere**, tái chế. **Engangs-** nghĩa là dùng một lần, như trong **engangsplast** (nhựa dùng một lần)."
     ],
     "tutora": ""
    }
   ]
