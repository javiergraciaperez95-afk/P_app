   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Mua sắm với ít rác thải hơn",
     "frases": [
      {
       "quien": {
        "texto": "Kunde",
        "lengua": "estudio"
       },
       "estudio": "Har dere en holdbar flaske uten engangsplast?",
       "alumno": "Bên bạn còn chai bền, không làm bằng nhựa dùng một lần không?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "en holdbar flaske",
         "một chai bền"
        ],
        [
         "uten engangsplast",
         "không làm bằng nhựa dùng một lần"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Butikkansatt",
        "lengua": "estudio"
       },
       "estudio": "Ja, denne kan gjenbrukes mange ganger.",
       "alumno": "Vâng, chiếc này tái sử dụng được nhiều lần.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "denne kan gjenbrukes",
         "chiếc này tái sử dụng được"
        ],
        [
         "mange ganger",
         "nhiều lần"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Kunde",
        "lengua": "estudio"
       },
       "estudio": "Hva gjør dere med emballasjen?",
       "alumno": "Bên bạn xử lý bao bì thế nào?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Hva gjør dere",
         "bên bạn xử lý"
        ],
        [
         "med emballasjen",
         "bao bì"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Butikkansatt",
        "lengua": "estudio"
       },
       "estudio": "Vi resirkulerer det som kan brukes på nytt.",
       "alumno": "Bên mình tái chế những gì dùng lại được.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Vi resirkulerer",
         "bên mình tái chế"
        ],
        [
         "det som kan brukes på nytt",
         "những gì dùng lại được"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Kunde",
        "lengua": "estudio"
       },
       "estudio": "Jeg vil også redusere matsvinnet hjemme.",
       "alumno": "Mình cũng muốn giảm lãng phí thực phẩm ở nhà.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Jeg vil også redusere",
         "mình cũng muốn giảm"
        ],
        [
         "matsvinnet hjemme",
         "lãng phí thực phẩm ở nhà"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Butikkansatt",
        "lengua": "estudio"
       },
       "estudio": "Planlegg måltidene, så kjøper du bare det du trenger.",
       "alumno": "Hãy lập kế hoạch cho bữa ăn, như vậy bạn chỉ mua những thứ cần thiết.",
       "literal": "",
       "estructura": "",
       "nota": [],
