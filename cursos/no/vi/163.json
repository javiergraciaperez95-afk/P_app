     "tipo": "dialogo",
     "titulo": "Tham gia vào khu dân cư",
     "frases": [
      {
       "quien": {
        "texto": "Lærer",
        "lengua": "estudio"
       },
       "estudio": "Hva kan gjøre det lettere for nye innbyggere å føle tilhørighet?",
       "alumno": "Điều gì giúp cư dân mới dễ cảm thấy mình thuộc về?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Hva kan gjøre det lettere",
         "điều gì giúp"
        ],
        [
         "for nye innbyggere",
         "cho cư dân mới"
        ],
        [
         "å føle tilhørighet",
         "cảm thấy thuộc về"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Elev",
        "lengua": "estudio"
       },
       "estudio": "En møteplass der folk kan delta sammen.",
       "alumno": "Một nơi gặp gỡ để mọi người cùng tham gia.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "En møteplass",
         "một nơi gặp gỡ"
        ],
        [
         "der folk kan delta sammen",
         "để mọi người cùng tham gia"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Lærer",
        "lengua": "estudio"
       },
       "estudio": "Ja, språkopplæring og kontakt med naboer kan også hjelpe.",
       "alumno": "Vâng, việc dạy ngôn ngữ và tiếp xúc với hàng xóm cũng giúp ích được.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "språkopplæring",
         "việc dạy ngôn ngữ"
        ],
        [
         "kontakt med naboer",
         "gần gũi với người láng giềng"
        ],
        [
         "kan også hjelpe",
         "cũng mang lại lợi ích"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Elev",
        "lengua": "estudio"
       },
       "estudio": "Selv om noen møter fordommer, kan de likevel delta i samfunnet.",
       "alumno": "Dù một số người phải chịu định kiến, họ vẫn tham gia được vào xã hội.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Selv om noen møter fordommer",
         "dù một số người phải chịu định kiến"
        ],
        [
         "kan de likevel delta",
         "họ vẫn tham gia được"
        ],
        [
         "i samfunnet",
         "vào xã hội"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Lærer",
        "lengua": "estudio"
       },
       "estudio": "Riktig. Alle skal ha likeverd og vern mot diskriminering.",
       "alumno": "Đúng vậy. Mọi người đều phải được bình đẳng về phẩm chất và được bảo vệ khỏi phân biệt đối xử.",
