     "tipo": "texto",
     "titulo": "Một ý kiến về ngôn ngữ",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Innledning: Norge har flere språk og dialekter.",
       "alumno": "Mở đầu: Na Uy sử dụng nhiều ngôn ngữ và phương ngữ.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Innledning",
         "phần mở đầu"
        ],
        [
         "Norge har flere språk og dialekter",
         "Na Uy sử dụng nhiều ngôn ngữ và phương ngữ"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Etter min mening er dette mangfoldet en viktig del av samfunnet.",
       "alumno": "Theo ý kiến của mình, sự đa dạng này là một phần quan trọng của xã hội.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Etter min mening",
         "theo ý kiến của mình"
        ],
        [
         "dette mangfoldet",
         "sự đa dạng này"
        ],
        [
         "en viktig del av samfunnet",
         "một phần quan trọng của xã hội"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "For det første gir språk mennesker tilhørighet.",
       "alumno": "Trước hết, ngôn ngữ mang lại sự gắn bó cho con người.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "For det første",
         "trước hết"
        ],
        [
         "gir språk",
         "ngôn ngữ mang lại"
        ],
        [
         "mennesker tilhørighet",
         "sự gắn bó cho con người"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "På den andre siden kan ulike dialekter være vanskelige å forstå.",
       "alumno": "Mặt khác, hiểu những phương ngữ không đồng nhất thì thường khó hơn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "På den andre siden",
         "mặt khác"
        ],
        [
         "ulike dialekter",
         "những phương ngữ không đồng nhất"
        ],
        [
         "være vanskelige å forstå",
         "thường khó hiểu"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Likevel bør vi lytte og spørre når vi ikke forstår.",
       "alumno": "Dù vậy, bên mình nên lắng nghe và hỏi khi không hiểu.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Likevel bør vi",
         "dù vậy bên mình nên"
        ],
        [
         "lytte og spørre",
         "lắng nghe và hỏi"
        ],
        [
         "når vi ikke forstår",
         "khi không hiểu"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Avslutningsvis mener jeg at språklig variasjon bør beskyttes.",
       "alumno": "Để kết thúc, mình cho rằng sự biến đổi ngôn ngữ cần được bảo vệ.",
       "literal": "",
