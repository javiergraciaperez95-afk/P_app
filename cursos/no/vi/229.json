       "quien": {
        "texto": "Emil",
        "lengua": "estudio"
       },
       "estudio": "Men plattformansvar omfatter også moderering.",
       "alumno": "Nhưng trách nhiệm của nền tảng cũng bao gồm kiểm duyệt.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "plattformansvar",
         "trách nhiệm của nền tảng"
        ],
        [
         "moderering",
         "kiểm duyệt"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nora",
        "lengua": "estudio"
       },
       "estudio": "Innholdet bør ikke eksponeres bare fordi det deles raskt.",
       "alumno": "Nội dung không nên bị phơi bày chỉ vì được chia sẻ nhanh.",
