     "titulo": "Vì sao mình thấy nội dung này?",
     "frases": [
      {
       "quien": {
        "texto": "Nora",
        "lengua": "estudio"
       },
       "estudio": "Anbefalingssystemet bygger på aktiviteten min.",
       "alumno": "Hệ thống gợi ý dựa trên hoạt động của mình.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "anbefalingssystemet",
         "hệ thống gợi ý"
        ],
        [
         "aktiviteten min",
         "hoạt động của mình"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Emil",
        "lengua": "estudio"
       },
       "estudio": "Ja, personalisering kan gjøre innholdsstrømmen mer relevant.",
       "alumno": "Vâng, cá nhân hóa dễ làm dòng nội dung phù hợp hơn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "personalisering",
         "cá nhân hóa"
        ],
        [
         "innholdsstrømmen",
         "dòng nội dung"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nora",
        "lengua": "estudio"
       },
       "estudio": "Samtidig kan algoritmisk utvalg begrense synligheten til andre synspunkter.",
       "alumno": "Đồng thời, lựa chọn theo thuật toán dễ giới hạn khả năng hiển thị của những quan điểm còn lại.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "algoritmisk utvalg",
         "lựa chọn theo thuật toán"
        ],
        [
         "synligheten",
         "khả năng hiển thị"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Emil",
        "lengua": "estudio"
       },
       "estudio": "Plattformens inntektsmodell kan påvirke hvilke innlegg som får rekkevidde.",
       "alumno": "Mô hình doanh thu của nền tảng dễ ảnh hưởng đến bài đăng nào được lan truyền.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "inntektsmodell",
         "mô hình doanh thu"
        ],
        [
         "rekkevidde",
         "phạm vi tiếp cận"
