       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nora",
        "lengua": "estudio"
       },
       "estudio": "Høyt engasjement kan gi et innlegg større spredning.",
       "alumno": "Mức tương tác cao dễ làm một bài đăng lan truyền rộng hơn.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
