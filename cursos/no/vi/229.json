 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Cá nhân hóa",
     "texto": [
      "Một **anbefalingssystem** đề xuất nội dung theo mô hình hoạt động của người dùng nền tảng. **personalisering** làm dòng nội dung phù hợp hơn, nhưng cũng dễ giới hạn những góc nhìn được thấy."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Lan truyền và trách nhiệm",
     "texto": [
      "**moderering** của nền tảng liên quan đến việc quản lý nội dung ra sao. **Rekkevidde** cho biết bao nhiêu người dễ tiếp xúc với nó."
     ],
     "tutora": ""
    }
   ]
  },
