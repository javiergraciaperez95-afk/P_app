   "etapa": "leer",
   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Kiểm tra một bức ảnh",
     "frases": [
      {
       "quien": {
        "texto": "Journalist",
        "lengua": "estudio"
       },
       "estudio": "En melding hevder at dette bildet viser en hendelse i dag.",
       "alumno": "Một tin nhắn khẳng định rằng bức ảnh này cho thấy một sự việc hôm nay.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "En melding hevder",
         "một tin nhắn khẳng định"
        ],
        [
         "dette bildet viser",
         "bức ảnh này cho thấy"
        ],
        [
         "en hendelse i dag",
         "một sự việc hôm nay"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Redaktør",
        "lengua": "estudio"
       },
       "estudio": "Ifølge bildeteksten er bildet datert for fem år siden.",
       "alumno": "Theo chú thích ảnh, bức ảnh được ghi ngày cách đây năm năm.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Ifølge bildeteksten",
         "theo lời ghi ảnh"
        ],
        [
         "er bildet datert",
         "bức ảnh được ghi ngày"
        ],
        [
         "for fem år siden",
         "cách đây năm năm"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Journalist",
        "lengua": "estudio"
       },
       "estudio": "Da mangler bildet viktig kontekst.",
       "alumno": "Vậy bức ảnh thiếu bối cảnh quan trọng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Da mangler bildet",
         "vậy bức ảnh thiếu"
        ],
        [
         "viktig kontekst",
         "bối cảnh quan trọng"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Redaktør",
        "lengua": "estudio"
       },
       "estudio": "Ja. Påstanden er villedende, men bildet er ikke manipulert.",
       "alumno": "Đúng vậy. Khẳng định đó gây hiểu lầm, nhưng bức ảnh không bị thao túng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Påstanden er villedende",
         "khẳng định đó gây hiểu lầm"
        ],
        [
         "bildet er ikke manipulert",
         "bức ảnh không bị thao túng"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Journalist",
        "lengua": "estudio"
       },
       "estudio": "Vi må faktasjekke meldingen før ryktet spres.",
       "alumno": "Bên mình cần kiểm chứng tin nhắn trước khi tin đồn được lan truyền.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Vi må faktasjekke meldingen",
         "bên mình cần kiểm chứng tin nhắn"
        ],
        [
         "før ryktet spres",
         "trước khi tin đồn được lan truyền"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Redaktør",
        "lengua": "estudio"
       },
       "estudio": "Hun sa at hun hadde sett bildet før.",
       "alumno": "Cô ấy đã kể rằng trước đó đã thấy bức ảnh.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Hun sa",
         "cô ấy đã kể"
        ],
        [
         "at hun hadde sett bildet før",
         "rằng trước đó đã thấy bức ảnh"
        ]
       ],
       "parrafo": 0
      }
     ]
