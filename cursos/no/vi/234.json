   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Lựa chọn ngôn ngữ",
     "texto": [
      "Một **vốn ngôn ngữ** là tập hợp những hình thức ngôn ngữ mà một người dùng được. **Chuyển mã** là luân phiên giữa những ngôn ngữ hoặc biến thể tùy theo tình huống."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Thái độ và địa vị",
     "texto": [
      "Một **thái độ ngôn ngữ** là ý kiến hay đánh giá về một kiểu nói. Những thái độ này dễ ảnh hưởng đến việc người ta nhìn nhận phương ngữ và xã hội ngữ."
     ],
     "tutora": ""
    }
   ]
  },
