    {
     "tipo": "explicacion",
     "titulo": "Chuẩn bị cho một buổi phỏng vấn",
     "texto": [
      "**Arbeidsintervju** là buổi phỏng vấn xin việc. Để trả lời, hãy mô tả một tình huống cụ thể, bạn đã làm gì và kết quả ra sao. Như vậy bạn chứng minh được phẩm chất của mình bằng ví dụ."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Nói về điểm mạnh",
     "texto": [
      "**Styrke** là điểm mạnh; **utfordring**, thử thách. **Å være vant til å** nghĩa là quen làm việc gì đó."
     ],
     "tutora": ""
    }
   ]
