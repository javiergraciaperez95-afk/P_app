      {
       "quien": {
        "texto": "Utleier",
        "lengua": "estudio"
       },
       "estudio": "Det er to soverom og en lys stue.",
       "alumno": "Có hai phòng ngủ và một phòng khách sáng sủa.",
       "literal": "",
       "estructura": "",
       "nota": [],
