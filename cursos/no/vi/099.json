       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Eva",
        "lengua": "alumno"
       },
       "estudio": "Er leiligheten rolig om kvelden?",
       "alumno": "Buổi tối căn hộ có yên tĩnh không?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Utleier",
        "lengua": "estudio"
       },
       "estudio": "Ja, den ligger i en rolig gate nær parken.",
       "alumno": "Vâng, nó nằm trên con phố yên tĩnh gần công viên.",
       "literal": "",
       "estructura": "",
       "nota": [],
