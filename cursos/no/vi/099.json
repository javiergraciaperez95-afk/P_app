       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Eva",
        "lengua": "alumno"
       },
       "estudio": "Er strøm inkludert i husleia?",
       "alumno": "Tiền điện đã được tính trong tiền thuê không?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Utleier",
        "lengua": "estudio"
       },
       "estudio": "Nei, strøm betales separat.",
       "alumno": "Không, tiền điện trả riêng.",
