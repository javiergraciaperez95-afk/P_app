      {
       "quien": {
        "texto": "Linn",
        "lengua": "estudio"
       },
       "estudio": "Fellesarealet trenger en rask vask. Kan vi lage en enkel turnus?",
       "alumno": "Khu vực chung cần được lau dọn nhanh. Mình lập một lịch phân công đơn giản được không?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Pavel",
        "lengua": "estudio"
       },
       "estudio": "Gjerne. Jeg kan støvsuge på tirsdag, men jeg rekker ikke å handle såpe.",
       "alumno": "Được thôi. Mình hút bụi được vào thứ Ba, nhưng không kịp mua xà phòng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Linn",
        "lengua": "estudio"
       },
       "estudio": "Det går fint. Jeg kjøper såpe. Kan du ta ut søpla på torsdag også?",
       "alumno": "Không sao. Mình mua xà phòng. Bạn cũng đổ rác vào thứ Năm được không?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Pavel",
        "lengua": "estudio"
       },
       "estudio": "Ja, hvis du tar oppvasken etter middagen på fredag.",
       "alumno": "Được, nếu bạn rửa chén sau bữa tối thứ Sáu.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Linn",
        "lengua": "estudio"
       },
       "estudio": "Avtale. Da skriver jeg oppgavene på tavla.",
       "alumno": "Thống nhất. Vậy mình ghi việc lên bảng.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
