   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Biên bản viết của một cuộc họp",
     "texto": [
      "Một **referat** ghi lại những gì được bàn và thỏa thuận. Một **protokoll** ghi nhận những quyết định hình thức.",
      "Mỗi **oppfølgingspunkt** cần một người chịu trách nhiệm và một thời hạn."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Diễn đạt rõ ràng",
     "texto": [
      "Phân biệt giữa đề xuất, quyết định và phản đối. Nếu bất đồng, biên bản ghi lại được điều đó mà không trình bày như một quyết định."
     ],
     "tutora": ""
    }
   ]
  },
