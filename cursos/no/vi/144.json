   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Mô tả học vấn",
     "texto": [
      "**Utdanningsbakgrunn** là quá trình học mà một người đã theo. **Fagbrev** là chứng chỉ nghề của Na Uy; **vitnemål** là bằng hoặc bảng điểm. **Yrkesfaglig** mô tả đào tạo nghề."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Công nhận bằng cấp",
     "texto": [
      "**Godkjenning** là công nhận chính thức. Để nộp đơn, cần tài liệu chứng minh bạn đã học gì, học trong bao lâu và đạt trình độ nào."
     ],
     "tutora": ""
    }
   ]
  },
