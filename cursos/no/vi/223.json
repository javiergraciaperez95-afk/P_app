     "tipo": "dialogo",
     "titulo": "Cuộc họp của đội học tập",
     "frases": [
      {
       "quien": {
        "texto": "Sara",
        "lengua": "estudio"
       },
       "estudio": "Vi har to forslag til leserommet.",
       "alumno": "Bên mình đưa ra hai đề xuất cho phòng đọc.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Emil",
        "lengua": "estudio"
       },
       "estudio": "Nye lamper koster mindre enn nye stoler.",
       "alumno": "Đèn mới tốn ít hơn ghế mới.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Sara",
        "lengua": "estudio"
       },
       "estudio": "Stolene kan gjøre rommet tilgjengelig for flere.",
       "alumno": "Ghế giúp phòng dễ tiếp cận hơn với nhiều người.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Emil",
        "lengua": "estudio"
       },
       "estudio": "På kort sikt har vi bare råd til ett forslag.",
       "alumno": "Trong ngắn hạn, bên mình chỉ đủ khả năng tài chính cho một đề xuất.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Sara",
        "lengua": "estudio"
       },
       "estudio": "Da bør vi sammenligne nytten og kostnaden.",
       "alumno": "Vậy bên mình nên so sánh tiện ích và chi phí.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Emil",
        "lengua": "estudio"
       },
       "estudio": "Enig. Vi kan støtte lampene nå og planlegge stolene senere.",
       "alumno": "Đồng ý. Bên mình ưu tiên đèn bây giờ và lên kế hoạch cho ghế sau này.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
