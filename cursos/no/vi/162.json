       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Mange snakker dialekt også på jobb.",
       "alumno": "Nhiều người cũng dùng phương ngữ ở nơi làm việc.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Mange snakker dialekt",
         "nhiều người dùng phương ngữ"
        ],
        [
         "også på jobb",
         "ngay cả ở nơi làm việc"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Dialektene kan være ulike, men folk forstår hverandre.",
       "alumno": "Phương ngữ thì không đồng nhất, nhưng người ta vẫn hiểu nhau.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Dialektene kan være ulike",
         "phương ngữ thì không đồng nhất"
        ],
        [
         "folk forstår hverandre",
         "người ta vẫn hiểu nhau"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Språklig mangfold er en del av kulturarven.",
       "alumno": "Sự đa dạng ngôn ngữ là một phần của di sản văn hóa.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
