     "tipo": "texto",
     "titulo": "Ngôn ngữ ở Na Uy",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Norge har to norske skriftspråk: bokmål og nynorsk.",
       "alumno": "Na Uy sử dụng hai chuẩn viết: bokmål và nynorsk.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Norge har",
         "Na Uy sử dụng"
        ],
