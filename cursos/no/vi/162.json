         "Språklig mangfold",
         "sự đa dạng ngôn ngữ"
        ],
        [
         "er en del av kulturarven",
         "là một phần của di sản văn hóa"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Ulike uttaler og dialektord viser variasjon i språket.",
       "alumno": "Những lối đọc và từ phương ngữ đa dạng cho thấy sự biến đổi của ngôn ngữ.",
       "literal": "",
       "estructura": "",
