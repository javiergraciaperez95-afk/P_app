         "to norske skriftspråk",
         "hai chuẩn viết"
        ],
        [
         "bokmål og nynorsk",
         "bokmål và nynorsk"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Samisk er et samlebegrep for flere språk.",
       "alumno": "Sámi là một thuật ngữ chung cho nhiều ngôn ngữ.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Samisk er",
         "sámi là"
        ],
        [
         "et samlebegrep",
