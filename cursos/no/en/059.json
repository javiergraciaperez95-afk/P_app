   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Delay announcements",
     "texto": [
      "**Forsinket** means «delayed» and **avlyst**, «cancelled». **I tide** means «on time».",
      "**På grunn av** introduces the cause: **forsinket på grunn av trafikken** («delayed because of the traffic»). The definite form **trafikken** is usually translated as «the traffic»."
     ],
     "tutora": ""
    }
   ]
