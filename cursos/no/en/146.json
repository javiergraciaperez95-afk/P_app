   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Simple past and present perfect",
     "texto": [
      "Use the simple past for a finished time: **Jeg studerte i fjor** («I studied last year»). Use **har + participle** for an experience with no specific date, or for a situation that continues: **Jeg har studert her i to år** («I've been studying here for two years»)."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Talking about studies",
     "texto": [
      "A **semester** is half of the academic year. **Studiepoeng** are credits; **forelesning**, a lecture; **innlevering**, an assignment that is handed in."
     ],
     "tutora": ""
    }
   ]
  },
