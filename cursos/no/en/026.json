   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Describing the weather",
     "texto": [
      "To talk about the weather, Norwegian usually uses the neutral subject det: Det regner («it rains»), Det snør («it is snowing»), Det er kaldt («it is cold»). English also uses an impersonal «it» here, as in «it rains».",
      "With a specific month, use i: i januar. For a season that happens regularly, use om and the definite noun: om vinteren («in winter»). In English both are usually translated as «in», but Norwegian uses two different words: i and om."
     ],
     "tutora": ""
    },
