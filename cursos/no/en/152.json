     "titulo": "Raising a concern",
     "frases": [
      {
       "quien": {
        "texto": "Arbeidstaker",
        "lengua": "estudio"
       },
       "estudio": "Jeg er bekymret for sikkerheten på arbeidsplassen.",
       "alumno": "I'm worried about safety at the workplace.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Jeg er bekymret for",
         "I'm worried about"
        ],
        [
         "sikkerheten",
         "safety"
        ],
        [
         "på arbeidsplassen",
         "at the workplace"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Verneombud",
        "lengua": "estudio"
       },
       "estudio": "Har du meldt fra om problemet?",
       "alumno": "Have you reported the problem?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Har du meldt fra",
         "have you reported"
        ],
        [
         "om problemet",
         "about the problem"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Arbeidstaker",
        "lengua": "estudio"
       },
       "estudio": "Ja, men arbeidsulykken ble ikke rapportert.",
       "alumno": "Yes, but the work accident wasn't reported.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "arbeidsulykken",
         "the work accident"
        ],
        [
         "ble ikke rapportert",
         "wasn't reported"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Verneombud",
        "lengua": "estudio"
       },
       "estudio": "Du får lov til å ta opp saken med lederen.",
       "alumno": "You have permission to raise the matter with the manager.",
       "literal": "",
