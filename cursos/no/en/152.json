        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Arbeidstaker",
        "lengua": "estudio"
       },
       "estudio": "Kan jeg få snakke med tillitsvalgt også?",
       "alumno": "Can I also speak to the workers' representative?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Kan jeg få snakke med",
         "can I speak to"
        ],
        [
         "tillitsvalgt også",
         "the representative as well"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Verneombud",
        "lengua": "estudio"
       },
       "estudio": "Ja. Sammen kan dere finne en løsning og forbedre arbeidsmiljøet.",
       "alumno": "Yes. Together you can find a solution and improve the work environment.",
