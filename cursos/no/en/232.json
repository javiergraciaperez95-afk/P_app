       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Maja",
        "lengua": "alumno"
       },
       "estudio": "Varslingsrutinen beskriver hvem som skal håndtere saken.",
       "alumno": "The procedure explains who must handle the case.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "varslingsrutinen",
         "the procedure"
        ],
        [
         "håndtere saken",
         "handle the case"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Maja",
        "lengua": "alumno"
       },
       "estudio": "En avviksrapport kan gjøre årsaken lettere å kartlegge.",
       "alumno": "An incident report can make it easier to identify the cause.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "avviksrapport",
         "incident report"
        ],
        [
         "kartlegge",
         "identify"
        ]
