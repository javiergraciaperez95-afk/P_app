 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Reporting irregularities",
     "texto": [
      "**Å varsle** means reporting a worrying or irregular situation. A **varslingsrutine** describes how the notice must be handled.",
      "An **avviksrapport** records a deviation or incident so that the workplace can investigate its cause and prevent it from happening again."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Follow-up",
     "texto": [
      "**Gjengjeldelse** means a negative reaction against the person who reports. The case must be handled safely and objectively."
     ],
     "tutora": ""
    }
   ]
  },
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "«En melding om et avvik» (a report of an incident)",
     "frases": [
      {
       "quien": {
        "texto": "Verneombud",
        "lengua": "estudio"
       },
       "estudio": "Verneombudet får en melding om et kritikkverdig forhold.",
       "alumno": "The health and safety representative receives a report about a questionable situation.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
