       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Maja",
        "lengua": "alumno"
       },
       "estudio": "Arbeidsmiljøutvalget ber om en risikovurdering.",
       "alumno": "The work environment committee requests a risk assessment.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "arbeidsmiljøutvalget",
         "the work environment committee"
        ],
        [
         "risikovurdering",
         "risk assessment"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Maja",
        "lengua": "alumno"
       },
       "estudio": "Tiltaksplanen skal forebygge at avviket gjentar seg.",
       "alumno": "The action plan should prevent the incident from being repeated.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "tiltaksplanen",
         "the action plan"
        ],
