  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Indirect speech",
     "texto": [
      "**Hun sa at bildet var gammelt** means «She said the picture was old». After **at**, the subject usually comes before the verb; the word order of a direct question is not kept."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Earlier past",
     "texto": [
      "**Hadde + participle** places an action before another past event: **Hun sa at hun hadde sett bildet før** («She said she had seen the picture before»)."
     ],
     "tutora": ""
    }
   ]
  },
