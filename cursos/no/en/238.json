 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Digital inclusion",
     "texto": [
      "**Digital inclusion** seeks to ensure that all people can use digital services. **Universal design** aims to make a solution accessible to as many people as possible."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Alternatives",
     "texto": [
      "If a service is only available in digital format, some people may encounter language barriers or lack the necessary skills. An alternative can reduce that exclusion."
     ],
     "tutora": ""
    }
   ]
  },
