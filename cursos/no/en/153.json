   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Checking the source",
     "texto": [
      "**Kildekritikk** means assessing whether a source is reliable before accepting or sharing information. Check who published it, when, and what evidence it offers."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Facts and opinions",
     "texto": [
      "**Fakta** are facts that can be checked; **mening** is an opinion. A **påstand** is a claim that still needs to be checked."
     ],
     "tutora": ""
    }
   ]
  },
