       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En antydning er ikke det samme som dokumentasjon.",
       "alumno": "An insinuation is not the same as documentary evidence.",
