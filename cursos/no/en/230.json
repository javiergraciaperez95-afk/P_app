    {
     "tipo": "texto",
     "titulo": "Two readers assess the same article",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Artikkelen viser til tre kilder, men dokumentasjonsgrunnlaget er ulikt.",
       "alumno": "The article cites three sources, but the documentary basis is uneven.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "viser til",
         "cites"
        ],
        [
         "dokumentasjonsgrunnlaget",
         "the documentary basis"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En leser mener at påstanden er etterprøvbar.",
       "alumno": "One reader thinks the claim is verifiable.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "mener at",
         "thinks that"
        ],
        [
         "etterprøvbar",
         "verifiable"
