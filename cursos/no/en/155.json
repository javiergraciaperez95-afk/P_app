 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Protecting personal data",
     "texto": [
      "**Personvern** is the protection of private life. **Personopplysning** is a piece of data that can identify a person. **Samtykke** is permission given voluntarily."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Using someone else's content",
     "texto": [
      "**Opphavsrett** protects original works. When you share a photo or text, respect the permission and mention who created it where appropriate."
     ],
     "tutora": ""
    }
   ]
  },
  {
