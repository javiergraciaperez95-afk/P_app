  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "The past of other regular verbs",
     "texto": [
      "Many verbs ending in **-ere** form the past with **-erte**: studere → studerte («to study → studied»). Others add **-de**: øve → øvde («to practise → practised»). These endings depend on the verb, so it is best to learn them together with the past form."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Questions in the past",
     "texto": [
      "The verb also comes first in a yes/no question: **Studerte du i går?** If the question starts with a question word, the verb comes after it: **Hva lærte du?**"
     ],
     "tutora": ""
    }
   ]
  },
