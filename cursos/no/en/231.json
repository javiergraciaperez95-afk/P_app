   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Negotiations in the workplace",
     "texto": [
      "**Tariffavtale** is a collective agreement between employee representatives and employers. It can regulate wages and working hours.",
      "**Medbestemmelse** means that workers take part in decisions that affect their work."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Conditions and changes",
     "texto": [
      "A **drøftingsmøte** is a meeting in which the parties can exchange views before making a decision. Proposals must be assessed in line with the terms of the agreement."
     ],
     "tutora": ""
    }
   ]
  },
