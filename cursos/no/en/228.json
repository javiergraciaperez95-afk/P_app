        "lengua": "estudio"
       },
       "estudio": "Sitatkontroll kan avdekke feil før publisering.",
       "alumno": "Quote checking can uncover errors before publication.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "sitatkontroll",
         "quote checking"
        ],
        [
