    {
     "tipo": "dialogo",
     "titulo": "What goes into a news story?",
     "frases": [
      {
       "quien": {
        "texto": "Redaktør",
        "lengua": "estudio"
       },
       "estudio": "Redaksjonell linje kan påvirke hvilke saker avisen velger.",
       "alumno": "The editorial line can influence which issues the newspaper chooses.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
