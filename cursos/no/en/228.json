      },
      {
       "quien": {
        "texto": "Reporter",
        "lengua": "estudio"
       },
       "estudio": "En tydelig vinkling kan komme fram gjennom bildebruk.",
       "alumno": "A clear angle can come across through the use of images.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
