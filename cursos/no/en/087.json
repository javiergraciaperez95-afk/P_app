   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Giving an opinion",
     "texto": [
      "**Synes** already appears at the previous level to express a personal opinion. **Jeg tror** usually expresses what one believes or hopes is true. In English, «I think» can serve for both meanings."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Showing agreement",
     "texto": [
      "**Enig** means «in agreement»; **uenig**, «in disagreement». To soften the disagreement, you can say **Jeg er ikke helt enig** («I'm not completely in agreement»)."
     ],
     "tutora": ""
    }
   ]
  },
