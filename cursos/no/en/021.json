   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Pointing at something and buying it",
     "texto": [
      "Denne («this») is used with a singular common-gender noun; dette, with a neuter one; disse, in the plural. For distant objects, den, det and de are used.",
      "After the demonstrative, the noun takes the definite form: denne jakka («this jacket»), dette skjerfet («this scarf»), disse skoene («these shoes»). Unlike English «this jacket», where the noun does not change, Norwegian adds a definite ending to the noun."
     ],
     "tutora": ""
    },
