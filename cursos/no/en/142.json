 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Naming the partner",
     "texto": [
      "**Samboer** is a cohabiting partner who isn't necessarily married; **ektefelle** is spouse. **Likestilling** means equality of rights and opportunities."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Connectors in couples",
     "texto": [
      "**Både ... og** means «both ... and»; **verken ... eller**, «neither ... nor». With **verken ... eller**, the negation is inside the expression, so no other negation is added."
     ],
     "tutora": ""
    }
   ]
  },
