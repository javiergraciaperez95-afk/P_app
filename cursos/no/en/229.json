     "tipo": "dialogo",
     "titulo": "Why do we see this content?",
     "frases": [
      {
       "quien": {
        "texto": "Nora",
        "lengua": "estudio"
       },
       "estudio": "Anbefalingssystemet bygger på aktiviteten min.",
       "alumno": "The recommendation system is based on my activity.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "anbefalingssystemet",
         "the recommendation system"
        ],
        [
         "aktiviteten min",
         "my activity"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Emil",
        "lengua": "estudio"
       },
       "estudio": "Ja, personalisering kan gjøre innholdsstrømmen mer relevant.",
       "alumno": "Yes, personalisation can make the content stream more relevant.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "personalisering",
         "personalisation"
        ],
        [
         "innholdsstrømmen",
         "the content stream"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nora",
        "lengua": "estudio"
       },
       "estudio": "Samtidig kan algoritmisk utvalg begrense synligheten til andre synspunkter.",
       "alumno": "At the same time, algorithmic selection can limit the visibility of other points of view.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "algoritmisk utvalg",
         "algorithmic selection"
        ],
        [
         "synligheten",
         "the visibility"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Emil",
        "lengua": "estudio"
       },
       "estudio": "Plattformens inntektsmodell kan påvirke hvilke innlegg som får rekkevidde.",
       "alumno": "The platform's revenue model can influence which posts reach people.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "inntektsmodell",
         "revenue model"
        ],
        [
         "rekkevidde",
         "reach"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nora",
        "lengua": "estudio"
       },
       "estudio": "Høyt engasjement kan gi et innlegg større spredning.",
       "alumno": "High engagement can give a post wider spread.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "engasjement",
         "engagement"
        ],
        [
         "spredning",
         "spread"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Emil",
        "lengua": "estudio"
       },
       "estudio": "Men plattformansvar omfatter også moderering.",
       "alumno": "But platform responsibility also includes moderation.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "plattformansvar",
         "platform responsibility"
        ],
        [
         "moderering",
         "moderation"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nora",
        "lengua": "estudio"
       },
       "estudio": "Innholdet bør ikke eksponeres bare fordi det deles raskt.",
       "alumno": "Content should not be exposed just because it is shared quickly.",
       "literal": "",
       "estructura": "",
       "nota": [],
