   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Selective reading of a policy",
     "texto": [
      "Look for the verbs that explain what the service does: **samles inn** («is collected»), **lagres** («is stored») and **deles** («is shared»). Then look for purpose, duration and options. The passive voice can leave out who carries out the action; check the context."
     ],
     "tutora": ""
    }
   ]
