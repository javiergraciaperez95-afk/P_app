   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "General guarantees",
     "texto": [
      "**Rettssikkerhet** is protection against arbitrary decisions. **Uskyldspresumsjon** means that a person must be considered innocent until their guilt is proven.",
      "**Upartisk** means impartial; **uavhengig**, independent."
     ],
     "tutora": ""
    }
   ]
  },
