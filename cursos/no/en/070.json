   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Simple past or present perfect",
     "texto": [
      "Compare **Jeg så filmen i går** («I saw the film yesterday») with **Jeg har sett filmen** («I have seen the film»). With a specific past time, such as **i går** or **i fjor**, use the simple past. For an experience with no specific date, use **har + past participle**."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Irregular past participles",
     "texto": [
      "Some more: **ta → tatt**, **gå → gått**, **skrive → skrevet**, **prøve → prøvd**, **finne → funnet**, **begynne → begynt** and **drikke → drukket**. The past participle is not always formed by adding a regular ending."
     ],
     "tutora": ""
    },
    {
     "tipo": "tabla",
     "titulo": "Which tense do I use?",
