   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Giving directions",
     "texto": [
      "**Gå rett fram** means «go straight ahead». **Ta til høyre/venstre** means «turn right/left». **Ved siden av** means «next to»."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Asking about distance",
     "texto": [
      "**Er det langt herfra?** means «Is it far from here?». **Til fots** is «on foot» and **omtrent** means «approximately»."
     ],
     "tutora": ""
    }
   ]
  },
