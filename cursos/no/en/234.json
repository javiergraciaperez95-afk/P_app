   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Language choices",
     "texto": [
      "A **linguistic repertoire** is the set of language forms a person can use. **Code-switching** is switching between languages or varieties depending on the situation."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Attitudes and status",
     "texto": [
      "A **language attitude** is an opinion or judgement about a way of speaking. These attitudes can influence how dialects and sociolects are perceived."
     ],
     "tutora": ""
    }
   ]
  },
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "Choosing a language in different situations",
     "frases": [
      {
       "quien": {
        "texto": "Nils",
        "lengua": "alumno"
       },
       "estudio": "Jeg har et bredt språklig repertoar.",
       "alumno": "I have a broad linguistic repertoire.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "bredt språklig repertoar",
         "broad linguistic repertoire"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Rana",
        "lengua": "alumno"
       },
       "estudio": "Da kan du bruke ulike språkvarianter etter situasjonen.",
       "alumno": "So you can use different language varieties depending on the situation.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "ulike språkvarianter",
         "different language varieties"
        ],
        [
         "etter situasjonen",
         "depending on the situation"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nils",
        "lengua": "alumno"
       },
       "estudio": "Ja, kodeveksling er vanlig i et flerspråklig miljø.",
       "alumno": "Yes, code-switching is common in a multilingual environment.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "kodeveksling",
         "code-switching"
        ],
        [
         "flerspråklig miljø",
         "multilingual environment"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Rana",
        "lengua": "alumno"
       },
       "estudio": "Noen mener at standardtalemål gir høyere status.",
       "alumno": "Some people think standard speech gives more status.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "standardtalemål",
         "standard speech"
        ],
        [
         "høyere status",
         "more status"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nils",
        "lengua": "alumno"
       },
       "estudio": "Slike språkholdninger kan skape en statusforskjell mellom dialekter.",
       "alumno": "Those language attitudes can create a status difference between dialects.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "språkholdninger",
         "language attitudes"
        ],
        [
         "statusforskjell",
         "status difference"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Rana",
        "lengua": "alumno"
       },
       "estudio": "Dialektutjevning betyr ikke nødvendigvis at dialektene forsvinner.",
       "alumno": "Dialect levelling does not necessarily mean that dialects disappear.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "dialektutjevning",
         "dialect levelling"
        ],
        [
         "ikke nødvendigvis",
         "not necessarily"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nils",
        "lengua": "alumno"
       },
       "estudio": "Språkpraksis kan også uttrykke tilhørighet.",
       "alumno": "Language practice can also express belonging.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "språkpraksis",
         "language practice"
        ],
        [
         "tilhørighet",
         "belonging"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
