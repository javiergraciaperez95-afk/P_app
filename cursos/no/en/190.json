      },
      {
       "quien": {
        "texto": "Koordinator",
        "lengua": "estudio"
       },
       "estudio": "Det kan vi undersøke. På tirsdager må møtet slutte før klokka ti.",
       "alumno": "We can check that. On Tuesdays the meeting must end before ten.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Deltaker",
        "lengua": "estudio"
       },
       "estudio": "Da kan vi holde møtet fra ni til halv ti.",
       "alumno": "Then we can hold the meeting from nine to half past nine.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Koordinator",
        "lengua": "estudio"
       },
       "estudio": "Det passer. Jeg sender en oppdatert invitasjon.",
       "alumno": "That suits me. I'll send an updated invitation.",
       "literal": "",
