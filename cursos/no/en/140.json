       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "De andre lytter til forslaget og diskuterer det.",
       "alumno": "The others listen to the proposal and discuss it.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
