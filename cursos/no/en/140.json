     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Beboerne ønsker en møteplass der de kan snakke sammen.",
       "alumno": "The residents want a meeting place where they can talk together.",
       "literal": "",
       "estructura": "",
       "nota": [],
