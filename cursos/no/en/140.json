         "der de kan snakke sammen",
         "where they can talk together"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Styret har et møte på torsdag.",
       "alumno": "The board has a meeting on Thursday.",
