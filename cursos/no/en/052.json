   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Ingredients and quantities",
     "texto": [
      "**Oppskrift** means «recipe». In Norwegian, measures are usually followed by the name of the ingredient without an article: **to desiliter vann** («two decilitres of water»).",
      "**En halv** means «half», and **litt** expresses a small amount; it works like English «a little salt», with no «of»."
     ],
     "tutora": ""
    }
   ]
  },
