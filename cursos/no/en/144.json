   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Describing studies",
     "texto": [
      "**Utdanningsbakgrunn** is the education a person has received. **Fagbrev** is a Norwegian professional certificate; **vitnemål** is a certificate or academic transcript. **Yrkesfaglig** describes vocational training."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Recognising qualifications",
     "texto": [
      "**Godkjenning** is official recognition. To apply for it, you may need documentation showing what you studied, for how long and what qualification you obtained."
     ],
     "tutora": ""
    }
   ]
  },
