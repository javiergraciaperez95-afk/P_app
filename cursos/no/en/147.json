   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Information in an advert",
     "texto": [
      "**Stillingsannonse** is a job advert. It can state the **arbeidsoppgaver** (tasks), the **arbeidssted** (workplace), the hours and the qualities they are looking for."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Describing qualities",
     "texto": [
      "**Pålitelig** means reliable; **selvstendig**, able to work on one's own. **Samarbeidsevne** is the ability to collaborate with other people."
     ],
     "tutora": ""
    }
   ]
  },
