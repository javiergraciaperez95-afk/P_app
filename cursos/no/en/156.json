 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Cause and effect",
     "texto": [
      "**Klimaendring** is a lasting change in the climate. **Klimagass** is a gas that contributes to warming; **forurensning**, pollution. **Konsekvens** is the result of a cause."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "«Fordi» and «derfor»",
     "texto": [
      "**Fordi** introduces the cause with the normal order: **Fordi temperaturen stiger, smelter isen** («As the temperature rises, the ice melts»). **Derfor** introduces the result and, if it comes first, the verb goes before the subject: **Derfor stiger havet** («That's why the sea rises»)."
     ],
     "tutora": ""
    }
   ]
  },
