         "what do you want to know"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Mina",
        "lengua": "estudio"
       },
       "estudio": "Ligger vaskerommet i samme etasje?",
       "alumno": "Is the laundry room on the same floor?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Ligger vaskerommet",
         "is the laundry room"
        ],
        [
