      },
      {
       "quien": {
        "texto": "Utleier",
        "lengua": "estudio"
       },
       "estudio": "Det er roligere om kvelden, men du kan undersøke det selv.",
       "alumno": "It's quieter in the evening, but you can check it yourself.",
