        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Utleier",
        "lengua": "estudio"
       },
       "estudio": "Ja, og det finnes en heis. Balkongen er også ganske stor.",
       "alumno": "Yes, and there's a lift. The balcony is also quite big.",
       "literal": "",
