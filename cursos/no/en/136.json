  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Asking about a flat",
     "texto": [
      "**Visning** is a viewing of a property before renting it. **Fellesområde** is a shared area; **vaskerom**, a laundry room; **etasje**, a floor of a building."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Describing problems",
     "texto": [
      "**Fukt** means damp and **fuktig**, damp or humid. **Støy** is noise. To ask about a specific condition, you can use **Er det ...?** or **Er ... inkludert?**"
     ],
     "tutora": ""
    }
   ]
  },
  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "dialogo",
     "titulo": "A visit with the landlady",
     "frases": [
      {
       "quien": {
        "texto": "Mina",
        "lengua": "estudio"
       },
       "estudio": "Takk for visningen. Kan jeg spørre om noen ting?",
       "alumno": "Thanks for showing me the flat. Can I ask you a few questions?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Takk for visningen",
         "thanks for the viewing"
        ],
        [
         "Kan jeg spørre",
         "can I ask"
        ],
        [
         "om noen ting",
         "about a few things"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Utleier",
        "lengua": "estudio"
       },
       "estudio": "Selvfølgelig. Hva vil du vite?",
       "alumno": "Of course. What do you want to know?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
