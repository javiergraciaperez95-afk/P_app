        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Mina",
        "lengua": "estudio"
       },
       "estudio": "Jeg merker litt støy fra trafikken. Er det alltid så mye støy?",
       "alumno": "I notice a bit of noise from the traffic. Is there always this much noise?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
