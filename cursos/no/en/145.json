 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Indirect questions",
     "texto": [
      "**Jeg lurer på om ...** («I'd like to know if…») introduces an indirect question. Inside it, the subject comes before the verb: **Jeg lurer på om dere trenger flere dokumenter** («I'd like to know whether you need more documents»). The direct question order is not used."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Requesting information",
     "texto": [
      "**Behandlingstid** is the time an application takes. **Saksbehandler** is the person who processes it. **Bekreftet kopi** is a certified copy."
     ],
     "tutora": ""
    }
   ]
  },
