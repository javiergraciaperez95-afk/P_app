       "quien": {
        "texto": "Student",
        "lengua": "estudio"
       },
       "estudio": "En person er tiltalt for et lovbrudd.",
       "alumno": "A person is charged with an offence.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "tiltalt for",
         "charged with"
        ],
        [
         "lovbrudd",
         "offence"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Lærer",
        "lengua": "estudio"
       },
       "estudio": "Hvilke bevis blir lagt fram?",
       "alumno": "What evidence is presented?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "bevis",
         "evidence"
        ],
        [
         "blir lagt fram",
         "is presented"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Student",
        "lengua": "estudio"
       },
       "estudio": "Et vitne skal forklare seg.",
       "alumno": "A witness is going to give evidence.",
       "literal": "",
