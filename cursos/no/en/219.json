      {
       "quien": {
        "texto": "Lærer",
        "lengua": "estudio"
       },
       "estudio": "Hvem er tiltalt?",
       "alumno": "Who is the defendant?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Hvem er",
         "who is"
        ],
        [
         "tiltalt",
         "accused"
