       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Lærer",
        "lengua": "estudio"
       },
       "estudio": "Domstolen vurderer forklaringene før den avsier dom.",
       "alumno": "The court weighs the statements before passing sentence.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
