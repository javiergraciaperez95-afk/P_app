     "titulo": "A parcel without a label",
     "frases": [
      {
       "quien": {
        "texto": "Shift supervisor",
        "lengua": "alumno"
       },
       "estudio": "Hva skjedde med esken på lageret?",
       "alumno": "What happened to the box in the warehouse?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Tomas",
        "lengua": "alumno"
       },
       "estudio": "Jeg oppdaget den ved døren klokka ni. Etiketten manglet.",
       "alumno": "I found it by the door at nine. The label was missing.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Shift supervisor",
        "lengua": "alumno"
       },
       "estudio": "Sa noen hvor den skulle stå?",
       "alumno": "Did anyone say where it should be?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Tomas",
        "lengua": "alumno"
       },
       "estudio": "Mira sa at esken skulle til rom tre. Jeg foreslår at vi kontrollerer innholdet først.",
       "alumno": "Mira said the box was supposed to go to room three. I suggest we check the contents first.",
       "literal": "",
       "estructura": "",
       "nota": [],
