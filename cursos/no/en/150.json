   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Working conditions",
     "texto": [
      "**Arbeidstaker** is an employee. **Arbeidsvilkår** includes hours, pay, holidays and other conditions. A **tariffavtale** is a collective agreement on working conditions."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Rights and duties",
     "texto": [
      "**Rettighet** is a right; **plikt**, a duty. **Tillitsvalgt** is a representative elected by the workers; **verneombud**, the person representing workplace safety."
     ],
     "tutora": ""
    }
   ]
  },
