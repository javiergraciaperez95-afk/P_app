     "titulo": "A question about the packaging",
     "frases": [
      {
       "quien": {
        "texto": "Customer",
        "lengua": "alumno"
       },
       "estudio": "Hei. Jeg har hoste og vil gjerne lese bruksanvisningen.",
       "alumno": "Hi. I have a cough and would like to read the instructions.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Pharmacist",
        "lengua": "alumno"
       },
       "estudio": "Her står det hvordan produktet skal brukes. Har du spørsmål om doseringen?",
       "alumno": "Here it says how the product should be used. Do you have questions about the dose?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Customer",
        "lengua": "alumno"
       },
       "estudio": "Ja. Kan du forklare doseringen på pakningen?",
       "alumno": "Yes. Can you explain the dose on the packaging?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Pharmacist",
        "lengua": "alumno"
       },
       "estudio": "Jeg kan lese det sammen med deg. Fortell meg også hvis du bruker andre legemidler.",
       "alumno": "I can read it with you. Also tell me if you take any other medicines.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
