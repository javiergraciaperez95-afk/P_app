 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "How «all» changes with the noun",
     "texto": [
      "**Alle** goes with people or plural nouns (**alle foreldrene**, all the parents). **Alt** goes with neuter nouns or is used alone (**alt arbeidet**, all the work). **All** goes with singular common nouns."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Entire: «hel», «helt», «hele»",
     "texto": [
      "**Hel** agrees with a common noun; **helt**, with a neuter one; **hele**, with the definite form: **hele familien**, the whole family. These words don't always match the same English «whole»."
     ],
     "tutora": ""
    }
   ]
  },
