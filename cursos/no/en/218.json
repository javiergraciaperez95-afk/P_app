         "apt and convincing"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En svakhet er at avslutningen kommer brått.",
       "alumno": "A weak point is that the ending comes suddenly.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "En svakhet",
         "a weak point"
        ],
        [
         "avslutningen kommer brått",
