     "titulo": "Meetings always shorter?",
     "frases": [
      {
       "quien": {
        "texto": "Edda",
        "lengua": "estudio"
       },
       "estudio": "Alle møter bør vare maksimalt tretti minutter.",
       "alumno": "All meetings should last at most thirty minutes.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nils",
        "lengua": "alumno"
       },
       "estudio": "Et moteksempel er planleggingsmøtet før festivalen. Det tok en time, men avklarte mange oppgaver.",
       "alumno": "A counterexample is the planning meeting before the festival. It lasted an hour, but it clarified many tasks.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Edda",
        "lengua": "estudio"
       },
       "estudio": "Det er sant. Jeg vil nyansere påstanden: korte møter passer for enkle saker.",
       "alumno": "That's true. I'll qualify my claim: short meetings suit simple matters.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Nils",
        "lengua": "alumno"
       },
       "estudio": "Og lengre møter bør ha en tydelig saksliste.",
       "alumno": "And longer meetings should have a clear agenda.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [],
       "parrafo": 0
      }
     ]
    }
   ]
