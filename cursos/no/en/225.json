   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Institutions and agreements",
     "texto": [
      "**Bilateral** cooperation takes place between two parties; **multilateral** cooperation includes several countries.",
      "A **treaty** is a formal agreement. By joining it, countries take on obligations."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Negotiations",
     "texto": [
      "**Suverenitet** refers to a country's right to govern itself. Even so, international agreements may require shared rules and responsibilities."
     ],
     "tutora": ""
    }
   ]
  },
