   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Talking about transport",
     "texto": [
      "To ask which bus to take, you can say Hvilken buss går til …? («Which bus goes to …?»). Ta buss means «go by bus»; bytte buss means «change buses».",
      "The stop can be called stopp or bussholdeplass. Neste means «next» and appears in directions such as gå av ved neste stopp («get off at the next stop»)."
     ],
     "tutora": ""
    },
