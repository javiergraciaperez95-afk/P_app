     "tipo": "texto",
     "titulo": "A view on languages",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Innledning: Norge har flere språk og dialekter.",
       "alumno": "Introduction: Norway has several languages and dialects.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Innledning",
         "introduction"
        ],
        [
         "Norge har flere språk og dialekter",
         "Norway has several languages and dialects"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Etter min mening er dette mangfoldet en viktig del av samfunnet.",
       "alumno": "In my opinion, this diversity is an important part of society.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Etter min mening",
         "in my opinion"
        ],
        [
         "dette mangfoldet",
         "this diversity"
        ],
        [
         "en viktig del av samfunnet",
         "an important part of society"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "For det første gir språk mennesker tilhørighet.",
       "alumno": "Firstly, languages give people a sense of belonging.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "For det første",
         "firstly"
        ],
        [
         "gir språk",
         "languages give"
        ],
        [
         "mennesker tilhørighet",
         "people a sense of belonging"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "På den andre siden kan ulike dialekter være vanskelige å forstå.",
       "alumno": "On the other hand, it can be difficult to understand different dialects.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "På den andre siden",
         "on the other hand"
        ],
        [
         "ulike dialekter",
         "different dialects"
        ],
        [
         "være vanskelige å forstå",
         "can be difficult to understand"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Likevel bør vi lytte og spørre når vi ikke forstår.",
       "alumno": "Even so, we should listen and ask when we don't understand.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Likevel bør vi",
         "even so we should"
        ],
        [
         "lytte og spørre",
         "listen and ask"
        ],
        [
         "når vi ikke forstår",
         "when we don't understand"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Avslutningsvis mener jeg at språklig variasjon bør beskyttes.",
       "alumno": "To conclude, I believe linguistic variation should be protected.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Avslutningsvis",
         "to conclude"
        ],
        [
         "mener jeg",
