   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Talking about languages",
     "texto": [
      "The Norwegian present does not change with the person: jeg snakker and du snakker have the same verb form. Unlike English «he speaks», there is no «-s» ending.",
      "Norsk can be the nationality «Norwegian» or the name of the language «Norwegian». Nationalities and languages start with a lower-case letter, unlike in English.",
      "The form snakker can mean «I speak» or «I am speaking»; the context makes the meaning clear. There is no separate progressive form, unlike English «I am speaking»."
     ],
     "tutora": ""
    }
   ]
  },
