   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Language standardisation",
     "texto": [
      "**Language standardisation** establishes conventions for writing a variety. A **spelling reform** can change which forms are considered acceptable."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Language and history",
     "texto": [
      "Language norms are the result of historical decisions and language policies. They change over time, but speakers don't always adopt changes at the same pace."
     ],
     "tutora": ""
    }
   ]
  },
