  {
   "etapa": "leer",
   "piezas": [
    {
     "tipo": "texto",
     "titulo": "Two perspectives on language change",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Et normeringsvedtak kan åpne for flere godkjente former.",
       "alumno": "A standardisation decision can allow several accepted forms.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "normeringsvedtak",
         "standardisation decision"
        ],
        [
         "godkjente former",
         "accepted forms"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Noen språkbrukere foretrekker en bokmålsnær form.",
       "alumno": "Some language users prefer a form close to Bokmål.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "språkbrukere",
         "language users"
        ],
        [
         "bokmålsnær form",
         "form close to Bokmål"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Andre mener at talemålsendringer bør gjenspeiles i skrift.",
       "alumno": "Others think changes in speech should be reflected in writing.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "talemålsendringer",
         "changes in speech"
        ],
        [
         "gjenspeiles i skrift",
         "be reflected in writing"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Språkdebatten handler også om hvem som får påvirke normen.",
       "alumno": "The language debate is also about who can influence the norm.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "språkdebatten",
         "the language debate"
        ],
        [
         "påvirke normen",
         "influence the norm"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Samnorsk var et historisk prosjekt for å føre bokmål og nynorsk nærmere hverandre.",
       "alumno": "Samnorsk was a historical project to bring bokmål and nynorsk closer together.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "historisk prosjekt",
         "historical project"
        ],
        [
         "føre bokmål og nynorsk nærmere hverandre",
         "bring bokmål and nynorsk closer to each other"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "I dag står målfrihet og språklig mangfold sentralt i diskusjonen.",
       "alumno": "Today, freedom to choose a written form and linguistic diversity are central to the debate.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "målfrihet",
         "freedom to choose a written form"
        ],
        [
         "språklig mangfold",
         "linguistic diversity"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En rettskrivingsnorm må kunne forstås av språkbrukerne.",
       "alumno": "Language users must be able to understand a spelling norm.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "rettskrivingsnorm",
         "spelling norm"
        ],
        [
         "kunne forstås",
         "be understandable"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
   ]
