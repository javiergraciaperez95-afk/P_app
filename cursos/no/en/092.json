    {
     "tipo": "explicacion",
     "titulo": "Talking about activities",
     "texto": [
      "**Arrangement** is an event; **foredrag**, a talk or lecture. **Kulturhus** is a cultural centre. **Gratis** means that it doesn't cost any money."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Registration",
     "texto": [
      "**Påmelding** means registration. **Program** is the activity programme; **nettside**, website. **Nødvendig** means necessary."
     ],
     "tutora": ""
    }
   ]
