    {
     "tipo": "dialogo",
     "titulo": "Taking part in the neighbourhood",
     "frases": [
      {
       "quien": {
        "texto": "Lærer",
        "lengua": "estudio"
       },
       "estudio": "Hva kan gjøre det lettere for nye innbyggere å føle tilhørighet?",
       "alumno": "What can make it easier for new residents to feel they belong?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Hva kan gjøre det lettere",
         "what can make it easier"
        ],
        [
         "for nye innbyggere",
         "for new residents"
        ],
        [
         "å føle tilhørighet",
         "to feel a sense of belonging"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Elev",
        "lengua": "estudio"
       },
       "estudio": "En møteplass der folk kan delta sammen.",
       "alumno": "A meeting place where people can take part together.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "En møteplass",
         "a meeting place"
        ],
        [
         "der folk kan delta sammen",
         "where people can take part together"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Lærer",
        "lengua": "estudio"
       },
       "estudio": "Ja, språkopplæring og kontakt med naboer kan også hjelpe.",
       "alumno": "Yes, language teaching and contact with neighbours can also help.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "språkopplæring",
         "language teaching"
        ],
        [
         "kontakt med naboer",
         "contact with neighbours"
        ],
        [
         "kan også hjelpe",
         "can also help"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Elev",
        "lengua": "estudio"
       },
       "estudio": "Selv om noen møter fordommer, kan de likevel delta i samfunnet.",
       "alumno": "Although some people face prejudice, they can still take part in society.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Selv om noen møter fordommer",
         "although some people face prejudice"
        ],
        [
         "kan de likevel delta",
         "they can still take part"
        ],
        [
         "i samfunnet",
         "in society"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Lærer",
        "lengua": "estudio"
       },
       "estudio": "Riktig. Alle skal ha likeverd og vern mot diskriminering.",
       "alumno": "Right. Everyone should have equal dignity and protection against discrimination.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Alle skal ha",
         "everyone should have"
        ],
        [
         "likeverd",
         "equal dignity"
        ],
        [
         "vern mot diskriminering",
         "protection against discrimination"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
   ]
