   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Asking where a place is",
     "texto": [
      "Hvor ligger …? means «Where is …?». In Norwegian, ligger, literally «is located», is usually used to talk about where a place is.",
      "To give a short direction, use the imperative: Gå rett fram («go straight ahead»), gå til høyre («go to the right»). With verbs ending in -e, that -e is usually dropped: å vente → Vent!"
     ],
     "tutora": ""
    },
