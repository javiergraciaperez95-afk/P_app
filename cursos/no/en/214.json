 "etapas": [
  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Quoting and rewording",
     "texto": [
      "**Et sitat** reproduces exact words; **en parafrase** expresses the idea in your own wording. In both cases the source is indicated.",
      "**Etterprøvbar** means that others can check the information."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Avoiding plagiarism",
     "texto": [
      "A **kildehenvisning** shows where an idea comes from. Presenting others' words or ideas as your own may be considered **plagiat**."
     ],
     "tutora": ""
    }
   ]
  },
