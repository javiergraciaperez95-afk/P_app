     "id": "no233-2",
     "pregunta": {
      "texto": "Translate the sentence.",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "Referatet skiller mellom forslag og vedtak.",
      "lengua": "estudio"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "The minutes distinguish between proposals and decisions.",
       "lengua": "alumno",
       "explicacion": "«Skille mellom» means to distinguish between.",
       "correcta": true
      },
      {
       "texto": "The decision distinguishes between meetings and timetables.",
       "lengua": "alumno",
       "explicacion": "That's not what it says.",
