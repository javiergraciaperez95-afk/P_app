     "id": "no233-1",
     "pregunta": {
      "texto": "What is the difference between «referat» and «protokoll»?",
      "lengua": "alumno"
     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "It summarises what was said and agreed.",
       "lengua": "alumno",
       "explicacion": "The «protokoll» records «vedtak».",
       "correcta": true
      },
      {
       "texto": "The minutes always set a penalty",
       "lengua": "alumno",
       "explicacion": "That isn't its general function.",
       "correcta": false
      },
      {
       "texto": "The protocol contains only individual opinions",
       "lengua": "alumno",
       "explicacion": "It also records decisions.",
       "correcta": false
