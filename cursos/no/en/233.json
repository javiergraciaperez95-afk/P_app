     },
     "frase": {
      "texto": "",
      "lengua": "alumno"
     },
     "traduccion": "",
     "audio": "Hva blir journalført sammen med protokollen?",
     "oir_frase": false,
     "opciones": [
      {
       "texto": "The documented proposal",
       "lengua": "alumno",
