   "etapa": "leer",
   "piezas": [
    {
     "tipo": "texto",
     "titulo": "After the meeting on working hours",
     "frases": [
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Møtelederen oppsummerer beslutningsgrunnlaget før saken avgjøres.",
       "alumno": "The chair summarises the basis for the decision before the matter is settled.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "møtelederen",
         "the chair"
        ],
        [
         "beslutningsgrunnlaget",
         "the basis for the decision"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Referatet skiller mellom forslag og vedtak.",
       "alumno": "The minutes distinguish between proposals and decisions.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "referatet",
         "the minutes"
        ],
        [
         "vedtak",
         "decisions"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "En innsigelse blir tatt med selv om flertallet er enig.",
       "alumno": "An objection is included even though the majority agrees.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "innsigelse",
         "objection"
        ],
        [
         "blir tatt med",
         "is included"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Hvert oppfølgingspunkt får en ansvarshavende og en tidsfrist.",
       "alumno": "Each follow-up point is given a responsible person and a deadline.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "oppfølgingspunkt",
         "follow-up point"
        ],
        [
         "ansvarshavende",
         "responsible person"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Saksframlegget journalføres sammen med protokollen.",
       "alumno": "The documented proposal is recorded together with the formal minutes.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "saksframlegget",
         "the documented proposal"
        ],
        [
         "journalføres",
         "is recorded"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Møtelederen presiserer at beslutningen ikke var enstemmig.",
       "alumno": "The chair states that the decision was not unanimous.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "presiserer",
         "states"
        ],
        [
         "enstemmig",
         "unanimous"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "",
        "lengua": "alumno"
       },
       "estudio": "Senere kontrollerer gruppen om pålegget er fulgt opp.",
       "alumno": "Later, the group checks whether the order has been complied with.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "pålegget",
         "the order"
        ],
        [
         "fulgt opp",
         "complied with"
        ]
       ],
       "parrafo": 0
      }
     ]
    }
