  {
   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Written minutes of a meeting",
     "texto": [
      "A **referat** summarises what was said and agreed. A **protokoll** documents formal decisions.",
      "Each **oppfølgingspunkt** must have a responsible person and a deadline."
     ],
     "tutora": ""
    },
    {
     "tipo": "explicacion",
     "titulo": "Precise wording",
     "texto": [
      "Distinguish between a proposal, a decision and an objection. If there is disagreement, the minutes can record it without presenting it as a decision."
     ],
     "tutora": ""
    }
   ]
  },
