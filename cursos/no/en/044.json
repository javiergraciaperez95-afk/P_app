   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Prohibitions",
     "texto": [
      "**Ikke** goes before the verb in a negative command: **Ikke gå inn!** («Don't go in!»).",
      "**Må ikke + infinitive** expresses a prohibition: **Du må ikke parkere her** («You mustn't park here»). It does not mean «you don't have to»."
     ],
     "tutora": ""
    }
   ]
