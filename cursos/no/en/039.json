    {
     "tipo": "explicacion",
     "titulo": "Changing or cancelling",
     "texto": [
      "To change an appointment, say what is being changed and suggest an alternative.",
      "**Avlyse** means «to cancel»; **utsette** means «to postpone». They do not mean the same: when you postpone, the appointment is kept for another time."
     ],
     "tutora": ""
    }
   ]
  },
