         "not only personal choices"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Rådgiver",
        "lengua": "estudio"
       },
       "estudio": "Levekår og tilgang til helsetjenester spiller også inn.",
       "alumno": "Living conditions and access to health services also play a part.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Levekår",
         "living conditions"
        ],
        [
         "tilgang til helsetjenester",
         "access to health services"
        ],
        [
         "spiller også inn",
         "also play a part"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Lege",
        "lengua": "estudio"
       },
       "estudio": "Er ulikhetene større i noen områder?",
       "alumno": "Are the inequalities bigger in some areas?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "ulikhetene",
         "the inequalities"
        ],
        [
         "større i noen områder",
         "bigger in some areas"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Rådgiver",
        "lengua": "estudio"
       },
       "estudio": "Ja, og ressursfordeling kan være en del av forklaringen.",
       "alumno": "Yes, and the distribution of resources can be part of the explanation.",
