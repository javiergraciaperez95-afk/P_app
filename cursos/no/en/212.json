     "titulo": "A conversation about health services",
     "frases": [
      {
       "quien": {
        "texto": "Lege",
        "lengua": "estudio"
       },
       "estudio": "Folkehelse handler ikke bare om personlige valg.",
       "alumno": "Public health isn't only about personal choices.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "Folkehelse handler",
         "public health deals with"
        ],
        [
