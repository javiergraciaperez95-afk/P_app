     "tipo": "dialogo",
     "titulo": "Commenting on a novel",
     "frases": [
      {
       "quien": {
        "texto": "Lærer",
        "lengua": "estudio"
       },
       "estudio": "I skjønnlitteratur kan fortellerstemmen påvirke hvordan vi oppfatter hovedpersonen.",
       "alumno": "In fiction, the narrative voice can influence how we perceive the protagonist.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "fortellerstemmen",
         "the narrative voice"
        ],
        [
         "oppfatter hovedpersonen",
         "we perceive the protagonist"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Elev",
        "lengua": "estudio"
       },
       "estudio": "Er synsvinkelen alltid den samme?",
       "alumno": "Is the point of view always the same?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "synsvinkelen",
         "the point of view"
        ],
        [
         "alltid den samme",
         "always the same"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Lærer",
        "lengua": "estudio"
       },
       "estudio": "Nei, den kan skifte, og handlingen blir sett fra en annen side.",
       "alumno": "No, it can shift, and the plot is seen from another side.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "kan skifte",
         "it can shift"
        ],
        [
         "handlingen blir sett",
         "the plot is seen"
        ],
        [
         "fra en annen side",
         "from another side"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Elev",
        "lengua": "estudio"
       },
       "estudio": "Hva gjør skildringen av hovedpersonen interessant?",
       "alumno": "What makes the portrayal of the protagonist interesting?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "skildringen av hovedpersonen",
         "the portrayal of the protagonist"
        ],
        [
         "interessant",
         "interesting"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Lærer",
        "lengua": "estudio"
       },
       "estudio": "Karakterutviklingen skjer gradvis, men noe blir stående usagt.",
       "alumno": "The character's development happens gradually, but something is left unsaid.",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "karakterutviklingen skjer gradvis",
         "the character's development happens gradually"
        ],
        [
         "stående usagt",
         "left unsaid"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Elev",
        "lengua": "estudio"
       },
       "estudio": "Er underteksten tydelig?",
       "alumno": "Is the subtext clear?",
       "literal": "",
       "estructura": "",
       "nota": [],
       "analisis": [
        [
         "underteksten",
         "the subtext"
        ],
        [
         "tydelig",
         "clear"
        ]
       ],
       "parrafo": 0
      },
      {
       "quien": {
        "texto": "Lærer",
        "lengua": "estudio"
       },
       "estudio": "Ikke alltid. Symbolikken kan tolkes på flere måter.",
