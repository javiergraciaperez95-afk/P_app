   "etapa": "explicar",
   "piezas": [
    {
     "tipo": "explicacion",
     "titulo": "Connected speech",
     "texto": [
      "In spontaneous speech, some unstressed syllables are reduced and words run together. Not all the letters are heard as clearly as in slow reading.",
      "Norwegian dialects can differ a lot in sounds and intonation. Use spelling as support and practise first with a clear rhythm, without assuming that there is a single standard spoken pronunciation."
     ],
     "tutora": ""
    }
   ]
  },
