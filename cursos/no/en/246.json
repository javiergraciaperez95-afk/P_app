     "tipo": "explicacion",
     "titulo": "Consistent comparison",
     "texto": [
      "Define criteria before assessing options and compare the same dimensions. Cite the source next to the figure and avoid general conclusions based on a small or non-comparable difference. A table helps, but the text should explain why each criterion matters."
     ],
     "tutora": ""
    }
   ]
