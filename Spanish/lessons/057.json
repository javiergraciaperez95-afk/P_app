{
  "capitulo": 7,
  "titulo_es": "Voy a viajar",
  "titulo": { "en": "I'm going to travel" },
  "intro": { "en": "Ir a plus an infinitive is the easiest way to talk about a plan." },
  "palabras": {
    "voy": { "en": "I go", "pron": "boy", "cat": "verb" },
    "vas": { "en": "you go", "pron": "bas", "cat": "verb" },
    "va": { "en": "he/she goes", "pron": "ba", "cat": "verb" },
    "vamos": { "en": "we go", "pron": "BA-mos", "cat": "verb" },
    "a": { "en": "to", "pron": "a", "cat": "preposition" },
    "viajar": { "en": "to travel", "pron": "bya-HAR", "cat": "verb" },
    "mañana": { "en": "tomorrow", "pron": "ma-NYA-na", "cat": "adverb" },
    "el próximo": { "en": "the next (masculine)", "pron": "el PROK-si-mo", "cat": "expression" }
  },
  "bloques": [
    {
      "tipo": "explicacion",
      "titulo": "A plan",
      "texto": "**Ir a** + infinitive means going to do something.\n\n- **Voy a** viajar.\n- **Vas a** estudiar.\n- **Vamos a** comer.\n\nIr itself is irregular: voy, vas, va, vamos, vais, van. The second verb never changes: it stays the infinitive."
    },
    {
      "tipo": "dialogo",
      "titulo": "Tomorrow",
      "frases": [
        {
          "quien": "Lucía",
          "es": "¿Qué vas a hacer mañana?",
          "en": "What are you going to do tomorrow?",
          "analisis": [
            ["¿Qué", "question (what)"],
            ["vas a hacer", "going to do"],
            ["mañana", "tomorrow"]
          ]
        },
        {
          "quien": "Pablo",
          "es": "Voy a viajar a Granada.",
          "en": "I'm going to travel to Granada.",
          "analisis": [
            ["Voy a viajar", "I'm going to travel"],
            ["a Granada", "destination"]
          ]
        },
        {
          "quien": "Lucía",
          "es": "Nosotros vamos a estudiar.",
          "en": "We're going to study.",
          "analisis": [
            ["Nosotros", "subject"],
            ["vamos a estudiar", "we're going to study"]
          ]
        },
        {
          "quien": "Pablo",
          "es": "El próximo mes va a llover poco.",
          "en": "It's going to rain little next month.",
          "nota": "Va a llover is an impersonal plan: it's going to rain.",
          "analisis": [
            ["El próximo mes", "when"],
            ["va a llover", "it's going to rain"]
          ]
        }
      ]
    },
    {
      "tipo": "vocabulario",
      "palabras": ["voy", "vas", "va", "vamos", "viajar", "mañana", "el próximo"]
    },
