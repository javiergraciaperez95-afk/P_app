    {
      "etapa": {
        "en": "Building numbers"
      },
      "tipo": "detector",
      "dice": {
        "en": "How do you write 23, or 31? Look at the model: up to 29 it is ONE word; from 31, three words with **y**. Now, is each number written right? **Sí** or **No**."
      },
      "modelo": {
        "es": "**veinti**trés · treinta **y** uno",
        "trad": {
          "en": "23: one word. 31: three words, with **y** («and»)."
        }
      },
      "frases": [
        {
          "es": "veintidós",
          "ok": true,
          "por": {
            "en": "Sí: 22, one word."
          }
        },
        {
          "es": "veinte y dos",
          "ok": false,
          "por": {
            "en": "No: the twenties are ONE word: **veintidós**."
          }
        },
        {
          "es": "treinta y cinco",
          "ok": true,
          "por": {
            "en": "Sí: 35, tens + **y** + units."
          }
        },
        {
          "es": "treinticinco",
          "ok": false,
          "por": {
            "en": "No: the one-word form stops at 29. **treinta y cinco**."
          }
        },
        {
          "es": "cuarenta dos",
          "ok": false,
          "por": {
            "en": "No: you need **y** in the middle. **cuarenta y dos**."
          }
        },
        {
          "es": "veintiséis",
          "ok": true,
          "por": {
            "en": "Sí: 26, one word, with an accent."
          }
        },
        {
          "es": "cincuenta y uno",
          "ok": true,
          "por": {
            "en": "Sí: 51."
          }
        }
      ],
      "despues": {
        "en": "Up to 29: **veinti…**, one word. From 31: tens **y** units. Now build them yourself!"
      }
