      "pregunta": {"en": "Complete: I like coffee."},
      "frase": "Me ___ el café.",
      "audio": true,
      "opciones": {
        "gusta": {"en": "One thing: gusta."},
        "gustan": {"en": "Gustan is for a plural."},
        "gusto": {"en": "Gustar does not take a yo ending here."}
      },
      "correcta": "gusta"
    },
    {
      "tipo": "huecos",
      "id": "a1-gusta-m2",
      "pregunta": {"en": "Complete: I don't like tea."},
      "frase": "___ me gusta el té.",
      "audio": true,
      "opciones": {
        "No": {"en": "No goes before me."},
        "Nada": {"en": "Nada comes after the verb: no me gusta nada."},
