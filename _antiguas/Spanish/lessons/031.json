{
  "capitulo": 4,
  "titulo_es": "Me gusta",
  "titulo": { "en": "I like it" },
  "intro": { "en": "Gustar works backwards: the thing is the subject." },
  "palabras": {
    "me gusta": { "en": "I like (one thing)", "pron": "me GUS-ta", "cat": "verb" },
    "me gustan": { "en": "I like (more than one)", "pron": "me GUS-tan", "cat": "verb" },
    "te gusta": { "en": "you like (one thing)", "pron": "te GUS-ta", "cat": "verb" },
    "no": { "en": "not, no", "pron": "no", "cat": "adverb" },
    "el café": { "en": "coffee", "pron": "el ka-FE", "genero": "m" },
    "los libros": { "en": "the books", "pron": "los LI-bros", "genero": "m" },
    "también": { "en": "also, too", "pron": "tam-BYEN", "cat": "adverb" },
    "mucho": { "en": "a lot, much", "pron": "MU-cho", "cat": "adverb" }
  },
  "bloques": [
    {
      "tipo": "explicacion",
      "titulo": "The thing does the liking",
      "texto": "**Gustar** agrees with the thing you like, not with you.\n\n- Me **gusta** el café. (one thing)\n- Me **gustan** los libros. (more than one)\n\n**No** goes first: **No** me gusta el café.\n\n**Me, te, le, nos, os, les** say who likes it."
    },
    {
      "tipo": "dialogo",
      "titulo": "At the café",
      "frases": [
        {
          "quien": "Lucía",
          "es": "¿Te gusta el café?",
          "en": "Do you like coffee?",
          "analisis": [
            ["¿Te gusta", "does it please you"],
            ["el café", "subject (the thing)"]
          ]
        },
        {
          "quien": "Pablo",
          "es": "Sí, me gusta mucho.",
          "en": "Yes, I like it a lot.",
          "analisis": [
            ["me gusta", "I like it"],
            ["mucho", "a lot"]
          ]
        },
        {
          "quien": "Lucía",
          "es": "A mí me gustan los libros.",
          "en": "I like books.",
          "nota": "A mí makes it clear who likes them. Me gustan would also be correct.",
          "analisis": [
            ["A mí", "who likes them"],
            ["me gustan", "they please me"],
            ["los libros", "subject"]
          ]
        },
        {
          "quien": "Pablo",
          "es": "No me gusta el té.",
          "en": "I don't like tea.",
          "analisis": [
            ["No", "negation"],
            ["me gusta", "I like"],
            ["el té", "subject"]
          ]
        }
      ]
    },
    {
      "tipo": "vocabulario",
      "palabras": ["me gusta", "me gustan", "te gusta", "no", "el café", "los libros", "también", "mucho"]
    },
    {
      "tipo": "huecos",
      "id": "a1-gusta-plural",
      "pregunta": { "en": "Complete: I like the books." },
      "frase": "Me ___ los libros.",
      "audio": true,
      "opciones": {
        "gustan": { "en": "Los libros is plural, so gustan." },
        "gusta": { "en": "Gusta is for one thing: me gusta el café." },
        "gusto": { "en": "Gustar does not take a yo ending here." }
      },
      "correcta": "gustan"
    },
    {
      "tipo": "escribir",
      "id": "a1-gusta-escribir",
      "pregunta": { "en": "Translate: «I like coffee.»" },
      "respuestas": ["Me gusta el café"],
      "explicacion": { "en": "One thing: me gusta + el café." }
    },
    {
      "tipo": "huecos",
