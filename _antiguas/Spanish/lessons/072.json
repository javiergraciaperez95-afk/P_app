      "frase": "___ veo.",
      "audio": true,
      "opciones": {
        "La": {"en": "A woman as direct object: la."},
        "Lo": {"en": "Lo is masculine."},
        "Le": {"en": "Le is the receiver, not the direct object."}
      },
      "correcta": "La"
    },
    {
      "tipo": "huecos",
      "id": "a2-lo-m2",
