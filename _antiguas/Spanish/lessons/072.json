      "audio": true,
      "opciones": {
        "Las": {"en": "Llaves is feminine plural."},
        "Los": {"en": "Llaves is feminine."},
        "La": {"en": "Llaves is plural."}
      },
      "correcta": "Las"
    },
    {
      "tipo": "escribir",
      "id": "a2-lo-m3",
      "pregunta": {"en": "Answer with a pronoun: «¿Compras el pan?» Yes, I'm buying it."},
      "respuestas": ["Sí, lo compro", "Lo compro"]
