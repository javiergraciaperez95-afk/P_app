{
  "categorias": [
    {
      "titulo": "Lo básico",
      "descripcion": "Saludos y frases de las primeras lecciones.",
      "grupos": [
        {
          "titulo": "Saludar",
          "tarea": "Saluda y pregunta qué tal.",
          "leccion": "001",
          "frases": [
            {
              "da": "こんにちは！",
              "es": "¡Hola!",
              "pron": "kon-ni-chi-wa",
              "analisis": [["こんにちは", "interjección (hola)"]]
            },
            {
              "da": "げんき です か。",
              "es": "¿Qué tal?",
              "pron": "gen-ki des ka",
              "analisis": [
                ["げんき", "adjetivo (bien)"],
                ["です", "verbo (es)"],
                ["か", "partícula de pregunta"]
              ]
            },
            {
              "da": "はい げんき です。",
              "es": "Sí, estoy bien.",
              "pron": "hai gen-ki des",
              "analisis": [
                ["はい", "adverbio (sí)"],
                ["げんき", "adjetivo (bien)"],
                ["です", "verbo (es)"]
              ]
            },
            {
              "da": "さようなら！",
              "es": "¡Adiós!",
              "pron": "sa-yo-u-na-ra",
              "analisis": [["さようなら", "interjección (adiós)"]]
            }
          ]
        },
        {
          "titulo": "Presentarse",
          "tarea": "Di tu nombre.",
          "leccion": "002",
          "frases": [
            {
              "da": "わたし は アンナ です。",
              "es": "Me llamo Anna.",
              "pron": "wa-ta-shi wa A-n-na des",
              "analisis": [
                ["わたし", "pronombre (yo)"],
                ["は", "partícula de tema"],
                ["アンナ", "nombre propio"],
                ["です", "verbo (es)"]
              ]
            },
            {
              "da": "にほんご を はなします か。",
              "es": "¿Hablas japonés?",
              "pron": "ni-hon-go o ha-na-shi-mas ka",
              "analisis": [
                ["にほんご", "complemento (japonés)"],
                ["を", "partícula de objeto"],
                ["はなします", "verbo (hablo)"],
                ["か", "partícula de pregunta"]
              ]
            }
          ]
        },
        {
          "titulo": "Pedir",
          "tarea": "Pide un café.",
          "leccion": "003",
          "frases": [
            {
              "da": "コーヒー を ください。",
              "es": "Un café, por favor.",
              "pron": "ko-o-hi-i o ku-da-sai",
              "analisis": [
                ["コーヒー", "lo que se pide"],
                ["を", "partícula de objeto"],
                ["ください", "fórmula de cortesía (por favor)"]
              ]
            },
            {
              "da": "ありがとう！",
              "es": "¡Gracias!",
              "pron": "a-ri-ga-to-u",
              "analisis": [["ありがとう", "interjección (gracias)"]]
            },
            {
              "da": "どういたしまして！",
              "es": "¡De nada!",
              "pron": "do-u-i-ta-shi-ma-shi-te",
              "analisis": [["どういたしまして", "expresión (de nada)"]]
            }
          ]
        }
      ]
    }
  ]
}
