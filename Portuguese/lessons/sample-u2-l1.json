{
  "titulo": "Os números de 0 a 20",
  "subtitulo": { "en": "Numbers from 0 to 20", "vi": "Các số từ 0 đến 20" },
  "intro": {
    "en": "Numbers! You need them for prices, phone numbers and your age. Watch out: «um» and «dois» change for feminine nouns.",
    "vi": "Các con số! Bạn cần chúng để nói giá tiền, số điện thoại và tuổi. Chú ý: «um» và «dois» thay đổi với danh từ giống cái."
  },
  "palabras": {
    "zero": { "trad": { "en": "zero", "vi": "không (số 0)" }, "cat": "numero" },
    "um": { "trad": { "en": "one (masculine)", "vi": "một (giống đực)" }, "cat": "numero", "femenino": "uma" },
    "uma": { "trad": { "en": "one (feminine)", "vi": "một (giống cái)" }, "cat": "numero" },
    "dois": { "trad": { "en": "two (masculine)", "vi": "hai (giống đực)" }, "cat": "numero", "femenino": "duas" },
    "duas": { "trad": { "en": "two (feminine)", "vi": "hai (giống cái)" }, "cat": "numero" },
    "três": { "trad": { "en": "three", "vi": "ba" }, "cat": "numero" },
    "quatro": { "trad": { "en": "four", "vi": "bốn" }, "cat": "numero" },
    "cinco": { "trad": { "en": "five", "vi": "năm" }, "cat": "numero" },
    "seis": { "trad": { "en": "six", "vi": "sáu" }, "cat": "numero" },
    "sete": { "trad": { "en": "seven", "vi": "bảy" }, "cat": "numero" },
    "oito": { "trad": { "en": "eight", "vi": "tám" }, "cat": "numero" },
    "nove": { "trad": { "en": "nine", "vi": "chín" }, "cat": "numero" },
    "dez": { "trad": { "en": "ten", "vi": "mười" }, "cat": "numero" },
    "onze": { "trad": { "en": "eleven", "vi": "mười một" }, "cat": "numero" },
    "doze": { "trad": { "en": "twelve", "vi": "mười hai" }, "cat": "numero" },
    "treze": { "trad": { "en": "thirteen", "vi": "mười ba" }, "cat": "numero" },
    "catorze": { "trad": { "en": "fourteen", "vi": "mười bốn" }, "cat": "numero" },
    "quinze": { "trad": { "en": "fifteen", "vi": "mười lăm" }, "cat": "numero" },
    "dezasseis": {
      "trad": { "en": "sixteen", "vi": "mười sáu" },
      "cat": "numero",
      "nota": { "en": "European Portuguese spelling. In Brazil it is «dezesseis».", "vi": "Cách viết của Bồ Đào Nha. Ở Brazil viết là «dezesseis»." }
    },
    "dezassete": { "trad": { "en": "seventeen", "vi": "mười bảy" }, "cat": "numero" },
    "dezoito": { "trad": { "en": "eighteen", "vi": "mười tám" }, "cat": "numero" },
    "dezanove": { "trad": { "en": "nineteen", "vi": "mười chín" }, "cat": "numero" },
    "vinte": { "trad": { "en": "twenty", "vi": "hai mươi" }, "cat": "numero" },
    "quantos anos tens": { "trad": { "en": "how old are you? (informal)", "vi": "bạn bao nhiêu tuổi? (thân mật)" }, "cat": "expresion" },
    "tenho": { "trad": { "en": "I have (verb «ter»)", "vi": "tôi có (động từ «ter»)" }, "cat": "verbo" },
    "anos": { "trad": { "en": "years", "vi": "năm, tuổi" }, "cat": "sustantivo", "genero": "m" }
  },
  "bloques": [
    {
      "tipo": "tabla",
      "titulo": { "en": "0 to 20", "vi": "Từ 0 đến 20" },
      "columnas": ["0–6", "7–13", "14–20"],
      "filas": [
        ["0 zero", "7 sete", "14 catorze"],
        ["1 um / uma", "8 oito", "15 quinze"],
        ["2 dois / duas", "9 nove", "16 dezasseis"],
        ["3 três", "10 dez", "17 dezassete"],
        ["4 quatro", "11 onze", "18 dezoito"],
        ["5 cinco", "12 doze", "19 dezanove"],
        ["6 seis", "13 treze", "20 vinte"]
      ],
      "nota": {
        "en": "**um / uma** and **dois / duas** agree with the noun: «um café», «uma água», «dois cafés», «duas águas».",
        "vi": "**um / uma** và **dois / duas** thay đổi theo danh từ: «um café», «uma água», «dois cafés», «duas águas»."
      }
    },
    {
      "tipo": "dialogo",
      "titulo": { "en": "How old are you?", "vi": "Bạn bao nhiêu tuổi?" },
      "frases": [
        {
          "quien": "Sofia",
          "pt": "Quantos anos tens?",
          "trad": { "en": "How old are you?", "vi": "Bạn bao nhiêu tuổi?" },
          "literal": { "en": "How many years do you have?", "vi": "Bạn có bao nhiêu năm?" }
        },
        {
          "quien": "Tiago",
          "pt": "Tenho dezanove anos. E tu?",
          "trad": { "en": "I'm nineteen. And you?", "vi": "Mình mười chín tuổi. Còn bạn?" },
          "nota": { "en": "In Portuguese you «have» years: «tenho dezanove anos».", "vi": "Trong tiếng Bồ Đào Nha, người ta «có» tuổi: «tenho dezanove anos»." },
          "analisis": [["Tenho", "verbo"], ["dezanove anos", "objeto"]]
        },
        {
          "quien": "Sofia",
          "pt": "Tenho vinte.",
          "trad": { "en": "I'm twenty.", "vi": "Mình hai mươi." }
        }
      ]
    },
    {
      "tipo": "vocabulario",
      "titulo": { "en": "Numbers to remember", "vi": "Các số cần nhớ" },
      "palabras": ["zero", "um", "uma", "dois", "duas", "três", "dez", "catorze", "dezasseis", "dezanove", "vinte"]
    },
    {
      "tipo": "test",
      "id": "numero-quinze",
      "pregunta": { "en": "Which number is «quinze»?", "vi": "«quinze» là số mấy?" },
      "opciones": ["15", "5", "50"],
      "correcta": "15"
    },
    {
      "tipo": "huecos",
      "id": "duas-aguas",
      "frase": "___ águas, por favor.",
      "pregunta": { "en": "«Água» is feminine. Choose «two»:", "vi": "«Água» là danh từ giống cái. Chọn «hai»:" },
      "opciones": {
        "Duas": { "en": "Correct: feminine → **duas**.", "vi": "Đúng: giống cái → **duas**." },
        "Dois": { "en": "«Dois» is for masculine nouns: «dois cafés».", "vi": "«Dois» dùng cho danh từ giống đực: «dois cafés»." },
        "Uma": { "en": "«Uma» means one, not two.", "vi": "«Uma» nghĩa là một, không phải hai." }
      },
      "correcta": "Duas"
    },
    {
      "tipo": "test",
      "id": "ouvir-dezassete",
      "audio": "dezassete",
      "pregunta": { "en": "Listen. Which number is it?", "vi": "Hãy nghe. Đó là số mấy?" },
      "opciones": ["17", "7", "16", "70"],
      "correcta": "17"
    },
    {
      "tipo": "escribir",
      "id": "escrever-doze",
      "pregunta": { "en": "Write the number 12 in letters.", "vi": "Viết số 12 bằng chữ." },
      "respuestas": ["doze"],
      "explicacion": { "en": "12 = **doze**.", "vi": "12 = **doze**." }
    },
    {
      "tipo": "ordenar",
      "id": "ordenar-tenho-anos",
      "frase": "Eu tenho vinte anos.",
      "traduccion": { "en": "I'm twenty years old.", "vi": "Tôi hai mươi tuổi." }
    }
  ]
}
