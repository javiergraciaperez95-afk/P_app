        ],
        [
          "ни..., ни...",
          "ni... ni...",
          "Ни брат, ни сестра не пришли."
        ],
        [
          "либо..., либо...",
          "o... o...",
          "Либо ты идёшь, либо остаёшься."
        ]
      ],
      "columnas": [
