          "quien": "Lucía",
          "es": "¿Estás casado?",
          "en": "Are you married?",
          "analisis": [["¿Estás", "verb"], ["casado", "description"]]
        },
        {
          "quien": "Pablo",
          "es": "No, estoy soltero, pero tengo novia. ¿Y tú?",
          "en": "No, I'm single, but I have a girlfriend. And you?",
          "analisis": [["estoy", "verb"], ["soltero", "description"], ["tengo", "verb"], ["novia", "object"]]
        },
        {
          "quien": "Lucía",
          "es": "Mi marido se llama Marcos. Tenemos dos hijos.",
          "en": "My husband is called Marcos. We have two children.",
          "analisis": [["Mi marido", "subject"], ["se llama", "verb"], ["Tenemos", "verb"], ["dos hijos", "object"]]
        },
        {
          "quien": "Pablo",
