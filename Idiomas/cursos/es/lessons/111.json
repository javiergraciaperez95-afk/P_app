          "es": "A2. Me cuesta hablar, pero entiendo bastante.",
          "en": "A2. I find speaking hard, but I understand quite a lot.",
          "analisis": [["Me cuesta", "verb"], ["hablar", "subject"], ["entiendo", "verb"], ["bastante", "how much"]]
        },
