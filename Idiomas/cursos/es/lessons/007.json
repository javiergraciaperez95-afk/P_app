{
  "capitulo": 2,
  "titulo_es": "Soy de Londres",
  "titulo": { "en": "I'm from London" },
  "intro": { "en": "Ser is the verb for who you are, where you are from, your nationality and your job. This lesson is that whole introduction, in one place." },
  "palabras": {
    "soy": { "en": "I am", "pron": "soy", "cat": "verb" },
    "eres": { "en": "you are", "pron": "E-res", "cat": "verb" },
    "es": { "en": "he/she is, you (formal) are", "pron": "es", "cat": "verb" },
    "somos": { "en": "we are", "pron": "SO-mos", "cat": "verb" },
    "sois": { "en": "you (plural, Spain) are", "pron": "soys", "cat": "verb" },
    "son": { "en": "they are, you (plural) are", "pron": "son", "cat": "verb" },
    "de": { "en": "from, of", "pron": "de", "cat": "preposition" },
    "estudiante": { "en": "student", "pron": "es-tu-DYAN-te", "genero": "m/f", "nota": "The same form for a man or a woman." },
    "profesor": { "en": "teacher (male)", "pron": "pro-fe-SOR", "genero": "m" },
    "profesora": { "en": "teacher (female)", "pron": "pro-fe-SO-ra", "genero": "f" },
    "médico": { "en": "doctor (male)", "pron": "ME-di-ko", "genero": "m" },
    "médica": { "en": "doctor (female)", "pron": "ME-di-ka", "genero": "f" },
    "canadiense": { "en": "Canadian", "pron": "ka-na-DYEN-se", "cat": "adjective", "nota": "Nationalities ending in -ense do not change for a woman: canadiense, estadounidense." },
    "español": { "en": "Spanish (male); the Spanish language", "pron": "es-pa-NYOL", "genero": "m" },
    "española": { "en": "Spanish (female)", "pron": "es-pa-NYO-la", "genero": "f", "consejo": "Ñ sounds like ny in canyon." },
    "inglés": { "en": "English (male); the English language", "pron": "in-GLES", "genero": "m" },
    "inglesa": { "en": "English (female)", "pron": "in-GLE-sa", "genero": "f" }
  },
  "bloques": [
    {
      "tipo": "explicacion",
      "titulo": "Who, where from, what job",
      "texto": "Use **ser** for identity.\n\n- **Soy** de Londres. The place takes **de**, and no article: de España, de México, de Madrid.\n- **Soy** canadiense. **Soy** española. The nationality matches the person. -O becomes -a for a woman when the word has that pair: español, española. **Canadiense** stays the same.\n- **Soy** profesora. **Soy** médica. There is no word for «a» before a profession.\n\nThe language, when you get to it, also has no article: hablo español. The full present of hablar is the next verb lesson. Today the job is ser."
    },
    {
      "tipo": "tabla",
      "titulo": "Ser",
      "columnas": ["Person", "ser"],
      "filas": [
        ["yo", "soy"],
        ["tú", "eres"],
        ["él / ella / usted", "es"],
        ["nosotros / nosotras", "somos"],
        ["vosotros / vosotras", "sois"],
        ["ellos / ustedes", "son"]
      ],
      "nota": { "en": "Spain uses vosotros for you, plural and informal. Usted uses es, the same form as él and ella." }
    },
    {
      "tipo": "dialogo",
      "titulo": "Two people in class",
      "frases": [
        {
          "quien": "Pablo",
          "es": "¿De dónde eres?",
          "en": "Where are you from?",
          "analisis": [
            ["¿De dónde", "question"],
            ["eres", "verb"]
          ]
        },
        {
          "quien": "Lucía",
          "es": "Soy de Canadá. Soy canadiense.",
          "en": "I'm from Canada. I'm Canadian.",
          "analisis": [
            ["Soy", "verb"],
            ["de Canadá", "origin"],
            ["canadiense", "nationality"]
          ]
        },
        {
          "quien": "Pablo",
          "es": "¿Eres profesora?",
          "en": "Are you a teacher?",
          "analisis": [
            ["¿Eres", "verb"],
            ["profesora", "profession"]
          ]
        },
        {
          "quien": "Lucía",
          "es": "No, soy estudiante. ¿Y tú?",
          "en": "No, I'm a student. And you?",
          "analisis": [
            ["No", "negation"],
            ["soy", "verb"],
            ["estudiante", "profession"],
            ["¿Y tú", "question"]
          ]
        },
        {
          "quien": "Pablo",
          "es": "Yo soy profesor. Soy de Madrid y soy español.",
          "en": "I'm a teacher. I'm from Madrid and I'm Spanish.",
          "analisis": [
            ["Yo", "subject"],
            ["soy", "verb"],
            ["profesor", "profession"],
            ["de Madrid", "origin"],
            ["español", "nationality"]
          ]
        },
        {
          "quien": "Lucía",
          "es": "Ana es médica. Es española.",
          "en": "Ana is a doctor. She is Spanish.",
          "analisis": [
            ["Ana", "subject"],
            ["es", "verb"],
            ["médica", "profession"],
            ["española", "nationality"]
          ]
        }
      ]
    },
    {
      "tipo": "vocabulario",
      "palabras": ["soy", "eres", "es", "somos", "sois", "son", "de", "estudiante", "profesor", "profesora", "médico", "médica", "canadiense", "español", "española", "inglés", "inglesa"]
    },
    {
      "tipo": "huecos",
      "id": "a1-ser-soy",
      "pregunta": { "en": "Complete: I am from Mexico." },
      "frase": "Yo ___ de México.",
      "audio": true,
      "opciones": {
        "soy": { "en": "Yo goes with soy." },
        "eres": { "en": "Eres is for tú." },
        "es": { "en": "Es is for él, ella or usted." }
      },
      "correcta": "soy"
    },
    {
      "tipo": "huecos",
      "id": "a1-ser-nacional",
      "pregunta": { "en": "Complete: Ana is Spanish." },
      "frase": "Ana es ___.",
      "audio": true,
      "opciones": {
        "española": { "en": "Ana is a woman, so the nationality takes -a." },
        "español": { "en": "Español is the masculine form." },
        "canadiense": { "en": "Canadiense would say she is Canadian." }
      },
      "correcta": "española"
    },
    {
      "tipo": "test",
      "id": "a1-ser-oficio",
      "pregunta": { "en": "Lucía is a doctor. Which sentence is the one you want?" },
      "opciones": {
        "Soy médica": { "en": "A profession after ser has no article." },
        "Soy una médica": { "en": "The article una does not go before the profession here." },
        "Estoy médica": { "en": "A job is identity, so it takes ser." }
      },
      "correcta": "Soy médica"
    },
    {
      "tipo": "escribir",
      "id": "a1-ser-escribir",
      "pregunta": { "en": "Translate: «I am from Spain.»" },
      "respuestas": ["Soy de España", "Yo soy de España"],
      "explicacion": { "en": "Origin is ser + de + the place. No article before España." }
    },
    {
      "tipo": "ordenar",
      "id": "a1-ser-donde",
      "frase": "¿De dónde eres?",
      "traduccion": { "en": "Where are you from?" },
      "explicacion": { "en": "De dónde asks for the origin. Eres is tú." }
    },
    {
      "tipo": "explicacion",
      "titulo": {"en": "Your turn: write and speak"},
      "texto": {
        "en": "**The app cannot check this part.** For the writing, please use pen and paper. For the speaking, say it out loud and, if you can, practise with a native speaker or a teacher who can correct you.\n\n**Write (30–40 words).** Write who you are and where you are from. Then do the same for three people you know.\n\n**Speak (about 30 seconds).** Say aloud where you and four other people are from: Soy de…, Es de…, Somos de…"
      }
    }
  ]
}
