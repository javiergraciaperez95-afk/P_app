{
  "capitulo": 9,
  "titulo_es": "De viaje",
  "titulo": {"en": "Travelling"},
  "intro": {"en": "Tickets, platforms, delays and the questions you need at a station or an airport."},
  "palabras": {
    "el billete": {"en": "the ticket (el boleto in many Latin American countries)", "pron": "el bi-YE-te", "cat": "noun", "genero": "m"},
    "de ida y vuelta": {"en": "return / round-trip (ticket)", "pron": "de I-da i BWEL-ta", "cat": "expression"},
    "solo ida": {"en": "one way", "pron": "SO-lo I-da", "cat": "expression"},
    "el andén": {"en": "the platform", "pron": "el an-DEN", "cat": "noun", "genero": "m"},
    "el retraso": {"en": "the delay", "pron": "el re-TRA-so", "cat": "noun", "genero": "m"},
    "sale": {"en": "it leaves", "pron": "SA-le", "cat": "verb"},
    "llega": {"en": "it arrives", "pron": "YE-ga", "cat": "verb"},
    "tarda": {"en": "it takes (time)", "pron": "TAR-da", "cat": "verb"},
    "el vuelo": {"en": "the flight", "pron": "el BWE-lo", "cat": "noun", "genero": "m"},
    "la maleta": {"en": "the suitcase", "pron": "la ma-LE-ta", "cat": "noun", "genero": "f"},
    "la puerta de embarque": {"en": "the boarding gate", "pron": "la PWER-ta de em-BAR-ke", "cat": "noun", "genero": "f"},
    "facturar": {"en": "to check a bag", "pron": "fak-tu-RAR", "cat": "verb"},
    "el asiento": {"en": "the seat", "pron": "el a-SYEN-to", "cat": "noun", "genero": "m"},
    "hacer transbordo": {"en": "to make a transfer (change trains/lines)", "pron": "a-SER trans-BOR-do (seseo) / a-THER trans-BOR-do (distinción)", "cat": "expression"},
    "el tren": {"en": "the train", "pron": "el TREN", "cat": "noun", "genero": "m"},
    "la estación": {"en": "the station", "pron": "la es-ta-SYON (seseo) / la es-ta-THYON (distinción)", "cat": "noun", "genero": "f"},
    "el aeropuerto": {"en": "the airport", "pron": "el a-e-ro-PWER-to", "cat": "noun", "genero": "m"},
    "la salida": {"en": "the departure; the exit", "pron": "la sa-LI-da", "cat": "noun", "genero": "f"},
    "la llegada": {"en": "the arrival", "pron": "la ye-GA-da", "cat": "noun", "genero": "f"},
